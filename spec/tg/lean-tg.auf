l51: $ GG , w = ⟨ o , ra_add q1 q2 q3 ⟩ , w ∊ cl_add_s , ∃ n ∃ j (w = ⟨ scons (ra_add i n j) ∅ , ra_add i ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_s , scons j ∅ ⟩ ⟩) ⇒ ph $ by ex_elim [l50, l49]
l52: $ GG , w = ⟨ o , ra_add q1 q2 q3 ⟩ , w ∊ cl_add_s ⇒ ph $ by ex_elim [l2, l51]
l53: $ GG ⇒ ph $ by wcel_elim [#1, l52]

lemma y2_add_e2 (GG: hyps) (q1 q2 q3 w3 u_i u_n u_j v_i v_n v_j: set):
  $ GG ⇒ q1 = u_i $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ q3 = ⟨ kc_s , scons u_j ∅ ⟩ $ > $ GG ⇒ ra_add u_i u_n u_j ∈ lrel $ > $ GG ⇒ ra_add u_i u_n u_j ∈ y2_P_add lrel $ > $ GG ⇒ q1 = v_i $ > $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ w3 = ⟨ kc_s , scons v_j ∅ ⟩ $ > $ GG ⇒ ra_add v_i v_n v_j ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ u_i = q1 $ by eq_sym [#1]
l2: $ GG ⇒ u_i = v_i $ by eq_trans [l1, #6]
l3: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = q2 $ by eq_sym [#2]
l4: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [l3, #7]
l5: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l6: $ GG ⇒ isset kc_s $ by wcel_isset [l5]
l7: $ GG ⇒ isset u_n $ by isset_var
l8: $ GG ⇒ isset v_n $ by isset_var
l9: $ GG ⇒ u_n = v_n $ by y2_nd1 [l4, l6, l7, l8]
l10: $ GG ⇒ v_i = u_i $ by eq_sym [l2]
l11: $ GG ⇒ v_n = u_n $ by eq_sym [l9]
l12: $ GG ⇒ v_j = v_j $ by eq_refl
l13: $ GG ⇒ ra_add u_i u_n v_j ∈ lrel $ by x1_eq_add [#9, l10, l11, l12]
l14: $ GG ⇒ isset u_i $ by isset_var
l15: $ GG ⇒ isset u_n $ by isset_var
l16: $ GG ⇒ isset u_j $ by isset_var
l17: $ GG ⇒ isset v_j $ by isset_var
l18: $ GG ⇒ u_j = v_j $ by y2_add_ihc [l14, l15, l16, l17, #5, l13]
l19: $ GG ⇒ ∅ = ∅ $ by eq_refl
l20: $ GG ⇒ scons u_j ∅ = scons v_j ∅ $ by scons_eq [l18, l19]
l21: $ GG ⇒ kc_s = kc_s $ by eq_refl
l22: $ GG ⇒ ⟨ kc_s , scons u_j ∅ ⟩ = ⟨ kc_s , scons v_j ∅ ⟩ $ by opair_eq [l21, l20]
l23: $ GG ⇒ ⟨ kc_s , scons v_j ∅ ⟩ = w3 $ by eq_sym [#8]
l24: $ GG ⇒ q3 = ⟨ kc_s , scons v_j ∅ ⟩ $ by eq_trans [#3, l22]
l25: $ GG ⇒ q3 = w3 $ by eq_trans [l24, l23]

lemma y2_add_c2 (GG: hyps) (q1 q2 q3 w3 u_i u_n u_j: set):
  $ GG ⇒ q1 = u_i ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ > $ GG ⇒ ra_add q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ∨ ∃ a ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) $ by lrel_add_cases [#2]
l2: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by ax
l3: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = u_i ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by weaken [#1]
l4: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = u_i $ by and_elim_l [l3]
l5: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l3]
l6: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l5]
l8: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = ⟨ kc_s , scons u_j ∅ ⟩ $ by and_elim_l [l7]
l9: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l7]
l10: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_add u_i u_n u_j ∈ lrel $ by and_elim_l [l9]
l11: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l9]
l12: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = a $ by and_elim_l [l2]
l13: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by and_elim_r [l2]
l14: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l13]
l15: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l13]
l16: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ kc_nz ∈ kc_s $ by y2_lt_nz_s
l17: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ kc_s ∈ ω $ by v1_kc_s
l18: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ isset kc_s $ by wcel_isset [l17]
l19: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ⊥ $ by y2_ne [l14, l6, l16, l18]
l20: $ GG , q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = w3 $ by bot_elim [l19]
l21: $ GG , ∃ a (q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ ∃ a (q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) $ by ax
l22: $ GG , ∃ a (q1 = a ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l21, l20]
l23: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel $ by ax
l24: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q1 = u_i ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by weaken [#1]
l25: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q1 = u_i $ by and_elim_l [l24]
l26: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l24]
l27: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l26]
l28: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q3 = ⟨ kc_s , scons u_j ∅ ⟩ ∧ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l26]
l29: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q3 = ⟨ kc_s , scons u_j ∅ ⟩ $ by and_elim_l [l28]
l30: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ ra_add u_i u_n u_j ∈ lrel ∧ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l28]
l31: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ ra_add u_i u_n u_j ∈ lrel $ by and_elim_l [l30]
l32: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ ra_add u_i u_n u_j ∈ y2_P_add lrel $ by and_elim_r [l30]
l33: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q1 = a $ by and_elim_l [l23]
l34: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel $ by and_elim_r [l23]
l35: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons b ∅ ⟩ $ by and_elim_l [l34]
l36: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel $ by and_elim_r [l34]
l37: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ w3 = ⟨ kc_s , scons d ∅ ⟩ $ by and_elim_l [l36]
l38: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ ra_add a b d ∈ lrel $ by and_elim_r [l36]
l39: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ⇒ q3 = w3 $ by y2_add_e2 [l25, l27, l29, l31, l32, l33, l35, l37, l38]
l40: $ GG , ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) ⇒ ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) $ by ax
l41: $ GG , ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l40, l39]
l42: $ GG , ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) ⇒ ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) $ by ax
l43: $ GG , ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l42, l41]
l44: $ GG , ∃ a ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) ⇒ ∃ a ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) $ by ax
l45: $ GG , ∃ a ∃ b ∃ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ w3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l44, l43]
l46: $ GG ⇒ q3 = w3 $ by or_elim [l1, l22, l45]

lemma y2_add_d2 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_add q1 q2 q3 ⟩ ∈ cl_add_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_add lrel $ > $ GG ⇒ ra_add q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel ⇒ q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel $ by ax
l2: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel ⇒ ra_add q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel ⇒ q3 = w3 $ by y2_add_c2 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = a ∧ q2 = ⟨ kc_s , scons b ∅ ⟩ ∧ q3 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_add a b d ∈ lrel ∧ ra_add a b d ∈ y2_P_add lrel → q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ q3 = w3 $ by y2_add_i2 [#1, #2, l7]

lemma y2_add_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_add lrel → c ∊ y2_P_add lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ c = ra_add x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_add x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_add x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_add x1 x2 x3 ⟩ ∈ pr_add $ by lprog_add_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_add lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ra_add x1 x2 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_z ⇒ ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_z $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_z ⇒ crn o ⊆ horn lprog ∩ y2_P_add lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_z ⇒ ra_add x1 x2 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_z ⇒ x3 = x6 $ by y2_add_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_s ⇒ ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_s $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_s ⇒ crn o ⊆ horn lprog ∩ y2_P_add lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_s ⇒ ra_add x1 x2 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel , ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_s ⇒ x3 = x6 $ by y2_add_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_s → x3 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ ⟨ o , ra_add x1 x2 x3 ⟩ ∈ cl_add_z ∪ cl_add_s → x3 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 , ra_add x1 x2 x6 ∈ lrel ⇒ x3 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 ⇒ ra_add x1 x2 x6 ∈ lrel → x3 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel , c = ra_add x1 x2 x3 ⇒ ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel ⇒ c = ⟨ kr_add , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel ⇒ ∀ x3 (c = ⟨ kr_add , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_add , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_add , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_add , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_add lrel ⇒ c ∊ y2_P_add lrel $ by cab_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_add lrel → c ∊ y2_P_add lrel $ by imp_intro [l26]
l28: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_add lrel → c ∊ y2_P_add lrel $ by imp_intro [l27]
l29: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_add lrel → c ∊ y2_P_add lrel) $ by all_intro [l28]
l30: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_add lrel → c ∊ y2_P_add lrel) $ by all_intro [l29]

lemma y2_add_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_add lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_add lrel → c ∊ y2_P_add lrel) $ by y2_add_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_add lrel $ by horn_ind [l1, l2]

lrel_add_det
------------
l1: $ G ⇒ horn lprog ⊆ y2_P_add lrel $ by y2_add_in
l2: $ G ⇒ ra_add t1 t2 u3 ∈ y2_P_add lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u3 = v3 $ by y2_add_ih [l2, #2]

--| The atoms of `clen` whose variants in `L` with the same inputs have the same outputs.
def y2_P_clen (L: class) (.c .x1 .x2 .x6: set): class = $ {c | ∀ x1 ∀ x2 (c = ⟨ kr_clen , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons x1 (scons x6 ∅) ⟩ ∈ L → x2 = x6))} $

lemma y2_clen_ih (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ ra_clen q1 q2 ∈ y2_P_clen lrel $ > $ GG ⇒ ra_clen q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ c ∊ y2_P_clen lrel $ by ax
l2: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_clen , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ ∀ x2 (c = ⟨ kr_clen , scons q1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons q1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ c = ⟨ kr_clen , scons q1 (scons q2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by all_elim [l3]
l5: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ c = ra_clen q1 q2 $ by ax
l6: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ ∀ x6 (⟨ kr_clen , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by imp_elim [l4, l5]
l7: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ ra_clen q1 w2 ∈ lrel → q2 = w2 $ by all_elim [l6]
l8: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ ra_clen q1 w2 ∈ lrel $ by weaken [#2]
l9: $ GG , c = ra_clen q1 q2 , c ∊ y2_P_clen lrel ⇒ q2 = w2 $ by imp_elim [l7, l8]
l10: $ GG ⇒ q2 = w2 $ by wcel_elim [#1, l9]

lemma y2_clen_ihc (GG: hyps) (Q1 Q2 W2: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ ra_clen Q1 Q2 ∈ y2_P_clen lrel $ > $ GG ⇒ ra_clen Q1 W2 ∈ lrel $ > $ GG ⇒ Q2 = W2 $
----
l1: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ d = W2 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q1 = a $ by eq_sym [l1]
l5: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = b $ by eq_sym [l2]
l6: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ W2 = d $ by eq_sym [l3]
l7: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ∅ = ∅ $ by eq_refl
l8: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q2 ∅ = scons b ∅ $ by scons_eq [l5, l7]
l9: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q1 (scons Q2 ∅) = scons a (scons b ∅) $ by scons_eq [l4, l8]
l10: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ kr_clen = kr_clen $ by eq_refl
l11: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen Q1 Q2 = ra_clen a b $ by opair_eq [l10, l9]
l12: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen Q1 Q2 ∈ y2_P_clen lrel $ by weaken [#4]
l13: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen a b ∈ y2_P_clen lrel $ by wcel_eq_l [l11, l12]
l14: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen Q1 W2 ∈ lrel $ by weaken [#5]
l15: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen a d ∈ lrel $ by x1_eq_clen [l14, l4, l6]
l16: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = d $ by y2_clen_ih [l13, l15]
l17: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = d $ by eq_trans [l5, l16]
l18: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = W2 $ by eq_trans [l17, l3]
l19: $ GG , a = Q1 , b = Q2 ⇒ Q2 = W2 $ by isset_elim [#3, l18]
l20: $ GG , a = Q1 ⇒ Q2 = W2 $ by isset_elim [#2, l19]
l21: $ GG ⇒ Q2 = W2 $ by isset_elim [#1, l20]

lemma y2_clen_i1 (GG: hyps) (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_clen q1 q2 ⟩ ∈ cl_clen_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ > $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil ⇒ w ∊ cl_clen_nil $ by ax
l2: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil ⇒ w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_clen q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen q1 q2 ⟩ = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_clen q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_clen q1 q2 = ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ kr_clen , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_clen , scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_clen ∈ ω $ by x1_kr_clen
l15: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset kr_clen $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l19: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by y2_nd2 [l13, l15, l16, l17, l18, l19]
l21: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l20]
l22: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l20]
l23: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l21, l22]
l24: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph $ by weaken [#3]
l25: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil , w = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l24, l23]
l26: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_nil ⇒ ph $ by cut [l2, l25]
l27: $ GG ⇒ ph $ by wcel_elim [#1, l26]

lemma y2_clen_e1 (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_trans [l1, #3]
l3: $ GG ⇒ ∅ = ∅ $ by eq_refl
l4: $ GG ⇒ kc_nz = kc_nz $ by eq_refl
l5: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by opair_eq [l4, l3]
l6: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = w2 $ by eq_sym [#4]
l7: $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [#2, l5]
l8: $ GG ⇒ q2 = w2 $ by eq_trans [l7, l6]

lemma y2_clen_c1 (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ra_clen q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ (q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by lrel_clen_cases [#2]
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l2]
l7: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l8: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_clen_e1 [l4, l5, l6, l7]
l9: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel $ by ax
l10: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l11: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l10]
l12: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l10]
l13: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ $ by and_elim_l [l9]
l14: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel $ by and_elim_r [l9]
l15: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ $ by and_elim_l [l14]
l16: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ ra_clen b d ∈ lrel $ by and_elim_r [l14]
l17: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ kc_nil ∈ kc_cons $ by y2_lt_nil_cons
l18: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ kc_cons ∈ ω $ by v1_kc_cons
l19: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ isset kc_cons $ by wcel_isset [l18]
l20: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ ⊥ $ by y2_ne [l11, l13, l17, l19]
l21: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q2 = w2 $ by bot_elim [l20]
l22: $ GG , ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by ax
l23: $ GG , ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l22, l21]
l24: $ GG , ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by ax
l25: $ GG , ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l24, l23]
l26: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by ax
l27: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l26, l25]
l28: $ GG ⇒ q2 = w2 $ by or_elim [l1, l8, l27]

lemma y2_clen_d1 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_clen q1 q2 ⟩ ∈ cl_clen_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ > $ GG ⇒ ra_clen q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_clen_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ q2 = w2 $ by y2_clen_i1 [#1, #2, l4]

lemma y2_clen_i2 (GG: hyps) {A G n: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_clen q1 q2 ⟩ ∈ cl_clen_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ > $ GG ⇒ ∀ A ∀ G ∀ n (q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons ⇒ w ∊ cl_clen_cons $ by ax
l2: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons ⇒ ∃ A ∃ G ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_clen q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen q1 q2 ⟩ = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen G n) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ scons (ra_clen G n) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (scons (ra_clen G n) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ o = scons (ra_clen G n) ∅ ∧ ra_clen q1 q2 = ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ o = scons (ra_clen G n) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ kr_clen , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_clen , scons ⟨ kc_cons , scons A (scons G ∅) ⟩ (scons ⟨ kc_s , scons n ∅ ⟩ ∅) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ kr_clen ∈ ω $ by x1_kr_clen
l18: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset kr_clen $ by wcel_isset [l17]
l19: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l20: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l21: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset ⟨ kc_cons , scons A (scons G ∅) ⟩ $ by opair_isset
l22: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset ⟨ kc_s , scons n ∅ ⟩ $ by opair_isset
l23: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by y2_nd2 [l16, l18, l19, l20, l21, l22]
l24: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ $ by and_elim_l [l23]
l25: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by and_elim_r [l23]
l26: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ by weaken [#2]
l27: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn o = crn (scons (ra_clen G n) ∅) $ by crn_eq [l15]
l28: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn (scons (ra_clen G n) ∅) ⊆ horn lprog ∩ y2_P_clen lrel $ by subset_eq_l [l27, l26]
l29: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ horn lprog ∩ y2_P_clen lrel ⊆ horn lprog $ by cin_subset_l
l30: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ horn lprog ∩ y2_P_clen lrel ⊆ y2_P_clen lrel $ by cin_subset_r
l31: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen G n) $ by opair_isset
l32: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ra_clen G n ∈ horn lprog ∩ y2_P_clen lrel $ by crn_scons_head [l31, l28]
l33: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ra_clen G n ∈ lrel $ by wcel_subset [l29, l32]
l34: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ra_clen G n ∈ y2_P_clen lrel $ by wcel_subset [l30, l32]
l35: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel $ by and_intro [l33, l34]
l36: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel $ by and_intro [l25, l35]
l37: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel $ by and_intro [l24, l36]
l38: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ∀ A ∀ G ∀ n (q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel → ph) $ by weaken [#3]
l39: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ∀ G ∀ n (q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel → ph) $ by all_elim [l38]
l40: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ∀ n (q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel → ph) $ by all_elim [l39]
l41: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen G n ∈ lrel ∧ ra_clen G n ∈ y2_P_clen lrel → ph $ by all_elim [l40]
l42: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l41, l37]
l43: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) ⇒ ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) $ by ax
l44: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) ⇒ ph $ by ex_elim [l43, l42]
l45: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , ∃ G ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) ⇒ ∃ G ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) $ by ax
l46: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons , ∃ G ∃ n (w = ⟨ scons (ra_clen G n) ∅ , ra_clen ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) ⇒ ph $ by ex_elim [l45, l44]
l47: $ GG , w = ⟨ o , ra_clen q1 q2 ⟩ , w ∊ cl_clen_cons ⇒ ph $ by ex_elim [l2, l46]
l48: $ GG ⇒ ph $ by wcel_elim [#1, l47]

lemma y2_clen_e2 (GG: hyps) (q1 q2 w2 u_A u_G u_n v_A v_G v_n: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ ra_clen u_G u_n ∈ lrel $ > $ GG ⇒ ra_clen u_G u_n ∈ y2_P_clen lrel $ > $ GG ⇒ q1 = ⟨ kc_cons , scons v_A (scons v_G ∅) ⟩ $ > $ GG ⇒ w2 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ ra_clen v_G v_n ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ = ⟨ kc_cons , scons v_A (scons v_G ∅) ⟩ $ by eq_trans [l1, #5]
l3: $ GG ⇒ kc_cons ∈ ω $ by v1_kc_cons
l4: $ GG ⇒ isset kc_cons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_A $ by isset_var
l6: $ GG ⇒ isset u_G $ by isset_var
l7: $ GG ⇒ isset v_A $ by isset_var
l8: $ GG ⇒ isset v_G $ by isset_var
l9: $ GG ⇒ u_A = v_A ∧ u_G = v_G $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_A = v_A $ by and_elim_l [l9]
l11: $ GG ⇒ u_G = v_G $ by and_elim_r [l9]
l12: $ GG ⇒ v_G = u_G $ by eq_sym [l11]
l13: $ GG ⇒ v_n = v_n $ by eq_refl
l14: $ GG ⇒ ra_clen u_G v_n ∈ lrel $ by x1_eq_clen [#7, l12, l13]
l15: $ GG ⇒ isset u_G $ by isset_var
l16: $ GG ⇒ isset u_n $ by isset_var
l17: $ GG ⇒ isset v_n $ by isset_var
l18: $ GG ⇒ u_n = v_n $ by y2_clen_ihc [l15, l16, l17, #4, l14]
l19: $ GG ⇒ ∅ = ∅ $ by eq_refl
l20: $ GG ⇒ scons u_n ∅ = scons v_n ∅ $ by scons_eq [l18, l19]
l21: $ GG ⇒ kc_s = kc_s $ by eq_refl
l22: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by opair_eq [l21, l20]
l23: $ GG ⇒ ⟨ kc_s , scons v_n ∅ ⟩ = w2 $ by eq_sym [#6]
l24: $ GG ⇒ q2 = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [#2, l22]
l25: $ GG ⇒ q2 = w2 $ by eq_trans [l24, l23]

lemma y2_clen_c2 (GG: hyps) (q1 q2 w2 u_A u_G u_n: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ > $ GG ⇒ ra_clen q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ (q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by lrel_clen_cases [#2]
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen u_G u_n ∈ lrel $ by and_elim_l [l7]
l9: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen u_G u_n ∈ y2_P_clen lrel $ by and_elim_r [l7]
l10: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l2]
l11: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l12: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_nil ∈ kc_cons $ by y2_lt_nil_cons
l13: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ kc_cons ∈ ω $ by v1_kc_cons
l14: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_cons $ by wcel_isset [l13]
l15: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ ⊥ $ by y2_ne [l10, l4, l12, l14]
l16: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by bot_elim [l15]
l17: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel $ by ax
l18: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ by weaken [#1]
l19: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ by and_elim_l [l18]
l20: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ by and_elim_r [l18]
l21: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q2 = ⟨ kc_s , scons u_n ∅ ⟩ $ by and_elim_l [l20]
l22: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ ra_clen u_G u_n ∈ lrel ∧ ra_clen u_G u_n ∈ y2_P_clen lrel $ by and_elim_r [l20]
l23: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ ra_clen u_G u_n ∈ lrel $ by and_elim_l [l22]
l24: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ ra_clen u_G u_n ∈ y2_P_clen lrel $ by and_elim_r [l22]
l25: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ $ by and_elim_l [l17]
l26: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel $ by and_elim_r [l17]
l27: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ $ by and_elim_l [l26]
l28: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ ra_clen b d ∈ lrel $ by and_elim_r [l26]
l29: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ⇒ q2 = w2 $ by y2_clen_e2 [l19, l21, l23, l24, l25, l27, l28]
l30: $ GG , ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by ax
l31: $ GG , ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l30, l29]
l32: $ GG , ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by ax
l33: $ GG , ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l32, l31]
l34: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) $ by ax
l35: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l34, l33]
l36: $ GG ⇒ q2 = w2 $ by or_elim [l1, l16, l35]

lemma y2_clen_d2 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_clen q1 q2 ⟩ ∈ cl_clen_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ > $ GG ⇒ ra_clen q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel $ by ax
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel ⇒ ra_clen q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel ⇒ q2 = w2 $ by y2_clen_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel → q2 = w2) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen b d ∈ lrel ∧ ra_clen b d ∈ y2_P_clen lrel → q2 = w2) $ by all_intro [l6]
l8: $ GG ⇒ q2 = w2 $ by y2_clen_i2 [#1, #2, l7]

lemma y2_clen_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen lrel → c ∊ y2_P_clen lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ c = ra_clen x1 x2 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_clen x1 x2 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen x1 x2 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen x1 x2 ⟩ ∈ pr_clen $ by lprog_clen_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ra_clen x1 x6 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_nil ⇒ ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_nil $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_nil ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_nil ⇒ ra_clen x1 x6 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_nil ⇒ x2 = x6 $ by y2_clen_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_cons ⇒ ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_cons $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_cons ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_cons ⇒ ra_clen x1 x6 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel , ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_cons ⇒ x2 = x6 $ by y2_clen_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_cons → x2 = x6 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ ⟨ o , ra_clen x1 x2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons → x2 = x6 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 , ra_clen x1 x6 ∈ lrel ⇒ x2 = x6 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 ⇒ ra_clen x1 x6 ∈ lrel → x2 = x6 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel , c = ra_clen x1 x2 ⇒ ∀ x6 (⟨ kr_clen , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel ⇒ c = ⟨ kr_clen , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6) $ by imp_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel ⇒ ∀ x2 (c = ⟨ kr_clen , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_clen , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_clen lrel ⇒ c ∊ y2_P_clen lrel $ by cab_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_clen lrel → c ∊ y2_P_clen lrel $ by imp_intro [l25]
l27: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen lrel → c ∊ y2_P_clen lrel $ by imp_intro [l26]
l28: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen lrel → c ∊ y2_P_clen lrel) $ by all_intro [l27]
l29: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen lrel → c ∊ y2_P_clen lrel) $ by all_intro [l28]

lemma y2_clen_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_clen lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_clen lrel → c ∊ y2_P_clen lrel) $ by y2_clen_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_clen lrel $ by horn_ind [l1, l2]

lrel_clen_det
-------------
l1: $ G ⇒ horn lprog ⊆ y2_P_clen lrel $ by y2_clen_in
l2: $ G ⇒ ra_clen t1 u2 ∈ y2_P_clen lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 $ by y2_clen_ih [l2, #2]

--| The atoms of `clen_c` whose variants in `L` with the same inputs have the same outputs.
def y2_P_clen_c (L: class) (.c .x1 .x2 .x6: set): class = $ {c | ∀ x1 ∀ x2 (c = ⟨ kr_clen_c , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons x1 (scons x6 ∅) ⟩ ∈ L → x2 = x6))} $

lemma y2_clen_c_ih (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ ra_clen_c q1 q2 ∈ y2_P_clen_c lrel $ > $ GG ⇒ ra_clen_c q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ c ∊ y2_P_clen_c lrel $ by ax
l2: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ ∀ x1 ∀ x2 (c = ⟨ kr_clen_c , scons x1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons x1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ ∀ x2 (c = ⟨ kr_clen_c , scons q1 (scons x2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons q1 (scons x6 ∅) ⟩ ∈ lrel → x2 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ c = ⟨ kr_clen_c , scons q1 (scons q2 ∅) ⟩ → ∀ x6 (⟨ kr_clen_c , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by all_elim [l3]
l5: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ c = ra_clen_c q1 q2 $ by ax
l6: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ ∀ x6 (⟨ kr_clen_c , scons q1 (scons x6 ∅) ⟩ ∈ lrel → q2 = x6) $ by imp_elim [l4, l5]
l7: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ ra_clen_c q1 w2 ∈ lrel → q2 = w2 $ by all_elim [l6]
l8: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ ra_clen_c q1 w2 ∈ lrel $ by weaken [#2]
l9: $ GG , c = ra_clen_c q1 q2 , c ∊ y2_P_clen_c lrel ⇒ q2 = w2 $ by imp_elim [l7, l8]
l10: $ GG ⇒ q2 = w2 $ by wcel_elim [#1, l9]

lemma y2_clen_c_ihc (GG: hyps) (Q1 Q2 W2: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ ra_clen_c Q1 Q2 ∈ y2_P_clen_c lrel $ > $ GG ⇒ ra_clen_c Q1 W2 ∈ lrel $ > $ GG ⇒ Q2 = W2 $
----
l1: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ d = W2 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q1 = a $ by eq_sym [l1]
l5: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = b $ by eq_sym [l2]
l6: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ W2 = d $ by eq_sym [l3]
l7: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ∅ = ∅ $ by eq_refl
l8: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q2 ∅ = scons b ∅ $ by scons_eq [l5, l7]
l9: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ scons Q1 (scons Q2 ∅) = scons a (scons b ∅) $ by scons_eq [l4, l8]
l10: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ kr_clen_c = kr_clen_c $ by eq_refl
l11: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen_c Q1 Q2 = ra_clen_c a b $ by opair_eq [l10, l9]
l12: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen_c Q1 Q2 ∈ y2_P_clen_c lrel $ by weaken [#4]
l13: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen_c a b ∈ y2_P_clen_c lrel $ by wcel_eq_l [l11, l12]
l14: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen_c Q1 W2 ∈ lrel $ by weaken [#5]
l15: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ ra_clen_c a d ∈ lrel $ by x1_eq_clen_c [l14, l4, l6]
l16: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ b = d $ by y2_clen_c_ih [l13, l15]
l17: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = d $ by eq_trans [l5, l16]
l18: $ GG , a = Q1 , b = Q2 , d = W2 ⇒ Q2 = W2 $ by eq_trans [l17, l3]
l19: $ GG , a = Q1 , b = Q2 ⇒ Q2 = W2 $ by isset_elim [#3, l18]
l20: $ GG , a = Q1 ⇒ Q2 = W2 $ by isset_elim [#2, l19]
l21: $ GG ⇒ Q2 = W2 $ by isset_elim [#1, l20]

lemma y2_clen_c_i1 (GG: hyps) (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ ∈ cl_clen_c_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ > $ GG ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil ⇒ w ∊ cl_clen_c_nil $ by ax
l2: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil ⇒ w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_clen_c q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_clen_c q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset (ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ ∧ ra_clen_c q1 q2 = ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ kr_clen_c , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_clen_c , scons ⟨ kc_cnil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_clen_c ∈ ω $ by x1_kr_clen_c
l15: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset kr_clen_c $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_cnil , ∅ ⟩ $ by opair_isset
l19: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by y2_nd2 [l13, l15, l16, l17, l18, l19]
l21: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l20]
l22: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l20]
l23: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l21, l22]
l24: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → ph $ by weaken [#3]
l25: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil , w = ⟨ ∅ , ra_clen_c ⟨ kc_cnil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ph $ by imp_elim [l24, l23]
l26: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_nil ⇒ ph $ by cut [l2, l25]
l27: $ GG ⇒ ph $ by wcel_elim [#1, l26]

lemma y2_clen_c_e1 (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ > $ GG ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_cnil , ∅ ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_cnil , ∅ ⟩ = ⟨ kc_cnil , ∅ ⟩ $ by eq_trans [l1, #3]
l3: $ GG ⇒ ∅ = ∅ $ by eq_refl
l4: $ GG ⇒ kc_nz = kc_nz $ by eq_refl
l5: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by opair_eq [l4, l3]
l6: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = w2 $ by eq_sym [#4]
l7: $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [#2, l5]
l8: $ GG ⇒ q2 = w2 $ by eq_trans [l7, l6]

lemma y2_clen_c_c1 (GG: hyps) (q1 q2 w2: set):
  $ GG ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ ra_clen_c q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ (q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by lrel_clen_c_cases [#2]
l2: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l2]
l7: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ w2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l2]
l8: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_clen_c_e1 [l4, l5, l6, l7]
l9: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel $ by ax
l10: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by weaken [#1]
l11: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ $ by and_elim_l [l10]
l12: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l10]
l13: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ $ by and_elim_l [l9]
l14: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel $ by and_elim_r [l9]
l15: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ w2 = ⟨ kc_s , scons d ∅ ⟩ $ by and_elim_l [l14]
l16: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ ra_clen_c b d ∈ lrel $ by and_elim_r [l14]
l17: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ kc_cnil ∈ kc_ccons $ by y2_lt_cnil_ccons
l18: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ kc_ccons ∈ ω $ by v1_kc_ccons
l19: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ isset kc_ccons $ by wcel_isset [l18]
l20: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ ⊥ $ by y2_ne [l11, l13, l17, l19]
l21: $ GG , q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel ⇒ q2 = w2 $ by bot_elim [l20]
l22: $ GG , ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by ax
l23: $ GG , ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l22, l21]
l24: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by ax
l25: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l24, l23]
l26: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) $ by ax
l27: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ccons , scons a (scons b ∅) ⟩ ∧ w2 = ⟨ kc_s , scons d ∅ ⟩ ∧ ra_clen_c b d ∈ lrel) ⇒ q2 = w2 $ by ex_elim [l26, l25]
l28: $ GG ⇒ q2 = w2 $ by or_elim [l1, l8, l27]

lemma y2_clen_c_d1 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ ∈ cl_clen_c_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ > $ GG ⇒ ra_clen_c q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_clen_c q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 $ by y2_clen_c_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_cnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ q2 = w2 $ by y2_clen_c_i1 [#1, #2, l4]

lemma y2_clen_c_i2 (GG: hyps) {K C n: set} (o q1 q2: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ ∈ cl_clen_c_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ > $ GG ⇒ ∀ K ∀ C ∀ n (q1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ ra_clen_c C n ∈ lrel ∧ ra_clen_c C n ∈ y2_P_clen_c lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons ⇒ w ∊ cl_clen_c_cons $ by ax
l2: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons ⇒ ∃ K ∃ C ∃ n (w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ w = ⟨ o , ra_clen_c q1 q2 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ o , ra_clen_c q1 q2 ⟩ = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen_c q1 q2) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen_c C n) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ scons (ra_clen_c C n) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (scons (ra_clen_c C n) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset (ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ o = scons (ra_clen_c C n) ∅ ∧ ra_clen_c q1 q2 = ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ o = scons (ra_clen_c C n) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ ⟨ kr_clen_c , scons q1 (scons q2 ∅) ⟩ = ⟨ kr_clen_c , scons ⟨ kc_ccons , scons K (scons C ∅) ⟩ (scons ⟨ kc_s , scons n ∅ ⟩ ∅) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ kr_clen_c ∈ ω $ by x1_kr_clen_c
l18: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset kr_clen_c $ by wcel_isset [l17]
l19: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset q1 $ by isset_var
l20: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset q2 $ by isset_var
l21: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset ⟨ kc_ccons , scons K (scons C ∅) ⟩ $ by opair_isset
l22: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ isset ⟨ kc_s , scons n ∅ ⟩ $ by opair_isset
l23: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by y2_nd2 [l16, l18, l19, l20, l21, l22]
l24: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q1 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ $ by and_elim_l [l23]
l25: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ q2 = ⟨ kc_s , scons n ∅ ⟩ $ by and_elim_r [l23]
l26: $ GG , w = ⟨ o , ra_clen_c q1 q2 ⟩ , w ∊ cl_clen_c_cons , w = ⟨ scons (ra_clen_c C n) ∅ , ra_clen_c ⟨ kc_ccons , scons K (scons C ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ ⟩ ⇒ crn o ⊆ horn lprog ∩ y2_P_clen_c lrel $ by weaken [#2]
