l8: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ x ∊ y1_lab kr_minor_idx (suc kr_minor_idx) $ by ex_elim [l8, l7]
