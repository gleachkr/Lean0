-- Inversion: reading a clause's disjunct off the equation of pairs.

lemma y1_e_le_z (G: hyps) {n_v: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_le t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_le t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_le ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_le t1 t2 = ra_le ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_le t1 t2 = ra_le ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V1 $ by isset_var
l15: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_le ∈ ω $ by x1_kr_le
l19: $ G ⇒ isset kr_le $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_le = kr_le ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ scons t2 ∅ = scons V1 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V1 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $ by ex_intro [l29]

lemma y1_d_le_z (G: hyps) {n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $
----
l1: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x ∊ cl_le_z ⇒ x ∊ cl_le_z $ by ax
l2: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x ∊ cl_le_z ⇒ ∃ y (x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_le t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_le t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_le t1 t2 ⟩ = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $ by y1_e_le_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x ∊ cl_le_z ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $ by wcel_elim [#1, l9]

lemma y1_e_le_s (G: hyps) {i_v n_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ = ⟨ scons (ra_le V1 V2) ∅ , ra_le ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_s , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le V1 V2) ∅ , ra_le ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_s , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_le t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le V1 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_le t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_le ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_s , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le V1 V2) ∅ ∧ ra_le t1 t2 = ra_le ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_s , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_le t1 t2 = ra_le ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_s , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_s , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_s , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_s , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_s , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_le ∈ ω $ by x1_kr_le
l19: $ G ⇒ isset kr_le $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_s , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_le = kr_le ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_s , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_s , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_s , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_s , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_le V1 V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_le V1 V2) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_le V1 V2) $ by opair_isset
l32: $ G ⇒ ra_le V1 V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ ra_le V1 V2 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ n_v (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le V1 n_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by ex_intro [l35]

lemma y1_d_le_s (G: hyps) {i_v n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x ∊ cl_le_s ⇒ x ∊ cl_le_s $ by ax
l2: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x ∊ cl_le_s ⇒ ∃ y ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_le t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_le t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_le t1 t2 ⟩ = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by y1_e_le_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_le t1 t2 ⟩ , x ∊ cl_le_s ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_o_le (G: hyps) {n_v i_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ pr_le $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s $ by ax
l2: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by y1_d_le_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s → ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s $ by ax
l6: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∨ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z $ by ax
l8: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) $ by y1_d_le_z [l7, l8]
l10: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s $ by ax
l12: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s → ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_s ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_le t1 t2 ⟩ ∈ cl_le_z ∪ cl_le_s → ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨ ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_add_z (G: hyps) {i_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ = ⟨ ∅ , ra_add V1 ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_add V1 ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_add t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_add t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_add V1 ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_add t1 t2 t3 = ra_add V1 ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_add t1 t2 t3 = ra_add V1 ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l16, l19]
l21: $ G ⇒ kr_add ∈ ω $ by x1_kr_add
l22: $ G ⇒ isset kr_add $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_add = kr_add ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l26, l14, l16, l13, l19]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l18, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $ by ex_intro [l36]

lemma y1_d_add_z (G: hyps) {i_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $
----
l1: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x ∊ cl_add_z ⇒ x ∊ cl_add_z $ by ax
l2: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x ∊ cl_add_z ⇒ ∃ y (x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_add t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $ by y1_e_add_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x ∊ cl_add_z ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $ by wcel_elim [#1, l9]

lemma y1_e_add_s (G: hyps) {i_v n_v j_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ = ⟨ scons (ra_add V1 V2 V3) ∅ , ra_add V1 ⟨ kc_s , scons V2 ∅ ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V1 V2 V3) ∅ , ra_add V1 ⟨ kc_s , scons V2 ∅ ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_add t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_add t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_add V1 ⟨ kc_s , scons V2 ∅ ⟩ ⟨ kc_s , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_add V1 V2 V3) ∅ ∧ ra_add t1 t2 t3 = ra_add V1 ⟨ kc_s , scons V2 ∅ ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_add V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_add t1 t2 t3 = ra_add V1 ⟨ kc_s , scons V2 ∅ ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_add ∈ ω $ by x1_kr_add
l23: $ G ⇒ isset kr_add $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_add = kr_add ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V2 ∅ ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_add V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_add V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_add V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_add V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_add V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_add V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_add V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ j_v (t1 = V1 ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add V1 V2 j_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ n_v ∃ j_v (t1 = V1 ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add V1 n_v j_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_intro [l44]

lemma y1_d_add_s (G: hyps) {i_v n_v j_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x ∊ cl_add_s ⇒ x ∊ cl_add_s $ by ax
l2: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x ∊ cl_add_s ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_add t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by y1_e_add_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_add y z u) ∅ , ra_add y ⟨ kc_s , scons z ∅ ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_add t1 t2 t3 ⟩ , x ∊ cl_add_s ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_add (G: hyps) {i_v n_v j_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ pr_add $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s $ by ax
l2: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by y1_d_add_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s → ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s $ by ax
l6: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∨ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z $ by ax
l8: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) $ by y1_d_add_z [l7, l8]
l10: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s $ by ax
l12: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s → ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_s ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_add t1 t2 t3 ⟩ ∈ cl_add_z ∪ cl_add_s → ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨ ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_lnth_z (G: hyps) {a_v S: set} (pp t1 t2 t3 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_lnth t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lnth t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_lnth ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_lnth t1 t2 t3 = ra_lnth ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lnth t1 t2 t3 = ra_lnth ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_lnth ∈ ω $ by x1_kr_lnth
l23: $ G ⇒ isset kr_lnth $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_lnth = kr_lnth ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l32, l35]
l37: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l29, l36]
l38: $ G ⇒ ∃ S (t1 = ⟨ kc_lcons , scons V1 (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1) $ by ex_intro [l37]
l39: $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $ by ex_intro [l38]

lemma y1_d_lnth_z (G: hyps) {a_v S: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $
----
l1: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x ∊ cl_lnth_z ⇒ x ∊ cl_lnth_z $ by ax
l2: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x ∊ cl_lnth_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $ by y1_e_lnth_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_lnth ⟨ kc_lcons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x ∊ cl_lnth_z ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $ by wcel_elim [#1, l11]

lemma y1_e_lnth_s (G: hyps) {a_v b_v S n_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ = ⟨ scons (ra_lnth V3 V4 V2) ∅ , ra_lnth ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lnth V3 V4 V2) ∅ , ra_lnth ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 ⟩ = ⟨ pp , ra_lnth t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lnth V3 V4 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lnth t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_lnth ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lnth V3 V4 V2) ∅ ∧ ra_lnth t1 t2 t3 = ra_lnth ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lnth V3 V4 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lnth t1 t2 t3 = ra_lnth ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_lnth ∈ ω $ by x1_kr_lnth
l23: $ G ⇒ isset kr_lnth $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_lnth = kr_lnth ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t3 ∅ = scons V2 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V2 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_lnth V3 V4 V2) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_lnth V3 V4 V2) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_lnth V3 V4 V2) $ by opair_isset
l39: $ G ⇒ ra_lnth V3 V4 V2 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V2 ∧ ra_lnth V3 V4 V2 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V2 ∧ ra_lnth V3 V4 V2 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V2 ∧ ra_lnth V3 V4 V2 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ n_v (t1 = ⟨ kc_lcons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = V2 ∧ ra_lnth V3 n_v V2 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons V1 (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = V2 ∧ ra_lnth S n_v V2 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons V1 (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by ex_intro [l45]

lemma y1_d_lnth_s (G: hyps) {a_v b_v S n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x ∊ cl_lnth_s ⇒ x ∊ cl_lnth_s $ by ax
l2: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x ∊ cl_lnth_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by y1_e_lnth_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_lnth u v z) ∅ , ra_lnth ⟨ kc_lcons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lnth t1 t2 t3 ⟩ , x ∊ cl_lnth_s ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_lnth (G: hyps) {a_v S b_v n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ pr_lnth $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s $ by ax
l2: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by y1_d_lnth_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s → ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s $ by ax
l6: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∨ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z $ by ax
l8: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) $ by y1_d_lnth_z [l7, l8]
l10: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s $ by ax
l12: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s → ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_s ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_lnth t1 t2 t3 ⟩ ∈ cl_lnth_z ∪ cl_lnth_s → ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_linst_z (G: hyps) {S: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ ∅ , ra_linst V1 ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_linst V1 ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_linst t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_linst V1 ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_lz , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_lz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset V1 $ by isset_var
l20: $ G ⇒ scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_linst ∈ ω $ by x1_kr_linst
l22: $ G ⇒ isset kr_linst $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_linst = kr_linst ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_lz , ∅ ⟩ (scons ⟨ kc_lz , ∅ ⟩ ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_lz , ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_lz , ∅ ⟩ ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_lz , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons ⟨ kc_lz , ∅ ⟩ ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = ⟨ kc_lz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = ⟨ kc_lz , ∅ ⟩ $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩ $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩ $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) $ by ex_intro [l36]

lemma y1_d_linst_z (G: hyps) {S: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ ∈ cl_linst_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_z ⇒ x ∊ cl_linst_z $ by ax
l2: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_z ⇒ ∃ y (x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_linst y ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ⟩ ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) $ by y1_e_linst_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_z ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_linst_s (G: hyps) {S a_v a2: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_linst V1 V2 V3) ∅ , ra_linst V1 ⟨ kc_ls , scons V2 ∅ ⟩ ⟨ kc_ls , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_linst V1 V2 V3) ∅ , ra_linst V1 ⟨ kc_ls , scons V2 ∅ ⟩ ⟨ kc_ls , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_linst V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_linst t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_linst V1 ⟨ kc_ls , scons V2 ∅ ⟩ ⟨ kc_ls , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_linst V1 V2 V3) ∅ ∧ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_ls , scons V2 ∅ ⟩ ⟨ kc_ls , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_linst V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_ls , scons V2 ∅ ⟩ ⟨ kc_ls , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_ls , scons V3 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_ls , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_linst ∈ ω $ by x1_kr_linst
l23: $ G ⇒ isset kr_linst $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_linst = kr_linst ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_ls , scons V2 ∅ ⟩ (scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_ls , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_ls , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_ls , scons V3 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_linst V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_linst V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_linst V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_linst V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_ls , scons V3 ∅ ⟩ ∧ ra_linst V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons V3 ∅ ⟩ ∧ ra_linst V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons V3 ∅ ⟩ ∧ ra_linst V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ a2 (t1 = V1 ∧ t2 = ⟨ kc_ls , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst V1 V2 a2 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ a_v ∃ a2 (t1 = V1 ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst V1 a_v a2 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $ by ex_intro [l44]

lemma y1_d_linst_s (G: hyps) {S a_v a2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ ∈ cl_linst_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_s ⇒ x ∊ cl_linst_s $ by ax
l2: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_s ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩ ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $ by y1_e_linst_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_linst y z u) ∅ , ra_linst y ⟨ kc_ls , scons z ∅ ⟩ ⟨ kc_ls , scons u ∅ ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_s ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_linst_max (G: hyps) {S a_v b_v a2 b2: set} (pp t1 t2 t3 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) , ra_linst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) , ra_linst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ⟩ = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_linst t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_linst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) ∧ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_linst ∈ ω $ by x1_kr_linst
l23: $ G ⇒ isset kr_linst $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_linst = kr_linst ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 ∅ = scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅)) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅)) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_linst V1 V2 V4) $ by opair_isset
l39: $ G ⇒ ra_linst V1 V2 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_linst V1 V3 V5) ∅) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_linst V1 V3 V5) $ by opair_isset
l42: $ G ⇒ ra_linst V1 V3 V5 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l39, l42]
l44: $ G ⇒ t3 = ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l35, l43]
l45: $ G ⇒ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l32, l44]
l46: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons V4 (scons V5 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l29, l45]
l47: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons V4 (scons b2 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 b2 ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ a2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst V1 V2 a2 ∈ lrel ∧ ra_linst V1 V3 b2 ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ b_v ∃ a2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons V2 (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst V1 V2 a2 ∈ lrel ∧ ra_linst V1 b_v b2 ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst V1 a_v a2 ∈ lrel ∧ ra_linst V1 b_v b2 ∈ lrel) $ by ex_intro [l49]
l51: $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_intro [l50]

lemma y1_d_linst_max (G: hyps) {S a_v b_v a2 b2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ ∈ cl_linst_max $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_max ⇒ x ∊ cl_linst_max $ by ax
l2: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_max ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩ ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by y1_e_linst_max [l6, l7]
l9: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_lmax , scons z (scons u ∅) ⟩ ⟨ kc_lmax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_max ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_e_linst_imax (G: hyps) {S a_v b_v a2 b2: set} (pp t1 t2 t3 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) , ra_linst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) , ra_linst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ⟩ = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_linst t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_linst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) ∧ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_linst ∈ ω $ by x1_kr_linst
l23: $ G ⇒ isset kr_linst $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_linst = kr_linst ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ (scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 ∅ = scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅)) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_linst V1 V2 V4) (scons (ra_linst V1 V3 V5) ∅)) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_linst V1 V2 V4) $ by opair_isset
l39: $ G ⇒ ra_linst V1 V2 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_linst V1 V3 V5) ∅) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_linst V1 V3 V5) $ by opair_isset
l42: $ G ⇒ ra_linst V1 V3 V5 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l39, l42]
l44: $ G ⇒ t3 = ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l35, l43]
l45: $ G ⇒ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l32, l44]
l46: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons V4 (scons V5 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 V5 ∈ lrel $ by and_intro [l29, l45]
l47: $ G ⇒ ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons V4 (scons b2 ∅) ⟩ ∧ ra_linst V1 V2 V4 ∈ lrel ∧ ra_linst V1 V3 b2 ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ a2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons V3 ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst V1 V2 a2 ∈ lrel ∧ ra_linst V1 V3 b2 ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ b_v ∃ a2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons V2 (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst V1 V2 a2 ∈ lrel ∧ ra_linst V1 b_v b2 ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = V1 ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst V1 a_v a2 ∈ lrel ∧ ra_linst V1 b_v b2 ∈ lrel) $ by ex_intro [l49]
l51: $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_intro [l50]

lemma y1_d_linst_imax (G: hyps) {S a_v b_v a2 b2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ ∈ cl_linst_imax $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_imax ⇒ x ∊ cl_linst_imax $ by ax
l2: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_imax ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩ ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by y1_e_linst_imax [l6, l7]
l9: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_linst y z v) (scons (ra_linst y u w) ∅) , ra_linst y ⟨ kc_limax , scons z (scons u ∅) ⟩ ⟨ kc_limax , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_imax ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_e_linst_param (G: hyps) {S n_v a_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_lnth V1 V2 V3) ∅ , ra_linst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lnth V1 V2 V3) ∅ , ra_linst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 ⟩ = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lnth V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_linst t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_linst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lnth V1 V2 V3) ∅ ∧ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lnth V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_linst t1 t2 t3 = ra_linst V1 ⟨ kc_lparam , scons V2 ∅ ⟩ V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V3 $ by isset_var
l17: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_lparam , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_linst ∈ ω $ by x1_kr_linst
l23: $ G ⇒ isset kr_linst $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_linst = kr_linst ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons V3 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V3 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_lnth V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_lnth V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_lnth V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_lnth V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V3 ∧ ra_lnth V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ ra_lnth V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ ra_lnth V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth V1 V2 a_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ n_v ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth V1 n_v a_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $ by ex_intro [l44]

lemma y1_d_linst_param (G: hyps) {S n_v a_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ ∈ cl_linst_param $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_param ⇒ x ∊ cl_linst_param $ by ax
l2: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_param ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ x = ⟨ pp , ra_linst t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩ ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $ by y1_e_linst_param [l6, l7]
l9: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_lnth y z u) ∅ , ra_linst y ⟨ kc_lparam , scons z ∅ ⟩ u ⟩) ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_linst t1 t2 t3 ⟩ , x ∊ cl_linst_param ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_linst (G: hyps) {S a_v a2 b_v b2 n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_linst t1 t2 t3 ⟩ ∈ pr_linst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) ∨ ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) ∨ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) ∨ ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) ∨ ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $
