l48: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by or_elim [l1, l22, l47]

lemma y2_isort_d2 (GG: hyps) (o q1 q2 q3 w2 w3: set):
  $ GG ⇒ ⟨ o , ra_isort q1 q2 q3 ⟩ ∈ cl_isort_pi $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ > $ GG ⇒ ra_isort q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel ⇒ q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel $ by ax
l2: $ GG , q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel ⇒ ra_isort q1 w2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel ⇒ q2 = w2 ∧ q3 = w3 $ by y2_isort_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel → q2 = w2 ∧ q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = ⟨ kc_pi , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons d ∅ ⟩ ∧ q3 = e ∧ ra_isort b d e ∈ lrel ∧ ra_isort b d e ∈ y2_P_isort lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l7]
l9: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by y2_isort_i2 [#1, #2, l8]

lemma y2_isort_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_isort lrel → c ∊ y2_P_isort lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ c = ra_isort x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_isort x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ pr_isort $ by lprog_isort_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ra_isort x1 x6 x7 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_srt ⇒ ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_srt $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_srt ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_srt ⇒ ra_isort x1 x6 x7 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_srt ⇒ x2 = x6 ∧ x3 = x7 $ by y2_isort_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_pi ⇒ ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_pi $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_pi ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_pi ⇒ ra_isort x1 x6 x7 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel , ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_pi ⇒ x2 = x6 ∧ x3 = x7 $ by y2_isort_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_pi → x2 = x6 ∧ x3 = x7 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_isort x1 x2 x3 ⟩ ∈ cl_isort_srt ∪ cl_isort_pi → x2 = x6 ∧ x3 = x7 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 , ra_isort x1 x6 x7 ∈ lrel ⇒ x2 = x6 ∧ x3 = x7 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 ⇒ ra_isort x1 x6 x7 ∈ lrel → x2 = x6 ∧ x3 = x7 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 ⇒ ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel , c = ra_isort x1 x2 x3 ⇒ ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7) $ by all_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel ⇒ c = ⟨ kr_isort , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7) $ by imp_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel ⇒ ∀ x3 (c = ⟨ kr_isort , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_isort , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_isort , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_isort , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_isort lrel ⇒ c ∊ y2_P_isort lrel $ by cab_intro [l26]
l28: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_isort lrel → c ∊ y2_P_isort lrel $ by imp_intro [l27]
l29: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_isort lrel → c ∊ y2_P_isort lrel $ by imp_intro [l28]
l30: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_isort lrel → c ∊ y2_P_isort lrel) $ by all_intro [l29]
l31: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_isort lrel → c ∊ y2_P_isort lrel) $ by all_intro [l30]

lemma y2_isort_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_isort lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_isort lrel → c ∊ y2_P_isort lrel) $ by y2_isort_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_isort lrel $ by horn_ind [l1, l2]

lrel_isort_det
--------------
l1: $ G ⇒ horn lprog ⊆ y2_P_isort lrel $ by y2_isort_in
l2: $ G ⇒ ra_isort t1 u2 u3 ∈ y2_P_isort lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 ∧ u3 = v3 $ by y2_isort_ih [l2, #2]

--| The atoms of `ndecl` whose variants in `L` with the same inputs have the same outputs.
def y2_P_ndecl (L: class) (.c .x1 .x2 .x3 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_ndecl , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ L → x3 = x6))} $

lemma y2_ndecl_ih (GG: hyps) (q1 q2 q3 w3: set):
  $ GG ⇒ ra_ndecl q1 q2 q3 ∈ y2_P_ndecl lrel $ > $ GG ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ c ∊ y2_P_ndecl lrel $ by ax
l2: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_ndecl , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons x1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_ndecl , scons q1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons q1 (scons x2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ ∀ x3 (c = ⟨ kr_ndecl , scons q1 (scons q2 (scons x3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → x3 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ c = ⟨ kr_ndecl , scons q1 (scons q2 (scons q3 ∅)) ⟩ → ∀ x6 (⟨ kr_ndecl , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by all_elim [l4]
l6: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ c = ra_ndecl q1 q2 q3 $ by ax
l7: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ ∀ x6 (⟨ kr_ndecl , scons q1 (scons q2 (scons x6 ∅)) ⟩ ∈ lrel → q3 = x6) $ by imp_elim [l5, l6]
l8: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ ra_ndecl q1 q2 w3 ∈ lrel → q3 = w3 $ by all_elim [l7]
l9: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ by weaken [#2]
l10: $ GG , c = ra_ndecl q1 q2 q3 , c ∊ y2_P_ndecl lrel ⇒ q3 = w3 $ by imp_elim [l8, l9]
l11: $ GG ⇒ q3 = w3 $ by wcel_elim [#1, l10]

lemma y2_ndecl_ihc (GG: hyps) (Q1 Q2 Q3 W3: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ ra_ndecl Q1 Q2 Q3 ∈ y2_P_ndecl lrel $ > $ GG ⇒ ra_ndecl Q1 Q2 W3 ∈ lrel $ > $ GG ⇒ Q3 = W3 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ e = W3 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q1 = a $ by eq_sym [l1]
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q2 = b $ by eq_sym [l2]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = d $ by eq_sym [l3]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ W3 = e $ by eq_sym [l4]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ∅ = ∅ $ by eq_refl
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q3 ∅ = scons d ∅ $ by scons_eq [l7, l9]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q2 (scons Q3 ∅) = scons b (scons d ∅) $ by scons_eq [l6, l10]
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ scons Q1 (scons Q2 (scons Q3 ∅)) = scons a (scons b (scons d ∅)) $ by scons_eq [l5, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ kr_ndecl = kr_ndecl $ by eq_refl
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_ndecl Q1 Q2 Q3 = ra_ndecl a b d $ by opair_eq [l13, l12]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_ndecl Q1 Q2 Q3 ∈ y2_P_ndecl lrel $ by weaken [#5]
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_ndecl a b d ∈ y2_P_ndecl lrel $ by wcel_eq_l [l14, l15]
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_ndecl Q1 Q2 W3 ∈ lrel $ by weaken [#6]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ ra_ndecl a b e ∈ lrel $ by x1_eq_ndecl [l17, l5, l6, l8]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ d = e $ by y2_ndecl_ih [l16, l18]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = e $ by eq_trans [l7, l19]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = W3 ⇒ Q3 = W3 $ by eq_trans [l20, l4]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q3 = W3 $ by isset_elim [#4, l21]
l23: $ GG , a = Q1 , b = Q2 ⇒ Q3 = W3 $ by isset_elim [#3, l22]
l24: $ GG , a = Q1 ⇒ Q3 = W3 $ by isset_elim [#2, l23]
l25: $ GG ⇒ Q3 = W3 $ by isset_elim [#1, l24]

lemma y2_ndecl_i1 (GG: hyps) {n: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ ∈ cl_ndecl_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ndecl lrel $ > $ GG ⇒ ∀ n (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = n ∧ q3 = n → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil ⇒ w ∊ cl_ndecl_nil $ by ax
l2: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil ⇒ ∃ n (w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ ⟨ o , ra_ndecl q1 q2 q3 ⟩ = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset (ra_ndecl q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset ∅ $ by ax_empty
l10: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset (ra_ndecl ⟨ kc_nil , ∅ ⟩ n n) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ o = ∅ ∧ ra_ndecl q1 q2 q3 = ra_ndecl ⟨ kc_nil , ∅ ⟩ n n $ by opair_inj_c [l6, l7, l8, l9, l10]
l12: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ o = ∅ $ by and_elim_l [l11]
l13: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ ⟨ kr_ndecl , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_ndecl , scons ⟨ kc_nil , ∅ ⟩ (scons n (scons n ∅)) ⟩ $ by and_elim_r [l11]
l14: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ kr_ndecl ∈ ω $ by x1_kr_ndecl
l15: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset kr_ndecl $ by wcel_isset [l14]
l16: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset q1 $ by isset_var
l17: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset q2 $ by isset_var
l18: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset q3 $ by isset_var
l19: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l20: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset n $ by isset_var
l21: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ isset n $ by isset_var
l22: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = n ∧ q3 = n $ by y2_nd3 [l13, l15, l16, l17, l18, l19, l20, l21]
l23: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l22]
l24: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q2 = n ∧ q3 = n $ by and_elim_r [l22]
l25: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q2 = n $ by and_elim_l [l24]
l26: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q3 = n $ by and_elim_r [l24]
l27: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q2 = n ∧ q3 = n $ by and_intro [l25, l26]
l28: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = n ∧ q3 = n $ by and_intro [l23, l27]
l29: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ ∀ n (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = n ∧ q3 = n → ph) $ by weaken [#3]
l30: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = n ∧ q3 = n → ph $ by all_elim [l29]
l31: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil , w = ⟨ ∅ , ra_ndecl ⟨ kc_nil , ∅ ⟩ n n ⟩ ⇒ ph $ by imp_elim [l30, l28]
l32: $ GG , w = ⟨ o , ra_ndecl q1 q2 q3 ⟩ , w ∊ cl_ndecl_nil ⇒ ph $ by ex_elim [l2, l31]
l33: $ GG ⇒ ph $ by wcel_elim [#1, l32]

lemma y2_ndecl_e1 (GG: hyps) (q1 q2 q3 w3 u_n v_n: set):
  $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q2 = u_n $ > $ GG ⇒ q3 = u_n $ > $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ > $ GG ⇒ q2 = v_n $ > $ GG ⇒ w3 = v_n $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_nil , ∅ ⟩ $ by eq_trans [l1, #4]
l3: $ GG ⇒ u_n = q2 $ by eq_sym [#2]
l4: $ GG ⇒ u_n = v_n $ by eq_trans [l3, #5]
l5: $ GG ⇒ v_n = w3 $ by eq_sym [#6]
l6: $ GG ⇒ q3 = v_n $ by eq_trans [#3, l4]
l7: $ GG ⇒ q3 = w3 $ by eq_trans [l6, l5]

lemma y2_ndecl_c1 (GG: hyps) (q1 q2 q3 w3 u_n: set):
  $ GG ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = u_n ∧ q3 = u_n $ > $ GG ⇒ ra_ndecl q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ∨ ∃ b ∃ d ∃ a ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel) $ by lrel_ndecl_cases [#2]
l2: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = u_n ∧ q3 = u_n $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = u_n ∧ q3 = u_n $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = u_n $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = u_n $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l2]
l9: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a ∧ w3 = a $ by and_elim_r [l2]
l10: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q2 = a $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a ⇒ q3 = w3 $ by y2_ndecl_e1 [l4, l6, l7, l8, l10, l11]
l13: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) $ by ax
l14: $ GG , ∃ a (q1 = ⟨ kc_nil , ∅ ⟩ ∧ q2 = a ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l13, l12]
