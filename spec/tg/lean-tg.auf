lemma y1_d_spz_ctors_nil (G: hyps) {D N I X ni npi: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_spz_ctors_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ I ∃ X ∃ ni ∃ npi (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_cnil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_spz_ctors_nil ⇒ x ∊ cl_spz_ctors_nil $ by ax
