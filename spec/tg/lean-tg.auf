lemma y1_k_lsubst_eq (G: hyps): $ G ⇒ cl_lsubst_eq ⊆ y1_lab kr_lsubst (suc kr_lsubst) $
----
l1: $ G , x ∊ cl_lsubst_eq ⇒ x ∊ cl_lsubst_eq $ by ax
l2: $ G , x ∊ cl_lsubst_eq ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ kr_lsubst ∈ ω $ by x1_kr_lsubst
l5: $ G , x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩ ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_lsubst y ⟨ kc_lparam , scons y ∅ ⟩ z z ⟩) ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_lsubst_eq ⇒ x ∊ y1_lab kr_lsubst (suc kr_lsubst) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_lsubst_eq ⊆ y1_lab kr_lsubst (suc kr_lsubst) $ by subset_intro [l8]

