l50: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ mn ∃ b_v ∃ f_v ∃ Y ∃ X1 ∃ X2 ∃ X3 ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = A ∧ t11 = ⟨ kc_app , scons X3 (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y X2 ni A X3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v nf a_v ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add a_v mn b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons j_v (scons v_v ∅)) ⟩ b_v np X1 ∈ lrel ∧ ra_pargs X1 a_v mn X2 ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by wcel_elim [#1, l49]

lemma y1_o_ihval (G: hyps) {D np n_v m_v v_v nf fld y_v j_v A B IH ni k_v a_v mn b_v f_v Y X1 X2 X3 U: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set):
  $ G ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ ∈ pr_ihval $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons A (scons IH ∅) ⟩ ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ mn ∃ b_v ∃ f_v ∃ Y ∃ X1 ∃ X2 ∃ X3 ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = A ∧ t11 = ⟨ kc_app , scons X3 (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y X2 ni A X3 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v nf a_v ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add a_v mn b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons j_v (scons v_v ∅)) ⟩ b_v np X1 ∈ lrel ∧ ra_pargs X1 a_v mn X2 ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $
----
