l45: $ G ⇒ t1 = ⟨ kc_ind_mkn , scons V1 (scons V2 (scons V3 (scons V4 ∅))) ⟩ ∧ t2 = V1 ∧ t3 = V2 ∧ t4 = V3 $ by and_intro [l33, l44]
