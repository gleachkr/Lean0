l7: $ GG , c = ra_rehead q1 q2 q3 q4 q5 , c ∊ y2_P_rehead lrel ⇒ c = ⟨ kr_rehead , scons q1 (scons q2 (scons q3 (scons q4 (scons q5 ∅)))) ⟩ → ∀ x6 ∀ x7 (⟨ kr_rehead , scons x6 (scons q2 (scons q3 (scons q4 (scons x7 ∅)))) ⟩ ∈ lrel → q1 = x6 ∧ q5 = x7) $ by all_elim [l6]
