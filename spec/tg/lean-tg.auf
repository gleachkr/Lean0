lemma v1_ent_nz (G: hyps) (c k a: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ $ > $ G ⇒ c = kc_nz ∧ k = ks_nat ∧ a = ∅ $
----
l1: $ G ⇒ kc_nz ∈ ω $ by v1_kc_nz
l2: $ G ⇒ isset kc_nz $ by wcel_isset [l1]
l3: $ G ⇒ ks_nat ∈ ω $ by v1_ks_nat
l4: $ G ⇒ isset ks_nat $ by wcel_isset [l3]
l5: $ G ⇒ ∅ ∈ fseq ω $ by v1_args_nz
l6: $ G ⇒ isset ∅ $ by wcel_isset [l5]
l7: $ G ⇒ c = kc_nz ∧ k = ks_nat ∧ a = ∅ $ by v1_ent [l2, l4, l6, #1]

lemma v1_skip_nz (G: hyps) (c k a: set) (R: class) (p: fml):
  $ G ⇒ k = ks_nat → ⊥ $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ R → p $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ∪ R → p $
----
l1: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ $ by ax
l2: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ c = kc_nz ∧ k = ks_nat ∧ a = ∅ $ by v1_ent_nz [l1]
l3: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ k = ks_nat ∧ a = ∅ $ by and_elim_r [l2]
l4: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ k = ks_nat $ by and_elim_l [l3]
l5: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ k = ks_nat → ⊥ $ by weaken [#1]
l6: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ ⊥ $ by imp_elim [l5, l4]
l7: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ p $ by bot_elim [l6]
l8: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ∪ R → p $ by v1_cun_imp [l7, #2]

lemma v1_take_nz (G: hyps) (c k a: set) (R: class) (p: fml):
  $ G , c = kc_nz ∧ a = ∅ ⇒ p $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ R → p $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ∪ R → p $
----
l1: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ $ by ax
l2: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ c = kc_nz ∧ k = ks_nat ∧ a = ∅ $ by v1_ent_nz [l1]
l3: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ c = kc_nz $ by and_elim_l [l2]
l4: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ k = ks_nat ∧ a = ∅ $ by and_elim_r [l2]
l5: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ a = ∅ $ by and_elim_r [l4]
l6: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ c = kc_nz ∧ a = ∅ $ by and_intro [l3, l5]
l7: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_nz , ⟨ ks_nat , ∅ ⟩ ⟩ ⇒ p $ by cut [l6, #1]
