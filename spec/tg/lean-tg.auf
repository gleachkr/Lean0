l3: $ G ⇒ scons A2 (scons A3 ∅) = scons B2 (scons B3 ∅) $ by scons_eq [#2, l2]
l4: $ G ⇒ scons A1 (scons A2 (scons A3 ∅)) = scons B1 (scons B2 (scons B3 ∅)) $ by scons_eq [#1, l3]
l5: $ G ⇒ kr_add = kr_add $ by eq_refl
l6: $ G ⇒ ⟨ kr_add , scons A1 (scons A2 (scons A3 ∅)) ⟩ = ⟨ kr_add , scons B1 (scons B2 (scons B3 ∅)) ⟩ $ by opair_eq [l5, l4]

