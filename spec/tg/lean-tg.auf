l36: $ GG , w = ⟨ o , ra_ind_nested q1 q2 ⟩ , w ∊ cl_ind_nested_mkn ⇒ ph $ by ex_elim [l2, l35]
l37: $ GG ⇒ ph $ by wcel_elim [#1, l36]

lemma y2_ind_nested_e2 (GG: hyps) (q1 q2 w2 u_b u_P u_T u_N v_b v_P v_T v_N: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ $ > $ GG ⇒ q2 = u_N $ > $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons v_b (scons v_P (scons v_T (scons v_N ∅))) ⟩ $ > $ GG ⇒ w2 = v_N $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ = ⟨ kc_ind_mkn , scons v_b (scons v_P (scons v_T (scons v_N ∅))) ⟩ $ by eq_trans [l1, #3]
l3: $ GG ⇒ kc_ind_mkn ∈ ω $ by v1_kc_ind_mkn
l4: $ GG ⇒ isset kc_ind_mkn $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_b $ by isset_var
l6: $ GG ⇒ isset u_P $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset u_N $ by isset_var
l9: $ GG ⇒ isset v_b $ by isset_var
l10: $ GG ⇒ isset v_P $ by isset_var
l11: $ GG ⇒ isset v_T $ by isset_var
l12: $ GG ⇒ isset v_N $ by isset_var
l13: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T ∧ u_N = v_N $ by y2_nd4 [l2, l4, l5, l6, l7, l8, l9, l10, l11, l12]
l14: $ GG ⇒ u_b = v_b $ by and_elim_l [l13]
l15: $ GG ⇒ u_P = v_P ∧ u_T = v_T ∧ u_N = v_N $ by and_elim_r [l13]
l16: $ GG ⇒ u_P = v_P $ by and_elim_l [l15]
l17: $ GG ⇒ u_T = v_T ∧ u_N = v_N $ by and_elim_r [l15]
l18: $ GG ⇒ u_T = v_T $ by and_elim_l [l17]
l19: $ GG ⇒ u_N = v_N $ by and_elim_r [l17]
l20: $ GG ⇒ v_N = w2 $ by eq_sym [#4]
l21: $ GG ⇒ q2 = v_N $ by eq_trans [#2, l19]
l22: $ GG ⇒ q2 = w2 $ by eq_trans [l21, l20]

lemma y2_ind_nested_c2 (GG: hyps) (q1 q2 w2 u_b u_P u_T u_N: set):
  $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ ∧ q2 = u_N $ > $ GG ⇒ ra_ind_nested q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by lrel_ind_nested_cases [#2]
l2: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ $ by ax
l3: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ ∧ q2 = u_N $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q2 = u_N $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ $ by and_elim_l [l2]
l7: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ w2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l2]
l8: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ kc_ind_mk ∈ kc_ind_mkn $ by y2_lt_ind_mk_ind_mkn
l9: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ kc_ind_mkn ∈ ω $ by v1_kc_ind_mkn
l10: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ isset kc_ind_mkn $ by wcel_isset [l9]
l11: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ ⊥ $ by y2_ne [l6, l4, l8, l10]
l12: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩ ⇒ q2 = w2 $ by bot_elim [l11]
l13: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) $ by ax
l14: $ GG , ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l13, l12]
l15: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) $ by ax
l16: $ GG , ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l15, l14]
l17: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) $ by ax
l18: $ GG , ∃ a ∃ b ∃ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ w2 = ⟨ kc_nil , ∅ ⟩) ⇒ q2 = w2 $ by ex_elim [l17, l16]
l19: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e $ by ax
l20: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ ∧ q2 = u_N $ by weaken [#1]
l21: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons u_b (scons u_P (scons u_T (scons u_N ∅))) ⟩ $ by and_elim_l [l20]
l22: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q2 = u_N $ by and_elim_r [l20]
l23: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ $ by and_elim_l [l19]
l24: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ w2 = e $ by and_elim_r [l19]
l25: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e ⇒ q2 = w2 $ by y2_ind_nested_e2 [l21, l22, l23, l24]
l26: $ GG , ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l27: $ GG , ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l26, l25]
l28: $ GG , ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l29: $ GG , ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l28, l27]
l30: $ GG , ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l31: $ GG , ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l30, l29]
l32: $ GG , ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) $ by ax
l33: $ GG , ∃ a ∃ b ∃ d ∃ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ w2 = e) ⇒ q2 = w2 $ by ex_elim [l32, l31]
l34: $ GG ⇒ q2 = w2 $ by or_elim [l1, l18, l33]

lemma y2_ind_nested_d2 (GG: hyps) (o q1 q2 w2: set):
  $ GG ⇒ ⟨ o , ra_ind_nested q1 q2 ⟩ ∈ cl_ind_nested_mkn $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel $ > $ GG ⇒ ra_ind_nested q1 w2 ∈ lrel $ > $ GG ⇒ q2 = w2 $
----
l1: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e $ by ax
l2: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e ⇒ ra_ind_nested q1 w2 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e ⇒ q2 = w2 $ by y2_ind_nested_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e → q2 = w2 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e → q2 = w2) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e → q2 = w2) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e → q2 = w2) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = ⟨ kc_ind_mkn , scons a (scons b (scons d (scons e ∅))) ⟩ ∧ q2 = e → q2 = w2) $ by all_intro [l7]
l9: $ GG ⇒ q2 = w2 $ by y2_ind_nested_i2 [#1, #2, l8]

lemma y2_ind_nested_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel → c ∊ y2_P_ind_nested lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel , c = ra_ind_nested x1 x2 , ra_ind_nested x1 x6 ∈ lrel ⇒ c = ra_ind_nested x1 x2 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel , c = ra_ind_nested x1 x2 , ra_ind_nested x1 x6 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ind_nested lrel , c = ra_ind_nested x1 x2 , ra_ind_nested x1 x6 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_ind_nested x1 x2 ⟩ $ by opair_eq [l2, l1]
