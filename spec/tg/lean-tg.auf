lemma y1_d_ctor_ty_i (G: hyps) {D b_v P N T i_v c_v np n_v m_v F K K2 K3 R C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ ∈ cl_ctor_ty_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ K3 ∃ R ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_rst D N K2 K3 ∈ lrel ∧ ra_pis P K3 R ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ , x ∊ cl_ctor_ty_i ⇒ x ∊ cl_ctor_ty_i $ by ax
l2: $ G , x = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ , x ∊ cl_ctor_ty_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h (x = ⟨ scons (ra_ind_data y z u w) (scons (ra_nth_ty w a i h) (scons (ra_nth_ctor h b j) (scons (ra_clen u c) (scons (ra_ntys w f g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c j k) (scons (ra_ind_nested y v) (scons (ra_rst y v k d) (scons (ra_pis u d e) ∅)))))))) , ra_ctor_ty y a b e ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u w) (scons (ra_nth_ty w a i h) (scons (ra_nth_ctor h b j) (scons (ra_clen u c) (scons (ra_ntys w f g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c j k) (scons (ra_ind_nested y v) (scons (ra_rst y v k d) (scons (ra_pis u d e) ∅)))))))) , ra_ctor_ty y a b e ⟩ ⇒ x = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u w) (scons (ra_nth_ty w a i h) (scons (ra_nth_ctor h b j) (scons (ra_clen u c) (scons (ra_ntys w f g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c j k) (scons (ra_ind_nested y v) (scons (ra_rst y v k d) (scons (ra_pis u d e) ∅)))))))) , ra_ctor_ty y a b e ⟩ ⇒ ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u w) (scons (ra_nth_ty w a i h) (scons (ra_nth_ctor h b j) (scons (ra_clen u c) (scons (ra_ntys w f g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c j k) (scons (ra_ind_nested y v) (scons (ra_rst y v k d) (scons (ra_pis u d e) ∅)))))))) , ra_ctor_ty y a b e ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u w) (scons (ra_nth_ty w a i h) (scons (ra_nth_ctor h b j) (scons (ra_clen u c) (scons (ra_ntys w f g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ f c j k) (scons (ra_ind_nested y v) (scons (ra_rst y v k d) (scons (ra_pis u d e) ∅)))))))) , ra_ctor_ty y a b e ⟩ $ by ax
