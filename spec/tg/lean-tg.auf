l37: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))))) ∈ fseq y1_vv $ by y1_fs [l36, l35]
l38: $ G ⇒ isset V2 $ by isset_var
l39: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅)))))) ∈ fseq y1_vv $ by y1_fs [l38, l37]
l40: $ G ⇒ isset V1 $ by isset_var
l41: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))))))) ∈ fseq y1_vv $ by y1_fs [l40, l39]
