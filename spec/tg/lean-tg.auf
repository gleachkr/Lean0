lemma y1_e_ind_data_i (G: hyps) {b_v P T: set} (pp t1 t2 t3 t4 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ V1 V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ P ∃ T (t1 = ⟨ kc_ind_mk , scons b_v (scons P (scons T ∅)) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $
----
l1: $ G ⇒ ⟨ ∅ , ra_ind_data ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ V1 V2 V3 ⟩ = ⟨ pp , ra_ind_data t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ind_data t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_ind_data ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ V1 V2 V3) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_ind_data t1 t2 t3 t4 = ra_ind_data ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ V1 V2 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ind_data t1 t2 t3 t4 = ra_ind_data ⟨ kc_ind_mk , scons V1 (scons V2 (scons V3 ∅)) ⟩ V1 V2 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V3 $ by isset_var
