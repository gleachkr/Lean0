l3: $ G ⇒ u3 = v3 $ by y2_nidx_ih [l2, #2]

--| The atoms of `nfields` whose variants in `L` with the same inputs have the same outputs.
def y2_P_nfields (L: class) (.c .x1 .x2 .x3 .x4 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_nfields , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_nfields , scons x1 (scons x2 (scons x3 (scons x6 ∅))) ⟩ ∈ L → x4 = x6))} $

lemma y2_nfields_ih (GG: hyps) (q1 q2 q3 q4 w4: set):
  $ GG ⇒ ra_nfields q1 q2 q3 q4 ∈ y2_P_nfields lrel $ > $ GG ⇒ ra_nfields q1 q2 q3 w4 ∈ lrel $ > $ GG ⇒ q4 = w4 $
----
l1: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ c ∊ y2_P_nfields lrel $ by ax
l2: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_nfields , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_nfields , scons x1 (scons x2 (scons x3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_nfields , scons q1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_nfields , scons q1 (scons x2 (scons x3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ∀ x3 ∀ x4 (c = ⟨ kr_nfields , scons q1 (scons q2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_nfields , scons q1 (scons q2 (scons x3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ∀ x4 (c = ⟨ kr_nfields , scons q1 (scons q2 (scons q3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_nfields , scons q1 (scons q2 (scons q3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by all_elim [l4]
l6: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ c = ⟨ kr_nfields , scons q1 (scons q2 (scons q3 (scons q4 ∅))) ⟩ → ∀ x6 (⟨ kr_nfields , scons q1 (scons q2 (scons q3 (scons x6 ∅))) ⟩ ∈ lrel → q4 = x6) $ by all_elim [l5]
l7: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ c = ra_nfields q1 q2 q3 q4 $ by ax
l8: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ∀ x6 (⟨ kr_nfields , scons q1 (scons q2 (scons q3 (scons x6 ∅))) ⟩ ∈ lrel → q4 = x6) $ by imp_elim [l6, l7]
l9: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ra_nfields q1 q2 q3 w4 ∈ lrel → q4 = w4 $ by all_elim [l8]
l10: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ ra_nfields q1 q2 q3 w4 ∈ lrel $ by weaken [#2]
l11: $ GG , c = ra_nfields q1 q2 q3 q4 , c ∊ y2_P_nfields lrel ⇒ q4 = w4 $ by imp_elim [l9, l10]
l12: $ GG ⇒ q4 = w4 $ by wcel_elim [#1, l11]

lemma y2_nfields_ihc (GG: hyps) (Q1 Q2 Q3 Q4 W4: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset Q4 $ > $ GG ⇒ isset W4 $ > $ GG ⇒ ra_nfields Q1 Q2 Q3 Q4 ∈ y2_P_nfields lrel $ > $ GG ⇒ ra_nfields Q1 Q2 Q3 W4 ∈ lrel $ > $ GG ⇒ Q4 = W4 $
