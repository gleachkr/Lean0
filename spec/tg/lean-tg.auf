lemma y2_rehead_d1 (GG: hyps) (o q1 q2 q3 q4 q5 w1 w5: set):
  $ GG ⇒ ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ ∈ cl_rehead_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_rehead lrel $ > $ GG ⇒ ra_rehead w1 q2 q3 q4 w5 ∈ lrel $ > $ GG ⇒ q1 = w1 ∧ q5 = w5 $
----
l1: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b ⇒ q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b $ by ax
l2: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b ⇒ ra_rehead w1 q2 q3 q4 w5 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b ⇒ q1 = w1 ∧ q5 = w5 $ by y2_rehead_c1 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b → q1 = w1 ∧ q5 = w5 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b → q1 = w1 ∧ q5 = w5) $ by all_intro [l4]
l6: $ GG ⇒ ∀ a ∀ b (q1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ q5 = b → q1 = w1 ∧ q5 = w5) $ by all_intro [l5]
l7: $ GG ⇒ q1 = w1 ∧ q5 = w5 $ by y2_rehead_i1 [#1, #2, l6]

lemma y2_rehead_i2 (GG: hyps) {Y X e e2 a k: set} (o q1 q2 q3 q4 q5: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ ∈ cl_rehead_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_rehead lrel $ > $ GG ⇒ ∀ Y ∀ X ∀ e ∀ e2 ∀ a ∀ k (q1 = Y ∧ q2 = X ∧ q3 = ⟨ kc_s , scons k ∅ ⟩ ∧ q4 = ⟨ kc_app , scons e (scons a ∅) ⟩ ∧ q5 = ⟨ kc_app , scons e2 (scons a ∅) ⟩ ∧ ra_rehead Y X k e e2 ∈ lrel ∧ ra_rehead Y X k e e2 ∈ y2_P_rehead lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s ⇒ w ∊ cl_rehead_s $ by ax
l2: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s ⇒ ∃ Y ∃ X ∃ e ∃ e2 ∃ a ∃ k (w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ isset (ra_rehead q1 q2 q3 q4 q5) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ isset (ra_rehead Y X k e e2) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ scons (ra_rehead Y X k e e2) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ isset (scons (ra_rehead Y X k e e2) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ isset (ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ o = scons (ra_rehead Y X k e e2) ∅ ∧ ra_rehead q1 q2 q3 q4 q5 = ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ o = scons (ra_rehead Y X k e e2) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ ⟨ kr_rehead , scons q1 (scons q2 (scons q3 (scons q4 (scons q5 ∅)))) ⟩ = ⟨ kr_rehead , scons Y (scons X (scons ⟨ kc_s , scons k ∅ ⟩ (scons ⟨ kc_app , scons e (scons a ∅) ⟩ (scons ⟨ kc_app , scons e2 (scons a ∅) ⟩ ∅)))) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ kr_rehead ∈ ω $ by x1_kr_rehead
l18: $ GG , w = ⟨ o , ra_rehead q1 q2 q3 q4 q5 ⟩ , w ∊ cl_rehead_s , w = ⟨ scons (ra_rehead Y X k e e2) ∅ , ra_rehead Y X ⟨ kc_s , scons k ∅ ⟩ ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_app , scons e2 (scons a ∅) ⟩ ⟩ ⇒ isset kr_rehead $ by wcel_isset [l17]
