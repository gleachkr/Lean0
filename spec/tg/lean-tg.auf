l42: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot → v1_d_nat x t $ by v1_skip_quot [l6, l41]
l43: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_eq_blk → v1_d_nat x t $ by v1_skip_eq_blk [l14, l42]
l44: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_nat_blk → v1_d_nat x t $ by v1_skip_nat_blk [l14, l43]
l45: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_proj → v1_d_nat x t $ by v1_skip_proj [l6, l44]
l46: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_rec → v1_d_nat x t $ by v1_skip_ind_rec [l6, l45]
l47: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_ctor → v1_d_nat x t $ by v1_skip_ind_ctor [l6, l46]
l48: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_ty → v1_d_nat x t $ by v1_skip_ind_ty [l6, l47]
l49: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_mkn → v1_d_nat x t $ by v1_skip_ind_mkn [l16, l48]
l50: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ccons → v1_d_nat x t $ by v1_skip_ccons [l20, l49]
l51: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_cnil → v1_d_nat x t $ by v1_skip_cnil [l20, l50]
l52: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_tcons → v1_d_nat x t $ by v1_skip_tcons [l18, l51]
l53: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_tnil → v1_d_nat x t $ by v1_skip_tnil [l18, l52]
l54: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_ind_mk → v1_d_nat x t $ by v1_skip_ind_mk [l16, l53]
l55: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_lit → v1_d_nat x t $ by v1_skip_lit [l6, l54]
l56: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_bd1 → v1_d_nat x t $ by v1_skip_bd1 [l12, l55]
