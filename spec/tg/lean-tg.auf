l32: $ G , c = kc_lcons ∧ a = scons ks_lvl (scons ks_lvls ∅) ⇒ ∃ x ∃ y (t = ⟨ kc_lcons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvls) $ by v1_build2 [l22, l24, #3, #4, #5, #6]
