l29: $ G ⇒ kr_lsubst = kr_lsubst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_lparam , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅) $ by y1_scons_inj [l33, l14, l18, l13, l21]
l35: $ G ⇒ t2 = ⟨ kc_lparam , scons V2 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_lparam , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l34]
