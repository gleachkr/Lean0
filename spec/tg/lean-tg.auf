lemma y1_d_baddc_01 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ ∈ cl_baddc_01 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x ∊ cl_baddc_01 ⇒ x ∊ cl_baddc_01 $ by ax
l2: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x ∊ cl_baddc_01 ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_baddc t1 t2 t3 ⟩ = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by y1_e_baddc_01 [l6, l7]
l9: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_baddc y z u) ∅ , ra_baddc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_baddc t1 t2 t3 ⟩ , x ∊ cl_baddc_01 ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by wcel_elim [#1, l13]

