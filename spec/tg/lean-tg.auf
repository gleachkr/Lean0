l30: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ k_v ∃ t_v ∃ m_v ∃ na ∃ X ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_spine ⟨ kc_bvar , scons t_v ∅ ⟩ A na ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_add k_v j_v t_v ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np X ∈ lrel ∧ ra_nidx D j_v m_v ∈ lrel ∧ ra_iargs k_v m_v X A ∈ lrel) $ by wcel_elim [#1, l29]

lemma y1_o_indapp (G: hyps) {D n_v np d_v j_v k_v t_v m_v na X A: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_indapp t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_indapp $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ k_v ∃ t_v ∃ m_v ∃ na ∃ X ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_spine ⟨ kc_bvar , scons t_v ∅ ⟩ A na ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_add k_v j_v t_v ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np X ∈ lrel ∧ ra_nidx D j_v m_v ∈ lrel ∧ ra_iargs k_v m_v X A ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ k_v ∃ t_v ∃ m_v ∃ na ∃ X ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_spine ⟨ kc_bvar , scons t_v ∅ ⟩ A na ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_add k_v j_v t_v ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np X ∈ lrel ∧ ra_nidx D j_v m_v ∈ lrel ∧ ra_iargs k_v m_v X A ∈ lrel) $ by y1_d_indapp_i [#1, #2]

lemma y1_e_ipos_closed (G: hyps) {D n_v np d_v k_v A: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅) , ra_ipos V1 V2 V3 V4 V6 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅) , ra_ipos V1 V2 V3 V4 V6 ⟩ = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ipos t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_ipos V1 V2 V3 V4 V6) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅) ∧ ra_ipos t1 t2 t3 t4 t5 = ra_ipos V1 V2 V3 V4 V6 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ipos t1 t2 t3 t4 t5 = ra_ipos V1 V2 V3 V4 V6 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V6 $ by isset_var
l21: $ G ⇒ scons V6 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V4 $ by isset_var
l23: $ G ⇒ scons V4 (scons V6 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V3 $ by isset_var
l25: $ G ⇒ scons V3 (scons V4 (scons V6 ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V6 ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_ipos ∈ ω $ by x1_kr_ipos
l31: $ G ⇒ isset kr_ipos $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_ipos = kr_ipos ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V6 ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V6 ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V6 ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V6 ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V4 (scons V6 ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V4 (scons V6 ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V4 ∧ scons t5 ∅ = scons V6 ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = V4 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons V6 ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = V6 ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = V6 $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅)) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) ∅)) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_add V4 V3 V5) $ by opair_isset
l53: $ G ⇒ ra_add V4 V3 V5 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ crn (scons (ra_closed V5 V6) ∅) ⊆ lrel $ by crn_scons_tail [l51]
l55: $ G ⇒ isset (ra_closed V5 V6) $ by opair_isset
l56: $ G ⇒ ra_closed V5 V6 ∈ lrel $ by crn_scons_head [l55, l54]
l57: $ G ⇒ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel $ by and_intro [l53, l56]
l58: $ G ⇒ t5 = V6 ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel $ by and_intro [l49, l57]
l59: $ G ⇒ t4 = V4 ∧ t5 = V6 ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel $ by and_intro [l46, l58]
l60: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel $ by and_intro [l43, l59]
l61: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel $ by and_intro [l40, l60]
l62: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel $ by and_intro [l37, l61]
l63: $ G ⇒ ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = A ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 A ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ k_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = A ∧ ra_add V4 V3 k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_intro [l63]
l65: $ G ⇒ ∃ d_v ∃ k_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v V3 k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_intro [l64]
l66: $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_intro [l65]
l67: $ G ⇒ ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = V1 ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_intro [l67]

lemma y1_d_ipos_closed (G: hyps) {D n_v np d_v k_v A: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_closed ⇒ x ∊ cl_ipos_closed $ by ax
l2: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_closed ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by y1_e_ipos_closed [l6, l7]
l9: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) ∅) , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_closed ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_e_ipos_pi (G: hyps) {D n_v np d_v k_v A B: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅)) , ra_ipos V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅)) , ra_ipos V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ⟩ = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ipos t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_ipos V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅)) ∧ ra_ipos t1 t2 t3 t4 t5 = ra_ipos V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ipos t1 t2 t3 t4 t5 = ra_ipos V1 V2 V3 V4 ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V4 $ by isset_var
l23: $ G ⇒ scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V3 $ by isset_var
l25: $ G ⇒ scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_ipos ∈ ω $ by x1_kr_ipos
l31: $ G ⇒ isset kr_ipos $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_ipos = kr_ipos ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V4 ∧ scons t5 ∅ = scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = V4 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅))) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_add V4 V3 V5) (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅))) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_add V4 V3 V5) $ by opair_isset
l53: $ G ⇒ ra_add V4 V3 V5 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ crn (scons (ra_closed V5 V6) (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅)) ⊆ lrel $ by crn_scons_tail [l51]
l55: $ G ⇒ isset (ra_closed V5 V6) $ by opair_isset
l56: $ G ⇒ ra_closed V5 V6 ∈ lrel $ by crn_scons_head [l55, l54]
l57: $ G ⇒ crn (scons (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) ∅) ⊆ lrel $ by crn_scons_tail [l54]
l58: $ G ⇒ isset (ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7) $ by opair_isset
l59: $ G ⇒ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by crn_scons_head [l58, l57]
l60: $ G ⇒ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l56, l59]
l61: $ G ⇒ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l53, l60]
l62: $ G ⇒ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l49, l61]
l63: $ G ⇒ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l46, l62]
l64: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l43, l63]
l65: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l40, l64]
l66: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ V7 ∈ lrel $ by and_intro [l37, l65]
l67: $ G ⇒ ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons V6 (scons B ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 V6 ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ B ∈ lrel) $ by ex_intro [l66]
l68: $ G ⇒ ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add V4 V3 V5 ∈ lrel ∧ ra_closed V5 A ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ B ∈ lrel) $ by ex_intro [l67]
l69: $ G ⇒ ∃ k_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add V4 V3 k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons V4 ∅ ⟩ B ∈ lrel) $ by ex_intro [l68]
l70: $ G ⇒ ∃ d_v ∃ k_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v V3 k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos V1 V2 V3 ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l69]
l71: $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos V1 V2 np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = V1 ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos V1 n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l71]
l73: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l72]

lemma y1_d_ipos_pi (G: hyps) {D n_v np d_v k_v A B: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_pi ⇒ x ∊ cl_ipos_pi $ by ax
l2: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by y1_e_ipos_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_add v u w) (scons (ra_closed w a) (scons (ra_ipos y z u ⟨ kc_s , scons v ∅ ⟩ b) ∅)) , ra_ipos y z u v ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_pi ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_e_ipos_app (G: hyps) {D n_v np d_v j_v A: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ , ra_ipos V1 V2 V3 V4 V6 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ , ra_ipos V1 V2 V3 V4 V6 ⟩ = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ipos t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_ipos V1 V2 V3 V4 V6) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ ∧ ra_ipos t1 t2 t3 t4 t5 = ra_ipos V1 V2 V3 V4 V6 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ipos t1 t2 t3 t4 t5 = ra_ipos V1 V2 V3 V4 V6 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V6 $ by isset_var
l21: $ G ⇒ scons V6 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V4 $ by isset_var
l23: $ G ⇒ scons V4 (scons V6 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V3 $ by isset_var
l25: $ G ⇒ scons V3 (scons V4 (scons V6 ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V6 ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_ipos ∈ ω $ by x1_kr_ipos
l31: $ G ⇒ isset kr_ipos $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_ipos = kr_ipos ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V6 ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V6 ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons V3 (scons V4 (scons V6 ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V6 ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V3 (scons V4 (scons V6 ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 ∅) = scons V4 (scons V6 ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = V3 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V4 (scons V6 ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V4 ∧ scons t5 ∅ = scons V6 ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = V4 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons V6 ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = V6 ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = V6 $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_indapp V1 V2 V3 V4 V6 V5) ∅) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_indapp V1 V2 V3 V4 V6 V5) $ by opair_isset
l53: $ G ⇒ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ t5 = V6 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l49, l53]
l55: $ G ⇒ t4 = V4 ∧ t5 = V6 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l46, l54]
l56: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l43, l55]
l57: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l40, l56]
l58: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V6 ∧ ra_indapp V1 V2 V3 V4 V6 V5 ∈ lrel $ by and_intro [l37, l57]
l59: $ G ⇒ ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = A ∧ ra_indapp V1 V2 V3 V4 A V5 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ j_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = A ∧ ra_indapp V1 V2 V3 V4 A j_v ∈ lrel) $ by ex_intro [l59]
l61: $ G ⇒ ∃ d_v ∃ j_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp V1 V2 V3 d_v A j_v ∈ lrel) $ by ex_intro [l60]
l62: $ G ⇒ ∃ np ∃ d_v ∃ j_v ∃ A (t1 = V1 ∧ t2 = V2 ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp V1 V2 np d_v A j_v ∈ lrel) $ by ex_intro [l61]
l63: $ G ⇒ ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = V1 ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp V1 n_v np d_v A j_v ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_intro [l63]

lemma y1_d_ipos_app (G: hyps) {D n_v np d_v j_v A: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_app ⇒ x ∊ cl_ipos_app $ by ax
l2: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩ ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by y1_e_ipos_app [l6, l7]
l9: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_indapp y z u v a w) ∅ , ra_ipos y z u v a ⟩) ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ , x ∊ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_ipos (G: hyps) {D n_v np d_v k_v A B j_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ pr_ipos $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app $ by ax
l2: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by y1_d_ipos_app [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app $ by ax
l6: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∨ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi $ by ax
l8: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by y1_d_ipos_pi [l7, l8]
l10: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app $ by ax
l12: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_pi ∪ cl_ipos_app → ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) $ by ax
l18: $ G , ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) ⇒ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ cl_ipos_closed ∨ ⟨ pp , ra_ipos t1 t2 t3 t4 t5 ⟩ ∈ (cl_ipos_pi ∪ cl_ipos_app) $ by v1_wcel_cun_elim [l17]
