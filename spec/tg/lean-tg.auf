l7: $ G ⇒ X ∈ (((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst)))) ∪ (((pr_cext ∪ pr_clen) ∪ (pr_cnth ∪ (pr_capp ∪ pr_bsucc))) ∪ ((pr_bdbl ∪ (pr_badd ∪ pr_baddc)) ∪ (pr_bmul ∪ (pr_bpow ∪ pr_band))))) ∪ ((((pr_bor ∪ pr_bxor) ∪ (pr_ind_data ∪ (pr_ind_nested ∪ pr_nth_ty))) ∪ ((pr_nth_ctor ∪ pr_clen_c) ∪ (pr_ntys ∪ (pr_minor_idx ∪ pr_npis)))) ∪ (((pr_nth_pi ∪ pr_isort) ∪ (pr_ind_arity ∪ (pr_nidx ∪ pr_nfields))) ∪ ((pr_ndecl ∪ (pr_aux_of ∪ pr_pis)) ∪ (pr_lams ∪ (pr_tys_closed ∪ pr_pargs)))))) ∪ (((((pr_spine ∪ pr_rehead) ∪ (pr_has_arg ∪ (pr_leaf_has ∪ pr_pinst))) ∪ ((pr_sinst ∪ pr_iargs) ∪ (pr_indapp ∪ (pr_ipos ∪ pr_recfield)))) ∪ (((pr_rst ∪ pr_nst_hit) ∪ (pr_spz ∪ (pr_afree ∪ pr_spz_ctors))) ∪ ((pr_aux_data ∪ (pr_mty ∪ pr_motives)) ∪ (pr_ihty ∪ (pr_mwalk ∪ pr_cminors))))) ∪ ((((pr_minors ∪ pr_rtail) ∪ (pr_rec_ty ∪ (pr_ctor_ty ∪ pr_ihval))) ∪ ((pr_rwalk ∪ pr_rec_rhs) ∪ (pr_struct_like ∪ (pr_field_ty ∪ pr_qinst)))) ∪ (((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq)))))) $ by x1_in_r [l6]

lemma x1_pr_eta_eq (G: hyps) (X: class): $ G ⇒ X ∈ pr_eta_eq $ > $ G ⇒ X ∈ x1_top $
----
l1: $ G ⇒ X ∈ pr_proj_eq ∪ pr_eta_eq $ by x1_in_r [#1]
l2: $ G ⇒ X ∈ pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq) $ by x1_in_r [l1]
l3: $ G ⇒ X ∈ (pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq)) $ by x1_in_r [l2]
l4: $ G ⇒ X ∈ ((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq))) $ by x1_in_r [l3]
l5: $ G ⇒ X ∈ (((pr_minors ∪ pr_rtail) ∪ (pr_rec_ty ∪ (pr_ctor_ty ∪ pr_ihval))) ∪ ((pr_rwalk ∪ pr_rec_rhs) ∪ (pr_struct_like ∪ (pr_field_ty ∪ pr_qinst)))) ∪ (((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq)))) $ by x1_in_r [l4]
l6: $ G ⇒ X ∈ ((((pr_spine ∪ pr_rehead) ∪ (pr_has_arg ∪ (pr_leaf_has ∪ pr_pinst))) ∪ ((pr_sinst ∪ pr_iargs) ∪ (pr_indapp ∪ (pr_ipos ∪ pr_recfield)))) ∪ (((pr_rst ∪ pr_nst_hit) ∪ (pr_spz ∪ (pr_afree ∪ pr_spz_ctors))) ∪ ((pr_aux_data ∪ (pr_mty ∪ pr_motives)) ∪ (pr_ihty ∪ (pr_mwalk ∪ pr_cminors))))) ∪ ((((pr_minors ∪ pr_rtail) ∪ (pr_rec_ty ∪ (pr_ctor_ty ∪ pr_ihval))) ∪ ((pr_rwalk ∪ pr_rec_rhs) ∪ (pr_struct_like ∪ (pr_field_ty ∪ pr_qinst)))) ∪ (((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq))))) $ by x1_in_r [l5]
l7: $ G ⇒ X ∈ (((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ (pr_linst ∪ pr_lsubst))) ∪ ((pr_closed ∪ pr_lift) ∪ (pr_inst ∪ (pr_lookup ∪ pr_cinst)))) ∪ (((pr_cext ∪ pr_clen) ∪ (pr_cnth ∪ (pr_capp ∪ pr_bsucc))) ∪ ((pr_bdbl ∪ (pr_badd ∪ pr_baddc)) ∪ (pr_bmul ∪ (pr_bpow ∪ pr_band))))) ∪ ((((pr_bor ∪ pr_bxor) ∪ (pr_ind_data ∪ (pr_ind_nested ∪ pr_nth_ty))) ∪ ((pr_nth_ctor ∪ pr_clen_c) ∪ (pr_ntys ∪ (pr_minor_idx ∪ pr_npis)))) ∪ (((pr_nth_pi ∪ pr_isort) ∪ (pr_ind_arity ∪ (pr_nidx ∪ pr_nfields))) ∪ ((pr_ndecl ∪ (pr_aux_of ∪ pr_pis)) ∪ (pr_lams ∪ (pr_tys_closed ∪ pr_pargs)))))) ∪ (((((pr_spine ∪ pr_rehead) ∪ (pr_has_arg ∪ (pr_leaf_has ∪ pr_pinst))) ∪ ((pr_sinst ∪ pr_iargs) ∪ (pr_indapp ∪ (pr_ipos ∪ pr_recfield)))) ∪ (((pr_rst ∪ pr_nst_hit) ∪ (pr_spz ∪ (pr_afree ∪ pr_spz_ctors))) ∪ ((pr_aux_data ∪ (pr_mty ∪ pr_motives)) ∪ (pr_ihty ∪ (pr_mwalk ∪ pr_cminors))))) ∪ ((((pr_minors ∪ pr_rtail) ∪ (pr_rec_ty ∪ (pr_ctor_ty ∪ pr_ihval))) ∪ ((pr_rwalk ∪ pr_rec_rhs) ∪ (pr_struct_like ∪ (pr_field_ty ∪ pr_qinst)))) ∪ (((pr_nonrec ∪ pr_eta_ok) ∪ (pr_projs ∪ (pr_clift ∪ pr_psplit))) ∪ ((pr_iota_tel ∪ (pr_iota_lhs ∪ pr_crst)) ∪ (pr_iota_eq ∪ (pr_proj_eq ∪ pr_eta_eq)))))) $ by x1_in_r [l6]

lrel_le_z
---------
l1: $ G , y = A1 , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ex_intro [l1]
l3: $ G , y = A1 , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ cl_le_z $ by cab_intro [l2]
l4: $ G , y = A1 , x = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ∈ cl_le_z $ by wcel_intro [l1, l3]
l5: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ $ by opair_isset
l6: $ G , y = A1 ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ ∈ cl_le_z $ by isset_elim [l5, l4]
l7: $ G , y = A1 ⇒ y = A1 $ by ax
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l10: $ G , y = A1 ⇒ scons y ∅ = scons A1 ∅ $ by scons_eq [l7, l8]
l11: $ G , y = A1 ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons y ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons A1 ∅) $ by scons_eq [l9, l10]
l12: $ G , y = A1 ⇒ kr_le = kr_le $ by eq_refl
l13: $ G , y = A1 ⇒ ra_le ⟨ kc_nz , ∅ ⟩ y = ra_le ⟨ kc_nz , ∅ ⟩ A1 $ by opair_eq [l12, l11]
l14: $ G , y = A1 ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ y ⟩ = ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ A1 ⟩ $ by opair_eq [l8, l13]
l15: $ G , y = A1 ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ A1 ⟩ ∈ cl_le_z $ by wcel_eq_l [l14, l6]
l16: $ G ⇒ isset A1 $ by wcel_isset [#1]
l17: $ G ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ A1 ⟩ ∈ cl_le_z $ by isset_elim [l16, l15]
l18: $ G ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ A1 ⟩ ∈ cl_le_z ∪ cl_le_s $ by x1_in_l [l17]
l19: $ G ⇒ ⟨ ∅ , ra_le ⟨ kc_nz , ∅ ⟩ A1 ⟩ ∈ x1_top $ by x1_pr_le [l18]
l20: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l21: $ G ⇒ crn ∅ ⊆ lrel $ by crn_empty_sub
l22: $ G ⇒ isset ω $ by omega_set
l23: $ G ⇒ kc_nz ∈ ω $ by v1_kc_nz
l24: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l25: $ G ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by trees_intro_c [l22, l23, l24]
l26: $ G ⇒ ra_le ⟨ kc_nz , ∅ ⟩ A1 ∈ latoms $ by x1_ra_le [l25, #1]
l27: $ G ⇒ ra_le ⟨ kc_nz , ∅ ⟩ A1 ∈ lrel $ by x1_horn [l19, l20, l26, l21]

lrel_le_s
---------
l1: $ G , y = A1 , z = A2 , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ $ by ax
l2: $ G , y = A1 , z = A2 , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) $ by ex_intro [l1]
l3: $ G , y = A1 , z = A2 , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ ∃ y ∃ z (x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩) $ by ex_intro [l2]
l4: $ G , y = A1 , z = A2 , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ x ∊ cl_le_s $ by cab_intro [l3]
l5: $ G , y = A1 , z = A2 , x = ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ⇒ ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ∈ cl_le_s $ by wcel_intro [l1, l4]
l6: $ G , y = A1 , z = A2 ⇒ isset ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ $ by opair_isset
l7: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ ∈ cl_le_s $ by isset_elim [l6, l5]
l8: $ G , y = A1 , z = A2 ⇒ y = A1 $ by ax
l9: $ G , y = A1 , z = A2 ⇒ z = A2 $ by ax
l10: $ G , y = A1 , z = A2 ⇒ ∅ = ∅ $ by eq_refl
l11: $ G , y = A1 , z = A2 ⇒ scons z ∅ = scons A2 ∅ $ by scons_eq [l9, l10]
l12: $ G , y = A1 , z = A2 ⇒ scons y (scons z ∅) = scons A1 (scons A2 ∅) $ by scons_eq [l8, l11]
l13: $ G , y = A1 , z = A2 ⇒ kr_le = kr_le $ by eq_refl
l14: $ G , y = A1 , z = A2 ⇒ ra_le y z = ra_le A1 A2 $ by opair_eq [l13, l12]
l15: $ G , y = A1 , z = A2 ⇒ scons (ra_le y z) ∅ = scons (ra_le A1 A2) ∅ $ by scons_eq [l14, l10]
l16: $ G , y = A1 , z = A2 ⇒ kc_s = kc_s $ by eq_refl
l17: $ G , y = A1 , z = A2 ⇒ scons y ∅ = scons A1 ∅ $ by scons_eq [l8, l10]
l18: $ G , y = A1 , z = A2 ⇒ ⟨ kc_s , scons y ∅ ⟩ = ⟨ kc_s , scons A1 ∅ ⟩ $ by opair_eq [l16, l17]
l19: $ G , y = A1 , z = A2 ⇒ scons z ∅ = scons A2 ∅ $ by scons_eq [l9, l10]
l20: $ G , y = A1 , z = A2 ⇒ ⟨ kc_s , scons z ∅ ⟩ = ⟨ kc_s , scons A2 ∅ ⟩ $ by opair_eq [l16, l19]
l21: $ G , y = A1 , z = A2 ⇒ scons ⟨ kc_s , scons z ∅ ⟩ ∅ = scons ⟨ kc_s , scons A2 ∅ ⟩ ∅ $ by scons_eq [l20, l10]
l22: $ G , y = A1 , z = A2 ⇒ scons ⟨ kc_s , scons y ∅ ⟩ (scons ⟨ kc_s , scons z ∅ ⟩ ∅) = scons ⟨ kc_s , scons A1 ∅ ⟩ (scons ⟨ kc_s , scons A2 ∅ ⟩ ∅) $ by scons_eq [l18, l21]
l23: $ G , y = A1 , z = A2 ⇒ kr_le = kr_le $ by eq_refl
l24: $ G , y = A1 , z = A2 ⇒ ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ = ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ $ by opair_eq [l23, l22]
l25: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_le y z) ∅ , ra_le ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_s , scons z ∅ ⟩ ⟩ = ⟨ scons (ra_le A1 A2) ∅ , ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ⟩ $ by opair_eq [l15, l24]
l26: $ G , y = A1 , z = A2 ⇒ ⟨ scons (ra_le A1 A2) ∅ , ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ⟩ ∈ cl_le_s $ by wcel_eq_l [l25, l7]
l27: $ G ⇒ isset A2 $ by wcel_isset [#2]
l28: $ G , y = A1 ⇒ ⟨ scons (ra_le A1 A2) ∅ , ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ⟩ ∈ cl_le_s $ by isset_elim [l27, l26]
l29: $ G ⇒ isset A1 $ by wcel_isset [#1]
l30: $ G ⇒ ⟨ scons (ra_le A1 A2) ∅ , ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ⟩ ∈ cl_le_s $ by isset_elim [l29, l28]
l31: $ G ⇒ ⟨ scons (ra_le A1 A2) ∅ , ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ⟩ ∈ cl_le_z ∪ cl_le_s $ by x1_in_r [l30]
l32: $ G ⇒ ⟨ scons (ra_le A1 A2) ∅ , ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ⟩ ∈ x1_top $ by x1_pr_le [l31]
l33: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l34: $ G ⇒ crn ∅ ⊆ lrel $ by crn_empty_sub
l35: $ G ⇒ (ra_le A1 A2) ∈ latoms $ by x1_lrel_lat [#3]
l36: $ G ⇒ scons (ra_le A1 A2) ∅ ∈ fseq latoms $ by v1_scons_fseq_c [l35, l33]
l37: $ G ⇒ crn (scons (ra_le A1 A2) ∅) ⊆ lrel $ by crn_scons_sub [#3, l34]
l38: $ G ⇒ isset ω $ by omega_set
l39: $ G ⇒ kc_s ∈ ω $ by v1_kc_s
l40: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l41: $ G ⇒ scons A1 ∅ ∈ fseq (trees ω) $ by v1_scons_fseq_c [#1, l40]
l42: $ G ⇒ ⟨ kc_s , scons A1 ∅ ⟩ ∈ trees ω $ by trees_intro_c [l38, l39, l41]
l43: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by v1_scons_fseq_c [#2, l40]
l44: $ G ⇒ ⟨ kc_s , scons A2 ∅ ⟩ ∈ trees ω $ by trees_intro_c [l38, l39, l43]
l45: $ G ⇒ ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ∈ latoms $ by x1_ra_le [l42, l44]
l46: $ G ⇒ ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ∈ lrel $ by x1_horn [l32, l36, l45, l37]

lrel_add_z
----------
l1: $ G , y = A1 , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l2: $ G , y = A1 , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ex_intro [l1]
l3: $ G , y = A1 , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x ∊ cl_add_z $ by cab_intro [l2]
l4: $ G , y = A1 , x = ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ∈ cl_add_z $ by wcel_intro [l1, l3]
l5: $ G , y = A1 ⇒ isset ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ $ by opair_isset
l6: $ G , y = A1 ⇒ ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ ∈ cl_add_z $ by isset_elim [l5, l4]
l7: $ G , y = A1 ⇒ y = A1 $ by ax
l8: $ G , y = A1 ⇒ ∅ = ∅ $ by eq_refl
l9: $ G , y = A1 ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l10: $ G , y = A1 ⇒ scons y ∅ = scons A1 ∅ $ by scons_eq [l7, l8]
l11: $ G , y = A1 ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons y ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons A1 ∅) $ by scons_eq [l9, l10]
l12: $ G , y = A1 ⇒ scons y (scons ⟨ kc_nz , ∅ ⟩ (scons y ∅)) = scons A1 (scons ⟨ kc_nz , ∅ ⟩ (scons A1 ∅)) $ by scons_eq [l7, l11]
l13: $ G , y = A1 ⇒ kr_add = kr_add $ by eq_refl
l14: $ G , y = A1 ⇒ ra_add y ⟨ kc_nz , ∅ ⟩ y = ra_add A1 ⟨ kc_nz , ∅ ⟩ A1 $ by opair_eq [l13, l12]
l15: $ G , y = A1 ⇒ ⟨ ∅ , ra_add y ⟨ kc_nz , ∅ ⟩ y ⟩ = ⟨ ∅ , ra_add A1 ⟨ kc_nz , ∅ ⟩ A1 ⟩ $ by opair_eq [l8, l14]
l16: $ G , y = A1 ⇒ ⟨ ∅ , ra_add A1 ⟨ kc_nz , ∅ ⟩ A1 ⟩ ∈ cl_add_z $ by wcel_eq_l [l15, l6]
l17: $ G ⇒ isset A1 $ by wcel_isset [#1]
l18: $ G ⇒ ⟨ ∅ , ra_add A1 ⟨ kc_nz , ∅ ⟩ A1 ⟩ ∈ cl_add_z $ by isset_elim [l17, l16]
