l16: $ G , y = A1 , z = A2 ⇒ kr_rst = kr_rst $ by eq_refl
l17: $ G , y = A1 , z = A2 ⇒ ra_rst y ⟨ kc_nil , ∅ ⟩ z z = ra_rst A1 ⟨ kc_nil , ∅ ⟩ A2 A2 $ by opair_eq [l16, l15]
l18: $ G , y = A1 , z = A2 ⇒ ⟨ ∅ , ra_rst y ⟨ kc_nil , ∅ ⟩ z z ⟩ = ⟨ ∅ , ra_rst A1 ⟨ kc_nil , ∅ ⟩ A2 A2 ⟩ $ by opair_eq [l10, l17]
