l20: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q3 = u_n $ by and_elim_r [l18]
l21: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ $ by and_elim_l [l15]
l22: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel $ by and_elim_r [l15]
l23: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q2 = ⟨ kc_s , scons a ∅ ⟩ $ by and_elim_l [l22]
l24: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ w3 = e ∧ ra_ndecl d a e ∈ lrel $ by and_elim_r [l22]
l25: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ w3 = e $ by and_elim_l [l24]
l26: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ ra_ndecl d a e ∈ lrel $ by and_elim_r [l24]
l27: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ kc_nil ∈ kc_cons $ by y2_lt_nil_cons
l28: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ kc_cons ∈ ω $ by v1_kc_cons
l29: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ isset kc_cons $ by wcel_isset [l28]
l30: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ ⊥ $ by y2_ne [l17, l21, l27, l29]
l31: $ GG , q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel ⇒ q3 = w3 $ by bot_elim [l30]
l32: $ GG , ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel) ⇒ ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel) $ by ax
l33: $ GG , ∃ e (q1 = ⟨ kc_cons , scons b (scons d ∅) ⟩ ∧ q2 = ⟨ kc_s , scons a ∅ ⟩ ∧ w3 = e ∧ ra_ndecl d a e ∈ lrel) ⇒ q3 = w3 $ by ex_elim [l32, l31]
