--| @rewrite
--| The numeral `n1` of the statements, for the normalizer (which keeps `s nz` folded).
lemma x1_enc_n1: $ enc_nat n1 ≐ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $
----
l1: $ enc_nat n1 ≐ ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ $ by enc_s

--| Moving a derivable atom along equalities of its arguments.
lemma x1_eq_le (G: hyps) (A1 B1 A2 B2: class):
  $ G ⇒ ra_le A1 A2 ∈ lrel $ > $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ >
  $ G ⇒ ra_le B1 B2 ∈ lrel $
