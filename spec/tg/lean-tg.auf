lemma y2_pargs_e2 (GG: hyps) (q1 q2 q3 q4 w4 u_X u_e u_d u_n v_X v_e v_d v_n: set):
  $ GG ⇒ q1 = u_X $ > $ GG ⇒ q2 = u_d $ > $ GG ⇒ q3 = ⟨ kc_s , scons u_n ∅ ⟩ $ > $ GG ⇒ q4 = ⟨ kc_app , scons u_e (scons ⟨ kc_bvar , scons u_d ∅ ⟩ ∅) ⟩ $ > $ GG ⇒ ra_pargs u_X ⟨ kc_s , scons u_d ∅ ⟩ u_n u_e ∈ lrel $ > $ GG ⇒ ra_pargs u_X ⟨ kc_s , scons u_d ∅ ⟩ u_n u_e ∈ y2_P_pargs lrel $ > $ GG ⇒ q1 = v_X $ > $ GG ⇒ q2 = v_d $ > $ GG ⇒ q3 = ⟨ kc_s , scons v_n ∅ ⟩ $ > $ GG ⇒ w4 = ⟨ kc_app , scons v_e (scons ⟨ kc_bvar , scons v_d ∅ ⟩ ∅) ⟩ $ > $ GG ⇒ ra_pargs v_X ⟨ kc_s , scons v_d ∅ ⟩ v_n v_e ∈ lrel $ > $ GG ⇒ q4 = w4 $
----
l1: $ GG ⇒ u_X = q1 $ by eq_sym [#1]
l2: $ GG ⇒ u_X = v_X $ by eq_trans [l1, #7]
l3: $ GG ⇒ u_d = q2 $ by eq_sym [#2]
l4: $ GG ⇒ u_d = v_d $ by eq_trans [l3, #8]
l5: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = q3 $ by eq_sym [#3]
l6: $ GG ⇒ ⟨ kc_s , scons u_n ∅ ⟩ = ⟨ kc_s , scons v_n ∅ ⟩ $ by eq_trans [l5, #9]
l7: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l8: $ GG ⇒ isset kc_s $ by wcel_isset [l7]
l9: $ GG ⇒ isset u_n $ by isset_var
l10: $ GG ⇒ isset v_n $ by isset_var
l11: $ GG ⇒ u_n = v_n $ by y2_nd1 [l6, l8, l9, l10]
l12: $ GG ⇒ v_X = u_X $ by eq_sym [l2]
l13: $ GG ⇒ ∅ = ∅ $ by eq_refl
l14: $ GG ⇒ scons u_d ∅ = scons v_d ∅ $ by scons_eq [l4, l13]
l15: $ GG ⇒ kc_s = kc_s $ by eq_refl
l16: $ GG ⇒ ⟨ kc_s , scons u_d ∅ ⟩ = ⟨ kc_s , scons v_d ∅ ⟩ $ by opair_eq [l15, l14]
l17: $ GG ⇒ ⟨ kc_s , scons v_d ∅ ⟩ = ⟨ kc_s , scons u_d ∅ ⟩ $ by eq_sym [l16]
l18: $ GG ⇒ v_n = u_n $ by eq_sym [l11]
l19: $ GG ⇒ v_e = v_e $ by eq_refl
l20: $ GG ⇒ ra_pargs u_X ⟨ kc_s , scons u_d ∅ ⟩ u_n v_e ∈ lrel $ by x1_eq_pargs [#11, l12, l17, l18, l19]
l21: $ GG ⇒ isset u_X $ by isset_var
l22: $ GG ⇒ isset ⟨ kc_s , scons u_d ∅ ⟩ $ by opair_isset
l23: $ GG ⇒ isset u_n $ by isset_var
l24: $ GG ⇒ isset u_e $ by isset_var
l25: $ GG ⇒ isset v_e $ by isset_var
l26: $ GG ⇒ u_e = v_e $ by y2_pargs_ihc [l21, l22, l23, l24, l25, #6, l20]
l27: $ GG ⇒ ∅ = ∅ $ by eq_refl
l28: $ GG ⇒ ∅ = ∅ $ by eq_refl
l29: $ GG ⇒ scons u_d ∅ = scons v_d ∅ $ by scons_eq [l4, l28]
l30: $ GG ⇒ kc_bvar = kc_bvar $ by eq_refl
l31: $ GG ⇒ ⟨ kc_bvar , scons u_d ∅ ⟩ = ⟨ kc_bvar , scons v_d ∅ ⟩ $ by opair_eq [l30, l29]
l32: $ GG ⇒ scons ⟨ kc_bvar , scons u_d ∅ ⟩ ∅ = scons ⟨ kc_bvar , scons v_d ∅ ⟩ ∅ $ by scons_eq [l31, l27]
l33: $ GG ⇒ scons u_e (scons ⟨ kc_bvar , scons u_d ∅ ⟩ ∅) = scons v_e (scons ⟨ kc_bvar , scons v_d ∅ ⟩ ∅) $ by scons_eq [l26, l32]
l34: $ GG ⇒ kc_app = kc_app $ by eq_refl
l35: $ GG ⇒ ⟨ kc_app , scons u_e (scons ⟨ kc_bvar , scons u_d ∅ ⟩ ∅) ⟩ = ⟨ kc_app , scons v_e (scons ⟨ kc_bvar , scons v_d ∅ ⟩ ∅) ⟩ $ by opair_eq [l34, l33]
l36: $ GG ⇒ ⟨ kc_app , scons v_e (scons ⟨ kc_bvar , scons v_d ∅ ⟩ ∅) ⟩ = w4 $ by eq_sym [#10]
l37: $ GG ⇒ q4 = ⟨ kc_app , scons v_e (scons ⟨ kc_bvar , scons v_d ∅ ⟩ ∅) ⟩ $ by eq_trans [#4, l35]
l38: $ GG ⇒ q4 = w4 $ by eq_trans [l37, l36]

lemma y2_pargs_c2 (GG: hyps) (q1 q2 q3 q4 w4 u_X u_e u_d u_n: set):
  $ GG ⇒ q1 = u_X ∧ q2 = u_d ∧ q3 = ⟨ kc_s , scons u_n ∅ ⟩ ∧ q4 = ⟨ kc_app , scons u_e (scons ⟨ kc_bvar , scons u_d ∅ ⟩ ∅) ⟩ ∧ ra_pargs u_X ⟨ kc_s , scons u_d ∅ ⟩ u_n u_e ∈ lrel ∧ ra_pargs u_X ⟨ kc_s , scons u_d ∅ ⟩ u_n u_e ∈ y2_P_pargs lrel $ > $ GG ⇒ ra_pargs q1 q2 q3 w4 ∈ lrel $ > $ GG ⇒ q4 = w4 $
