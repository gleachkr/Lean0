l59: $ G ⇒ crn (scons (ra_spine V10 V9 V8) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅))) ⊆ lrel $ by crn_scons_tail [l56]
l60: $ G ⇒ isset (ra_spine V10 V9 V8) $ by opair_isset
l61: $ G ⇒ ra_spine V10 V9 V8 ∈ lrel $ by crn_scons_head [l60, l59]
l62: $ G ⇒ crn (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) (scons (ra_rehead V10 V13 V8 V9 V14) ∅)) ⊆ lrel $ by crn_scons_tail [l59]
l63: $ G ⇒ isset (ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13) $ by opair_isset
l64: $ G ⇒ ra_pinst ⟨ kc_nz , ∅ ⟩ V10 V12 V13 ∈ lrel $ by crn_scons_head [l63, l62]
l65: $ G ⇒ crn (scons (ra_rehead V10 V13 V8 V9 V14) ∅) ⊆ lrel $ by crn_scons_tail [l62]
