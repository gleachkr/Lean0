l12: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T $ by lrel_ind_data_det [#5, l11]
l13: $ GG ⇒ u_b = v_b $ by and_elim_l [l12]
l14: $ GG ⇒ u_P = v_P ∧ u_T = v_T $ by and_elim_r [l12]
l15: $ GG ⇒ u_P = v_P $ by and_elim_l [l14]
l16: $ GG ⇒ u_T = v_T $ by and_elim_r [l14]
l17: $ GG ⇒ v_T = u_T $ by eq_sym [l16]
l18: $ GG ⇒ v_i = u_i $ by eq_sym [l4]
l19: $ GG ⇒ v_F = v_F $ by eq_refl
l20: $ GG ⇒ v_C = v_C $ by eq_refl
l21: $ GG ⇒ ra_nth_ty u_T u_i v_F v_C ∈ lrel $ by x1_eq_nth_ty [#14, l17, l18, l19, l20]
l22: $ GG ⇒ u_F = v_F ∧ u_C = v_C $ by lrel_nth_ty_det [#6, l21]
l23: $ GG ⇒ u_F = v_F $ by and_elim_l [l22]
l24: $ GG ⇒ u_C = v_C $ by and_elim_r [l22]
l25: $ GG ⇒ v_C = u_C $ by eq_sym [l24]
l26: $ GG ⇒ v_c = u_c $ by eq_sym [l6]
l27: $ GG ⇒ v_K = v_K $ by eq_refl
