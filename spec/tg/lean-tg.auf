l16: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ kc_srt ∈ kc_pi $ by y2_lt_srt_pi
l17: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ kc_pi ∈ ω $ by v1_kc_pi
l18: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ isset kc_pi $ by wcel_isset [l17]
l19: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ ⊥ $ by y2_ne [l12, l4, l16, l18]
l20: $ GG , q1 = ⟨ kc_srt , scons a ∅ ⟩ ∧ w2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = w2 ∧ q3 = w3 $ by bot_elim [l19]
