l57: $ G ⇒ crn pp = crn (scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅))) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅))) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) $ by opair_isset
l60: $ G ⇒ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel $ by crn_scons_head [l59, l58]
l61: $ G ⇒ crn (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅)) ⊆ lrel $ by crn_scons_tail [l58]
l62: $ G ⇒ isset (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) $ by opair_isset
l63: $ G ⇒ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel $ by crn_scons_head [l62, l61]
l64: $ G ⇒ crn (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅) ⊆ lrel $ by crn_scons_tail [l61]
l65: $ G ⇒ isset (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) $ by opair_isset
l66: $ G ⇒ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by crn_scons_head [l65, l64]
l67: $ G ⇒ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l63, l66]
l68: $ G ⇒ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l60, l67]
l69: $ G ⇒ t6 = V7 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l56, l68]
l70: $ G ⇒ t5 = V5 ∧ t6 = V7 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l53, l69]
l71: $ G ⇒ t4 = V4 ∧ t5 = V5 ∧ t6 = V7 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l50, l70]
l72: $ G ⇒ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V7 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l47, l71]
l73: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V7 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l44, l72]
l74: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = V7 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7 ∈ lrel $ by and_intro [l41, l73]
l75: $ G ⇒ ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 e2 ∈ lrel) $ by ex_intro [l74]
l76: $ G ⇒ ∃ e1 ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = V5 ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ e1 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 e1 e2 ∈ lrel) $ by ex_intro [l75]
l77: $ G ⇒ ∃ e_v ∃ e1 ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = V4 ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst V4 e_v ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ e1 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 e1 e2 ∈ lrel) $ by ex_intro [l76]
l78: $ G ⇒ ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3 ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ e1 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 k_v e1 e2 ∈ lrel) $ by ex_intro [l77]
l79: $ G ⇒ ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = V1 ∧ t2 = V2 ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons V2 ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ e1 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_intro [l78]
l80: $ G ⇒ ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = V1 ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons V1 (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst V1 ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_intro [l79]
l81: $ G ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_intro [l80]

lemma y1_d_sinst_step (G: hyps) {D j_v n_v k_v e_v e1 e2: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_sinst_step ⇒ x ∊ cl_sinst_step $ by ax
l2: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_sinst_step ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by y1_e_sinst_step [l6, l7]
l9: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩) ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_sinst_step ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_o_sinst (G: hyps) {D n_v k_v e_v j_v e1 e2: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_sinst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) ∨ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step $ by ax
l2: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by y1_d_sinst_step [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step → ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step $ by ax
l6: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∨ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done $ by ax
l8: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by y1_d_sinst_done [l7, l8]
l10: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) ∨ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step $ by ax
l12: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step → ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_step ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) ∨ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) ∨ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done ∪ cl_sinst_step → ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) ∨ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) ∨ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_iargs_z (G: hyps) {k_v X: set} (pp t1 t2 t3 t4 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_iargs V1 ⟨ kc_nz , ∅ ⟩ V2 V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $
----
l1: $ G ⇒ ⟨ ∅ , ra_iargs V1 ⟨ kc_nz , ∅ ⟩ V2 V2 ⟩ = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_iargs t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_iargs V1 ⟨ kc_nz , ∅ ⟩ V2 V2) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_iargs t1 t2 t3 t4 = ra_iargs V1 ⟨ kc_nz , ∅ ⟩ V2 V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_iargs t1 t2 t3 t4 = ra_iargs V1 ⟨ kc_nz , ∅ ⟩ V2 V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V2 (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l22: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_iargs ∈ ω $ by x1_kr_iargs
l26: $ G ⇒ isset kr_iargs $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_iargs = kr_iargs ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V2 (scons V2 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V2 (scons V2 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V2 (scons V2 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V2 ∧ scons t4 ∅ = scons V2 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V2 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V2 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V2 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V2 ∧ t4 = V2 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V2 ∧ t4 = V2 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V2 ∧ t4 = V2 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ X (t1 = V1 ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by ex_intro [l44]
l46: $ G ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by ex_intro [l45]

lemma y1_d_iargs_z (G: hyps) {k_v X: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $
----
l1: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x ∊ cl_iargs_z ⇒ x ∊ cl_iargs_z $ by ax
l2: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x ∊ cl_iargs_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ ⇒ x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ ⇒ x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩ ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by y1_e_iargs_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_iargs y ⟨ kc_nz , ∅ ⟩ z z ⟩) ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x ∊ cl_iargs_z ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by wcel_elim [#1, l11]

lemma y1_e_iargs_s (G: hyps) {k_v m_v X A a_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ = ⟨ scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅) , ra_iargs V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅) , ra_iargs V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ⟩ = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_iargs t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_iargs V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅) ∧ ra_iargs t1 t2 t3 t4 = ra_iargs V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_iargs t1 t2 t3 t4 = ra_iargs V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V3 $ by isset_var
l21: $ G ⇒ scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_s , scons V2 ∅ ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_iargs ∈ ω $ by x1_kr_iargs
l27: $ G ⇒ isset kr_iargs $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_iargs = kr_iargs ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_s , scons V2 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V3 (scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V3 ∧ scons t4 ∅ = scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V3 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_iargs V1 V2 V3 V4) (scons (ra_closed V1 V5) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_iargs V1 V2 V3 V4) $ by opair_isset
l46: $ G ⇒ ra_iargs V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_closed V1 V5) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_closed V1 V5) $ by opair_isset
l49: $ G ⇒ ra_closed V1 V5 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_iargs V1 V2 V3 V4 ∈ lrel ∧ ra_closed V1 V5 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_iargs V1 V2 V3 V4 ∈ lrel ∧ ra_closed V1 V5 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_iargs V1 V2 V3 V4 ∈ lrel ∧ ra_closed V1 V5 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_iargs V1 V2 V3 V4 ∈ lrel ∧ ra_closed V1 V5 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons V5 ∅) ⟩ ∧ ra_iargs V1 V2 V3 V4 ∈ lrel ∧ ra_closed V1 V5 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons V4 (scons a_v ∅) ⟩ ∧ ra_iargs V1 V2 V3 V4 ∈ lrel ∧ ra_closed V1 a_v ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ A ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = V3 ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs V1 V2 V3 A ∈ lrel ∧ ra_closed V1 a_v ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ X ∃ A ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_s , scons V2 ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs V1 V2 X A ∈ lrel ∧ ra_closed V1 a_v ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ m_v ∃ X ∃ A ∃ a_v (t1 = V1 ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs V1 m_v X A ∈ lrel ∧ ra_closed V1 a_v ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by ex_intro [l58]

lemma y1_d_iargs_s (G: hyps) {k_v m_v X A a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x ∊ cl_iargs_s ⇒ x ∊ cl_iargs_s $ by ax
l2: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x ∊ cl_iargs_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_iargs y z u v) (scons (ra_closed y w) ∅) , ra_iargs y ⟨ kc_s , scons z ∅ ⟩ u ⟨ kc_app , scons v (scons w ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
