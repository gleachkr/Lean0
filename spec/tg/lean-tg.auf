lemma y1_d_field_ty_i (G: hyps) {D b_v P T j_v i_v np n_v m_v F K K2 A C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ ∈ cl_field_ty_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ A ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = A ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_nth_pi K2 i_v A ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x ∊ cl_field_ty_i ⇒ x ∊ cl_field_ty_i $ by ax
l2: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x ∊ cl_field_ty_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ ⇒ x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ ⇒ ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ ⇒ ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩ ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ A ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = A ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_nth_pi K2 i_v A ∈ lrel) $ by y1_e_field_ty_i [l6, l7]
l9: $ G , x = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ , ∃ d (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩) ⇒ ∃ d (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w g d) (scons (ra_nth_ctor d ⟨ kc_nz , ∅ ⟩ i) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ c b i j) (scons (ra_nth_pi j a k) ∅)))))) , ra_field_ty y w a k ⟩) $ by ax
