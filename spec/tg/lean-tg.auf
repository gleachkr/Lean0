lemma y1_k_ihval_app (G: hyps): $ G ⇒ cl_ihval_app ⊆ y1_lab kr_ihval (suc kr_ihval) $
----
l1: $ G , x ∊ cl_ihval_app ⇒ x ∊ cl_ihval_app $ by ax
l2: $ G , x ∊ cl_ihval_app ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ p i) (scons (ra_nidx y f g) (scons (ra_add z g i) (scons (ra_rehead h m g p n) (scons (ra_spine ⟨ kc_ind_ty , scons y (scons f ∅) ⟩ h z) (scons (ra_add c a j) (scons (ra_add v u k) (scons (ra_add j k d) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons f (scons w ∅)) ⟩ d z l) (scons (ra_pargs l j k m) (scons (ra_add c b e) (scons (ra_pargs ⟨ kc_bvar , scons e ∅ ⟩ ⟨ kc_nz , ∅ ⟩ c o) ∅))))))))))) , ra_ihval y z u v w a b c f p ⟨ kc_app , scons n (scons o ∅) ⟩ ⟩ ⇒ kr_ihval ∈ ω $ by x1_kr_ihval
