  $ G ⇒ ra_iota_lhs B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A11 ∅ = scons B11 ∅ $ by scons_eq [#12, l1]
l3: $ G ⇒ scons A10 (scons A11 ∅) = scons B10 (scons B11 ∅) $ by scons_eq [#11, l2]
l4: $ G ⇒ scons A9 (scons A10 (scons A11 ∅)) = scons B9 (scons B10 (scons B11 ∅)) $ by scons_eq [#10, l3]
l5: $ G ⇒ scons A8 (scons A9 (scons A10 (scons A11 ∅))) = scons B8 (scons B9 (scons B10 (scons B11 ∅))) $ by scons_eq [#9, l4]
l6: $ G ⇒ scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅)))) = scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅)))) $ by scons_eq [#8, l5]
l7: $ G ⇒ scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅))))) = scons B6 (scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅))))) $ by scons_eq [#7, l6]
l8: $ G ⇒ scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅)))))) = scons B5 (scons B6 (scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅)))))) $ by scons_eq [#6, l7]
l9: $ G ⇒ scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅))))))) = scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅))))))) $ by scons_eq [#5, l8]
l10: $ G ⇒ scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅)))))))) = scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅)))))))) $ by scons_eq [#4, l9]
l11: $ G ⇒ scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅))))))))) = scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅))))))))) $ by scons_eq [#3, l10]
l12: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 (scons A5 (scons A6 (scons A7 (scons A8 (scons A9 (scons A10 (scons A11 ∅)))))))))) = scons B1 (scons B2 (scons B3 (scons B4 (scons B5 (scons B6 (scons B7 (scons B8 (scons B9 (scons B10 (scons B11 ∅)))))))))) $ by scons_eq [#2, l11]
l13: $ G ⇒ kr_iota_lhs = kr_iota_lhs $ by eq_refl
l14: $ G ⇒ ra_iota_lhs A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 = ra_iota_lhs B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 $ by opair_eq [l13, l12]
l15: $ G ⇒ ra_iota_lhs B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 ∈ lrel $ by wcel_eq_l [l14, #1]

lemma x1_eq_crst (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4: class):
  $ G ⇒ ra_crst A1 A2 A3 A4 ∈ lrel $ > $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ >
  $ G ⇒ ra_crst B1 B2 B3 B4 ∈ lrel $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A4 ∅ = scons B4 ∅ $ by scons_eq [#5, l1]
l3: $ G ⇒ scons A3 (scons A4 ∅) = scons B3 (scons B4 ∅) $ by scons_eq [#4, l2]
l4: $ G ⇒ scons A2 (scons A3 (scons A4 ∅)) = scons B2 (scons B3 (scons B4 ∅)) $ by scons_eq [#3, l3]
l5: $ G ⇒ scons A1 (scons A2 (scons A3 (scons A4 ∅))) = scons B1 (scons B2 (scons B3 (scons B4 ∅))) $ by scons_eq [#2, l4]
l6: $ G ⇒ kr_crst = kr_crst $ by eq_refl
l7: $ G ⇒ ra_crst A1 A2 A3 A4 = ra_crst B1 B2 B3 B4 $ by opair_eq [l6, l5]
l8: $ G ⇒ ra_crst B1 B2 B3 B4 ∈ lrel $ by wcel_eq_l [l7, #1]

