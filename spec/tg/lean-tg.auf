ofsort_nat_cases
----------------
l1: $ G ⇒ ⟨ ks_nat , t ⟩ ∈ sorted lsig lopen $ by ofsort_elim [#1]
l2: $ G ⇒ ks_nat ∈ ω $ by v1_ks_nat
l3: $ G ⇒ isset ks_nat $ by wcel_isset [l2]
l4: $ G , k = ks_nat ⇒ k = ks_nat $ by ax
l5: $ G , k = ks_nat ⇒ ks_nat = k $ by eq_sym [l4]
l6: $ G , k = ks_nat ⇒ t = t $ by eq_refl
l7: $ G , k = ks_nat ⇒ ⟨ ks_nat , t ⟩ = ⟨ k , t ⟩ $ by opair_eq [l5, l6]
l8: $ G , k = ks_nat ⇒ ⟨ ks_nat , t ⟩ ∈ sorted lsig lopen $ by weaken [l1]
l9: $ G , k = ks_nat ⇒ ⟨ k , t ⟩ ∈ sorted lsig lopen $ by wcel_eq_l [l7, l8]
l10: $ G , k = ks_nat ⇒ sig lsig lopen $ by lsig_sig
l11: $ G , k = ks_nat ⇒ (∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩)) ∨ (k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩)) $ by sorted_elim [l10, l9]
l12: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by ax
l13: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ by and_elim_l [l12]
l14: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l12]
l15: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) $ by and_elim_l [l14]
l16: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l14]
l17: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a $ by and_elim_l [l16]
l18: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l16]
l19: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen $ by and_elim_l [l18]
l20: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ t = ⟨ c , b ⟩ $ by and_elim_r [l18]
l21: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ k = ks_nat $ by ax
l22: $ G , k = ks_nat , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ v1_d_nat x t $ by v1_node_nat [l13, l21, l15, l17, l19, l20]
l23: $ G , k = ks_nat , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l24: $ G , k = ks_nat , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_nat x t $ by ex_elim [l23, l22]
l25: $ G , k = ks_nat , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l26: $ G , k = ks_nat , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_nat x t $ by ex_elim [l25, l24]
l27: $ G , k = ks_nat , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l28: $ G , k = ks_nat , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_nat x t $ by ex_elim [l27, l26]
l29: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) $ by ax
l30: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k ∊ lopen $ by and_elim_l [l29]
l31: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_nat $ by ax
l32: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ ks_nat ∈ ks_blk $ by v1_lt_nat_blk
l33: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [l31, l32]
l34: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ ks_nat ∈ ks_atom $ by v1_lt_nat_atom
l35: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_atom → ⊥ $ by v1_ne_lt [l31, l34]
l36: $ G , k = ks_nat , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ v1_d_nat x t $ by v1_lopen_no [l33, l35, l30]
l37: $ G , k = ks_nat ⇒ v1_d_nat x t $ by or_elim [l11, l28, l36]
l38: $ G ⇒ (t = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by isset_elim [l3, l37]

--| The cases of sort `lvl`.
def v1_d_lvl {x y: set} (t: set): fml = $ (t = ⟨ kc_lz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $

lemma v1_node_lvl (G: hyps) {x y: set} (c k a b t: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ > $ G ⇒ k = ks_lvl $ > $ G ⇒ b ∊ fseq (trees ω) $ >
  $ G ⇒ cdm b = cdm a $ > $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G ⇒ v1_d_lvl x y t $
----
l1: $ G ⇒ ks_nat ∈ ks_lvl $ by v1_lt_nat_lvl
l2: $ G ⇒ k = ks_nat → ⊥ $ by v1_ne_gt [#2, l1]
l3: $ G ⇒ ks_lvl ∈ ks_lvls $ by v1_lt_lvl_lvls
l4: $ G ⇒ k = ks_lvls → ⊥ $ by v1_ne_lt [#2, l3]
l5: $ G ⇒ ks_lvl ∈ ks_expr $ by v1_lt_lvl_expr
l6: $ G ⇒ k = ks_expr → ⊥ $ by v1_ne_lt [#2, l5]
l7: $ G ⇒ ks_lvl ∈ ks_atom $ by v1_lt_lvl_atom
l8: $ G ⇒ k = ks_atom → ⊥ $ by v1_ne_lt [#2, l7]
l9: $ G ⇒ ks_lvl ∈ ks_ctx $ by v1_lt_lvl_ctx
l10: $ G ⇒ k = ks_ctx → ⊥ $ by v1_ne_lt [#2, l9]
l11: $ G ⇒ ks_lvl ∈ ks_bin $ by v1_lt_lvl_bin
l12: $ G ⇒ k = ks_bin → ⊥ $ by v1_ne_lt [#2, l11]
l13: $ G ⇒ ks_lvl ∈ ks_blk $ by v1_lt_lvl_blk
l14: $ G ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [#2, l13]
l15: $ G ⇒ ks_lvl ∈ ks_ind $ by v1_lt_lvl_ind
l16: $ G ⇒ k = ks_ind → ⊥ $ by v1_ne_lt [#2, l15]
l17: $ G ⇒ ks_lvl ∈ ks_tys $ by v1_lt_lvl_tys
l18: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_lt [#2, l17]
l19: $ G ⇒ ks_lvl ∈ ks_ctors $ by v1_lt_lvl_ctors
l20: $ G ⇒ k = ks_ctors → ⊥ $ by v1_ne_lt [#2, l19]
l21: $ G ⇒ ks_lvl ∈ ω $ by v1_ks_lvl
l22: $ G ⇒ isset ks_lvl $ by wcel_isset [l21]
l23: $ G ⇒ ks_nat ∈ ω $ by v1_ks_nat
l24: $ G ⇒ isset ks_nat $ by wcel_isset [l23]
l25: $ G , (t = ⟨ kc_lz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ (t = ⟨ kc_lz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by ax
l26: $ G ⇒ ((t = ⟨ kc_lz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_lvl x y t $ by imp_intro [l25]
l27: $ G ⇒ (t = ⟨ kc_lz , ∅ ⟩) → v1_d_lvl x y t $ by v1_imp_or_l [l26]
l28: $ G ⇒ (∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_lvl x y t $ by v1_imp_or_r [l26]
l29: $ G ⇒ (∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl)) → v1_d_lvl x y t $ by v1_imp_or_l [l28]
l30: $ G ⇒ (∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_lvl x y t $ by v1_imp_or_r [l28]
l31: $ G ⇒ (∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl)) → v1_d_lvl x y t $ by v1_imp_or_l [l30]
l32: $ G ⇒ (∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_lvl x y t $ by v1_imp_or_r [l30]
l33: $ G ⇒ (∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl)) → v1_d_lvl x y t $ by v1_imp_or_l [l32]
l34: $ G ⇒ (∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_lvl x y t $ by v1_imp_or_r [l32]
l35: $ G , c = kc_lz ∧ a = ∅ ⇒ (t = ⟨ kc_lz , ∅ ⟩) $ by v1_build0 [#3, #4, #6]
l36: $ G , c = kc_lz ∧ a = ∅ ⇒ (t = ⟨ kc_lz , ∅ ⟩) → v1_d_lvl x y t $ by weaken [l27]
l37: $ G , c = kc_lz ∧ a = ∅ ⇒ v1_d_lvl x y t $ by imp_elim [l36, l35]
l38: $ G , c = kc_ls ∧ a = scons ks_lvl ∅ ⇒ ∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $ by v1_build1 [l22, #3, #4, #5, #6]
l39: $ G , c = kc_ls ∧ a = scons ks_lvl ∅ ⇒ (∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl)) → v1_d_lvl x y t $ by weaken [l29]
l40: $ G , c = kc_ls ∧ a = scons ks_lvl ∅ ⇒ v1_d_lvl x y t $ by imp_elim [l39, l38]
l41: $ G , c = kc_lmax ∧ a = scons ks_lvl (scons ks_lvl ∅) ⇒ ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) $ by v1_build2 [l22, l22, #3, #4, #5, #6]
l42: $ G , c = kc_lmax ∧ a = scons ks_lvl (scons ks_lvl ∅) ⇒ (∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl)) → v1_d_lvl x y t $ by weaken [l31]
l43: $ G , c = kc_lmax ∧ a = scons ks_lvl (scons ks_lvl ∅) ⇒ v1_d_lvl x y t $ by imp_elim [l42, l41]
