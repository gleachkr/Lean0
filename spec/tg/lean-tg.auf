l101: $ G ⇒ ∃ k_v ∃ i_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨ ∃ k_v ∃ a_v ∃ a2 (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons k_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a2 ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ a_v a2 ∈ lrel) ∨ ∃ k_v ∃ i_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons i_v ∅ ⟩ ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel) ∨ ∃ k_v ∃ l_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ k_v ∃ f_v ∃ x_v ∃ a_v ∃ f2 ∃ x2_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons x_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_app , scons f2 (scons x2_v ∅) ⟩ ∧ ra_inst k_v f_v a_v f2 ∈ lrel ∧ ra_inst k_v x_v a_v x2_v ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) ∨ ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) ∨ ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $ by imp_elim [l100, #1]

lemma y1_e_lookup_z (G: hyps) {A A2 G_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅ , ra_lookup ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅ , ra_lookup ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V2 ⟩ = ⟨ pp , ra_lookup t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lookup t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_lookup ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅ ∧ ra_lookup t1 t2 t3 = ra_lookup ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_lookup t1 t2 t3 = ra_lookup ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_lookup ∈ ω $ by x1_kr_lookup
l23: $ G ⇒ isset kr_lookup $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_lookup = kr_lookup ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V2 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V2 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V2 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2) $ by opair_isset
l39: $ G ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ G_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 V2 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V1 A2 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by ex_intro [l44]

lemma y1_d_lookup_z (G: hyps) {A A2 G_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x ∊ cl_lookup_z ⇒ x ∊ cl_lookup_z $ by ax
l2: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x ∊ cl_lookup_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩ ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by y1_e_lookup_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y z) ∅ , ra_lookup ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_nz , ∅ ⟩ z ⟩) ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x ∊ cl_lookup_z ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_lookup_s (G: hyps) {A B B2 G_v n_v: set} (pp t1 t2 t3 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ = ⟨ scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅) , ra_lookup ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅) , ra_lookup ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟩ = ⟨ pp , ra_lookup t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_lookup t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_lookup ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅) ∧ ra_lookup t1 t2 t3 = ra_lookup ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_lookup t1 t2 t3 = ra_lookup ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟨ kc_s , scons V5 ∅ ⟩ V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V3 $ by isset_var
l17: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V5 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_lookup ∈ ω $ by x1_kr_lookup
l23: $ G ⇒ isset kr_lookup $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_lookup = kr_lookup ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ scons t3 ∅ = scons V3 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V5 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V3 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅)) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_lookup V4 V5 V2) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅)) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_lookup V4 V5 V2) $ by opair_isset
l39: $ G ⇒ ra_lookup V4 V5 V2 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) ∅) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3) $ by opair_isset
l42: $ G ⇒ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ ra_lookup V4 V5 V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel $ by and_intro [l39, l42]
l44: $ G ⇒ t3 = V3 ∧ ra_lookup V4 V5 V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel $ by and_intro [l35, l43]
l45: $ G ⇒ t2 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ t3 = V3 ∧ ra_lookup V4 V5 V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel $ by and_intro [l32, l44]
l46: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ t3 = V3 ∧ ra_lookup V4 V5 V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel $ by and_intro [l29, l45]
l47: $ G ⇒ ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = V3 ∧ ra_lookup V4 n_v V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = V3 ∧ ra_lookup G_v n_v V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 V3 ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v V2 ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V2 B2 ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_intro [l49]
l51: $ G ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_intro [l50]

lemma y1_d_lookup_s (G: hyps) {A B B2 G_v n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x ∊ cl_lookup_s ⇒ x ∊ cl_lookup_s $ by ax
l2: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x ∊ cl_lookup_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩ ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by y1_e_lookup_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_lookup v w z) (scons (ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ z u) ∅) , ra_lookup ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟨ kc_s , scons w ∅ ⟩ u ⟩) ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_lookup t1 t2 t3 ⟩ , x ∊ cl_lookup_s ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_o_lookup (G: hyps) {A A2 G_v B B2 n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ pr_lookup $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s $ by ax
l2: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by y1_d_lookup_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s → ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s $ by ax
l6: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∨ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z $ by ax
l8: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) $ by y1_d_lookup_z [l7, l8]
l10: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s $ by ax
l12: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s → ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_s ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_lookup t1 t2 t3 ⟩ ∈ cl_lookup_z ∪ cl_lookup_s → ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨ ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_cinst_z (G: hyps) {G0 A0 a_v: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ V1 V2 V3 ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $
----
l1: $ G ⇒ ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ V1 V2 V3 ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ V1 ⟩ = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cinst t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_cinst ⟨ kc_nz , ∅ ⟩ V1 V2 V3 ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_cinst t1 t2 t3 t4 t5 t6 = ra_cinst ⟨ kc_nz , ∅ ⟩ V1 V2 V3 ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cinst t1 t2 t3 t4 t5 t6 = ra_cinst ⟨ kc_nz , ∅ ⟩ V1 V2 V3 ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V1 $ by isset_var
l23: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V3 $ by isset_var
l27: $ G ⇒ scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V2 $ by isset_var
l29: $ G ⇒ scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)))) ∈ fseq y1_vv $ by y1_fs [l22, l29]
l31: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l32: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅))))) ∈ fseq y1_vv $ by y1_fs [l31, l30]
l33: $ G ⇒ kr_cinst ∈ ω $ by x1_kr_cinst
l34: $ G ⇒ isset kr_cinst $ by wcel_isset [l33]
l35: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l36: $ G ⇒ isset (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)))))) $ by wcel_isset [l32]
l37: $ G ⇒ kr_cinst = kr_cinst ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅))))) $ by opair_inj_c [l8, l34, l35, l34, l36]
l38: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅))))) $ by and_elim_r [l37]
l39: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)))) $ by y1_scons_inj [l38, l20, l31, l19, l30]
l40: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l39]
l41: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V1 (scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)))) $ by and_elim_r [l39]
l42: $ G ⇒ t2 = V1 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅))) $ by y1_scons_inj [l41, l18, l22, l17, l29]
l43: $ G ⇒ t2 = V1 $ by and_elim_l [l42]
l44: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V2 (scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅))) $ by and_elim_r [l42]
l45: $ G ⇒ t3 = V2 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)) $ by y1_scons_inj [l44, l16, l28, l15, l27]
l46: $ G ⇒ t3 = V2 $ by and_elim_l [l45]
l47: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅)) $ by and_elim_r [l45]
l48: $ G ⇒ t4 = V3 ∧ scons t5 (scons t6 ∅) = scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅) $ by y1_scons_inj [l47, l14, l26, l13, l25]
l49: $ G ⇒ t4 = V3 $ by and_elim_l [l48]
l50: $ G ⇒ scons t5 (scons t6 ∅) = scons ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ (scons V1 ∅) $ by and_elim_r [l48]
l51: $ G ⇒ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ scons t6 ∅ = scons V1 ∅ $ by y1_scons_inj [l50, l12, l24, l11, l23]
l52: $ G ⇒ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ $ by and_elim_l [l51]
l53: $ G ⇒ scons t6 ∅ = scons V1 ∅ $ by and_elim_r [l51]
l54: $ G ⇒ t6 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l53, l10, l22, l9, l9]
l55: $ G ⇒ t6 = V1 $ by and_elim_l [l54]
l56: $ G ⇒ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ t6 = V1 $ by and_intro [l52, l55]
l57: $ G ⇒ t4 = V3 ∧ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ t6 = V1 $ by and_intro [l49, l56]
l58: $ G ⇒ t3 = V2 ∧ t4 = V3 ∧ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ t6 = V1 $ by and_intro [l46, l57]
l59: $ G ⇒ t2 = V1 ∧ t3 = V2 ∧ t4 = V3 ∧ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ t6 = V1 $ by and_intro [l43, l58]
l60: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V2 ∧ t4 = V3 ∧ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ t6 = V1 $ by and_intro [l40, l59]
l61: $ G ⇒ ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V2 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons V2 (scons V1 ∅) ⟩ ∧ t6 = V1) $ by ex_intro [l60]
l62: $ G ⇒ ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons V1 ∅) ⟩ ∧ t6 = V1) $ by ex_intro [l61]
l63: $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by ex_intro [l62]

lemma y1_d_cinst_z (G: hyps) {G0 A0 a_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $
----
l1: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_cinst_z ⇒ x ∊ cl_cinst_z $ by ax
l2: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_cinst_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩ ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by y1_e_cinst_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_cinst ⟨ kc_nz , ∅ ⟩ y z u ⟨ kc_cons , scons z (scons y ∅) ⟩ y ⟩) ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_cinst_z ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by wcel_elim [#1, l13]

lemma y1_e_cinst_s (G: hyps) {k_v G0 G1 G_v A0 a_v A A2: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅) , ra_cinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V5 V6 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅) , ra_cinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V5 V6 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cinst t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_cinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V5 V6 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅) ∧ ra_cinst t1 t2 t3 t4 t5 t6 = ra_cinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V5 V6 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_cinst t1 t2 t3 t4 t5 t6 = ra_cinst ⟨ kc_s , scons V1 ∅ ⟩ V2 V5 V6 ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V6 $ by isset_var
l27: $ G ⇒ scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V5 $ by isset_var
l29: $ G ⇒ scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset ⟨ kc_s , scons V1 ∅ ⟩ $ by opair_isset
l33: $ G ⇒ scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_cinst ∈ ω $ by x1_kr_cinst
l35: $ G ⇒ isset kr_cinst $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_cinst = kr_cinst ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V5 (scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V5 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V5 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V6 (scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V6 ∧ scons t5 (scons t6 ∅) = scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V6 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ (scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ scons t6 ∅ = scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l52]
l55: $ G ⇒ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l54, l10, l22, l9, l9]
l56: $ G ⇒ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ $ by and_elim_l [l55]
l57: $ G ⇒ crn pp = crn (scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅)) $ by crn_eq [l7]
l58: $ G ⇒ crn (scons (ra_cinst V1 V2 V5 V6 V3 V4) (scons (ra_inst V1 V7 V6 V8) ∅)) ⊆ lrel $ by subset_eq_l [l57, #2]
l59: $ G ⇒ isset (ra_cinst V1 V2 V5 V6 V3 V4) $ by opair_isset
l60: $ G ⇒ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel $ by crn_scons_head [l59, l58]
l61: $ G ⇒ crn (scons (ra_inst V1 V7 V6 V8) ∅) ⊆ lrel $ by crn_scons_tail [l58]
l62: $ G ⇒ isset (ra_inst V1 V7 V6 V8) $ by opair_isset
l63: $ G ⇒ ra_inst V1 V7 V6 V8 ∈ lrel $ by crn_scons_head [l62, l61]
l64: $ G ⇒ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l60, l63]
l65: $ G ⇒ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l56, l64]
l66: $ G ⇒ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l53, l65]
l67: $ G ⇒ t4 = V6 ∧ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l50, l66]
l68: $ G ⇒ t3 = V5 ∧ t4 = V6 ∧ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l47, l67]
l69: $ G ⇒ t2 = V2 ∧ t3 = V5 ∧ t4 = V6 ∧ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l44, l68]
l70: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = V5 ∧ t4 = V6 ∧ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons V8 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 V8 ∈ lrel $ by and_intro [l41, l69]
l71: $ G ⇒ ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = V5 ∧ t4 = V6 ∧ t5 = ⟨ kc_cons , scons V7 (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 V7 V6 A2 ∈ lrel) $ by ex_intro [l70]
l72: $ G ⇒ ∃ A ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = V5 ∧ t4 = V6 ∧ t5 = ⟨ kc_cons , scons A (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 V6 V3 V4 ∈ lrel ∧ ra_inst V1 A V6 A2 ∈ lrel) $ by ex_intro [l71]
l73: $ G ⇒ ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = V5 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 V5 a_v V3 V4 ∈ lrel ∧ ra_inst V1 A a_v A2 ∈ lrel) $ by ex_intro [l72]
l74: $ G ⇒ ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons V4 ∅) ⟩ ∧ ra_cinst V1 V2 A0 a_v V3 V4 ∈ lrel ∧ ra_inst V1 A a_v A2 ∈ lrel) $ by ex_intro [l73]
l75: $ G ⇒ ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons V3 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst V1 V2 A0 a_v V3 G_v ∈ lrel ∧ ra_inst V1 A a_v A2 ∈ lrel) $ by ex_intro [l74]
l76: $ G ⇒ ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst V1 V2 A0 a_v G1 G_v ∈ lrel ∧ ra_inst V1 A a_v A2 ∈ lrel) $ by ex_intro [l75]
l77: $ G ⇒ ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst V1 G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst V1 A a_v A2 ∈ lrel) $ by ex_intro [l76]
l78: $ G ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_intro [l77]

lemma y1_d_cinst_s (G: hyps) {k_v G0 G1 G_v A0 a_v A A2: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_cinst_s ⇒ x ∊ cl_cinst_s $ by ax
l2: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_cinst_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by y1_e_cinst_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) $ by ax
l22: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_cinst y z w a u v) (scons (ra_inst y b a c) ∅) , ra_cinst ⟨ kc_s , scons y ∅ ⟩ z w a ⟨ kc_cons , scons b (scons u ∅) ⟩ ⟨ kc_cons , scons c (scons v ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_cinst_s ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by ex_elim [l2, l22]
l24: $ G ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by wcel_elim [#1, l23]

lemma y1_o_cinst (G: hyps) {G0 A0 a_v k_v G1 G_v A A2: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_cinst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s $ by ax
l2: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by y1_d_cinst_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s → ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s $ by ax
l6: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∨ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z $ by ax
l8: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) $ by y1_d_cinst_z [l7, l8]
l10: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s $ by ax
l12: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s → ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_s ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_cinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_cinst_z ∪ cl_cinst_s → ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨ ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_cext_z (G: hyps) {G_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_cext t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cext t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_cext ⟨ kc_nz , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_cext t1 t2 t3 = ra_cext ⟨ kc_nz , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cext t1 t2 t3 = ra_cext ⟨ kc_nz , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_cext ∈ ω $ by x1_kr_cext
l22: $ G ⇒ isset kr_cext $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_cext = kr_cext ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by ex_intro [l36]

lemma y1_d_cext_z (G: hyps) {G_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $
----
l1: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x ∊ cl_cext_z ⇒ x ∊ cl_cext_z $ by ax
l2: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x ∊ cl_cext_z ⇒ ∃ y (x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_cext t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cext ⟨ kc_nz , ∅ ⟩ y y ⟩ ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by y1_e_cext_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x ∊ cl_cext_z ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by wcel_elim [#1, l9]

lemma y1_e_cext_s (G: hyps) {n_v G_v G2 A: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ = ⟨ scons (ra_cext V1 V2 V3) ∅ , ra_cext ⟨ kc_s , scons V1 ∅ ⟩ V2 ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_cext V1 V2 V3) ∅ , ra_cext ⟨ kc_s , scons V1 ∅ ⟩ V2 ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ⟩ = ⟨ pp , ra_cext t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_cext V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cext t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_cext ⟨ kc_s , scons V1 ∅ ⟩ V2 ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_cext V1 V2 V3) ∅ ∧ ra_cext t1 t2 t3 = ra_cext ⟨ kc_s , scons V1 ∅ ⟩ V2 ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_cext V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cext t1 t2 t3 = ra_cext ⟨ kc_s , scons V1 ∅ ⟩ V2 ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_s , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_cext ∈ ω $ by x1_kr_cext
l23: $ G ⇒ isset kr_cext $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_cext = kr_cext ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_cext V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_cext V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_cext V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_cext V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∧ ra_cext V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∧ ra_cext V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V4 (scons V3 ∅) ⟩ ∧ ra_cext V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ A (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons A (scons V3 ∅) ⟩ ∧ ra_cext V1 V2 V3 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ G2 ∃ A (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext V1 V2 G2 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext V1 G_v G2 ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by ex_intro [l45]

lemma y1_d_cext_s (G: hyps) {n_v G_v G2 A: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x ∊ cl_cext_s ⇒ x ∊ cl_cext_s $ by ax
l2: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x ∊ cl_cext_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_cext t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩ ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by y1_e_cext_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cext y z u) ∅ , ra_cext ⟨ kc_s , scons y ∅ ⟩ z ⟨ kc_cons , scons v (scons u ∅) ⟩ ⟩) ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_cext t1 t2 t3 ⟩ , x ∊ cl_cext_s ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_cext (G: hyps) {G_v n_v G2 A: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ pr_cext $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s $ by ax
l2: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by y1_d_cext_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s → ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s $ by ax
l6: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∨ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z $ by ax
l8: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by y1_d_cext_z [l7, l8]
l10: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s $ by ax
l12: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s → ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_s ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_cext t1 t2 t3 ⟩ ∈ cl_cext_z ∪ cl_cext_s → ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_clen_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ = ⟨ pp , ra_clen t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_clen t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_clen t1 t2 = ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_clen t1 t2 = ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_clen ∈ ω $ by x1_kr_clen
l19: $ G ⇒ isset kr_clen $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_clen = kr_clen ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nz , ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_nz , ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_intro [l25, l28]

lemma y1_d_clen_nil (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ x ∊ cl_clen_nil $ by ax
l2: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ (x = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ x = ⟨ pp , ra_clen t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ ⟨ pp , ra_clen t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ ⟨ pp , ra_clen t1 t2 ⟩ = ⟨ ∅ , ra_clen ⟨ kc_nil , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_nil ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_e_clen_nil [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by wcel_elim [#1, l7]

lemma y1_e_clen_cons (G: hyps) {A G_v n_v: set} (pp t1 t2 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ = ⟨ scons (ra_clen V2 V3) ∅ , ra_clen ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_clen V2 V3) ∅ , ra_clen ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_clen t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_clen V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_clen t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_clen ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_clen V2 V3) ∅ ∧ ra_clen t1 t2 = ra_clen ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_clen V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_clen t1 t2 = ra_clen ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_s , scons V3 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_clen ∈ ω $ by x1_kr_clen
l19: $ G ⇒ isset kr_clen $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_clen = kr_clen ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_s , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_s , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_clen V2 V3) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_clen V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_clen V2 V3) $ by opair_isset
l32: $ G ⇒ ra_clen V2 V3 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_clen V2 V3 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V3 ∅ ⟩ ∧ ra_clen V2 V3 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen V2 n_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by ex_intro [l35]
l37: $ G ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by ex_intro [l36]

lemma y1_d_clen_cons (G: hyps) {A G_v n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_cons ⇒ x ∊ cl_clen_cons $ by ax
l2: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_cons ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_clen t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_clen t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_clen t1 t2 ⟩ = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by y1_e_clen_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_clen z u) ∅ , ra_clen ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_clen t1 t2 ⟩ , x ∊ cl_clen_cons ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_clen (G: hyps) {A G_v n_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ pr_clen $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons $ by ax
l2: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by y1_d_clen_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons → ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons $ by ax
l6: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∨ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil $ by ax
l8: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) $ by y1_d_clen_nil [l7, l8]
l10: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons $ by ax
l12: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons → ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_cons ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_clen t1 t2 ⟩ ∈ cl_clen_nil ∪ cl_clen_cons → (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_cnth_z (G: hyps) {A G_v: set} (pp t1 t2 t3 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $
----
l1: $ G ⇒ ⟨ ∅ , ra_cnth ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 ⟩ = ⟨ pp , ra_cnth t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cnth t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_cnth ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_cnth t1 t2 t3 = ra_cnth ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cnth t1 t2 t3 = ra_cnth ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_cnth ∈ ω $ by x1_kr_cnth
l23: $ G ⇒ isset kr_cnth $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_cnth = kr_cnth ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V1 $ by and_elim_l [l34]
l36: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l32, l35]
l37: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1 $ by and_intro [l29, l36]
l38: $ G ⇒ ∃ G_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V1) $ by ex_intro [l37]
l39: $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by ex_intro [l38]

lemma y1_d_cnth_z (G: hyps) {A G_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $
----
l1: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x ∊ cl_cnth_z ⇒ x ∊ cl_cnth_z $ by ax
l2: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x ∊ cl_cnth_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩ ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by y1_e_cnth_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ z (x = ⟨ ∅ , ra_cnth ⟨ kc_cons , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ y ⟩) ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x ∊ cl_cnth_z ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by wcel_elim [#1, l11]

lemma y1_e_cnth_s (G: hyps) {A B G_v n_v: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ = ⟨ scons (ra_cnth V3 V4 V2) ∅ , ra_cnth ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_cnth V3 V4 V2) ∅ , ra_cnth ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 ⟩ = ⟨ pp , ra_cnth t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_cnth V3 V4 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_cnth t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_cnth ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_cnth V3 V4 V2) ∅ ∧ ra_cnth t1 t2 t3 = ra_cnth ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_cnth V3 V4 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_cnth t1 t2 t3 = ra_cnth ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V2 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V2 $ by isset_var
l17: $ G ⇒ scons V2 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_cnth ∈ ω $ by x1_kr_cnth
l23: $ G ⇒ isset kr_cnth $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_cnth = kr_cnth ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V2 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t3 ∅ = scons V2 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V2 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V2 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_cnth V3 V4 V2) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_cnth V3 V4 V2) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_cnth V3 V4 V2) $ by opair_isset
l39: $ G ⇒ ra_cnth V3 V4 V2 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V2 ∧ ra_cnth V3 V4 V2 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V2 ∧ ra_cnth V3 V4 V2 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V2 ∧ ra_cnth V3 V4 V2 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons V3 ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = V2 ∧ ra_cnth V3 n_v V2 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = V2 ∧ ra_cnth G_v n_v V2 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons V1 (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by ex_intro [l45]

lemma y1_d_cnth_s (G: hyps) {A B G_v n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x ∊ cl_cnth_s ⇒ x ∊ cl_cnth_s $ by ax
l2: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x ∊ cl_cnth_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩ ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by y1_e_cnth_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_cnth u v z) ∅ , ra_cnth ⟨ kc_cons , scons y (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ z ⟩) ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_cnth t1 t2 t3 ⟩ , x ∊ cl_cnth_s ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_cnth (G: hyps) {A G_v B n_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ pr_cnth $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s $ by ax
l2: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by y1_d_cnth_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s → ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s $ by ax
l6: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∨ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z $ by ax
l8: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) $ by y1_d_cnth_z [l7, l8]
l10: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s $ by ax
l12: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s → ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_s ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_cnth t1 t2 t3 ⟩ ∈ cl_cnth_z ∪ cl_cnth_s → ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨ ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_capp_nil (G: hyps) {G_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ V1 V1 ⟩ = ⟨ pp , ra_capp t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_capp t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_capp ⟨ kc_nil , ∅ ⟩ V1 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_capp t1 t2 t3 = ra_capp ⟨ kc_nil , ∅ ⟩ V1 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_capp t1 t2 t3 = ra_capp ⟨ kc_nil , ∅ ⟩ V1 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons V1 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l20: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_capp ∈ ω $ by x1_kr_capp
l22: $ G ⇒ isset kr_capp $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_capp = kr_capp ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons V1 (scons V1 ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons V1 (scons V1 ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = V1 ∧ scons t3 ∅ = scons V1 ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = V1 $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons V1 ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = V1 $ by and_elim_l [l33]
l35: $ G ⇒ t2 = V1 ∧ t3 = V1 $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V1 $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by ex_intro [l36]

lemma y1_d_capp_nil (G: hyps) {G_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $
----
l1: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x ∊ cl_capp_nil ⇒ x ∊ cl_capp_nil $ by ax
l2: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x ∊ cl_capp_nil ⇒ ∃ y (x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ pp , ra_capp t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_capp ⟨ kc_nil , ∅ ⟩ y y ⟩ ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by y1_e_capp_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x ∊ cl_capp_nil ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by wcel_elim [#1, l9]

lemma y1_e_capp_cons (G: hyps) {A P G_v G2: set} (pp t1 t2 t3 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ = ⟨ scons (ra_capp V2 V3 V4) ∅ , ra_capp ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ V3 ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_capp V2 V3 V4) ∅ , ra_capp ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ V3 ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ⟩ = ⟨ pp , ra_capp t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_capp V2 V3 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_capp t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_capp ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ V3 ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_capp V2 V3 V4) ∅ ∧ ra_capp t1 t2 t3 = ra_capp ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ V3 ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_capp V2 V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_capp t1 t2 t3 = ra_capp ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ V3 ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V3 $ by isset_var
l19: $ G ⇒ scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_capp ∈ ω $ by x1_kr_capp
l23: $ G ⇒ isset kr_capp $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_capp = kr_capp ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ (scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ scons t2 (scons t3 ∅) = scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V3 (scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V3 ∧ scons t3 ∅ = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V3 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_capp V2 V3 V4) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_capp V2 V3 V4) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_capp V2 V3 V4) $ by opair_isset
l39: $ G ⇒ ra_capp V2 V3 V4 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ ra_capp V2 V3 V4 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = V3 ∧ t3 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ ra_capp V2 V3 V4 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = V3 ∧ t3 = ⟨ kc_cons , scons V1 (scons V4 ∅) ⟩ ∧ ra_capp V2 V3 V4 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ G2 (t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = V3 ∧ t3 = ⟨ kc_cons , scons V1 (scons G2 ∅) ⟩ ∧ ra_capp V2 V3 G2 ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons V1 (scons V2 ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons V1 (scons G2 ∅) ⟩ ∧ ra_capp V2 G_v G2 ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons V1 (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons V1 (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by ex_intro [l45]

lemma y1_d_capp_cons (G: hyps) {A P G_v G2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x ∊ cl_capp_cons ⇒ x ∊ cl_capp_cons $ by ax
l2: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x ∊ cl_capp_cons ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_capp t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩ ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by y1_e_capp_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) ⇒ ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_capp z u v) ∅ , ra_capp ⟨ kc_cons , scons y (scons z ∅) ⟩ u ⟨ kc_cons , scons y (scons v ∅) ⟩ ⟩) ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_capp t1 t2 t3 ⟩ , x ∊ cl_capp_cons ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by wcel_elim [#1, l15]

lemma y1_o_capp (G: hyps) {G_v A P G2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ pr_capp $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons $ by ax
l2: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by y1_d_capp_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons → ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons $ by ax
l6: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∨ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil $ by ax
l8: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) $ by y1_d_capp_nil [l7, l8]
l10: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons $ by ax
l12: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons → ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_cons ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_capp t1 t2 t3 ⟩ ∈ cl_capp_nil ∪ cl_capp_cons → ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨ ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_bsucc_0 (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = ⟨ ∅ , ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⟩ = ⟨ pp , ra_bsucc t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bsucc t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bsucc t1 t2 = ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bsucc t1 t2 = ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_b0 , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_bsucc ∈ ω $ by x1_kr_bsucc
l19: $ G ⇒ isset kr_bsucc $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_bsucc = kr_bsucc ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_b0 , ∅ ⟩ (scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ $ by and_intro [l25, l28]

lemma y1_d_bsucc_0 (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ x ∊ cl_bsucc_0 $ by ax
l2: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ (x = ⟨ ∅ , ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ x = ⟨ pp , ra_bsucc t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = ⟨ ∅ , ra_bsucc ⟨ kc_b0 , ∅ ⟩ ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩ ⟩ $ by eq_trans [l4, l2]
l6: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l7: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_0 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $ by y1_e_bsucc_0 [l5, l6]
l8: $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $ by wcel_elim [#1, l7]

lemma y1_e_bsucc_d0 (G: hyps) {a_v: set} (pp t1 t2 V1: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_bsucc t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bsucc t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_bsucc ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_bsucc t1 t2 = ra_bsucc ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bsucc t1 t2 = ra_bsucc ⟨ kc_bd0 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_bsucc ∈ ω $ by x1_kr_bsucc
l19: $ G ⇒ isset kr_bsucc $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_bsucc = kr_bsucc ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_bd0 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ t1 = ⟨ kc_bd0 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by and_intro [l25, l28]
l30: $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $ by ex_intro [l29]

lemma y1_d_bsucc_d0 (G: hyps) {a_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_d0 ⇒ x ∊ cl_bsucc_d0 $ by ax
l2: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_d0 ⇒ ∃ y (x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_bsucc t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ ∅ , ra_bsucc ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd1 , scons y ∅ ⟩ ⟩ ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $ by y1_e_bsucc_d0 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_d0 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_bsucc_d1 (G: hyps) {a_v b_v: set} (pp t1 t2 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = ⟨ scons (ra_bsucc V1 V2) ∅ , ra_bsucc ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bsucc V1 V2) ∅ , ra_bsucc ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ ⟩ = ⟨ pp , ra_bsucc t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bsucc V1 V2) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bsucc t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_bsucc ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_bsucc V1 V2) ∅ ∧ ra_bsucc t1 t2 = ra_bsucc ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bsucc V1 V2) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bsucc t1 t2 = ra_bsucc ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by opair_isset
l15: $ G ⇒ scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_bsucc ∈ ω $ by x1_kr_bsucc
l19: $ G ⇒ isset kr_bsucc $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_bsucc = kr_bsucc ∧ scons t1 (scons t2 ∅) = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ scons t2 ∅ = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons ⟨ kc_bd0 , scons V2 ∅ ⟩ ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_bsucc V1 V2) ∅) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_bsucc V1 V2) ∅) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_bsucc V1 V2) $ by opair_isset
l32: $ G ⇒ ra_bsucc V1 V2 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ ra_bsucc V1 V2 ∈ lrel $ by and_intro [l28, l32]
l34: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons V2 ∅ ⟩ ∧ ra_bsucc V1 V2 ∈ lrel $ by and_intro [l25, l33]
l35: $ G ⇒ ∃ b_v (t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc V1 b_v ∈ lrel) $ by ex_intro [l34]
l36: $ G ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by ex_intro [l35]

lemma y1_d_bsucc_d1 (G: hyps) {a_v b_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_d1 ⇒ x ∊ cl_bsucc_d1 $ by ax
l2: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_d1 ⇒ ∃ y ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_bsucc t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩ ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by y1_e_bsucc_d1 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , ∃ z (x = ⟨ scons (ra_bsucc y z) ∅ , ra_bsucc ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_bsucc t1 t2 ⟩ , x ∊ cl_bsucc_d1 ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by wcel_elim [#1, l11]

lemma y1_o_bsucc (G: hyps) {a_v b_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ pr_bsucc $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 $ by ax
l2: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by y1_d_bsucc_d1 [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 → ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 $ by ax
l6: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∨ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 $ by ax
l8: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) $ by y1_d_bsucc_d0 [l7, l8]
l10: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 $ by ax
l12: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 → ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 → ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) $ by ax
l18: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∨ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ (cl_bsucc_d0 ∪ cl_bsucc_d1) $ by v1_wcel_cun_elim [l17]
l19: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 $ by ax
l20: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l21: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) $ by y1_d_bsucc_0 [l19, l20]
l22: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by or_intro_l [l21]
l23: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 $ by ax
l24: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 → ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by weaken [l16]
l25: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by imp_elim [l24, l23]
l26: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_d0 ∪ cl_bsucc_d1 ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by or_intro_r [l25]
l27: $ G , ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by or_elim [l18, l22, l26]
l28: $ G ⇒ ⟨ pp , ra_bsucc t1 t2 ⟩ ∈ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) → (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by imp_intro [l27]
l29: $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨ ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨ ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $ by imp_elim [l28, #1]

lemma y1_e_bdbl_0 (G: hyps) (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_bdbl t1 t2 ⟩ = ⟨ ∅ , ra_bdbl ⟨ kc_b0 , ∅ ⟩ ⟨ kc_b0 , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
