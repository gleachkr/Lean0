l26: $ G ⇒ isset V11 $ by isset_var
l27: $ G ⇒ scons V11 (scons V4 (scons V5 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V10 $ by isset_var
l29: $ G ⇒ scons V10 (scons V11 (scons V4 (scons V5 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V9 $ by isset_var
l31: $ G ⇒ scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ $ by opair_isset
l33: $ G ⇒ scons ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ (scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_nst_hit ∈ ω $ by x1_kr_nst_hit
l35: $ G ⇒ isset kr_nst_hit $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ (scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_nst_hit = kr_nst_hit ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ (scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ (scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = ⟨ kc_cons , scons V1 (scons V6 ∅) ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V9 (scons V10 (scons V11 (scons V4 (scons V5 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V9 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V10 (scons V11 (scons V4 (scons V5 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V9 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V10 (scons V11 (scons V4 (scons V5 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V10 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V11 (scons V4 (scons V5 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V10 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V11 (scons V4 (scons V5 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V11 ∧ scons t5 (scons t6 ∅) = scons V4 (scons V5 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
