lemma y1_o_struct_like (G: hyps) {D b_v P T j_v F K l_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_struct_like t1 t2 ⟩ ∈ pr_struct_like $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = D ∧ t2 = j_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = D ∧ t2 = j_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by y1_d_struct_like_i [#1, #2]

lemma y1_e_field_ty_i (G: hyps) {D b_v P T j_v i_v np n_v m_v F K K2 A C: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14: set):
  $ G ⇒ ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V10 V14) (scons (ra_nth_ctor V14 ⟨ kc_nz , ∅ ⟩ V11) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V8 V7 V11 V12) (scons (ra_nth_pi V12 V6 V13) ∅)))))) , ra_field_ty V1 V5 V6 V13 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ A ∃ C (t1 = D ∧ t2 = j_v ∧ t3 = i_v ∧ t4 = A ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ctor C ⟨ kc_nz , ∅ ⟩ K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_nth_pi K2 i_v A ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V10 V14) (scons (ra_nth_ctor V14 ⟨ kc_nz , ∅ ⟩ V11) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V8 V7 V11 V12) (scons (ra_nth_pi V12 V6 V13) ∅)))))) , ra_field_ty V1 V5 V6 V13 ⟩ = ⟨ pp , ra_field_ty t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V10 V14) (scons (ra_nth_ctor V14 ⟨ kc_nz , ∅ ⟩ V11) (scons (ra_clen V3 V7) (scons (ra_ntys V4 V8 V9) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V8 V7 V11 V12) (scons (ra_nth_pi V12 V6 V13) ∅))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_field_ty t1 t2 t3 t4) $ by opair_isset
