lemma y2_nth_ty_d1 (GG: hyps) (o q1 q2 q3 q4 w3 w4: set):
  $ GG ⇒ ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ ∈ cl_nth_ty_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_nth_ty lrel $ > $ GG ⇒ ra_nth_ty q1 q2 w3 w4 ∈ lrel $ > $ GG ⇒ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b $ by ax
l2: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b ⇒ ra_nth_ty q1 q2 w3 w4 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b ⇒ q3 = w3 ∧ q4 = w4 $ by y2_nth_ty_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b → q3 = w3 ∧ q4 = w4 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b → q3 = w3 ∧ q4 = w4) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b → q3 = w3 ∧ q4 = w4) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ∧ q4 = b → q3 = w3 ∧ q4 = w4) $ by all_intro [l6]
l8: $ GG ⇒ q3 = w3 ∧ q4 = w4 $ by y2_nth_ty_i1 [#1, #2, l7]

lemma y2_nth_ty_i2 (GG: hyps) {F F2 C C2 T i: set} (o q1 q2 q3 q4: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ ∈ cl_nth_ty_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_nth_ty lrel $ > $ GG ⇒ ∀ F ∀ F2 ∀ C ∀ C2 ∀ T ∀ i (q1 = ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons i ∅ ⟩ ∧ q3 = F ∧ q4 = C ∧ ra_nth_ty T i F C ∈ lrel ∧ ra_nth_ty T i F C ∈ y2_P_nth_ty lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s ⇒ w ∊ cl_nth_ty_s $ by ax
l2: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s ⇒ ∃ F ∃ F2 ∃ C ∃ C2 ∃ T ∃ i (w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset (ra_nth_ty q1 q2 q3 q4) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset (ra_nth_ty T i F C) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ scons (ra_nth_ty T i F C) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset (scons (ra_nth_ty T i F C) ∅) $ by y2_fs_set [l11]
l13: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset (ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ o = scons (ra_nth_ty T i F C) ∅ ∧ ra_nth_ty q1 q2 q3 q4 = ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ o = scons (ra_nth_ty T i F C) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ ⟨ kr_nth_ty , scons q1 (scons q2 (scons q3 (scons q4 ∅))) ⟩ = ⟨ kr_nth_ty , scons ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ (scons ⟨ kc_s , scons i ∅ ⟩ (scons F (scons C ∅))) ⟩ $ by and_elim_r [l14]
l17: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ kr_nth_ty ∈ ω $ by x1_kr_nth_ty
l18: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset kr_nth_ty $ by wcel_isset [l17]
l19: $ GG , w = ⟨ o , ra_nth_ty q1 q2 q3 q4 ⟩ , w ∊ cl_nth_ty_s , w = ⟨ scons (ra_nth_ty T i F C) ∅ , ra_nth_ty ⟨ kc_tcons , scons F2 (scons C2 (scons T ∅)) ⟩ ⟨ kc_s , scons i ∅ ⟩ F C ⟩ ⇒ isset q1 $ by isset_var
