lemma y2_ind_arity_e1 (GG: hyps) (q1 q2 q3 q4 w2 w3 w4 u_D u_b u_P u_T u_np u_n u_m v_D v_b v_P v_T v_np v_n v_m: set):
  $ GG ⇒ q1 = u_D $ > $ GG ⇒ q2 = u_np $ > $ GG ⇒ q3 = u_n $ > $ GG ⇒ q4 = u_m $ > $ GG ⇒ ra_ind_data u_D u_b u_P u_T ∈ lrel $ > $ GG ⇒ ra_clen u_P u_np ∈ lrel $ > $ GG ⇒ ra_ntys u_T u_n u_m ∈ lrel $ > $ GG ⇒ q1 = v_D $ > $ GG ⇒ w2 = v_np $ > $ GG ⇒ w3 = v_n $ > $ GG ⇒ w4 = v_m $ > $ GG ⇒ ra_ind_data v_D v_b v_P v_T ∈ lrel $ > $ GG ⇒ ra_clen v_P v_np ∈ lrel $ > $ GG ⇒ ra_ntys v_T v_n v_m ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ u_D = q1 $ by eq_sym [#1]
l2: $ GG ⇒ u_D = v_D $ by eq_trans [l1, #8]
l3: $ GG ⇒ v_D = u_D $ by eq_sym [l2]
l4: $ GG ⇒ v_b = v_b $ by eq_refl
l5: $ GG ⇒ v_P = v_P $ by eq_refl
l6: $ GG ⇒ v_T = v_T $ by eq_refl
l7: $ GG ⇒ ra_ind_data u_D v_b v_P v_T ∈ lrel $ by x1_eq_ind_data [#12, l3, l4, l5, l6]
l8: $ GG ⇒ u_b = v_b ∧ u_P = v_P ∧ u_T = v_T $ by lrel_ind_data_det [#5, l7]
l9: $ GG ⇒ u_b = v_b $ by and_elim_l [l8]
l10: $ GG ⇒ u_P = v_P ∧ u_T = v_T $ by and_elim_r [l8]
l11: $ GG ⇒ u_P = v_P $ by and_elim_l [l10]
l12: $ GG ⇒ u_T = v_T $ by and_elim_r [l10]
l13: $ GG ⇒ v_P = u_P $ by eq_sym [l11]
l14: $ GG ⇒ v_np = v_np $ by eq_refl
l15: $ GG ⇒ ra_clen u_P v_np ∈ lrel $ by x1_eq_clen [#13, l13, l14]
l16: $ GG ⇒ u_np = v_np $ by lrel_clen_det [#6, l15]
l17: $ GG ⇒ v_T = u_T $ by eq_sym [l12]
l18: $ GG ⇒ v_n = v_n $ by eq_refl
l19: $ GG ⇒ v_m = v_m $ by eq_refl
l20: $ GG ⇒ ra_ntys u_T v_n v_m ∈ lrel $ by x1_eq_ntys [#14, l17, l18, l19]
l21: $ GG ⇒ u_n = v_n ∧ u_m = v_m $ by lrel_ntys_det [#7, l20]
l22: $ GG ⇒ u_n = v_n $ by and_elim_l [l21]
l23: $ GG ⇒ u_m = v_m $ by and_elim_r [l21]
l24: $ GG ⇒ v_np = w2 $ by eq_sym [#9]
l25: $ GG ⇒ q2 = v_np $ by eq_trans [#2, l16]
l26: $ GG ⇒ q2 = w2 $ by eq_trans [l25, l24]
l27: $ GG ⇒ v_n = w3 $ by eq_sym [#10]
l28: $ GG ⇒ q3 = v_n $ by eq_trans [#3, l22]
l29: $ GG ⇒ q3 = w3 $ by eq_trans [l28, l27]
l30: $ GG ⇒ v_m = w4 $ by eq_sym [#11]
l31: $ GG ⇒ q4 = v_m $ by eq_trans [#4, l23]
l32: $ GG ⇒ q4 = w4 $ by eq_trans [l31, l30]
l33: $ GG ⇒ q3 = w3 ∧ q4 = w4 $ by and_intro [l29, l32]
l34: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by and_intro [l26, l33]

lemma y2_ind_arity_c1 (GG: hyps) (q1 q2 q3 q4 w2 w3 w4 u_D u_b u_P u_T u_np u_n u_m: set):
  $ GG ⇒ q1 = u_D ∧ q2 = u_np ∧ q3 = u_n ∧ q4 = u_m ∧ ra_ind_data u_D u_b u_P u_T ∈ lrel ∧ ra_clen u_P u_np ∈ lrel ∧ ra_ntys u_T u_n u_m ∈ lrel $ > $ GG ⇒ ra_ind_arity q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
