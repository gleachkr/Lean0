ofsort_bin_cases
----------------
l1: $ G ⇒ ⟨ ks_bin , t ⟩ ∈ sorted lsig lopen $ by ofsort_elim [#1]
l2: $ G ⇒ ks_bin ∈ ω $ by v1_ks_bin
l3: $ G ⇒ isset ks_bin $ by wcel_isset [l2]
l4: $ G , k = ks_bin ⇒ k = ks_bin $ by ax
l5: $ G , k = ks_bin ⇒ ks_bin = k $ by eq_sym [l4]
l6: $ G , k = ks_bin ⇒ t = t $ by eq_refl
l7: $ G , k = ks_bin ⇒ ⟨ ks_bin , t ⟩ = ⟨ k , t ⟩ $ by opair_eq [l5, l6]
l8: $ G , k = ks_bin ⇒ ⟨ ks_bin , t ⟩ ∈ sorted lsig lopen $ by weaken [l1]
l9: $ G , k = ks_bin ⇒ ⟨ k , t ⟩ ∈ sorted lsig lopen $ by wcel_eq_l [l7, l8]
l10: $ G , k = ks_bin ⇒ sig lsig lopen $ by lsig_sig
l11: $ G , k = ks_bin ⇒ (∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩)) ∨ (k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩)) $ by sorted_elim [l10, l9]
l12: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by ax
l13: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ by and_elim_l [l12]
l14: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l12]
l15: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) $ by and_elim_l [l14]
l16: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l14]
l17: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a $ by and_elim_l [l16]
l18: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l16]
l19: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen $ by and_elim_l [l18]
l20: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ t = ⟨ c , b ⟩ $ by and_elim_r [l18]
l21: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ k = ks_bin $ by ax
l22: $ G , k = ks_bin , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ v1_d_bin x t $ by v1_node_bin [l13, l21, l15, l17, l19, l20]
l23: $ G , k = ks_bin , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l24: $ G , k = ks_bin , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_bin x t $ by ex_elim [l23, l22]
l25: $ G , k = ks_bin , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l26: $ G , k = ks_bin , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_bin x t $ by ex_elim [l25, l24]
l27: $ G , k = ks_bin , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l28: $ G , k = ks_bin , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_bin x t $ by ex_elim [l27, l26]
l29: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) $ by ax
l30: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k ∊ lopen $ by and_elim_l [l29]
l31: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_bin $ by ax
l32: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ ks_bin ∈ ks_blk $ by v1_lt_bin_blk
l33: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [l31, l32]
l34: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ ks_atom ∈ ks_bin $ by v1_lt_atom_bin
l35: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ k = ks_atom → ⊥ $ by v1_ne_gt [l31, l34]
l36: $ G , k = ks_bin , k ∊ lopen ∧ ∃ j (j ∊ ω ∧ t = ⟨ j , ∅ ⟩) ⇒ v1_d_bin x t $ by v1_lopen_no [l33, l35, l30]
l37: $ G , k = ks_bin ⇒ v1_d_bin x t $ by or_elim [l11, l28, l36]
l38: $ G ⇒ (t = ⟨ kc_b0 , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_bd0 , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨ ∃ x (t = ⟨ kc_bd1 , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) $ by isset_elim [l3, l37]

--| The cases of sort `blk`.
def v1_d_blk {n: set} (t: set): fml = $ (t = ⟨ kc_nat_blk , ∅ ⟩) ∨ (t = ⟨ kc_eq_blk , ∅ ⟩) ∨ (t = ⟨ kc_iff_blk , ∅ ⟩) ∨ (t = ⟨ kc_nonempty_blk , ∅ ⟩) ∨ (t = ⟨ kc_le_blk , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $

lemma v1_node_blk (G: hyps) {n: set} (c k a b t: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ > $ G ⇒ k = ks_blk $ > $ G ⇒ b ∊ fseq (trees ω) $ >
  $ G ⇒ cdm b = cdm a $ > $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G ⇒ v1_d_blk n t $
----
l1: $ G ⇒ ks_nat ∈ ks_blk $ by v1_lt_nat_blk
l2: $ G ⇒ k = ks_nat → ⊥ $ by v1_ne_gt [#2, l1]
l3: $ G ⇒ ks_lvl ∈ ks_blk $ by v1_lt_lvl_blk
l4: $ G ⇒ k = ks_lvl → ⊥ $ by v1_ne_gt [#2, l3]
l5: $ G ⇒ ks_lvls ∈ ks_blk $ by v1_lt_lvls_blk
l6: $ G ⇒ k = ks_lvls → ⊥ $ by v1_ne_gt [#2, l5]
l7: $ G ⇒ ks_expr ∈ ks_blk $ by v1_lt_expr_blk
l8: $ G ⇒ k = ks_expr → ⊥ $ by v1_ne_gt [#2, l7]
l9: $ G ⇒ ks_atom ∈ ks_blk $ by v1_lt_atom_blk
l10: $ G ⇒ k = ks_atom → ⊥ $ by v1_ne_gt [#2, l9]
l11: $ G ⇒ ks_ctx ∈ ks_blk $ by v1_lt_ctx_blk
l12: $ G ⇒ k = ks_ctx → ⊥ $ by v1_ne_gt [#2, l11]
