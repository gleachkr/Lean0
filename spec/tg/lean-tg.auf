l30: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by wcel_elim [#1, l29]

lemma y1_o_motives (G: hyps) {D np j_v v_v F F2 Mj C T Mr M: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_motives $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons $ by ax
l2: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by y1_d_motives_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons → ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons $ by ax
l6: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∨ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil $ by ax
l8: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by y1_d_motives_nil [l7, l8]
l10: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons $ by ax
l12: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons → ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_cons ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil ∪ cl_motives_cons → ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_ihty_pi (G: hyps) {D np n_v mo fld y_v j_v A B IH: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10: set):
  $ G ⇒ ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ = ⟨ scons (ra_ihty V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V7 V9 V10) ∅ , ra_ihty V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t9 = ⟨ kc_pi , scons A (scons IH ∅) ⟩ ∧ ra_ihty D np n_v mo fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ihty V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V7 V9 V10) ∅ , ra_ihty V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ ⟩ = ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ihty V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V7 V9 V10) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9) $ by opair_isset
l5: $ G ⇒ isset (ra_ihty V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ihty V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V7 V9 V10) ∅ ∧ ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 = ra_ihty V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ihty V1 V2 V3 V4 V5 ⟨ kc_s , scons V6 ∅ ⟩ V7 V9 V10) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 = ra_ihty V1 V2 V3 V4 V5 V6 V7 ⟨ kc_pi , scons V8 (scons V9 ∅) ⟩ ⟨ kc_pi , scons V8 (scons V10 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t9 $ by isset_var
l11: $ G ⇒ scons t9 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t8 $ by isset_var
