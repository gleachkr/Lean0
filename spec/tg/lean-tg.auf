l54: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t (x = ⟨ scons (ra_ind_arity y w a b) (scons (ra_nidx y u g) (scons (ra_add b a c) (scons (ra_add f b i) (scons (ra_add i a j) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons u (scons z ∅)) ⟩ j w h) (scons (ra_pargs h i a l) (scons (ra_pargs l f b m) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ j w o) (scons (ra_lift c f e p) (scons (ra_rehead o m g p n) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ j w r) (scons (ra_pargs r ⟨ kc_nz , ∅ ⟩ f t) (scons (ra_add k ⟨ kc_s , scons u ∅ ⟩ a) (scons (ra_add i k d) (scons (ra_rehead o ⟨ kc_bvar , scons d ∅ ⟩ g p q) ∅))))))))))))))) , ra_iota_lhs y z u v f e m r t n ⟨ kc_app , scons q (scons t ∅) ⟩ ⟩) ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $ by ex_elim [l53, l52]
l55: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_iota_lhs_i ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $ by ex_elim [l2, l54]
l56: $ G ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $ by wcel_elim [#1, l55]

lemma y1_o_iota_lhs (G: hyps) {D v_v i_v c_v np n_v m_v mn nf ni a_v d1 io mo res e1 e2 e3 e4 Y T2 T0 c1 maj: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set):
  $ G ⇒ ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ ∈ pr_iota_lhs $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $ by y1_d_iota_lhs_i [#1, #2]

lemma y1_e_crst_nil (G: hyps) {D N: set} (pp t1 t2 t3 t4 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_crst V1 V2 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_crst V1 V2 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_crst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_crst V1 V2 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_crst t1 t2 t3 t4 = ra_crst V1 V2 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_crst t1 t2 t3 t4 = ra_crst V1 V2 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset V2 $ by isset_var
l22: $ G ⇒ scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset V1 $ by isset_var
l24: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_crst ∈ ω $ by x1_kr_crst
l26: $ G ⇒ isset kr_crst $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_crst = kr_crst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = V1 $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = V2 $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = ⟨ kc_nil , ∅ ⟩ ∧ scons t4 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l40]
l42: $ G ⇒ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ N (t1 = V1 ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l44]
l46: $ G ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l45]

lemma y1_d_crst_nil (G: hyps) {D N: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x ∊ cl_crst_nil ⇒ x ∊ cl_crst_nil $ by ax
l2: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x ∊ cl_crst_nil ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by y1_e_crst_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ z (x = ⟨ ∅ , ra_crst y z ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x ∊ cl_crst_nil ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l11]

lemma y1_e_crst_cons (G: hyps) {D N A A2 G_v G2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅) , ra_crst V1 V2 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅) , ra_crst V1 V2 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅)) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_crst t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_crst V1 V2 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅) ∧ ra_crst t1 t2 t3 t4 = ra_crst V1 V2 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅) $ by and_elim_l [l6]
l8: $ G ⇒ ra_crst t1 t2 t3 t4 = ra_crst V1 V2 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V1 $ by isset_var
l25: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_crst ∈ ω $ by x1_kr_crst
l27: $ G ⇒ isset kr_crst $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_crst = kr_crst ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons V1 (scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = V1 $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons V2 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 ∅) = scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = V2 $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ scons t4 ∅ = scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅)) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_rst V1 V2 V3 V4) (scons (ra_crst V1 V2 V5 V6) ∅)) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_rst V1 V2 V3 V4) $ by opair_isset
l46: $ G ⇒ ra_rst V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_crst V1 V2 V5 V6) ∅) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_crst V1 V2 V5 V6) $ by opair_isset
l49: $ G ⇒ ra_crst V1 V2 V5 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 V5 V6 ∈ lrel $ by and_intro [l46, l49]
l51: $ G ⇒ t4 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 V5 V6 ∈ lrel $ by and_intro [l42, l50]
l52: $ G ⇒ t3 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 V5 V6 ∈ lrel $ by and_intro [l39, l51]
l53: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 V5 V6 ∈ lrel $ by and_intro [l36, l52]
l54: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 V5 V6 ∈ lrel $ by and_intro [l33, l53]
l55: $ G ⇒ ∃ G2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons V4 (scons G2 ∅) ⟩ ∧ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 V5 G2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ G_v ∃ G2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V3 (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons V4 (scons G2 ∅) ⟩ ∧ ra_rst V1 V2 V3 V4 ∈ lrel ∧ ra_crst V1 V2 G_v G2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ A2 ∃ G_v ∃ G2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons V3 (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst V1 V2 V3 A2 ∈ lrel ∧ ra_crst V1 V2 G_v G2 ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst V1 V2 A A2 ∈ lrel ∧ ra_crst V1 V2 G_v G2 ∈ lrel) $ by ex_intro [l57]
l59: $ G ⇒ ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = V1 ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst V1 N A A2 ∈ lrel ∧ ra_crst V1 N G_v G2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_intro [l59]

lemma y1_d_crst_cons (G: hyps) {D N A A2 G_v G2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x ∊ cl_crst_cons ⇒ x ∊ cl_crst_cons $ by ax
l2: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x ∊ cl_crst_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by y1_e_crst_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ , x ∊ cl_crst_cons ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_crst (G: hyps) {D N A A2 G_v G2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ pr_crst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons $ by ax
l2: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by y1_d_crst_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons → ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons $ by ax
l6: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∨ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil $ by ax
l8: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) $ by y1_d_crst_nil [l7, l8]
l10: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons $ by ax
l12: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons → ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_cons ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_crst t1 t2 t3 t4 ⟩ ∈ cl_crst_nil ∪ cl_crst_cons → ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ N (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_nil , ∅ ⟩ ∧ t4 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ D ∃ N ∃ A ∃ A2 ∃ G_v ∃ G2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t4 = ⟨ kc_cons , scons A2 (scons G2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_crst D N G_v G2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_iota_eq_i (G: hyps) {D i_v c_v v_v np n_v m_v a0 ar nf X Dl res e3 e4 c1 maj Rh rhs0 rhs T: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20 V21: set):
  $ G ⇒ ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_iota_tel V1 V4 V2 V3 V11 V13 V10 V12) (scons (ra_iota_lhs V1 V4 V2 V3 V10 V13 V14 V16 V17 V15 V21) (scons (ra_rec_rhs V1 V4 V2 V3 V18) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_add V5 V6 V8) (scons (ra_add V8 V7 V9) (scons (ra_rehead ⟨ kc_ind_rec , scons V1 (scons V2 (scons V4 ∅)) ⟩ V18 V9 V14 V19) (scons (ra_rehead V16 V19 V10 V17 V20) ∅))))))) , ra_iota_eq V1 V2 V3 V4 V12 ⟨ kc_app , scons V15 (scons V17 ∅) ⟩ V20 V21 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_iota_tel V1 V4 V2 V3 V11 V13 V10 V12) (scons (ra_iota_lhs V1 V4 V2 V3 V10 V13 V14 V16 V17 V15 V21) (scons (ra_rec_rhs V1 V4 V2 V3 V18) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_add V5 V6 V8) (scons (ra_add V8 V7 V9) (scons (ra_rehead ⟨ kc_ind_rec , scons V1 (scons V2 (scons V4 ∅)) ⟩ V18 V9 V14 V19) (scons (ra_rehead V16 V19 V10 V17 V20) ∅))))))) , ra_iota_eq V1 V2 V3 V4 V12 ⟨ kc_app , scons V15 (scons V17 ∅) ⟩ V20 V21 ⟩ = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_iota_tel V1 V4 V2 V3 V11 V13 V10 V12) (scons (ra_iota_lhs V1 V4 V2 V3 V10 V13 V14 V16 V17 V15 V21) (scons (ra_rec_rhs V1 V4 V2 V3 V18) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_add V5 V6 V8) (scons (ra_add V8 V7 V9) (scons (ra_rehead ⟨ kc_ind_rec , scons V1 (scons V2 (scons V4 ∅)) ⟩ V18 V9 V14 V19) (scons (ra_rehead V16 V19 V10 V17 V20) ∅)))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8) $ by opair_isset
l5: $ G ⇒ isset (ra_iota_eq V1 V2 V3 V4 V12 ⟨ kc_app , scons V15 (scons V17 ∅) ⟩ V20 V21) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_iota_tel V1 V4 V2 V3 V11 V13 V10 V12) (scons (ra_iota_lhs V1 V4 V2 V3 V10 V13 V14 V16 V17 V15 V21) (scons (ra_rec_rhs V1 V4 V2 V3 V18) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_add V5 V6 V8) (scons (ra_add V8 V7 V9) (scons (ra_rehead ⟨ kc_ind_rec , scons V1 (scons V2 (scons V4 ∅)) ⟩ V18 V9 V14 V19) (scons (ra_rehead V16 V19 V10 V17 V20) ∅))))))) ∧ ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 = ra_iota_eq V1 V2 V3 V4 V12 ⟨ kc_app , scons V15 (scons V17 ∅) ⟩ V20 V21 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_iota_tel V1 V4 V2 V3 V11 V13 V10 V12) (scons (ra_iota_lhs V1 V4 V2 V3 V10 V13 V14 V16 V17 V15 V21) (scons (ra_rec_rhs V1 V4 V2 V3 V18) (scons (ra_ind_arity V1 V5 V6 V7) (scons (ra_add V5 V6 V8) (scons (ra_add V8 V7 V9) (scons (ra_rehead ⟨ kc_ind_rec , scons V1 (scons V2 (scons V4 ∅)) ⟩ V18 V9 V14 V19) (scons (ra_rehead V16 V19 V10 V17 V20) ∅))))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 = ra_iota_eq V1 V2 V3 V4 V12 ⟨ kc_app , scons V15 (scons V17 ∅) ⟩ V20 V21 $ by and_elim_r [l6]
