l46: $ G ⇒ kr_rtail = kr_rtail ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_pi , scons V7 (scons V8 ∅) ⟩ (scons ⟨ kc_pi , scons V7 (scons V9 ∅) ⟩ ∅))))))) $ by opair_inj_c [l8, l43, l44, l43, l45]
