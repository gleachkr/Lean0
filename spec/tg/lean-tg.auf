l109: $ G ⇒ ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys V4 n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ V4 M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 N ∈ lrel ∧ ra_nth_ty V4 i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail V1 np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis V3 R2 R ∈ lrel) $ by ex_intro [l108]
l110: $ G ⇒ ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail V1 np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis V3 R2 R ∈ lrel) $ by ex_intro [l109]
l111: $ G ⇒ ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail V1 np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $ by ex_intro [l110]
l112: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = V1 ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives V1 np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors V1 np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail V1 np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $ by ex_intro [l111]
l113: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $ by ex_intro [l112]

lemma y1_d_rec_ty_i (G: hyps) {D b_v P T v_v i_v np n_v m_v mn M N F F2 B R1 R2 R C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ ∈ cl_rec_ty_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ , x ∊ cl_rec_ty_i ⇒ x ∊ cl_rec_ty_i $ by ax
l2: $ G , x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ , x ∊ cl_rec_ty_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_motives y b w ⟨ kc_nz , ∅ ⟩ v i) (scons (ra_minors y b c ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v j) (scons (ra_nth_ty v a k n) (scons (ra_add f c g) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ k d) (scons (ra_rtail y b c f a ⟨ kc_nz , ∅ ⟩ d e) (scons (ra_pis j e h) (scons (ra_pis i h l) (scons (ra_pis u l m) ∅))))))))))) , ra_rec_ty y w a m ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_motives y b w ⟨ kc_nz , ∅ ⟩ v i) (scons (ra_minors y b c ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v j) (scons (ra_nth_ty v a k n) (scons (ra_add f c g) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ k d) (scons (ra_rtail y b c f a ⟨ kc_nz , ∅ ⟩ d e) (scons (ra_pis j e h) (scons (ra_pis i h l) (scons (ra_pis u l m) ∅))))))))))) , ra_rec_ty y w a m ⟩ ⇒ x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_motives y b w ⟨ kc_nz , ∅ ⟩ v i) (scons (ra_minors y b c ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v j) (scons (ra_nth_ty v a k n) (scons (ra_add f c g) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ k d) (scons (ra_rtail y b c f a ⟨ kc_nz , ∅ ⟩ d e) (scons (ra_pis j e h) (scons (ra_pis i h l) (scons (ra_pis u l m) ∅))))))))))) , ra_rec_ty y w a m ⟩ ⇒ ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_motives y b w ⟨ kc_nz , ∅ ⟩ v i) (scons (ra_minors y b c ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v j) (scons (ra_nth_ty v a k n) (scons (ra_add f c g) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ k d) (scons (ra_rtail y b c f a ⟨ kc_nz , ∅ ⟩ d e) (scons (ra_pis j e h) (scons (ra_pis i h l) (scons (ra_pis u l m) ∅))))))))))) , ra_rec_ty y w a m ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u b) (scons (ra_ntys v c f) (scons (ra_motives y b w ⟨ kc_nz , ∅ ⟩ v i) (scons (ra_minors y b c ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ v j) (scons (ra_nth_ty v a k n) (scons (ra_add f c g) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ k d) (scons (ra_rtail y b c f a ⟨ kc_nz , ∅ ⟩ d e) (scons (ra_pis j e h) (scons (ra_pis i h l) (scons (ra_pis u l m) ∅))))))))))) , ra_rec_ty y w a m ⟩ $ by ax
