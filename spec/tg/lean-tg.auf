lemma y2_capp_e2 (GG: hyps) (q1 q2 q3 w3 u_A u_P u_G u_G2 v_A v_P v_G v_G2: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_P ∅) ⟩ $ > $ GG ⇒ q2 = u_G $ > $ GG ⇒ q3 = ⟨ kc_cons , scons u_A (scons u_G2 ∅) ⟩ $ > $ GG ⇒ ra_capp u_P u_G u_G2 ∈ lrel $ > $ GG ⇒ ra_capp u_P u_G u_G2 ∈ y2_P_capp lrel $ > $ GG ⇒ q1 = ⟨ kc_cons , scons v_A (scons v_P ∅) ⟩ $ > $ GG ⇒ q2 = v_G $ > $ GG ⇒ w3 = ⟨ kc_cons , scons v_A (scons v_G2 ∅) ⟩ $ > $ GG ⇒ ra_capp v_P v_G v_G2 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_P ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_P ∅) ⟩ = ⟨ kc_cons , scons v_A (scons v_P ∅) ⟩ $ by eq_trans [l1, #6]
l3: $ GG ⇒ kc_cons ∈ ω $ by v1_kc_cons
l4: $ GG ⇒ isset kc_cons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_A $ by isset_var
l6: $ GG ⇒ isset u_P $ by isset_var
l7: $ GG ⇒ isset v_A $ by isset_var
l8: $ GG ⇒ isset v_P $ by isset_var
l9: $ GG ⇒ u_A = v_A ∧ u_P = v_P $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_A = v_A $ by and_elim_l [l9]
l11: $ GG ⇒ u_P = v_P $ by and_elim_r [l9]
l12: $ GG ⇒ u_G = q2 $ by eq_sym [#2]
l13: $ GG ⇒ u_G = v_G $ by eq_trans [l12, #7]
l14: $ GG ⇒ v_P = u_P $ by eq_sym [l11]
l15: $ GG ⇒ v_G = u_G $ by eq_sym [l13]
l16: $ GG ⇒ v_G2 = v_G2 $ by eq_refl
l17: $ GG ⇒ ra_capp u_P u_G v_G2 ∈ lrel $ by x1_eq_capp [#9, l14, l15, l16]
l18: $ GG ⇒ isset u_P $ by isset_var
l19: $ GG ⇒ isset u_G $ by isset_var
l20: $ GG ⇒ isset u_G2 $ by isset_var
l21: $ GG ⇒ isset v_G2 $ by isset_var
l22: $ GG ⇒ u_G2 = v_G2 $ by y2_capp_ihc [l18, l19, l20, l21, #5, l17]
l23: $ GG ⇒ ∅ = ∅ $ by eq_refl
l24: $ GG ⇒ scons u_G2 ∅ = scons v_G2 ∅ $ by scons_eq [l22, l23]
l25: $ GG ⇒ scons u_A (scons u_G2 ∅) = scons v_A (scons v_G2 ∅) $ by scons_eq [l10, l24]
l26: $ GG ⇒ kc_cons = kc_cons $ by eq_refl
l27: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G2 ∅) ⟩ = ⟨ kc_cons , scons v_A (scons v_G2 ∅) ⟩ $ by opair_eq [l26, l25]
l28: $ GG ⇒ ⟨ kc_cons , scons v_A (scons v_G2 ∅) ⟩ = w3 $ by eq_sym [#8]
l29: $ GG ⇒ q3 = ⟨ kc_cons , scons v_A (scons v_G2 ∅) ⟩ $ by eq_trans [#3, l27]
l30: $ GG ⇒ q3 = w3 $ by eq_trans [l29, l28]

lemma y2_capp_c2 (GG: hyps) (q1 q2 q3 w3 u_A u_P u_G u_G2: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_P ∅) ⟩ ∧ q2 = u_G ∧ q3 = ⟨ kc_cons , scons u_A (scons u_G2 ∅) ⟩ ∧ ra_capp u_P u_G u_G2 ∈ lrel ∧ ra_capp u_P u_G u_G2 ∈ y2_P_capp lrel $ > $ GG ⇒ ra_capp q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
