l22: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) $ by ax
l24: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f (x = ⟨ scons (ra_add v u w) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ w z c) (scons (ra_pargs c ⟨ kc_nz , ∅ ⟩ v f) ∅)) , ra_mty y z u v a ⟨ kc_srt , scons b ∅ ⟩ ⟨ kc_pi , scons f (scons ⟨ kc_srt , scons a ∅ ⟩ ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l23, l22]
l25: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_mty_srt ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by ex_elim [l2, l24]
l26: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by wcel_elim [#1, l25]

lemma y1_o_mty (G: hyps) {D np j_v d_v v_v A B M k_v l_v X I: set} (pp t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ pr_mty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt $ by ax
l2: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by y1_d_mty_srt [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt → ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt $ by ax
l6: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∨ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi $ by ax
l8: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) $ by y1_d_mty_pi [l7, l8]
l10: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt $ by ax
l12: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt → ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_srt ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ ∈ cl_mty_pi ∪ cl_mty_srt → ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_motives_nil (G: hyps) {D np j_v v_v: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_motives V1 V2 V4 V3 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_motives V1 V2 V4 V3 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_motives t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_motives V1 V2 V4 V3 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_motives t1 t2 t3 t4 t5 t6 = ra_motives V1 V2 V4 V3 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_motives t1 t2 t3 t4 t5 t6 = ra_motives V1 V2 V4 V3 ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset ⟨ kc_tnil , ∅ ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V3 $ by isset_var
l27: $ G ⇒ scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V4 $ by isset_var
l29: $ G ⇒ scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_motives ∈ ω $ by x1_kr_motives
l35: $ G ⇒ isset kr_motives $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_motives = kr_motives ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V4 (scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V4 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V4 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V3 ∧ scons t5 (scons t6 ∅) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V3 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons ⟨ kc_tnil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ scons t6 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l52]
l55: $ G ⇒ t6 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l54, l10, l22, l9, l9]
l56: $ G ⇒ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l55]
l57: $ G ⇒ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l53, l56]
l58: $ G ⇒ t4 = V3 ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l50, l57]
l59: $ G ⇒ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l47, l58]
l60: $ G ⇒ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l44, l59]
l61: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V4 ∧ t4 = V3 ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l41, l60]
l62: $ G ⇒ ∃ v_v (t1 = V1 ∧ t2 = V2 ∧ t3 = v_v ∧ t4 = V3 ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l61]
l63: $ G ⇒ ∃ j_v ∃ v_v (t1 = V1 ∧ t2 = V2 ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l62]
l64: $ G ⇒ ∃ np ∃ j_v ∃ v_v (t1 = V1 ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l63]
l65: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l64]

lemma y1_d_motives_nil (G: hyps) {D np j_v v_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_motives_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_motives_nil ⇒ x ∊ cl_motives_nil $ by ax
l2: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_motives_nil ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by y1_e_motives_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_motives y z v u ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_motives_nil ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l15]

lemma y1_e_motives_cons (G: hyps) {D np j_v v_v F F2 Mj C T Mr M: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11: set):
  $ G ⇒ ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅))) , ra_motives V1 V2 V4 V3 ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ V11 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅))) , ra_motives V1 V2 V4 V3 ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ V11 ⟩ = ⟨ pp , ra_motives t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅)))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_motives t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_motives V1 V2 V4 V3 ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ V11) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅))) ∧ ra_motives t1 t2 t3 t4 t5 t6 = ra_motives V1 V2 V4 V3 ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ V11 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_lift V3 ⟨ kc_nz , ∅ ⟩ V5 V6) (scons (ra_mty V1 V2 V3 ⟨ kc_nz , ∅ ⟩ V4 V6 V7) (scons (ra_motives V1 V2 V4 ⟨ kc_s , scons V3 ∅ ⟩ V9 V10) (scons (ra_capp V10 ⟨ kc_cons , scons V7 (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ V11) ∅))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_motives t1 t2 t3 t4 t5 t6 = ra_motives V1 V2 V4 V3 ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ V11 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V11 $ by isset_var
