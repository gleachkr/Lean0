lemma y1_d_nfields_i (G: hyps) {D b_v P T i_v c_v nf F K C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ ∈ cl_nfields_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x ∊ cl_nfields_i ⇒ x ∊ cl_nfields_i $ by ax
l2: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x ∊ cl_nfields_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nfields t1 t2 t3 t4 ⟩ , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_nth_ty v w c g) (scons (ra_nth_ctor g a f) (scons (ra_npis f b) ∅))) , ra_nfields y w a b ⟩ ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ i_v ∃ c_v ∃ nf ∃ F ∃ K ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = nf ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_npis K nf ∈ lrel) $ by y1_e_nfields_i [l6, l7]
