l4: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ kr_sinst ∈ ω $ by x1_kr_sinst
l5: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons z ∅ ⟩ u) (scons (ra_inst v w ⟨ kc_ind_ty , scons y (scons z ∅) ⟩ a) (scons (ra_sinst y ⟨ kc_s , scons z ∅ ⟩ u v a b) ∅)) , ra_sinst y z u v w b ⟩ ⇒ x ∊ y1_lab kr_sinst (suc kr_sinst) $ by y1_lab_self [l3, l4]
