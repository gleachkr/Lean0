l17: $ G ⇒ cl_rst_proj ⊆ y1_lab kr_rst (suc kr_rst) $ by subset_intro [l16]

lemma y1_k_rst_refl (G: hyps): $ G ⇒ cl_rst_refl ⊆ y1_lab kr_rst (suc kr_rst) $
----
l1: $ G , x ∊ cl_rst_refl ⇒ x ∊ cl_rst_refl $ by ax
l2: $ G , x ∊ cl_rst_refl ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ x = ⟨ ∅ , ra_rst y z u u ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ kr_rst ∈ ω $ by x1_kr_rst
l5: $ G , x = ⟨ ∅ , ra_rst y z u u ⟩ ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ ∅ , ra_rst y z u u ⟩) ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_rst_refl ⇒ x ∊ y1_lab kr_rst (suc kr_rst) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_rst_refl ⊆ y1_lab kr_rst (suc kr_rst) $ by subset_intro [l10]

lemma y1_p_rst (G: hyps): $ G ⇒ pr_rst ⊆ y1_lab kr_rst (suc kr_rst) $
----
l1: $ G ⇒ cl_rst_refl ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_refl
l2: $ G ⇒ cl_rst_proj ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_proj
l3: $ G ⇒ cl_rst_proj ∪ cl_rst_refl ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_rst_pi ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_pi
l5: $ G ⇒ cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl) ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_rst_lam ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_lam
l7: $ G ⇒ cl_rst_lam ∪ (cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl)) ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_rst_app ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_app
l9: $ G ⇒ cl_rst_app ∪ (cl_rst_lam ∪ (cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl))) ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_rst_ctor ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_ctor
l11: $ G ⇒ cl_rst_ctor ∪ (cl_rst_app ∪ (cl_rst_lam ∪ (cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl)))) ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l10, l9]
l12: $ G ⇒ cl_rst_ty ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_ty
l13: $ G ⇒ cl_rst_ty ∪ (cl_rst_ctor ∪ (cl_rst_app ∪ (cl_rst_lam ∪ (cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl))))) ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l12, l11]
l14: $ G ⇒ cl_rst_nil ⊆ y1_lab kr_rst (suc kr_rst) $ by y1_k_rst_nil
l15: $ G ⇒ pr_rst ⊆ y1_lab kr_rst (suc kr_rst) $ by cun_least [l14, l13]

lemma y1_k_nst_hit_z (G: hyps): $ G ⇒ cl_nst_hit_z ⊆ y1_lab kr_nst_hit (suc kr_nst_hit) $
----
l1: $ G , x ∊ cl_nst_hit_z ⇒ x ∊ cl_nst_hit_z $ by ax
l2: $ G , x ∊ cl_nst_hit_z ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ kr_nst_hit ∈ ω $ by x1_kr_nst_hit
l5: $ G , x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩ ⇒ x ∊ y1_lab kr_nst_hit (suc kr_nst_hit) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ h (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩) ⇒ ∃ h (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩) $ by ax
l7: $ G , ∃ h (x = ⟨ scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ y k) (scons (ra_spine ⟨ kc_ind_ty , scons b (scons c ∅) ⟩ v j) (scons (ra_add k d j) (scons (ra_lift g ⟨ kc_nz , ∅ ⟩ y z) (scons (ra_spine z v d) (scons (ra_add i f e) (scons (ra_add g e h) (scons (ra_pargs ⟨ kc_bvar , scons h ∅ ⟩ g i u) (scons (ra_rehead z u d v w) ∅)))))))) , ra_nst_hit ⟨ kc_cons , scons y (scons a ∅) ⟩ f g i v w ⟩) ⇒ x ∊ y1_lab kr_nst_hit (suc kr_nst_hit) $ by ex_elim [l6, l5]
