l12: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) $ by ax
l13: $ G , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ x ∊ y1_lab kr_minor_idx (suc kr_minor_idx) $ by ex_elim [l12, l11]
l14: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) $ by ax
l15: $ G , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ x ∊ y1_lab kr_minor_idx (suc kr_minor_idx) $ by ex_elim [l14, l13]
l16: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) $ by ax
l17: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ x ∊ y1_lab kr_minor_idx (suc kr_minor_idx) $ by ex_elim [l16, l15]
l18: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) $ by ax
l19: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_clen_c z b) (scons (ra_minor_idx u v w a) (scons (ra_add b a c) ∅)) , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ w c ⟩) ⇒ x ∊ y1_lab kr_minor_idx (suc kr_minor_idx) $ by ex_elim [l18, l17]
l20: $ G , x ∊ cl_minor_idx_s ⇒ x ∊ y1_lab kr_minor_idx (suc kr_minor_idx) $ by ex_elim [l2, l19]
l21: $ G ⇒ cl_minor_idx_s ⊆ y1_lab kr_minor_idx (suc kr_minor_idx) $ by subset_intro [l20]

lemma y1_p_minor_idx (G: hyps): $ G ⇒ pr_minor_idx ⊆ y1_lab kr_minor_idx (suc kr_minor_idx) $
----
