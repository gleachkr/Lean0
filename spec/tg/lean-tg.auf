l24: $ G ⇒ isset ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V3 $ by isset_var
l27: $ G ⇒ scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V4 $ by isset_var
l29: $ G ⇒ scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_motives ∈ ω $ by x1_kr_motives
l35: $ G ⇒ isset kr_motives $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_motives = kr_motives ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V4 (scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V4 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V4 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V3 ∧ scons t5 (scons t6 ∅) = scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V3 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ (scons V11 ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ ∧ scons t6 ∅ = scons V11 ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = ⟨ kc_tcons , scons V5 (scons V8 (scons V9 ∅)) ⟩ $ by and_elim_l [l52]
