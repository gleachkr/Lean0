l19: $ G ⇒ cl_spz_pi ⊆ y1_lab kr_spz (suc kr_spz) $ by subset_intro [l18]

lemma y1_k_spz_proj (G: hyps): $ G ⇒ cl_spz_proj ⊆ y1_lab kr_spz (suc kr_spz) $
----
l1: $ G , x ∊ cl_spz_proj ⇒ x ∊ cl_spz_proj $ by ax
l2: $ G , x ∊ cl_spz_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ kr_spz ∈ ω $ by x1_kr_spz
l5: $ G , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l7: $ G , ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l6, l5]
l8: $ G , ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l9: $ G , ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l8, l7]
l10: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l11: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l10, l9]
l12: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l13: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l12, l11]
l14: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l15: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l14, l13]
l16: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l17: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l16, l15]
l18: $ G , x ∊ cl_spz_proj ⇒ x ∊ y1_lab kr_spz (suc kr_spz) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_spz_proj ⊆ y1_lab kr_spz (suc kr_spz) $ by subset_intro [l18]

lemma y1_p_spz (G: hyps): $ G ⇒ pr_spz ⊆ y1_lab kr_spz (suc kr_spz) $
----
l1: $ G ⇒ cl_spz_proj ⊆ y1_lab kr_spz (suc kr_spz) $ by y1_k_spz_proj
l2: $ G ⇒ cl_spz_pi ⊆ y1_lab kr_spz (suc kr_spz) $ by y1_k_spz_pi
l3: $ G ⇒ cl_spz_pi ∪ cl_spz_proj ⊆ y1_lab kr_spz (suc kr_spz) $ by cun_least [l2, l1]
l4: $ G ⇒ cl_spz_lam ⊆ y1_lab kr_spz (suc kr_spz) $ by y1_k_spz_lam
l5: $ G ⇒ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) ⊆ y1_lab kr_spz (suc kr_spz) $ by cun_least [l4, l3]
l6: $ G ⇒ cl_spz_app ⊆ y1_lab kr_spz (suc kr_spz) $ by y1_k_spz_app
l7: $ G ⇒ cl_spz_app ∪ (cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj)) ⊆ y1_lab kr_spz (suc kr_spz) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_spz_hit ⊆ y1_lab kr_spz (suc kr_spz) $ by y1_k_spz_hit
l9: $ G ⇒ cl_spz_hit ∪ (cl_spz_app ∪ (cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj))) ⊆ y1_lab kr_spz (suc kr_spz) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_spz_refl ⊆ y1_lab kr_spz (suc kr_spz) $ by y1_k_spz_refl
l11: $ G ⇒ pr_spz ⊆ y1_lab kr_spz (suc kr_spz) $ by cun_least [l10, l9]

lemma y1_k_afree_bvar (G: hyps): $ G ⇒ cl_afree_bvar ⊆ y1_lab kr_afree (suc kr_afree) $
----
l1: $ G , x ∊ cl_afree_bvar ⇒ x ∊ cl_afree_bvar $ by ax
l2: $ G , x ∊ cl_afree_bvar ⇒ ∃ y (x = ⟨ ∅ , ra_afree ⟨ kc_bvar , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
