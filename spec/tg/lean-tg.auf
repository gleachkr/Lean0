lemma y1_p_motives (G: hyps): $ G ⇒ pr_motives ⊆ y1_lab kr_motives (suc kr_motives) $
----
l1: $ G ⇒ cl_motives_cons ⊆ y1_lab kr_motives (suc kr_motives) $ by y1_k_motives_cons
l2: $ G ⇒ cl_motives_nil ⊆ y1_lab kr_motives (suc kr_motives) $ by y1_k_motives_nil
l3: $ G ⇒ pr_motives ⊆ y1_lab kr_motives (suc kr_motives) $ by cun_least [l2, l1]

lemma y1_k_ihty_pi (G: hyps): $ G ⇒ cl_ihty_pi ⊆ y1_lab kr_ihty (suc kr_ihty) $
----
l1: $ G , x ∊ cl_ihty_pi ⇒ x ∊ cl_ihty_pi $ by ax
l2: $ G , x ∊ cl_ihty_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g (x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ⇒ kr_ihty ∈ ω $ by x1_kr_ihty
l5: $ G , x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩ ⇒ x ∊ y1_lab kr_ihty (suc kr_ihty) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ g (x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩) ⇒ ∃ g (x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩) $ by ax
l7: $ G , ∃ g (x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_ihty (suc kr_ihty) $ by ex_elim [l6, l5]
l8: $ G , ∃ f ∃ g (x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩) ⇒ ∃ f ∃ g (x = ⟨ scons (ra_ihty y z u v w ⟨ kc_s , scons a ∅ ⟩ b f g) ∅ , ra_ihty y z u v w a b ⟨ kc_pi , scons c (scons f ∅) ⟩ ⟨ kc_pi , scons c (scons g ∅) ⟩ ⟩) $ by ax
