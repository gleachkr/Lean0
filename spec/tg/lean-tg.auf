lemma x1_trees_set (G: hyps): $ G ⇒ isset (trees ω) $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G , x = ω ⇒ isset (trees x) $ by trees_set
l3: $ G , x = ω ⇒ x = ω $ by ax
l4: $ G , x = ω ⇒ trees x = trees ω $ by trees_eq [l3]
l5: $ G , x = ω ⇒ isset (trees ω) $ by isset_eq [l4, l2]
l6: $ G ⇒ isset (trees ω) $ by isset_elim [l1, l5]

lemma x1_latoms_set (G: hyps): $ G ⇒ isset latoms $
----
l1: $ G ⇒ isset ω $ by omega_set
l2: $ G ⇒ isset (trees ω) $ by x1_trees_set
l3: $ G ⇒ isset (fseq (trees ω)) $ by fseq_set [l2]
l4: $ G ⇒ isset latoms $ by cxp_set [l1, l3]

lprog_hprog
-----------
l1: $ G ⇒ isset latoms $ by x1_latoms_set
l2: $ G ⇒ hprog lprog latoms $ by hprog_cin [l1]

