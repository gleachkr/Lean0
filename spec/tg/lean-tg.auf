l51: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V3 ∧ t5 = V3 $ by and_intro [l39, l50]
l52: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = V3 ∧ t5 = V3 $ by and_intro [l36, l51]
l53: $ G ⇒ ∃ Y (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by ex_intro [l52]
l54: $ G ⇒ ∃ e_v ∃ Y (t1 = V1 ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by ex_intro [l53]
l55: $ G ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by ex_intro [l54]

lemma y1_d_projs_z (G: hyps) {b_v e_v Y: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $
----
l1: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_projs_z ⇒ x ∊ cl_projs_z $ by ax
l2: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_projs_z ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩ ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by y1_e_projs_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_projs y z ⟨ kc_nz , ∅ ⟩ u u ⟩) ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_projs_z ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by wcel_elim [#1, l13]

lemma y1_e_projs_s (G: hyps) {b_v e_v Y M k_v: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_projs V1 V2 V5 V3 V4) ∅ , ra_projs V1 V2 ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_projs V1 V2 V5 V3 V4) ∅ , ra_projs V1 V2 ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ⟩ = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_projs V1 V2 V5 V3 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_projs t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_projs V1 V2 ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_projs V1 V2 V5 V3 V4) ∅ ∧ ra_projs t1 t2 t3 t4 t5 = ra_projs V1 V2 ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_projs V1 V2 V5 V3 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_projs t1 t2 t3 t4 t5 = ra_projs V1 V2 ⟨ kc_s , scons V5 ∅ ⟩ V3 ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V3 $ by isset_var
l23: $ G ⇒ scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_s , scons V5 ∅ ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V2 $ by isset_var
l27: $ G ⇒ scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V1 $ by isset_var
l29: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_projs ∈ ω $ by x1_kr_projs
l31: $ G ⇒ isset kr_projs $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_projs = kr_projs ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons V1 (scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = V1 $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V2 (scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = V2 $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons ⟨ kc_s , scons V5 ∅ ⟩ (scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ scons t4 (scons t5 ∅) = scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = ⟨ kc_s , scons V5 ∅ ⟩ $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V3 (scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V3 ∧ scons t5 ∅ = scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = V3 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_projs V1 V2 V5 V3 V4) ∅) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_projs V1 V2 V5 V3 V4) ∅) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_projs V1 V2 V5 V3 V4) $ by opair_isset
l53: $ G ⇒ ra_projs V1 V2 V5 V3 V4 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 V5 V3 V4 ∈ lrel $ by and_intro [l49, l53]
l55: $ G ⇒ t4 = V3 ∧ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 V5 V3 V4 ∈ lrel $ by and_intro [l46, l54]
l56: $ G ⇒ t3 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ t4 = V3 ∧ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 V5 V3 V4 ∈ lrel $ by and_intro [l43, l55]
l57: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ t4 = V3 ∧ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 V5 V3 V4 ∈ lrel $ by and_intro [l40, l56]
l58: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons V5 ∅ ⟩ ∧ t4 = V3 ∧ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons V5 (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 V5 V3 V4 ∈ lrel $ by and_intro [l37, l57]
l59: $ G ⇒ ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = V3 ∧ t5 = ⟨ kc_app , scons V4 (scons ⟨ kc_proj , scons V1 (scons k_v (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 k_v V3 V4 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ M ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = V3 ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons V1 (scons k_v (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 k_v V3 M ∈ lrel) $ by ex_intro [l59]
l61: $ G ⇒ ∃ Y ∃ M ∃ k_v (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons V1 (scons k_v (scons V2 ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 V2 k_v Y M ∈ lrel) $ by ex_intro [l60]
l62: $ G ⇒ ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = V1 ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons V1 (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs V1 e_v k_v Y M ∈ lrel) $ by ex_intro [l61]
l63: $ G ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by ex_intro [l62]

lemma y1_d_projs_s (G: hyps) {b_v e_v Y M k_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_projs_s ⇒ x ∊ cl_projs_s $ by ax
l2: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_projs_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩ ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by y1_e_projs_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_projs y z w u v) ∅ , ra_projs y z ⟨ kc_s , scons w ∅ ⟩ u ⟨ kc_app , scons v (scons ⟨ kc_proj , scons y (scons w (scons z ∅)) ⟩ ∅) ⟩ ⟩) ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_projs_s ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_o_projs (G: hyps) {b_v e_v Y M k_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ pr_projs $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) ∨ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s $ by ax
l2: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by y1_d_projs_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s → ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s $ by ax
l6: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∨ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z $ by ax
l8: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $ by y1_d_projs_z [l7, l8]
l10: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) ∨ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s $ by ax
l12: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s → ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_s ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) ∨ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) ∨ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ ∈ cl_projs_z ∪ cl_projs_s → ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) ∨ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) ∨ ∃ b_v ∃ e_v ∃ Y ∃ M ∃ k_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = Y ∧ t5 = ⟨ kc_app , scons M (scons ⟨ kc_proj , scons b_v (scons k_v (scons e_v ∅)) ⟩ ∅) ⟩ ∧ ra_projs b_v e_v k_v Y M ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_clift_nil (G: hyps) {k_v: set} (pp t1 t2 t3 V1: set):
  $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ = ⟨ ∅ , ra_clift V1 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_clift V1 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ = ⟨ pp , ra_clift t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_clift t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_clift V1 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_clift t1 t2 t3 = ra_clift V1 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_clift t1 t2 t3 = ra_clift V1 ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_nil , ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l16, l17]
l19: $ G ⇒ isset V1 $ by isset_var
l20: $ G ⇒ scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l19, l18]
l21: $ G ⇒ kr_clift ∈ ω $ by x1_kr_clift
l22: $ G ⇒ isset kr_clift $ by wcel_isset [l21]
l23: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l24: $ G ⇒ isset (scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅))) $ by wcel_isset [l20]
l25: $ G ⇒ kr_clift = kr_clift ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by opair_inj_c [l8, l22, l23, l22, l24]
l26: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅)) $ by and_elim_r [l25]
l27: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by y1_scons_inj [l26, l14, l19, l13, l18]
l28: $ G ⇒ t1 = V1 $ by and_elim_l [l27]
l29: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_nil , ∅ ⟩ (scons ⟨ kc_nil , ∅ ⟩ ∅) $ by and_elim_r [l27]
l30: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by y1_scons_inj [l29, l12, l16, l11, l17]
l31: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l30]
l32: $ G ⇒ scons t3 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by and_elim_r [l30]
l33: $ G ⇒ t3 = ⟨ kc_nil , ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l32, l10, l16, l9, l9]
l34: $ G ⇒ t3 = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [l33]
l35: $ G ⇒ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l31, l34]
l36: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩ $ by and_intro [l28, l35]
l37: $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $ by ex_intro [l36]

lemma y1_d_clift_nil (G: hyps) {k_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x ∊ cl_clift_nil ⇒ x ∊ cl_clift_nil $ by ax
l2: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x ∊ cl_clift_nil ⇒ ∃ y (x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_clift t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ ∅ , ra_clift y ⟨ kc_nil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $ by y1_e_clift_nil [l6, l7]
l9: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x ∊ cl_clift_nil ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $ by wcel_elim [#1, l9]

lemma y1_e_clift_cons (G: hyps) {k_v d_v A A2 X Y: set} (pp t1 t2 t3 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ = ⟨ scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅)) , ra_clift V1 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅)) , ra_clift V1 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ⟩ = ⟨ pp , ra_clift t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_clift t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_clift V1 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅)) ∧ ra_clift t1 t2 t3 = ra_clift V1 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_clift t1 t2 t3 = ra_clift V1 ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_clift ∈ ω $ by x1_kr_clift
l23: $ G ⇒ isset kr_clift $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_clift = kr_clift ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ (scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ scons t3 ∅ = scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅))) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_clift V1 V5 V6) (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅))) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_clift V1 V5 V6) $ by opair_isset
l39: $ G ⇒ ra_clift V1 V5 V6 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_clen V5 V2) (scons (ra_lift V1 V2 V3 V4) ∅)) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_clen V5 V2) $ by opair_isset
l42: $ G ⇒ ra_clen V5 V2 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ crn (scons (ra_lift V1 V2 V3 V4) ∅) ⊆ lrel $ by crn_scons_tail [l40]
l44: $ G ⇒ isset (ra_lift V1 V2 V3 V4) $ by opair_isset
l45: $ G ⇒ ra_lift V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ ra_clen V5 V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel $ by and_intro [l42, l45]
l47: $ G ⇒ ra_clift V1 V5 V6 ∈ lrel ∧ ra_clen V5 V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel $ by and_intro [l39, l46]
l48: $ G ⇒ t3 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_clift V1 V5 V6 ∈ lrel ∧ ra_clen V5 V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t2 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_clift V1 V5 V6 ∈ lrel ∧ ra_clen V5 V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons V4 (scons V6 ∅) ⟩ ∧ ra_clift V1 V5 V6 ∈ lrel ∧ ra_clen V5 V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel $ by and_intro [l29, l49]
l51: $ G ⇒ ∃ Y (t1 = V1 ∧ t2 = ⟨ kc_cons , scons V3 (scons V5 ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons V4 (scons Y ∅) ⟩ ∧ ra_clift V1 V5 Y ∈ lrel ∧ ra_clen V5 V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ X ∃ Y (t1 = V1 ∧ t2 = ⟨ kc_cons , scons V3 (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons V4 (scons Y ∅) ⟩ ∧ ra_clift V1 X Y ∈ lrel ∧ ra_clen X V2 ∈ lrel ∧ ra_lift V1 V2 V3 V4 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ A2 ∃ X ∃ Y (t1 = V1 ∧ t2 = ⟨ kc_cons , scons V3 (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift V1 X Y ∈ lrel ∧ ra_clen X V2 ∈ lrel ∧ ra_lift V1 V2 V3 A2 ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ A ∃ A2 ∃ X ∃ Y (t1 = V1 ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift V1 X Y ∈ lrel ∧ ra_clen X V2 ∈ lrel ∧ ra_lift V1 V2 A A2 ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = V1 ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift V1 X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift V1 d_v A A2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_intro [l55]

lemma y1_d_clift_cons (G: hyps) {k_v d_v A A2 X Y: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x ∊ cl_clift_cons ⇒ x ∊ cl_clift_cons $ by ax
l2: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x ∊ cl_clift_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_clift t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩ ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by y1_e_clift_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_clift y w a) (scons (ra_clen w z) (scons (ra_lift y z u v) ∅)) , ra_clift y ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_clift t1 t2 t3 ⟩ , x ∊ cl_clift_cons ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_clift (G: hyps) {k_v d_v A A2 X Y: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ pr_clift $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons $ by ax
l2: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by y1_d_clift_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons → ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons $ by ax
l6: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∨ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil $ by ax
l8: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) $ by y1_d_clift_nil [l7, l8]
l10: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons $ by ax
l12: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons → ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_cons ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_clift t1 t2 t3 ⟩ ∈ cl_clift_nil ∪ cl_clift_cons → ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨ ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_psplit_z (G: hyps) {K A: set} (pp t1 t2 t3 t4 t5 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ V1 V2 V2 V1 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $
----
l1: $ G ⇒ ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ V1 V2 V2 V1 ⟩ = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_psplit t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_psplit ⟨ kc_nz , ∅ ⟩ V1 V2 V2 V1) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_psplit t1 t2 t3 t4 t5 = ra_psplit ⟨ kc_nz , ∅ ⟩ V1 V2 V2 V1 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_psplit t1 t2 t3 t4 t5 = ra_psplit ⟨ kc_nz , ∅ ⟩ V1 V2 V2 V1 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V2 $ by isset_var
l23: $ G ⇒ scons V2 (scons V1 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ scons V2 (scons V2 (scons V1 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l23]
l25: $ G ⇒ scons V1 (scons V2 (scons V2 (scons V1 ∅))) ∈ fseq y1_vv $ by y1_fs [l20, l24]
l26: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l27: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V2 (scons V1 ∅)))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ kr_psplit ∈ ω $ by x1_kr_psplit
l29: $ G ⇒ isset kr_psplit $ by wcel_isset [l28]
l30: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l31: $ G ⇒ isset (scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V2 (scons V1 ∅))))) $ by wcel_isset [l27]
l32: $ G ⇒ kr_psplit = kr_psplit ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V2 (scons V1 ∅)))) $ by opair_inj_c [l8, l29, l30, l29, l31]
l33: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons ⟨ kc_nz , ∅ ⟩ (scons V1 (scons V2 (scons V2 (scons V1 ∅)))) $ by and_elim_r [l32]
l34: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V1 (scons V2 (scons V2 (scons V1 ∅))) $ by y1_scons_inj [l33, l18, l26, l17, l25]
l35: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons V1 (scons V2 (scons V2 (scons V1 ∅))) $ by and_elim_r [l34]
l37: $ G ⇒ t2 = V1 ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V2 (scons V2 (scons V1 ∅)) $ by y1_scons_inj [l36, l16, l20, l15, l24]
l38: $ G ⇒ t2 = V1 $ by and_elim_l [l37]
l39: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V2 (scons V2 (scons V1 ∅)) $ by and_elim_r [l37]
l40: $ G ⇒ t3 = V2 ∧ scons t4 (scons t5 ∅) = scons V2 (scons V1 ∅) $ by y1_scons_inj [l39, l14, l22, l13, l23]
l41: $ G ⇒ t3 = V2 $ by and_elim_l [l40]
l42: $ G ⇒ scons t4 (scons t5 ∅) = scons V2 (scons V1 ∅) $ by and_elim_r [l40]
l43: $ G ⇒ t4 = V2 ∧ scons t5 ∅ = scons V1 ∅ $ by y1_scons_inj [l42, l12, l22, l11, l21]
l44: $ G ⇒ t4 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t5 ∅ = scons V1 ∅ $ by and_elim_r [l43]
l46: $ G ⇒ t5 = V1 ∧ ∅ = ∅ $ by y1_scons_inj [l45, l10, l20, l9, l9]
l47: $ G ⇒ t5 = V1 $ by and_elim_l [l46]
l48: $ G ⇒ t4 = V2 ∧ t5 = V1 $ by and_intro [l44, l47]
l49: $ G ⇒ t3 = V2 ∧ t4 = V2 ∧ t5 = V1 $ by and_intro [l41, l48]
l50: $ G ⇒ t2 = V1 ∧ t3 = V2 ∧ t4 = V2 ∧ t5 = V1 $ by and_intro [l38, l49]
l51: $ G ⇒ t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 ∧ t3 = V2 ∧ t4 = V2 ∧ t5 = V1 $ by and_intro [l35, l50]
l52: $ G ⇒ ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = V1 ∧ t3 = A ∧ t4 = A ∧ t5 = V1) $ by ex_intro [l51]
l53: $ G ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $ by ex_intro [l52]

lemma y1_d_psplit_z (G: hyps) {K A: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $
----
l1: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x ∊ cl_psplit_z ⇒ x ∊ cl_psplit_z $ by ax
l2: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x ∊ cl_psplit_z ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩ ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $ by y1_e_psplit_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ z (x = ⟨ ∅ , ra_psplit ⟨ kc_nz , ∅ ⟩ y z z y ⟩) ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x ∊ cl_psplit_z ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $ by ex_elim [l2, l10]
l12: $ G ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $ by wcel_elim [#1, l11]

lemma y1_e_psplit_s (G: hyps) {n_v B C res A X: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6: set):
  $ G ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅ , ra_psplit ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V5 V6 V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅ , ra_psplit ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V5 V6 V4 ⟩ = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_psplit t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_psplit ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V5 V6 V4) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅ ∧ ra_psplit t1 t2 t3 t4 t5 = ra_psplit ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V5 V6 V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_psplit t1 t2 t3 t4 t5 = ra_psplit ⟨ kc_s , scons V1 ∅ ⟩ ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ V5 V6 V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
l11: $ G ⇒ scons t5 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t4 $ by isset_var
l13: $ G ⇒ scons t4 (scons t5 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t3 $ by isset_var
l15: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t2 $ by isset_var
l17: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t1 $ by isset_var
l19: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V4 $ by isset_var
l21: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l20, l9]
l22: $ G ⇒ isset V6 $ by isset_var
l23: $ G ⇒ scons V6 (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset V5 $ by isset_var
l25: $ G ⇒ scons V5 (scons V6 (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by opair_isset
l27: $ G ⇒ scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅))) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset ⟨ kc_s , scons V1 ∅ ⟩ $ by opair_isset
l29: $ G ⇒ scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅)))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ kr_psplit ∈ ω $ by x1_kr_psplit
l31: $ G ⇒ isset kr_psplit $ by wcel_isset [l30]
l32: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅))))) $ by wcel_isset [l19]
l33: $ G ⇒ isset (scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅))))) $ by wcel_isset [l29]
l34: $ G ⇒ kr_psplit = kr_psplit ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅)))) $ by opair_inj_c [l8, l31, l32, l31, l33]
l35: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 ∅)))) = scons ⟨ kc_s , scons V1 ∅ ⟩ (scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅)))) $ by and_elim_r [l34]
l36: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅))) $ by y1_scons_inj [l35, l18, l28, l17, l27]
l37: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ $ by and_elim_l [l36]
l38: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 ∅))) = scons ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ (scons V5 (scons V6 (scons V4 ∅))) $ by and_elim_r [l36]
l39: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ scons t3 (scons t4 (scons t5 ∅)) = scons V5 (scons V6 (scons V4 ∅)) $ by y1_scons_inj [l38, l16, l26, l15, l25]
l40: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ $ by and_elim_l [l39]
l41: $ G ⇒ scons t3 (scons t4 (scons t5 ∅)) = scons V5 (scons V6 (scons V4 ∅)) $ by and_elim_r [l39]
l42: $ G ⇒ t3 = V5 ∧ scons t4 (scons t5 ∅) = scons V6 (scons V4 ∅) $ by y1_scons_inj [l41, l14, l24, l13, l23]
l43: $ G ⇒ t3 = V5 $ by and_elim_l [l42]
l44: $ G ⇒ scons t4 (scons t5 ∅) = scons V6 (scons V4 ∅) $ by and_elim_r [l42]
l45: $ G ⇒ t4 = V6 ∧ scons t5 ∅ = scons V4 ∅ $ by y1_scons_inj [l44, l12, l22, l11, l21]
l46: $ G ⇒ t4 = V6 $ by and_elim_l [l45]
l47: $ G ⇒ scons t5 ∅ = scons V4 ∅ $ by and_elim_r [l45]
l48: $ G ⇒ t5 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l47, l10, l20, l9, l9]
l49: $ G ⇒ t5 = V4 $ by and_elim_l [l48]
l50: $ G ⇒ crn pp = crn (scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅) $ by crn_eq [l7]
l51: $ G ⇒ crn (scons (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) ∅) ⊆ lrel $ by subset_eq_l [l50, #2]
l52: $ G ⇒ isset (ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4) $ by opair_isset
l53: $ G ⇒ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4 ∈ lrel $ by crn_scons_head [l52, l51]
l54: $ G ⇒ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4 ∈ lrel $ by and_intro [l49, l53]
l55: $ G ⇒ t4 = V6 ∧ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4 ∈ lrel $ by and_intro [l46, l54]
l56: $ G ⇒ t3 = V5 ∧ t4 = V6 ∧ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4 ∈ lrel $ by and_intro [l43, l55]
l57: $ G ⇒ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V5 ∧ t4 = V6 ∧ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4 ∈ lrel $ by and_intro [l40, l56]
l58: $ G ⇒ t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V5 ∧ t4 = V6 ∧ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ V6 V4 ∈ lrel $ by and_intro [l37, l57]
l59: $ G ⇒ ∃ X (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = V5 ∧ t4 = X ∧ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons V5 ∅) ⟩ X V4 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ A ∃ X (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = V4 ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons A ∅) ⟩ X V4 ∈ lrel) $ by ex_intro [l59]
l61: $ G ⇒ ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons V2 (scons V3 ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit V1 V3 ⟨ kc_cons , scons V2 (scons A ∅) ⟩ X res ∈ lrel) $ by ex_intro [l60]
l62: $ G ⇒ ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons V2 (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit V1 C ⟨ kc_cons , scons V2 (scons A ∅) ⟩ X res ∈ lrel) $ by ex_intro [l61]
l63: $ G ⇒ ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit V1 C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_intro [l63]

lemma y1_d_psplit_s (G: hyps) {n_v B C res A X: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x ∊ cl_psplit_s ⇒ x ∊ cl_psplit_s $ by ax
l2: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x ∊ cl_psplit_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩ ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by y1_e_psplit_s [l6, l7]
l9: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_psplit y u ⟨ kc_cons , scons z (scons w ∅) ⟩ a v) ∅ , ra_psplit ⟨ kc_s , scons y ∅ ⟩ ⟨ kc_pi , scons z (scons u ∅) ⟩ w a v ⟩) ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ , x ∊ cl_psplit_s ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by ex_elim [l2, l18]
l20: $ G ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_psplit (G: hyps) {K A n_v B C res X: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ pr_psplit $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) ∨ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s $ by ax
l2: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by y1_d_psplit_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s → ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s $ by ax
l6: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∨ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z $ by ax
l8: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) $ by y1_d_psplit_z [l7, l8]
l10: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) ∨ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s $ by ax
l12: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s → ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_z ∪ cl_psplit_s , ⟨ pp , ra_psplit t1 t2 t3 t4 t5 ⟩ ∈ cl_psplit_s ⇒ ∃ K ∃ A (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = K ∧ t3 = A ∧ t4 = A ∧ t5 = K) ∨ ∃ n_v ∃ B ∃ C ∃ res ∃ A ∃ X (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = ⟨ kc_pi , scons B (scons C ∅) ⟩ ∧ t3 = A ∧ t4 = X ∧ t5 = res ∧ ra_psplit n_v C ⟨ kc_cons , scons B (scons A ∅) ⟩ X res ∈ lrel) $ by or_intro_r [l13]
