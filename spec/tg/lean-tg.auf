lemma y2_nfields_e1 (GG: hyps) (q1 q2 q3 q4 w4 u_D u_b u_P u_T u_i u_c u_nf u_F u_K u_C v_D v_b v_P v_T v_i v_c v_nf v_F v_K v_C: set):
  $ GG ⇒ q1 = u_D $ > $ GG ⇒ q2 = u_i $ > $ GG ⇒ q3 = u_c $ > $ GG ⇒ q4 = u_nf $ > $ GG ⇒ ra_ind_data u_D u_b u_P u_T ∈ lrel $ > $ GG ⇒ ra_nth_ty u_T u_i u_F u_C ∈ lrel $ > $ GG ⇒ ra_nth_ctor u_C u_c u_K ∈ lrel $ > $ GG ⇒ ra_npis u_K u_nf ∈ lrel $ > $ GG ⇒ q1 = v_D $ > $ GG ⇒ q2 = v_i $ > $ GG ⇒ q3 = v_c $ > $ GG ⇒ w4 = v_nf $ > $ GG ⇒ ra_ind_data v_D v_b v_P v_T ∈ lrel $ > $ GG ⇒ ra_nth_ty v_T v_i v_F v_C ∈ lrel $ > $ GG ⇒ ra_nth_ctor v_C v_c v_K ∈ lrel $ > $ GG ⇒ ra_npis v_K v_nf ∈ lrel $ > $ GG ⇒ q4 = w4 $
----
l1: $ GG ⇒ u_D = q1 $ by eq_sym [#1]
l2: $ GG ⇒ u_D = v_D $ by eq_trans [l1, #9]
l3: $ GG ⇒ u_i = q2 $ by eq_sym [#2]
