l56: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 (scons t9 (scons t10 (scons t11 ∅))))))))))) $ by wcel_isset [l31]
