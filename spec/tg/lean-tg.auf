lemma y2_spine2_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_spine2 lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_spine2 lrel → c ∊ y2_P_spine2 lrel) $ by y2_spine2_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_spine2 lrel $ by horn_ind [l1, l2]

lrel_spine_det2
---------------
l1: $ G ⇒ horn lprog ⊆ y2_P_spine2 lrel $ by y2_spine2_in
l2: $ G ⇒ ra_spine u1 t2 u3 ∈ y2_P_spine2 lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u1 = v1 ∧ u3 = v3 $ by y2_spine2_ih [l2, #2, #3, #4]

