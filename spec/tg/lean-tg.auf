lemma y1_e_afree_quot_lift (G: hyps) {u_v v_v: set} (pp t1 V1 V2: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_quot_lift , scons V1 (scons V2 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
