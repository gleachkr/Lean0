l9: $ G ⇒ cl_nth_pi_z ⊆ y1_lab kr_nth_pi (suc kr_nth_pi) $ by subset_intro [l8]

lemma y1_k_nth_pi_s (G: hyps): $ G ⇒ cl_nth_pi_s ⊆ y1_lab kr_nth_pi (suc kr_nth_pi) $
----
l1: $ G , x ∊ cl_nth_pi_s ⇒ x ∊ cl_nth_pi_s $ by ax
l2: $ G , x ∊ cl_nth_pi_s ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ kr_nth_pi ∈ ω $ by x1_kr_nth_pi
l5: $ G , x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩ ⇒ x ∊ y1_lab kr_nth_pi (suc kr_nth_pi) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ x ∊ y1_lab kr_nth_pi (suc kr_nth_pi) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ x ∊ y1_lab kr_nth_pi (suc kr_nth_pi) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ scons (ra_nth_pi u v y) ∅ , ra_nth_pi ⟨ kc_pi , scons z (scons u ∅) ⟩ ⟨ kc_s , scons v ∅ ⟩ y ⟩) ⇒ x ∊ y1_lab kr_nth_pi (suc kr_nth_pi) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_nth_pi_s ⇒ x ∊ y1_lab kr_nth_pi (suc kr_nth_pi) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_nth_pi_s ⊆ y1_lab kr_nth_pi (suc kr_nth_pi) $ by subset_intro [l12]

