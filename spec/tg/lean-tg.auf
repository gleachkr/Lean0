l9: $ G , ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l8, l7]
l10: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l11: $ G , ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l10, l9]
l12: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l13: $ G , ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l12, l11]
l14: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) $ by ax
l15: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ scons (ra_rst y z u v) (scons (ra_crst y z w a) ∅) , ra_crst y z ⟨ kc_cons , scons u (scons w ∅) ⟩ ⟨ kc_cons , scons v (scons a ∅) ⟩ ⟩) ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l14, l13]
l16: $ G , x ∊ cl_crst_cons ⇒ x ∊ y1_lab kr_crst (suc kr_crst) $ by ex_elim [l2, l15]
l17: $ G ⇒ cl_crst_cons ⊆ y1_lab kr_crst (suc kr_crst) $ by subset_intro [l16]

lemma y1_p_crst (G: hyps): $ G ⇒ pr_crst ⊆ y1_lab kr_crst (suc kr_crst) $
----
