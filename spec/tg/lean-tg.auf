l6: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ $ by and_elim_l [l5]
l7: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ ra_spine u_h u_e u_k ∈ lrel ∧ ra_spine u_h u_e u_k ∈ y2_P_spine lrel $ by and_elim_r [l5]
l8: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ $ by and_elim_l [l7]
l9: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_spine u_h u_e u_k ∈ lrel ∧ ra_spine u_h u_e u_k ∈ y2_P_spine lrel $ by and_elim_r [l7]
l10: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_spine u_h u_e u_k ∈ lrel $ by and_elim_l [l9]
l11: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_spine u_h u_e u_k ∈ y2_P_spine lrel $ by and_elim_r [l9]
l12: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ w1 = a $ by and_elim_l [l2]
