ra_le_congr
-----------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A2 ∅ ≐ scons B2 ∅ $ by scons_congr [#2, l1]
l3: $ scons A1 (scons A2 ∅) ≐ scons B1 (scons B2 ∅) $ by scons_congr [#1, l2]
l4: $ kr_le ≐ kr_le $ by ceqt_refl
l5: $ ⟨ kr_le , scons A1 (scons A2 ∅) ⟩ ≐ ⟨ kr_le , scons B1 (scons B2 ∅) ⟩ $ by opair_congr [l4, l3]

ra_le_eq
--------
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ scons A2 ∅ = scons B2 ∅ $ by scons_eq [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) = scons B1 (scons B2 ∅) $ by scons_eq [#1, l2]
l4: $ G ⇒ kr_le = kr_le $ by eq_refl
l5: $ G ⇒ ⟨ kr_le , scons A1 (scons A2 ∅) ⟩ = ⟨ kr_le , scons B1 (scons B2 ∅) ⟩ $ by opair_eq [l4, l3]

sb_c_ra_le
----------
l1: $ (⟦ x / t ⟧ ⟨ kr_le , scons A1 (scons A2 ∅) ⟩) ≐ ⟨ kr_le , scons (⟦ x / t ⟧ A1) (scons (⟦ x / t ⟧ A2) ∅) ⟩ $ by ceqt_refl

ra_add_congr
------------
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A3 ∅ ≐ scons B3 ∅ $ by scons_congr [#3, l1]
l3: $ scons A2 (scons A3 ∅) ≐ scons B2 (scons B3 ∅) $ by scons_congr [#2, l2]
l4: $ scons A1 (scons A2 (scons A3 ∅)) ≐ scons B1 (scons B2 (scons B3 ∅)) $ by scons_congr [#1, l3]
l5: $ kr_add ≐ kr_add $ by ceqt_refl
l6: $ ⟨ kr_add , scons A1 (scons A2 (scons A3 ∅)) ⟩ ≐ ⟨ kr_add , scons B1 (scons B2 (scons B3 ∅)) ⟩ $ by opair_congr [l5, l4]

