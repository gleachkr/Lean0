l17: $ G ⇒ scons V7 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_ntys ∈ ω $ by x1_kr_ntys
l23: $ G ⇒ isset kr_ntys $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_ntys = kr_ntys ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V7 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t3 ∅ = scons V7 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V7 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V7 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V7 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅))) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_ntys V3 V4 V5) (scons (ra_clen_c V2 V6) (scons (ra_add V5 V6 V7) ∅))) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_ntys V3 V4 V5) $ by opair_isset
