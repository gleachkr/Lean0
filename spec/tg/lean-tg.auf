l46: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V6 (scons ⟨ kc_srt , scons V7 ∅ ⟩ (scons ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∅))))) $ by and_elim_r [l44]
l47: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V6 (scons ⟨ kc_srt , scons V7 ∅ ⟩ (scons ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ∅)))) $ by y1_scons_inj [l46, l20, l34, l19, l33]
