l49: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ N (t1 = ⟨ kc_ind_mkn , scons b_v (scons P (scons T (scons N ∅))) ⟩ ∧ t2 = b_v ∧ t3 = P ∧ t4 = T) $ by ex_intro [l48]

