lemma y2_spine_e2 (GG: hyps) (q1 q2 q3 w1 u_h u_e u_a u_k v_h v_e v_a v_k: set):
  $ GG ⇒ q1 = u_h $ > $ GG ⇒ q2 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ $ > $ GG ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ $ > $ GG ⇒ ra_spine u_h u_e u_k ∈ lrel $ > $ GG ⇒ ra_spine u_h u_e u_k ∈ y2_P_spine lrel $ > $ GG ⇒ w1 = v_h $ > $ GG ⇒ q2 = ⟨ kc_app , scons v_e (scons v_a ∅) ⟩ $ > $ GG ⇒ q3 = ⟨ kc_s , scons v_k ∅ ⟩ $ > $ GG ⇒ ra_spine v_h v_e v_k ∈ lrel $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG ⇒ ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ = q2 $ by eq_sym [#2]
l2: $ GG ⇒ ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ = ⟨ kc_app , scons v_e (scons v_a ∅) ⟩ $ by eq_trans [l1, #7]
l3: $ GG ⇒ kc_app ∈ ω $ by v1_kc_app
l4: $ GG ⇒ isset kc_app $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_e $ by isset_var
l6: $ GG ⇒ isset u_a $ by isset_var
l7: $ GG ⇒ isset v_e $ by isset_var
l8: $ GG ⇒ isset v_a $ by isset_var
l9: $ GG ⇒ u_e = v_e ∧ u_a = v_a $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_e = v_e $ by and_elim_l [l9]
l11: $ GG ⇒ u_a = v_a $ by and_elim_r [l9]
l12: $ GG ⇒ ⟨ kc_s , scons u_k ∅ ⟩ = q3 $ by eq_sym [#3]
l13: $ GG ⇒ ⟨ kc_s , scons u_k ∅ ⟩ = ⟨ kc_s , scons v_k ∅ ⟩ $ by eq_trans [l12, #8]
l14: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l15: $ GG ⇒ isset kc_s $ by wcel_isset [l14]
l16: $ GG ⇒ isset u_k $ by isset_var
l17: $ GG ⇒ isset v_k $ by isset_var
l18: $ GG ⇒ u_k = v_k $ by y2_nd1 [l13, l15, l16, l17]
l19: $ GG ⇒ v_h = v_h $ by eq_refl
l20: $ GG ⇒ v_e = u_e $ by eq_sym [l10]
l21: $ GG ⇒ v_k = u_k $ by eq_sym [l18]
l22: $ GG ⇒ ra_spine v_h u_e u_k ∈ lrel $ by x1_eq_spine [#9, l19, l20, l21]
l23: $ GG ⇒ isset u_h $ by isset_var
l24: $ GG ⇒ isset u_e $ by isset_var
l25: $ GG ⇒ isset u_k $ by isset_var
l26: $ GG ⇒ isset v_h $ by isset_var
l27: $ GG ⇒ u_h = v_h $ by y2_spine_ihc [l23, l24, l25, l26, #5, l22]
l28: $ GG ⇒ v_h = w1 $ by eq_sym [#6]
l29: $ GG ⇒ q1 = v_h $ by eq_trans [#1, l27]
l30: $ GG ⇒ q1 = w1 $ by eq_trans [l29, l28]

lemma y2_spine_c2 (GG: hyps) (q1 q2 q3 w1 u_h u_e u_a u_k: set):
  $ GG ⇒ q1 = u_h ∧ q2 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ ∧ q3 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ ra_spine u_h u_e u_k ∈ lrel ∧ ra_spine u_h u_e u_k ∈ y2_P_spine lrel $ > $ GG ⇒ ra_spine w1 q2 q3 ∈ lrel $ > $ GG ⇒ q1 = w1 $
----
l1: $ GG ⇒ ∃ a (w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ a ∃ b ∃ d ∃ e (w1 = a ∧ q2 = ⟨ kc_app , scons b (scons d ∅) ⟩ ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ ra_spine a b e ∈ lrel) $ by lrel_spine_cases [#2]
l2: $ GG , w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ w1 = a ∧ q2 = a ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by ax
