lemma y2_rehead_e2 (GG: hyps) (q1 q2 q3 q4 q5 w1 w5 u_Y u_X u_e u_e2 u_a u_k v_Y v_X v_e v_e2 v_a v_k: set):
  $ GG ⇒ q1 = u_Y $ > $ GG ⇒ q2 = u_X $ > $ GG ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ $ > $ GG ⇒ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ $ > $ GG ⇒ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ $ > $ GG ⇒ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel $ > $ GG ⇒ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ > $ GG ⇒ w1 = v_Y $ > $ GG ⇒ q2 = v_X $ > $ GG ⇒ q3 = ⟨ kc_s , scons v_k ∅ ⟩ $ > $ GG ⇒ q4 = ⟨ kc_app , scons v_e (scons v_a ∅) ⟩ $ > $ GG ⇒ w5 = ⟨ kc_app , scons v_e2 (scons v_a ∅) ⟩ $ > $ GG ⇒ ra_rehead v_Y v_X v_k v_e v_e2 ∈ lrel $ > $ GG ⇒ q1 = w1 ∧ q5 = w5 $
----
l1: $ GG ⇒ u_X = q2 $ by eq_sym [#2]
l2: $ GG ⇒ u_X = v_X $ by eq_trans [l1, #9]
l3: $ GG ⇒ ⟨ kc_s , scons u_k ∅ ⟩ = q3 $ by eq_sym [#3]
l4: $ GG ⇒ ⟨ kc_s , scons u_k ∅ ⟩ = ⟨ kc_s , scons v_k ∅ ⟩ $ by eq_trans [l3, #10]
l5: $ GG ⇒ kc_s ∈ ω $ by v1_kc_s
l6: $ GG ⇒ isset kc_s $ by wcel_isset [l5]
l7: $ GG ⇒ isset u_k $ by isset_var
l8: $ GG ⇒ isset v_k $ by isset_var
l9: $ GG ⇒ u_k = v_k $ by y2_nd1 [l4, l6, l7, l8]
l10: $ GG ⇒ ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ = q4 $ by eq_sym [#4]
l11: $ GG ⇒ ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ = ⟨ kc_app , scons v_e (scons v_a ∅) ⟩ $ by eq_trans [l10, #11]
l12: $ GG ⇒ kc_app ∈ ω $ by v1_kc_app
l13: $ GG ⇒ isset kc_app $ by wcel_isset [l12]
l14: $ GG ⇒ isset u_e $ by isset_var
l15: $ GG ⇒ isset u_a $ by isset_var
l16: $ GG ⇒ isset v_e $ by isset_var
l17: $ GG ⇒ isset v_a $ by isset_var
l18: $ GG ⇒ u_e = v_e ∧ u_a = v_a $ by y2_nd2 [l11, l13, l14, l15, l16, l17]
l19: $ GG ⇒ u_e = v_e $ by and_elim_l [l18]
l20: $ GG ⇒ u_a = v_a $ by and_elim_r [l18]
l21: $ GG ⇒ v_Y = v_Y $ by eq_refl
l22: $ GG ⇒ v_X = u_X $ by eq_sym [l2]
l23: $ GG ⇒ v_k = u_k $ by eq_sym [l9]
l24: $ GG ⇒ v_e = u_e $ by eq_sym [l19]
l25: $ GG ⇒ v_e2 = v_e2 $ by eq_refl
l26: $ GG ⇒ ra_rehead v_Y u_X u_k u_e v_e2 ∈ lrel $ by x1_eq_rehead [#13, l21, l22, l23, l24, l25]
l27: $ GG ⇒ isset u_Y $ by isset_var
l28: $ GG ⇒ isset u_X $ by isset_var
l29: $ GG ⇒ isset u_k $ by isset_var
l30: $ GG ⇒ isset u_e $ by isset_var
l31: $ GG ⇒ isset u_e2 $ by isset_var
l32: $ GG ⇒ isset v_Y $ by isset_var
l33: $ GG ⇒ isset v_e2 $ by isset_var
l34: $ GG ⇒ u_Y = v_Y ∧ u_e2 = v_e2 $ by y2_rehead_ihc [l27, l28, l29, l30, l31, l32, l33, #7, l26]
l35: $ GG ⇒ u_Y = v_Y $ by and_elim_l [l34]
l36: $ GG ⇒ u_e2 = v_e2 $ by and_elim_r [l34]
l37: $ GG ⇒ v_Y = w1 $ by eq_sym [#8]
l38: $ GG ⇒ q1 = v_Y $ by eq_trans [#1, l35]
l39: $ GG ⇒ q1 = w1 $ by eq_trans [l38, l37]
l40: $ GG ⇒ ∅ = ∅ $ by eq_refl
l41: $ GG ⇒ scons u_a ∅ = scons v_a ∅ $ by scons_eq [l20, l40]
l42: $ GG ⇒ scons u_e2 (scons u_a ∅) = scons v_e2 (scons v_a ∅) $ by scons_eq [l36, l41]
l43: $ GG ⇒ kc_app = kc_app $ by eq_refl
l44: $ GG ⇒ ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ = ⟨ kc_app , scons v_e2 (scons v_a ∅) ⟩ $ by opair_eq [l43, l42]
l45: $ GG ⇒ ⟨ kc_app , scons v_e2 (scons v_a ∅) ⟩ = w5 $ by eq_sym [#12]
l46: $ GG ⇒ q5 = ⟨ kc_app , scons v_e2 (scons v_a ∅) ⟩ $ by eq_trans [#5, l44]
l47: $ GG ⇒ q5 = w5 $ by eq_trans [l46, l45]
l48: $ GG ⇒ q1 = w1 ∧ q5 = w5 $ by and_intro [l39, l47]

lemma y2_rehead_c2 (GG: hyps) (q1 q2 q3 q4 q5 w1 w5 u_Y u_X u_e u_e2 u_a u_k: set):
  $ GG ⇒ q1 = u_Y ∧ q2 = u_X ∧ q3 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ ∧ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ > $ GG ⇒ ra_rehead w1 q2 q3 q4 w5 ∈ lrel $ > $ GG ⇒ q1 = w1 ∧ q5 = w5 $
----
l1: $ GG ⇒ ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ∨ ∃ a ∃ b ∃ d ∃ e ∃ f ∃ g (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ w5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel) $ by lrel_rehead_cases [#2]
l2: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b $ by ax
l3: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q1 = u_Y ∧ q2 = u_X ∧ q3 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ ∧ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by weaken [#1]
l4: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q1 = u_Y $ by and_elim_l [l3]
l5: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = u_X ∧ q3 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ ∧ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by and_elim_r [l3]
l6: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = u_X $ by and_elim_l [l5]
l7: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ ∧ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ ∧ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by and_elim_r [l5]
l8: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_s , scons u_k ∅ ⟩ $ by and_elim_l [l7]
l9: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ ∧ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by and_elim_r [l7]
l10: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = ⟨ kc_app , scons u_e (scons u_a ∅) ⟩ $ by and_elim_l [l9]
l11: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by and_elim_r [l9]
l12: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q5 = ⟨ kc_app , scons u_e2 (scons u_a ∅) ⟩ $ by and_elim_l [l11]
l13: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel ∧ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by and_elim_r [l11]
l14: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ ra_rehead u_Y u_X u_k u_e u_e2 ∈ lrel $ by and_elim_l [l13]
l15: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ ra_rehead u_Y u_X u_k u_e u_e2 ∈ y2_P_rehead lrel $ by and_elim_r [l13]
l16: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ w1 = a $ by and_elim_l [l2]
l17: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b $ by and_elim_r [l2]
l18: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q2 = b $ by and_elim_l [l17]
l19: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b $ by and_elim_r [l17]
l20: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q3 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l19]
l21: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = a ∧ w5 = b $ by and_elim_r [l19]
l22: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q4 = a $ by and_elim_l [l21]
l23: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ w5 = b $ by and_elim_r [l21]
l24: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ kc_nz ∈ kc_s $ by y2_lt_nz_s
l25: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ kc_s ∈ ω $ by v1_kc_s
l26: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ isset kc_s $ by wcel_isset [l25]
l27: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ ⊥ $ by y2_ne [l20, l8, l24, l26]
l28: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b ⇒ q1 = w1 ∧ q5 = w5 $ by bot_elim [l27]
l29: $ GG , ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) $ by ax
l30: $ GG , ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ q1 = w1 ∧ q5 = w5 $ by ex_elim [l29, l28]
l31: $ GG , ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) $ by ax
l32: $ GG , ∃ a ∃ b (w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = a ∧ w5 = b) ⇒ q1 = w1 ∧ q5 = w5 $ by ex_elim [l31, l30]
l33: $ GG , w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ w5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel ⇒ w1 = a ∧ q2 = b ∧ q3 = ⟨ kc_s , scons g ∅ ⟩ ∧ q4 = ⟨ kc_app , scons d (scons f ∅) ⟩ ∧ w5 = ⟨ kc_app , scons e (scons f ∅) ⟩ ∧ ra_rehead a b g d e ∈ lrel $ by ax
