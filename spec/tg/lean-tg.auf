l15: $ G , ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_ihty_pi ∪ cl_ihty_app ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t9 = ⟨ kc_pi , scons A (scons IH ∅) ⟩ ∧ ra_ihty D np n_v mo fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ⟩ ∈ cl_ihty_pi ∪ cl_ihty_app → ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t9 = ⟨ kc_pi , scons A (scons IH ∅) ⟩ ∧ ra_ihty D np n_v mo fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t9 = ⟨ kc_pi , scons A (scons IH ∅) ⟩ ∧ ra_ihty D np n_v mo fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_mwalk_pi_nr (G: hyps) {D np n_v k_v i_v c_v nf d_v r_v dp kn Ihs A A3 B Min: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16: set):
  $ G ⇒ ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ = ⟨ scons (ra_add V8 V2 V10) (scons (ra_closed V10 V13) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V13 V14) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V12 V15 V16) ∅)))) , ra_mwalk V1 V2 V3 V4 V5 V6 V7 V8 V9 V12 ⟨ kc_pi , scons V13 (scons V15 ∅) ⟩ ⟨ kc_pi , scons V14 (scons V16 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ Ihs ∃ A ∃ A3 ∃ B ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A A3 ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ r_v Ihs B Min ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V8 V2 V10) (scons (ra_closed V10 V13) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V13 V14) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V12 V15 V16) ∅)))) , ra_mwalk V1 V2 V3 V4 V5 V6 V7 V8 V9 V12 ⟨ kc_pi , scons V13 (scons V15 ∅) ⟩ ⟨ kc_pi , scons V14 (scons V16 ∅) ⟩ ⟩ = ⟨ pp , ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V8 V2 V10) (scons (ra_closed V10 V13) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V13 V14) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V12 V15 V16) ∅))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12) $ by opair_isset
l5: $ G ⇒ isset (ra_mwalk V1 V2 V3 V4 V5 V6 V7 V8 V9 V12 ⟨ kc_pi , scons V13 (scons V15 ∅) ⟩ ⟨ kc_pi , scons V14 (scons V16 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_add V8 V2 V10) (scons (ra_closed V10 V13) (scons (ra_add V4 V3 V11) (scons (ra_lift V11 V8 V13 V14) (scons (ra_mwalk V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V12 V15 V16) ∅)))) ∧ ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 = ra_mwalk V1 V2 V3 V4 V5 V6 V7 V8 V9 V12 ⟨ kc_pi , scons V13 (scons V15 ∅) ⟩ ⟨ kc_pi , scons V14 (scons V16 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
