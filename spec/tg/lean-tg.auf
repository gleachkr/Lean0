l27: $ G ⇒ scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V5 $ by isset_var
l29: $ G ⇒ scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V4 $ by isset_var
l31: $ G ⇒ scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V3 $ by isset_var
l33: $ G ⇒ scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ isset V2 $ by isset_var
l35: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))))) ∈ fseq y1_vv $ by y1_fs [l34, l33]
l36: $ G ⇒ isset V1 $ by isset_var
l37: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))))) ∈ fseq y1_vv $ by y1_fs [l36, l35]
l38: $ G ⇒ kr_mty ∈ ω $ by x1_kr_mty
l39: $ G ⇒ isset kr_mty $ by wcel_isset [l38]
l40: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))))) $ by wcel_isset [l23]
l41: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))))))) $ by wcel_isset [l37]
l42: $ G ⇒ kr_mty = kr_mty ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))))) $ by opair_inj_c [l8, l39, l40, l39, l41]
l43: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))))) $ by and_elim_r [l42]
l44: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))))) $ by y1_scons_inj [l43, l22, l36, l21, l35]
l45: $ G ⇒ t1 = V1 $ by and_elim_l [l44]
l46: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))))) $ by and_elim_r [l44]
l47: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) $ by y1_scons_inj [l46, l20, l34, l19, l33]
l48: $ G ⇒ t2 = V2 $ by and_elim_l [l47]
l49: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 ∅)))) = scons V3 (scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)))) $ by and_elim_r [l47]
l50: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) $ by y1_scons_inj [l49, l18, l32, l17, l31]
l51: $ G ⇒ t3 = V3 $ by and_elim_l [l50]
l52: $ G ⇒ scons t4 (scons t5 (scons t6 (scons t7 ∅))) = scons V4 (scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅))) $ by and_elim_r [l50]
l53: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 (scons t7 ∅)) = scons V5 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅)) $ by y1_scons_inj [l52, l16, l30, l15, l29]
