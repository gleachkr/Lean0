lemma y2_ind_data_d1 (GG: hyps) (o q1 q2 q3 q4 w2 w3 w4: set):
  $ GG ⇒ ⟨ o , ra_ind_data q1 q2 q3 q4 ⟩ ∈ cl_ind_data_i $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_data lrel $ > $ GG ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d $ by ax
l2: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_data_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l4]
l6: $ GG ⇒ ∀ b ∀ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l5]
l7: $ GG ⇒ ∀ a ∀ b ∀ d (q1 = ⟨ kc_ind_mk , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = a ∧ q3 = b ∧ q4 = d → q2 = w2 ∧ q3 = w3 ∧ q4 = w4) $ by all_intro [l6]
l8: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by y2_ind_data_i1 [#1, #2, l7]

lemma y2_ind_data_i2 (GG: hyps) {b P T N: set} (o q1 q2 q3 q4: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_ind_data q1 q2 q3 q4 ⟩ ∈ cl_ind_data_n $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ind_data lrel $ > $ GG ⇒ ∀ b ∀ P ∀ T ∀ N (q1 = ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ ∧ q2 = b ∧ q3 = P ∧ q4 = T → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_ind_data q1 q2 q3 q4 ⟩ , w ∊ cl_ind_data_n ⇒ w ∊ cl_ind_data_n $ by ax
l2: $ GG , w = ⟨ o , ra_ind_data q1 q2 q3 q4 ⟩ , w ∊ cl_ind_data_n ⇒ ∃ b ∃ P ∃ T ∃ N (w = ⟨ ∅ , ra_ind_data ⟨ kc_ind_mkn , scons b (scons P (scons T (scons N ∅))) ⟩ b P T ⟩) $ by cab_elim [l1]
