l45: $ G , x = ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ , x ∊ cl_rec_ty_i ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $ by ex_elim [l2, l44]
l46: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $ by wcel_elim [#1, l45]

lemma y1_o_rec_ty (G: hyps) {D b_v P T v_v i_v np n_v m_v mn M N F F2 B R1 R2 R C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_rec_ty t1 t2 t3 t4 ⟩ ∈ pr_rec_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ M ∃ N ∃ F ∃ F2 ∃ B ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_rtail D np n_v m_v i_v ⟨ kc_nz , ∅ ⟩ F2 B ∈ lrel ∧ ra_pis N B R1 ∈ lrel ∧ ra_pis M R1 R2 ∈ lrel ∧ ra_pis P R2 R ∈ lrel) $ by y1_d_rec_ty_i [#1, #2]

lemma y1_e_ctor_ty_i (G: hyps) {D b_v P N T i_v c_v np n_v m_v F K K2 K3 R C: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16: set):
  $ G ⇒ ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V5) (scons (ra_nth_ty V5 V6 V11 V16) (scons (ra_nth_ctor V16 V7 V12) (scons (ra_clen V3 V8) (scons (ra_ntys V5 V9 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V12 V13) (scons (ra_ind_nested V1 V4) (scons (ra_rst V1 V4 V13 V14) (scons (ra_pis V3 V14 V15) ∅)))))))) , ra_ctor_ty V1 V6 V7 V15 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ K3 ∃ R ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_rst D N K2 K3 ∈ lrel ∧ ra_pis P K3 R ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V5) (scons (ra_nth_ty V5 V6 V11 V16) (scons (ra_nth_ctor V16 V7 V12) (scons (ra_clen V3 V8) (scons (ra_ntys V5 V9 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V12 V13) (scons (ra_ind_nested V1 V4) (scons (ra_rst V1 V4 V13 V14) (scons (ra_pis V3 V14 V15) ∅)))))))) , ra_ctor_ty V1 V6 V7 V15 ⟩ = ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V5) (scons (ra_nth_ty V5 V6 V11 V16) (scons (ra_nth_ctor V16 V7 V12) (scons (ra_clen V3 V8) (scons (ra_ntys V5 V9 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V12 V13) (scons (ra_ind_nested V1 V4) (scons (ra_rst V1 V4 V13 V14) (scons (ra_pis V3 V14 V15) ∅))))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ctor_ty t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_ctor_ty V1 V6 V7 V15) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V5) (scons (ra_nth_ty V5 V6 V11 V16) (scons (ra_nth_ctor V16 V7 V12) (scons (ra_clen V3 V8) (scons (ra_ntys V5 V9 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V12 V13) (scons (ra_ind_nested V1 V4) (scons (ra_rst V1 V4 V13 V14) (scons (ra_pis V3 V14 V15) ∅)))))))) ∧ ra_ctor_ty t1 t2 t3 t4 = ra_ctor_ty V1 V6 V7 V15 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V5) (scons (ra_nth_ty V5 V6 V11 V16) (scons (ra_nth_ctor V16 V7 V12) (scons (ra_clen V3 V8) (scons (ra_ntys V5 V9 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V9 V8 V12 V13) (scons (ra_ind_nested V1 V4) (scons (ra_rst V1 V4 V13 V14) (scons (ra_pis V3 V14 V15) ∅)))))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_ctor_ty t1 t2 t3 t4 = ra_ctor_ty V1 V6 V7 V15 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
