-- Atoms, and the derivable ones.

lemma x1_ra_le (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_le A1 A2 ∈ latoms $
----
l1: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l2: $ G ⇒ scons A2 ∅ ∈ fseq (trees ω) $ by v1_scons_fseq_c [#2, l1]
l3: $ G ⇒ scons A1 (scons A2 ∅) ∈ fseq (trees ω) $ by v1_scons_fseq_c [#1, l2]
l4: $ G ⇒ kr_le ∈ ω $ by x1_kr_le
l5: $ G ⇒ ra_le A1 A2 ∈ latoms $ by cxp_intro_c [l4, l3]

