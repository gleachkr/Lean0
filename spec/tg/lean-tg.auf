lemma y1_e_rst_ctor (G: hyps) {D I N j_v c_v i_v np n_v m_v na k_v npi e_v S X X1 X2 Y e2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19: set):
  $ G ⇒ ⟨ pp , ra_rst t1 t2 t3 t4 ⟩ = ⟨ scons (ra_spine ⟨ kc_ind_ctor , scons V1 (scons V4 (scons V5 ∅)) ⟩ V13 V10) (scons (ra_aux_of V1 V3 V4 V15) (scons (ra_ind_arity V1 V7 V8 V9) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V8 V7 V15 V16) (scons (ra_add V7 V11 V10) (scons (ra_spine V14 V13 V11) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V14 V16 V17) (scons (ra_spine ⟨ kc_ind_ty , scons V2 (scons V6 ∅) ⟩ V17 V12) (scons (ra_rehead ⟨ kc_ind_ty , scons V2 (scons V6 ∅) ⟩ ⟨ kc_ind_ctor , scons V2 (scons V6 (scons V5 ∅)) ⟩ V12 V17 V18) (scons (ra_rehead V14 V18 V11 V13 V19) ∅))))))))) , ra_rst V1 V3 V13 V19 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) $
