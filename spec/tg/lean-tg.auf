l21: $ G , x = ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_qinst_s ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_o_qinst (G: hyps) {b_v e_v A j_v A1 R k_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ pr_qinst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) ∨ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s $ by ax
l2: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by y1_d_qinst_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s → ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s $ by ax
l6: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∨ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z $ by ax
l8: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) $ by y1_d_qinst_z [l7, l8]
l10: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) ∨ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s $ by ax
l12: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s → ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_s ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) ∨ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) ∨ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_qinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_qinst_z ∪ cl_qinst_s → ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) ∨ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ b_v ∃ e_v ∃ A ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = A) ∨ ∃ b_v ∃ e_v ∃ A ∃ A1 ∃ R ∃ k_v ∃ j_v (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t4 = j_v ∧ t5 = A ∧ t6 = R ∧ ra_inst k_v A ⟨ kc_proj , scons b_v (scons j_v (scons e_v ∅)) ⟩ A1 ∈ lrel ∧ ra_qinst b_v e_v k_v ⟨ kc_s , scons j_v ∅ ⟩ A1 R ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_nonrec_pi (G: hyps) {np d_v k_v A B: set} (pp t1 t2 t3 V1 V2 V3 V4 V5: set):
  $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ = ⟨ scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅)) , ra_nonrec V1 V2 ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅)) , ra_nonrec V1 V2 ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ⟩ = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nonrec t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nonrec V1 V2 ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅)) ∧ ra_nonrec t1 t2 t3 = ra_nonrec V1 V2 ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_nonrec t1 t2 t3 = ra_nonrec V1 V2 ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nonrec ∈ ω $ by x1_kr_nonrec
l23: $ G ⇒ isset kr_nonrec $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nonrec = kr_nonrec ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅))) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_add V2 V1 V3) (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅))) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_add V2 V1 V3) $ by opair_isset
l39: $ G ⇒ ra_add V2 V1 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ crn (scons (ra_closed V3 V4) (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅)) ⊆ lrel $ by crn_scons_tail [l37]
l41: $ G ⇒ isset (ra_closed V3 V4) $ by opair_isset
l42: $ G ⇒ ra_closed V3 V4 ∈ lrel $ by crn_scons_head [l41, l40]
l43: $ G ⇒ crn (scons (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) ∅) ⊆ lrel $ by crn_scons_tail [l40]
l44: $ G ⇒ isset (ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5) $ by opair_isset
l45: $ G ⇒ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ ra_closed V3 V4 ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5 ∈ lrel $ by and_intro [l42, l45]
l47: $ G ⇒ ra_add V2 V1 V3 ∈ lrel ∧ ra_closed V3 V4 ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5 ∈ lrel $ by and_intro [l39, l46]
l48: $ G ⇒ t3 = ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∧ ra_add V2 V1 V3 ∈ lrel ∧ ra_closed V3 V4 ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∧ ra_add V2 V1 V3 ∈ lrel ∧ ra_closed V3 V4 ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V4 (scons V5 ∅) ⟩ ∧ ra_add V2 V1 V3 ∈ lrel ∧ ra_closed V3 V4 ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ V5 ∈ lrel $ by and_intro [l29, l49]
l51: $ G ⇒ ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons V4 (scons B ∅) ⟩ ∧ ra_add V2 V1 V3 ∈ lrel ∧ ra_closed V3 V4 ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ B ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add V2 V1 V3 ∈ lrel ∧ ra_closed V3 A ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ B ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ k_v ∃ A ∃ B (t1 = V1 ∧ t2 = V2 ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add V2 V1 k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons V2 ∅ ⟩ B ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ d_v ∃ k_v ∃ A ∃ B (t1 = V1 ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v V1 k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec V1 ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_intro [l54]

lemma y1_d_nonrec_pi (G: hyps) {np d_v k_v A B: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x ∊ cl_nonrec_pi ⇒ x ∊ cl_nonrec_pi $ by ax
l2: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x ∊ cl_nonrec_pi ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩ ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by y1_e_nonrec_pi [l6, l7]
l9: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w (x = ⟨ scons (ra_add z y u) (scons (ra_closed u v) (scons (ra_nonrec y ⟨ kc_s , scons z ∅ ⟩ w) ∅)) , ra_nonrec y z ⟨ kc_pi , scons v (scons w ∅) ⟩ ⟩) ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x ∊ cl_nonrec_pi ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by ex_elim [l2, l16]
l18: $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by wcel_elim [#1, l17]

lemma y1_e_nonrec_res (G: hyps) {np d_v K: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ = ⟨ scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec V1 V2 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec V1 V2 V3 ⟩ = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_nonrec t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_nonrec V1 V2 V3) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅ ∧ ra_nonrec t1 t2 t3 = ra_nonrec V1 V2 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_nonrec t1 t2 t3 = ra_nonrec V1 V2 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset V3 $ by isset_var
l17: $ G ⇒ scons V3 ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset V2 $ by isset_var
l19: $ G ⇒ scons V2 (scons V3 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset V1 $ by isset_var
l21: $ G ⇒ scons V1 (scons V2 (scons V3 ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_nonrec ∈ ω $ by x1_kr_nonrec
l23: $ G ⇒ isset kr_nonrec $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons V1 (scons V2 (scons V3 ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_nonrec = kr_nonrec ∧ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons V1 (scons V2 (scons V3 ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = V1 $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons V2 (scons V3 ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = V2 ∧ scons t3 ∅ = scons V3 ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = V2 $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons V3 ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = V3 ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = V3 $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_npis V3 ⟨ kc_nz , ∅ ⟩) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_npis V3 ⟨ kc_nz , ∅ ⟩) $ by opair_isset
l39: $ G ⇒ ra_npis V3 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = V3 ∧ ra_npis V3 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = V2 ∧ t3 = V3 ∧ ra_npis V3 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ ra_npis V3 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ K (t1 = V1 ∧ t2 = V2 ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ d_v ∃ K (t1 = V1 ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_intro [l44]

lemma y1_d_nonrec_res (G: hyps) {np d_v K: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x ∊ cl_nonrec_res ⇒ x ∊ cl_nonrec_res $ by ax
l2: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x ∊ cl_nonrec_res ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩ ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by y1_e_nonrec_res [l6, l7]
l9: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_npis u ⟨ kc_nz , ∅ ⟩) ∅ , ra_nonrec y z u ⟩) ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_nonrec t1 t2 t3 ⟩ , x ∊ cl_nonrec_res ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_nonrec (G: hyps) {np d_v k_v A B K: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ pr_nonrec $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res $ by ax
l2: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by y1_d_nonrec_res [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res → ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res $ by ax
l6: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∨ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi $ by ax
l8: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) $ by y1_d_nonrec_pi [l7, l8]
l10: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res $ by ax
l12: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res → ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_res ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_nonrec t1 t2 t3 ⟩ ∈ cl_nonrec_pi ∪ cl_nonrec_res → ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = np ∧ t2 = d_v ∧ t3 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_nonrec np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨ ∃ np ∃ d_v ∃ K (t1 = np ∧ t2 = d_v ∧ t3 = K ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_eta_ok_i (G: hyps) {D b_v P T j_v np F K: set} (pp t1 t2 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_eta_ok t1 t2 ⟩ = ⟨ scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)))) , ra_eta_ok V1 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)))) , ra_eta_ok V1 V5 ⟩ = ⟨ pp , ra_eta_ok t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_eta_ok t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_eta_ok V1 V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)))) ∧ ra_eta_ok t1 t2 = ra_eta_ok V1 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_eta_ok t1 t2 = ra_eta_ok V1 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V5 $ by isset_var
l15: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_eta_ok ∈ ω $ by x1_kr_eta_ok
l19: $ G ⇒ isset kr_eta_ok $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons V5 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_eta_ok = kr_eta_ok ∧ scons t1 (scons t2 ∅) = scons V1 (scons V5 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V5 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V5 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V5 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V5 $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))))) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_struct_like V1 V5) (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))))) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_struct_like V1 V5) $ by opair_isset
l32: $ G ⇒ ra_struct_like V1 V5 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)))) ⊆ lrel $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_ind_data V1 V2 V3 V4) $ by opair_isset
l35: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l34, l33]
l36: $ G ⇒ crn (scons (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))) ⊆ lrel $ by crn_scons_tail [l33]
l37: $ G ⇒ isset (ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) $ by opair_isset
l38: $ G ⇒ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel $ by crn_scons_head [l37, l36]
l39: $ G ⇒ crn (scons (ra_clen V3 V6) (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)) ⊆ lrel $ by crn_scons_tail [l36]
l40: $ G ⇒ isset (ra_clen V3 V6) $ by opair_isset
l41: $ G ⇒ ra_clen V3 V6 ∈ lrel $ by crn_scons_head [l40, l39]
l42: $ G ⇒ crn (scons (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) ∅) ⊆ lrel $ by crn_scons_tail [l39]
l43: $ G ⇒ isset (ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8) $ by opair_isset
l44: $ G ⇒ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by crn_scons_head [l43, l42]
l45: $ G ⇒ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l41, l44]
l46: $ G ⇒ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l38, l45]
l47: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l35, l46]
l48: $ G ⇒ ra_struct_like V1 V5 ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l32, l47]
l49: $ G ⇒ t2 = V5 ∧ ra_struct_like V1 V5 ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l28, l48]
l50: $ G ⇒ t1 = V1 ∧ t2 = V5 ∧ ra_struct_like V1 V5 ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons V8 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l25, l49]
l51: $ G ⇒ ∃ K (t1 = V1 ∧ t2 = V5 ∧ ra_struct_like V1 V5 ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V7 ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ F ∃ K (t1 = V1 ∧ t2 = V5 ∧ ra_struct_like V1 V5 ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 V6 ∈ lrel ∧ ra_nonrec V6 ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ np ∃ F ∃ K (t1 = V1 ∧ t2 = V5 ∧ ra_struct_like V1 V5 ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ j_v ∃ np ∃ F ∃ K (t1 = V1 ∧ t2 = j_v ∧ ra_struct_like V1 j_v ∈ lrel ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = V1 ∧ t2 = j_v ∧ ra_struct_like V1 j_v ∈ lrel ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen V3 np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = V1 ∧ t2 = j_v ∧ ra_struct_like V1 j_v ∈ lrel ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = V1 ∧ t2 = j_v ∧ ra_struct_like V1 j_v ∈ lrel ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l56]
l58: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_intro [l57]

lemma y1_d_eta_ok_i (G: hyps) {D b_v P T j_v np F K: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eta_ok t1 t2 ⟩ ∈ cl_eta_ok_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x ∊ cl_eta_ok_i ⇒ x ∊ cl_eta_ok_i $ by ax
l2: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x ∊ cl_eta_ok_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ x = ⟨ pp , ra_eta_ok t1 t2 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ ⟨ pp , ra_eta_ok t1 t2 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ ⟨ pp , ra_eta_ok t1 t2 ⟩ = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩ ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by y1_e_eta_ok_i [l6, l7]
l9: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) $ by ax
l22: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_struct_like y w) (scons (ra_ind_data y z u v) (scons (ra_nth_ty v w b ⟨ kc_ccons , scons c (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen u a) (scons (ra_nonrec a ⟨ kc_nz , ∅ ⟩ c) ∅)))) , ra_eta_ok y w ⟩) ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_eta_ok t1 t2 ⟩ , x ∊ cl_eta_ok_i ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by ex_elim [l2, l22]
l24: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by wcel_elim [#1, l23]

lemma y1_o_eta_ok (G: hyps) {D b_v P T j_v np F K: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_eta_ok t1 t2 ⟩ ∈ pr_eta_ok $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ np ∃ F ∃ K (t1 = D ∧ t2 = j_v ∧ ra_struct_like D j_v ∈ lrel ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_nonrec np ⟨ kc_nz , ∅ ⟩ K ∈ lrel) $ by y1_d_eta_ok_i [#1, #2]

lemma y1_e_projs_z (G: hyps) {b_v e_v Y: set} (pp t1 t2 t3 t4 t5 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ = ⟨ ∅ , ra_projs V1 V2 ⟨ kc_nz , ∅ ⟩ V3 V3 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ e_v ∃ Y (t1 = b_v ∧ t2 = e_v ∧ t3 = ⟨ kc_nz , ∅ ⟩ ∧ t4 = Y ∧ t5 = Y) $
----
l1: $ G ⇒ ⟨ ∅ , ra_projs V1 V2 ⟨ kc_nz , ∅ ⟩ V3 V3 ⟩ = ⟨ pp , ra_projs t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_projs t1 t2 t3 t4 t5) $ by opair_isset
l5: $ G ⇒ isset (ra_projs V1 V2 ⟨ kc_nz , ∅ ⟩ V3 V3) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_projs t1 t2 t3 t4 t5 = ra_projs V1 V2 ⟨ kc_nz , ∅ ⟩ V3 V3 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_projs t1 t2 t3 t4 t5 = ra_projs V1 V2 ⟨ kc_nz , ∅ ⟩ V3 V3 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t5 $ by isset_var
