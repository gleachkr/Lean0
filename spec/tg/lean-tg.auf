lemma y1_o_pinst (G: hyps) {i_v D j_v A c_v S a_v A1 R: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_pinst t1 t2 t3 t4 ⟩ ∈ pr_pinst $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) ∨ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) ∨ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $
