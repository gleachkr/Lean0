l151: $ G ⇒ ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = V1 ∧ t2 = V2 ∧ t3 = V3 ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v V2 dp ∈ lrel ∧ ra_recfield V1 V3 V2 d_v A j_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 dp A A2 ∈ lrel ∧ ra_add m_v V3 mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval V1 V2 V3 m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk V1 V2 V3 m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $ by ex_intro [l150]
l152: $ G ⇒ ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = V1 ∧ t2 = V2 ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v V2 dp ∈ lrel ∧ ra_recfield V1 n_v V2 d_v A j_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval V1 V2 n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk V1 V2 n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $ by ex_intro [l151]
l153: $ G ⇒ ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = V1 ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield V1 n_v np d_v A j_v ∈ lrel ∧ ra_sinst V1 ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval V1 np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk V1 np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $ by ex_intro [l152]
l154: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $ by ex_intro [l153]

lemma y1_d_rwalk_pi_rec (G: hyps) {D np n_v m_v v_v nf d_v dp mn j_v sh fld Acc A A2 A3 A4 B IH Val: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10: set):
  $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_rec $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x ∊ cl_rwalk_pi_rec ⇒ x ∊ cl_rwalk_pi_rec $ by ax
l2: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x ∊ cl_rwalk_pi_rec ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o (x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x = ⟨ scons (ra_add b z c) (scons (ra_recfield y u z b d g) (scons (ra_sinst y ⟨ kc_nz , ∅ ⟩ u c d e) (scons (ra_add v u f) (scons (ra_lift f b e h) (scons (ra_add i b a) (scons (ra_add j ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ i) (scons (ra_lift i ⟨ kc_nz , ∅ ⟩ h l) (scons (ra_ihval y z u v w a j ⟨ kc_nz , ∅ ⟩ g l n) (scons (ra_rwalk y z u v w a ⟨ kc_s , scons b ∅ ⟩ ⟨ kc_app , scons k (scons n ∅) ⟩ m o) ∅))))))))) , ra_rwalk y z u v w a b k ⟨ kc_pi , scons d (scons m ∅) ⟩ ⟨ kc_lam , scons h (scons o ∅) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
