l48: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by or_elim [l1, l12, l47]

lemma y2_ntys_d1 (GG: hyps) (o q1 q2 q3 w2 w3: set):
  $ GG ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ ∈ cl_ntys_nil $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel $ > $ GG ⇒ ra_ntys q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q1 = ⟨ kc_tnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = ⟨ kc_nz , ∅ ⟩ $ by ax
l2: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ ra_ntys q1 w2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_tnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = ⟨ kc_nz , ∅ ⟩ ⇒ q2 = w2 ∧ q3 = w3 $ by y2_ntys_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_tnil , ∅ ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = ⟨ kc_nz , ∅ ⟩ → q2 = w2 ∧ q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by y2_ntys_i1 [#1, #2, l4]

lemma y2_ntys_i2 (GG: hyps) {F C T n m c m2: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ ∈ cl_ntys_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel $ > $ GG ⇒ ∀ F ∀ C ∀ T ∀ n ∀ m ∀ c ∀ m2 (q1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ q3 = m2 ∧ ra_ntys T n m ∈ lrel ∧ ra_ntys T n m ∈ y2_P_ntys lrel ∧ ra_clen_c C c ∈ lrel ∧ ra_add m c m2 ∈ lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons ⇒ w ∊ cl_ntys_cons $ by ax
l2: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons ⇒ ∃ F ∃ C ∃ T ∃ n ∃ m ∃ c ∃ m2 (w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ w = ⟨ o , ra_ntys q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset (ra_ntys q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset (ra_add m c m2) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ scons (ra_add m c m2) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset (ra_clen_c C c) $ by opair_isset
l13: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ scons (ra_clen_c C c) (scons (ra_add m c m2) ∅) ∈ fseq y2_V $ by y2_fs [l12, l11]
l14: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset (ra_ntys T n m) $ by opair_isset
l15: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) ∈ fseq y2_V $ by y2_fs [l14, l13]
l16: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset (scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅))) $ by y2_fs_set [l15]
l17: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset (ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2) $ by opair_isset
l18: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ o = scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) ∧ ra_ntys q1 q2 q3 = ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 $ by opair_inj_c [l6, l7, l8, l16, l17]
l19: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ o = scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) $ by and_elim_l [l18]
l20: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ ⟨ kr_ntys , scons q1 (scons q2 (scons q3 ∅)) ⟩ = ⟨ kr_ntys , scons ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ (scons ⟨ kc_s , scons n ∅ ⟩ (scons m2 ∅)) ⟩ $ by and_elim_r [l18]
l21: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ kr_ntys ∈ ω $ by x1_kr_ntys
l22: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset kr_ntys $ by wcel_isset [l21]
l23: $ GG , w = ⟨ o , ra_ntys q1 q2 q3 ⟩ , w ∊ cl_ntys_cons , w = ⟨ scons (ra_ntys T n m) (scons (ra_clen_c C c) (scons (ra_add m c m2) ∅)) , ra_ntys ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ⟨ kc_s , scons n ∅ ⟩ m2 ⟩ ⇒ isset q1 $ by isset_var
