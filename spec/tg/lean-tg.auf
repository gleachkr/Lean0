l56: $ G ⇒ t5 = V5 ∧ scons t6 (scons t7 ∅) = scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons ⟨ kc_pi , scons V6 (scons V8 ∅) ⟩ ∅) $ by y1_scons_inj [l55, l14, l28, l13, l27]
