  $ ra_eta_ok A1 A2 ≐ ra_eta_ok B1 B2 $
----
l1: $ ∅ ≐ ∅ $ by ceqt_refl
l2: $ scons A2 ∅ ≐ scons B2 ∅ $ by scons_congr [#2, l1]
l3: $ scons A1 (scons A2 ∅) ≐ scons B1 (scons B2 ∅) $ by scons_congr [#1, l2]
l4: $ kr_eta_ok ≐ kr_eta_ok $ by ceqt_refl
l5: $ ra_eta_ok A1 A2 ≐ ra_eta_ok B1 B2 $ by opair_congr [l4, l3]

