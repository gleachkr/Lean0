l35: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_z ⇒ ph $ by ex_elim [l2, l34]
l36: $ GG ⇒ ph $ by wcel_elim [#1, l35]

lemma y2_cnth_e1 (GG: hyps) (q1 q2 q3 w3 u_A u_G v_A v_G: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ q3 = u_A $ > $ GG ⇒ q1 = ⟨ kc_cons , scons v_A (scons v_G ∅) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ > $ GG ⇒ w3 = v_A $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ = ⟨ kc_cons , scons v_A (scons v_G ∅) ⟩ $ by eq_trans [l1, #4]
l3: $ GG ⇒ kc_cons ∈ ω $ by v1_kc_cons
l4: $ GG ⇒ isset kc_cons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_A $ by isset_var
l6: $ GG ⇒ isset u_G $ by isset_var
l7: $ GG ⇒ isset v_A $ by isset_var
l8: $ GG ⇒ isset v_G $ by isset_var
l9: $ GG ⇒ u_A = v_A ∧ u_G = v_G $ by y2_nd2 [l2, l4, l5, l6, l7, l8]
l10: $ GG ⇒ u_A = v_A $ by and_elim_l [l9]
l11: $ GG ⇒ u_G = v_G $ by and_elim_r [l9]
l12: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = q2 $ by eq_sym [#2]
l13: $ GG ⇒ ⟨ kc_nz , ∅ ⟩ = ⟨ kc_nz , ∅ ⟩ $ by eq_trans [l12, #5]
l14: $ GG ⇒ v_A = w3 $ by eq_sym [#6]
l15: $ GG ⇒ q3 = v_A $ by eq_trans [#3, l10]
l16: $ GG ⇒ q3 = w3 $ by eq_trans [l15, l14]

lemma y2_cnth_c1 (GG: hyps) (q1 q2 q3 w3 u_A u_G: set):
  $ GG ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_A $ > $ GG ⇒ ra_cnth q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG ⇒ ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ∨ ∃ a ∃ d ∃ b ∃ e (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel) $ by lrel_cnth_cases [#2]
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by ax
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_A $ by weaken [#1]
l4: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ by and_elim_l [l3]
l5: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_A $ by and_elim_r [l3]
l6: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l5]
l7: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = u_A $ by and_elim_r [l5]
l8: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ $ by and_elim_l [l2]
l9: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a $ by and_elim_r [l2]
l10: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l9]
l11: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ w3 = a $ by and_elim_r [l9]
l12: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a ⇒ q3 = w3 $ by y2_cnth_e1 [l4, l6, l7, l8, l10, l11]
l13: $ GG , ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) $ by ax
l14: $ GG , ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l13, l12]
l15: $ GG , ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) $ by ax
l16: $ GG , ∃ a ∃ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ w3 = a) ⇒ q3 = w3 $ by ex_elim [l15, l14]
l17: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel $ by ax
l18: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_A $ by weaken [#1]
l19: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons u_A (scons u_G ∅) ⟩ $ by and_elim_l [l18]
l20: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = u_A $ by and_elim_r [l18]
l21: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l20]
l22: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q3 = u_A $ by and_elim_r [l20]
l23: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ $ by and_elim_l [l17]
l24: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel $ by and_elim_r [l17]
l25: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ q2 = ⟨ kc_s , scons e ∅ ⟩ $ by and_elim_l [l24]
l26: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ w3 = d ∧ ra_cnth b e d ∈ lrel $ by and_elim_r [l24]
l27: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ w3 = d $ by and_elim_l [l26]
l28: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ ra_cnth b e d ∈ lrel $ by and_elim_r [l26]
l29: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ kc_nz ∈ kc_s $ by y2_lt_nz_s
l30: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ w3 = d ∧ ra_cnth b e d ∈ lrel ⇒ kc_s ∈ ω $ by v1_kc_s
