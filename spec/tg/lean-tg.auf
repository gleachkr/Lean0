l9: $ GG ⇒ ∀ d ∀ e ∀ f ∀ g ∀ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l8]
l10: $ GG ⇒ ∀ b ∀ d ∀ e ∀ f ∀ g ∀ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l9]
l11: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e ∀ f ∀ g ∀ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l10]
l12: $ GG ⇒ q2 = w2 ∧ q3 = w3 $ by y2_ntys_i2 [#1, #2, l11]

lemma y2_ntys_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ntys lrel → c ∊ y2_P_ntys lrel) $
----
l1: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ c = ra_ntys x1 x2 x3 $ by ax
l2: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ o = o $ by eq_refl
l3: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ⟨ o , c ⟩ = ⟨ o , ra_ntys x1 x2 x3 ⟩ $ by opair_eq [l2, l1]
l4: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ⟨ o , c ⟩ ∈ lprog $ by ax
l5: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ lprog $ by wcel_eq_l [l3, l4]
l6: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ pr_ntys $ by lprog_ntys_pr [l5]
l7: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel $ by ax
l8: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ra_ntys x1 x6 x7 ∈ lrel $ by ax
l9: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_nil ⇒ ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_nil $ by ax
l10: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_nil ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel $ by weaken [l7]
l11: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_nil ⇒ ra_ntys x1 x6 x7 ∈ lrel $ by weaken [l8]
l12: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_nil ⇒ x2 = x6 ∧ x3 = x7 $ by y2_ntys_d1 [l9, l10, l11]
l13: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_cons ⇒ ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_cons $ by ax
l14: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_cons ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel $ by weaken [l7]
l15: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_cons ⇒ ra_ntys x1 x6 x7 ∈ lrel $ by weaken [l8]
l16: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel , ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_cons ⇒ x2 = x6 ∧ x3 = x7 $ by y2_ntys_d2 [l13, l14, l15]
l17: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_cons → x2 = x6 ∧ x3 = x7 $ by imp_intro [l16]
l18: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ ⟨ o , ra_ntys x1 x2 x3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons → x2 = x6 ∧ x3 = x7 $ by v1_cun_imp [l12, l17]
l19: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 , ra_ntys x1 x6 x7 ∈ lrel ⇒ x2 = x6 ∧ x3 = x7 $ by imp_elim [l18, l6]
l20: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 ⇒ ra_ntys x1 x6 x7 ∈ lrel → x2 = x6 ∧ x3 = x7 $ by imp_intro [l19]
l21: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 ⇒ ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7) $ by all_intro [l20]
l22: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel , c = ra_ntys x1 x2 x3 ⇒ ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7) $ by all_intro [l21]
l23: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel ⇒ c = ⟨ kr_ntys , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7) $ by imp_intro [l22]
l24: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel ⇒ ∀ x3 (c = ⟨ kr_ntys , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_intro [l23]
l25: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel ⇒ ∀ x2 ∀ x3 (c = ⟨ kr_ntys , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_intro [l24]
l26: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel ⇒ ∀ x1 ∀ x2 ∀ x3 (c = ⟨ kr_ntys , scons x1 (scons x2 (scons x3 ∅)) ⟩ → ∀ x6 ∀ x7 (⟨ kr_ntys , scons x1 (scons x6 (scons x7 ∅)) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7)) $ by all_intro [l25]
l27: $ GG , ⟨ o , c ⟩ ∈ lprog , crn o ⊆ horn lprog ∩ y2_P_ntys lrel ⇒ c ∊ y2_P_ntys lrel $ by cab_intro [l26]
l28: $ GG , ⟨ o , c ⟩ ∈ lprog ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel → c ∊ y2_P_ntys lrel $ by imp_intro [l27]
l29: $ GG ⇒ ⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ntys lrel → c ∊ y2_P_ntys lrel $ by imp_intro [l28]
l30: $ GG ⇒ ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ntys lrel → c ∊ y2_P_ntys lrel) $ by all_intro [l29]
l31: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ntys lrel → c ∊ y2_P_ntys lrel) $ by all_intro [l30]

lemma y2_ntys_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_ntys lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_ntys lrel → c ∊ y2_P_ntys lrel) $ by y2_ntys_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_ntys lrel $ by horn_ind [l1, l2]

lrel_ntys_det
-------------
l1: $ G ⇒ horn lprog ⊆ y2_P_ntys lrel $ by y2_ntys_in
l2: $ G ⇒ ra_ntys t1 u2 u3 ∈ y2_P_ntys lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u2 = v2 ∧ u3 = v3 $ by y2_ntys_ih [l2, #2]

--| The atoms of `ind_data` whose variants in `L` with the same inputs have the same outputs.
def y2_P_ind_data (L: class) (.c .x1 .x2 .x3 .x4 .x6 .x7 .x8: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_ind_data , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ L → x2 = x6 ∧ x3 = x7 ∧ x4 = x8))} $

lemma y2_ind_data_ih (GG: hyps) (q1 q2 q3 q4 w2 w3 w4: set):
  $ GG ⇒ ra_ind_data q1 q2 q3 q4 ∈ y2_P_ind_data lrel $ > $ GG ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ c ∊ y2_P_ind_data lrel $ by ax
l2: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_ind_data , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons x1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by cab_elim [l1]
l3: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_ind_data , scons q1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons q1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → x2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by all_elim [l2]
l4: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x3 ∀ x4 (c = ⟨ kr_ind_data , scons q1 (scons q2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons q1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → q2 = x6 ∧ x3 = x7 ∧ x4 = x8)) $ by all_elim [l3]
l5: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x4 (c = ⟨ kr_ind_data , scons q1 (scons q2 (scons q3 (scons x4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons q1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7 ∧ x4 = x8)) $ by all_elim [l4]
l6: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ c = ⟨ kr_ind_data , scons q1 (scons q2 (scons q3 (scons q4 ∅))) ⟩ → ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons q1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7 ∧ q4 = x8) $ by all_elim [l5]
l7: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ c = ra_ind_data q1 q2 q3 q4 $ by ax
l8: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x6 ∀ x7 ∀ x8 (⟨ kr_ind_data , scons q1 (scons x6 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → q2 = x6 ∧ q3 = x7 ∧ q4 = x8) $ by imp_elim [l6, l7]
l9: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x7 ∀ x8 (⟨ kr_ind_data , scons q1 (scons w2 (scons x7 (scons x8 ∅))) ⟩ ∈ lrel → q2 = w2 ∧ q3 = x7 ∧ q4 = x8) $ by all_elim [l8]
l10: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ∀ x8 (⟨ kr_ind_data , scons q1 (scons w2 (scons w3 (scons x8 ∅))) ⟩ ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = x8) $ by all_elim [l9]
l11: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel → q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by all_elim [l10]
l12: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ ra_ind_data q1 w2 w3 w4 ∈ lrel $ by weaken [#2]
l13: $ GG , c = ra_ind_data q1 q2 q3 q4 , c ∊ y2_P_ind_data lrel ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by imp_elim [l11, l12]
l14: $ GG ⇒ q2 = w2 ∧ q3 = w3 ∧ q4 = w4 $ by wcel_elim [#1, l13]

lemma y2_ind_data_ihc (GG: hyps) (Q1 Q2 Q3 Q4 W2 W3 W4: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset Q4 $ > $ GG ⇒ isset W2 $ > $ GG ⇒ isset W3 $ > $ GG ⇒ isset W4 $ > $ GG ⇒ ra_ind_data Q1 Q2 Q3 Q4 ∈ y2_P_ind_data lrel $ > $ GG ⇒ ra_ind_data Q1 W2 W3 W4 ∈ lrel $ > $ GG ⇒ Q2 = W2 ∧ Q3 = W3 ∧ Q4 = W4 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W2 , g = W3 , h = W4 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W2 , g = W3 , h = W4 ⇒ b = Q2 $ by ax
