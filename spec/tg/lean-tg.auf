l10: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_badd t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_badd y z u) ∅ , ra_badd ⟨ kc_bd0 , scons y ∅ ⟩ ⟨ kc_bd0 , scons z ∅ ⟩ ⟨ kc_bd0 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) $ by ex_elim [l11, l10]
