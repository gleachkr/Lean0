lemma y1_o_iargs (G: hyps) {k_v X m_v A a_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ pr_iargs $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) ∨ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s $ by ax
l2: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by y1_d_iargs_s [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s → ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s $ by ax
l6: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∨ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z $ by ax
l8: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) $ by y1_d_iargs_z [l7, l8]
l10: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) ∨ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s $ by ax
l12: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s → ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_s ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) ∨ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) ∨ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_iargs t1 t2 t3 t4 ⟩ ∈ cl_iargs_z ∪ cl_iargs_s → ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) ∨ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ k_v ∃ X (t1 = k_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = X ∧ t4 = X) ∨ ∃ k_v ∃ m_v ∃ X ∃ A ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_s , scons m_v ∅ ⟩ ∧ t3 = X ∧ t4 = ⟨ kc_app , scons A (scons a_v ∅) ⟩ ∧ ra_iargs k_v m_v X A ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_indapp_i (G: hyps) {D n_v np d_v j_v k_v t_v m_v na X A: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11: set):
  $ G ⇒ ⟨ pp , ra_indapp t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_spine ⟨ kc_bvar , scons V7 ∅ ⟩ V11 V9) (scons (ra_add V4 V3 V6) (scons (ra_add V6 V5 V7) (scons (ra_le ⟨ kc_s , scons V5 ∅ ⟩ V2) (scons (ra_pargs ⟨ kc_bvar , scons V7 ∅ ⟩ V4 V3 V10) (scons (ra_nidx V1 V5 V8) (scons (ra_iargs V6 V8 V10 V11) ∅)))))) , ra_indapp V1 V2 V3 V4 V11 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ k_v ∃ t_v ∃ m_v ∃ na ∃ X ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_spine ⟨ kc_bvar , scons t_v ∅ ⟩ A na ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_add k_v j_v t_v ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np X ∈ lrel ∧ ra_nidx D j_v m_v ∈ lrel ∧ ra_iargs k_v m_v X A ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_spine ⟨ kc_bvar , scons V7 ∅ ⟩ V11 V9) (scons (ra_add V4 V3 V6) (scons (ra_add V6 V5 V7) (scons (ra_le ⟨ kc_s , scons V5 ∅ ⟩ V2) (scons (ra_pargs ⟨ kc_bvar , scons V7 ∅ ⟩ V4 V3 V10) (scons (ra_nidx V1 V5 V8) (scons (ra_iargs V6 V8 V10 V11) ∅)))))) , ra_indapp V1 V2 V3 V4 V11 V5 ⟩ = ⟨ pp , ra_indapp t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_spine ⟨ kc_bvar , scons V7 ∅ ⟩ V11 V9) (scons (ra_add V4 V3 V6) (scons (ra_add V6 V5 V7) (scons (ra_le ⟨ kc_s , scons V5 ∅ ⟩ V2) (scons (ra_pargs ⟨ kc_bvar , scons V7 ∅ ⟩ V4 V3 V10) (scons (ra_nidx V1 V5 V8) (scons (ra_iargs V6 V8 V10 V11) ∅))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_indapp t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_indapp V1 V2 V3 V4 V11 V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_spine ⟨ kc_bvar , scons V7 ∅ ⟩ V11 V9) (scons (ra_add V4 V3 V6) (scons (ra_add V6 V5 V7) (scons (ra_le ⟨ kc_s , scons V5 ∅ ⟩ V2) (scons (ra_pargs ⟨ kc_bvar , scons V7 ∅ ⟩ V4 V3 V10) (scons (ra_nidx V1 V5 V8) (scons (ra_iargs V6 V8 V10 V11) ∅)))))) ∧ ra_indapp t1 t2 t3 t4 t5 t6 = ra_indapp V1 V2 V3 V4 V11 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_spine ⟨ kc_bvar , scons V7 ∅ ⟩ V11 V9) (scons (ra_add V4 V3 V6) (scons (ra_add V6 V5 V7) (scons (ra_le ⟨ kc_s , scons V5 ∅ ⟩ V2) (scons (ra_pargs ⟨ kc_bvar , scons V7 ∅ ⟩ V4 V3 V10) (scons (ra_nidx V1 V5 V8) (scons (ra_iargs V6 V8 V10 V11) ∅)))))) $ by and_elim_l [l6]
l8: $ G ⇒ ra_indapp t1 t2 t3 t4 t5 t6 = ra_indapp V1 V2 V3 V4 V11 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V5 $ by isset_var
l23: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset V11 $ by isset_var
l25: $ G ⇒ scons V11 (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V4 $ by isset_var
l27: $ G ⇒ scons V4 (scons V11 (scons V5 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V3 $ by isset_var
l29: $ G ⇒ scons V3 (scons V4 (scons V11 (scons V5 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V11 (scons V5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V11 (scons V5 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
