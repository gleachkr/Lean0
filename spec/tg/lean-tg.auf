l7: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ p $ by bot_elim [l6]
l8: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ → p $ by imp_intro [l7]

lemma v1_take_le_blk (G: hyps) (c k a: set) (p: fml):
  $ G , c = kc_le_blk ∧ a = ∅ ⇒ p $ > $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ → p $
----
l1: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ $ by ax
l2: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ c = kc_le_blk ∧ k = ks_blk ∧ a = ∅ $ by v1_ent_le_blk [l1]
l3: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ c = kc_le_blk $ by and_elim_l [l2]
l4: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ k = ks_blk ∧ a = ∅ $ by and_elim_r [l2]
l5: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ a = ∅ $ by and_elim_r [l4]
l6: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ c = kc_le_blk ∧ a = ∅ $ by and_intro [l3, l5]
l7: $ G , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ ⇒ p $ by cut [l6, #1]
l8: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ csn ⟨ kc_le_blk , ⟨ ks_blk , ∅ ⟩ ⟩ → p $ by imp_intro [l7]

--| The cases of sort `nat`.
def v1_d_nat {x: set} (t: set): fml = $ (t = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $

lemma v1_node_nat (G: hyps) {x: set} (c k a b t: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ > $ G ⇒ k = ks_nat $ > $ G ⇒ b ∊ fseq (trees ω) $ >
  $ G ⇒ cdm b = cdm a $ > $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G ⇒ v1_d_nat x t $
----
l1: $ G ⇒ ks_nat ∈ ks_lvl $ by v1_lt_nat_lvl
l2: $ G ⇒ k = ks_lvl → ⊥ $ by v1_ne_lt [#2, l1]
l3: $ G ⇒ ks_nat ∈ ks_lvls $ by v1_lt_nat_lvls
l4: $ G ⇒ k = ks_lvls → ⊥ $ by v1_ne_lt [#2, l3]
l5: $ G ⇒ ks_nat ∈ ks_expr $ by v1_lt_nat_expr
l6: $ G ⇒ k = ks_expr → ⊥ $ by v1_ne_lt [#2, l5]
l7: $ G ⇒ ks_nat ∈ ks_atom $ by v1_lt_nat_atom
l8: $ G ⇒ k = ks_atom → ⊥ $ by v1_ne_lt [#2, l7]
l9: $ G ⇒ ks_nat ∈ ks_ctx $ by v1_lt_nat_ctx
l10: $ G ⇒ k = ks_ctx → ⊥ $ by v1_ne_lt [#2, l9]
l11: $ G ⇒ ks_nat ∈ ks_bin $ by v1_lt_nat_bin
l12: $ G ⇒ k = ks_bin → ⊥ $ by v1_ne_lt [#2, l11]
l13: $ G ⇒ ks_nat ∈ ks_blk $ by v1_lt_nat_blk
l14: $ G ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [#2, l13]
l15: $ G ⇒ ks_nat ∈ ks_ind $ by v1_lt_nat_ind
l16: $ G ⇒ k = ks_ind → ⊥ $ by v1_ne_lt [#2, l15]
l17: $ G ⇒ ks_nat ∈ ks_tys $ by v1_lt_nat_tys
l18: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_lt [#2, l17]
l19: $ G ⇒ ks_nat ∈ ks_ctors $ by v1_lt_nat_ctors
l20: $ G ⇒ k = ks_ctors → ⊥ $ by v1_ne_lt [#2, l19]
l21: $ G ⇒ ks_nat ∈ ω $ by v1_ks_nat
l22: $ G ⇒ isset ks_nat $ by wcel_isset [l21]
l23: $ G , (t = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ⇒ (t = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by ax
l24: $ G ⇒ ((t = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_nat x t $ by imp_intro [l23]
l25: $ G ⇒ (t = ⟨ kc_nz , ∅ ⟩) → v1_d_nat x t $ by v1_imp_or_l [l24]
l26: $ G ⇒ (∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_nat x t $ by v1_imp_or_r [l24]
l27: $ G , c = kc_nz ∧ a = ∅ ⇒ (t = ⟨ kc_nz , ∅ ⟩) $ by v1_build0 [#3, #4, #6]
l28: $ G , c = kc_nz ∧ a = ∅ ⇒ (t = ⟨ kc_nz , ∅ ⟩) → v1_d_nat x t $ by weaken [l25]
l29: $ G , c = kc_nz ∧ a = ∅ ⇒ v1_d_nat x t $ by imp_elim [l28, l27]
l30: $ G , c = kc_s ∧ a = scons ks_nat ∅ ⇒ ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $ by v1_build1 [l22, #3, #4, #5, #6]
l31: $ G , c = kc_s ∧ a = scons ks_nat ∅ ⇒ (∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat)) → v1_d_nat x t $ by weaken [l26]
l32: $ G , c = kc_s ∧ a = scons ks_nat ∅ ⇒ v1_d_nat x t $ by imp_elim [l31, l30]
l33: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_le_blk → v1_d_nat x t $ by v1_skip_le_blk [l14]
l34: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_choice_atom → v1_d_nat x t $ by v1_skip_choice_atom [l8, l33]
l35: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_nonempty_blk → v1_d_nat x t $ by v1_skip_nonempty_blk [l14, l34]
l36: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_quot_sound_atom → v1_d_nat x t $ by v1_skip_quot_sound_atom [l8, l35]
l37: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_propext_atom → v1_d_nat x t $ by v1_skip_propext_atom [l8, l36]
l38: $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ v1_tl_iff_blk → v1_d_nat x t $ by v1_skip_iff_blk [l14, l37]
