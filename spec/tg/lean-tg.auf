----
l1: $ G ⇒ ks_nat ∈ ω $ by v1_ks_nat
l2: $ G ⇒ isset ks_nat $ by wcel_isset [l1]
l3: $ G ⇒ ks_nat ∈ ks_lvl $ by v1_in_suc [l2]

