l20: $ G ⇒ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $ by wcel_elim [#1, l19]

lemma y1_o_lift (G: hyps) {n_v k_v i_v j_v l_v f_v a_v f2 a2 A b_v A2 b2 e_v e2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ pr_lift $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨ ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨ ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj ⇒ ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj $ by ax
l2: $ G , ⟨ pp , ra_lift t1 t2 t3 t4 ⟩ ∈ cl_lift_proj ⇒ crn pp ⊆ lrel $ by weaken [#2]
