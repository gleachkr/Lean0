l42: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_baddc V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ c_v (t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_baddc V1 V2 c_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_baddc V1 b_v c_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $ by ex_intro [l44]

