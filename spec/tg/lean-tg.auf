l30: $ G ⇒ isset V6 $ by isset_var
l31: $ G ⇒ scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l30, l29]
