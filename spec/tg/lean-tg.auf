lemma y1_k_lift_bvar_lt (G: hyps): $ G ⇒ cl_lift_bvar_lt ⊆ y1_lab kr_lift (suc kr_lift) $
----
l1: $ G , x ∊ cl_lift_bvar_lt ⇒ x ∊ cl_lift_bvar_lt $ by ax
l2: $ G , x ∊ cl_lift_bvar_lt ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ kr_lift ∈ ω $ by x1_kr_lift
l5: $ G , x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_le ⟨ kc_s , scons u ∅ ⟩ z) ∅ , ra_lift y z ⟨ kc_bvar , scons u ∅ ⟩ ⟨ kc_bvar , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_lift_bvar_lt ⇒ x ∊ y1_lab kr_lift (suc kr_lift) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_lift_bvar_lt ⊆ y1_lab kr_lift (suc kr_lift) $ by subset_intro [l10]

