l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons ⟨ kc_pi , scons V6 (scons V7 ∅) ⟩ (scons V5 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_recfield ∈ ω $ by x1_kr_recfield
