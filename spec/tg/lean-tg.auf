l29: $ G ⇒ ∃ i_v ∃ D ∃ j_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ t3 = A ∧ t4 = A) ∨ ∃ i_v ∃ D ∃ j_v ∃ c_v ∃ A (t1 = i_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ t3 = A ∧ t4 = A) ∨ ∃ i_v ∃ S ∃ a_v ∃ A ∃ A1 ∃ R (t1 = i_v ∧ t2 = ⟨ kc_app , scons S (scons a_v ∅) ⟩ ∧ t3 = A ∧ t4 = R ∧ ra_pinst ⟨ kc_s , scons i_v ∅ ⟩ S A A1 ∈ lrel ∧ ra_inst i_v A1 a_v R ∈ lrel) $ by imp_elim [l28, #1]

lemma y1_e_sinst_done (G: hyps) {D n_v k_v e_v: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_sinst V1 V2 V2 V3 V4 V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_sinst V1 V2 V2 V3 V4 V4 ⟩ = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_sinst t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_sinst V1 V2 V2 V3 V4 V4) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_sinst t1 t2 t3 t4 t5 t6 = ra_sinst V1 V2 V2 V3 V4 V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 = ra_sinst V1 V2 V2 V3 V4 V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V4 $ by isset_var
l23: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ scons V4 (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l22, l23]
l25: $ G ⇒ isset V3 $ by isset_var
l26: $ G ⇒ scons V3 (scons V4 (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l25, l24]
l27: $ G ⇒ isset V2 $ by isset_var
l28: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V4 ∅))) ∈ fseq y1_vv $ by y1_fs [l27, l26]
l29: $ G ⇒ scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))) ∈ fseq y1_vv $ by y1_fs [l27, l28]
l30: $ G ⇒ isset V1 $ by isset_var
l31: $ G ⇒ scons V1 (scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅))))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ kr_sinst ∈ ω $ by x1_kr_sinst
l33: $ G ⇒ isset kr_sinst $ by wcel_isset [l32]
l34: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l35: $ G ⇒ isset (scons V1 (scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))))) $ by wcel_isset [l31]
l36: $ G ⇒ kr_sinst = kr_sinst ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅))))) $ by opair_inj_c [l8, l33, l34, l33, l35]
l37: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅))))) $ by and_elim_r [l36]
l38: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))) $ by y1_scons_inj [l37, l20, l30, l19, l29]
l39: $ G ⇒ t1 = V1 $ by and_elim_l [l38]
l40: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V2 (scons V3 (scons V4 (scons V4 ∅)))) $ by and_elim_r [l38]
l41: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V2 (scons V3 (scons V4 (scons V4 ∅))) $ by y1_scons_inj [l40, l18, l27, l17, l28]
l42: $ G ⇒ t2 = V2 $ by and_elim_l [l41]
l43: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V2 (scons V3 (scons V4 (scons V4 ∅))) $ by and_elim_r [l41]
l44: $ G ⇒ t3 = V2 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons V4 (scons V4 ∅)) $ by y1_scons_inj [l43, l16, l27, l15, l26]
l45: $ G ⇒ t3 = V2 $ by and_elim_l [l44]
l46: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V3 (scons V4 (scons V4 ∅)) $ by and_elim_r [l44]
l47: $ G ⇒ t4 = V3 ∧ scons t5 (scons t6 ∅) = scons V4 (scons V4 ∅) $ by y1_scons_inj [l46, l14, l25, l13, l24]
l48: $ G ⇒ t4 = V3 $ by and_elim_l [l47]
l49: $ G ⇒ scons t5 (scons t6 ∅) = scons V4 (scons V4 ∅) $ by and_elim_r [l47]
l50: $ G ⇒ t5 = V4 ∧ scons t6 ∅ = scons V4 ∅ $ by y1_scons_inj [l49, l12, l22, l11, l23]
l51: $ G ⇒ t5 = V4 $ by and_elim_l [l50]
l52: $ G ⇒ scons t6 ∅ = scons V4 ∅ $ by and_elim_r [l50]
l53: $ G ⇒ t6 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l52, l10, l22, l9, l9]
l54: $ G ⇒ t6 = V4 $ by and_elim_l [l53]
l55: $ G ⇒ t5 = V4 ∧ t6 = V4 $ by and_intro [l51, l54]
l56: $ G ⇒ t4 = V3 ∧ t5 = V4 ∧ t6 = V4 $ by and_intro [l48, l55]
l57: $ G ⇒ t3 = V2 ∧ t4 = V3 ∧ t5 = V4 ∧ t6 = V4 $ by and_intro [l45, l56]
l58: $ G ⇒ t2 = V2 ∧ t3 = V2 ∧ t4 = V3 ∧ t5 = V4 ∧ t6 = V4 $ by and_intro [l42, l57]
l59: $ G ⇒ t1 = V1 ∧ t2 = V2 ∧ t3 = V2 ∧ t4 = V3 ∧ t5 = V4 ∧ t6 = V4 $ by and_intro [l39, l58]
l60: $ G ⇒ ∃ e_v (t1 = V1 ∧ t2 = V2 ∧ t3 = V2 ∧ t4 = V3 ∧ t5 = e_v ∧ t6 = e_v) $ by ex_intro [l59]
l61: $ G ⇒ ∃ k_v ∃ e_v (t1 = V1 ∧ t2 = V2 ∧ t3 = V2 ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_intro [l60]
l62: $ G ⇒ ∃ n_v ∃ k_v ∃ e_v (t1 = V1 ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_intro [l61]
l63: $ G ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_intro [l62]

lemma y1_d_sinst_done (G: hyps) {D n_v k_v e_v: set} (pp t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ ∈ cl_sinst_done $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $
----
l1: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_sinst_done ⇒ x ∊ cl_sinst_done $ by ax
l2: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_sinst_done ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ x = ⟨ ∅ , ra_sinst y z z u v v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ ∅ , ra_sinst y z z u v v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by y1_e_sinst_done [l6, l7]
l9: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ , x ∊ cl_sinst_done ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ D ∃ n_v ∃ k_v ∃ e_v (t1 = D ∧ t2 = n_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e_v) $ by wcel_elim [#1, l15]

lemma y1_e_sinst_step (G: hyps) {D j_v n_v k_v e_v e1 e2: set} (pp t1 t2 t3 t4 t5 t6 V1 V2 V3 V4 V5 V6 V7: set):
  $ G ⇒ ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ = ⟨ scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅)) , ra_sinst V1 V2 V3 V4 V5 V7 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ j_v ∃ n_v ∃ k_v ∃ e_v ∃ e1 ∃ e2 (t1 = D ∧ t2 = j_v ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = e_v ∧ t6 = e2 ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_inst k_v e_v ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e1 ∈ lrel ∧ ra_sinst D ⟨ kc_s , scons j_v ∅ ⟩ n_v k_v e1 e2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅)) , ra_sinst V1 V2 V3 V4 V5 V7 ⟩ = ⟨ pp , ra_sinst t1 t2 t3 t4 t5 t6 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_sinst t1 t2 t3 t4 t5 t6) $ by opair_isset
l5: $ G ⇒ isset (ra_sinst V1 V2 V3 V4 V5 V7) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅)) ∧ ra_sinst t1 t2 t3 t4 t5 t6 = ra_sinst V1 V2 V3 V4 V5 V7 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_le ⟨ kc_s , scons V2 ∅ ⟩ V3) (scons (ra_inst V4 V5 ⟨ kc_ind_ty , scons V1 (scons V2 ∅) ⟩ V6) (scons (ra_sinst V1 ⟨ kc_s , scons V2 ∅ ⟩ V3 V4 V6 V7) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 = ra_sinst V1 V2 V3 V4 V5 V7 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t6 $ by isset_var
l11: $ G ⇒ scons t6 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t5 $ by isset_var
l13: $ G ⇒ scons t5 (scons t6 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t4 $ by isset_var
l15: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t3 $ by isset_var
l17: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t2 $ by isset_var
l19: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset t1 $ by isset_var
l21: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset V7 $ by isset_var
l23: $ G ⇒ scons V7 ∅ ∈ fseq y1_vv $ by y1_fs [l22, l9]
l24: $ G ⇒ isset V5 $ by isset_var
l25: $ G ⇒ scons V5 (scons V7 ∅) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ isset V4 $ by isset_var
l27: $ G ⇒ scons V4 (scons V5 (scons V7 ∅)) ∈ fseq y1_vv $ by y1_fs [l26, l25]
l28: $ G ⇒ isset V3 $ by isset_var
l29: $ G ⇒ scons V3 (scons V4 (scons V5 (scons V7 ∅))) ∈ fseq y1_vv $ by y1_fs [l28, l27]
l30: $ G ⇒ isset V2 $ by isset_var
l31: $ G ⇒ scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅)))) ∈ fseq y1_vv $ by y1_fs [l30, l29]
l32: $ G ⇒ isset V1 $ by isset_var
l33: $ G ⇒ scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅))))) ∈ fseq y1_vv $ by y1_fs [l32, l31]
l34: $ G ⇒ kr_sinst ∈ ω $ by x1_kr_sinst
l35: $ G ⇒ isset kr_sinst $ by wcel_isset [l34]
l36: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))))) $ by wcel_isset [l21]
l37: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅)))))) $ by wcel_isset [l33]
l38: $ G ⇒ kr_sinst = kr_sinst ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅))))) $ by opair_inj_c [l8, l35, l36, l35, l37]
l39: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅))))) $ by and_elim_r [l38]
l40: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅)))) $ by y1_scons_inj [l39, l20, l32, l19, l31]
l41: $ G ⇒ t1 = V1 $ by and_elim_l [l40]
l42: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 ∅)))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V7 ∅)))) $ by and_elim_r [l40]
l43: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V3 (scons V4 (scons V5 (scons V7 ∅))) $ by y1_scons_inj [l42, l18, l30, l17, l29]
l44: $ G ⇒ t2 = V2 $ by and_elim_l [l43]
l45: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 ∅))) = scons V3 (scons V4 (scons V5 (scons V7 ∅))) $ by and_elim_r [l43]
l46: $ G ⇒ t3 = V3 ∧ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons V5 (scons V7 ∅)) $ by y1_scons_inj [l45, l16, l28, l15, l27]
l47: $ G ⇒ t3 = V3 $ by and_elim_l [l46]
l48: $ G ⇒ scons t4 (scons t5 (scons t6 ∅)) = scons V4 (scons V5 (scons V7 ∅)) $ by and_elim_r [l46]
l49: $ G ⇒ t4 = V4 ∧ scons t5 (scons t6 ∅) = scons V5 (scons V7 ∅) $ by y1_scons_inj [l48, l14, l26, l13, l25]
l50: $ G ⇒ t4 = V4 $ by and_elim_l [l49]
l51: $ G ⇒ scons t5 (scons t6 ∅) = scons V5 (scons V7 ∅) $ by and_elim_r [l49]
l52: $ G ⇒ t5 = V5 ∧ scons t6 ∅ = scons V7 ∅ $ by y1_scons_inj [l51, l12, l24, l11, l23]
l53: $ G ⇒ t5 = V5 $ by and_elim_l [l52]
l54: $ G ⇒ scons t6 ∅ = scons V7 ∅ $ by and_elim_r [l52]
