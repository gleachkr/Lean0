lemma y1_d_iota_eq_i (G: hyps) {D i_v c_v v_v np n_v m_v a0 ar nf X Dl res e3 e4 c1 maj Rh rhs0 rhs T: set} (pp t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_iota_eq_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_iota_eq_i ⇒ x ∊ cl_iota_eq_i $ by ax
l2: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x ∊ cl_iota_eq_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ ⇒ x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ ⇒ ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ ⇒ x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ ⇒ ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩ ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $ by y1_e_iota_eq_i [l6, l7]
l9: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) ⇒ ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ o ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) ⇒ ∃ o ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_iota_eq t1 t2 t3 t4 t5 t6 t7 t8 ⟩ , ∃ o ∃ p (x = ⟨ scons (ra_iota_tel y v z u i k g j) (scons (ra_iota_lhs y v z u g k d h l e p) (scons (ra_rec_rhs y v z u m) (scons (ra_ind_arity y w a b) (scons (ra_add w a c) (scons (ra_add c b f) (scons (ra_rehead ⟨ kc_ind_rec , scons y (scons z (scons v ∅)) ⟩ m f d n) (scons (ra_rehead h n g l o) ∅))))))) , ra_iota_eq y z u v j ⟨ kc_app , scons e (scons l ∅) ⟩ o p ⟩) ⇒ ∃ D ∃ i_v ∃ c_v ∃ v_v ∃ np ∃ n_v ∃ m_v ∃ a0 ∃ ar ∃ nf ∃ X ∃ Dl ∃ res ∃ e3 ∃ e4 ∃ c1 ∃ maj ∃ Rh ∃ rhs0 ∃ rhs ∃ T (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = v_v ∧ t5 = Dl ∧ t6 = ⟨ kc_app , scons e4 (scons maj ∅) ⟩ ∧ t7 = rhs ∧ t8 = T ∧ ra_iota_tel D v_v i_v c_v X res nf Dl ∈ lrel ∧ ra_iota_lhs D v_v i_v c_v nf res e3 c1 maj e4 T ∈ lrel ∧ ra_rec_rhs D v_v i_v c_v Rh ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_add np n_v a0 ∈ lrel ∧ ra_add a0 m_v ar ∈ lrel ∧ ra_rehead ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ Rh ar e3 rhs0 ∈ lrel ∧ ra_rehead c1 rhs0 nf maj rhs ∈ lrel) $ by ex_elim [l11, l10]
