l13: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ isset (ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩) $ by opair_isset
l14: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ o = scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ ∧ ra_pargs q1 q2 q3 q4 = ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ $ by opair_inj_c [l6, l7, l8, l12, l13]
l15: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ o = scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ $ by and_elim_l [l14]
l16: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_s , w = ⟨ scons (ra_pargs X ⟨ kc_s , scons d ∅ ⟩ n e) ∅ , ra_pargs X d ⟨ kc_s , scons n ∅ ⟩ ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ⟩ ⇒ ⟨ kr_pargs , scons q1 (scons q2 (scons q3 (scons q4 ∅))) ⟩ = ⟨ kr_pargs , scons X (scons d (scons ⟨ kc_s , scons n ∅ ⟩ (scons ⟨ kc_app , scons e (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∅))) ⟩ $ by and_elim_r [l14]
