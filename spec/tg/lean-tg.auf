l28: $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ ∈ cl_rwalk_pi_nr ∪ (cl_rwalk_pi_rec ∪ cl_rwalk_res) → ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_intro [l27]
l29: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) ∨ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $ by imp_elim [l28, #1]

lemma y1_e_rec_rhs_i (G: hyps) {D b_v P T v_v i_v c_v np n_v m_v k_v nf a_v mk M N F K Acc Val R1 R2 R C: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20 V21 V22 V23 V24: set):
  $ G ⇒ ⟨ pp , ra_rec_rhs t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V15) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V16) (scons (ra_nth_ty V4 V6 V17 V24) (scons (ra_nth_ctor V24 V7 V18) (scons (ra_minor_idx V4 V6 V7 V11) (scons (ra_npis V18 V12) (scons (ra_add V12 V10 V13) (scons (ra_add V14 ⟨ kc_s , scons V11 ∅ ⟩ V13) (scons (ra_pargs ⟨ kc_bvar , scons V14 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V19) (scons (ra_rwalk V1 V8 V9 V10 V5 V12 ⟨ kc_nz , ∅ ⟩ V19 V18 V20) (scons (ra_lams V16 V20 V21) (scons (ra_lams V15 V21 V22) (scons (ra_lams V3 V22 V23) ∅))))))))))))))) , ra_rec_rhs V1 V5 V6 V7 V23 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ nf ∃ a_v ∃ mk ∃ M ∃ N ∃ F ∃ K ∃ Acc ∃ Val ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add mk ⟨ kc_s , scons k_v ∅ ⟩ a_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ nf Acc ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_nz , ∅ ⟩ Acc K Val ∈ lrel ∧ ra_lams N Val R1 ∈ lrel ∧ ra_lams M R1 R2 ∈ lrel ∧ ra_lams P R2 R ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V15) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V16) (scons (ra_nth_ty V4 V6 V17 V24) (scons (ra_nth_ctor V24 V7 V18) (scons (ra_minor_idx V4 V6 V7 V11) (scons (ra_npis V18 V12) (scons (ra_add V12 V10 V13) (scons (ra_add V14 ⟨ kc_s , scons V11 ∅ ⟩ V13) (scons (ra_pargs ⟨ kc_bvar , scons V14 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V19) (scons (ra_rwalk V1 V8 V9 V10 V5 V12 ⟨ kc_nz , ∅ ⟩ V19 V18 V20) (scons (ra_lams V16 V20 V21) (scons (ra_lams V15 V21 V22) (scons (ra_lams V3 V22 V23) ∅))))))))))))))) , ra_rec_rhs V1 V5 V6 V7 V23 ⟩ = ⟨ pp , ra_rec_rhs t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_clen V3 V8) (scons (ra_ntys V4 V9 V10) (scons (ra_motives V1 V8 V5 ⟨ kc_nz , ∅ ⟩ V4 V15) (scons (ra_minors V1 V8 V9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V4 V16) (scons (ra_nth_ty V4 V6 V17 V24) (scons (ra_nth_ctor V24 V7 V18) (scons (ra_minor_idx V4 V6 V7 V11) (scons (ra_npis V18 V12) (scons (ra_add V12 V10 V13) (scons (ra_add V14 ⟨ kc_s , scons V11 ∅ ⟩ V13) (scons (ra_pargs ⟨ kc_bvar , scons V14 ∅ ⟩ ⟨ kc_nz , ∅ ⟩ V12 V19) (scons (ra_rwalk V1 V8 V9 V10 V5 V12 ⟨ kc_nz , ∅ ⟩ V19 V18 V20) (scons (ra_lams V16 V20 V21) (scons (ra_lams V15 V21 V22) (scons (ra_lams V3 V22 V23) ∅)))))))))))))))) $ by y1_opair_set_l [l1]
