l44: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))))) $ by wcel_isset [l25]
l45: $ G ⇒ isset (scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅)))))))) $ by wcel_isset [l41]
l46: $ G ⇒ kr_rtail = kr_rtail ∧ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))))))) $ by opair_inj_c [l8, l43, l44, l43, l45]
l47: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))))) = scons V1 (scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))))))) $ by and_elim_r [l46]
l48: $ G ⇒ t1 = V1 ∧ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅)))))) $ by y1_scons_inj [l47, l24, l40, l23, l39]
l49: $ G ⇒ t1 = V1 $ by and_elim_l [l48]
l50: $ G ⇒ scons t2 (scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅)))))) = scons V2 (scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅)))))) $ by and_elim_r [l48]
l51: $ G ⇒ t2 = V2 ∧ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))))) $ by y1_scons_inj [l50, l22, l38, l21, l37]
l52: $ G ⇒ t2 = V2 $ by and_elim_l [l51]
l53: $ G ⇒ scons t3 (scons t4 (scons t5 (scons t6 (scons t7 (scons t8 ∅))))) = scons V3 (scons V4 (scons V5 (scons V6 (scons ⟨ kc_srt , scons V10 ∅ ⟩ (scons ⟨ kc_pi , scons V12 (scons ⟨ kc_app , scons V13 (scons ⟨ kc_bvar , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ∅) ⟩ ∅) ⟩ ∅))))) $ by and_elim_r [l51]
