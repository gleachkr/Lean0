l55: $ G , x = ⟨ pp , ra_rec_rhs t1 t2 t3 t4 t5 ⟩ , x ∊ cl_rec_rhs_i ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ nf ∃ a_v ∃ mk ∃ M ∃ N ∃ F ∃ K ∃ Acc ∃ Val ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add mk ⟨ kc_s , scons k_v ∅ ⟩ a_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ nf Acc ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_nz , ∅ ⟩ Acc K Val ∈ lrel ∧ ra_lams N Val R1 ∈ lrel ∧ ra_lams M R1 R2 ∈ lrel ∧ ra_lams P R2 R ∈ lrel) $ by ex_elim [l2, l54]
l56: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ nf ∃ a_v ∃ mk ∃ M ∃ N ∃ F ∃ K ∃ Acc ∃ Val ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add mk ⟨ kc_s , scons k_v ∅ ⟩ a_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ nf Acc ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_nz , ∅ ⟩ Acc K Val ∈ lrel ∧ ra_lams N Val R1 ∈ lrel ∧ ra_lams M R1 R2 ∈ lrel ∧ ra_lams P R2 R ∈ lrel) $ by wcel_elim [#1, l55]

lemma y1_o_rec_rhs (G: hyps) {D b_v P T v_v i_v c_v np n_v m_v k_v nf a_v mk M N F K Acc Val R1 R2 R C: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_rec_rhs t1 t2 t3 t4 t5 ⟩ ∈ pr_rec_rhs $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ nf ∃ a_v ∃ mk ∃ M ∃ N ∃ F ∃ K ∃ Acc ∃ Val ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add mk ⟨ kc_s , scons k_v ∅ ⟩ a_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ nf Acc ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_nz , ∅ ⟩ Acc K Val ∈ lrel ∧ ra_lams N Val R1 ∈ lrel ∧ ra_lams M R1 R2 ∈ lrel ∧ ra_lams P R2 R ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ k_v ∃ nf ∃ a_v ∃ mk ∃ M ∃ N ∃ F ∃ K ∃ Acc ∃ Val ∃ R1 ∃ R2 ∃ R ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_npis K nf ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add mk ⟨ kc_s , scons k_v ∅ ⟩ a_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons mk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ nf Acc ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_nz , ∅ ⟩ Acc K Val ∈ lrel ∧ ra_lams N Val R1 ∈ lrel ∧ ra_lams M R1 R2 ∈ lrel ∧ ra_lams P R2 R ∈ lrel) $ by y1_d_rec_rhs_i [#1, #2]

lemma y1_e_struct_like_i (G: hyps) {D b_v P T j_v F K l_v: set} (pp t1 t2 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_struct_like t1 t2 ⟩ = ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)) , ra_struct_like V1 V5 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = D ∧ t2 = j_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)) , ra_struct_like V1 V5 ⟩ = ⟨ pp , ra_struct_like t1 t2 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_struct_like t1 t2) $ by opair_isset
l5: $ G ⇒ isset (ra_struct_like V1 V5) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)) ∧ ra_struct_like t1 t2 = ra_struct_like V1 V5 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_struct_like t1 t2 = ra_struct_like V1 V5 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t2 $ by isset_var
l11: $ G ⇒ scons t2 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t1 $ by isset_var
l13: $ G ⇒ scons t1 (scons t2 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset V5 $ by isset_var
l15: $ G ⇒ scons V5 ∅ ∈ fseq y1_vv $ by y1_fs [l14, l9]
l16: $ G ⇒ isset V1 $ by isset_var
l17: $ G ⇒ scons V1 (scons V5 ∅) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ kr_struct_like ∈ ω $ by x1_kr_struct_like
l19: $ G ⇒ isset kr_struct_like $ by wcel_isset [l18]
l20: $ G ⇒ isset (scons t1 (scons t2 ∅)) $ by wcel_isset [l13]
l21: $ G ⇒ isset (scons V1 (scons V5 ∅)) $ by wcel_isset [l17]
l22: $ G ⇒ kr_struct_like = kr_struct_like ∧ scons t1 (scons t2 ∅) = scons V1 (scons V5 ∅) $ by opair_inj_c [l8, l19, l20, l19, l21]
l23: $ G ⇒ scons t1 (scons t2 ∅) = scons V1 (scons V5 ∅) $ by and_elim_r [l22]
l24: $ G ⇒ t1 = V1 ∧ scons t2 ∅ = scons V5 ∅ $ by y1_scons_inj [l23, l12, l16, l11, l15]
l25: $ G ⇒ t1 = V1 $ by and_elim_l [l24]
l26: $ G ⇒ scons t2 ∅ = scons V5 ∅ $ by and_elim_r [l24]
l27: $ G ⇒ t2 = V5 ∧ ∅ = ∅ $ by y1_scons_inj [l26, l10, l14, l9, l9]
l28: $ G ⇒ t2 = V5 $ by and_elim_l [l27]
l29: $ G ⇒ crn pp = crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))) $ by crn_eq [l7]
l30: $ G ⇒ crn (scons (ra_ind_data V1 V2 V3 V4) (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅))) ⊆ lrel $ by subset_eq_l [l29, #2]
l31: $ G ⇒ isset (ra_ind_data V1 V2 V3 V4) $ by opair_isset
l32: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel $ by crn_scons_head [l31, l30]
l33: $ G ⇒ crn (scons (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅)) ⊆ lrel $ by crn_scons_tail [l30]
l34: $ G ⇒ isset (ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) $ by opair_isset
l35: $ G ⇒ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel $ by crn_scons_head [l34, l33]
l36: $ G ⇒ crn (scons (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) ∅) ⊆ lrel $ by crn_scons_tail [l33]
l37: $ G ⇒ isset (ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8) $ by opair_isset
l38: $ G ⇒ ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by crn_scons_head [l37, l36]
l39: $ G ⇒ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l35, l38]
l40: $ G ⇒ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l32, l39]
l41: $ G ⇒ t2 = V5 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l28, l40]
l42: $ G ⇒ t1 = V1 ∧ t2 = V5 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort V6 ⟨ kc_nz , ∅ ⟩ V8 ∈ lrel $ by and_intro [l25, l41]
l43: $ G ⇒ ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons V7 (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort V6 ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ K ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 V6 ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort V6 ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ F ∃ K ∃ l_v (t1 = V1 ∧ t2 = V5 ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 V5 F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l44]
l46: $ G ⇒ ∃ j_v ∃ F ∃ K ∃ l_v (t1 = V1 ∧ t2 = j_v ∧ ra_ind_data V1 V2 V3 V4 ∈ lrel ∧ ra_nth_ty V4 j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l45]
l47: $ G ⇒ ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = V1 ∧ t2 = j_v ∧ ra_ind_data V1 V2 V3 T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l46]
l48: $ G ⇒ ∃ P ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = V1 ∧ t2 = j_v ∧ ra_ind_data V1 V2 P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l47]
l49: $ G ⇒ ∃ b_v ∃ P ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = V1 ∧ t2 = j_v ∧ ra_ind_data V1 b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l48]
l50: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ j_v ∃ F ∃ K ∃ l_v (t1 = D ∧ t2 = j_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T j_v F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩ ∈ lrel ∧ ra_isort F ⟨ kc_nz , ∅ ⟩ l_v ∈ lrel) $ by ex_intro [l49]

lemma y1_d_struct_like_i (G: hyps) {D b_v P T j_v F K l_v: set} (pp t1 t2: set):
  $ G ⇒ ⟨ pp , ra_struct_like t1 t2 ⟩ ∈ cl_struct_like_i $ > $ G ⇒ crn pp ⊆ lrel $ >
