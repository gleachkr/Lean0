l20: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_ind_nested y z) (scons (ra_ind_arity y w a b) (scons (ra_ndecl z a c) (scons (ra_le ⟨ kc_s , scons u ∅ ⟩ c) ∅))) , ra_afree ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) $ by ex_elim [l19, l18]
