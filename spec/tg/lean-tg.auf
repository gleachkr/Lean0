lemma y1_p_field_ty (G: hyps): $ G ⇒ pr_field_ty ⊆ y1_lab kr_field_ty (suc kr_field_ty) $
----
l1: $ G ⇒ pr_field_ty ⊆ y1_lab kr_field_ty (suc kr_field_ty) $ by y1_k_field_ty_i

lemma y1_k_qinst_z (G: hyps): $ G ⇒ cl_qinst_z ⊆ y1_lab kr_qinst (suc kr_qinst) $
----
l1: $ G , x ∊ cl_qinst_z ⇒ x ∊ cl_qinst_z $ by ax
l2: $ G , x ∊ cl_qinst_z ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ kr_qinst ∈ ω $ by x1_kr_qinst
l5: $ G , x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩ ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_qinst y z ⟨ kc_nz , ∅ ⟩ v u u ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_qinst_z ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_qinst_z ⊆ y1_lab kr_qinst (suc kr_qinst) $ by subset_intro [l12]

lemma y1_k_qinst_s (G: hyps): $ G ⇒ cl_qinst_s ⊆ y1_lab kr_qinst (suc kr_qinst) $
----
l1: $ G , x ∊ cl_qinst_s ⇒ x ∊ cl_qinst_s $ by ax
l2: $ G , x ∊ cl_qinst_s ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ kr_qinst ∈ ω $ by x1_kr_qinst
l5: $ G , x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩ ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by ax
l7: $ G , ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by ax
l9: $ G , ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by ax
l11: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l10, l9]
l12: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by ax
l13: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l12, l11]
l14: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by ax
l15: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l14, l13]
l16: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) $ by ax
l17: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_inst a u ⟨ kc_proj , scons y (scons b (scons z ∅)) ⟩ v) (scons (ra_qinst y z a ⟨ kc_s , scons b ∅ ⟩ v w) ∅) , ra_qinst y z ⟨ kc_s , scons a ∅ ⟩ b u w ⟩) ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l16, l15]
l18: $ G , x ∊ cl_qinst_s ⇒ x ∊ y1_lab kr_qinst (suc kr_qinst) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_qinst_s ⊆ y1_lab kr_qinst (suc kr_qinst) $ by subset_intro [l18]

lemma y1_p_qinst (G: hyps): $ G ⇒ pr_qinst ⊆ y1_lab kr_qinst (suc kr_qinst) $
----
l1: $ G ⇒ cl_qinst_s ⊆ y1_lab kr_qinst (suc kr_qinst) $ by y1_k_qinst_s
l2: $ G ⇒ cl_qinst_z ⊆ y1_lab kr_qinst (suc kr_qinst) $ by y1_k_qinst_z
