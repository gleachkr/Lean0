lemma y1_k_sinst_done (G: hyps): $ G ⇒ cl_sinst_done ⊆ y1_lab kr_sinst (suc kr_sinst) $
----
l1: $ G , x ∊ cl_sinst_done ⇒ x ∊ cl_sinst_done $ by ax
l2: $ G , x ∊ cl_sinst_done ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ x = ⟨ ∅ , ra_sinst y z z u v v ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ kr_sinst ∈ ω $ by x1_kr_sinst
l5: $ G , x = ⟨ ∅ , ra_sinst y z z u v v ⟩ ⇒ x ∊ y1_lab kr_sinst (suc kr_sinst) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by ax
l7: $ G , ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ x ∊ y1_lab kr_sinst (suc kr_sinst) $ by ex_elim [l6, l5]
l8: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by ax
l9: $ G , ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ x ∊ y1_lab kr_sinst (suc kr_sinst) $ by ex_elim [l8, l7]
l10: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) $ by ax
l11: $ G , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_sinst y z z u v v ⟩) ⇒ x ∊ y1_lab kr_sinst (suc kr_sinst) $ by ex_elim [l10, l9]
l12: $ G , x ∊ cl_sinst_done ⇒ x ∊ y1_lab kr_sinst (suc kr_sinst) $ by ex_elim [l2, l11]
l13: $ G ⇒ cl_sinst_done ⊆ y1_lab kr_sinst (suc kr_sinst) $ by subset_intro [l12]

