l42: $ GG ⇒ q3 = w3 $ by or_elim [l1, l16, l41]

lemma y2_cnth_d1 (GG: hyps) (o q1 q2 q3 w3: set):
  $ GG ⇒ ⟨ o , ra_cnth q1 q2 q3 ⟩ ∈ cl_cnth_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ > $ GG ⇒ ra_cnth q1 q2 w3 ∈ lrel $ > $ GG ⇒ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a $ by ax
l2: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ ra_cnth q1 q2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a ⇒ q3 = w3 $ by y2_cnth_c1 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ a ∀ b (q1 = ⟨ kc_cons , scons a (scons b ∅) ⟩ ∧ q2 = ⟨ kc_nz , ∅ ⟩ ∧ q3 = a → q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ q3 = w3 $ by y2_cnth_i1 [#1, #2, l6]

lemma y2_cnth_i2 (GG: hyps) {A B G n: set} (o q1 q2 q3: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_cnth q1 q2 q3 ⟩ ∈ cl_cnth_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_cnth lrel $ > $ GG ⇒ ∀ A ∀ B ∀ G ∀ n (q1 = ⟨ kc_cons , scons A (scons G ∅) ⟩ ∧ q2 = ⟨ kc_s , scons n ∅ ⟩ ∧ q3 = B ∧ ra_cnth G n B ∈ lrel ∧ ra_cnth G n B ∈ y2_P_cnth lrel → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s ⇒ w ∊ cl_cnth_s $ by ax
l2: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s ⇒ ∃ A ∃ B ∃ G ∃ n (w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ w = ⟨ o , ra_cnth q1 q2 q3 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ ⟨ o , ra_cnth q1 q2 q3 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ ⟨ o , ra_cnth q1 q2 q3 ⟩ = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ $ by eq_trans [l5, l4]
l7: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ isset o $ by isset_var
l8: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ isset (ra_cnth q1 q2 q3) $ by opair_isset
l9: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ ∅ ∈ fseq y2_V $ by y2_fs0
l10: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ isset (ra_cnth G n B) $ by opair_isset
l11: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ scons (ra_cnth G n B) ∅ ∈ fseq y2_V $ by y2_fs [l10, l9]
l12: $ GG , w = ⟨ o , ra_cnth q1 q2 q3 ⟩ , w ∊ cl_cnth_s , w = ⟨ scons (ra_cnth G n B) ∅ , ra_cnth ⟨ kc_cons , scons A (scons G ∅) ⟩ ⟨ kc_s , scons n ∅ ⟩ B ⟩ ⇒ isset (scons (ra_cnth G n B) ∅) $ by y2_fs_set [l11]
