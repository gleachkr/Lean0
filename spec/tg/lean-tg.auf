lemma y1_e_bor_11 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = ⟨ scons (ra_bor V1 V2 V3) ∅ , ra_bor ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_bor V1 V2 V3) ∅ , ra_bor ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ ⟩ = ⟨ pp , ra_bor t1 t2 t3 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_bor V1 V2 V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_bor t1 t2 t3) $ by opair_isset
l5: $ G ⇒ isset (ra_bor ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_bor V1 V2 V3) ∅ ∧ ra_bor t1 t2 t3 = ra_bor ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_bor V1 V2 V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_bor t1 t2 t3 = ra_bor ⟨ kc_bd1 , scons V1 ∅ ⟩ ⟨ kc_bd1 , scons V2 ∅ ⟩ ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t3 $ by isset_var
l11: $ G ⇒ scons t3 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t2 $ by isset_var
l13: $ G ⇒ scons t2 (scons t3 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t1 $ by isset_var
l15: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by opair_isset
l17: $ G ⇒ scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l16, l9]
l18: $ G ⇒ isset ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by opair_isset
l19: $ G ⇒ scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) ∈ fseq y1_vv $ by y1_fs [l18, l17]
l20: $ G ⇒ isset ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by opair_isset
l21: $ G ⇒ scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ kr_bor ∈ ω $ by x1_kr_bor
l23: $ G ⇒ isset kr_bor $ by wcel_isset [l22]
l24: $ G ⇒ isset (scons t1 (scons t2 (scons t3 ∅))) $ by wcel_isset [l15]
l25: $ G ⇒ isset (scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅))) $ by wcel_isset [l21]
l26: $ G ⇒ kr_bor = kr_bor ∧ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) $ by opair_inj_c [l8, l23, l24, l23, l25]
l27: $ G ⇒ scons t1 (scons t2 (scons t3 ∅)) = scons ⟨ kc_bd1 , scons V1 ∅ ⟩ (scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅)) $ by and_elim_r [l26]
l28: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) $ by y1_scons_inj [l27, l14, l20, l13, l19]
l29: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ $ by and_elim_l [l28]
l30: $ G ⇒ scons t2 (scons t3 ∅) = scons ⟨ kc_bd1 , scons V2 ∅ ⟩ (scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅) $ by and_elim_r [l28]
l31: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ scons t3 ∅ = scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅ $ by y1_scons_inj [l30, l12, l18, l11, l17]
l32: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t3 ∅ = scons ⟨ kc_bd1 , scons V3 ∅ ⟩ ∅ $ by and_elim_r [l31]
l34: $ G ⇒ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l33, l10, l16, l9, l9]
l35: $ G ⇒ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ crn pp = crn (scons (ra_bor V1 V2 V3) ∅) $ by crn_eq [l7]
l37: $ G ⇒ crn (scons (ra_bor V1 V2 V3) ∅) ⊆ lrel $ by subset_eq_l [l36, #2]
l38: $ G ⇒ isset (ra_bor V1 V2 V3) $ by opair_isset
l39: $ G ⇒ ra_bor V1 V2 V3 ∈ lrel $ by crn_scons_head [l38, l37]
l40: $ G ⇒ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_bor V1 V2 V3 ∈ lrel $ by and_intro [l35, l39]
l41: $ G ⇒ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_bor V1 V2 V3 ∈ lrel $ by and_intro [l32, l40]
l42: $ G ⇒ t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons V3 ∅ ⟩ ∧ ra_bor V1 V2 V3 ∈ lrel $ by and_intro [l29, l41]
l43: $ G ⇒ ∃ c_v (t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons V2 ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor V1 V2 c_v ∈ lrel) $ by ex_intro [l42]
l44: $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons V1 ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor V1 b_v c_v ∈ lrel) $ by ex_intro [l43]
l45: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by ex_intro [l44]

lemma y1_d_bor_11 (G: hyps) {a_v b_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_11 ⇒ x ∊ cl_bor_11 $ by ax
l2: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_11 ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_bor t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩ ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by y1_e_bor_11 [l6, l7]
l9: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_bor y z u) ∅ , ra_bor ⟨ kc_bd1 , scons y ∅ ⟩ ⟨ kc_bd1 , scons z ∅ ⟩ ⟨ kc_bd1 , scons u ∅ ⟩ ⟩) ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_bor t1 t2 t3 ⟩ , x ∊ cl_bor_11 ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_o_bor (G: hyps) {b_v a_v c_v: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ pr_bor $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 $ by ax
l2: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by y1_d_bor_11 [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 → ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 $ by ax
l6: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∨ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 $ by ax
l8: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by y1_d_bor_10 [l7, l8]
l10: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ⇒ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) ∨ ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_bor a_v b_v c_v ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_10 ∪ cl_bor_11 , ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 ⇒ ⟨ pp , ra_bor t1 t2 t3 ⟩ ∈ cl_bor_11 $ by ax
