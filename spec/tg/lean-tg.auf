lemma y1_d_iota_lhs_i (G: hyps) {D v_v i_v c_v np n_v m_v mn nf ni a_v d1 io mo res e1 e2 e3 e4 Y T2 T0 c1 maj: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set):
  $ G ⇒ ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ ∈ cl_iota_lhs_i $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_iota_lhs_i ⇒ x ∊ cl_iota_lhs_i $ by ax
l2: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x ∊ cl_iota_lhs_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t (x = ⟨ scons (ra_ind_arity y w a b) (scons (ra_nidx y u g) (scons (ra_add b a c) (scons (ra_add f b i) (scons (ra_add i a j) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons u (scons z ∅)) ⟩ j w h) (scons (ra_pargs h i a l) (scons (ra_pargs l f b m) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ j w o) (scons (ra_lift c f e p) (scons (ra_rehead o m g p n) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ j w r) (scons (ra_pargs r ⟨ kc_nz , ∅ ⟩ f t) (scons (ra_add k ⟨ kc_s , scons u ∅ ⟩ a) (scons (ra_add i k d) (scons (ra_rehead o ⟨ kc_bvar , scons d ∅ ⟩ g p q) ∅))))))))))))))) , ra_iota_lhs y z u v f e m r t n ⟨ kc_app , scons q (scons t ∅) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_ind_arity y w a b) (scons (ra_nidx y u g) (scons (ra_add b a c) (scons (ra_add f b i) (scons (ra_add i a j) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons u (scons z ∅)) ⟩ j w h) (scons (ra_pargs h i a l) (scons (ra_pargs l f b m) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ j w o) (scons (ra_lift c f e p) (scons (ra_rehead o m g p n) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ j w r) (scons (ra_pargs r ⟨ kc_nz , ∅ ⟩ f t) (scons (ra_add k ⟨ kc_s , scons u ∅ ⟩ a) (scons (ra_add i k d) (scons (ra_rehead o ⟨ kc_bvar , scons d ∅ ⟩ g p q) ∅))))))))))))))) , ra_iota_lhs y z u v f e m r t n ⟨ kc_app , scons q (scons t ∅) ⟩ ⟩ ⇒ x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_ind_arity y w a b) (scons (ra_nidx y u g) (scons (ra_add b a c) (scons (ra_add f b i) (scons (ra_add i a j) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons u (scons z ∅)) ⟩ j w h) (scons (ra_pargs h i a l) (scons (ra_pargs l f b m) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ j w o) (scons (ra_lift c f e p) (scons (ra_rehead o m g p n) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ j w r) (scons (ra_pargs r ⟨ kc_nz , ∅ ⟩ f t) (scons (ra_add k ⟨ kc_s , scons u ∅ ⟩ a) (scons (ra_add i k d) (scons (ra_rehead o ⟨ kc_bvar , scons d ∅ ⟩ g p q) ∅))))))))))))))) , ra_iota_lhs y z u v f e m r t n ⟨ kc_app , scons q (scons t ∅) ⟩ ⟩ ⇒ ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ , x = ⟨ scons (ra_ind_arity y w a b) (scons (ra_nidx y u g) (scons (ra_add b a c) (scons (ra_add f b i) (scons (ra_add i a j) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons u (scons z ∅)) ⟩ j w h) (scons (ra_pargs h i a l) (scons (ra_pargs l f b m) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ j w o) (scons (ra_lift c f e p) (scons (ra_rehead o m g p n) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ j w r) (scons (ra_pargs r ⟨ kc_nz , ∅ ⟩ f t) (scons (ra_add k ⟨ kc_s , scons u ∅ ⟩ a) (scons (ra_add i k d) (scons (ra_rehead o ⟨ kc_bvar , scons d ∅ ⟩ g p q) ∅))))))))))))))) , ra_iota_lhs y z u v f e m r t n ⟨ kc_app , scons q (scons t ∅) ⟩ ⟩ ⇒ x = ⟨ scons (ra_ind_arity y w a b) (scons (ra_nidx y u g) (scons (ra_add b a c) (scons (ra_add f b i) (scons (ra_add i a j) (scons (ra_pargs ⟨ kc_ind_rec , scons y (scons u (scons z ∅)) ⟩ j w h) (scons (ra_pargs h i a l) (scons (ra_pargs l f b m) (scons (ra_pargs ⟨ kc_ind_ty , scons y (scons u ∅) ⟩ j w o) (scons (ra_lift c f e p) (scons (ra_rehead o m g p n) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons u (scons v ∅)) ⟩ j w r) (scons (ra_pargs r ⟨ kc_nz , ∅ ⟩ f t) (scons (ra_add k ⟨ kc_s , scons u ∅ ⟩ a) (scons (ra_add i k d) (scons (ra_rehead o ⟨ kc_bvar , scons d ∅ ⟩ g p q) ∅))))))))))))))) , ra_iota_lhs y z u v f e m r t n ⟨ kc_app , scons q (scons t ∅) ⟩ ⟩ $ by ax
