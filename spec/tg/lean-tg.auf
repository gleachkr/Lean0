lemma y1_k_npis_bvar (G: hyps): $ G ⇒ cl_npis_bvar ⊆ y1_lab kr_npis (suc kr_npis) $
----
l1: $ G , x ∊ cl_npis_bvar ⇒ x ∊ cl_npis_bvar $ by ax
l2: $ G , x ∊ cl_npis_bvar ⇒ ∃ y (x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_npis ∈ ω $ by x1_kr_npis
l5: $ G , x = ⟨ ∅ , ra_npis ⟨ kc_bvar , scons y ∅ ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by y1_lab_self [l3, l4]
l6: $ G , x ∊ cl_npis_bvar ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by ex_elim [l2, l5]
l7: $ G ⇒ cl_npis_bvar ⊆ y1_lab kr_npis (suc kr_npis) $ by subset_intro [l6]

lemma y1_k_npis_app (G: hyps): $ G ⇒ cl_npis_app ⊆ y1_lab kr_npis (suc kr_npis) $
----
l1: $ G , x ∊ cl_npis_app ⇒ x ∊ cl_npis_app $ by ax
l2: $ G , x ∊ cl_npis_app ⇒ ∃ y ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ kr_npis ∈ ω $ by x1_kr_npis
l5: $ G , x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) ⇒ ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ z (x = ⟨ ∅ , ra_npis ⟨ kc_app , scons y (scons z ∅) ⟩ ⟨ kc_nz , ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by ex_elim [l6, l5]
l8: $ G , x ∊ cl_npis_app ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by ex_elim [l2, l7]
l9: $ G ⇒ cl_npis_app ⊆ y1_lab kr_npis (suc kr_npis) $ by subset_intro [l8]

lemma y1_k_npis_pi (G: hyps): $ G ⇒ cl_npis_pi ⊆ y1_lab kr_npis (suc kr_npis) $
----
l1: $ G , x ∊ cl_npis_pi ⇒ x ∊ cl_npis_pi $ by ax
l2: $ G , x ∊ cl_npis_pi ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ kr_npis ∈ ω $ by x1_kr_npis
l5: $ G , x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l7: $ G , ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by ex_elim [l6, l5]
l8: $ G , ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) $ by ax
l9: $ G , ∃ z ∃ u (x = ⟨ scons (ra_npis z u) ∅ , ra_npis ⟨ kc_pi , scons y (scons z ∅) ⟩ ⟨ kc_s , scons u ∅ ⟩ ⟩) ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by ex_elim [l8, l7]
l10: $ G , x ∊ cl_npis_pi ⇒ x ∊ y1_lab kr_npis (suc kr_npis) $ by ex_elim [l2, l9]
l11: $ G ⇒ cl_npis_pi ⊆ y1_lab kr_npis (suc kr_npis) $ by subset_intro [l10]

