l28: $ G ⇒ (∃ x ∃ y (t = ⟨ kc_lcons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvls)) → v1_d_lvls x y t $ by v1_imp_or_r [l26]
