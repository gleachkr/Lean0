l22: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c (x = ⟨ scons (ra_mty y z u ⟨ kc_s , scons v ∅ ⟩ w b c) ∅ , ra_mty y z u v w ⟨ kc_pi , scons a (scons b ∅) ⟩ ⟨ kc_pi , scons a (scons c ∅) ⟩ ⟩) ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) $ by ex_elim [l21, l20]
l23: $ G , x = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ , x ∊ cl_mty_pi ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) $ by ex_elim [l2, l22]
l24: $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) $ by wcel_elim [#1, l23]

lemma y1_e_mty_srt (G: hyps) {D np j_v d_v k_v v_v l_v X I: set} (pp t1 t2 t3 t4 t5 t6 t7 V1 V2 V3 V4 V5 V6 V7 V8 V9: set):
  $ G ⇒ ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ = ⟨ scons (ra_add V4 V3 V5) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8) (scons (ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9) ∅)) , ra_mty V1 V2 V3 V4 V6 ⟨ kc_srt , scons V7 ∅ ⟩ ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V4 V3 V5) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8) (scons (ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9) ∅)) , ra_mty V1 V2 V3 V4 V6 ⟨ kc_srt , scons V7 ∅ ⟩ ⟨ kc_pi , scons V9 (scons ⟨ kc_srt , scons V6 ∅ ⟩ ∅) ⟩ ⟩ = ⟨ pp , ra_mty t1 t2 t3 t4 t5 t6 t7 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V4 V3 V5) (scons (ra_pargs ⟨ kc_ind_ty , scons V1 (scons V3 ∅) ⟩ V5 V2 V8) (scons (ra_pargs V8 ⟨ kc_nz , ∅ ⟩ V4 V9) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_mty t1 t2 t3 t4 t5 t6 t7) $ by opair_isset
