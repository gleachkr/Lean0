lemma y1_k_spz_ctors_nil (G: hyps): $ G ⇒ cl_spz_ctors_nil ⊆ y1_lab kr_spz_ctors (suc kr_spz_ctors) $
----
l1: $ G , x ∊ cl_spz_ctors_nil ⇒ x ∊ cl_spz_ctors_nil $ by ax
l2: $ G , x ∊ cl_spz_ctors_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a (x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ kr_spz_ctors ∈ ω $ by x1_kr_spz_ctors
l5: $ G , x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_spz_ctors (suc kr_spz_ctors) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ a (x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩) ⇒ ∃ a (x = ⟨ ∅ , ra_spz_ctors y z u v w a ⟨ kc_cnil , ∅ ⟩ ⟨ kc_cnil , ∅ ⟩ ⟩) $ by ax
