l66: $ G ⇒ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ scons t8 ∅ = scons ⟨ kc_nil , ∅ ⟩ ∅ $ by y1_scons_inj [l65, l12, l28, l11, l27]
