l14: $ G , y = A1 , z = A2 ⇒ scons ⟨ kc_nil , ∅ ⟩ (scons z (scons z ∅)) = scons ⟨ kc_nil , ∅ ⟩ (scons A2 (scons A2 ∅)) $ by scons_eq [l11, l13]
