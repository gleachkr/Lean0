lemma y1_p_cminors (G: hyps): $ G ⇒ pr_cminors ⊆ y1_lab kr_cminors (suc kr_cminors) $
----
l1: $ G ⇒ cl_cminors_cons ⊆ y1_lab kr_cminors (suc kr_cminors) $ by y1_k_cminors_cons
l2: $ G ⇒ cl_cminors_nil ⊆ y1_lab kr_cminors (suc kr_cminors) $ by y1_k_cminors_nil
l3: $ G ⇒ pr_cminors ⊆ y1_lab kr_cminors (suc kr_cminors) $ by cun_least [l2, l1]

lemma y1_k_minors_nil (G: hyps): $ G ⇒ cl_minors_nil ⊆ y1_lab kr_minors (suc kr_minors) $
----
l1: $ G , x ∊ cl_minors_nil ⇒ x ∊ cl_minors_nil $ by ax
l2: $ G , x ∊ cl_minors_nil ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w (x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ $ by ax
l4: $ G , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ kr_minors ∈ ω $ by x1_kr_minors
l5: $ G , x = ⟨ ∅ , ra_minors y z u v w ⟨ kc_tnil , ∅ ⟩ ⟨ kc_nil , ∅ ⟩ ⟩ ⇒ x ∊ y1_lab kr_minors (suc kr_minors) $ by y1_lab_self [l3, l4]
