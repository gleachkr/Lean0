l35: $ G , x = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ , x ∊ cl_rwalk_pi_nr ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) $ by ex_elim [l2, l34]
l36: $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ Acc ∃ A ∃ A3 ∃ B ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A A3 ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ Acc B Val ∈ lrel) $ by wcel_elim [#1, l35]

lemma y1_e_rwalk_pi_rec (G: hyps) {D np n_v m_v v_v nf d_v dp mn j_v sh fld Acc A A2 A3 A4 B IH Val: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19 V20: set):
  $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ = ⟨ scons (ra_add V7 V2 V8) (scons (ra_recfield V1 V3 V2 V7 V14 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 V8 V14 V15) (scons (ra_add V4 V3 V9) (scons (ra_lift V9 V7 V15 V16) (scons (ra_add V11 V7 V6) (scons (ra_add V12 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V11) (scons (ra_lift V11 ⟨ kc_nz , ∅ ⟩ V16 V17) (scons (ra_ihval V1 V2 V3 V4 V5 V6 V12 ⟨ kc_nz , ∅ ⟩ V10 V17 V19) (scons (ra_rwalk V1 V2 V3 V4 V5 V6 ⟨ kc_s , scons V7 ∅ ⟩ ⟨ kc_app , scons V13 (scons V19 ∅) ⟩ V18 V20) ∅))))))))) , ra_rwalk V1 V2 V3 V4 V5 V6 V7 V13 ⟨ kc_pi , scons V14 (scons V18 ∅) ⟩ ⟨ kc_lam , scons V16 (scons V20 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ d_v ∃ dp ∃ mn ∃ j_v ∃ sh ∃ fld ∃ Acc ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Val (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t10 = ⟨ kc_lam , scons A3 (scons Val ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_lift mn d_v A2 A3 ∈ lrel ∧ ra_add sh d_v nf ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_rwalk D np n_v m_v v_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_app , scons Acc (scons IH ∅) ⟩ B Val ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_add V7 V2 V8) (scons (ra_recfield V1 V3 V2 V7 V14 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 V8 V14 V15) (scons (ra_add V4 V3 V9) (scons (ra_lift V9 V7 V15 V16) (scons (ra_add V11 V7 V6) (scons (ra_add V12 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V11) (scons (ra_lift V11 ⟨ kc_nz , ∅ ⟩ V16 V17) (scons (ra_ihval V1 V2 V3 V4 V5 V6 V12 ⟨ kc_nz , ∅ ⟩ V10 V17 V19) (scons (ra_rwalk V1 V2 V3 V4 V5 V6 ⟨ kc_s , scons V7 ∅ ⟩ ⟨ kc_app , scons V13 (scons V19 ∅) ⟩ V18 V20) ∅))))))))) , ra_rwalk V1 V2 V3 V4 V5 V6 V7 V13 ⟨ kc_pi , scons V14 (scons V18 ∅) ⟩ ⟨ kc_lam , scons V16 (scons V20 ∅) ⟩ ⟩ = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_add V7 V2 V8) (scons (ra_recfield V1 V3 V2 V7 V14 V10) (scons (ra_sinst V1 ⟨ kc_nz , ∅ ⟩ V3 V8 V14 V15) (scons (ra_add V4 V3 V9) (scons (ra_lift V9 V7 V15 V16) (scons (ra_add V11 V7 V6) (scons (ra_add V12 ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ V11) (scons (ra_lift V11 ⟨ kc_nz , ∅ ⟩ V16 V17) (scons (ra_ihval V1 V2 V3 V4 V5 V6 V12 ⟨ kc_nz , ∅ ⟩ V10 V17 V19) (scons (ra_rwalk V1 V2 V3 V4 V5 V6 ⟨ kc_s , scons V7 ∅ ⟩ ⟨ kc_app , scons V13 (scons V19 ∅) ⟩ V18 V20) ∅)))))))))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
