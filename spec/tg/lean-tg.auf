lemma y2_nth_ty_e2 (GG: hyps) (q1 q2 q3 q4 w3 w4 u_F u_F2 u_C u_C2 u_T u_i v_F v_F2 v_C v_C2 v_T v_i: set):
  $ GG ⇒ q1 = ⟨ kc_tcons , scons u_F2 (scons u_C2 (scons u_T ∅)) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons u_i ∅ ⟩ $ > $ GG ⇒ q3 = u_F $ > $ GG ⇒ q4 = u_C $ > $ GG ⇒ ra_nth_ty u_T u_i u_F u_C ∈ lrel $ > $ GG ⇒ ra_nth_ty u_T u_i u_F u_C ∈ y2_P_nth_ty lrel $ > $ GG ⇒ q1 = ⟨ kc_tcons , scons v_F2 (scons v_C2 (scons v_T ∅)) ⟩ $ > $ GG ⇒ q2 = ⟨ kc_s , scons v_i ∅ ⟩ $ > $ GG ⇒ w3 = v_F $ > $ GG ⇒ w4 = v_C $ > $ GG ⇒ ra_nth_ty v_T v_i v_F v_C ∈ lrel $ > $ GG ⇒ q3 = w3 ∧ q4 = w4 $
----
l1: $ GG ⇒ ⟨ kc_tcons , scons u_F2 (scons u_C2 (scons u_T ∅)) ⟩ = q1 $ by eq_sym [#1]
l2: $ GG ⇒ ⟨ kc_tcons , scons u_F2 (scons u_C2 (scons u_T ∅)) ⟩ = ⟨ kc_tcons , scons v_F2 (scons v_C2 (scons v_T ∅)) ⟩ $ by eq_trans [l1, #7]
l3: $ GG ⇒ kc_tcons ∈ ω $ by v1_kc_tcons
l4: $ GG ⇒ isset kc_tcons $ by wcel_isset [l3]
l5: $ GG ⇒ isset u_F2 $ by isset_var
l6: $ GG ⇒ isset u_C2 $ by isset_var
l7: $ GG ⇒ isset u_T $ by isset_var
l8: $ GG ⇒ isset v_F2 $ by isset_var
l9: $ GG ⇒ isset v_C2 $ by isset_var
