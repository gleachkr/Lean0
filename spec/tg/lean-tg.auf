lemma y2_ntys_d2 (GG: hyps) (o q1 q2 q3 w2 w3: set):
  $ GG ⇒ ⟨ o , ra_ntys q1 q2 q3 ⟩ ∈ cl_ntys_cons $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_ntys lrel $ > $ GG ⇒ ra_ntys q1 w2 w3 ∈ lrel $ > $ GG ⇒ q2 = w2 ∧ q3 = w3 $
----
l1: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel $ by ax
l2: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel ⇒ ra_ntys q1 w2 w3 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel ⇒ q2 = w2 ∧ q3 = w3 $ by y2_ntys_c2 [l1, l2]
l4: $ GG ⇒ q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l4]
l6: $ GG ⇒ ∀ g ∀ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l5]
l7: $ GG ⇒ ∀ f ∀ g ∀ h (q1 = ⟨ kc_tcons , scons a (scons b (scons d ∅)) ⟩ ∧ q2 = ⟨ kc_s , scons e ∅ ⟩ ∧ q3 = h ∧ ra_ntys d e f ∈ lrel ∧ ra_ntys d e f ∈ y2_P_ntys lrel ∧ ra_clen_c b g ∈ lrel ∧ ra_add f g h ∈ lrel → q2 = w2 ∧ q3 = w3) $ by all_intro [l6]
