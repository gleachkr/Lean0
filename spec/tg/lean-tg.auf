l3: $ G ⇒ pr_isort ⊆ y1_lab kr_isort (suc kr_isort) $ by cun_least [l2, l1]

lemma y1_k_ind_arity_i (G: hyps): $ G ⇒ cl_ind_arity_i ⊆ y1_lab kr_ind_arity (suc kr_ind_arity) $
----
l1: $ G , x ∊ cl_ind_arity_i ⇒ x ∊ cl_ind_arity_i $ by ax
l2: $ G , x ∊ cl_ind_arity_i ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ $ by ax
l4: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ kr_ind_arity ∈ ω $ by x1_kr_ind_arity
l5: $ G , x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩ ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by y1_lab_self [l3, l4]
l6: $ G , ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l7: $ G , ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l6, l5]
l8: $ G , ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l9: $ G , ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l8, l7]
l10: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l11: $ G , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l10, l9]
l12: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l13: $ G , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l12, l11]
l14: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l15: $ G , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l14, l13]
l16: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) $ by ax
l17: $ G , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ind_data y z u v) (scons (ra_clen u w) (scons (ra_ntys v a b) ∅)) , ra_ind_arity y w a b ⟩) ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l16, l15]
l18: $ G , x ∊ cl_ind_arity_i ⇒ x ∊ y1_lab kr_ind_arity (suc kr_ind_arity) $ by ex_elim [l2, l17]
l19: $ G ⇒ cl_ind_arity_i ⊆ y1_lab kr_ind_arity (suc kr_ind_arity) $ by subset_intro [l18]

