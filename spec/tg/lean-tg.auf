-- The label ranges of the subtrees: from the first to the last relation.

lemma y1_f5 (G: hyps): $ G ⇒ kr_le ⊆ kr_add $
----
l1: $ G ⇒ kr_le ⊆ kr_le $ by subset_refl
l2: $ G ⇒ kr_le ⊆ kr_add $ by suc_subset
l3: $ G ⇒ kr_add ⊆ kr_add $ by subset_refl
l4: $ G ⇒ kr_le ⊆ kr_add $ by subset_trans [l2, l3]

lemma y1_f7 (G: hyps): $ G ⇒ kr_linst ⊆ kr_lsubst $
----
l1: $ G ⇒ kr_linst ⊆ kr_linst $ by subset_refl
l2: $ G ⇒ kr_linst ⊆ kr_lsubst $ by suc_subset
l3: $ G ⇒ kr_lsubst ⊆ kr_lsubst $ by subset_refl
l4: $ G ⇒ kr_linst ⊆ kr_lsubst $ by subset_trans [l2, l3]

lemma y1_f6 (G: hyps): $ G ⇒ kr_lnth ⊆ kr_lsubst $
----
l1: $ G ⇒ kr_lnth ⊆ kr_lnth $ by subset_refl
l2: $ G ⇒ kr_lnth ⊆ kr_linst $ by suc_subset
l3: $ G ⇒ kr_linst ⊆ kr_lsubst $ by y1_f7
l4: $ G ⇒ kr_lnth ⊆ kr_lsubst $ by subset_trans [l2, l3]

lemma y1_f4 (G: hyps): $ G ⇒ kr_le ⊆ kr_lsubst $
----
l1: $ G ⇒ kr_le ⊆ kr_add $ by y1_f5
l2: $ G ⇒ kr_add ⊆ kr_lnth $ by suc_subset
l3: $ G ⇒ kr_lnth ⊆ kr_lsubst $ by y1_f6
l4: $ G ⇒ kr_le ⊆ kr_lnth $ by subset_trans [l1, l2]
l5: $ G ⇒ kr_le ⊆ kr_lsubst $ by subset_trans [l4, l3]

lemma y1_f9 (G: hyps): $ G ⇒ kr_closed ⊆ kr_lift $
----
l1: $ G ⇒ kr_closed ⊆ kr_closed $ by subset_refl
l2: $ G ⇒ kr_closed ⊆ kr_lift $ by suc_subset
l3: $ G ⇒ kr_lift ⊆ kr_lift $ by subset_refl
l4: $ G ⇒ kr_closed ⊆ kr_lift $ by subset_trans [l2, l3]

lemma y1_f11 (G: hyps): $ G ⇒ kr_lookup ⊆ kr_cinst $
----
l1: $ G ⇒ kr_lookup ⊆ kr_lookup $ by subset_refl
l2: $ G ⇒ kr_lookup ⊆ kr_cinst $ by suc_subset
l3: $ G ⇒ kr_cinst ⊆ kr_cinst $ by subset_refl
