l43: $ G ⇒ crn (scons (ra_add V5 V6 V7) ∅) ⊆ lrel $ by crn_scons_tail [l40]
l44: $ G ⇒ isset (ra_add V5 V6 V7) $ by opair_isset
l45: $ G ⇒ ra_add V5 V6 V7 ∈ lrel $ by crn_scons_head [l44, l43]
l46: $ G ⇒ ra_clen_c V2 V6 ∈ lrel ∧ ra_add V5 V6 V7 ∈ lrel $ by and_intro [l42, l45]
l47: $ G ⇒ ra_ntys V3 V4 V5 ∈ lrel ∧ ra_clen_c V2 V6 ∈ lrel ∧ ra_add V5 V6 V7 ∈ lrel $ by and_intro [l39, l46]
l48: $ G ⇒ t3 = V7 ∧ ra_ntys V3 V4 V5 ∈ lrel ∧ ra_clen_c V2 V6 ∈ lrel ∧ ra_add V5 V6 V7 ∈ lrel $ by and_intro [l35, l47]
l49: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V7 ∧ ra_ntys V3 V4 V5 ∈ lrel ∧ ra_clen_c V2 V6 ∈ lrel ∧ ra_add V5 V6 V7 ∈ lrel $ by and_intro [l32, l48]
l50: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V7 ∧ ra_ntys V3 V4 V5 ∈ lrel ∧ ra_clen_c V2 V6 ∈ lrel ∧ ra_add V5 V6 V7 ∈ lrel $ by and_intro [l29, l49]
l51: $ G ⇒ ∃ m2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys V3 V4 V5 ∈ lrel ∧ ra_clen_c V2 V6 ∈ lrel ∧ ra_add V5 V6 m2 ∈ lrel) $ by ex_intro [l50]
l52: $ G ⇒ ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys V3 V4 V5 ∈ lrel ∧ ra_clen_c V2 c_v ∈ lrel ∧ ra_add V5 c_v m2 ∈ lrel) $ by ex_intro [l51]
l53: $ G ⇒ ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys V3 V4 m_v ∈ lrel ∧ ra_clen_c V2 c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_intro [l52]
l54: $ G ⇒ ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys V3 n_v m_v ∈ lrel ∧ ra_clen_c V2 c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_intro [l53]
l55: $ G ⇒ ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c V2 c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_intro [l54]
l56: $ G ⇒ ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons V1 (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_intro [l55]
l57: $ G ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_intro [l56]

lemma y1_d_ntys_cons (G: hyps) {F C T n_v m_v c_v m2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_cons ⇒ x ∊ cl_ntys_cons $ by ax
l2: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_cons ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ ⇒ x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ ⇒ x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩ ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by y1_e_ntys_cons [l6, l7]
l9: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_ntys u v w) (scons (ra_clen_c z a) (scons (ra_add w a b) ∅)) , ra_ntys ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_s , scons v ∅ ⟩ b ⟩) ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_ntys t1 t2 t3 ⟩ , x ∊ cl_ntys_cons ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_o_ntys (G: hyps) {F C T n_v m_v c_v m2: set} (pp t1 t2 t3: set):
  $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ pr_ntys $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons $ by ax
l2: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by y1_d_ntys_cons [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons → ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons $ by ax
l6: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∨ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil $ by ax
l8: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) $ by y1_d_ntys_nil [l7, l8]
l10: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons $ by ax
l12: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons → ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_cons ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_ntys t1 t2 t3 ⟩ ∈ cl_ntys_nil ∪ cl_ntys_cons → (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ (t1 = ⟨ kc_tnil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = ⟨ kc_nz , ∅ ⟩) ∨ ∃ F ∃ C ∃ T ∃ n_v ∃ m_v ∃ c_v ∃ m2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = m2 ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_clen_c C c_v ∈ lrel ∧ ra_add m_v c_v m2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_minor_idx_z (G: hyps) {F C T c_v: set} (pp t1 t2 t3 t4 V1 V2 V3 V4: set):
  $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V4 V4 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $
----
l1: $ G ⇒ ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V4 V4 ⟩ = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_minor_idx t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V4 V4) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_minor_idx t1 t2 t3 t4 = ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V4 V4 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_minor_idx t1 t2 t3 t4 = ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ V4 V4 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V4 $ by isset_var
l19: $ G ⇒ scons V4 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ scons V4 (scons V4 ∅) ∈ fseq y1_vv $ by y1_fs [l18, l19]
l21: $ G ⇒ isset ⟨ kc_nz , ∅ ⟩ $ by opair_isset
l22: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅)) ∈ fseq y1_vv $ by y1_fs [l21, l20]
l23: $ G ⇒ isset ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l24: $ G ⇒ scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅))) ∈ fseq y1_vv $ by y1_fs [l23, l22]
l25: $ G ⇒ kr_minor_idx ∈ ω $ by x1_kr_minor_idx
l26: $ G ⇒ isset kr_minor_idx $ by wcel_isset [l25]
l27: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l28: $ G ⇒ isset (scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅)))) $ by wcel_isset [l24]
l29: $ G ⇒ kr_minor_idx = kr_minor_idx ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅))) $ by opair_inj_c [l8, l26, l27, l26, l28]
l30: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅))) $ by and_elim_r [l29]
l31: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅)) $ by y1_scons_inj [l30, l16, l23, l15, l22]
l32: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l31]
l33: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_nz , ∅ ⟩ (scons V4 (scons V4 ∅)) $ by and_elim_r [l31]
l34: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V4 (scons V4 ∅) $ by y1_scons_inj [l33, l14, l21, l13, l20]
l35: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [l34]
l36: $ G ⇒ scons t3 (scons t4 ∅) = scons V4 (scons V4 ∅) $ by and_elim_r [l34]
l37: $ G ⇒ t3 = V4 ∧ scons t4 ∅ = scons V4 ∅ $ by y1_scons_inj [l36, l12, l18, l11, l19]
l38: $ G ⇒ t3 = V4 $ by and_elim_l [l37]
l39: $ G ⇒ scons t4 ∅ = scons V4 ∅ $ by and_elim_r [l37]
l40: $ G ⇒ t4 = V4 ∧ ∅ = ∅ $ by y1_scons_inj [l39, l10, l18, l9, l9]
l41: $ G ⇒ t4 = V4 $ by and_elim_l [l40]
l42: $ G ⇒ t3 = V4 ∧ t4 = V4 $ by and_intro [l38, l41]
l43: $ G ⇒ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V4 ∧ t4 = V4 $ by and_intro [l35, l42]
l44: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = V4 ∧ t4 = V4 $ by and_intro [l32, l43]
l45: $ G ⇒ ∃ c_v (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_intro [l44]
l46: $ G ⇒ ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_intro [l45]
l47: $ G ⇒ ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons V1 (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_intro [l46]
l48: $ G ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_intro [l47]

lemma y1_d_minor_idx_z (G: hyps) {F C T c_v: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_z $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $
----
l1: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x ∊ cl_minor_idx_z ⇒ x ∊ cl_minor_idx_z $ by ax
l2: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x ∊ cl_minor_idx_z ⇒ ∃ y ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ ⇒ x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ ⇒ x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩ ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by y1_e_minor_idx_z [l6, l7]
l9: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , ∃ z ∃ u ∃ v (x = ⟨ ∅ , ra_minor_idx ⟨ kc_tcons , scons y (scons z (scons u ∅)) ⟩ ⟨ kc_nz , ∅ ⟩ v v ⟩) ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ , x ∊ cl_minor_idx_z ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by ex_elim [l2, l14]
l16: $ G ⇒ ∃ F ∃ C ∃ T ∃ c_v (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = c_v ∧ t4 = c_v) $ by wcel_elim [#1, l15]

lemma y1_e_minor_idx_s (G: hyps) {F C T i_v c_v k_v nc k2: set} (pp t1 t2 t3 t4 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ = ⟨ scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅)) , ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V5 V8 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅)) , ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V5 V8 ⟩ = ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅))) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_minor_idx t1 t2 t3 t4) $ by opair_isset
l5: $ G ⇒ isset (ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V5 V8) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅)) ∧ ra_minor_idx t1 t2 t3 t4 = ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V5 V8 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅)) $ by and_elim_l [l6]
l8: $ G ⇒ ra_minor_idx t1 t2 t3 t4 = ra_minor_idx ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟨ kc_s , scons V4 ∅ ⟩ V5 V8 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t4 $ by isset_var
l11: $ G ⇒ scons t4 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t3 $ by isset_var
l13: $ G ⇒ scons t3 (scons t4 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t2 $ by isset_var
l15: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t1 $ by isset_var
l17: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset V8 $ by isset_var
l19: $ G ⇒ scons V8 ∅ ∈ fseq y1_vv $ by y1_fs [l18, l9]
l20: $ G ⇒ isset V5 $ by isset_var
l21: $ G ⇒ scons V5 (scons V8 ∅) ∈ fseq y1_vv $ by y1_fs [l20, l19]
l22: $ G ⇒ isset ⟨ kc_s , scons V4 ∅ ⟩ $ by opair_isset
l23: $ G ⇒ scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅)) ∈ fseq y1_vv $ by y1_fs [l22, l21]
l24: $ G ⇒ isset ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l25: $ G ⇒ scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅))) ∈ fseq y1_vv $ by y1_fs [l24, l23]
l26: $ G ⇒ kr_minor_idx ∈ ω $ by x1_kr_minor_idx
l27: $ G ⇒ isset kr_minor_idx $ by wcel_isset [l26]
l28: $ G ⇒ isset (scons t1 (scons t2 (scons t3 (scons t4 ∅)))) $ by wcel_isset [l17]
l29: $ G ⇒ isset (scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅)))) $ by wcel_isset [l25]
l30: $ G ⇒ kr_minor_idx = kr_minor_idx ∧ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅))) $ by opair_inj_c [l8, l27, l28, l27, l29]
l31: $ G ⇒ scons t1 (scons t2 (scons t3 (scons t4 ∅))) = scons ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ (scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅))) $ by and_elim_r [l30]
l32: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅)) $ by y1_scons_inj [l31, l16, l24, l15, l23]
l33: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l32]
l34: $ G ⇒ scons t2 (scons t3 (scons t4 ∅)) = scons ⟨ kc_s , scons V4 ∅ ⟩ (scons V5 (scons V8 ∅)) $ by and_elim_r [l32]
l35: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ scons t3 (scons t4 ∅) = scons V5 (scons V8 ∅) $ by y1_scons_inj [l34, l14, l22, l13, l21]
l36: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ $ by and_elim_l [l35]
l37: $ G ⇒ scons t3 (scons t4 ∅) = scons V5 (scons V8 ∅) $ by and_elim_r [l35]
l38: $ G ⇒ t3 = V5 ∧ scons t4 ∅ = scons V8 ∅ $ by y1_scons_inj [l37, l12, l20, l11, l19]
l39: $ G ⇒ t3 = V5 $ by and_elim_l [l38]
l40: $ G ⇒ scons t4 ∅ = scons V8 ∅ $ by and_elim_r [l38]
l41: $ G ⇒ t4 = V8 ∧ ∅ = ∅ $ by y1_scons_inj [l40, l10, l18, l9, l9]
l42: $ G ⇒ t4 = V8 $ by and_elim_l [l41]
l43: $ G ⇒ crn pp = crn (scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅))) $ by crn_eq [l7]
l44: $ G ⇒ crn (scons (ra_clen_c V2 V7) (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅))) ⊆ lrel $ by subset_eq_l [l43, #2]
l45: $ G ⇒ isset (ra_clen_c V2 V7) $ by opair_isset
l46: $ G ⇒ ra_clen_c V2 V7 ∈ lrel $ by crn_scons_head [l45, l44]
l47: $ G ⇒ crn (scons (ra_minor_idx V3 V4 V5 V6) (scons (ra_add V7 V6 V8) ∅)) ⊆ lrel $ by crn_scons_tail [l44]
l48: $ G ⇒ isset (ra_minor_idx V3 V4 V5 V6) $ by opair_isset
l49: $ G ⇒ ra_minor_idx V3 V4 V5 V6 ∈ lrel $ by crn_scons_head [l48, l47]
l50: $ G ⇒ crn (scons (ra_add V7 V6 V8) ∅) ⊆ lrel $ by crn_scons_tail [l47]
l51: $ G ⇒ isset (ra_add V7 V6 V8) $ by opair_isset
l52: $ G ⇒ ra_add V7 V6 V8 ∈ lrel $ by crn_scons_head [l51, l50]
l53: $ G ⇒ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 V8 ∈ lrel $ by and_intro [l49, l52]
l54: $ G ⇒ ra_clen_c V2 V7 ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 V8 ∈ lrel $ by and_intro [l46, l53]
l55: $ G ⇒ t4 = V8 ∧ ra_clen_c V2 V7 ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 V8 ∈ lrel $ by and_intro [l42, l54]
l56: $ G ⇒ t3 = V5 ∧ t4 = V8 ∧ ra_clen_c V2 V7 ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 V8 ∈ lrel $ by and_intro [l39, l55]
l57: $ G ⇒ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V5 ∧ t4 = V8 ∧ ra_clen_c V2 V7 ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 V8 ∈ lrel $ by and_intro [l36, l56]
l58: $ G ⇒ t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V5 ∧ t4 = V8 ∧ ra_clen_c V2 V7 ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 V8 ∈ lrel $ by and_intro [l33, l57]
l59: $ G ⇒ ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V5 ∧ t4 = k2 ∧ ra_clen_c V2 V7 ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add V7 V6 k2 ∈ lrel) $ by ex_intro [l58]
l60: $ G ⇒ ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V5 ∧ t4 = k2 ∧ ra_clen_c V2 nc ∈ lrel ∧ ra_minor_idx V3 V4 V5 V6 ∈ lrel ∧ ra_add nc V6 k2 ∈ lrel) $ by ex_intro [l59]
l61: $ G ⇒ ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = V5 ∧ t4 = k2 ∧ ra_clen_c V2 nc ∈ lrel ∧ ra_minor_idx V3 V4 V5 k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by ex_intro [l60]
l62: $ G ⇒ ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons V4 ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c V2 nc ∈ lrel ∧ ra_minor_idx V3 V4 c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by ex_intro [l61]
l63: $ G ⇒ ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c V2 nc ∈ lrel ∧ ra_minor_idx V3 i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by ex_intro [l62]
l64: $ G ⇒ ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons V2 (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c V2 nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by ex_intro [l63]
l65: $ G ⇒ ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons V1 (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by ex_intro [l64]
l66: $ G ⇒ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $ by ex_intro [l65]

lemma y1_d_minor_idx_s (G: hyps) {F C T i_v c_v k_v nc k2: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_minor_idx t1 t2 t3 t4 ⟩ ∈ cl_minor_idx_s $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ F ∃ C ∃ T ∃ i_v ∃ c_v ∃ k_v ∃ nc ∃ k2 (t1 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t2 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t3 = c_v ∧ t4 = k2 ∧ ra_clen_c C nc ∈ lrel ∧ ra_minor_idx T i_v c_v k_v ∈ lrel ∧ ra_add nc k_v k2 ∈ lrel) $
----
