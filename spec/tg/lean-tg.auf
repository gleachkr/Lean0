lemma y1_k_mwalk_res (G: hyps): $ G ⇒ cl_mwalk_res ⊆ y1_lab kr_mwalk (suc kr_mwalk) $
----
l1: $ G , x ∊ cl_mwalk_res ⇒ x ∊ cl_mwalk_res $ by ax
l2: $ G , x ∊ cl_mwalk_res ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b ∃ c ∃ f ∃ g ∃ i ∃ j ∃ k ∃ d ∃ e ∃ h ∃ l ∃ m ∃ n ∃ o ∃ p ∃ q ∃ r ∃ t ∃ x0 ∃ x1 (x = ⟨ scons (ra_add b z f) (scons (ra_add v u g) (scons (ra_add f w i) (scons (ra_add i g j) (scons (ra_add j c k) (scons (ra_lift g b n o) (scons (ra_lift c ⟨ kc_nz , ∅ ⟩ o p) (scons (ra_nidx y w d) (scons (ra_rehead q ⟨ kc_bvar , scons e ∅ ⟩ d p r) (scons (ra_spine ⟨ kc_bvar , scons k ∅ ⟩ q z) (scons (ra_add c b h) (scons (ra_add h g l) (scons (ra_add e ⟨ kc_s , scons w ∅ ⟩ l) (scons (ra_pargs ⟨ kc_ind_ctor , scons y (scons w (scons a ∅)) ⟩ l z t) (scons (ra_pargs t c b x0) (scons (ra_pis m ⟨ kc_app , scons r (scons x0 ∅) ⟩ x1) ∅))))))))))))))) , ra_mwalk y z u v w a b b c m n x1 ⟩) $ by cab_elim [l1]
