lemma y1_e_rwalk_res (G: hyps) {D np n_v m_v v_v d_v Acc K: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 V1 V2 V3 V4 V5 V6 V7 V8: set):
  $ G ⇒ ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ = ⟨ scons (ra_npis V8 ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk V1 V2 V3 V4 V5 V6 V6 V7 V8 V7 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ d_v ∃ Acc ∃ K (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = d_v ∧ t7 = d_v ∧ t8 = Acc ∧ t9 = K ∧ t10 = Acc ∧ ra_npis K ⟨ kc_nz , ∅ ⟩ ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_npis V8 ⟨ kc_nz , ∅ ⟩) ∅ , ra_rwalk V1 V2 V3 V4 V5 V6 V6 V7 V8 V7 ⟩ = ⟨ pp , ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_npis V8 ⟨ kc_nz , ∅ ⟩) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10) $ by opair_isset
l5: $ G ⇒ isset (ra_rwalk V1 V2 V3 V4 V5 V6 V6 V7 V8 V7) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_npis V8 ⟨ kc_nz , ∅ ⟩) ∅ ∧ ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 = ra_rwalk V1 V2 V3 V4 V5 V6 V6 V7 V8 V7 $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_npis V8 ⟨ kc_nz , ∅ ⟩) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_rwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 = ra_rwalk V1 V2 V3 V4 V5 V6 V6 V7 V8 V7 $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t10 $ by isset_var
l11: $ G ⇒ scons t10 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset t9 $ by isset_var
l13: $ G ⇒ scons t9 (scons t10 ∅) ∈ fseq y1_vv $ by y1_fs [l12, l11]
l14: $ G ⇒ isset t8 $ by isset_var
l15: $ G ⇒ scons t8 (scons t9 (scons t10 ∅)) ∈ fseq y1_vv $ by y1_fs [l14, l13]
l16: $ G ⇒ isset t7 $ by isset_var
l17: $ G ⇒ scons t7 (scons t8 (scons t9 (scons t10 ∅))) ∈ fseq y1_vv $ by y1_fs [l16, l15]
l18: $ G ⇒ isset t6 $ by isset_var
