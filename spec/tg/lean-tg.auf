lemma y1_o_ctor_ty (G: hyps) {D b_v P N T i_v c_v np n_v m_v F K K2 K3 R C: set} (pp t1 t2 t3 t4: set):
  $ G ⇒ ⟨ pp , ra_ctor_ty t1 t2 t3 t4 ⟩ ∈ pr_ctor_ty $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ K3 ∃ R ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_rst D N K2 K3 ∈ lrel ∧ ra_pis P K3 R ∈ lrel) $
----
l1: $ G ⇒ ∃ D ∃ b_v ∃ P ∃ N ∃ T ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ F ∃ K ∃ K2 ∃ K3 ∃ R ∃ C (t1 = D ∧ t2 = i_v ∧ t3 = c_v ∧ t4 = R ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_rst D N K2 K3 ∈ lrel ∧ ra_pis P K3 R ∈ lrel) $ by y1_d_ctor_ty_i [#1, #2]

lemma y1_e_ihval_lam (G: hyps) {D np n_v m_v v_v nf fld y_v j_v A B IH: set} (pp t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12: set):
  $ G ⇒ ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ = ⟨ scons (ra_ihval V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V11 V12) ∅ , ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 ⟨ kc_pi , scons V10 (scons V11 ∅) ⟩ ⟨ kc_lam , scons V10 (scons V12 ∅) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ m_v ∃ v_v ∃ nf ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = m_v ∧ t5 = v_v ∧ t6 = nf ∧ t7 = fld ∧ t8 = y_v ∧ t9 = j_v ∧ t10 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t11 = ⟨ kc_lam , scons A (scons IH ∅) ⟩ ∧ ra_ihval D np n_v m_v v_v nf fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ihval V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V11 V12) ∅ , ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 ⟨ kc_pi , scons V10 (scons V11 ∅) ⟩ ⟨ kc_lam , scons V10 (scons V12 ∅) ⟩ ⟩ = ⟨ pp , ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_ihval V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V11 V12) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11) $ by opair_isset
l5: $ G ⇒ isset (ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 ⟨ kc_pi , scons V10 (scons V11 ∅) ⟩ ⟨ kc_lam , scons V10 (scons V12 ∅) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_ihval V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V11 V12) ∅ ∧ ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 = ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 ⟨ kc_pi , scons V10 (scons V11 ∅) ⟩ ⟨ kc_lam , scons V10 (scons V12 ∅) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_ihval V1 V2 V3 V4 V5 V6 V7 ⟨ kc_s , scons V8 ∅ ⟩ V9 V11 V12) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_ihval t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 = ra_ihval V1 V2 V3 V4 V5 V6 V7 V8 V9 ⟨ kc_pi , scons V10 (scons V11 ∅) ⟩ ⟨ kc_lam , scons V10 (scons V12 ∅) ⟩ $ by and_elim_r [l6]
