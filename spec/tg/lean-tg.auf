ofsort_atom_cases
-----------------
l1: $ G ⇒ ⟨ ks_atom , t ⟩ ∈ sorted lsig lopen $ by ofsort_elim [#1]
l2: $ G ⇒ ks_atom ∈ ω $ by v1_ks_atom
l3: $ G ⇒ isset ks_atom $ by wcel_isset [l2]
l4: $ G , k = ks_atom ⇒ k = ks_atom $ by ax
l5: $ G , k = ks_atom ⇒ ks_atom = k $ by eq_sym [l4]
l6: $ G , k = ks_atom ⇒ t = t $ by eq_refl
l7: $ G , k = ks_atom ⇒ ⟨ ks_atom , t ⟩ = ⟨ k , t ⟩ $ by opair_eq [l5, l6]
l8: $ G , k = ks_atom ⇒ ⟨ ks_atom , t ⟩ ∈ sorted lsig lopen $ by weaken [l1]
l9: $ G , k = ks_atom ⇒ ⟨ k , t ⟩ ∈ sorted lsig lopen $ by wcel_eq_l [l7, l8]
l10: $ G , k = ks_atom ⇒ sig lsig lopen $ by lsig_sig
l11: $ G , k = ks_atom ⇒ (∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩)) ∨ (k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩)) $ by sorted_elim [l10, l9]
l12: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by ax
l13: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ by and_elim_l [l12]
l14: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l12]
l15: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ b ∊ fseq (trees ω) $ by and_elim_l [l14]
l16: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l14]
l17: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ cdm b = cdm a $ by and_elim_l [l16]
l18: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ $ by and_elim_r [l16]
l19: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ szip a b ⊆ sorted lsig lopen $ by and_elim_l [l18]
l20: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ t = ⟨ c , b ⟩ $ by and_elim_r [l18]
l21: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ k = ks_atom $ by ax
l22: $ G , k = ks_atom , ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩ ⇒ v1_d_atom n t $ by v1_node_atom [l13, l21, l15, l17, l19, l20]
l23: $ G , k = ks_atom , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l24: $ G , k = ks_atom , ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_atom n t $ by ex_elim [l23, l22]
l25: $ G , k = ks_atom , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l26: $ G , k = ks_atom , ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_atom n t $ by ex_elim [l25, l24]
l27: $ G , k = ks_atom , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) $ by ax
l28: $ G , k = ks_atom , ∃ c ∃ a ∃ b (⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig ∧ b ∊ fseq (trees ω) ∧ cdm b = cdm a ∧ szip a b ⊆ sorted lsig lopen ∧ t = ⟨ c , b ⟩) ⇒ v1_d_atom n t $ by ex_elim [l27, l26]
l29: $ G , k = ks_atom , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by ax
l30: $ G , k = ks_atom , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by and_elim_r [l29]
l31: $ G , k = ks_atom , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ (t = ⟨ kc_choice_atom , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by or_intro_r [l30]
l32: $ G , k = ks_atom , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ (t = ⟨ kc_quot_sound_atom , ∅ ⟩) ∨ (t = ⟨ kc_choice_atom , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by or_intro_r [l31]
l33: $ G , k = ks_atom , k ∊ lopen ∧ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) ⇒ v1_d_atom n t $ by or_intro_r [l32]
l34: $ G , k = ks_atom ⇒ v1_d_atom n t $ by or_elim [l11, l28, l33]
l35: $ G ⇒ (t = ⟨ kc_propext_atom , ∅ ⟩) ∨ (t = ⟨ kc_quot_sound_atom , ∅ ⟩) ∨ (t = ⟨ kc_choice_atom , ∅ ⟩) ∨ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $ by isset_elim [l3, l34]

--| The cases of sort `ctx`.
def v1_d_ctx {x y: set} (t: set): fml = $ (t = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y (t = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $

lemma v1_node_ctx (G: hyps) {x y: set} (c k a b t: set):
  $ G ⇒ ⟨ c , ⟨ k , a ⟩ ⟩ ∈ lsig $ > $ G ⇒ k = ks_ctx $ > $ G ⇒ b ∊ fseq (trees ω) $ >
  $ G ⇒ cdm b = cdm a $ > $ G ⇒ szip a b ⊆ sorted lsig lopen $ > $ G ⇒ t = ⟨ c , b ⟩ $ >
  $ G ⇒ v1_d_ctx x y t $
----
l1: $ G ⇒ ks_nat ∈ ks_ctx $ by v1_lt_nat_ctx
l2: $ G ⇒ k = ks_nat → ⊥ $ by v1_ne_gt [#2, l1]
l3: $ G ⇒ ks_lvl ∈ ks_ctx $ by v1_lt_lvl_ctx
l4: $ G ⇒ k = ks_lvl → ⊥ $ by v1_ne_gt [#2, l3]
l5: $ G ⇒ ks_lvls ∈ ks_ctx $ by v1_lt_lvls_ctx
l6: $ G ⇒ k = ks_lvls → ⊥ $ by v1_ne_gt [#2, l5]
l7: $ G ⇒ ks_expr ∈ ks_ctx $ by v1_lt_expr_ctx
l8: $ G ⇒ k = ks_expr → ⊥ $ by v1_ne_gt [#2, l7]
l9: $ G ⇒ ks_atom ∈ ks_ctx $ by v1_lt_atom_ctx
l10: $ G ⇒ k = ks_atom → ⊥ $ by v1_ne_gt [#2, l9]
l11: $ G ⇒ ks_ctx ∈ ks_bin $ by v1_lt_ctx_bin
l12: $ G ⇒ k = ks_bin → ⊥ $ by v1_ne_lt [#2, l11]
l13: $ G ⇒ ks_ctx ∈ ks_blk $ by v1_lt_ctx_blk
l14: $ G ⇒ k = ks_blk → ⊥ $ by v1_ne_lt [#2, l13]
l15: $ G ⇒ ks_ctx ∈ ks_ind $ by v1_lt_ctx_ind
l16: $ G ⇒ k = ks_ind → ⊥ $ by v1_ne_lt [#2, l15]
l17: $ G ⇒ ks_ctx ∈ ks_tys $ by v1_lt_ctx_tys
l18: $ G ⇒ k = ks_tys → ⊥ $ by v1_ne_lt [#2, l17]
