lemma y1_e_afree_ind_rec (G: hyps) {D i_v v_v: set} (pp t1 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_ind_rec , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ v_v (t1 = ⟨ kc_ind_rec , scons V1 (scons V2 (scons v_v ∅)) ⟩) $ by ex_intro [l21]
l23: $ G ⇒ ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons V1 (scons i_v (scons v_v ∅)) ⟩) $ by ex_intro [l22]
l24: $ G ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_intro [l23]

lemma y1_d_afree_ind_rec (G: hyps) {D i_v v_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_ind_rec $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_rec ⇒ x ∊ cl_afree_ind_rec $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_rec ⇒ ∃ y ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by y1_e_afree_ind_rec [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z ∃ u (x = ⟨ ∅ , ra_afree ⟨ kc_ind_rec , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_ind_rec ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) $ by wcel_elim [#1, l13]

lemma y1_e_afree_proj (G: hyps) {b_v i_v e_v: set} (pp t1 V1 V2 V3: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree V3) ∅ , ra_afree ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_afree V3) ∅ , ra_afree ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (scons (ra_afree V3) ∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩) $ by opair_isset
l6: $ G ⇒ pp = scons (ra_afree V3) ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = scons (ra_afree V3) ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ crn pp = crn (scons (ra_afree V3) ∅) $ by crn_eq [l7]
l23: $ G ⇒ crn (scons (ra_afree V3) ∅) ⊆ lrel $ by subset_eq_l [l22, #2]
l24: $ G ⇒ isset (ra_afree V3) $ by opair_isset
l25: $ G ⇒ ra_afree V3 ∈ lrel $ by crn_scons_head [l24, l23]
l26: $ G ⇒ t1 = ⟨ kc_proj , scons V1 (scons V2 (scons V3 ∅)) ⟩ ∧ ra_afree V3 ∈ lrel $ by and_intro [l21, l25]
l27: $ G ⇒ ∃ e_v (t1 = ⟨ kc_proj , scons V1 (scons V2 (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by ex_intro [l26]
l28: $ G ⇒ ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons V1 (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by ex_intro [l27]
l29: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by ex_intro [l28]

lemma y1_d_afree_proj (G: hyps) {b_v i_v e_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_proj $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_proj ⇒ x ∊ cl_afree_proj $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_proj ⇒ ∃ y ∃ z ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩ ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by y1_e_afree_proj [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_afree t1 ⟩ , ∃ z ∃ u (x = ⟨ scons (ra_afree u) ∅ , ra_afree ⟨ kc_proj , scons y (scons z (scons u ∅)) ⟩ ⟩) ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_proj ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by ex_elim [l2, l12]
l14: $ G ⇒ ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) $ by wcel_elim [#1, l13]

lemma y1_e_afree_quot (G: hyps) {u_v: set} (pp t1 V1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_quot , scons V1 ∅ ⟩ ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) $
----
l1: $ G ⇒ ⟨ ∅ , ra_afree ⟨ kc_quot , scons V1 ∅ ⟩ ⟩ = ⟨ pp , ra_afree t1 ⟩ $ by eq_sym [#1]
l2: $ G ⇒ isset (∅) $ by y1_opair_set_l [l1]
l3: $ G ⇒ isset pp $ by isset_var
l4: $ G ⇒ isset (ra_afree t1) $ by opair_isset
l5: $ G ⇒ isset (ra_afree ⟨ kc_quot , scons V1 ∅ ⟩) $ by opair_isset
l6: $ G ⇒ pp = ∅ ∧ ra_afree t1 = ra_afree ⟨ kc_quot , scons V1 ∅ ⟩ $ by opair_inj_c [#1, l3, l4, l2, l5]
l7: $ G ⇒ pp = ∅ $ by and_elim_l [l6]
l8: $ G ⇒ ra_afree t1 = ra_afree ⟨ kc_quot , scons V1 ∅ ⟩ $ by and_elim_r [l6]
l9: $ G ⇒ ∅ ∈ fseq y1_vv $ by fseq_empty
l10: $ G ⇒ isset t1 $ by isset_var
l11: $ G ⇒ scons t1 ∅ ∈ fseq y1_vv $ by y1_fs [l10, l9]
l12: $ G ⇒ isset ⟨ kc_quot , scons V1 ∅ ⟩ $ by opair_isset
l13: $ G ⇒ scons ⟨ kc_quot , scons V1 ∅ ⟩ ∅ ∈ fseq y1_vv $ by y1_fs [l12, l9]
l14: $ G ⇒ kr_afree ∈ ω $ by x1_kr_afree
l15: $ G ⇒ isset kr_afree $ by wcel_isset [l14]
l16: $ G ⇒ isset (scons t1 ∅) $ by wcel_isset [l11]
l17: $ G ⇒ isset (scons ⟨ kc_quot , scons V1 ∅ ⟩ ∅) $ by wcel_isset [l13]
l18: $ G ⇒ kr_afree = kr_afree ∧ scons t1 ∅ = scons ⟨ kc_quot , scons V1 ∅ ⟩ ∅ $ by opair_inj_c [l8, l15, l16, l15, l17]
l19: $ G ⇒ scons t1 ∅ = scons ⟨ kc_quot , scons V1 ∅ ⟩ ∅ $ by and_elim_r [l18]
l20: $ G ⇒ t1 = ⟨ kc_quot , scons V1 ∅ ⟩ ∧ ∅ = ∅ $ by y1_scons_inj [l19, l10, l12, l9, l9]
l21: $ G ⇒ t1 = ⟨ kc_quot , scons V1 ∅ ⟩ $ by and_elim_l [l20]
l22: $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by ex_intro [l21]

lemma y1_d_afree_quot (G: hyps) {u_v: set} (pp t1: set):
  $ G ⇒ ⟨ pp , ra_afree t1 ⟩ ∈ cl_afree_quot $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) $
----
l1: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot ⇒ x ∊ cl_afree_quot $ by ax
l2: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot ⇒ ∃ y (x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ pp , ra_afree t1 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ ⇒ ⟨ pp , ra_afree t1 ⟩ = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x = ⟨ ∅ , ra_afree ⟨ kc_quot , scons y ∅ ⟩ ⟩ ⇒ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by y1_e_afree_quot [l6, l7]
l9: $ G , x = ⟨ pp , ra_afree t1 ⟩ , x ∊ cl_afree_quot ⇒ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by ex_elim [l2, l8]
l10: $ G ⇒ ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) $ by wcel_elim [#1, l9]

