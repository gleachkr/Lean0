l15: $ G , ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_spz_ctors_nil ∪ cl_spz_ctors_cons ⇒ ∃ D ∃ N ∃ I ∃ X ∃ ni ∃ npi (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ I ∃ N ∃ NI ∃ X ∃ K ∃ K1 ∃ K2 ∃ K3 ∃ K4 ∃ ni ∃ npi ∃ C ∃ C2 (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = ⟨ kc_ccons , scons K4 (scons C2 ∅) ⟩ ∧ ra_sinst I ⟨ kc_nz , ∅ ⟩ ni npi K K1 ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_rst I NI K1 K2 ∈ lrel ∧ ra_afree K2 ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X K2 K3 ∈ lrel ∧ ra_spz D N ⟨ kc_nz , ∅ ⟩ K3 K4 ∈ lrel ∧ ra_spz_ctors D N I X ni npi C C2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ⟩ ∈ cl_spz_ctors_nil ∪ cl_spz_ctors_cons → ∃ D ∃ N ∃ I ∃ X ∃ ni ∃ npi (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ I ∃ N ∃ NI ∃ X ∃ K ∃ K1 ∃ K2 ∃ K3 ∃ K4 ∃ ni ∃ npi ∃ C ∃ C2 (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = ⟨ kc_ccons , scons K4 (scons C2 ∅) ⟩ ∧ ra_sinst I ⟨ kc_nz , ∅ ⟩ ni npi K K1 ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_rst I NI K1 K2 ∈ lrel ∧ ra_afree K2 ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X K2 K3 ∈ lrel ∧ ra_spz D N ⟨ kc_nz , ∅ ⟩ K3 K4 ∈ lrel ∧ ra_spz_ctors D N I X ni npi C C2 ∈ lrel) $ by imp_intro [l15]
l17: $ G ⇒ ∃ D ∃ N ∃ I ∃ X ∃ ni ∃ npi (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_cnil , ∅ ⟩) ∨ ∃ D ∃ I ∃ N ∃ NI ∃ X ∃ K ∃ K1 ∃ K2 ∃ K3 ∃ K4 ∃ ni ∃ npi ∃ C ∃ C2 (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = ⟨ kc_ccons , scons K4 (scons C2 ∅) ⟩ ∧ ra_sinst I ⟨ kc_nz , ∅ ⟩ ni npi K K1 ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_rst I NI K1 K2 ∈ lrel ∧ ra_afree K2 ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X K2 K3 ∈ lrel ∧ ra_spz D N ⟨ kc_nz , ∅ ⟩ K3 K4 ∈ lrel ∧ ra_spz_ctors D N I X ni npi C C2 ∈ lrel) $ by imp_elim [l16, #1]

lemma y1_e_aux_data_i (G: hyps) {D I b_v bi_v P Pi N T Ti j_v i_v npi ni mi X F Fi C Ci: set} (pp t1 t2 t3 t4 t5 V1 V2 V3 V4 V5 V6 V7 V8 V9 V10 V11 V12 V13 V14 V15 V16 V17 V18 V19: set):
  $ G ⇒ ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_ind_data V1 V3 V5 V8) (scons (ra_ind_nested V1 V7) (scons (ra_ind_data V2 V4 V6 V9) (scons (ra_nth_ty V8 V10 V16 V18) (scons (ra_nth_ty V9 V11 V17 V19) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V15 V17 V16) (scons (ra_ind_arity V2 V12 V13 V14) (scons (ra_spz_ctors V1 V7 V2 V15 V13 V12 V19 V18) ∅))))))) , ra_aux_data V1 V2 V15 V10 V11 ⟩ $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $
----
l1: $ G ⇒ ⟨ scons (ra_ind_data V1 V3 V5 V8) (scons (ra_ind_nested V1 V7) (scons (ra_ind_data V2 V4 V6 V9) (scons (ra_nth_ty V8 V10 V16 V18) (scons (ra_nth_ty V9 V11 V17 V19) (scons (ra_pinst ⟨ kc_nz , ∅ ⟩ V15 V17 V16) (scons (ra_ind_arity V2 V12 V13 V14) (scons (ra_spz_ctors V1 V7 V2 V15 V13 V12 V19 V18) ∅))))))) , ra_aux_data V1 V2 V15 V10 V11 ⟩ = ⟨ pp , ra_aux_data t1 t2 t3 t4 t5 ⟩ $ by eq_sym [#1]
