lemma y2_nfields_in (GG: hyps):
  $ GG ⇒ horn lprog ⊆ y2_P_nfields lrel $
----
l1: $ GG ⇒ hprog lprog latoms $ by lprog_hprog
l2: $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_nfields lrel → c ∊ y2_P_nfields lrel) $ by y2_nfields_st
l3: $ GG ⇒ horn lprog ⊆ y2_P_nfields lrel $ by horn_ind [l1, l2]

lrel_nfields_det
----------------
l1: $ G ⇒ horn lprog ⊆ y2_P_nfields lrel $ by y2_nfields_in
l2: $ G ⇒ ra_nfields t1 t2 t3 u4 ∈ y2_P_nfields lrel $ by wcel_subset [l1, #1]
l3: $ G ⇒ u4 = v4 $ by y2_nfields_ih [l2, #2]

--| The atoms of `pargs` whose variants in `L` with the same inputs have the same outputs.
def y2_P_pargs (L: class) (.c .x1 .x2 .x3 .x4 .x6: set): class = $ {c | ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_pargs , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_pargs , scons x1 (scons x2 (scons x3 (scons x6 ∅))) ⟩ ∈ L → x4 = x6))} $

lemma y2_pargs_ih (GG: hyps) (q1 q2 q3 q4 w4: set):
  $ GG ⇒ ra_pargs q1 q2 q3 q4 ∈ y2_P_pargs lrel $ > $ GG ⇒ ra_pargs q1 q2 q3 w4 ∈ lrel $ > $ GG ⇒ q4 = w4 $
----
l1: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ c ∊ y2_P_pargs lrel $ by ax
l2: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ∀ x1 ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_pargs , scons x1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_pargs , scons x1 (scons x2 (scons x3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by cab_elim [l1]
l3: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ∀ x2 ∀ x3 ∀ x4 (c = ⟨ kr_pargs , scons q1 (scons x2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_pargs , scons q1 (scons x2 (scons x3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by all_elim [l2]
l4: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ∀ x3 ∀ x4 (c = ⟨ kr_pargs , scons q1 (scons q2 (scons x3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_pargs , scons q1 (scons q2 (scons x3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by all_elim [l3]
l5: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ∀ x4 (c = ⟨ kr_pargs , scons q1 (scons q2 (scons q3 (scons x4 ∅))) ⟩ → ∀ x6 (⟨ kr_pargs , scons q1 (scons q2 (scons q3 (scons x6 ∅))) ⟩ ∈ lrel → x4 = x6)) $ by all_elim [l4]
l6: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ c = ⟨ kr_pargs , scons q1 (scons q2 (scons q3 (scons q4 ∅))) ⟩ → ∀ x6 (⟨ kr_pargs , scons q1 (scons q2 (scons q3 (scons x6 ∅))) ⟩ ∈ lrel → q4 = x6) $ by all_elim [l5]
l7: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ c = ra_pargs q1 q2 q3 q4 $ by ax
l8: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ∀ x6 (⟨ kr_pargs , scons q1 (scons q2 (scons q3 (scons x6 ∅))) ⟩ ∈ lrel → q4 = x6) $ by imp_elim [l6, l7]
l9: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ra_pargs q1 q2 q3 w4 ∈ lrel → q4 = w4 $ by all_elim [l8]
l10: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ ra_pargs q1 q2 q3 w4 ∈ lrel $ by weaken [#2]
l11: $ GG , c = ra_pargs q1 q2 q3 q4 , c ∊ y2_P_pargs lrel ⇒ q4 = w4 $ by imp_elim [l9, l10]
l12: $ GG ⇒ q4 = w4 $ by wcel_elim [#1, l11]

lemma y2_pargs_ihc (GG: hyps) (Q1 Q2 Q3 Q4 W4: class):
  $ GG ⇒ isset Q1 $ > $ GG ⇒ isset Q2 $ > $ GG ⇒ isset Q3 $ > $ GG ⇒ isset Q4 $ > $ GG ⇒ isset W4 $ > $ GG ⇒ ra_pargs Q1 Q2 Q3 Q4 ∈ y2_P_pargs lrel $ > $ GG ⇒ ra_pargs Q1 Q2 Q3 W4 ∈ lrel $ > $ GG ⇒ Q4 = W4 $
----
l1: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ a = Q1 $ by ax
l2: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ b = Q2 $ by ax
l3: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ d = Q3 $ by ax
l4: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ e = Q4 $ by ax
l5: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ f = W4 $ by ax
l6: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ Q1 = a $ by eq_sym [l1]
l7: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ Q2 = b $ by eq_sym [l2]
l8: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ Q3 = d $ by eq_sym [l3]
l9: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ Q4 = e $ by eq_sym [l4]
l10: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ W4 = f $ by eq_sym [l5]
l11: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ ∅ = ∅ $ by eq_refl
l12: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ scons Q4 ∅ = scons e ∅ $ by scons_eq [l9, l11]
l13: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ scons Q3 (scons Q4 ∅) = scons d (scons e ∅) $ by scons_eq [l8, l12]
l14: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ scons Q2 (scons Q3 (scons Q4 ∅)) = scons b (scons d (scons e ∅)) $ by scons_eq [l7, l13]
l15: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ scons Q1 (scons Q2 (scons Q3 (scons Q4 ∅))) = scons a (scons b (scons d (scons e ∅))) $ by scons_eq [l6, l14]
l16: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ kr_pargs = kr_pargs $ by eq_refl
l17: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ ra_pargs Q1 Q2 Q3 Q4 = ra_pargs a b d e $ by opair_eq [l16, l15]
l18: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ ra_pargs Q1 Q2 Q3 Q4 ∈ y2_P_pargs lrel $ by weaken [#6]
l19: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ ra_pargs a b d e ∈ y2_P_pargs lrel $ by wcel_eq_l [l17, l18]
l20: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ ra_pargs Q1 Q2 Q3 W4 ∈ lrel $ by weaken [#7]
l21: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ ra_pargs a b d f ∈ lrel $ by x1_eq_pargs [l20, l6, l7, l8, l10]
l22: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ e = f $ by y2_pargs_ih [l19, l21]
l23: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ Q4 = f $ by eq_trans [l9, l22]
l24: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 , f = W4 ⇒ Q4 = W4 $ by eq_trans [l23, l5]
l25: $ GG , a = Q1 , b = Q2 , d = Q3 , e = Q4 ⇒ Q4 = W4 $ by isset_elim [#5, l24]
l26: $ GG , a = Q1 , b = Q2 , d = Q3 ⇒ Q4 = W4 $ by isset_elim [#4, l25]
l27: $ GG , a = Q1 , b = Q2 ⇒ Q4 = W4 $ by isset_elim [#3, l26]
l28: $ GG , a = Q1 ⇒ Q4 = W4 $ by isset_elim [#2, l27]
l29: $ GG ⇒ Q4 = W4 $ by isset_elim [#1, l28]

lemma y2_pargs_i1 (GG: hyps) {X d: set} (o q1 q2 q3 q4: set) (ph: fml):
  $ GG ⇒ ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ ∈ cl_pargs_z $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_pargs lrel $ > $ GG ⇒ ∀ X ∀ d (q1 = X ∧ q2 = d ∧ q3 = ⟨ kc_nz , ∅ ⟩ ∧ q4 = X → ph) $ > $ GG ⇒ ph $
----
l1: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_z ⇒ w ∊ cl_pargs_z $ by ax
l2: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_z ⇒ ∃ X ∃ d (w = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩) $ by cab_elim [l1]
l3: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_z , w = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩ ⇒ w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ $ by ax
l4: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_z , w = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩ ⇒ w = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩ $ by ax
l5: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_z , w = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩ ⇒ ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ = w $ by eq_sym [l3]
l6: $ GG , w = ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ , w ∊ cl_pargs_z , w = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩ ⇒ ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ = ⟨ ∅ , ra_pargs X d ⟨ kc_nz , ∅ ⟩ X ⟩ $ by eq_trans [l5, l4]
