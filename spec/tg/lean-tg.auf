lemma y1_d_spz_proj (G: hyps) {D N d_v b_v i_v e_v e2: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $
----
l1: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_proj ⇒ x ∊ cl_spz_proj $ by ax
l2: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_proj ⇒ ∃ y ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by cab_elim [l1]
l3: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ $ by ax
l4: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = x $ by eq_sym [l3]
l5: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ $ by ax
l6: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ $ by eq_trans [l4, l5]
l7: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ crn pp ⊆ lrel $ by weaken [#2]
l8: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩ ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by y1_e_spz_proj [l6, l7]
l9: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l10: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l9, l8]
l11: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l12: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l11, l10]
l13: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l14: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l13, l12]
l15: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l16: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l15, l14]
l17: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l18: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l17, l16]
l19: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) $ by ax
l20: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , ∃ z ∃ u ∃ v ∃ w ∃ a ∃ b (x = ⟨ scons (ra_spz y z u a b) ∅ , ra_spz y z u ⟨ kc_proj , scons v (scons w (scons a ∅)) ⟩ ⟨ kc_proj , scons v (scons w (scons b ∅)) ⟩ ⟩) ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l19, l18]
l21: $ G , x = ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ , x ∊ cl_spz_proj ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by ex_elim [l2, l20]
l22: $ G ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by wcel_elim [#1, l21]

lemma y1_o_spz (G: hyps) {D N d_v e_v np n_v m_v n0 e2 f_v a_v f2 a2 A b_v A2 b2 i_v: set} (pp t1 t2 t3 t4 t5: set):
  $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ pr_spz $ > $ G ⇒ crn pp ⊆ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) ∨ ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $
----
l1: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj $ by ax
l2: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ crn pp ⊆ lrel $ by weaken [#2]
l3: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by y1_d_spz_proj [l1, l2]
l4: $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj → ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by imp_intro [l3]
l5: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj $ by ax
l6: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∨ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj $ by v1_wcel_cun_elim [l5]
l7: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi $ by ax
l8: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ⇒ crn pp ⊆ lrel $ by weaken [#2]
l9: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) $ by y1_d_spz_pi [l7, l8]
l10: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by or_intro_l [l9]
l11: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj $ by ax
l12: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj → ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by weaken [l4]
l13: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by imp_elim [l12, l11]
l14: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_proj ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by or_intro_r [l13]
l15: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by or_elim [l6, l10, l14]
l16: $ G ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_pi ∪ cl_spz_proj → ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by imp_intro [l15]
l17: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) $ by ax
l18: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∨ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ (cl_spz_pi ∪ cl_spz_proj) $ by v1_wcel_cun_elim [l17]
l19: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ⇒ ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam $ by ax
l20: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ⇒ crn pp ⊆ lrel $ by weaken [#2]
l21: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) $ by y1_d_spz_lam [l19, l20]
l22: $ G , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj) , ⟨ pp , ra_spz t1 t2 t3 t4 t5 ⟩ ∈ cl_spz_lam ⇒ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨ ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $ by or_intro_l [l21]
