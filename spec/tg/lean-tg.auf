l6: $ G ⇒ cl_band_00 ⊆ y1_lab kr_band (suc kr_band) $ by y1_k_band_00
l7: $ G ⇒ cl_band_00 ∪ (cl_band_01 ∪ (cl_band_10 ∪ cl_band_11)) ⊆ y1_lab kr_band (suc kr_band) $ by cun_least [l6, l5]
l8: $ G ⇒ cl_band_0r ⊆ y1_lab kr_band (suc kr_band) $ by y1_k_band_0r
l9: $ G ⇒ cl_band_0r ∪ (cl_band_00 ∪ (cl_band_01 ∪ (cl_band_10 ∪ cl_band_11))) ⊆ y1_lab kr_band (suc kr_band) $ by cun_least [l8, l7]
l10: $ G ⇒ cl_band_0l ⊆ y1_lab kr_band (suc kr_band) $ by y1_k_band_0l
l11: $ G ⇒ pr_band ⊆ y1_lab kr_band (suc kr_band) $ by cun_least [l10, l9]

