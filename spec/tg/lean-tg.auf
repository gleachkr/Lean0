l58: $ GG ⇒ q4 = w4 $ by or_elim [l1, l28, l57]

lemma y2_pargs_d2 (GG: hyps) (o q1 q2 q3 q4 w4: set):
  $ GG ⇒ ⟨ o , ra_pargs q1 q2 q3 q4 ⟩ ∈ cl_pargs_s $ > $ GG ⇒ crn o ⊆ horn lprog ∩ y2_P_pargs lrel $ > $ GG ⇒ ra_pargs q1 q2 q3 w4 ∈ lrel $ > $ GG ⇒ q4 = w4 $
----
l1: $ GG , q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel ⇒ q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel $ by ax
l2: $ GG , q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel ⇒ ra_pargs q1 q2 q3 w4 ∈ lrel $ by weaken [#3]
l3: $ GG , q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel ⇒ q4 = w4 $ by y2_pargs_c2 [l1, l2]
l4: $ GG ⇒ q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel → q4 = w4 $ by imp_intro [l3]
l5: $ GG ⇒ ∀ e (q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel → q4 = w4) $ by all_intro [l4]
l6: $ GG ⇒ ∀ d ∀ e (q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel → q4 = w4) $ by all_intro [l5]
l7: $ GG ⇒ ∀ b ∀ d ∀ e (q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel → q4 = w4) $ by all_intro [l6]
l8: $ GG ⇒ ∀ a ∀ b ∀ d ∀ e (q1 = a ∧ q2 = d ∧ q3 = ⟨ kc_s , scons e ∅ ⟩ ∧ q4 = ⟨ kc_app , scons b (scons ⟨ kc_bvar , scons d ∅ ⟩ ∅) ⟩ ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ lrel ∧ ra_pargs a ⟨ kc_s , scons d ∅ ⟩ e b ∈ y2_P_pargs lrel → q4 = w4) $ by all_intro [l7]
l9: $ GG ⇒ q4 = w4 $ by y2_pargs_i2 [#1, #2, l8]

lemma y2_pargs_st (GG: hyps) {o c: set}:
  $ GG ⇒ ∀ o ∀ c (⟨ o , c ⟩ ∈ lprog → crn o ⊆ horn lprog ∩ y2_P_pargs lrel → c ∊ y2_P_pargs lrel) $
----
