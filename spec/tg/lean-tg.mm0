    (csn ⟨ kc_ind_ctor , ⟨ ks_expr , scons ks_ind (scons ks_nat (scons ks_nat ∅)) ⟩ ⟩ ∪
    (csn ⟨ kc_ind_rec , ⟨ ks_expr , scons ks_ind (scons ks_nat (scons ks_lvl ∅)) ⟩ ⟩ ∪
