def ra_bsucc (a1 a2: class): class = $ ⟨ kr_bsucc , scons a1 (scons a2 ∅) ⟩ $;
def ra_bdbl (a1 a2: class): class = $ ⟨ kr_bdbl , scons a1 (scons a2 ∅) ⟩ $;
def ra_badd (a1 a2 a3: class): class = $ ⟨ kr_badd , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_baddc (a1 a2 a3: class): class = $ ⟨ kr_baddc , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_bmul (a1 a2 a3: class): class = $ ⟨ kr_bmul , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_bpow (a1 a2 a3: class): class = $ ⟨ kr_bpow , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_band (a1 a2 a3: class): class = $ ⟨ kr_band , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_bor (a1 a2 a3: class): class = $ ⟨ kr_bor , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_bxor (a1 a2 a3: class): class = $ ⟨ kr_bxor , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_ind_data (a1 a2 a3 a4: class): class = $ ⟨ kr_ind_data , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_ind_nested (a1 a2: class): class = $ ⟨ kr_ind_nested , scons a1 (scons a2 ∅) ⟩ $;
def ra_nth_ty (a1 a2 a3 a4: class): class = $ ⟨ kr_nth_ty , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_nth_ctor (a1 a2 a3: class): class = $ ⟨ kr_nth_ctor , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_clen_c (a1 a2: class): class = $ ⟨ kr_clen_c , scons a1 (scons a2 ∅) ⟩ $;
def ra_ntys (a1 a2 a3: class): class = $ ⟨ kr_ntys , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_minor_idx (a1 a2 a3 a4: class): class = $ ⟨ kr_minor_idx , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_npis (a1 a2: class): class = $ ⟨ kr_npis , scons a1 (scons a2 ∅) ⟩ $;
def ra_nth_pi (a1 a2 a3: class): class = $ ⟨ kr_nth_pi , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_isort (a1 a2 a3: class): class = $ ⟨ kr_isort , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_ind_arity (a1 a2 a3 a4: class): class = $ ⟨ kr_ind_arity , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_nidx (a1 a2 a3: class): class = $ ⟨ kr_nidx , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_nfields (a1 a2 a3 a4: class): class = $ ⟨ kr_nfields , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_ndecl (a1 a2 a3: class): class = $ ⟨ kr_ndecl , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_aux_of (a1 a2 a3 a4: class): class = $ ⟨ kr_aux_of , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_pis (a1 a2 a3: class): class = $ ⟨ kr_pis , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_lams (a1 a2 a3: class): class = $ ⟨ kr_lams , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_tys_closed (a1 a2: class): class = $ ⟨ kr_tys_closed , scons a1 (scons a2 ∅) ⟩ $;
def ra_pargs (a1 a2 a3 a4: class): class = $ ⟨ kr_pargs , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_spine (a1 a2 a3: class): class = $ ⟨ kr_spine , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_rehead (a1 a2 a3 a4 a5: class): class = $ ⟨ kr_rehead , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 ∅)))) ⟩ $;
def ra_has_arg (a1 a2: class): class = $ ⟨ kr_has_arg , scons a1 (scons a2 ∅) ⟩ $;
def ra_leaf_has (a1 a2: class): class = $ ⟨ kr_leaf_has , scons a1 (scons a2 ∅) ⟩ $;
def ra_pinst (a1 a2 a3 a4: class): class = $ ⟨ kr_pinst , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_sinst (a1 a2 a3 a4 a5 a6: class): class = $ ⟨ kr_sinst , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 ∅))))) ⟩ $;
def ra_iargs (a1 a2 a3 a4: class): class = $ ⟨ kr_iargs , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_indapp (a1 a2 a3 a4 a5 a6: class): class = $ ⟨ kr_indapp , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 ∅))))) ⟩ $;
def ra_ipos (a1 a2 a3 a4 a5: class): class = $ ⟨ kr_ipos , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 ∅)))) ⟩ $;
def ra_recfield (a1 a2 a3 a4 a5 a6: class): class = $ ⟨ kr_recfield , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 ∅))))) ⟩ $;
def ra_rst (a1 a2 a3 a4: class): class = $ ⟨ kr_rst , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_nst_hit (a1 a2 a3 a4 a5 a6: class): class = $ ⟨ kr_nst_hit , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 ∅))))) ⟩ $;
def ra_spz (a1 a2 a3 a4 a5: class): class = $ ⟨ kr_spz , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 ∅)))) ⟩ $;
def ra_afree (a1: class): class = $ ⟨ kr_afree , scons a1 ∅ ⟩ $;
def ra_spz_ctors (a1 a2 a3 a4 a5 a6 a7 a8: class): class = $ ⟨ kr_spz_ctors , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 ∅))))))) ⟩ $;
def ra_aux_data (a1 a2 a3 a4 a5: class): class = $ ⟨ kr_aux_data , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 ∅)))) ⟩ $;
def ra_mty (a1 a2 a3 a4 a5 a6 a7: class): class = $ ⟨ kr_mty , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 ∅)))))) ⟩ $;
def ra_motives (a1 a2 a3 a4 a5 a6: class): class = $ ⟨ kr_motives , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 ∅))))) ⟩ $;
def ra_ihty (a1 a2 a3 a4 a5 a6 a7 a8 a9: class): class = $ ⟨ kr_ihty , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 (scons a9 ∅)))))))) ⟩ $;
def ra_mwalk (a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12: class): class = $ ⟨ kr_mwalk , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 (scons a9 (scons a10 (scons a11 (scons a12 ∅))))))))))) ⟩ $;
def ra_cminors (a1 a2 a3 a4 a5 a6 a7 a8: class): class = $ ⟨ kr_cminors , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 ∅))))))) ⟩ $;
def ra_minors (a1 a2 a3 a4 a5 a6 a7: class): class = $ ⟨ kr_minors , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 ∅)))))) ⟩ $;
def ra_rtail (a1 a2 a3 a4 a5 a6 a7 a8: class): class = $ ⟨ kr_rtail , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 ∅))))))) ⟩ $;
