  $ {w | ∃ D ∃ b ∃ P ∃ T ∃ v ∃ i ∃ c ∃ np ∃ n ∃ m ∃ k ∃ nf ∃ a ∃ mk ∃ M ∃ N ∃ F ∃ K ∃ Acc ∃ Val ∃ R1 ∃ R2 ∃ R ∃ C (w = ⟨ scons (ra_ind_data D b P T) (scons (ra_clen P np) (scons (ra_ntys T n m) (scons (ra_motives D np v ⟨ kc_nz , ∅ ⟩ T M) (scons (ra_minors D np n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N) (scons (ra_nth_ty T i F C) (scons (ra_nth_ctor C c K) (scons (ra_minor_idx T i c k) (scons (ra_npis K nf) (scons (ra_add nf m a) (scons (ra_add mk ⟨ kc_s , scons k ∅ ⟩ a) (scons (ra_pargs ⟨ kc_bvar , scons mk ∅ ⟩ ⟨ kc_nz , ∅ ⟩ nf Acc) (scons (ra_rwalk D np n m v nf ⟨ kc_nz , ∅ ⟩ Acc K Val) (scons (ra_lams N Val R1) (scons (ra_lams M R1 R2) (scons (ra_lams P R2 R) ∅))))))))))))))) , ra_rec_rhs D v i c R ⟩)} $;
