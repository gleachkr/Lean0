  $ {w | ∃ D ∃ v ∃ i ∃ c ∃ np ∃ n ∃ m ∃ mn ∃ nf ∃ ni ∃ a ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (w = ⟨ scons (ra_ind_arity D np n m) (scons (ra_nidx D i ni) (scons (ra_add m n mn) (scons (ra_add nf m a) (scons (ra_add a n d1) (scons (ra_pargs ⟨ kc_ind_rec , scons D (scons i (scons v ∅)) ⟩ d1 np e1) (scons (ra_pargs e1 a n e2) (scons (ra_pargs e2 nf m e3) (scons (ra_pargs ⟨ kc_ind_ty , scons D (scons i ∅) ⟩ d1 np Y) (scons (ra_lift mn nf res T2) (scons (ra_rehead Y e3 ni T2 e4) (scons (ra_pargs ⟨ kc_ind_ctor , scons D (scons i (scons c ∅)) ⟩ d1 np c1) (scons (ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj) (scons (ra_add io ⟨ kc_s , scons i ∅ ⟩ n) (scons (ra_add a io mo) (scons (ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0) ∅))))))))))))))) , ra_iota_lhs D v i c nf res e3 c1 maj e4 ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ⟩)} $;

--| The clauses of each relation.
def pr_le: class = $ cl_le_z ∪ cl_le_s $;
def pr_add: class = $ cl_add_z ∪ cl_add_s $;
def pr_lnth: class = $ cl_lnth_z ∪ cl_lnth_s $;
def pr_linst: class = $ cl_linst_z ∪ (cl_linst_s ∪ (cl_linst_max ∪ (cl_linst_imax ∪ cl_linst_param))) $;
def pr_lsubst: class = $ cl_lsubst_z ∪ (cl_lsubst_s ∪ (cl_lsubst_max ∪ (cl_lsubst_imax ∪ (cl_lsubst_eq ∪ (cl_lsubst_lt ∪ cl_lsubst_gt))))) $;
def pr_closed: class = $ cl_closed_bvar ∪ (cl_closed_srt ∪ (cl_closed_app ∪ (cl_closed_lam ∪ (cl_closed_pi ∪ (cl_closed_cst ∪ (cl_closed_lit ∪ (cl_closed_ind_ty ∪ (cl_closed_ind_ctor ∪ (cl_closed_ind_rec ∪ (cl_closed_proj ∪ (cl_closed_quot ∪ (cl_closed_quot_mk ∪ (cl_closed_quot_lift ∪ cl_closed_quot_ind))))))))))))) $;
def pr_lift: class = $ cl_lift_bvar_lt ∪ (cl_lift_bvar_ge ∪ (cl_lift_srt ∪ (cl_lift_app ∪ (cl_lift_lam ∪ (cl_lift_pi ∪ (cl_lift_closed ∪ cl_lift_proj)))))) $;
def pr_inst: class = $ cl_inst_bvar_lt ∪ (cl_inst_bvar_eq ∪ (cl_inst_bvar_gt ∪ (cl_inst_srt ∪ (cl_inst_app ∪ (cl_inst_lam ∪ (cl_inst_pi ∪ (cl_inst_closed ∪ cl_inst_proj))))))) $;
def pr_lookup: class = $ cl_lookup_z ∪ cl_lookup_s $;
def pr_cinst: class = $ cl_cinst_z ∪ cl_cinst_s $;
def pr_cext: class = $ cl_cext_z ∪ cl_cext_s $;
def pr_clen: class = $ cl_clen_nil ∪ cl_clen_cons $;
def pr_cnth: class = $ cl_cnth_z ∪ cl_cnth_s $;
def pr_capp: class = $ cl_capp_nil ∪ cl_capp_cons $;
def pr_bsucc: class = $ cl_bsucc_0 ∪ (cl_bsucc_d0 ∪ cl_bsucc_d1) $;
def pr_bdbl: class = $ cl_bdbl_0 ∪ (cl_bdbl_d0 ∪ cl_bdbl_d1) $;
def pr_badd: class = $ cl_badd_0l ∪ (cl_badd_0r ∪ (cl_badd_00 ∪ (cl_badd_01 ∪ (cl_badd_10 ∪ cl_badd_11)))) $;
def pr_baddc: class = $ cl_baddc_0l ∪ (cl_baddc_0r ∪ (cl_baddc_00 ∪ (cl_baddc_01 ∪ (cl_baddc_10 ∪ cl_baddc_11)))) $;
def pr_bmul: class = $ cl_bmul_0 ∪ (cl_bmul_d0 ∪ cl_bmul_d1) $;
def pr_bpow: class = $ cl_bpow_0 ∪ (cl_bpow_d0 ∪ cl_bpow_d1) $;
def pr_band: class = $ cl_band_0l ∪ (cl_band_0r ∪ (cl_band_00 ∪ (cl_band_01 ∪ (cl_band_10 ∪ cl_band_11)))) $;
def pr_bor: class = $ cl_bor_0l ∪ (cl_bor_0r ∪ (cl_bor_00 ∪ (cl_bor_01 ∪ (cl_bor_10 ∪ cl_bor_11)))) $;
def pr_bxor: class = $ cl_bxor_0l ∪ (cl_bxor_0r ∪ (cl_bxor_00 ∪ (cl_bxor_01 ∪ (cl_bxor_10 ∪ cl_bxor_11)))) $;
def pr_ind_data: class = $ cl_ind_data_i ∪ cl_ind_data_n $;
def pr_ind_nested: class = $ cl_ind_nested_mk ∪ cl_ind_nested_mkn $;
def pr_nth_ty: class = $ cl_nth_ty_z ∪ cl_nth_ty_s $;
def pr_nth_ctor: class = $ cl_nth_ctor_z ∪ cl_nth_ctor_s $;
def pr_clen_c: class = $ cl_clen_c_nil ∪ cl_clen_c_cons $;
def pr_ntys: class = $ cl_ntys_nil ∪ cl_ntys_cons $;
def pr_minor_idx: class = $ cl_minor_idx_z ∪ cl_minor_idx_s $;
def pr_npis: class = $ cl_npis_bvar ∪ (cl_npis_app ∪ cl_npis_pi) $;
def pr_nth_pi: class = $ cl_nth_pi_z ∪ cl_nth_pi_s $;
def pr_isort: class = $ cl_isort_srt ∪ cl_isort_pi $;
def pr_ind_arity: class = $ cl_ind_arity_i $;
def pr_nidx: class = $ cl_nidx_i $;
def pr_nfields: class = $ cl_nfields_i $;
def pr_ndecl: class = $ cl_ndecl_nil ∪ cl_ndecl_cons $;
def pr_aux_of: class = $ cl_aux_of_i $;
def pr_pis: class = $ cl_pis_nil ∪ cl_pis_cons $;
def pr_lams: class = $ cl_lams_nil ∪ cl_lams_cons $;
def pr_tys_closed: class = $ cl_tys_closed_nil ∪ cl_tys_closed_cons $;
def pr_pargs: class = $ cl_pargs_z ∪ cl_pargs_s $;
def pr_spine: class = $ cl_spine_z ∪ cl_spine_s $;
def pr_rehead: class = $ cl_rehead_z ∪ cl_rehead_s $;
def pr_has_arg: class = $ cl_has_arg_z ∪ cl_has_arg_s $;
def pr_leaf_has: class = $ cl_leaf_has_pi ∪ cl_leaf_has_app $;
def pr_pinst: class = $ cl_pinst_head ∪ (cl_pinst_head_c ∪ cl_pinst_app) $;
def pr_sinst: class = $ cl_sinst_done ∪ cl_sinst_step $;
def pr_iargs: class = $ cl_iargs_z ∪ cl_iargs_s $;
def pr_indapp: class = $ cl_indapp_i $;
def pr_ipos: class = $ cl_ipos_closed ∪ (cl_ipos_pi ∪ cl_ipos_app) $;
def pr_recfield: class = $ cl_recfield_pi ∪ cl_recfield_app $;
def pr_rst: class = $ cl_rst_nil ∪ (cl_rst_ty ∪ (cl_rst_ctor ∪ (cl_rst_app ∪ (cl_rst_lam ∪ (cl_rst_pi ∪ (cl_rst_proj ∪ cl_rst_refl)))))) $;
def pr_nst_hit: class = $ cl_nst_hit_z ∪ cl_nst_hit_s $;
def pr_spz: class = $ cl_spz_refl ∪ (cl_spz_hit ∪ (cl_spz_app ∪ (cl_spz_lam ∪ (cl_spz_pi ∪ cl_spz_proj)))) $;
def pr_afree: class = $ cl_afree_bvar ∪ (cl_afree_srt ∪ (cl_afree_app ∪ (cl_afree_lam ∪ (cl_afree_pi ∪ (cl_afree_cst ∪ (cl_afree_lit ∪ (cl_afree_ind_ty ∪ (cl_afree_ind_ctor ∪ (cl_afree_ind_rec ∪ (cl_afree_proj ∪ (cl_afree_quot ∪ (cl_afree_quot_mk ∪ (cl_afree_quot_lift ∪ cl_afree_quot_ind))))))))))))) $;
def pr_spz_ctors: class = $ cl_spz_ctors_nil ∪ cl_spz_ctors_cons $;
def pr_aux_data: class = $ cl_aux_data_i $;
def pr_mty: class = $ cl_mty_pi ∪ cl_mty_srt $;
def pr_motives: class = $ cl_motives_nil ∪ cl_motives_cons $;
def pr_ihty: class = $ cl_ihty_pi ∪ cl_ihty_app $;
def pr_mwalk: class = $ cl_mwalk_pi_nr ∪ (cl_mwalk_pi_rec ∪ cl_mwalk_res) $;
def pr_cminors: class = $ cl_cminors_nil ∪ cl_cminors_cons $;
def pr_minors: class = $ cl_minors_nil ∪ cl_minors_cons $;
def pr_rtail: class = $ cl_rtail_pi ∪ cl_rtail_srt $;
def pr_rec_ty: class = $ cl_rec_ty_i $;
def pr_ctor_ty: class = $ cl_ctor_ty_i $;
def pr_ihval: class = $ cl_ihval_lam ∪ cl_ihval_app $;
def pr_rwalk: class = $ cl_rwalk_pi_nr ∪ (cl_rwalk_pi_rec ∪ cl_rwalk_res) $;
def pr_rec_rhs: class = $ cl_rec_rhs_i $;
def pr_struct_like: class = $ cl_struct_like_i $;
def pr_field_ty: class = $ cl_field_ty_i $;
def pr_qinst: class = $ cl_qinst_z ∪ cl_qinst_s $;
def pr_nonrec: class = $ cl_nonrec_pi ∪ cl_nonrec_res $;
def pr_eta_ok: class = $ cl_eta_ok_i $;
def pr_projs: class = $ cl_projs_z ∪ cl_projs_s $;
def pr_clift: class = $ cl_clift_nil ∪ cl_clift_cons $;
def pr_iota_tel: class = $ cl_iota_tel_i $;
def pr_iota_lhs: class = $ cl_iota_lhs_i $;

--| The program, at the atoms.
def lprog: class =
  $ ((((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ pr_linst)) ∪ ((pr_lsubst ∪ pr_closed) ∪ (pr_lift ∪ (pr_inst ∪ pr_lookup)))) ∪ (((pr_cinst ∪ pr_cext) ∪ (pr_clen ∪ (pr_cnth ∪ pr_capp))) ∪ ((pr_bsucc ∪ pr_bdbl) ∪ (pr_badd ∪ (pr_baddc ∪ pr_bmul))))) ∪ ((((pr_bpow ∪ pr_band) ∪ (pr_bor ∪ (pr_bxor ∪ pr_ind_data))) ∪ ((pr_ind_nested ∪ pr_nth_ty) ∪ (pr_nth_ctor ∪ (pr_clen_c ∪ pr_ntys)))) ∪ (((pr_minor_idx ∪ pr_npis) ∪ (pr_nth_pi ∪ (pr_isort ∪ pr_ind_arity))) ∪ ((pr_nidx ∪ pr_nfields) ∪ (pr_ndecl ∪ (pr_aux_of ∪ pr_pis)))))) ∪ (((((pr_lams ∪ pr_tys_closed) ∪ (pr_pargs ∪ (pr_spine ∪ pr_rehead))) ∪ ((pr_has_arg ∪ pr_leaf_has) ∪ (pr_pinst ∪ (pr_sinst ∪ pr_iargs)))) ∪ (((pr_indapp ∪ pr_ipos) ∪ (pr_recfield ∪ (pr_rst ∪ pr_nst_hit))) ∪ ((pr_spz ∪ pr_afree) ∪ (pr_spz_ctors ∪ (pr_aux_data ∪ pr_mty))))) ∪ ((((pr_motives ∪ pr_ihty) ∪ (pr_mwalk ∪ (pr_cminors ∪ pr_minors))) ∪ ((pr_rtail ∪ pr_rec_ty) ∪ (pr_ctor_ty ∪ (pr_ihval ∪ pr_rwalk)))) ∪ (((pr_rec_rhs ∪ pr_struct_like) ∪ (pr_field_ty ∪ (pr_qinst ∪ pr_nonrec))) ∪ ((pr_eta_ok ∪ pr_projs) ∪ (pr_clift ∪ (pr_iota_tel ∪ pr_iota_lhs))))))) ∩
    (fseq latoms × latoms) $;
--| The derivable atoms.
def lrel: class = $ horn lprog $;

--| The relations: an atom is derivable.
def le (a1: nat) (a2: nat): wff = $ _ ⇒ ra_le (enc_nat a1) (enc_nat a2) ∈ lrel $;
def add (a1: nat) (a2: nat) (a3: nat): wff = $ _ ⇒ ra_add (enc_nat a1) (enc_nat a2) (enc_nat a3) ∈ lrel $;
def lnth (a1: lvls) (a2: nat) (a3: lvl): wff = $ _ ⇒ ra_lnth (enc_lvls a1) (enc_nat a2) (enc_lvl a3) ∈ lrel $;
def linst (a1: lvls) (a2: lvl) (a3: lvl): wff = $ _ ⇒ ra_linst (enc_lvls a1) (enc_lvl a2) (enc_lvl a3) ∈ lrel $;
def lsubst (a1: nat) (a2: lvl) (a3: lvl) (a4: lvl): wff = $ _ ⇒ ra_lsubst (enc_nat a1) (enc_lvl a2) (enc_lvl a3) (enc_lvl a4) ∈ lrel $;
def closed (a1: nat) (a2: expr): wff = $ _ ⇒ ra_closed (enc_nat a1) (enc_expr a2) ∈ lrel $;
def lift (a1: nat) (a2: nat) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_lift (enc_nat a1) (enc_nat a2) (enc_expr a3) (enc_expr a4) ∈ lrel $;
def inst (a1: nat) (a2: expr) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_inst (enc_nat a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) ∈ lrel $;
def lookup (a1: ctx) (a2: nat) (a3: expr): wff = $ _ ⇒ ra_lookup (enc_ctx a1) (enc_nat a2) (enc_expr a3) ∈ lrel $;
def cinst (a1: nat) (a2: ctx) (a3: expr) (a4: expr) (a5: ctx) (a6: ctx): wff = $ _ ⇒ ra_cinst (enc_nat a1) (enc_ctx a2) (enc_expr a3) (enc_expr a4) (enc_ctx a5) (enc_ctx a6) ∈ lrel $;
def cext (a1: nat) (a2: ctx) (a3: ctx): wff = $ _ ⇒ ra_cext (enc_nat a1) (enc_ctx a2) (enc_ctx a3) ∈ lrel $;
def clen (a1: ctx) (a2: nat): wff = $ _ ⇒ ra_clen (enc_ctx a1) (enc_nat a2) ∈ lrel $;
def cnth (a1: ctx) (a2: nat) (a3: expr): wff = $ _ ⇒ ra_cnth (enc_ctx a1) (enc_nat a2) (enc_expr a3) ∈ lrel $;
def capp (a1: ctx) (a2: ctx) (a3: ctx): wff = $ _ ⇒ ra_capp (enc_ctx a1) (enc_ctx a2) (enc_ctx a3) ∈ lrel $;
def bsucc (a1: bin) (a2: bin): wff = $ _ ⇒ ra_bsucc (enc_bin a1) (enc_bin a2) ∈ lrel $;
def bdbl (a1: bin) (a2: bin): wff = $ _ ⇒ ra_bdbl (enc_bin a1) (enc_bin a2) ∈ lrel $;
def badd (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_badd (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def baddc (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_baddc (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def bmul (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_bmul (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def bpow (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_bpow (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def band (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_band (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def bor (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_bor (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def bxor (a1: bin) (a2: bin) (a3: bin): wff = $ _ ⇒ ra_bxor (enc_bin a1) (enc_bin a2) (enc_bin a3) ∈ lrel $;
def ind_data (a1: ind) (a2: blk) (a3: ctx) (a4: tys): wff = $ _ ⇒ ra_ind_data (enc_ind a1) (enc_blk a2) (enc_ctx a3) (enc_tys a4) ∈ lrel $;
def ind_nested (a1: ind) (a2: ctx): wff = $ _ ⇒ ra_ind_nested (enc_ind a1) (enc_ctx a2) ∈ lrel $;
def nth_ty (a1: tys) (a2: nat) (a3: expr) (a4: ctors): wff = $ _ ⇒ ra_nth_ty (enc_tys a1) (enc_nat a2) (enc_expr a3) (enc_ctors a4) ∈ lrel $;
def nth_ctor (a1: ctors) (a2: nat) (a3: expr): wff = $ _ ⇒ ra_nth_ctor (enc_ctors a1) (enc_nat a2) (enc_expr a3) ∈ lrel $;
def clen_c (a1: ctors) (a2: nat): wff = $ _ ⇒ ra_clen_c (enc_ctors a1) (enc_nat a2) ∈ lrel $;
def ntys (a1: tys) (a2: nat) (a3: nat): wff = $ _ ⇒ ra_ntys (enc_tys a1) (enc_nat a2) (enc_nat a3) ∈ lrel $;
def minor_idx (a1: tys) (a2: nat) (a3: nat) (a4: nat): wff = $ _ ⇒ ra_minor_idx (enc_tys a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) ∈ lrel $;
def npis (a1: expr) (a2: nat): wff = $ _ ⇒ ra_npis (enc_expr a1) (enc_nat a2) ∈ lrel $;
def nth_pi (a1: expr) (a2: nat) (a3: expr): wff = $ _ ⇒ ra_nth_pi (enc_expr a1) (enc_nat a2) (enc_expr a3) ∈ lrel $;
def isort (a1: expr) (a2: nat) (a3: lvl): wff = $ _ ⇒ ra_isort (enc_expr a1) (enc_nat a2) (enc_lvl a3) ∈ lrel $;
def ind_arity (a1: ind) (a2: nat) (a3: nat) (a4: nat): wff = $ _ ⇒ ra_ind_arity (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) ∈ lrel $;
def nidx (a1: ind) (a2: nat) (a3: nat): wff = $ _ ⇒ ra_nidx (enc_ind a1) (enc_nat a2) (enc_nat a3) ∈ lrel $;
def nfields (a1: ind) (a2: nat) (a3: nat) (a4: nat): wff = $ _ ⇒ ra_nfields (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) ∈ lrel $;
def ndecl (a1: ctx) (a2: nat) (a3: nat): wff = $ _ ⇒ ra_ndecl (enc_ctx a1) (enc_nat a2) (enc_nat a3) ∈ lrel $;
def aux_of (a1: ind) (a2: ctx) (a3: nat) (a4: expr): wff = $ _ ⇒ ra_aux_of (enc_ind a1) (enc_ctx a2) (enc_nat a3) (enc_expr a4) ∈ lrel $;
def pis (a1: ctx) (a2: expr) (a3: expr): wff = $ _ ⇒ ra_pis (enc_ctx a1) (enc_expr a2) (enc_expr a3) ∈ lrel $;
def lams (a1: ctx) (a2: expr) (a3: expr): wff = $ _ ⇒ ra_lams (enc_ctx a1) (enc_expr a2) (enc_expr a3) ∈ lrel $;
def tys_closed (a1: ctx) (a2: tys): wff = $ _ ⇒ ra_tys_closed (enc_ctx a1) (enc_tys a2) ∈ lrel $;
def pargs (a1: expr) (a2: nat) (a3: nat) (a4: expr): wff = $ _ ⇒ ra_pargs (enc_expr a1) (enc_nat a2) (enc_nat a3) (enc_expr a4) ∈ lrel $;
def spine (a1: expr) (a2: expr) (a3: nat): wff = $ _ ⇒ ra_spine (enc_expr a1) (enc_expr a2) (enc_nat a3) ∈ lrel $;
def rehead (a1: expr) (a2: expr) (a3: nat) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_rehead (enc_expr a1) (enc_expr a2) (enc_nat a3) (enc_expr a4) (enc_expr a5) ∈ lrel $;
def has_arg (a1: expr) (a2: expr): wff = $ _ ⇒ ra_has_arg (enc_expr a1) (enc_expr a2) ∈ lrel $;
def leaf_has (a1: nat) (a2: expr): wff = $ _ ⇒ ra_leaf_has (enc_nat a1) (enc_expr a2) ∈ lrel $;
def pinst (a1: nat) (a2: expr) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_pinst (enc_nat a1) (enc_expr a2) (enc_expr a3) (enc_expr a4) ∈ lrel $;
def sinst (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_sinst (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) (enc_expr a6) ∈ lrel $;
def iargs (a1: nat) (a2: nat) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_iargs (enc_nat a1) (enc_nat a2) (enc_expr a3) (enc_expr a4) ∈ lrel $;
def indapp (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: expr) (a6: nat): wff = $ _ ⇒ ra_indapp (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) (enc_nat a6) ∈ lrel $;
def ipos (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: expr): wff = $ _ ⇒ ra_ipos (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) ∈ lrel $;
def recfield (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: expr) (a6: nat): wff = $ _ ⇒ ra_recfield (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) (enc_nat a6) ∈ lrel $;
def rst (a1: ind) (a2: ctx) (a3: expr) (a4: expr): wff = $ _ ⇒ ra_rst (enc_ind a1) (enc_ctx a2) (enc_expr a3) (enc_expr a4) ∈ lrel $;
def nst_hit (a1: ctx) (a2: nat) (a3: nat) (a4: nat) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_nst_hit (enc_ctx a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) (enc_expr a6) ∈ lrel $;
def spz (a1: ind) (a2: ctx) (a3: nat) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_spz (enc_ind a1) (enc_ctx a2) (enc_nat a3) (enc_expr a4) (enc_expr a5) ∈ lrel $;
def afree (a1: expr): wff = $ _ ⇒ ra_afree (enc_expr a1) ∈ lrel $;
def spz_ctors (a1: ind) (a2: ctx) (a3: ind) (a4: expr) (a5: nat) (a6: nat) (a7: ctors) (a8: ctors): wff = $ _ ⇒ ra_spz_ctors (enc_ind a1) (enc_ctx a2) (enc_ind a3) (enc_expr a4) (enc_nat a5) (enc_nat a6) (enc_ctors a7) (enc_ctors a8) ∈ lrel $;
def aux_data (a1: ind) (a2: ind) (a3: expr) (a4: nat) (a5: nat): wff = $ _ ⇒ ra_aux_data (enc_ind a1) (enc_ind a2) (enc_expr a3) (enc_nat a4) (enc_nat a5) ∈ lrel $;
def mty (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: lvl) (a6: expr) (a7: expr): wff = $ _ ⇒ ra_mty (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_lvl a5) (enc_expr a6) (enc_expr a7) ∈ lrel $;
def motives (a1: ind) (a2: nat) (a3: lvl) (a4: nat) (a5: tys) (a6: ctx): wff = $ _ ⇒ ra_motives (enc_ind a1) (enc_nat a2) (enc_lvl a3) (enc_nat a4) (enc_tys a5) (enc_ctx a6) ∈ lrel $;
def ihty (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: nat) (a6: nat) (a7: nat) (a8: expr) (a9: expr): wff = $ _ ⇒ ra_ihty (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_nat a5) (enc_nat a6) (enc_nat a7) (enc_expr a8) (enc_expr a9) ∈ lrel $;
def mwalk (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: nat) (a6: nat) (a7: nat) (a8: nat) (a9: nat) (a10: ctx) (a11: expr) (a12: expr): wff = $ _ ⇒ ra_mwalk (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_nat a5) (enc_nat a6) (enc_nat a7) (enc_nat a8) (enc_nat a9) (enc_ctx a10) (enc_expr a11) (enc_expr a12) ∈ lrel $;
def cminors (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: nat) (a6: nat) (a7: ctors) (a8: ctx): wff = $ _ ⇒ ra_cminors (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_nat a5) (enc_nat a6) (enc_ctors a7) (enc_ctx a8) ∈ lrel $;
def minors (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: nat) (a6: tys) (a7: ctx): wff = $ _ ⇒ ra_minors (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_nat a5) (enc_tys a6) (enc_ctx a7) ∈ lrel $;
def rtail (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: nat) (a6: nat) (a7: expr) (a8: expr): wff = $ _ ⇒ ra_rtail (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_nat a5) (enc_nat a6) (enc_expr a7) (enc_expr a8) ∈ lrel $;
def rec_ty (a1: ind) (a2: lvl) (a3: nat) (a4: expr): wff = $ _ ⇒ ra_rec_ty (enc_ind a1) (enc_lvl a2) (enc_nat a3) (enc_expr a4) ∈ lrel $;
def ctor_ty (a1: ind) (a2: nat) (a3: nat) (a4: expr): wff = $ _ ⇒ ra_ctor_ty (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_expr a4) ∈ lrel $;
def ihval (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: lvl) (a6: nat) (a7: nat) (a8: nat) (a9: nat) (a10: expr) (a11: expr): wff = $ _ ⇒ ra_ihval (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_lvl a5) (enc_nat a6) (enc_nat a7) (enc_nat a8) (enc_nat a9) (enc_expr a10) (enc_expr a11) ∈ lrel $;
def rwalk (a1: ind) (a2: nat) (a3: nat) (a4: nat) (a5: lvl) (a6: nat) (a7: nat) (a8: expr) (a9: expr) (a10: expr): wff = $ _ ⇒ ra_rwalk (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_nat a4) (enc_lvl a5) (enc_nat a6) (enc_nat a7) (enc_expr a8) (enc_expr a9) (enc_expr a10) ∈ lrel $;
def rec_rhs (a1: ind) (a2: lvl) (a3: nat) (a4: nat) (a5: expr): wff = $ _ ⇒ ra_rec_rhs (enc_ind a1) (enc_lvl a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) ∈ lrel $;
def struct_like (a1: ind) (a2: nat): wff = $ _ ⇒ ra_struct_like (enc_ind a1) (enc_nat a2) ∈ lrel $;
def field_ty (a1: ind) (a2: nat) (a3: nat) (a4: expr): wff = $ _ ⇒ ra_field_ty (enc_ind a1) (enc_nat a2) (enc_nat a3) (enc_expr a4) ∈ lrel $;
def qinst (a1: blk) (a2: expr) (a3: nat) (a4: nat) (a5: expr) (a6: expr): wff = $ _ ⇒ ra_qinst (enc_blk a1) (enc_expr a2) (enc_nat a3) (enc_nat a4) (enc_expr a5) (enc_expr a6) ∈ lrel $;
def nonrec (a1: nat) (a2: nat) (a3: expr): wff = $ _ ⇒ ra_nonrec (enc_nat a1) (enc_nat a2) (enc_expr a3) ∈ lrel $;
def eta_ok (a1: ind) (a2: nat): wff = $ _ ⇒ ra_eta_ok (enc_ind a1) (enc_nat a2) ∈ lrel $;
def projs (a1: blk) (a2: expr) (a3: nat) (a4: expr) (a5: expr): wff = $ _ ⇒ ra_projs (enc_blk a1) (enc_expr a2) (enc_nat a3) (enc_expr a4) (enc_expr a5) ∈ lrel $;
def clift (a1: nat) (a2: ctx) (a3: ctx): wff = $ _ ⇒ ra_clift (enc_nat a1) (enc_ctx a2) (enc_ctx a3) ∈ lrel $;
def iota_tel (a1: ind) (a2: lvl) (a3: nat) (a4: nat) (a5: ctx) (a6: expr) (a7: nat) (a8: ctx): wff = $ _ ⇒ ra_iota_tel (enc_ind a1) (enc_lvl a2) (enc_nat a3) (enc_nat a4) (enc_ctx a5) (enc_expr a6) (enc_nat a7) (enc_ctx a8) ∈ lrel $;
def iota_lhs (a1: ind) (a2: lvl) (a3: nat) (a4: nat) (a5: nat) (a6: expr) (a7: expr) (a8: expr) (a9: expr) (a10: expr) (a11: expr): wff = $ _ ⇒ ra_iota_lhs (enc_ind a1) (enc_lvl a2) (enc_nat a3) (enc_nat a4) (enc_nat a5) (enc_expr a6) (enc_expr a7) (enc_expr a8) (enc_expr a9) (enc_expr a10) (enc_expr a11) ∈ lrel $;

--| The spec's definitions (in prefix form).
def n1: nat = $ s nz $;
def n2: nat = $ s n1 $;
def n3: nat = $ s n2 $;
def n4: nat = $ s n3 $;
def n5: nat = $ s n4 $;
def n6: nat = $ s n5 $;
def n7: nat = $ s n6 $;
def n8: nat = $ s n7 $;
def n9: nat = $ s n8 $;
def lt (i n: nat): wff = $ le (s i) n $;
def Prop: expr = $ srt lz $;
def lit0: expr = $ lit b0 $;
def lit1: expr = $ lit (bd1 b0) $;
def lit2: expr = $ lit (bd0 (bd1 b0)) $;
def nat_D: ind = $ ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil) $;
def eq_D (u: lvl): ind = $ ind_mk eq_blk (cons (bvar nz) (cons (srt u) nil)) (tcons (pi (bvar (s nz)) (srt lz)) (ccons (app (app (app (bvar (s (s nz))) (bvar (s nz))) (bvar nz)) (bvar nz)) cnil) tnil) $;
def nat_ty: expr = $ ind_ty nat_D nz $;
def nat_zero: expr = $ ind_ctor nat_D nz nz $;
def nat_succ: expr = $ ind_ctor nat_D nz n1 $;

theorem lprog_hprog (G: hyps): $ G ⇒ hprog lprog latoms $;

--| The clause axioms at classes (`lrel_A` for the clause axiom `A`): at any
--| trees `A1 .. An` for its variables, a clause's conclusion is derivable when
--| its premises are.
theorem lrel_le_z (G: hyps) (A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_le ⟨ kc_nz , ∅ ⟩ A1 ∈ lrel $;
theorem lrel_le_s (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_le A1 A2 ∈ lrel $ >
  $ G ⇒ ra_le ⟨ kc_s , scons A1 ∅ ⟩ ⟨ kc_s , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_add_z (G: hyps) (A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_add A1 ⟨ kc_nz , ∅ ⟩ A1 ∈ lrel $;
theorem lrel_add_s (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_add A1 A2 A3 ∈ lrel $ >
  $ G ⇒ ra_add A1 ⟨ kc_s , scons A2 ∅ ⟩ ⟨ kc_s , scons A3 ∅ ⟩ ∈ lrel $;
theorem lrel_lnth_z (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_lnth ⟨ kc_lcons , scons A1 (scons A2 ∅) ⟩ ⟨ kc_nz , ∅ ⟩ A1 ∈ lrel $;
theorem lrel_lnth_s (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_lnth A3 A4 A2 ∈ lrel $ >
  $ G ⇒ ra_lnth ⟨ kc_lcons , scons A1 (scons A3 ∅) ⟩ ⟨ kc_s , scons A4 ∅ ⟩ A2 ∈ lrel $;
theorem lrel_linst_z (G: hyps) (A1: class):
  $ G ⇒ A1 ∈ trees ω $ >
  $ G ⇒ ra_linst A1 ⟨ kc_lz , ∅ ⟩ ⟨ kc_lz , ∅ ⟩ ∈ lrel $;
theorem lrel_linst_s (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_linst A1 A2 A3 ∈ lrel $ >
  $ G ⇒ ra_linst A1 ⟨ kc_ls , scons A2 ∅ ⟩ ⟨ kc_ls , scons A3 ∅ ⟩ ∈ lrel $;
theorem lrel_linst_max (G: hyps) (A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ra_linst A1 A2 A4 ∈ lrel $ >
  $ G ⇒ ra_linst A1 A3 A5 ∈ lrel $ >
  $ G ⇒ ra_linst A1 ⟨ kc_lmax , scons A2 (scons A3 ∅) ⟩ ⟨ kc_lmax , scons A4 (scons A5 ∅) ⟩ ∈ lrel $;
theorem lrel_linst_imax (G: hyps) (A1 A2 A3 A4 A5: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ >
  $ G ⇒ ra_linst A1 A2 A4 ∈ lrel $ >
  $ G ⇒ ra_linst A1 A3 A5 ∈ lrel $ >
  $ G ⇒ ra_linst A1 ⟨ kc_limax , scons A2 (scons A3 ∅) ⟩ ⟨ kc_limax , scons A4 (scons A5 ∅) ⟩ ∈ lrel $;
theorem lrel_linst_param (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_lnth A1 A2 A3 ∈ lrel $ >
  $ G ⇒ ra_linst A1 ⟨ kc_lparam , scons A2 ∅ ⟩ A3 ∈ lrel $;
theorem lrel_lsubst_z (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_lz , ∅ ⟩ A2 ⟨ kc_lz , ∅ ⟩ ∈ lrel $;
theorem lrel_lsubst_s (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_lsubst A1 A2 A3 A4 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_ls , scons A2 ∅ ⟩ A3 ⟨ kc_ls , scons A4 ∅ ⟩ ∈ lrel $;
theorem lrel_lsubst_max (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_lsubst A1 A2 A4 A5 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 A3 A4 A6 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_lmax , scons A2 (scons A3 ∅) ⟩ A4 ⟨ kc_lmax , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_lsubst_imax (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_lsubst A1 A2 A4 A5 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 A3 A4 A6 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_limax , scons A2 (scons A3 ∅) ⟩ A4 ⟨ kc_limax , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_lsubst_eq (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_lparam , scons A1 ∅ ⟩ A2 A2 ∈ lrel $;
theorem lrel_lsubst_lt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_le ⟨ kc_s , scons A2 ∅ ⟩ A1 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_lparam , scons A2 ∅ ⟩ A3 ⟨ kc_lparam , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_lsubst_gt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_le ⟨ kc_s , scons A1 ∅ ⟩ A2 ∈ lrel $ >
  $ G ⇒ ra_lsubst A1 ⟨ kc_lparam , scons A2 ∅ ⟩ A3 ⟨ kc_lparam , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_closed_bvar (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_le ⟨ kc_s , scons A1 ∅ ⟩ A2 ∈ lrel $ >
  $ G ⇒ ra_closed A2 ⟨ kc_bvar , scons A1 ∅ ⟩ ∈ lrel $;
theorem lrel_closed_srt (G: hyps) (A1 A2: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ >
  $ G ⇒ ra_closed A1 ⟨ kc_srt , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_closed_app (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_closed A1 A2 ∈ lrel $ >
  $ G ⇒ ra_closed A1 A3 ∈ lrel $ >
  $ G ⇒ ra_closed A1 ⟨ kc_app , scons A2 (scons A3 ∅) ⟩ ∈ lrel $;
theorem lrel_closed_lam (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_closed A1 A2 ∈ lrel $ >
  $ G ⇒ ra_closed ⟨ kc_s , scons A1 ∅ ⟩ A3 ∈ lrel $ >
  $ G ⇒ ra_closed A1 ⟨ kc_lam , scons A2 (scons A3 ∅) ⟩ ∈ lrel $;
theorem lrel_closed_pi (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_closed A1 A2 ∈ lrel $ >
  $ G ⇒ ra_closed ⟨ kc_s , scons A1 ∅ ⟩ A3 ∈ lrel $ >
  $ G ⇒ ra_closed A1 ⟨ kc_pi , scons A2 (scons A3 ∅) ⟩ ∈ lrel $;
theorem lrel_closed_cst (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_closed A1 ⟨ kc_cst , scons A2 (scons A3 ∅) ⟩ ∈ lrel $;
theorem lrel_lift_bvar_lt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_le ⟨ kc_s , scons A3 ∅ ⟩ A2 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A2 ⟨ kc_bvar , scons A3 ∅ ⟩ ⟨ kc_bvar , scons A3 ∅ ⟩ ∈ lrel $;
theorem lrel_lift_bvar_ge (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_le A2 A3 ∈ lrel $ >
  $ G ⇒ ra_add A3 A1 A4 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A2 ⟨ kc_bvar , scons A3 ∅ ⟩ ⟨ kc_bvar , scons A4 ∅ ⟩ ∈ lrel $;
theorem lrel_lift_srt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_lift A1 A2 ⟨ kc_srt , scons A3 ∅ ⟩ ⟨ kc_srt , scons A3 ∅ ⟩ ∈ lrel $;
theorem lrel_lift_app (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_lift A1 A2 A3 A5 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A2 A4 A6 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A2 ⟨ kc_app , scons A3 (scons A4 ∅) ⟩ ⟨ kc_app , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_lift_lam (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_lift A1 A2 A3 A5 ∈ lrel $ >
  $ G ⇒ ra_lift A1 ⟨ kc_s , scons A2 ∅ ⟩ A4 A6 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A2 ⟨ kc_lam , scons A3 (scons A4 ∅) ⟩ ⟨ kc_lam , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_lift_pi (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_lift A1 A2 A3 A5 ∈ lrel $ >
  $ G ⇒ ra_lift A1 ⟨ kc_s , scons A2 ∅ ⟩ A4 A6 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A2 ⟨ kc_pi , scons A3 (scons A4 ∅) ⟩ ⟨ kc_pi , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_lift_closed (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_closed A2 A4 ∈ lrel $ >
  $ G ⇒ ra_le A2 A3 ∈ lrel $ >
  $ G ⇒ ra_lift A1 A3 A4 A4 ∈ lrel $;
theorem lrel_inst_bvar_lt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_le ⟨ kc_s , scons A2 ∅ ⟩ A1 ∈ lrel $ >
  $ G ⇒ ra_inst A1 ⟨ kc_bvar , scons A2 ∅ ⟩ A3 ⟨ kc_bvar , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_inst_bvar_eq (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_lift A1 ⟨ kc_nz , ∅ ⟩ A2 A3 ∈ lrel $ >
  $ G ⇒ ra_inst A1 ⟨ kc_bvar , scons A1 ∅ ⟩ A2 A3 ∈ lrel $;
theorem lrel_inst_bvar_gt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_le A1 A2 ∈ lrel $ >
  $ G ⇒ ra_inst A1 ⟨ kc_bvar , scons ⟨ kc_s , scons A2 ∅ ⟩ ∅ ⟩ A3 ⟨ kc_bvar , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_inst_srt (G: hyps) (A1 A2 A3: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ >
  $ G ⇒ ra_inst A1 ⟨ kc_srt , scons A2 ∅ ⟩ A3 ⟨ kc_srt , scons A2 ∅ ⟩ ∈ lrel $;
theorem lrel_inst_app (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_inst A1 A2 A4 A5 ∈ lrel $ >
  $ G ⇒ ra_inst A1 A3 A4 A6 ∈ lrel $ >
  $ G ⇒ ra_inst A1 ⟨ kc_app , scons A2 (scons A3 ∅) ⟩ A4 ⟨ kc_app , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_inst_lam (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_inst A1 A2 A4 A5 ∈ lrel $ >
  $ G ⇒ ra_inst ⟨ kc_s , scons A1 ∅ ⟩ A3 A4 A6 ∈ lrel $ >
  $ G ⇒ ra_inst A1 ⟨ kc_lam , scons A2 (scons A3 ∅) ⟩ A4 ⟨ kc_lam , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_inst_pi (G: hyps) (A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ >
  $ G ⇒ ra_inst A1 A2 A4 A5 ∈ lrel $ >
  $ G ⇒ ra_inst ⟨ kc_s , scons A1 ∅ ⟩ A3 A4 A6 ∈ lrel $ >
  $ G ⇒ ra_inst A1 ⟨ kc_pi , scons A2 (scons A3 ∅) ⟩ A4 ⟨ kc_pi , scons A5 (scons A6 ∅) ⟩ ∈ lrel $;
theorem lrel_inst_closed (G: hyps) (A1 A2 A3 A4: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ ra_closed A1 A3 ∈ lrel $ >
  $ G ⇒ ra_le A1 A2 ∈ lrel $ >
