  $ {w | ∃ D ∃ b ∃ P ∃ T ∃ j ∃ np ∃ F ∃ K (w = ⟨ scons (ra_struct_like D j) (scons (ra_ind_data D b P T) (scons (ra_nth_ty T j F ⟨ kc_ccons , scons K (scons ⟨ kc_cnil , ∅ ⟩ ∅) ⟩) (scons (ra_clen P np) (scons (ra_nonrec np ⟨ kc_nz , ∅ ⟩ K) ∅)))) , ra_eta_ok D j ⟩)} $;
