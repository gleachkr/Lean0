theorem lrel_indapp_cases (G: hyps) {D n_v np d_v j_v k_v t_v m_v na X A: set} (t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ra_indapp t1 t2 t3 t4 t5 t6 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ k_v ∃ t_v ∃ m_v ∃ na ∃ X ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_spine ⟨ kc_bvar , scons t_v ∅ ⟩ A na ∈ lrel ∧ ra_add d_v np k_v ∈ lrel ∧ ra_add k_v j_v t_v ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np X ∈ lrel ∧ ra_nidx D j_v m_v ∈ lrel ∧ ra_iargs k_v m_v X A ∈ lrel) $;
theorem lrel_ipos_cases (G: hyps) {D n_v np d_v k_v A B j_v: set} (t1 t2 t3 t4 t5: set):
  $ G ⇒ ra_ipos t1 t2 t3 t4 t5 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel) ∨
      ∃ D ∃ n_v ∃ np ∃ d_v ∃ k_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ ra_add d_v np k_v ∈ lrel ∧ ra_closed k_v A ∈ lrel ∧ ra_ipos D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B ∈ lrel) ∨
      ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $;
theorem lrel_recfield_cases (G: hyps) {D n_v np d_v j_v A B: set} (t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ra_recfield t1 t2 t3 t4 t5 t6 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A ∃ B (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t6 = j_v ∧ ra_recfield D n_v np ⟨ kc_s , scons d_v ∅ ⟩ B j_v ∈ lrel) ∨
      ∃ D ∃ n_v ∃ np ∃ d_v ∃ j_v ∃ A (t1 = D ∧ t2 = n_v ∧ t3 = np ∧ t4 = d_v ∧ t5 = A ∧ t6 = j_v ∧ ra_indapp D n_v np d_v A j_v ∈ lrel) $;
theorem lrel_rst_cases (G: hyps) {D e_v N j_v np n_v m_v na k_v S X X1 X2 e2 I c_v i_v npi Y f_v a_v f2 a2 A b_v A2 b2: set} (t1 t2 t3 t4: set):
  $ G ⇒ ra_rst t1 t2 t3 t4 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ e_v (t1 = D ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = e_v ∧ t4 = e_v) ∨
      ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_rehead S X2 k_v e_v e2 ∈ lrel) ∨
      ∃ D ∃ I ∃ N ∃ j_v ∃ c_v ∃ i_v ∃ np ∃ n_v ∃ m_v ∃ na ∃ k_v ∃ npi ∃ e_v ∃ S ∃ X ∃ X1 ∃ X2 ∃ Y ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e2 ∧ ra_spine ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ e_v na ∈ lrel ∧ ra_aux_of D N j_v X ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np X X1 ∈ lrel ∧ ra_add np k_v na ∈ lrel ∧ ra_spine S e_v k_v ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ S X1 X2 ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X2 npi ∈ lrel ∧ ra_rehead ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ ⟨ kc_ind_ctor , scons I (scons i_v (scons c_v ∅)) ⟩ npi X2 Y ∈ lrel ∧ ra_rehead S Y k_v e_v e2 ∈ lrel) ∨
      ∃ D ∃ N ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_rst D N f_v f2 ∈ lrel ∧ ra_rst D N a_v a2 ∈ lrel) ∨
      ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨
      ∃ D ∃ N ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_rst D N A A2 ∈ lrel ∧ ra_rst D N b_v b2 ∈ lrel) ∨
      ∃ D ∃ N ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_rst D N e_v e2 ∈ lrel) ∨
      ∃ D ∃ N ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = e_v ∧ t4 = e_v) $;
theorem lrel_nst_hit_cases (G: hyps) {X S Y e_v e2 N I i_v j_v d_v np na npi r_v a_v t_v: set} (t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ra_nst_hit t1 t2 t3 t4 t5 t6 ∈ lrel $ >
  $ G ⇒ ∃ X ∃ S ∃ Y ∃ e_v ∃ e2 ∃ N ∃ I ∃ i_v ∃ j_v ∃ d_v ∃ np ∃ na ∃ npi ∃ r_v ∃ a_v ∃ t_v (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ X npi ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons I (scons i_v ∅) ⟩ e_v na ∈ lrel ∧ ra_add npi r_v na ∈ lrel ∧ ra_lift d_v ⟨ kc_nz , ∅ ⟩ X S ∈ lrel ∧ ra_spine S e_v r_v ∈ lrel ∧ ra_add np j_v a_v ∈ lrel ∧ ra_add d_v a_v t_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons t_v ∅ ⟩ d_v np Y ∈ lrel ∧ ra_rehead S Y r_v e_v e2 ∈ lrel) ∨
      ∃ X ∃ e_v ∃ e2 ∃ N ∃ j_v ∃ d_v ∃ np (t1 = ⟨ kc_cons , scons X (scons N ∅) ⟩ ∧ t2 = j_v ∧ t3 = d_v ∧ t4 = np ∧ t5 = e_v ∧ t6 = e2 ∧ ra_nst_hit N ⟨ kc_s , scons j_v ∅ ⟩ d_v np e_v e2 ∈ lrel) $;
theorem lrel_spz_cases (G: hyps) {D N d_v e_v np n_v m_v n0 e2 f_v a_v f2 a2 A b_v A2 b2 i_v: set} (t1 t2 t3 t4 t5: set):
  $ G ⇒ ra_spz t1 t2 t3 t4 t5 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ d_v ∃ e_v (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e_v) ∨
      ∃ D ∃ N ∃ d_v ∃ np ∃ n_v ∃ m_v ∃ n0 ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = e_v ∧ t5 = e2 ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_nst_hit N n0 d_v np e_v e2 ∈ lrel) ∨
      ∃ D ∃ N ∃ d_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t5 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_spz D N d_v f_v f2 ∈ lrel ∧ ra_spz D N d_v a_v a2 ∈ lrel) ∨
      ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨
      ∃ D ∃ N ∃ d_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t5 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_spz D N d_v A A2 ∈ lrel ∧ ra_spz D N ⟨ kc_s , scons d_v ∅ ⟩ b_v b2 ∈ lrel) ∨
      ∃ D ∃ N ∃ d_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = D ∧ t2 = N ∧ t3 = d_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t5 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_spz D N d_v e_v e2 ∈ lrel) $;
theorem lrel_afree_cases (G: hyps) {i_v l_v f_v a_v A b_v S n_v D N j_v np m_v n0 c_v v_v e_v u_v: set} (t1: set):
  $ G ⇒ ra_afree t1 ∈ lrel $ >
  $ G ⇒ ∃ i_v (t1 = ⟨ kc_bvar , scons i_v ∅ ⟩) ∨
      ∃ l_v (t1 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨
      ∃ f_v ∃ a_v (t1 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_afree f_v ∈ lrel ∧ ra_afree a_v ∈ lrel) ∨
      ∃ A ∃ b_v (t1 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) ∨
      ∃ A ∃ b_v (t1 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_afree A ∈ lrel ∧ ra_afree b_v ∈ lrel) ∨
      ∃ a_v ∃ S (t1 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) ∨
      ∃ n_v (t1 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨
      ∃ D ∃ N ∃ j_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) ∨
      ∃ D ∃ N ∃ j_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ n0 (t1 = ⟨ kc_ind_ctor , scons D (scons j_v (scons c_v ∅)) ⟩ ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_ndecl N n_v n0 ∈ lrel ∧ ra_le ⟨ kc_s , scons j_v ∅ ⟩ n0 ∈ lrel) ∨
      ∃ D ∃ i_v ∃ v_v (t1 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) ∨
      ∃ b_v ∃ i_v ∃ e_v (t1 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_afree e_v ∈ lrel) ∨
      ∃ u_v (t1 = ⟨ kc_quot , scons u_v ∅ ⟩) ∨
      ∃ u_v (t1 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨
      ∃ u_v ∃ v_v (t1 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨
      ∃ u_v (t1 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $;
theorem lrel_spz_ctors_cases (G: hyps) {D N I X ni npi NI K K1 K2 K3 K4 C C2: set} (t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ra_spz_ctors t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ N ∃ I ∃ X ∃ ni ∃ npi (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_cnil , ∅ ⟩ ∧ t8 = ⟨ kc_cnil , ∅ ⟩) ∨
      ∃ D ∃ I ∃ N ∃ NI ∃ X ∃ K ∃ K1 ∃ K2 ∃ K3 ∃ K4 ∃ ni ∃ npi ∃ C ∃ C2 (t1 = D ∧ t2 = N ∧ t3 = I ∧ t4 = X ∧ t5 = ni ∧ t6 = npi ∧ t7 = ⟨ kc_ccons , scons K (scons C ∅) ⟩ ∧ t8 = ⟨ kc_ccons , scons K4 (scons C2 ∅) ⟩ ∧ ra_sinst I ⟨ kc_nz , ∅ ⟩ ni npi K K1 ∈ lrel ∧ ra_ind_nested I NI ∈ lrel ∧ ra_rst I NI K1 K2 ∈ lrel ∧ ra_afree K2 ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X K2 K3 ∈ lrel ∧ ra_spz D N ⟨ kc_nz , ∅ ⟩ K3 K4 ∈ lrel ∧ ra_spz_ctors D N I X ni npi C C2 ∈ lrel) $;
theorem lrel_aux_data_cases (G: hyps) {D I b_v bi_v P Pi N T Ti j_v i_v npi ni mi X F Fi C Ci: set} (t1 t2 t3 t4 t5: set):
  $ G ⇒ ra_aux_data t1 t2 t3 t4 t5 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ I ∃ b_v ∃ bi_v ∃ P ∃ Pi ∃ N ∃ T ∃ Ti ∃ j_v ∃ i_v ∃ npi ∃ ni ∃ mi ∃ X ∃ F ∃ Fi ∃ C ∃ Ci (t1 = D ∧ t2 = I ∧ t3 = X ∧ t4 = j_v ∧ t5 = i_v ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_ind_nested D N ∈ lrel ∧ ra_ind_data I bi_v Pi Ti ∈ lrel ∧ ra_nth_ty T j_v F C ∈ lrel ∧ ra_nth_ty Ti i_v Fi Ci ∈ lrel ∧ ra_pinst ⟨ kc_nz , ∅ ⟩ X Fi F ∈ lrel ∧ ra_ind_arity I npi ni mi ∈ lrel ∧ ra_spz_ctors D N I X ni npi Ci C ∈ lrel) $;
theorem lrel_mty_cases (G: hyps) {D np j_v d_v v_v A B M k_v l_v X I: set} (t1 t2 t3 t4 t5 t6 t7: set):
  $ G ⇒ ra_mty t1 t2 t3 t4 t5 t6 t7 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ d_v ∃ v_v ∃ A ∃ B ∃ M (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t7 = ⟨ kc_pi , scons A (scons M ∅) ⟩ ∧ ra_mty D np j_v ⟨ kc_s , scons d_v ∅ ⟩ v_v B M ∈ lrel) ∨
      ∃ D ∃ np ∃ j_v ∃ d_v ∃ k_v ∃ v_v ∃ l_v ∃ X ∃ I (t1 = D ∧ t2 = np ∧ t3 = j_v ∧ t4 = d_v ∧ t5 = v_v ∧ t6 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t7 = ⟨ kc_pi , scons I (scons ⟨ kc_srt , scons v_v ∅ ⟩ ∅) ⟩ ∧ ra_add d_v j_v k_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ k_v np X ∈ lrel ∧ ra_pargs X ⟨ kc_nz , ∅ ⟩ d_v I ∈ lrel) $;
theorem lrel_motives_cases (G: hyps) {D np j_v v_v F F2 Mj C T Mr M: set} (t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ra_motives t1 t2 t3 t4 t5 t6 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ j_v ∃ v_v (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tnil , ∅ ⟩ ∧ t6 = ⟨ kc_nil , ∅ ⟩) ∨
      ∃ D ∃ np ∃ j_v ∃ v_v ∃ F ∃ F2 ∃ Mj ∃ C ∃ T ∃ Mr ∃ M (t1 = D ∧ t2 = np ∧ t3 = v_v ∧ t4 = j_v ∧ t5 = ⟨ kc_tcons , scons F (scons C (scons T ∅)) ⟩ ∧ t6 = M ∧ ra_lift j_v ⟨ kc_nz , ∅ ⟩ F F2 ∈ lrel ∧ ra_mty D np j_v ⟨ kc_nz , ∅ ⟩ v_v F2 Mj ∈ lrel ∧ ra_motives D np v_v ⟨ kc_s , scons j_v ∅ ⟩ T Mr ∈ lrel ∧ ra_capp Mr ⟨ kc_cons , scons Mj (scons ⟨ kc_nil , ∅ ⟩ ∅) ⟩ M ∈ lrel) $;
theorem lrel_ihty_cases (G: hyps) {D np n_v mo fld y_v j_v A B IH ni k_v a_v b_v mj f_v Y X U: set} (t1 t2 t3 t4 t5 t6 t7 t8 t9: set):
  $ G ⇒ ra_ihty t1 t2 t3 t4 t5 t6 t7 t8 t9 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ A ∃ B ∃ IH (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t9 = ⟨ kc_pi , scons A (scons IH ∅) ⟩ ∧ ra_ihty D np n_v mo fld ⟨ kc_s , scons y_v ∅ ⟩ j_v B IH ∈ lrel) ∨
      ∃ D ∃ np ∃ n_v ∃ mo ∃ fld ∃ y_v ∃ j_v ∃ ni ∃ k_v ∃ a_v ∃ b_v ∃ mj ∃ f_v ∃ Y ∃ X ∃ U ∃ A (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = mo ∧ t5 = fld ∧ t6 = y_v ∧ t7 = j_v ∧ t8 = A ∧ t9 = ⟨ kc_app , scons X (scons U ∅) ⟩ ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ A k_v ∈ lrel ∧ ra_nidx D j_v ni ∈ lrel ∧ ra_add np ni k_v ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mj ∅ ⟩ ni A X ∈ lrel ∧ ra_spine ⟨ kc_ind_ty , scons D (scons j_v ∅) ⟩ Y np ∈ lrel ∧ ra_add y_v mo a_v ∈ lrel ∧ ra_add a_v n_v b_v ∈ lrel ∧ ra_add mj ⟨ kc_s , scons j_v ∅ ⟩ b_v ∈ lrel ∧ ra_add y_v fld f_v ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons f_v ∅ ⟩ ⟨ kc_nz , ∅ ⟩ y_v U ∈ lrel) $;
theorem lrel_mwalk_cases (G: hyps) {D np n_v k_v i_v c_v nf d_v r_v dp kn Ihs A A3 B Min j_v a_v sh fld mo A2 A4 IH h0 h1 h_v ni mi b_v K K2 K3 Y X Y1 Y2: set} (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12: set):
  $ G ⇒ ra_mwalk t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ Ihs ∃ A ∃ A3 ∃ B ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_closed dp A ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A A3 ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ r_v Ihs B Min ∈ lrel) ∨
      ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ nf ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ j_v ∃ a_v ∃ sh ∃ fld ∃ mo ∃ Ihs ∃ A ∃ A2 ∃ A3 ∃ A4 ∃ B ∃ IH ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = nf ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = ⟨ kc_pi , scons A (scons B ∅) ⟩ ∧ t12 = ⟨ kc_pi , scons A3 (scons Min ∅) ⟩ ∧ ra_add d_v np dp ∈ lrel ∧ ra_recfield D n_v np d_v A j_v ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v dp A A2 ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_lift kn d_v A2 A3 ∈ lrel ∧ ra_add r_v nf a_v ∈ lrel ∧ ra_add sh d_v a_v ∈ lrel ∧ ra_add fld ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ sh ∈ lrel ∧ ra_add a_v k_v mo ∈ lrel ∧ ra_lift sh ⟨ kc_nz , ∅ ⟩ A3 A4 ∈ lrel ∧ ra_ihty D np n_v mo fld ⟨ kc_nz , ∅ ⟩ j_v A4 IH ∈ lrel ∧ ra_mwalk D np n_v k_v i_v c_v nf ⟨ kc_s , scons d_v ∅ ⟩ ⟨ kc_s , scons r_v ∅ ⟩ ⟨ kc_cons , scons IH (scons Ihs ∅) ⟩ B Min ∈ lrel) ∨
      ∃ D ∃ np ∃ n_v ∃ k_v ∃ i_v ∃ c_v ∃ d_v ∃ r_v ∃ dp ∃ kn ∃ h0 ∃ h1 ∃ h_v ∃ ni ∃ mi ∃ a_v ∃ b_v ∃ Ihs ∃ K ∃ K2 ∃ K3 ∃ Y ∃ X ∃ Y1 ∃ Y2 ∃ Min (t1 = D ∧ t2 = np ∧ t3 = n_v ∧ t4 = k_v ∧ t5 = i_v ∧ t6 = c_v ∧ t7 = d_v ∧ t8 = d_v ∧ t9 = r_v ∧ t10 = Ihs ∧ t11 = K ∧ t12 = Min ∧ ra_add d_v np dp ∈ lrel ∧ ra_add k_v n_v kn ∈ lrel ∧ ra_add dp i_v h0 ∈ lrel ∧ ra_add h0 kn h1 ∈ lrel ∧ ra_add h1 r_v h_v ∈ lrel ∧ ra_lift kn d_v K K2 ∈ lrel ∧ ra_lift r_v ⟨ kc_nz , ∅ ⟩ K2 K3 ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mi ∅ ⟩ ni K3 X ∈ lrel ∧ ra_spine ⟨ kc_bvar , scons h_v ∅ ⟩ Y np ∈ lrel ∧ ra_add r_v d_v a_v ∈ lrel ∧ ra_add a_v kn b_v ∈ lrel ∧ ra_add mi ⟨ kc_s , scons i_v ∅ ⟩ b_v ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ b_v np Y1 ∈ lrel ∧ ra_pargs Y1 r_v d_v Y2 ∈ lrel ∧ ra_pis Ihs ⟨ kc_app , scons X (scons Y2 ∅) ⟩ Min ∈ lrel) $;
