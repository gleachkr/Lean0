--| Inversion: a derivable atom of a relation is the conclusion of one of its
--| clauses, at sets, with the clause's premises derivable (the arguments `tN`,
--| the clause's variables bound, renamed apart from `G` and the proof variables).
theorem lrel_le_cases (G: hyps) {n_v i_v: set} (t1 t2: set):
  $ G ⇒ ra_le t1 t2 ∈ lrel $ >
  $ G ⇒ ∃ n_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = n_v) ∨
      ∃ i_v ∃ n_v (t1 = ⟨ kc_s , scons i_v ∅ ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_le i_v n_v ∈ lrel) $;
theorem lrel_add_cases (G: hyps) {i_v n_v j_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_add t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ i_v (t1 = i_v ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = i_v) ∨
      ∃ i_v ∃ n_v ∃ j_v (t1 = i_v ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = ⟨ kc_s , scons j_v ∅ ⟩ ∧ ra_add i_v n_v j_v ∈ lrel) $;
theorem lrel_lnth_cases (G: hyps) {a_v S b_v n_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_lnth t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ a_v ∃ S (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = a_v) ∨
      ∃ a_v ∃ b_v ∃ S ∃ n_v (t1 = ⟨ kc_lcons , scons a_v (scons S ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = b_v ∧ ra_lnth S n_v b_v ∈ lrel) $;
theorem lrel_linst_cases (G: hyps) {S a_v a2 b_v b2 n_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_linst t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ S (t1 = S ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = ⟨ kc_lz , ∅ ⟩) ∨
      ∃ S ∃ a_v ∃ a2 (t1 = S ∧ t2 = ⟨ kc_ls , scons a_v ∅ ⟩ ∧ t3 = ⟨ kc_ls , scons a2 ∅ ⟩ ∧ ra_linst S a_v a2 ∈ lrel) ∨
      ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_lmax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_lmax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) ∨
      ∃ S ∃ a_v ∃ b_v ∃ a2 ∃ b2 (t1 = S ∧ t2 = ⟨ kc_limax , scons a_v (scons b_v ∅) ⟩ ∧ t3 = ⟨ kc_limax , scons a2 (scons b2 ∅) ⟩ ∧ ra_linst S a_v a2 ∈ lrel ∧ ra_linst S b_v b2 ∈ lrel) ∨
      ∃ S ∃ n_v ∃ a_v (t1 = S ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ ra_lnth S n_v a_v ∈ lrel) $;
theorem lrel_lsubst_cases (G: hyps) {n_v a_v b_v b2 c_v c2 m_v: set} (t1 t2 t3 t4: set):
  $ G ⇒ ra_lsubst t1 t2 t3 t4 ∈ lrel $ >
  $ G ⇒ ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lz , ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lz , ∅ ⟩) ∨
      ∃ n_v ∃ b_v ∃ a_v ∃ b2 (t1 = n_v ∧ t2 = ⟨ kc_ls , scons b_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_ls , scons b2 ∅ ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel) ∨
      ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_lmax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lmax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨
      ∃ n_v ∃ b_v ∃ c_v ∃ a_v ∃ b2 ∃ c2 (t1 = n_v ∧ t2 = ⟨ kc_limax , scons b_v (scons c_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_limax , scons b2 (scons c2 ∅) ⟩ ∧ ra_lsubst n_v b_v a_v b2 ∈ lrel ∧ ra_lsubst n_v c_v a_v c2 ∈ lrel) ∨
      ∃ n_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons n_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a_v) ∨
      ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons m_v ∅ ⟩ n_v ∈ lrel) ∨
      ∃ n_v ∃ m_v ∃ a_v (t1 = n_v ∧ t2 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lparam , scons m_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons n_v ∅ ⟩ m_v ∈ lrel) $;
theorem lrel_closed_cases (G: hyps) {i_v k_v l_v f_v a_v A b_v S n_v D c_v v_v e_v u_v: set} (t1 t2: set):
  $ G ⇒ ra_closed t1 t2 ∈ lrel $ >
  $ G ⇒ ∃ i_v ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨
      ∃ k_v ∃ l_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨
      ∃ k_v ∃ f_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ ra_closed k_v f_v ∈ lrel ∧ ra_closed k_v a_v ∈ lrel) ∨
      ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨
      ∃ k_v ∃ A ∃ b_v (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ ra_closed k_v A ∈ lrel ∧ ra_closed ⟨ kc_s , scons k_v ∅ ⟩ b_v ∈ lrel) ∨
      ∃ k_v ∃ a_v ∃ S (t1 = k_v ∧ t2 = ⟨ kc_cst , scons a_v (scons S ∅) ⟩) ∨
      ∃ k_v ∃ n_v (t1 = k_v ∧ t2 = ⟨ kc_lit , scons n_v ∅ ⟩) ∨
      ∃ k_v ∃ D ∃ i_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩) ∨
      ∃ k_v ∃ D ∃ i_v ∃ c_v (t1 = k_v ∧ t2 = ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩) ∨
      ∃ k_v ∃ D ∃ i_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩) ∨
      ∃ k_v ∃ b_v ∃ i_v ∃ e_v (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ ra_closed k_v e_v ∈ lrel) ∨
      ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot , scons u_v ∅ ⟩) ∨
      ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_mk , scons u_v ∅ ⟩) ∨
      ∃ k_v ∃ u_v ∃ v_v (t1 = k_v ∧ t2 = ⟨ kc_quot_lift , scons u_v (scons v_v ∅) ⟩) ∨
      ∃ k_v ∃ u_v (t1 = k_v ∧ t2 = ⟨ kc_quot_ind , scons u_v ∅ ⟩) $;
theorem lrel_lift_cases (G: hyps) {n_v k_v i_v j_v l_v f_v a_v f2 a2 A b_v A2 b2 e_v e2: set} (t1 t2 t3 t4: set):
  $ G ⇒ ra_lift t1 t2 t3 t4 ∈ lrel $ >
  $ G ⇒ ∃ n_v ∃ k_v ∃ i_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨
      ∃ n_v ∃ k_v ∃ i_v ∃ j_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t4 = ⟨ kc_bvar , scons j_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel ∧ ra_add i_v n_v j_v ∈ lrel) ∨
      ∃ n_v ∃ k_v ∃ l_v (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨
      ∃ n_v ∃ k_v ∃ f_v ∃ a_v ∃ f2 ∃ a2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_app , scons f_v (scons a_v ∅) ⟩ ∧ t4 = ⟨ kc_app , scons f2 (scons a2 ∅) ⟩ ∧ ra_lift n_v k_v f_v f2 ∈ lrel ∧ ra_lift n_v k_v a_v a2 ∈ lrel) ∨
      ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) ∨
      ∃ n_v ∃ k_v ∃ A ∃ b_v ∃ A2 ∃ b2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_lift n_v k_v A A2 ∈ lrel ∧ ra_lift n_v ⟨ kc_s , scons k_v ∅ ⟩ b_v b2 ∈ lrel) ∨
      ∃ n_v ∃ j_v ∃ k_v ∃ e_v (t1 = n_v ∧ t2 = k_v ∧ t3 = e_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨
      ∃ n_v ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ e2 (t1 = n_v ∧ t2 = k_v ∧ t3 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_lift n_v k_v e_v e2 ∈ lrel) $;
theorem lrel_inst_cases (G: hyps) {k_v i_v a_v a2 l_v f_v x_v f2 x2_v A b_v A2 b2 j_v e_v e2: set} (t1 t2 t3 t4: set):
  $ G ⇒ ra_inst t1 t2 t3 t4 ∈ lrel $ >
  $ G ⇒ ∃ k_v ∃ i_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le ⟨ kc_s , scons i_v ∅ ⟩ k_v ∈ lrel) ∨
      ∃ k_v ∃ a_v ∃ a2 (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons k_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = a2 ∧ ra_lift k_v ⟨ kc_nz , ∅ ⟩ a_v a2 ∈ lrel) ∨
      ∃ k_v ∃ i_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_bvar , scons ⟨ kc_s , scons i_v ∅ ⟩ ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_bvar , scons i_v ∅ ⟩ ∧ ra_le k_v i_v ∈ lrel) ∨
      ∃ k_v ∃ l_v ∃ a_v (t1 = k_v ∧ t2 = ⟨ kc_srt , scons l_v ∅ ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_srt , scons l_v ∅ ⟩) ∨
      ∃ k_v ∃ f_v ∃ x_v ∃ a_v ∃ f2 ∃ x2_v (t1 = k_v ∧ t2 = ⟨ kc_app , scons f_v (scons x_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_app , scons f2 (scons x2_v ∅) ⟩ ∧ ra_inst k_v f_v a_v f2 ∈ lrel ∧ ra_inst k_v x_v a_v x2_v ∈ lrel) ∨
      ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_lam , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_lam , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) ∨
      ∃ k_v ∃ A ∃ b_v ∃ a_v ∃ A2 ∃ b2 (t1 = k_v ∧ t2 = ⟨ kc_pi , scons A (scons b_v ∅) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_pi , scons A2 (scons b2 ∅) ⟩ ∧ ra_inst k_v A a_v A2 ∈ lrel ∧ ra_inst ⟨ kc_s , scons k_v ∅ ⟩ b_v a_v b2 ∈ lrel) ∨
      ∃ j_v ∃ k_v ∃ e_v ∃ a_v (t1 = k_v ∧ t2 = e_v ∧ t3 = a_v ∧ t4 = e_v ∧ ra_closed j_v e_v ∈ lrel ∧ ra_le j_v k_v ∈ lrel) ∨
      ∃ k_v ∃ b_v ∃ i_v ∃ e_v ∃ a_v ∃ e2 (t1 = k_v ∧ t2 = ⟨ kc_proj , scons b_v (scons i_v (scons e_v ∅)) ⟩ ∧ t3 = a_v ∧ t4 = ⟨ kc_proj , scons b_v (scons i_v (scons e2 ∅)) ⟩ ∧ ra_inst k_v e_v a_v e2 ∈ lrel) $;
theorem lrel_lookup_cases (G: hyps) {A A2 G_v B B2 n_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_lookup t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ A ∃ A2 ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A2 ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A A2 ∈ lrel) ∨
      ∃ A ∃ B ∃ B2 ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B2 ∧ ra_lookup G_v n_v B ∈ lrel ∧ ra_lift ⟨ kc_s , scons ⟨ kc_nz , ∅ ⟩ ∅ ⟩ ⟨ kc_nz , ∅ ⟩ B B2 ∈ lrel) $;
theorem lrel_cinst_cases (G: hyps) {G0 A0 a_v k_v G1 G_v A A2: set} (t1 t2 t3 t4 t5 t6: set):
  $ G ⇒ ra_cinst t1 t2 t3 t4 t5 t6 ∈ lrel $ >
  $ G ⇒ ∃ G0 ∃ A0 ∃ a_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A0 (scons G0 ∅) ⟩ ∧ t6 = G0) ∨
      ∃ k_v ∃ G0 ∃ G1 ∃ G_v ∃ A0 ∃ a_v ∃ A ∃ A2 (t1 = ⟨ kc_s , scons k_v ∅ ⟩ ∧ t2 = G0 ∧ t3 = A0 ∧ t4 = a_v ∧ t5 = ⟨ kc_cons , scons A (scons G1 ∅) ⟩ ∧ t6 = ⟨ kc_cons , scons A2 (scons G_v ∅) ⟩ ∧ ra_cinst k_v G0 A0 a_v G1 G_v ∈ lrel ∧ ra_inst k_v A a_v A2 ∈ lrel) $;
theorem lrel_cext_cases (G: hyps) {G_v n_v G2 A: set} (t1 t2 t3: set):
  $ G ⇒ ra_cext t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nz , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨
      ∃ n_v ∃ G_v ∃ G2 ∃ A (t1 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_cext n_v G_v G2 ∈ lrel) $;
theorem lrel_clen_cases (G: hyps) {A G_v n_v: set} (t1 t2: set):
  $ G ⇒ ra_clen t1 t2 ∈ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩) ∨
      ∃ A ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ ra_clen G_v n_v ∈ lrel) $;
theorem lrel_cnth_cases (G: hyps) {A G_v B n_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_cnth t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ A ∃ G_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_nz , ∅ ⟩ ∧ t3 = A) ∨
      ∃ A ∃ B ∃ G_v ∃ n_v (t1 = ⟨ kc_cons , scons A (scons G_v ∅) ⟩ ∧ t2 = ⟨ kc_s , scons n_v ∅ ⟩ ∧ t3 = B ∧ ra_cnth G_v n_v B ∈ lrel) $;
theorem lrel_capp_cases (G: hyps) {G_v A P G2: set} (t1 t2 t3: set):
  $ G ⇒ ra_capp t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ G_v (t1 = ⟨ kc_nil , ∅ ⟩ ∧ t2 = G_v ∧ t3 = G_v) ∨
      ∃ A ∃ P ∃ G_v ∃ G2 (t1 = ⟨ kc_cons , scons A (scons P ∅) ⟩ ∧ t2 = G_v ∧ t3 = ⟨ kc_cons , scons A (scons G2 ∅) ⟩ ∧ ra_capp P G_v G2 ∈ lrel) $;
theorem lrel_bsucc_cases (G: hyps) {a_v b_v: set} (t1 t2: set):
  $ G ⇒ ra_bsucc t1 t2 ∈ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨
      ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons a_v ∅ ⟩) ∨
      ∃ a_v ∃ b_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ ra_bsucc a_v b_v ∈ lrel) $;
theorem lrel_bdbl_cases (G: hyps) {a_v: set} (t1 t2: set):
  $ G ⇒ ra_bdbl t1 t2 ∈ lrel $ >
  $ G ⇒ (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = ⟨ kc_b0 , ∅ ⟩) ∨
      ∃ a_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd0 , scons a_v ∅ ⟩ ∅ ⟩) ∨
      ∃ a_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons ⟨ kc_bd1 , scons a_v ∅ ⟩ ∅ ⟩) $;
theorem lrel_badd_cases (G: hyps) {b_v a_v c_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_badd t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ b_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = b_v) ∨
      ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = a_v) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $;
theorem lrel_baddc_cases (G: hyps) {b_v c_v a_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_baddc t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ b_v ∃ c_v (t1 = ⟨ kc_b0 , ∅ ⟩ ∧ t2 = b_v ∧ t3 = c_v ∧ ra_bsucc b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ c_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = c_v ∧ ra_bsucc a_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_badd a_v b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd0 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd0 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v (t1 = ⟨ kc_bd1 , scons a_v ∅ ⟩ ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons c_v ∅ ⟩ ∧ ra_baddc a_v b_v c_v ∈ lrel) $;
theorem lrel_bmul_cases (G: hyps) {a_v b_v c_v d_v e_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_bmul t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_b0 , ∅ ⟩) ∨
      ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = a_v ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bmul a_v b_v c_v ∈ lrel ∧ ra_bdbl c_v d_v ∈ lrel ∧ ra_badd d_v a_v e_v ∈ lrel) $;
theorem lrel_bpow_cases (G: hyps) {a_v b_v c_v d_v e_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_bpow t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ a_v (t1 = a_v ∧ t2 = ⟨ kc_b0 , ∅ ⟩ ∧ t3 = ⟨ kc_bd1 , scons ⟨ kc_b0 , ∅ ⟩ ∅ ⟩) ∨
      ∃ a_v ∃ b_v ∃ c_v ∃ d_v (t1 = a_v ∧ t2 = ⟨ kc_bd0 , scons b_v ∅ ⟩ ∧ t3 = d_v ∧ ra_bpow a_v b_v c_v ∈ lrel ∧ ra_bmul c_v c_v d_v ∈ lrel) ∨
      ∃ a_v ∃ b_v ∃ c_v ∃ d_v ∃ e_v (t1 = a_v ∧ t2 = ⟨ kc_bd1 , scons b_v ∅ ⟩ ∧ t3 = e_v ∧ ra_bpow a_v b_v c_v ∈ lrel ∧ ra_bmul c_v c_v d_v ∈ lrel ∧ ra_bmul d_v a_v e_v ∈ lrel) $;
theorem lrel_band_cases (G: hyps) {b_v a_v c_v d_v: set} (t1 t2 t3: set):
  $ G ⇒ ra_band t1 t2 t3 ∈ lrel $ >
