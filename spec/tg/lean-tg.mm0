  $ {w | ∃ k ∃ d ∃ A ∃ A2 ∃ X ∃ Y (w = ⟨ scons (ra_clift k X Y) (scons (ra_clen X d) (scons (ra_lift k d A A2) ∅)) , ra_clift k ⟨ kc_cons , scons A (scons X ∅) ⟩ ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ⟩)} $;
def cl_iota_tel_i (.D .b .P .T .v .i .c .np .n .m .mn .nf .M .N .X .Xl .Q1 .Q2 .Dl .F .K .K2 .res .C .w: set): class =
  $ {w | ∃ D ∃ b ∃ P ∃ T ∃ v ∃ i ∃ c ∃ np ∃ n ∃ m ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (w = ⟨ scons (ra_ind_data D b P T) (scons (ra_clen P np) (scons (ra_ntys T n m) (scons (ra_motives D np v ⟨ kc_nz , ∅ ⟩ T M) (scons (ra_minors D np n ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N) (scons (ra_nth_ty T i F C) (scons (ra_nth_ctor C c K) (scons (ra_sinst D ⟨ kc_nz , ∅ ⟩ n np K K2) (scons (ra_pis X res K2) (scons (ra_clen X nf) (scons (ra_add m n mn) (scons (ra_clift mn X Xl) (scons (ra_capp M P Q1) (scons (ra_capp N Q1 Q2) (scons (ra_capp Xl Q2 Dl) ∅)))))))))))))) , ra_iota_tel D v i c X res nf Dl ⟩)} $;
