def ra_nonrec (a1 a2 a3: class): class = $ ⟨ kr_nonrec , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_eta_ok (a1 a2: class): class = $ ⟨ kr_eta_ok , scons a1 (scons a2 ∅) ⟩ $;
def ra_projs (a1 a2 a3 a4 a5: class): class = $ ⟨ kr_projs , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 ∅)))) ⟩ $;
def ra_clift (a1 a2 a3: class): class = $ ⟨ kr_clift , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_iota_tel (a1 a2 a3 a4 a5 a6 a7 a8: class): class = $ ⟨ kr_iota_tel , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 ∅))))))) ⟩ $;
def ra_iota_lhs (a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11: class): class = $ ⟨ kr_iota_lhs , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 (scons a7 (scons a8 (scons a9 (scons a10 (scons a11 ∅)))))))))) ⟩ $;

--| The ground instances of each clause axiom: ⟨ premises , conclusion ⟩.
def cl_le_z (.n .w: set): class =
