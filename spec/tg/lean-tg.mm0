  $ G ⇒ ra_ind_data A1 A2 A3 A4 ∈ lrel $ >
  $ G ⇒ ra_clen A3 A8 ∈ lrel $ >
  $ G ⇒ ra_ntys A4 A9 A10 ∈ lrel $ >
  $ G ⇒ ra_motives A1 A8 A5 ⟨ kc_nz , ∅ ⟩ A4 A13 ∈ lrel $ >
  $ G ⇒ ra_minors A1 A8 A9 ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ A4 A14 ∈ lrel $ >
  $ G ⇒ ra_nth_ty A4 A6 A20 A24 ∈ lrel $ >
  $ G ⇒ ra_nth_ctor A24 A7 A21 ∈ lrel $ >
  $ G ⇒ ra_sinst A1 ⟨ kc_nz , ∅ ⟩ A9 A8 A21 A22 ∈ lrel $ >
  $ G ⇒ ra_pis A15 A23 A22 ∈ lrel $ >
  $ G ⇒ ra_clen A15 A12 ∈ lrel $ >
  $ G ⇒ ra_add A10 A9 A11 ∈ lrel $ >
  $ G ⇒ ra_clift A11 A15 A16 ∈ lrel $ >
  $ G ⇒ ra_capp A13 A3 A17 ∈ lrel $ >
  $ G ⇒ ra_capp A14 A17 A18 ∈ lrel $ >
  $ G ⇒ ra_capp A16 A18 A19 ∈ lrel $ >
  $ G ⇒ ra_iota_tel A1 A5 A6 A7 A15 A23 A12 A19 ∈ lrel $;
theorem lrel_iota_lhs_i (G: hyps) (A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15 A16 A17 A18 A19 A20 A21 A22 A23 A24: class):
  $ G ⇒ A1 ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ A3 ∈ trees ω $ > $ G ⇒ A4 ∈ trees ω $ >
  $ G ⇒ A5 ∈ trees ω $ > $ G ⇒ A6 ∈ trees ω $ > $ G ⇒ A7 ∈ trees ω $ > $ G ⇒ A8 ∈ trees ω $ >
  $ G ⇒ A9 ∈ trees ω $ > $ G ⇒ A10 ∈ trees ω $ > $ G ⇒ A11 ∈ trees ω $ > $ G ⇒ A12 ∈ trees ω $ >
  $ G ⇒ A13 ∈ trees ω $ > $ G ⇒ A14 ∈ trees ω $ > $ G ⇒ A15 ∈ trees ω $ > $ G ⇒ A16 ∈ trees ω $ >
  $ G ⇒ A17 ∈ trees ω $ > $ G ⇒ A18 ∈ trees ω $ > $ G ⇒ A19 ∈ trees ω $ > $ G ⇒ A20 ∈ trees ω $ >
  $ G ⇒ A21 ∈ trees ω $ > $ G ⇒ A22 ∈ trees ω $ > $ G ⇒ A23 ∈ trees ω $ > $ G ⇒ A24 ∈ trees ω $ >
  $ G ⇒ ra_ind_arity A1 A5 A6 A7 ∈ lrel $ >
  $ G ⇒ ra_nidx A1 A3 A10 ∈ lrel $ >
  $ G ⇒ ra_add A7 A6 A8 ∈ lrel $ >
  $ G ⇒ ra_add A9 A7 A11 ∈ lrel $ >
  $ G ⇒ ra_add A11 A6 A12 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_rec , scons A1 (scons A3 (scons A2 ∅)) ⟩ A12 A5 A16 ∈ lrel $ >
  $ G ⇒ ra_pargs A16 A11 A6 A17 ∈ lrel $ >
  $ G ⇒ ra_pargs A17 A9 A7 A18 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ty , scons A1 (scons A3 ∅) ⟩ A12 A5 A20 ∈ lrel $ >
  $ G ⇒ ra_lift A8 A9 A15 A21 ∈ lrel $ >
  $ G ⇒ ra_rehead A20 A18 A10 A21 A19 ∈ lrel $ >
  $ G ⇒ ra_pargs ⟨ kc_ind_ctor , scons A1 (scons A3 (scons A4 ∅)) ⟩ A12 A5 A23 ∈ lrel $ >
  $ G ⇒ ra_pargs A23 ⟨ kc_nz , ∅ ⟩ A9 A24 ∈ lrel $ >
  $ G ⇒ ra_add A13 ⟨ kc_s , scons A3 ∅ ⟩ A6 ∈ lrel $ >
  $ G ⇒ ra_add A11 A13 A14 ∈ lrel $ >
  $ G ⇒ ra_rehead A20 ⟨ kc_bvar , scons A14 ∅ ⟩ A10 A21 A22 ∈ lrel $ >
  $ G ⇒ ra_iota_lhs A1 A2 A3 A4 A9 A15 A18 A23 A24 A19 ⟨ kc_app , scons A22 (scons A24 ∅) ⟩ ∈ lrel $;

--| The clause axioms of Part I, in prefix form.
theorem le_z (n: nat): $ le nz n $;
theorem le_s (i n: nat): $ le i n $ > $ le (s i) (s n) $;
theorem add_z (i: nat): $ add i nz i $;
theorem add_s (i n j: nat): $ add i n j $ > $ add i (s n) (s j) $;
theorem lnth_z (a: lvl) (S: lvls): $ lnth (lcons a S) nz a $;
theorem lnth_s (a b: lvl) (S: lvls) (n: nat): $ lnth S n b $ > $ lnth (lcons a S) (s n) b $;
theorem linst_z (S: lvls): $ linst S lz lz $;
theorem linst_s (S: lvls) (a a2: lvl): $ linst S a a2 $ > $ linst S (ls a) (ls a2) $;
theorem linst_max (S: lvls) (a b a2 b2: lvl): $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (lmax a b) (lmax a2 b2) $;
theorem linst_imax (S: lvls) (a b a2 b2: lvl): $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (limax a b) (limax a2 b2) $;
theorem linst_param (S: lvls) (n: nat) (a: lvl): $ lnth S n a $ > $ linst S (lparam n) a $;
theorem lsubst_z (n: nat) (a: lvl): $ lsubst n lz a lz $;
theorem lsubst_s (n: nat) (b a b2: lvl): $ lsubst n b a b2 $ > $ lsubst n (ls b) a (ls b2) $;
theorem lsubst_max (n: nat) (b c a b2 c2: lvl): $ lsubst n b a b2 $ > $ lsubst n c a c2 $ > $ lsubst n (lmax b c) a (lmax b2 c2) $;
theorem lsubst_imax (n: nat) (b c a b2 c2: lvl): $ lsubst n b a b2 $ > $ lsubst n c a c2 $ > $ lsubst n (limax b c) a (limax b2 c2) $;
theorem lsubst_eq (n: nat) (a: lvl): $ lsubst n (lparam n) a a $;
theorem lsubst_lt (n m: nat) (a: lvl): $ lt m n $ > $ lsubst n (lparam m) a (lparam m) $;
theorem lsubst_gt (n m: nat) (a: lvl): $ lt n m $ > $ lsubst n (lparam m) a (lparam m) $;
theorem closed_bvar (i k: nat): $ lt i k $ > $ closed k (bvar i) $;
theorem closed_srt (k: nat) (l: lvl): $ closed k (srt l) $;
theorem closed_app (k: nat) (f a: expr): $ closed k f $ > $ closed k a $ > $ closed k (app f a) $;
theorem closed_lam (k: nat) (A b: expr): $ closed k A $ > $ closed (s k) b $ > $ closed k (lam A b) $;
theorem closed_pi (k: nat) (A b: expr): $ closed k A $ > $ closed (s k) b $ > $ closed k (pi A b) $;
theorem closed_cst (k: nat) (a: atom) (S: lvls): $ closed k (cst a S) $;
theorem lift_bvar_lt (n k i: nat): $ lt i k $ > $ lift n k (bvar i) (bvar i) $;
theorem lift_bvar_ge (n k i j: nat): $ le k i $ > $ add i n j $ > $ lift n k (bvar i) (bvar j) $;
theorem lift_srt (n k: nat) (l: lvl): $ lift n k (srt l) (srt l) $;
theorem lift_app (n k: nat) (f a f2 a2: expr): $ lift n k f f2 $ > $ lift n k a a2 $ > $ lift n k (app f a) (app f2 a2) $;
theorem lift_lam (n k: nat) (A b A2 b2: expr): $ lift n k A A2 $ > $ lift n (s k) b b2 $ > $ lift n k (lam A b) (lam A2 b2) $;
theorem lift_pi (n k: nat) (A b A2 b2: expr): $ lift n k A A2 $ > $ lift n (s k) b b2 $ > $ lift n k (pi A b) (pi A2 b2) $;
theorem lift_closed (n j k: nat) (e: expr): $ closed j e $ > $ le j k $ > $ lift n k e e $;
theorem inst_bvar_lt (k i: nat) (a: expr): $ lt i k $ > $ inst k (bvar i) a (bvar i) $;
theorem inst_bvar_eq (k: nat) (a a2: expr): $ lift k nz a a2 $ > $ inst k (bvar k) a a2 $;
theorem inst_bvar_gt (k i: nat) (a: expr): $ le k i $ > $ inst k (bvar (s i)) a (bvar i) $;
theorem inst_srt (k: nat) (l: lvl) (a: expr): $ inst k (srt l) a (srt l) $;
theorem inst_app (k: nat) (f x a f2 x2: expr): $ inst k f a f2 $ > $ inst k x a x2 $ > $ inst k (app f x) a (app f2 x2) $;
theorem inst_lam (k: nat) (A b a A2 b2: expr): $ inst k A a A2 $ > $ inst (s k) b a b2 $ > $ inst k (lam A b) a (lam A2 b2) $;
theorem inst_pi (k: nat) (A b a A2 b2: expr): $ inst k A a A2 $ > $ inst (s k) b a b2 $ > $ inst k (pi A b) a (pi A2 b2) $;
theorem inst_closed (j k: nat) (e a: expr): $ closed j e $ > $ le j k $ > $ inst k e a e $;
theorem lookup_z (A A2: expr) (G: ctx): $ lift n1 nz A A2 $ > $ lookup (cons A G) nz A2 $;
theorem lookup_s (A B B2: expr) (G: ctx) (n: nat): $ lookup G n B $ > $ lift n1 nz B B2 $ > $ lookup (cons A G) (s n) B2 $;
theorem cinst_z (G0: ctx) (A0 a: expr): $ cinst nz G0 A0 a (cons A0 G0) G0 $;
theorem cinst_s (k: nat) (G0 G1 G: ctx) (A0 a A A2: expr): $ cinst k G0 A0 a G1 G $ > $ inst k A a A2 $ > $ cinst (s k) G0 A0 a (cons A G1) (cons A2 G) $;
theorem cext_z (G: ctx): $ cext nz G G $;
theorem cext_s (n: nat) (G G2: ctx) (A: expr): $ cext n G G2 $ > $ cext (s n) G (cons A G2) $;
theorem clen_nil: $ clen nil nz $;
theorem clen_cons (A: expr) (G: ctx) (n: nat): $ clen G n $ > $ clen (cons A G) (s n) $;
theorem cnth_z (A: expr) (G: ctx): $ cnth (cons A G) nz A $;
theorem cnth_s (A B: expr) (G: ctx) (n: nat): $ cnth G n B $ > $ cnth (cons A G) (s n) B $;
theorem capp_nil (G: ctx): $ capp nil G G $;
theorem capp_cons (A: expr) (P G G2: ctx): $ capp P G G2 $ > $ capp (cons A P) G (cons A G2) $;
theorem bsucc_0: $ bsucc b0 (bd1 b0) $;
theorem bsucc_d0 (a: bin): $ bsucc (bd0 a) (bd1 a) $;
theorem bsucc_d1 (a b: bin): $ bsucc a b $ > $ bsucc (bd1 a) (bd0 b) $;
theorem bdbl_0: $ bdbl b0 b0 $;
theorem bdbl_d0 (a: bin): $ bdbl (bd0 a) (bd0 (bd0 a)) $;
theorem bdbl_d1 (a: bin): $ bdbl (bd1 a) (bd0 (bd1 a)) $;
theorem badd_0l (b: bin): $ badd b0 b b $;
theorem badd_0r (a: bin): $ badd a b0 a $;
theorem badd_00 (a b c: bin): $ badd a b c $ > $ badd (bd0 a) (bd0 b) (bd0 c) $;
theorem badd_01 (a b c: bin): $ badd a b c $ > $ badd (bd0 a) (bd1 b) (bd1 c) $;
theorem badd_10 (a b c: bin): $ badd a b c $ > $ badd (bd1 a) (bd0 b) (bd1 c) $;
theorem badd_11 (a b c: bin): $ baddc a b c $ > $ badd (bd1 a) (bd1 b) (bd0 c) $;
theorem baddc_0l (b c: bin): $ bsucc b c $ > $ baddc b0 b c $;
theorem baddc_0r (a c: bin): $ bsucc a c $ > $ baddc a b0 c $;
theorem baddc_00 (a b c: bin): $ badd a b c $ > $ baddc (bd0 a) (bd0 b) (bd1 c) $;
theorem baddc_01 (a b c: bin): $ baddc a b c $ > $ baddc (bd0 a) (bd1 b) (bd0 c) $;
theorem baddc_10 (a b c: bin): $ baddc a b c $ > $ baddc (bd1 a) (bd0 b) (bd0 c) $;
theorem baddc_11 (a b c: bin): $ baddc a b c $ > $ baddc (bd1 a) (bd1 b) (bd1 c) $;
theorem bmul_0 (a: bin): $ bmul a b0 b0 $;
theorem bmul_d0 (a b c d: bin): $ bmul a b c $ > $ bdbl c d $ > $ bmul a (bd0 b) d $;
theorem bmul_d1 (a b c d e: bin): $ bmul a b c $ > $ bdbl c d $ > $ badd d a e $ > $ bmul a (bd1 b) e $;
theorem bpow_0 (a: bin): $ bpow a b0 (bd1 b0) $;
theorem bpow_d0 (a b c d: bin): $ bpow a b c $ > $ bmul c c d $ > $ bpow a (bd0 b) d $;
theorem bpow_d1 (a b c d e: bin): $ bpow a b c $ > $ bmul c c d $ > $ bmul d a e $ > $ bpow a (bd1 b) e $;
theorem band_0l (b: bin): $ band b0 b b0 $;
theorem band_0r (a: bin): $ band a b0 b0 $;
theorem band_00 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd0 a) (bd0 b) d $;
theorem band_01 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd0 a) (bd1 b) d $;
theorem band_10 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd1 a) (bd0 b) d $;
theorem band_11 (a b c: bin): $ band a b c $ > $ band (bd1 a) (bd1 b) (bd1 c) $;
theorem bor_0l (b: bin): $ bor b0 b b $;
theorem bor_0r (a: bin): $ bor a b0 a $;
theorem bor_00 (a b c: bin): $ bor a b c $ > $ bor (bd0 a) (bd0 b) (bd0 c) $;
theorem bor_01 (a b c: bin): $ bor a b c $ > $ bor (bd0 a) (bd1 b) (bd1 c) $;
theorem bor_10 (a b c: bin): $ bor a b c $ > $ bor (bd1 a) (bd0 b) (bd1 c) $;
theorem bor_11 (a b c: bin): $ bor a b c $ > $ bor (bd1 a) (bd1 b) (bd1 c) $;
theorem bxor_0l (b: bin): $ bxor b0 b b $;
theorem bxor_0r (a: bin): $ bxor a b0 a $;
theorem bxor_00 (a b c d: bin): $ bxor a b c $ > $ bdbl c d $ > $ bxor (bd0 a) (bd0 b) d $;
theorem bxor_01 (a b c: bin): $ bxor a b c $ > $ bxor (bd0 a) (bd1 b) (bd1 c) $;
theorem bxor_10 (a b c: bin): $ bxor a b c $ > $ bxor (bd1 a) (bd0 b) (bd1 c) $;
theorem bxor_11 (a b c d: bin): $ bxor a b c $ > $ bdbl c d $ > $ bxor (bd1 a) (bd1 b) d $;
theorem closed_lit (k: nat) (n: bin): $ closed k (lit n) $;
theorem closed_ind_ty (k: nat) (D: ind) (i: nat): $ closed k (ind_ty D i) $;
theorem closed_ind_ctor (k: nat) (D: ind) (i c: nat): $ closed k (ind_ctor D i c) $;
theorem closed_ind_rec (k: nat) (D: ind) (i: nat) (v: lvl): $ closed k (ind_rec D i v) $;
theorem closed_proj (k: nat) (b: blk) (i: nat) (e: expr): $ closed k e $ > $ closed k (proj b i e) $;
theorem lift_proj (n k: nat) (b: blk) (i: nat) (e e2: expr): $ lift n k e e2 $ > $ lift n k (proj b i e) (proj b i e2) $;
theorem inst_proj (k: nat) (b: blk) (i: nat) (e a e2: expr): $ inst k e a e2 $ > $ inst k (proj b i e) a (proj b i e2) $;
theorem ind_data_i (b: blk) (P: ctx) (T: tys): $ ind_data (ind_mk b P T) b P T $;
theorem ind_data_n (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_data (ind_mkn b P T N) b P T $;
theorem ind_nested_mk (b: blk) (P: ctx) (T: tys): $ ind_nested (ind_mk b P T) nil $;
theorem ind_nested_mkn (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_nested (ind_mkn b P T N) N $;
theorem nth_ty_z (F: expr) (C: ctors) (T: tys): $ nth_ty (tcons F C T) nz F C $;
theorem nth_ty_s (F F2: expr) (C C2: ctors) (T: tys) (i: nat): $ nth_ty T i F C $ > $ nth_ty (tcons F2 C2 T) (s i) F C $;
theorem nth_ctor_z (K: expr) (C: ctors): $ nth_ctor (ccons K C) nz K $;
theorem nth_ctor_s (K K2: expr) (C: ctors) (c: nat): $ nth_ctor C c K $ > $ nth_ctor (ccons K2 C) (s c) K $;
theorem clen_c_nil: $ clen_c cnil nz $;
theorem clen_c_cons (K: expr) (C: ctors) (n: nat): $ clen_c C n $ > $ clen_c (ccons K C) (s n) $;
theorem ntys_nil: $ ntys tnil nz nz $;
theorem ntys_cons (F: expr) (C: ctors) (T: tys) (n m c m2: nat): $ ntys T n m $ > $ clen_c C c $ > $ add m c m2 $ > $ ntys (tcons F C T) (s n) m2 $;
theorem minor_idx_z (F: expr) (C: ctors) (T: tys) (c: nat): $ minor_idx (tcons F C T) nz c c $;
theorem minor_idx_s (F: expr) (C: ctors) (T: tys) (i c k nc k2: nat): $ clen_c C nc $ > $ minor_idx T i c k $ > $ add nc k k2 $ > $ minor_idx (tcons F C T) (s i) c k2 $;
theorem npis_bvar (i: nat): $ npis (bvar i) nz $;
theorem npis_app (f a: expr): $ npis (app f a) nz $;
theorem npis_pi (A B: expr) (n: nat): $ npis B n $ > $ npis (pi A B) (s n) $;
theorem nth_pi_z (A B: expr): $ nth_pi (pi A B) nz A $;
theorem nth_pi_s (A A2 B: expr) (i: nat): $ nth_pi B i A $ > $ nth_pi (pi A2 B) (s i) A $;
theorem isort_srt (l: lvl): $ isort (srt l) nz l $;
theorem isort_pi (A B: expr) (k: nat) (l: lvl): $ isort B k l $ > $ isort (pi A B) (s k) l $;
theorem ind_arity_i (D: ind) (b: blk) (P: ctx) (T: tys) (np n m: nat): $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ ind_arity D np n m $;
theorem nidx_i (D: ind) (b: blk) (P: ctx) (T: tys) (i k: nat) (F: expr) (C: ctors) (l: lvl): $ ind_data D b P T $ > $ nth_ty T i F C $ > $ isort F k l $ > $ nidx D i k $;
theorem nfields_i (D: ind) (b: blk) (P: ctx) (T: tys) (i c nf: nat) (F K: expr) (C: ctors): $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ npis K nf $ > $ nfields D i c nf $;
theorem ndecl_nil (n: nat): $ ndecl nil n n $;
theorem ndecl_cons (X: expr) (N: ctx) (n n0: nat): $ ndecl N n n0 $ > $ ndecl (cons X N) (s n) n0 $;
theorem aux_of_i (D: ind) (N: ctx) (j np n m n0 k: nat) (X: expr): $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ add n0 k j $ > $ cnth N k X $ > $ aux_of D N j X $;
theorem pis_nil (b: expr): $ pis nil b b $;
theorem pis_cons (A b T: expr) (P: ctx): $ pis P (pi A b) T $ > $ pis (cons A P) b T $;
theorem lams_nil (b: expr): $ lams nil b b $;
theorem lams_cons (A b T: expr) (P: ctx): $ lams P (lam A b) T $ > $ lams (cons A P) b T $;
theorem tys_closed_nil (P: ctx): $ tys_closed P tnil $;
theorem tys_closed_cons (P: ctx) (F R: expr) (C: ctors) (T: tys): $ pis P F R $ > $ closed nz R $ > $ tys_closed P T $ > $ tys_closed P (tcons F C T) $;
theorem pargs_z (X: expr) (d: nat): $ pargs X d nz X $;
theorem pargs_s (X e: expr) (d n: nat): $ pargs X (s d) n e $ > $ pargs X d (s n) (app e (bvar d)) $;
theorem spine_z (h: expr): $ spine h h nz $;
theorem spine_s (h e a: expr) (k: nat): $ spine h e k $ > $ spine h (app e a) (s k) $;
theorem rehead_z (Y X: expr): $ rehead Y X nz Y X $;
theorem rehead_s (Y X e e2 a: expr) (k: nat): $ rehead Y X k e e2 $ > $ rehead Y X (s k) (app e a) (app e2 a) $;
theorem has_arg_z (e a: expr): $ has_arg (app e a) a $;
theorem has_arg_s (e a b: expr): $ has_arg e a $ > $ has_arg (app e b) a $;
theorem leaf_has_pi (j: nat) (A B: expr): $ leaf_has (s j) B $ > $ leaf_has j (pi A B) $;
theorem leaf_has_app (j: nat) (e: expr): $ has_arg e (bvar j) $ > $ leaf_has j e $;
theorem pinst_head (i: nat) (D: ind) (j: nat) (A: expr): $ pinst i (ind_ty D j) A A $;
theorem pinst_head_c (i: nat) (D: ind) (j c: nat) (A: expr): $ pinst i (ind_ctor D j c) A A $;
theorem pinst_app (i: nat) (S a A A1 R: expr): $ pinst (s i) S A A1 $ > $ inst i A1 a R $ > $ pinst i (app S a) A R $;
theorem closed_quot (k: nat) (u: lvl): $ closed k (quot u) $;
theorem closed_quot_mk (k: nat) (u: lvl): $ closed k (quot_mk u) $;
theorem closed_quot_lift (k: nat) (u v: lvl): $ closed k (quot_lift u v) $;
theorem closed_quot_ind (k: nat) (u: lvl): $ closed k (quot_ind u) $;
theorem sinst_done (D: ind) (n k: nat) (e: expr): $ sinst D n n k e e $;
theorem sinst_step (D: ind) (j n k: nat) (e e1 e2: expr): $ lt j n $ > $ inst k e (ind_ty D j) e1 $ > $ sinst D (s j) n k e1 e2 $ > $ sinst D j n k e e2 $;
theorem iargs_z (k: nat) (X: expr): $ iargs k nz X X $;
theorem iargs_s (k m: nat) (X A a: expr): $ iargs k m X A $ > $ closed k a $ > $ iargs k (s m) X (app A a) $;
theorem indapp_i (D: ind) (n np d j k t m na: nat) (X A: expr): $ spine (bvar t) A na $ > $ add d np k $ > $ add k j t $ > $ lt j n $ > $ pargs (bvar t) d np X $ > $ nidx D j m $ > $ iargs k m X A $ > $ indapp D n np d A j $;
theorem ipos_closed (D: ind) (n np d k: nat) (A: expr): $ add d np k $ > $ closed k A $ > $ ipos D n np d A $;
theorem ipos_pi (D: ind) (n np d k: nat) (A B: expr): $ add d np k $ > $ closed k A $ > $ ipos D n np (s d) B $ > $ ipos D n np d (pi A B) $;
theorem ipos_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ ipos D n np d A $;
theorem recfield_pi (D: ind) (n np d j: nat) (A B: expr): $ recfield D n np (s d) B j $ > $ recfield D n np d (pi A B) j $;
theorem recfield_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ recfield D n np d A j $;
theorem rst_nil (D: ind) (e: expr): $ rst D nil e e $;
theorem rst_ty (D: ind) (N: ctx) (j np n m na k: nat) (e S X X1 X2 e2: expr): $ spine (ind_ty D j) e na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D nz n np X X1 $ > $ add np k na $ > $ spine S e k $ > $ pinst nz S X1 X2 $ > $ rehead S X2 k e e2 $ > $ rst D N e e2 $;
theorem rst_ctor (D I: ind) (N: ctx) (j c i np n m na k npi: nat) (e S X X1 X2 Y e2: expr): $ spine (ind_ctor D j c) e na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D nz n np X X1 $ > $ add np k na $ > $ spine S e k $ > $ pinst nz S X1 X2 $ > $ spine (ind_ty I i) X2 npi $ > $ rehead (ind_ty I i) (ind_ctor I i c) npi X2 Y $ > $ rehead S Y k e e2 $ > $ rst D N e e2 $;
theorem rst_app (D: ind) (N: ctx) (f a f2 a2: expr): $ rst D N f f2 $ > $ rst D N a a2 $ > $ rst D N (app f a) (app f2 a2) $;
theorem rst_lam (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (lam A b) (lam A2 b2) $;
theorem rst_pi (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (pi A b) (pi A2 b2) $;
theorem rst_proj (D: ind) (N: ctx) (b: blk) (i: nat) (e e2: expr): $ rst D N e e2 $ > $ rst D N (proj b i e) (proj b i e2) $;
theorem rst_refl (D: ind) (N: ctx) (e: expr): $ rst D N e e $;
theorem nst_hit_z (X S Y e e2: expr) (N: ctx) (I: ind) (i j d np na npi r a t: nat): $ spine (ind_ty I i) X npi $ > $ spine (ind_ty I i) e na $ > $ add npi r na $ > $ lift d nz X S $ > $ spine S e r $ > $ add np j a $ > $ add d a t $ > $ pargs (bvar t) d np Y $ > $ rehead S Y r e e2 $ > $ nst_hit (cons X N) j d np e e2 $;
theorem nst_hit_s (X e e2: expr) (N: ctx) (j d np: nat): $ nst_hit N (s j) d np e e2 $ > $ nst_hit (cons X N) j d np e e2 $;
theorem spz_refl (D: ind) (N: ctx) (d: nat) (e: expr): $ spz D N d e e $;
theorem spz_hit (D: ind) (N: ctx) (d np n m n0: nat) (e e2: expr): $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ nst_hit N n0 d np e e2 $ > $ spz D N d e e2 $;
theorem spz_app (D: ind) (N: ctx) (d: nat) (f a f2 a2: expr): $ spz D N d f f2 $ > $ spz D N d a a2 $ > $ spz D N d (app f a) (app f2 a2) $;
theorem spz_lam (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (lam A b) (lam A2 b2) $;
theorem spz_pi (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (pi A b) (pi A2 b2) $;
theorem spz_proj (D: ind) (N: ctx) (d: nat) (b: blk) (i: nat) (e e2: expr): $ spz D N d e e2 $ > $ spz D N d (proj b i e) (proj b i e2) $;
theorem afree_bvar (i: nat): $ afree (bvar i) $;
theorem afree_srt (l: lvl): $ afree (srt l) $;
theorem afree_app (f a: expr): $ afree f $ > $ afree a $ > $ afree (app f a) $;
theorem afree_lam (A b: expr): $ afree A $ > $ afree b $ > $ afree (lam A b) $;
theorem afree_pi (A b: expr): $ afree A $ > $ afree b $ > $ afree (pi A b) $;
theorem afree_cst (a: atom) (S: lvls): $ afree (cst a S) $;
theorem afree_lit (n: bin): $ afree (lit n) $;
theorem afree_ind_ty (D: ind) (N: ctx) (j np n m n0: nat): $ ind_nested D N $ > $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ lt j n0 $ > $ afree (ind_ty D j) $;
theorem afree_ind_ctor (D: ind) (N: ctx) (j c np n m n0: nat): $ ind_nested D N $ > $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ lt j n0 $ > $ afree (ind_ctor D j c) $;
theorem afree_ind_rec (D: ind) (i: nat) (v: lvl): $ afree (ind_rec D i v) $;
theorem afree_proj (b: blk) (i: nat) (e: expr): $ afree e $ > $ afree (proj b i e) $;
theorem afree_quot (u: lvl): $ afree (quot u) $;
theorem afree_quot_mk (u: lvl): $ afree (quot_mk u) $;
theorem afree_quot_lift (u v: lvl): $ afree (quot_lift u v) $;
theorem afree_quot_ind (u: lvl): $ afree (quot_ind u) $;
theorem spz_ctors_nil (D: ind) (N: ctx) (I: ind) (X: expr) (ni npi: nat): $ spz_ctors D N I X ni npi cnil cnil $;
theorem spz_ctors_cons (D I: ind) (N NI: ctx) (X K K1 K2 K3 K4: expr) (ni npi: nat) (C C2: ctors): $ sinst I nz ni npi K K1 $ > $ ind_nested I NI $ > $ rst I NI K1 K2 $ > $ afree K2 $ > $ pinst nz X K2 K3 $ > $ spz D N nz K3 K4 $ > $ spz_ctors D N I X ni npi C C2 $ > $ spz_ctors D N I X ni npi (ccons K C) (ccons K4 C2) $;
theorem aux_data_i (D I: ind) (b bi_v: blk) (P Pi N: ctx) (T Ti: tys) (j i npi ni mi: nat) (X F Fi: expr) (C Ci: ctors): $ ind_data D b P T $ > $ ind_nested D N $ > $ ind_data I bi_v Pi Ti $ > $ nth_ty T j F C $ > $ nth_ty Ti i Fi Ci $ > $ pinst nz X Fi F $ > $ ind_arity I npi ni mi $ > $ spz_ctors D N I X ni npi Ci C $ > $ aux_data D I X j i $;
theorem mty_pi (D: ind) (np j d: nat) (v: lvl) (A B M: expr): $ mty D np j (s d) v B M $ > $ mty D np j d v (pi A B) (pi A M) $;
theorem mty_srt (D: ind) (np j d k: nat) (v l: lvl) (X I: expr): $ add d j k $ > $ pargs (ind_ty D j) k np X $ > $ pargs X nz d I $ > $ mty D np j d v (srt l) (pi I (srt v)) $;
theorem motives_nil (D: ind) (np j: nat) (v: lvl): $ motives D np v j tnil nil $;
theorem motives_cons (D: ind) (np j: nat) (v: lvl) (F F2 Mj: expr) (C: ctors) (T: tys) (Mr M: ctx): $ lift j nz F F2 $ > $ mty D np j nz v F2 Mj $ > $ motives D np v (s j) T Mr $ > $ capp Mr (cons Mj nil) M $ > $ motives D np v j (tcons F C T) M $;
theorem ihty_pi (D: ind) (np n mo fld y j: nat) (A B IH: expr): $ ihty D np n mo fld (s y) j B IH $ > $ ihty D np n mo fld y j (pi A B) (pi A IH) $;
theorem ihty_app (D: ind) (np n mo fld y j ni k a b mj f: nat) (Y X U A: expr): $ spine (ind_ty D j) A k $ > $ nidx D j ni $ > $ add np ni k $ > $ rehead Y (bvar mj) ni A X $ > $ spine (ind_ty D j) Y np $ > $ add y mo a $ > $ add a n b $ > $ add mj (s j) b $ > $ add y fld f $ > $ pargs (bvar f) nz y U $ > $ ihty D np n mo fld y j A (app X U) $;
theorem mwalk_pi_nr (D: ind) (np n k i c nf d r dp kn: nat) (Ihs: ctx) (A A3 B Min: expr): $ add d np dp $ > $ closed dp A $ > $ add k n kn $ > $ lift kn d A A3 $ > $ mwalk D np n k i c nf (s d) r Ihs B Min $ > $ mwalk D np n k i c nf d r Ihs (pi A B) (pi A3 Min) $;
theorem mwalk_pi_rec (D: ind) (np n k i c nf d r dp kn j a sh fld mo: nat) (Ihs: ctx) (A A2 A3 A4 B IH Min: expr): $ add d np dp $ > $ recfield D n np d A j $ > $ sinst D nz n dp A A2 $ > $ add k n kn $ > $ lift kn d A2 A3 $ > $ add r nf a $ > $ add sh d a $ > $ add fld n1 sh $ > $ add a k mo $ > $ lift sh nz A3 A4 $ > $ ihty D np n mo fld nz j A4 IH $ > $ mwalk D np n k i c nf (s d) (s r) (cons IH Ihs) B Min $ > $ mwalk D np n k i c nf d r Ihs (pi A B) (pi A3 Min) $;
theorem mwalk_res (D: ind) (np n k i c d r dp kn h0 h1 h ni mi a b: nat) (Ihs: ctx) (K K2 K3 Y X Y1 Y2 Min: expr): $ add d np dp $ > $ add k n kn $ > $ add dp i h0 $ > $ add h0 kn h1 $ > $ add h1 r h $ > $ lift kn d K K2 $ > $ lift r nz K2 K3 $ > $ nidx D i ni $ > $ rehead Y (bvar mi) ni K3 X $ > $ spine (bvar h) Y np $ > $ add r d a $ > $ add a kn b $ > $ add mi (s i) b $ > $ pargs (ind_ctor D i c) b np Y1 $ > $ pargs Y1 r d Y2 $ > $ pis Ihs (app X Y2) Min $ > $ mwalk D np n k i c d d r Ihs K Min $;
theorem cminors_nil (D: ind) (np n k i c: nat): $ cminors D np n k i c cnil nil $;
theorem cminors_cons (D: ind) (np n k i c nf: nat) (K Min: expr) (C: ctors) (M1 M: ctx): $ npis K nf $ > $ mwalk D np n k i c nf nz nz nil K Min $ > $ cminors D np n (s k) i (s c) C M1 $ > $ capp M1 (cons Min nil) M $ > $ cminors D np n k i c (ccons K C) M $;
theorem minors_nil (D: ind) (np n k i: nat): $ minors D np n k i tnil nil $;
theorem minors_cons (D: ind) (np n k i nc k2: nat) (F: expr) (C: ctors) (T: tys) (M1 M2 M: ctx): $ cminors D np n k i nz C M1 $ > $ clen_c C nc $ > $ add k nc k2 $ > $ minors D np n k2 (s i) T M2 $ > $ capp M2 M1 M $ > $ minors D np n k i (tcons F C T) M $;
theorem rtail_pi (D: ind) (np n m i d: nat) (A B B2: expr): $ rtail D np n m i (s d) B B2 $ > $ rtail D np n m i d (pi A B) (pi A B2) $;
theorem rtail_srt (D: ind) (np n m i d mn dmn mi: nat) (l: lvl) (X I X2: expr): $ add m n mn $ > $ add d mn dmn $ > $ pargs (ind_ty D i) dmn np X $ > $ pargs X nz d I $ > $ add mi i dmn $ > $ pargs (bvar mi) n1 d X2 $ > $ rtail D np n m i d (srt l) (pi I (app X2 (bvar nz))) $;
theorem rec_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i np n m mn: nat) (M N: ctx) (F F2 B R1 R2 R: expr) (C: ctors): $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v nz T M $ > $ minors D np n nz nz T N $ > $ nth_ty T i F C $ > $ add m n mn $ > $ lift mn nz F F2 $ > $ rtail D np n m i nz F2 B $ > $ pis N B R1 $ > $ pis M R1 R2 $ > $ pis P R2 R $ > $ rec_ty D v i R $;
theorem ctor_ty_i (D: ind) (b: blk) (P N: ctx) (T: tys) (i c np n m: nat) (F K K2 K3 R: expr) (C: ctors): $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ clen P np $ > $ ntys T n m $ > $ sinst D nz n np K K2 $ > $ ind_nested D N $ > $ rst D N K2 K3 $ > $ pis P K3 R $ > $ ctor_ty D i c R $;
theorem ihval_lam (D: ind) (np n m: nat) (v: lvl) (nf fld y j: nat) (A B IH: expr): $ ihval D np n m v nf fld (s y) j B IH $ > $ ihval D np n m v nf fld y j (pi A B) (lam A IH) $;
theorem ihval_app (D: ind) (np n m: nat) (v: lvl) (nf fld y j ni k a mn b f: nat) (Y X1 X2 X3 U A: expr): $ spine (ind_ty D j) A k $ > $ nidx D j ni $ > $ add np ni k $ > $ rehead Y X2 ni A X3 $ > $ spine (ind_ty D j) Y np $ > $ add y nf a $ > $ add m n mn $ > $ add a mn b $ > $ pargs (ind_rec D j v) b np X1 $ > $ pargs X1 a mn X2 $ > $ add y fld f $ > $ pargs (bvar f) nz y U $ > $ ihval D np n m v nf fld y j A (app X3 U) $;
theorem rwalk_pi_nr (D: ind) (np n m: nat) (v: lvl) (nf d dp mn: nat) (Acc A A3 B Val: expr): $ add d np dp $ > $ closed dp A $ > $ add m n mn $ > $ lift mn d A A3 $ > $ rwalk D np n m v nf (s d) Acc B Val $ > $ rwalk D np n m v nf d Acc (pi A B) (lam A3 Val) $;
theorem rwalk_pi_rec (D: ind) (np n m: nat) (v: lvl) (nf d dp mn j sh fld: nat) (Acc A A2 A3 A4 B IH Val: expr): $ add d np dp $ > $ recfield D n np d A j $ > $ sinst D nz n dp A A2 $ > $ add m n mn $ > $ lift mn d A2 A3 $ > $ add sh d nf $ > $ add fld n1 sh $ > $ lift sh nz A3 A4 $ > $ ihval D np n m v nf fld nz j A4 IH $ > $ rwalk D np n m v nf (s d) (app Acc IH) B Val $ > $ rwalk D np n m v nf d Acc (pi A B) (lam A3 Val) $;
theorem rwalk_res (D: ind) (np n m: nat) (v: lvl) (d: nat) (Acc K: expr): $ npis K nz $ > $ rwalk D np n m v d d Acc K Acc $;
theorem rec_rhs_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i c np n m k nf a mk: nat) (M N: ctx) (F K Acc Val R1 R2 R: expr) (C: ctors): $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v nz T M $ > $ minors D np n nz nz T N $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ minor_idx T i c k $ > $ npis K nf $ > $ add nf m a $ > $ add mk (s k) a $ > $ pargs (bvar mk) nz nf Acc $ > $ rwalk D np n m v nf nz Acc K Val $ > $ lams N Val R1 $ > $ lams M R1 R2 $ > $ lams P R2 R $ > $ rec_rhs D v i c R $;
theorem struct_like_i (D: ind) (b: blk) (P: ctx) (T: tys) (j: nat) (F K: expr) (l: lvl): $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ isort F nz l $ > $ struct_like D j $;
theorem field_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K K2 A: expr) (C: ctors): $ ind_data D b P T $ > $ nth_ty T j F C $ > $ nth_ctor C nz K $ > $ clen P np $ > $ ntys T n m $ > $ sinst D nz n np K K2 $ > $ nth_pi K2 i A $ > $ field_ty D j i A $;
theorem qinst_z (b: blk) (e A: expr) (j: nat): $ qinst b e nz j A A $;
theorem qinst_s (b: blk) (e A A1 R: expr) (k j: nat): $ inst k A (proj b j e) A1 $ > $ qinst b e k (s j) A1 R $ > $ qinst b e (s k) j A R $;
theorem nonrec_pi (np d k: nat) (A B: expr): $ add d np k $ > $ closed k A $ > $ nonrec np (s d) B $ > $ nonrec np d (pi A B) $;
theorem nonrec_res (np d: nat) (K: expr): $ npis K nz $ > $ nonrec np d K $;
theorem eta_ok_i (D: ind) (b: blk) (P: ctx) (T: tys) (j np: nat) (F K: expr): $ struct_like D j $ > $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ clen P np $ > $ nonrec np nz K $ > $ eta_ok D j $;
theorem projs_z (b: blk) (e Y: expr): $ projs b e nz Y Y $;
theorem projs_s (b: blk) (e Y M: expr) (k: nat): $ projs b e k Y M $ > $ projs b e (s k) Y (app M (proj b k e)) $;
theorem clift_nil (k: nat): $ clift k nil nil $;
theorem clift_cons (k d: nat) (A A2: expr) (X Y: ctx): $ clift k X Y $ > $ clen X d $ > $ lift k d A A2 $ > $ clift k (cons A X) (cons A2 Y) $;
theorem iota_tel_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i c np n m mn nf: nat) (M N X Xl Q1 Q2 Dl: ctx) (F K K2 res: expr) (C: ctors): $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v nz T M $ > $ minors D np n nz nz T N $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ sinst D nz n np K K2 $ > $ pis X res K2 $ > $ clen X nf $ > $ add m n mn $ > $ clift mn X Xl $ > $ capp M P Q1 $ > $ capp N Q1 Q2 $ > $ capp Xl Q2 Dl $ > $ iota_tel D v i c X res nf Dl $;
theorem iota_lhs_i (D: ind) (v: lvl) (i c np n m mn nf ni a d1 io mo: nat) (res e1 e2 e3 e4 Y T2 T0 c1 maj: expr): $ ind_arity D np n m $ > $ nidx D i ni $ > $ add m n mn $ > $ add nf m a $ > $ add a n d1 $ > $ pargs (ind_rec D i v) d1 np e1 $ > $ pargs e1 a n e2 $ > $ pargs e2 nf m e3 $ > $ pargs (ind_ty D i) d1 np Y $ > $ lift mn nf res T2 $ > $ rehead Y e3 ni T2 e4 $ > $ pargs (ind_ctor D i c) d1 np c1 $ > $ pargs c1 nz nf maj $ > $ add io (s i) n $ > $ add a io mo $ > $ rehead Y (bvar mo) ni T2 T0 $ > $ iota_lhs D v i c nf res e3 c1 maj e4 (app T0 maj) $;

--| The program's clauses that conclude an atom of a relation are that relation's
--| (rule induction over `lrel` with `horn_ind` reduces to them).
theorem lprog_le_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_le A1 A2 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_le A1 A2 ⟩ ∈ pr_le $;
theorem lprog_add_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_add A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_add A1 A2 A3 ⟩ ∈ pr_add $;
theorem lprog_lnth_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_lnth A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_lnth A1 A2 A3 ⟩ ∈ pr_lnth $;
theorem lprog_linst_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_linst A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_linst A1 A2 A3 ⟩ ∈ pr_linst $;
theorem lprog_lsubst_pr (G: hyps) (P A1 A2 A3 A4: class):
  $ G ⇒ ⟨ P , ra_lsubst A1 A2 A3 A4 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_lsubst A1 A2 A3 A4 ⟩ ∈ pr_lsubst $;
theorem lprog_closed_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_closed A1 A2 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_closed A1 A2 ⟩ ∈ pr_closed $;
theorem lprog_lift_pr (G: hyps) (P A1 A2 A3 A4: class):
  $ G ⇒ ⟨ P , ra_lift A1 A2 A3 A4 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_lift A1 A2 A3 A4 ⟩ ∈ pr_lift $;
theorem lprog_inst_pr (G: hyps) (P A1 A2 A3 A4: class):
  $ G ⇒ ⟨ P , ra_inst A1 A2 A3 A4 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_inst A1 A2 A3 A4 ⟩ ∈ pr_inst $;
theorem lprog_lookup_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_lookup A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_lookup A1 A2 A3 ⟩ ∈ pr_lookup $;
theorem lprog_cinst_pr (G: hyps) (P A1 A2 A3 A4 A5 A6: class):
  $ G ⇒ ⟨ P , ra_cinst A1 A2 A3 A4 A5 A6 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_cinst A1 A2 A3 A4 A5 A6 ⟩ ∈ pr_cinst $;
theorem lprog_cext_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_cext A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_cext A1 A2 A3 ⟩ ∈ pr_cext $;
theorem lprog_clen_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_clen A1 A2 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_clen A1 A2 ⟩ ∈ pr_clen $;
theorem lprog_cnth_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_cnth A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_cnth A1 A2 A3 ⟩ ∈ pr_cnth $;
theorem lprog_capp_pr (G: hyps) (P A1 A2 A3: class):
  $ G ⇒ ⟨ P , ra_capp A1 A2 A3 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_capp A1 A2 A3 ⟩ ∈ pr_capp $;
theorem lprog_bsucc_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_bsucc A1 A2 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_bsucc A1 A2 ⟩ ∈ pr_bsucc $;
theorem lprog_bdbl_pr (G: hyps) (P A1 A2: class):
  $ G ⇒ ⟨ P , ra_bdbl A1 A2 ⟩ ∈ lprog $ > $ G ⇒ ⟨ P , ra_bdbl A1 A2 ⟩ ∈ pr_bdbl $;
theorem lprog_badd_pr (G: hyps) (P A1 A2 A3: class):
