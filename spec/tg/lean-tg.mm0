-- --------------------------------------------------------------------------
-- Congruence of the atoms, substitution through them
-- --------------------------------------------------------------------------

--| @congr
theorem ra_le_congr (A1 B1 A2 B2: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ ra_le A1 A2 ≐ ra_le B1 B2 $;
theorem ra_le_eq (G: hyps) (A1 B1 A2 B2: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ ra_le A1 A2 = ra_le B1 B2 $;
--| @rewrite
theorem sb_c_ra_le {x: set} (t: set x) (A1 A2: class x): $ (⟦ x / t ⟧ (ra_le A1 A2)) ≐ ra_le (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) $;
--| @congr
theorem ra_add_congr (A1 B1 A2 B2 A3 B3: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ ra_add A1 A2 A3 ≐ ra_add B1 B2 B3 $;
