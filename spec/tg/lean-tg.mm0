--| @rewrite
theorem sb_c_ra_lnth {x: set} (t: set x) (A1 A2 A3: class x): $ (⟦ x / t ⟧ (ra_lnth A1 A2 A3)) ≐ ra_lnth (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $;
--| @congr
theorem ra_linst_congr (A1 B1 A2 B2 A3 B3: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ ra_linst A1 A2 A3 ≐ ra_linst B1 B2 B3 $;
