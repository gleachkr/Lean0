-- --------------------------------------------------------------------------
-- The instance
-- --------------------------------------------------------------------------

theorem lsig_sig (G: hyps): $ G ⇒ sig lsig lopen $;
theorem enc_nat_trees (G: hyps) (e: nat): $ G ⇒ enc_nat e ∈ trees ω $;
theorem enc_lvl_trees (G: hyps) (e: lvl): $ G ⇒ enc_lvl e ∈ trees ω $;
theorem enc_lvls_trees (G: hyps) (e: lvls): $ G ⇒ enc_lvls e ∈ trees ω $;
theorem enc_expr_trees (G: hyps) (e: expr): $ G ⇒ enc_expr e ∈ trees ω $;
theorem enc_atom_trees (G: hyps) (e: atom): $ G ⇒ enc_atom e ∈ trees ω $;
theorem enc_ctx_trees (G: hyps) (e: ctx): $ G ⇒ enc_ctx e ∈ trees ω $;
theorem enc_bin_trees (G: hyps) (e: bin): $ G ⇒ enc_bin e ∈ trees ω $;
theorem enc_blk_trees (G: hyps) (e: blk): $ G ⇒ enc_blk e ∈ trees ω $;
theorem enc_ind_trees (G: hyps) (e: ind): $ G ⇒ enc_ind e ∈ trees ω $;
theorem enc_tys_trees (G: hyps) (e: tys): $ G ⇒ enc_tys e ∈ trees ω $;
theorem enc_ctors_trees (G: hyps) (e: ctors): $ G ⇒ enc_ctors e ∈ trees ω $;

--| The trees of each sort, by constructor (`sorted_elim` at `lsig`).
theorem ofsort_nat_cases (G: hyps) {x: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_nat $ >
  $ G ⇒ (t = ⟨ kc_nz , ∅ ⟩) ∨
      ∃ x (t = ⟨ kc_s , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $;
theorem ofsort_lvl_cases (G: hyps) {x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_lvl $ >
  $ G ⇒ (t = ⟨ kc_lz , ∅ ⟩) ∨
      ∃ x (t = ⟨ kc_ls , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x ∃ y (t = ⟨ kc_lmax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x ∃ y (t = ⟨ kc_limax , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x (t = ⟨ kc_lparam , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) $;
theorem ofsort_lvls_cases (G: hyps) {x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_lvls $ >
  $ G ⇒ (t = ⟨ kc_lnil , ∅ ⟩) ∨
      ∃ x ∃ y (t = ⟨ kc_lcons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvls) $;
theorem ofsort_expr_cases (G: hyps) {u x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_expr $ >
  $ G ⇒ ∃ x (t = ⟨ kc_bvar , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_nat) ∨
      ∃ x (t = ⟨ kc_srt , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x ∃ y (t = ⟨ kc_app , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨
      ∃ x ∃ y (t = ⟨ kc_lam , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨
      ∃ x ∃ y (t = ⟨ kc_pi , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr) ∨
      ∃ x ∃ y (t = ⟨ kc_cst , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_atom ∧ y ∊ ofsort lsig lopen ks_lvls) ∨
      ∃ x (t = ⟨ kc_lit , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨
      ∃ x ∃ y (t = ⟨ kc_ind_ty , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat) ∨
      ∃ x ∃ y ∃ u (t = ⟨ kc_ind_ctor , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_nat) ∨
      ∃ x ∃ y ∃ u (t = ⟨ kc_ind_rec , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_ind ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x ∃ y ∃ u (t = ⟨ kc_proj , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_nat ∧ u ∊ ofsort lsig lopen ks_expr) ∨
      ∃ x (t = ⟨ kc_quot , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x (t = ⟨ kc_quot_mk , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x ∃ y (t = ⟨ kc_quot_lift , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl ∧ y ∊ ofsort lsig lopen ks_lvl) ∨
      ∃ x (t = ⟨ kc_quot_ind , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_lvl) $;
theorem ofsort_atom_cases (G: hyps) {n: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_atom $ >
  $ G ⇒ ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $;
theorem ofsort_ctx_cases (G: hyps) {x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_ctx $ >
  $ G ⇒ (t = ⟨ kc_nil , ∅ ⟩) ∨
      ∃ x ∃ y (t = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $;
theorem ofsort_bin_cases (G: hyps) {x: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_bin $ >
  $ G ⇒ (t = ⟨ kc_b0 , ∅ ⟩) ∨
      ∃ x (t = ⟨ kc_bd0 , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) ∨
      ∃ x (t = ⟨ kc_bd1 , scons x ∅ ⟩ ∧ x ∊ ofsort lsig lopen ks_bin) $;
theorem ofsort_blk_cases (G: hyps) {n: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_blk $ >
  $ G ⇒ (t = ⟨ kc_nat_blk , ∅ ⟩) ∨
      (t = ⟨ kc_eq_blk , ∅ ⟩) ∨
      ∃ n (n ∊ ω ∧ t = ⟨ n , ∅ ⟩) $;
theorem ofsort_ind_cases (G: hyps) {u v x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_ind $ >
  $ G ⇒ ∃ x ∃ y ∃ u (t = ⟨ kc_ind_mk , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys) ∨
      ∃ x ∃ y ∃ u ∃ v (t = ⟨ kc_ind_mkn , scons x (scons y (scons u (scons v ∅))) ⟩ ∧ x ∊ ofsort lsig lopen ks_blk ∧ y ∊ ofsort lsig lopen ks_ctx ∧ u ∊ ofsort lsig lopen ks_tys ∧ v ∊ ofsort lsig lopen ks_ctx) $;
theorem ofsort_tys_cases (G: hyps) {u x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_tys $ >
  $ G ⇒ (t = ⟨ kc_tnil , ∅ ⟩) ∨
      ∃ x ∃ y ∃ u (t = ⟨ kc_tcons , scons x (scons y (scons u ∅)) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors ∧ u ∊ ofsort lsig lopen ks_tys) $;
theorem ofsort_ctors_cases (G: hyps) {x y: set} (t: set):
  $ G ⇒ t ∊ ofsort lsig lopen ks_ctors $ >
  $ G ⇒ (t = ⟨ kc_cnil , ∅ ⟩) ∨
      ∃ x ∃ y (t = ⟨ kc_ccons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctors) $;

-- --------------------------------------------------------------------------
-- The relations of Part I
-- --------------------------------------------------------------------------

-- Each relation of Part I is the set of its derivable atoms in one program of
-- Horn clauses (horn.mm0): an atom is a relation's label with the trees of its
-- arguments, and each clause axiom of the spec gives the class of its ground
-- instances at all sets. The clause axioms are then theorems (below), and
-- induction over the derivations is `horn_ind`.

def kr_le: class = $ suc kc_quot_ind $;
def kr_add: class = $ suc kr_le $;
def kr_lnth: class = $ suc kr_add $;
def kr_linst: class = $ suc kr_lnth $;
def kr_lsubst: class = $ suc kr_linst $;
def kr_closed: class = $ suc kr_lsubst $;
def kr_lift: class = $ suc kr_closed $;
def kr_inst: class = $ suc kr_lift $;
def kr_lookup: class = $ suc kr_inst $;
def kr_cinst: class = $ suc kr_lookup $;
def kr_cext: class = $ suc kr_cinst $;
def kr_clen: class = $ suc kr_cext $;
def kr_cnth: class = $ suc kr_clen $;
def kr_capp: class = $ suc kr_cnth $;
def kr_bsucc: class = $ suc kr_capp $;
def kr_bdbl: class = $ suc kr_bsucc $;
def kr_badd: class = $ suc kr_bdbl $;
def kr_baddc: class = $ suc kr_badd $;
def kr_bmul: class = $ suc kr_baddc $;
def kr_bpow: class = $ suc kr_bmul $;
def kr_band: class = $ suc kr_bpow $;
def kr_bor: class = $ suc kr_band $;
def kr_bxor: class = $ suc kr_bor $;
def kr_ind_data: class = $ suc kr_bxor $;
def kr_ind_nested: class = $ suc kr_ind_data $;
def kr_nth_ty: class = $ suc kr_ind_nested $;
def kr_nth_ctor: class = $ suc kr_nth_ty $;
def kr_clen_c: class = $ suc kr_nth_ctor $;
def kr_ntys: class = $ suc kr_clen_c $;
def kr_minor_idx: class = $ suc kr_ntys $;
def kr_npis: class = $ suc kr_minor_idx $;
def kr_nth_pi: class = $ suc kr_npis $;
def kr_isort: class = $ suc kr_nth_pi $;
def kr_ind_arity: class = $ suc kr_isort $;
def kr_nidx: class = $ suc kr_ind_arity $;
def kr_nfields: class = $ suc kr_nidx $;
def kr_ndecl: class = $ suc kr_nfields $;
def kr_aux_of: class = $ suc kr_ndecl $;
def kr_pis: class = $ suc kr_aux_of $;
def kr_lams: class = $ suc kr_pis $;
def kr_tys_closed: class = $ suc kr_lams $;
def kr_pargs: class = $ suc kr_tys_closed $;
def kr_spine: class = $ suc kr_pargs $;
def kr_rehead: class = $ suc kr_spine $;
def kr_has_arg: class = $ suc kr_rehead $;
def kr_leaf_has: class = $ suc kr_has_arg $;
def kr_pinst: class = $ suc kr_leaf_has $;
def kr_sinst: class = $ suc kr_pinst $;
def kr_iargs: class = $ suc kr_sinst $;
def kr_indapp: class = $ suc kr_iargs $;
def kr_ipos: class = $ suc kr_indapp $;
def kr_recfield: class = $ suc kr_ipos $;
def kr_rst: class = $ suc kr_recfield $;
def kr_nst_hit: class = $ suc kr_rst $;
def kr_spz: class = $ suc kr_nst_hit $;
def kr_afree: class = $ suc kr_spz $;
def kr_spz_ctors: class = $ suc kr_afree $;
def kr_aux_data: class = $ suc kr_spz_ctors $;
def kr_mty: class = $ suc kr_aux_data $;
def kr_motives: class = $ suc kr_mty $;
def kr_ihty: class = $ suc kr_motives $;
def kr_mwalk: class = $ suc kr_ihty $;
def kr_cminors: class = $ suc kr_mwalk $;
def kr_minors: class = $ suc kr_cminors $;
def kr_rtail: class = $ suc kr_minors $;
def kr_rec_ty: class = $ suc kr_rtail $;
def kr_ctor_ty: class = $ suc kr_rec_ty $;
def kr_ihval: class = $ suc kr_ctor_ty $;
def kr_rwalk: class = $ suc kr_ihval $;
def kr_rec_rhs: class = $ suc kr_rwalk $;
def kr_struct_like: class = $ suc kr_rec_rhs $;
def kr_field_ty: class = $ suc kr_struct_like $;
def kr_qinst: class = $ suc kr_field_ty $;
def kr_nonrec: class = $ suc kr_qinst $;
def kr_eta_ok: class = $ suc kr_nonrec $;
def kr_projs: class = $ suc kr_eta_ok $;
def kr_clift: class = $ suc kr_projs $;
def kr_iota_tel: class = $ suc kr_clift $;
def kr_iota_lhs: class = $ suc kr_iota_tel $;

--| The atoms: a label and the trees of the arguments.
def latoms: class = $ ω × fseq (trees ω) $;
def ra_le (a1 a2: class): class = $ ⟨ kr_le , scons a1 (scons a2 ∅) ⟩ $;
def ra_add (a1 a2 a3: class): class = $ ⟨ kr_add , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_lnth (a1 a2 a3: class): class = $ ⟨ kr_lnth , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_linst (a1 a2 a3: class): class = $ ⟨ kr_linst , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_lsubst (a1 a2 a3 a4: class): class = $ ⟨ kr_lsubst , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_closed (a1 a2: class): class = $ ⟨ kr_closed , scons a1 (scons a2 ∅) ⟩ $;
def ra_lift (a1 a2 a3 a4: class): class = $ ⟨ kr_lift , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_inst (a1 a2 a3 a4: class): class = $ ⟨ kr_inst , scons a1 (scons a2 (scons a3 (scons a4 ∅))) ⟩ $;
def ra_lookup (a1 a2 a3: class): class = $ ⟨ kr_lookup , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_cinst (a1 a2 a3 a4 a5 a6: class): class = $ ⟨ kr_cinst , scons a1 (scons a2 (scons a3 (scons a4 (scons a5 (scons a6 ∅))))) ⟩ $;
def ra_cext (a1 a2 a3: class): class = $ ⟨ kr_cext , scons a1 (scons a2 (scons a3 ∅)) ⟩ $;
def ra_clen (a1 a2: class): class = $ ⟨ kr_clen , scons a1 (scons a2 ∅) ⟩ $;
