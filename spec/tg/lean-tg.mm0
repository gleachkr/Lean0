  $ G ⇒ ra_clift t1 t2 t3 ∈ lrel $ >
  $ G ⇒ ∃ k_v (t1 = k_v ∧ t2 = ⟨ kc_nil , ∅ ⟩ ∧ t3 = ⟨ kc_nil , ∅ ⟩) ∨
      ∃ k_v ∃ d_v ∃ A ∃ A2 ∃ X ∃ Y (t1 = k_v ∧ t2 = ⟨ kc_cons , scons A (scons X ∅) ⟩ ∧ t3 = ⟨ kc_cons , scons A2 (scons Y ∅) ⟩ ∧ ra_clift k_v X Y ∈ lrel ∧ ra_clen X d_v ∈ lrel ∧ ra_lift k_v d_v A A2 ∈ lrel) $;
theorem lrel_iota_tel_cases (G: hyps) {D b_v P T v_v i_v c_v np n_v m_v mn nf M N X Xl Q1 Q2 Dl F K K2 res C: set} (t1 t2 t3 t4 t5 t6 t7 t8: set):
  $ G ⇒ ra_iota_tel t1 t2 t3 t4 t5 t6 t7 t8 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ b_v ∃ P ∃ T ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ M ∃ N ∃ X ∃ Xl ∃ Q1 ∃ Q2 ∃ Dl ∃ F ∃ K ∃ K2 ∃ res ∃ C (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = X ∧ t6 = res ∧ t7 = nf ∧ t8 = Dl ∧ ra_ind_data D b_v P T ∈ lrel ∧ ra_clen P np ∈ lrel ∧ ra_ntys T n_v m_v ∈ lrel ∧ ra_motives D np v_v ⟨ kc_nz , ∅ ⟩ T M ∈ lrel ∧ ra_minors D np n_v ⟨ kc_nz , ∅ ⟩ ⟨ kc_nz , ∅ ⟩ T N ∈ lrel ∧ ra_nth_ty T i_v F C ∈ lrel ∧ ra_nth_ctor C c_v K ∈ lrel ∧ ra_sinst D ⟨ kc_nz , ∅ ⟩ n_v np K K2 ∈ lrel ∧ ra_pis X res K2 ∈ lrel ∧ ra_clen X nf ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_clift mn X Xl ∈ lrel ∧ ra_capp M P Q1 ∈ lrel ∧ ra_capp N Q1 Q2 ∈ lrel ∧ ra_capp Xl Q2 Dl ∈ lrel) $;
theorem lrel_iota_lhs_cases (G: hyps) {D v_v i_v c_v np n_v m_v mn nf ni a_v d1 io mo res e1 e2 e3 e4 Y T2 T0 c1 maj: set} (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11: set):
  $ G ⇒ ra_iota_lhs t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 ∈ lrel $ >
  $ G ⇒ ∃ D ∃ v_v ∃ i_v ∃ c_v ∃ np ∃ n_v ∃ m_v ∃ mn ∃ nf ∃ ni ∃ a_v ∃ d1 ∃ io ∃ mo ∃ res ∃ e1 ∃ e2 ∃ e3 ∃ e4 ∃ Y ∃ T2 ∃ T0 ∃ c1 ∃ maj (t1 = D ∧ t2 = v_v ∧ t3 = i_v ∧ t4 = c_v ∧ t5 = nf ∧ t6 = res ∧ t7 = e3 ∧ t8 = c1 ∧ t9 = maj ∧ t10 = e4 ∧ t11 = ⟨ kc_app , scons T0 (scons maj ∅) ⟩ ∧ ra_ind_arity D np n_v m_v ∈ lrel ∧ ra_nidx D i_v ni ∈ lrel ∧ ra_add m_v n_v mn ∈ lrel ∧ ra_add nf m_v a_v ∈ lrel ∧ ra_add a_v n_v d1 ∈ lrel ∧ ra_pargs ⟨ kc_ind_rec , scons D (scons i_v (scons v_v ∅)) ⟩ d1 np e1 ∈ lrel ∧ ra_pargs e1 a_v n_v e2 ∈ lrel ∧ ra_pargs e2 nf m_v e3 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ty , scons D (scons i_v ∅) ⟩ d1 np Y ∈ lrel ∧ ra_lift mn nf res T2 ∈ lrel ∧ ra_rehead Y e3 ni T2 e4 ∈ lrel ∧ ra_pargs ⟨ kc_ind_ctor , scons D (scons i_v (scons c_v ∅)) ⟩ d1 np c1 ∈ lrel ∧ ra_pargs c1 ⟨ kc_nz , ∅ ⟩ nf maj ∈ lrel ∧ ra_add io ⟨ kc_s , scons i_v ∅ ⟩ n_v ∈ lrel ∧ ra_add a_v io mo ∈ lrel ∧ ra_rehead Y ⟨ kc_bvar , scons mo ∅ ⟩ ni T2 T0 ∈ lrel) $;

--| Determinacy: two derivable atoms of a computing relation with the same
--| inputs (`tN`) have the same outputs (`uN`, `vN`).
theorem lrel_add_det (G: hyps) (t1 t2 u3 v3: set):
  $ G ⇒ ra_add t1 t2 u3 ∈ lrel $ > $ G ⇒ ra_add t1 t2 v3 ∈ lrel $ >
  $ G ⇒ u3 = v3 $;
theorem lrel_clen_det (G: hyps) (t1 u2 v2: set):
  $ G ⇒ ra_clen t1 u2 ∈ lrel $ > $ G ⇒ ra_clen t1 v2 ∈ lrel $ >
  $ G ⇒ u2 = v2 $;
theorem lrel_clen_c_det (G: hyps) (t1 u2 v2: set):
  $ G ⇒ ra_clen_c t1 u2 ∈ lrel $ > $ G ⇒ ra_clen_c t1 v2 ∈ lrel $ >
  $ G ⇒ u2 = v2 $;
theorem lrel_cnth_det (G: hyps) (t1 t2 u3 v3: set):
  $ G ⇒ ra_cnth t1 t2 u3 ∈ lrel $ > $ G ⇒ ra_cnth t1 t2 v3 ∈ lrel $ >
  $ G ⇒ u3 = v3 $;
theorem lrel_capp_det (G: hyps) (t1 t2 u3 v3: set):
  $ G ⇒ ra_capp t1 t2 u3 ∈ lrel $ > $ G ⇒ ra_capp t1 t2 v3 ∈ lrel $ >
  $ G ⇒ u3 = v3 $;
theorem lrel_npis_det (G: hyps) (t1 u2 v2: set):
  $ G ⇒ ra_npis t1 u2 ∈ lrel $ > $ G ⇒ ra_npis t1 v2 ∈ lrel $ >
  $ G ⇒ u2 = v2 $;
theorem lrel_isort_det (G: hyps) (t1 u2 v2 u3 v3: set):
  $ G ⇒ ra_isort t1 u2 u3 ∈ lrel $ > $ G ⇒ ra_isort t1 v2 v3 ∈ lrel $ >
  $ G ⇒ u2 = v2 ∧ u3 = v3 $;
theorem lrel_ndecl_det (G: hyps) (t1 t2 u3 v3: set):
  $ G ⇒ ra_ndecl t1 t2 u3 ∈ lrel $ > $ G ⇒ ra_ndecl t1 t2 v3 ∈ lrel $ >
  $ G ⇒ u3 = v3 $;
theorem lrel_nth_ty_det (G: hyps) (t1 t2 u3 v3 u4 v4: set):
  $ G ⇒ ra_nth_ty t1 t2 u3 u4 ∈ lrel $ > $ G ⇒ ra_nth_ty t1 t2 v3 v4 ∈ lrel $ >
  $ G ⇒ u3 = v3 ∧ u4 = v4 $;
theorem lrel_nth_ctor_det (G: hyps) (t1 t2 u3 v3: set):
  $ G ⇒ ra_nth_ctor t1 t2 u3 ∈ lrel $ > $ G ⇒ ra_nth_ctor t1 t2 v3 ∈ lrel $ >
  $ G ⇒ u3 = v3 $;
theorem lrel_ntys_det (G: hyps) (t1 u2 v2 u3 v3: set):
  $ G ⇒ ra_ntys t1 u2 u3 ∈ lrel $ > $ G ⇒ ra_ntys t1 v2 v3 ∈ lrel $ >
  $ G ⇒ u2 = v2 ∧ u3 = v3 $;
theorem lrel_ind_data_det (G: hyps) (t1 u2 v2 u3 v3 u4 v4: set):
  $ G ⇒ ra_ind_data t1 u2 u3 u4 ∈ lrel $ > $ G ⇒ ra_ind_data t1 v2 v3 v4 ∈ lrel $ >
  $ G ⇒ u2 = v2 ∧ u3 = v3 ∧ u4 = v4 $;
theorem lrel_ind_nested_det (G: hyps) (t1 u2 v2: set):
  $ G ⇒ ra_ind_nested t1 u2 ∈ lrel $ > $ G ⇒ ra_ind_nested t1 v2 ∈ lrel $ >
  $ G ⇒ u2 = v2 $;
theorem lrel_ind_arity_det (G: hyps) (t1 u2 v2 u3 v3 u4 v4: set):
  $ G ⇒ ra_ind_arity t1 u2 u3 u4 ∈ lrel $ > $ G ⇒ ra_ind_arity t1 v2 v3 v4 ∈ lrel $ >
  $ G ⇒ u2 = v2 ∧ u3 = v3 ∧ u4 = v4 $;
theorem lrel_nidx_det (G: hyps) (t1 t2 u3 v3: set):
  $ G ⇒ ra_nidx t1 t2 u3 ∈ lrel $ > $ G ⇒ ra_nidx t1 t2 v3 ∈ lrel $ >
  $ G ⇒ u3 = v3 $;
theorem lrel_nfields_det (G: hyps) (t1 t2 t3 u4 v4: set):
  $ G ⇒ ra_nfields t1 t2 t3 u4 ∈ lrel $ > $ G ⇒ ra_nfields t1 t2 t3 v4 ∈ lrel $ >
  $ G ⇒ u4 = v4 $;
theorem lrel_pargs_det (G: hyps) (t1 t2 t3 u4 v4: set):
  $ G ⇒ ra_pargs t1 t2 t3 u4 ∈ lrel $ > $ G ⇒ ra_pargs t1 t2 t3 v4 ∈ lrel $ >
  $ G ⇒ u4 = v4 $;
theorem lrel_rehead_det (G: hyps) (u1 v1 t2 t3 t4 u5 v5: set):
  $ G ⇒ ra_rehead u1 t2 t3 t4 u5 ∈ lrel $ > $ G ⇒ ra_rehead v1 t2 t3 t4 v5 ∈ lrel $ >
  $ G ⇒ u1 = v1 ∧ u5 = v5 $;
theorem lrel_spine_det (G: hyps) (u1 v1 t2 t3: set):
  $ G ⇒ ra_spine u1 t2 t3 ∈ lrel $ > $ G ⇒ ra_spine v1 t2 t3 ∈ lrel $ >
  $ G ⇒ u1 = v1 $;
theorem lrel_spine_det2 (G: hyps) {x y: set} (u1 v1 t2 u3 v3: set):
  $ G ⇒ ra_spine u1 t2 u3 ∈ lrel $ > $ G ⇒ ra_spine v1 t2 v3 ∈ lrel $ > $ G ⇒ ¬ ∃ x ∃ y (u1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ > $ G ⇒ ¬ ∃ x ∃ y (v1 = ⟨ kc_app , scons x (scons y ∅) ⟩) $ >
  $ G ⇒ u1 = v1 ∧ u3 = v3 $;

