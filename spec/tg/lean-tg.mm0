--| @rewrite
theorem sb_c_ra_linst {x: set} (t: set x) (A1 A2 A3: class x): $ (⟦ x / t ⟧ (ra_linst A1 A2 A3)) ≐ ra_linst (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $;
--| @congr
theorem ra_lsubst_congr (A1 B1 A2 B2 A3 B3 A4 B4: class): $ A1 ≐ B1 $ > $ A2 ≐ B2 $ > $ A3 ≐ B3 $ > $ A4 ≐ B4 $ > $ ra_lsubst A1 A2 A3 A4 ≐ ra_lsubst B1 B2 B3 B4 $;
theorem ra_lsubst_eq (G: hyps) (A1 B1 A2 B2 A3 B3 A4 B4: class): $ G ⇒ A1 = B1 $ > $ G ⇒ A2 = B2 $ > $ G ⇒ A3 = B3 $ > $ G ⇒ A4 = B4 $ > $ G ⇒ ra_lsubst A1 A2 A3 A4 = ra_lsubst B1 B2 B3 B4 $;
--| @rewrite
