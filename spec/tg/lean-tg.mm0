--| @rewrite
theorem sb_c_ra_add {x: set} (t: set x) (A1 A2 A3: class x): $ (⟦ x / t ⟧ (ra_add A1 A2 A3)) ≐ ra_add (⟦ x / t ⟧ A1) (⟦ x / t ⟧ A2) (⟦ x / t ⟧ A3) $;
--| @congr
