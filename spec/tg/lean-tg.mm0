axiom enc_nat_sorted (e: nat): $ _ ⇒ enc_nat e ∈ ofsort lsig lopen ks_nat $;
axiom enc_lvl_sorted (e: lvl): $ _ ⇒ enc_lvl e ∈ ofsort lsig lopen ks_lvl $;
axiom enc_lvls_sorted (e: lvls): $ _ ⇒ enc_lvls e ∈ ofsort lsig lopen ks_lvls $;
