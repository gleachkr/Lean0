--| A set is in the universal class.
lemma u2_vuniv {v: set} (G: hyps) (K: class): $ G ⇒ isset K $ > $ G ⇒ K ∈ {v | v = v} $
----
l1: $ G , u = K ⇒ u = u $ by eq_refl
l2: $ G ⇒ K ∈ {v | v = v} $ by wcel_cab_intro [#1, l1]

--| Inversion of a nonempty argument-sort list against a tree list.
lemma u2_uncons {x y: set} (G: hyps) (X K L W: class) (s: set):
  $ G ⇒ isset K $ > $ G ⇒ L ∈ fseq W $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ cdm s = cdm (scons K L) $ >
  $ G ⇒ szip (scons K L) s ⊆ X $ > $ G ⇒ ∃ x ∃ y (s = scons x y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , x ⟩ ∈ X) $
----
f1: $ G ⇒ s = ∅ ∨ ∃ i ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) $ by fseq_cases [#3]
g0: $ G , s = ∅ ⇒ s = ∅ $ by ax
g0a: $ G , s = ∅ ⇒ isset K $ by weaken [#1]
g0b: $ G , s = ∅ ⇒ L ∈ fseq W $ by weaken [#2]
g1: $ G , s = ∅ ⇒ cdm (scons K L) = suc (cdm L) $ by u2_scons_len_c [g0a, g0b]
g2: $ G , s = ∅ ⇒ cdm s = cdm ∅ $ by cdm_eq [g0]
g3: $ G , s = ∅ ⇒ cdm ∅ = ∅ $ by cdm_empty
g4: $ G , s = ∅ ⇒ cdm s = cdm (scons K L) $ by weaken [#4]
g5: $ G , s = ∅ ⇒ cdm (scons K L) = cdm s $ by eq_sym [g4]
g6: $ G , s = ∅ ⇒ suc (cdm L) = cdm (scons K L) $ by eq_sym [g1]
g7: $ G , s = ∅ ⇒ suc (cdm L) = cdm s $ by eq_trans [g6, g5]
g8: $ G , s = ∅ ⇒ suc (cdm L) = cdm ∅ $ by eq_trans [g7, g2]
g9: $ G , s = ∅ ⇒ suc (cdm L) = ∅ $ by eq_trans [g8, g3]
g10: $ G , s = ∅ ⇒ ⊥ $ by suc_ne_empty [g9]
g11: $ G , s = ∅ ⇒ ∃ x ∃ y (s = scons x y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , x ⟩ ∈ X) $ by bot_elim [g10]
h1: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j $ by ax
h2: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ j ∊ fseq (trees ω) ∧ s = scons i j $ by and_elim_r [h1]
h3: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ j ∊ fseq (trees ω) $ by and_elim_l [h2]
h4: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ s = scons i j $ by and_elim_r [h2]
h5: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm (scons i j) = suc (cdm j) $ by scons_len [h3]
h6: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm s = cdm (scons i j) $ by cdm_eq [h4]
h7a: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset K $ by weaken [#1]
h7b: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ L ∈ fseq W $ by weaken [#2]
h7: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm (scons K L) = suc (cdm L) $ by u2_scons_len_c [h7a, h7b]
h8: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm s = cdm (scons K L) $ by weaken [#4]
h9: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ suc (cdm j) = cdm (scons i j) $ by eq_sym [h5]
h10: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm (scons i j) = cdm s $ by eq_sym [h6]
h11: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ suc (cdm j) = cdm s $ by eq_trans [h9, h10]
h12: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ suc (cdm j) = cdm (scons K L) $ by eq_trans [h11, h8]
h13: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ suc (cdm j) = suc (cdm L) $ by eq_trans [h12, h7]
h14: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset j $ by isset_var
h15: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset (cdm j) $ by cdm_set [h14]
h16: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset L $ by wcel_isset [h7b]
h17: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset (cdm L) $ by cdm_set [h16]
h18: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm j = cdm L $ by suc_inj_c [h15, h17, h13]
h19: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ scons K L = scons K L $ by eq_refl
h20: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip (scons K L) s = szip (scons K L) (scons i j) $ by szip_eq [h19, h4]
h21: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset i $ by isset_var
h22: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip (scons K L) (scons i j) = csn ⟨ K , i ⟩ ∪ szip L j $ by u2_szip_scons_c [h7a, h21, h7b, h14]
h23: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip (scons K L) s = csn ⟨ K , i ⟩ ∪ szip L j $ by eq_trans [h20, h22]
h24: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip (scons K L) s ⊆ X $ by weaken [#5]
h25: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ csn ⟨ K , i ⟩ ∪ szip L j ⊆ X $ by subset_eq_l [h23, h24]
h26: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ csn ⟨ K , i ⟩ ⊆ csn ⟨ K , i ⟩ ∪ szip L j $ by cun_subset_l
h27: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip L j ⊆ csn ⟨ K , i ⟩ ∪ szip L j $ by cun_subset_r
h28: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ csn ⟨ K , i ⟩ ⊆ X $ by subset_trans [h26, h25]
h29: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip L j ⊆ X $ by subset_trans [h27, h25]
h30: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ isset ⟨ K , i ⟩ $ by opair_isset
h31: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ ⟨ K , i ⟩ ∈ csn ⟨ K , i ⟩ $ by cpr_intro_l_c [h30]
h32: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ ⟨ K , i ⟩ ∈ X $ by wcel_subset [h28, h31]
h33: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ szip L j ⊆ X ∧ ⟨ K , i ⟩ ∈ X $ by and_intro [h29, h32]
h34: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ cdm j = cdm L ∧ szip L j ⊆ X ∧ ⟨ K , i ⟩ ∈ X $ by and_intro [h18, h33]
h35: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ j ∊ fseq (trees ω) ∧ cdm j = cdm L ∧ szip L j ⊆ X ∧ ⟨ K , i ⟩ ∈ X $ by and_intro [h3, h34]
h36: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ s = scons i j ∧ j ∊ fseq (trees ω) ∧ cdm j = cdm L ∧ szip L j ⊆ X ∧ ⟨ K , i ⟩ ∈ X $ by and_intro [h4, h35]
h37: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ ∃ y (s = scons i y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , i ⟩ ∈ X) $ by ex_intro [h36]
h38: $ G , i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j ⇒ ∃ x ∃ y (s = scons x y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , x ⟩ ∈ X) $ by ex_intro [h37]
h39: $ G , ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) ⇒ ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) $ by ax
h40: $ G , ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) ⇒ ∃ x ∃ y (s = scons x y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , x ⟩ ∈ X) $ by ex_elim [h39, h38]
h41: $ G , ∃ i ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) ⇒ ∃ i ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) $ by ax
h42: $ G , ∃ i ∃ j (i ∊ trees ω ∧ j ∊ fseq (trees ω) ∧ s = scons i j) ⇒ ∃ x ∃ y (s = scons x y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , x ⟩ ∈ X) $ by ex_elim [h41, h40]
f2: $ G ⇒ ∃ x ∃ y (s = scons x y ∧ y ∊ fseq (trees ω) ∧ cdm y = cdm L ∧ szip L y ⊆ X ∧ ⟨ K , x ⟩ ∈ X) $ by or_elim [f1, g11, h42]

