p2: $ G ⇒ (scons K2 (scons K3 ∅)) ∈ fseq ω ∧ (scons A2 (scons A3 ∅)) ∈ fseq (trees ω) ∧ cdm (scons A2 (scons A3 ∅)) = cdm (scons K2 (scons K3 ∅)) ∧ szip (scons K2 (scons K3 ∅)) (scons A2 (scons A3 ∅)) ⊆ sorted T O $ by u2_inv_step [#1, #4, p1]
p3: $ G ⇒ (scons K1 (scons K2 (scons K3 ∅))) ∈ fseq ω ∧ (scons A1 (scons A2 (scons A3 ∅))) ∈ fseq (trees ω) ∧ cdm (scons A1 (scons A2 (scons A3 ∅))) = cdm (scons K1 (scons K2 (scons K3 ∅))) ∧ szip (scons K1 (scons K2 (scons K3 ∅))) (scons A1 (scons A2 (scons A3 ∅))) ⊆ sorted T O $ by u2_inv_step [#1, #3, p2]
q1: $ G ⇒ ⟨ C , scons A1 (scons A2 (scons A3 ∅)) ⟩ ∈ ofsort T O K $ by u2_inv_fin [#1, #2, p3]

ofsort_node4
------------
p0: $ G ⇒ ∅ ∈ fseq ω ∧ ∅ ∈ fseq (trees ω) ∧ cdm ∅ = cdm ∅ ∧ szip ∅ ∅ ⊆ sorted T O $ by u2_inv_base
p1: $ G ⇒ (scons K4 ∅) ∈ fseq ω ∧ (scons A4 ∅) ∈ fseq (trees ω) ∧ cdm (scons A4 ∅) = cdm (scons K4 ∅) ∧ szip (scons K4 ∅) (scons A4 ∅) ⊆ sorted T O $ by u2_inv_step [#1, #6, p0]
p2: $ G ⇒ (scons K3 (scons K4 ∅)) ∈ fseq ω ∧ (scons A3 (scons A4 ∅)) ∈ fseq (trees ω) ∧ cdm (scons A3 (scons A4 ∅)) = cdm (scons K3 (scons K4 ∅)) ∧ szip (scons K3 (scons K4 ∅)) (scons A3 (scons A4 ∅)) ⊆ sorted T O $ by u2_inv_step [#1, #5, p1]
p3: $ G ⇒ (scons K2 (scons K3 (scons K4 ∅))) ∈ fseq ω ∧ (scons A2 (scons A3 (scons A4 ∅))) ∈ fseq (trees ω) ∧ cdm (scons A2 (scons A3 (scons A4 ∅))) = cdm (scons K2 (scons K3 (scons K4 ∅))) ∧ szip (scons K2 (scons K3 (scons K4 ∅))) (scons A2 (scons A3 (scons A4 ∅))) ⊆ sorted T O $ by u2_inv_step [#1, #4, p2]
p4: $ G ⇒ (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) ∈ fseq ω ∧ (scons A1 (scons A2 (scons A3 (scons A4 ∅)))) ∈ fseq (trees ω) ∧ cdm (scons A1 (scons A2 (scons A3 (scons A4 ∅)))) = cdm (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) ∧ szip (scons K1 (scons K2 (scons K3 (scons K4 ∅)))) (scons A1 (scons A2 (scons A3 (scons A4 ∅)))) ⊆ sorted T O $ by u2_inv_step [#1, #3, p3]
