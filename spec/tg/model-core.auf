a1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ uadm x0 $ by ax
a2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ w ∊ lvals $ by ax
a3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ v ∊ sat x0 M (enc_ctx G2) w $ by ax
a4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ ∃ x1 ∃ x2 (x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2) $ by cext_den [#2, a2, a3]
k0: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 $ by ax
k1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x1 ∊ fseq x0 $ by and_elim_l [k0]
k2a: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 $ by and_elim_r [k0]
k2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ cdm x1 = fv nvf (enc_nat n) $ by and_elim_l [k2a]
k3a: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 $ by and_elim_r [k2a]
k3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x2 ∊ sat x0 M (enc_ctx G) w $ by and_elim_l [k3a]
k4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ v = scat x1 x2 $ by and_elim_r [k3a]
k5: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ sat x0 M (enc_ctx G) w ⊆ fseq x0 $ by sat_fseq
k6: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x2 ∊ fseq x0 $ by subset_elim [k5, k3]
k7: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ uadm x0 $ by ax
k8: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ w ∊ lvals $ by ax
e1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) = dt x0 M (enc_expr e) w x2 $ by lift0_den [#3, k8, k1, k2, k6]
