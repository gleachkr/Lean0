g4b: $ H , z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p , r ∊ fseq u ⇒ kexa ⊆ kstr $ by kexa_kstr
g4c: $ H , z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p , r ∊ fseq u ⇒ kc_quot_ind ∈ kstr $ by wcel_subset [g4b, g4a]
g5: $ H , z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p , r ∊ fseq u ⇒ isset (scons o ∅) $ by weaken [iz0]
g7: $ H , z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p , r ∊ fseq u ⇒ ra_eeqv z t ∈ lrel2 $ by weaken [p7]
br: $ H , z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p , r ∊ fseq u ⇒ dt u M z w r = dt u M t w r $ by g3_minv_e [g1, g2, b1, g4a, g5, g7, b8, b9]
s3: $ H , z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p ⇒ dt u M z w r = dt u M t w r $ by g3_split [p6, e0, kzc, iz0, tt, e1, kzc, it0, br]
fin: $ H ⇒ z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p → dt u M z w r = dt u M t w r $ by imp_intro [s3]

--| The induction step: a node and every tree it is `eeqv` to have the same
--| value, when its children are in the class.
lemma g3_node (G: hyps) (M: class) (u w r z k j t: set): $ G ⇒ minv M $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ crn j ⊆ g3_P u M w $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ ra_eeqv z t ∈ lrel2 $ > $ G ⇒ dt u M z w r = dt u M t w r $
----
d0: $ G ⇒ ∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2) ∨ ∃ o ∃ p (z = ⟨ kc_quot , scons o ∅ ⟩ ∧ t = ⟨ kc_quot , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ p (z = ⟨ kc_quot_mk , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ v ∃ p ∃ x8 (z = ⟨ kc_quot_lift , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons p (scons x8 ∅) ⟩ ∧ lveq o p ∧ lveq v x8) ∨ ∃ o ∃ p (z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p) $ by lrel2_eeqv_cases [#7]
k0: $ G ⇒ z = e ∧ t = e → dt u M z w r = dt u M t w r $ by g3_k_refl [#1, #2, #3, #4, #5, #6, #7]
