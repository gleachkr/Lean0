q1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x0 = x0 $ by eq_refl
q2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ M = M $ by eq_refl
q3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ w = w $ by eq_refl
