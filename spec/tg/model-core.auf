g6: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr A) w x2 = dt x0 M (enc_expr R) w (scat x1 x2) $ by eq_sym [e3]
