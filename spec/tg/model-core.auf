-- Proofs for model-core.mm0.

mbvar
-----
a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ fseq u $ by subset_elim [s1, a2]
t1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_nat i ∈ trees ω $ by enc_nat_trees
d1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_bvar , scons (enc_nat i) ∅ ⟩ w r = fv r (fv nvf (enc_nat i)) $ by dt_bvar [t1, a1, s2]
d2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ fv r (fv nvf (enc_nat i)) = dt u M (enc_expr (bvar i)) w r $ by eq_sym [d1]
l1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ fv r (fv nvf (enc_nat i)) ∈ dt u M (enc_expr A) w r $ by lookup_den [#1, a1, a2]
m1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr (bvar i)) w r ∈ dt u M (enc_expr A) w r $ by wcel_eq_l [d2, l1]
e1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr (bvar i)) w r = dt u M (enc_expr (bvar i)) w r $ by eq_refl
r1: $ mdeq M G (bvar i) (bvar i) A $ by mdeq_i [e1, m1]

mappDF
------
a1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
a2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ r ∊ fseq u $ by subset_elim [s1, a3]
tf: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr f ∈ trees ω $ by enc_expr_trees
ta: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr a ∈ trees ω $ by enc_expr_trees
tf2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr f2 ∈ trees ω $ by enc_expr_trees
ta2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr a2 ∈ trees ω $ by enc_expr_trees
tA: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
tB: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ enc_expr B ∈ trees ω $ by enc_expr_trees
d1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ w r = ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) $ by dt_app [tf, ta, a2, s2]
d2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_app , scons (enc_expr f2) (scons (enc_expr a2) ∅) ⟩ w r = ap (dt u M (enc_expr f2) w r) (dt u M (enc_expr a2) w r) $ by dt_app [tf2, ta2, a2, s2]
d3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ w r = cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) $ by dt_pi [tA, tB, a2, s2]
e1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr f) w r = dt u M (enc_expr f2) w r $ by mdeq_e [#1, a1, a2, a3]
e2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr a) w r = dt u M (enc_expr a2) w r $ by mdeq_e [#2, a1, a2, a3]
e3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) = ap (dt u M (enc_expr f2) w r) (dt u M (enc_expr a2) w r) $ by ap_eq [e1, e2]
e4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ap (dt u M (enc_expr f2) w r) (dt u M (enc_expr a2) w r) = dt u M ⟨ kc_app , scons (enc_expr f2) (scons (enc_expr a2) ∅) ⟩ w r $ by eq_sym [d2]
e5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) = dt u M ⟨ kc_app , scons (enc_expr f2) (scons (enc_expr a2) ∅) ⟩ w r $ by eq_trans [e3, e4]
e6: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ w r = dt u M ⟨ kc_app , scons (enc_expr f2) (scons (enc_expr a2) ∅) ⟩ w r $ by eq_trans [d1, e5]
m1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr f) w r ∈ dt u M ⟨ kc_pi , scons (enc_expr A) (scons (enc_expr B) ∅) ⟩ w r $ by mdeq_mem [#1, a1, a2, a3]
m2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr f) w r ∈ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) $ by wcel_eq_r [d3, m1]
m3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr a) w r ∈ dt u M (enc_expr A) w r $ by mdeq_mem [#2, a1, a2, a3]
n1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) $ by ax
n2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ z ∊ dt u M (enc_expr A) w r $ by ax
n3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ ap y z ∈ dt u M (enc_expr B) w (scons z r) $ by cpi_elim_ap [n1, n2]
n4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ y = dt u M (enc_expr f) w r $ by ax
n5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ z = dt u M (enc_expr a) w r $ by ax
n6: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ ap y z = ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) $ by ap_eq [n4, n5]
n7: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (scons z r) $ by wcel_eq_l [n6, n3]
q1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ u = u $ by eq_refl
q2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ M = M $ by eq_refl
q3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ enc_expr B = enc_expr B $ by eq_refl
q4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ w = w $ by eq_refl
q5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ r = r $ by eq_refl
q6: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ scons z r = scons (dt u M (enc_expr a) w r) r $ by scons_eq [n5, q5]
q7: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ dt u M (enc_expr B) w (scons z r) = dt u M (enc_expr B) w (scons (dt u M (enc_expr a) w r) r) $ by dt_eq [q1, q2, q3, q4, q6]
n8: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) , z = dt u M (enc_expr a) w r , z ∊ dt u M (enc_expr A) w r ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (scons (dt u M (enc_expr a) w r) r) $ by wcel_eq_r [q7, n7]
n9: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr f) w r , y ∊ cpi x (dt u M (enc_expr A) w r) (dt u M (enc_expr B) w (scons x r)) ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (scons (dt u M (enc_expr a) w r) r) $ by wcel_elim [m3, n8]
n10: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr B) w (scons (dt u M (enc_expr a) w r) r) $ by wcel_elim [m2, n9]
i1: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr R) w r = dt u M (enc_expr B) w (scons (dt u M (enc_expr a) w r) r) $ by inst0_den [#3, a1, a2, s2]
i2: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr B) w (scons (dt u M (enc_expr a) w r) r) = dt u M (enc_expr R) w r $ by eq_sym [i1]
i3: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) ∈ dt u M (enc_expr R) w r $ by wcel_eq_r [i2, n10]
i4: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ ap (dt u M (enc_expr f) w r) (dt u M (enc_expr a) w r) = dt u M ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ w r $ by eq_sym [d1]
i5: $ uadm u , w ∊ lvals , r ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_app , scons (enc_expr f) (scons (enc_expr a) ∅) ⟩ w r ∈ dt u M (enc_expr R) w r $ by wcel_eq_l [i4, i3]
l1: $ mdeq M G (app f a) (app f2 a2) R $ by mdeq_i [e6, i5]

