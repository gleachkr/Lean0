lemma g3_k_lit (H: hyps) (M: class) (u w r z k j t n: set): $ H ⇒ minv M $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ g3_P u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ → dt u M z w r = dt u M t w r $
----
c0: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ $ by ax
e0: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ z = ⟨ kc_lit , scons n ∅ ⟩ $ by and_elim_l [c0]
r0: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ t = ⟨ kc_lit , scons n ∅ ⟩ $ by and_elim_r [c0]
s1: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ ⟨ kc_lit , scons n ∅ ⟩ = t $ by eq_sym [r0]
s2: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ z = t $ by eq_trans [e0, s1]
q1: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ u = u $ by eq_refl
q2: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ M = M $ by eq_refl
q3: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ w = w $ by eq_refl
q4: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ r = r $ by eq_refl
s3: $ H , z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ ⇒ dt u M z w r = dt u M t w r $ by dt_eq [q1, q2, s2, q3, q4]
fin: $ H ⇒ z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩ → dt u M z w r = dt u M t w r $ by imp_intro [s3]

lemma g3_k_cst (H: hyps) (M: class) (u w r z k j t a x4 x5: set): $ H ⇒ minv M $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ g3_P u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 → dt u M z w r = dt u M t w r $
----
c0: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 $ by ax
e0: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ $ by and_elim_l [c0]
r0: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 $ by and_elim_r [c0]
e1: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ $ by and_elim_l [r0]
r1: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ ra_lseqv x4 x5 ∈ lrel2 $ by and_elim_r [r0]
p1: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ minv M $ by weaken [#1]
p2: $ H , z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2 ⇒ uadm u $ by weaken [#2]
