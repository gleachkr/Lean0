a1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ uadm u $ by ax
a2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ w ∊ lvals $ by ax
a3: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ v ∊ sat u M (enc_ctx G) w $ by ax
s1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ sat u M (enc_ctx G) w ⊆ fseq u $ by sat_fseq
s2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ v ∊ fseq u $ by subset_elim [s1, a3]
tA: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ enc_expr A ∈ trees ω $ by enc_expr_trees
te: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ enc_expr e ∈ trees ω $ by enc_expr_trees
ta: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ enc_expr a ∈ trees ω $ by enc_expr_trees
tG: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ enc_ctx G ∈ trees ω $ by enc_ctx_trees
tL: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ enc_expr (lam A e) ∈ trees ω $ by enc_expr_trees
d1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_app , scons ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr e) ∅) ⟩ (scons (enc_expr a) ∅) ⟩ w v = ap (dt u M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr e) ∅) ⟩ w v) (dt u M (enc_expr a) w v) $ by dt_app [tL, ta, a2, s2]
d2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ dt u M ⟨ kc_lam , scons (enc_expr A) (scons (enc_expr e) ∅) ⟩ w v = clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v)) $ by dt_lam [tA, te, a2, s2]
m3: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr a) w v ∈ dt u M (enc_expr A) w v $ by mdeq_mem [#2, a1, a2, a3]
k1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ dt u M (enc_expr A) w v ∈ u $ by den_in_u [a1, a2, s2]
k2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w ⇒ universe u $ by uadm_universe [a1]
n1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ y ∊ dt u M (enc_expr A) w v $ by ax
n2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ y = dt u M (enc_expr a) w v $ by ax
n3: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) y = dt u M (enc_expr e) w (scons y v) $ by clam_ap [n1]
q1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ u = u $ by eq_refl
q2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ M = M $ by eq_refl
q3: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ enc_expr e = enc_expr e $ by eq_refl
q4: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ w = w $ by eq_refl
q5: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ v = v $ by eq_refl
q6: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v)) = clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v)) $ by eq_refl
q7: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ scons y v = scons (dt u M (enc_expr a) w v) v $ by scons_eq [n2, q5]
q8: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ dt u M (enc_expr e) w (scons y v) = dt u M (enc_expr e) w (scons (dt u M (enc_expr a) w v) v) $ by dt_eq [q1, q2, q3, q4, q7]
q9: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) y = ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) (dt u M (enc_expr a) w v) $ by ap_eq [q6, n2]
q10: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) (dt u M (enc_expr a) w v) = ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) y $ by eq_sym [q9]
q11: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) (dt u M (enc_expr a) w v) = dt u M (enc_expr e) w (scons y v) $ by eq_trans [q10, n3]
q12: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ ap (clam x (dt u M (enc_expr A) w v) (dt u M (enc_expr e) w (scons x v))) (dt u M (enc_expr a) w v) = dt u M (enc_expr e) w (scons (dt u M (enc_expr a) w v) v) $ by eq_trans [q11, q8]
p1: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ enc_expr A ∈ trees ω $ by weaken [tA]
p2: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ enc_ctx G ∈ trees ω $ by weaken [tG]
p3: $ uadm u , w ∊ lvals , v ∊ sat u M (enc_ctx G) w , y = dt u M (enc_expr a) w v , y ∊ dt u M (enc_expr A) w v ⇒ w ∊ lvals $ by ax
