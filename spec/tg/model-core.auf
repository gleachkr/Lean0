o2: $ G ⇒ (∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2) ∨ ∃ o ∃ p (z = ⟨ kc_quot , scons o ∅ ⟩ ∧ t = ⟨ kc_quot , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ p (z = ⟨ kc_quot_mk , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ v ∃ p ∃ x8 (z = ⟨ kc_quot_lift , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons p (scons x8 ∅) ⟩ ∧ lveq o p ∧ lveq v x8) ∨ ∃ o ∃ p (z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p)) → dt u M z w r = dt u M t w r $ by g3_ori [k2b0, o3]
o1: $ G ⇒ (∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2) ∨ ∃ o ∃ p (z = ⟨ kc_quot , scons o ∅ ⟩ ∧ t = ⟨ kc_quot , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ p (z = ⟨ kc_quot_mk , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ v ∃ p ∃ x8 (z = ⟨ kc_quot_lift , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons p (scons x8 ∅) ⟩ ∧ lveq o p ∧ lveq v x8) ∨ ∃ o ∃ p (z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p)) → dt u M z w r = dt u M t w r $ by g3_ori [k1b0, o2]
o0: $ G ⇒ (∃ e (z = e ∧ t = e) ∨ ∃ i (z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩) ∨ ∃ l ∃ m (z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m) ∨ ∃ f ∃ a ∃ g ∃ h (z = ⟨ kc_app , scons f (scons a ∅) ⟩ ∧ t = ⟨ kc_app , scons g (scons h ∅) ⟩ ∧ ra_eeqv f g ∈ lrel2 ∧ ra_eeqv a h ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_lam , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_lam , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ x0 ∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_pi , scons x0 (scons x1 ∅) ⟩ ∧ t = ⟨ kc_pi , scons x2 (scons x3 ∅) ⟩ ∧ ra_eeqv x0 x2 ∈ lrel2 ∧ ra_eeqv x1 x3 ∈ lrel2) ∨ ∃ n (z = ⟨ kc_lit , scons n ∅ ⟩ ∧ t = ⟨ kc_lit , scons n ∅ ⟩) ∨ ∃ a ∃ x4 ∃ x5 (z = ⟨ kc_cst , scons a (scons x4 ∅) ⟩ ∧ t = ⟨ kc_cst , scons a (scons x5 ∅) ⟩ ∧ ra_lseqv x4 x5 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i (z = ⟨ kc_ind_ty , scons x6 (scons i ∅) ⟩ ∧ t = ⟨ kc_ind_ty , scons x7 (scons i ∅) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ c (z = ⟨ kc_ind_ctor , scons x6 (scons i (scons c ∅)) ⟩ ∧ t = ⟨ kc_ind_ctor , scons x7 (scons i (scons c ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2) ∨ ∃ x6 ∃ x7 ∃ i ∃ v ∃ x8 (z = ⟨ kc_ind_rec , scons x6 (scons i (scons v ∅)) ⟩ ∧ t = ⟨ kc_ind_rec , scons x7 (scons i (scons x8 ∅)) ⟩ ∧ ra_ind_eqv x6 x7 ∈ lrel2 ∧ lveq v x8) ∨ ∃ x1 ∃ i ∃ e ∃ x9 (z = ⟨ kc_proj , scons x1 (scons i (scons e ∅)) ⟩ ∧ t = ⟨ kc_proj , scons x1 (scons i (scons x9 ∅)) ⟩ ∧ ra_eeqv e x9 ∈ lrel2) ∨ ∃ o ∃ p (z = ⟨ kc_quot , scons o ∅ ⟩ ∧ t = ⟨ kc_quot , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ p (z = ⟨ kc_quot_mk , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_mk , scons p ∅ ⟩ ∧ lveq o p) ∨ ∃ o ∃ v ∃ p ∃ x8 (z = ⟨ kc_quot_lift , scons o (scons v ∅) ⟩ ∧ t = ⟨ kc_quot_lift , scons p (scons x8 ∅) ⟩ ∧ lveq o p ∧ lveq v x8) ∨ ∃ o ∃ p (z = ⟨ kc_quot_ind , scons o ∅ ⟩ ∧ t = ⟨ kc_quot_ind , scons p ∅ ⟩ ∧ lveq o p)) → dt u M z w r = dt u M t w r $ by g3_ori [k0b0, o1]
fin: $ G ⇒ dt u M z w r = dt u M t w r $ by imp_elim [o0, d0]

--| By induction on the trees.
lemma g3_all (G: hyps) (M: class) (u w: set): $ G ⇒ minv M $ > $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ trees ω ⊆ g3_P u M w $
----
a1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ minv M $ by weaken [#1]
a2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ uadm u $ by weaken [#2]
a3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ w ∊ lvals $ by weaken [#3]
a4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ crn j ⊆ g3_P u M w $ by ax
a5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ z = ⟨ k , j ⟩ $ by ax
a6k: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ k ∊ ω $ by ax
a6j: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ j ∊ fseq (trees ω) $ by ax
a6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ z ∊ trees ω $ by g3_ztree [a6k, a6j, a5]
a7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ ra_eeqv z t ∈ lrel2 $ by ax
n1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ , ra_eeqv z t ∈ lrel2 ⇒ dt u M z w r = dt u M t w r $ by g3_node [a1, a2, a3, a4, a5, a6, a7]
n2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ ⇒ z ∊ g3_P u M w $ by g3_P_i [n1]
n3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ g3_P u M w $ by wcel_intro [n3, n2]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
n6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ g3_P u M w ⇒ ⟨ k , j ⟩ ∈ g3_P u M w $ by isset_elim [n5, n4]
n7: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ g3_P u M w → ⟨ k , j ⟩ ∈ g3_P u M w $ by imp_intro [n6]
n8: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ g3_P u M w → ⟨ k , j ⟩ ∈ g3_P u M w $ by imp_intro [n7]
n9: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ g3_P u M w → ⟨ k , j ⟩ ∈ g3_P u M w $ by imp_intro [n8]
n10: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ g3_P u M w → ⟨ k , j ⟩ ∈ g3_P u M w) $ by all_intro [n9]
n11: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ g3_P u M w → ⟨ k , j ⟩ ∈ g3_P u M w) $ by all_intro [n10]
n12: $ G ⇒ isset ω $ by omega_set
n13: $ G ⇒ trees ω ⊆ g3_P u M w $ by trees_ind_c [n12, n11]

lrel2_eeqv_dt
-------------
l1: $ G ⇒ trees ω ⊆ g3_P u M w $ by g3_all [#1, #2, #5]
l2: $ G ⇒ sig lsig lopen $ by lsig_sig
l3: $ G ⇒ ofsort lsig lopen ks_expr ⊆ trees ω $ by ofsort_trees [l2]
l4: $ G ⇒ t ∊ trees ω $ by subset_elim [l3, #3]
l5: $ G ⇒ t ∊ g3_P u M w $ by subset_elim [l1, l4]
l6: $ G ⇒ isset r $ by isset_var
l7: $ G ⇒ dt u M t w r = dt u M t2 w r $ by g3_P_e [l5, #4, l6]

eeqv_dt
-------
l1: $ _ ⇒ enc_expr e ∈ ofsort lsig lopen ks_expr $ by enc_expr_sorted
l2: $ G ⇒ enc_expr e ∈ ofsort lsig lopen ks_expr $ by weaken [l1]
l3: $ G ⇒ enc_expr e2 ∈ trees ω $ by enc_expr_trees
l4: $ G ⇒ isset (enc_expr e2) $ by wcel_isset [l3]
h1: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ minv M $ by weaken [#1]
h2: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ uadm u $ by weaken [#3]
h3: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ x ∊ ofsort lsig lopen ks_expr $ by ax
h4: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ ra_eeqv (enc_expr e) (enc_expr e2) ∈ lrel2 $ by weaken [#2]
h5: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ x = enc_expr e $ by ax
h6: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ y = enc_expr e2 $ by ax
h7: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ enc_expr e = x $ by eq_sym [h5]
h8: $ G , x = enc_expr e , x ∊ ofsort lsig lopen ks_expr , y = enc_expr e2 ⇒ enc_expr e2 = y $ by eq_sym [h6]
