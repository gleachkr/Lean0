-------
a1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ uadm x0 $ by ax
a2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ w ∊ lvals $ by ax
a3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ v ∊ sat x0 M (enc_ctx G2) w $ by ax
a4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ ∃ x1 ∃ x2 (x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2) $ by cext_den [#2, a2, a3]
k0: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 $ by ax
k1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x1 ∊ fseq x0 $ by and_elim_l [k0]
k2a: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 $ by and_elim_r [k0]
k2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ cdm x1 = fv nvf (enc_nat n) $ by and_elim_l [k2a]
k3a: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 $ by and_elim_r [k2a]
k3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x2 ∊ sat x0 M (enc_ctx G) w $ by and_elim_l [k3a]
k4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ v = scat x1 x2 $ by and_elim_r [k3a]
k5: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ sat x0 M (enc_ctx G) w ⊆ fseq x0 $ by sat_fseq
k6: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x2 ∊ fseq x0 $ by subset_elim [k5, k3]
k7: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ uadm x0 $ by ax
k8: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ w ∊ lvals $ by ax
e1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) = dt x0 M (enc_expr e) w x2 $ by lift0_den [#3, k8, k1, k2, k6]
e2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r2) w (scat x1 x2) = dt x0 M (enc_expr e2) w x2 $ by lift0_den [#4, k8, k1, k2, k6]
e3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr R) w (scat x1 x2) = dt x0 M (enc_expr A) w x2 $ by lift0_den [#5, k8, k1, k2, k6]
m1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr e) w x2 = dt x0 M (enc_expr e2) w x2 $ by mdeq_e [#1, k7, k8, k3]
m2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr e) w x2 ∈ dt x0 M (enc_expr A) w x2 $ by mdeq_mem [#1, k7, k8, k3]
g1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) = dt x0 M (enc_expr e2) w x2 $ by eq_trans [e1, m1]
g2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr e2) w x2 = dt x0 M (enc_expr r2) w (scat x1 x2) $ by eq_sym [e2]
g3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) = dt x0 M (enc_expr r2) w (scat x1 x2) $ by eq_trans [g1, g2]
g4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr e) w x2 = dt x0 M (enc_expr r) w (scat x1 x2) $ by eq_sym [e1]
g5: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) ∈ dt x0 M (enc_expr A) w x2 $ by wcel_eq_l [g4, m2]
g6: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr A) w x2 = dt x0 M (enc_expr R) w (scat x1 x2) $ by eq_sym [e3]
g7: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) ∈ dt x0 M (enc_expr R) w (scat x1 x2) $ by wcel_eq_r [g6, g5]
q1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ x0 = x0 $ by eq_refl
q2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ M = M $ by eq_refl
q3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ w = w $ by eq_refl
q4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ enc_expr r = enc_expr r $ by eq_refl
q5: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ enc_expr r2 = enc_expr r2 $ by eq_refl
q6: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ enc_expr R = enc_expr R $ by eq_refl
v1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r) w (scat x1 x2) $ by dt_eq [q1, q2, q4, q3, k4]
v2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r2) w v = dt x0 M (enc_expr r2) w (scat x1 x2) $ by dt_eq [q1, q2, q5, q3, k4]
v3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr R) w v = dt x0 M (enc_expr R) w (scat x1 x2) $ by dt_eq [q1, q2, q6, q3, k4]
w1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r2) w (scat x1 x2) $ by eq_trans [v1, g3]
w2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r2) w (scat x1 x2) = dt x0 M (enc_expr r2) w v $ by eq_sym [v2]
w3: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r2) w v $ by eq_trans [w1, w2]
w4: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w (scat x1 x2) = dt x0 M (enc_expr r) w v $ by eq_sym [v1]
w5: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w v ∈ dt x0 M (enc_expr R) w (scat x1 x2) $ by wcel_eq_l [w4, g7]
w6: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr R) w (scat x1 x2) = dt x0 M (enc_expr R) w v $ by eq_sym [v3]
w7: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w v ∈ dt x0 M (enc_expr R) w v $ by wcel_eq_r [w6, w5]
w8: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2 ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r2) w v ∧ dt x0 M (enc_expr r) w v ∈ dt x0 M (enc_expr R) w v $ by and_intro [w3, w7]
x1a: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , ∃ x2 (x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2) ⇒ ∃ x2 (x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2) $ by ax
x1b: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w , ∃ x2 (x1 ∊ fseq x0 ∧ cdm x1 = fv nvf (enc_nat n) ∧ x2 ∊ sat x0 M (enc_ctx G) w ∧ v = scat x1 x2) ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r2) w v ∧ dt x0 M (enc_expr r) w v ∈ dt x0 M (enc_expr R) w v $ by ex_elim [x1a, w8]
x1c: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r2) w v ∧ dt x0 M (enc_expr r) w v ∈ dt x0 M (enc_expr R) w v $ by ex_elim [a4, x1b]
f1: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ dt x0 M (enc_expr r) w v = dt x0 M (enc_expr r2) w v $ by and_elim_l [x1c]
f2: $ uadm x0 , w ∊ lvals , v ∊ sat x0 M (enc_ctx G2) w ⇒ dt x0 M (enc_expr r) w v ∈ dt x0 M (enc_expr R) w v $ by and_elim_r [x1c]
f3: $ mdeq M G2 r r2 R $ by mdeq_i [f1, f2]

--| An implication out of an existential.
lemma g3_exi {x: set} (G: hyps) (p: fml x) (c: fml): $ G ⇒ ∀ x (p → c) $ > $ G ⇒ (∃ x p) → c $
----
l1: $ G , ∃ x p ⇒ ∃ x p $ by ax
l2: $ G , p ⇒ ∀ x (p → c) $ by weaken [#1]
l3: $ G , p ⇒ p → c $ by all_elim [l2]
l4: $ G , p ⇒ p $ by ax
l5: $ G , p ⇒ c $ by imp_elim [l3, l4]
l6: $ G , ∃ x p ⇒ c $ by ex_elim [l1, l5]
l7: $ G ⇒ (∃ x p) → c $ by imp_intro [l6]

--| An implication out of a disjunction.
lemma g3_ori (G: hyps) (p q c: fml): $ G ⇒ p → c $ > $ G ⇒ q → c $ > $ G ⇒ (p ∨ q) → c $
----
a1: $ G , p ⇒ c $ by imp_use [#1]
a2: $ G , q ⇒ c $ by imp_use [#2]
b1: $ G , p ∨ q ⇒ p ∨ q $ by ax
b2: $ G , p ∨ q , p ⇒ c $ by weaken [a1]
b3: $ G , p ∨ q , q ⇒ c $ by weaken [a2]
b4: $ G , p ∨ q ⇒ c $ by or_elim [b1, b2, b3]
b5: $ G ⇒ (p ∨ q) → c $ by imp_intro [b4]

--| An expression node off the valuations has the value `∅`.
lemma g3_out (G: hyps) (M W R K S: class) (u t: set): $ G ⇒ t ∊ trees ω $ > $ G ⇒ t = ⟨ K , S ⟩ $ > $ G ⇒ K ∈ kstr $ > $ G ⇒ isset S $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t W R = ∅ $
----
l1: $ G ⇒ isset K $ by wcel_isset [#3]
l2y1: $ G ⇒ ⟨ K , S ⟩ ∈ trees ω $ by wcel_intro [#2, #1]
l2y2: $ G ⇒ isset ω $ by omega_set
l2y3: $ G ⇒ K ∈ ω ∧ S ∈ fseq (trees ω) $ by trees_node_c [l2y2, l2y1, l1, #4]
l2: $ G ⇒ S ∈ fseq (trees ω) $ by and_elim_r [l2y3]
l3: $ G ⇒ dt u M ⟨ K , S ⟩ W R = ∅ $ by dt_out [#3, l2, #5]
l4: $ G ⇒ u = u $ by eq_refl
l5: $ G ⇒ M = M $ by eq_refl
l6: $ G ⇒ W = W $ by eq_refl
l7: $ G ⇒ R = R $ by eq_refl
l8: $ G ⇒ dt u M t W R = dt u M ⟨ K , S ⟩ W R $ by dt_eq [l4, l5, #2, l6, l7]
l9: $ G ⇒ dt u M t W R = ∅ $ by eq_trans [l8, l3]

--| Two expression nodes have the same value at `r` if they have at the
--| valuations `r ∊ fseq u` (off them both are `∅`).
lemma g3_split (H: hyps) (M K K2 S S2: class) (u w r z t: set): $ H ⇒ z ∊ trees ω $ > $ H ⇒ z = ⟨ K , S ⟩ $ > $ H ⇒ K ∈ kstr $ > $ H ⇒ isset S $ > $ H ⇒ t ∊ trees ω $ > $ H ⇒ t = ⟨ K2 , S2 ⟩ $ > $ H ⇒ K2 ∈ kstr $ > $ H ⇒ isset S2 $ > $ H , r ∊ fseq u ⇒ dt u M z w r = dt u M t w r $ > $ H ⇒ dt u M z w r = dt u M t w r $
----
l1: $ H ⇒ r ∊ fseq u ∨ ¬ r ∊ fseq u $ by excluded_middle
n1: $ H , ¬ r ∊ fseq u , r ∈ fseq u ⇒ r ∈ fseq u $ by ax
n2: $ H , ¬ r ∊ fseq u , r ∈ fseq u ⇒ r ∊ fseq u $ by wcel_welc [n1]
n3: $ H , ¬ r ∊ fseq u , r ∈ fseq u ⇒ ¬ r ∊ fseq u $ by ax
n4: $ H , ¬ r ∊ fseq u , r ∈ fseq u ⇒ ⊥ $ by not_elim [n3, n2]
n5: $ H , ¬ r ∊ fseq u ⇒ ¬ r ∈ fseq u $ by not_intro [n4]
w1: $ H , ¬ r ∊ fseq u ⇒ z ∊ trees ω $ by weaken [#1]
w2: $ H , ¬ r ∊ fseq u ⇒ z = ⟨ K , S ⟩ $ by weaken [#2]
w3: $ H , ¬ r ∊ fseq u ⇒ K ∈ kstr $ by weaken [#3]
w4: $ H , ¬ r ∊ fseq u ⇒ isset S $ by weaken [#4]
w5: $ H , ¬ r ∊ fseq u ⇒ t ∊ trees ω $ by weaken [#5]
w6: $ H , ¬ r ∊ fseq u ⇒ t = ⟨ K2 , S2 ⟩ $ by weaken [#6]
w7: $ H , ¬ r ∊ fseq u ⇒ K2 ∈ kstr $ by weaken [#7]
w8: $ H , ¬ r ∊ fseq u ⇒ isset S2 $ by weaken [#8]
n6: $ H , ¬ r ∊ fseq u ⇒ dt u M z w r = ∅ $ by g3_out [w1, w2, w3, w4, n5]
n7: $ H , ¬ r ∊ fseq u ⇒ dt u M t w r = ∅ $ by g3_out [w5, w6, w7, w8, n5]
n8: $ H , ¬ r ∊ fseq u ⇒ ∅ = dt u M t w r $ by eq_sym [n7]
n9: $ H , ¬ r ∊ fseq u ⇒ dt u M z w r = dt u M t w r $ by eq_trans [n6, n8]
l2: $ H ⇒ dt u M z w r = dt u M t w r $ by or_elim [l1, #9, n9]

--| The arguments of a derivable `eeqv` atom are trees.
lemma g3_atoms (G: hyps) (a b: set): $ G ⇒ ra_eeqv a b ∈ lrel2 $ > $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $
----
l1: $ G ⇒ hprog lprog2 latoms $ by lprog2_hprog
l2: $ G ⇒ lrel2 ⊆ latoms $ by horn_sub [l1]
l3: $ G ⇒ ra_eeqv a b ∈ latoms $ by wcel_subset [l2, #1]
l4: $ G ⇒ isset ω $ by omega_set
l5: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l4]
l6: $ G ⇒ ⟨ kr_eeqv , scons a (scons b ∅) ⟩ ∈ trees ω $ by wcel_eq_r [l5, l3]
l7: $ G ⇒ kr_eeqv ∈ ω $ by kr_eeqv_omega
l8: $ G ⇒ isset kr_eeqv $ by wcel_isset [l7]
l9: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω $ by trees_kids2 [l4, l6, l8]

--| `lveq` at a level valuation.
lemma g3_lveq (G: hyps) (a b w: set): $ G ⇒ lveq a b $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ lv a w = lv b w $
----
l1: $ G ⇒ w ∊ lvals → lv a w = lv b w $ by all_elim [#1]
l2: $ G ⇒ lv a w = lv b w $ by imp_elim [l1, #2]

lemma g3_rw (G: hyps) (M X Y R: class) (u w z t: set): $ G ⇒ z = X $ > $ G ⇒ t = Y $ > $ G ⇒ dt u M X w R = dt u M Y w R $ > $ G ⇒ dt u M z w R = dt u M t w R $
----
l1: $ G ⇒ u = u $ by eq_refl
l2: $ G ⇒ M = M $ by eq_refl
l3: $ G ⇒ w = w $ by eq_refl
l4: $ G ⇒ R = R $ by eq_refl
l5: $ G ⇒ dt u M z w R = dt u M X w R $ by dt_eq [l1, l2, #1, l3, l4]
l6: $ G ⇒ dt u M t w R = dt u M Y w R $ by dt_eq [l1, l2, #2, l3, l4]
l7: $ G ⇒ dt u M Y w R = dt u M t w R $ by eq_sym [l6]
l8: $ G ⇒ dt u M z w R = dt u M Y w R $ by eq_trans [l5, #3]
l9: $ G ⇒ dt u M z w R = dt u M t w R $ by eq_trans [l8, l7]

lemma g3_crn (G: hyps) (X K S: class) (z k s: set): $ G ⇒ crn s ⊆ X $ > $ G ⇒ z = ⟨ k , s ⟩ $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ > $ G ⇒ crn S ⊆ X $
----
l1: $ G ⇒ ⟨ k , s ⟩ = z $ by eq_sym [#2]
l2: $ G ⇒ ⟨ k , s ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #3]
l3: $ G ⇒ isset k $ by isset_var
l4: $ G ⇒ isset s $ by isset_var
l5: $ G ⇒ k = K ∧ s = S $ by opair_inj_c [l2, l3, l4, #4, #5]
l6: $ G ⇒ s = S $ by and_elim_r [l5]
l7: $ G ⇒ crn s = crn S $ by crn_eq [l6]
l8: $ G ⇒ crn S ⊆ X $ by subset_eq_l [l7, #1]

lemma g3_ztree (G: hyps) (k j z: set): $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ trees ω $
----
l1: $ G ⇒ ⟨ k , j ⟩ ∈ ω × fseq (trees ω) $ by cxp_intro [#1, #2]
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l2]
l4: $ G ⇒ ⟨ k , j ⟩ ∈ trees ω $ by wcel_eq_r [l3, l1]
l5: $ G ⇒ ⟨ k , j ⟩ = z $ by eq_sym [#3]
l6: $ G ⇒ z ∈ trees ω $ by wcel_eq_l [l5, l4]
l7: $ G ⇒ z ∊ trees ω $ by wcel_welc [l6]

--| The trees whose value is the value of every tree they are `eeqv` to, at
--| every valuation.
def g3_P (U M W: class) (.y .t .r: set): class = $ {y | ∀ t ∀ r (⟨ kr_eeqv , scons y (scons t ∅) ⟩ ∈ lrel2 → dt U M y W r = dt U M t W r)} $

lemma g3_P_e (G: hyps) (M R: class) (u w x c: set): $ G ⇒ x ∊ g3_P u M w $ > $ G ⇒ ra_eeqv x c ∈ lrel2 $ > $ G ⇒ isset R $ > $ G ⇒ dt u M x w R = dt u M c w R $
----
l1: $ G ⇒ ∀ t ∀ r (⟨ kr_eeqv , scons x (scons t ∅) ⟩ ∈ lrel2 → dt u M x w r = dt u M t w r) $ by cab_elim [#1]
l2: $ G ⇒ ∀ r (⟨ kr_eeqv , scons x (scons c ∅) ⟩ ∈ lrel2 → dt u M x w r = dt u M c w r) $ by all_elim (t := $ c $) [l1]
l3: $ G , v = R ⇒ ∀ r (⟨ kr_eeqv , scons x (scons c ∅) ⟩ ∈ lrel2 → dt u M x w r = dt u M c w r) $ by weaken [l2]
l4: $ G , v = R ⇒ ⟨ kr_eeqv , scons x (scons c ∅) ⟩ ∈ lrel2 → dt u M x w v = dt u M c w v $ by all_elim (t := $ v $) [l3]
l5: $ G , v = R ⇒ ra_eeqv x c ∈ lrel2 $ by weaken [#2]
l6: $ G , v = R ⇒ dt u M x w v = dt u M c w v $ by imp_elim [l4, l5]
l7: $ G , v = R ⇒ u = u $ by eq_refl
l8: $ G , v = R ⇒ M = M $ by eq_refl
l9: $ G , v = R ⇒ x = x $ by eq_refl
l10: $ G , v = R ⇒ c = c $ by eq_refl
l11: $ G , v = R ⇒ w = w $ by eq_refl
l12: $ G , v = R ⇒ v = R $ by ax
l13: $ G , v = R ⇒ R = v $ by eq_sym [l12]
l14: $ G , v = R ⇒ dt u M x w R = dt u M x w v $ by dt_eq [l7, l8, l9, l11, l13]
l15: $ G , v = R ⇒ dt u M c w v = dt u M c w R $ by dt_eq [l7, l8, l10, l11, l12]
l16: $ G , v = R ⇒ dt u M x w R = dt u M c w v $ by eq_trans [l14, l6]
l17: $ G , v = R ⇒ dt u M x w R = dt u M c w R $ by eq_trans [l16, l15]
l18: $ G ⇒ dt u M x w R = dt u M c w R $ by isset_elim [#3, l17]

lemma g3_P_i {t r: set} (G: hyps) (M: class) (u w x: set): $ G , ra_eeqv x t ∈ lrel2 ⇒ dt u M x w r = dt u M t w r $ > $ G ⇒ x ∊ g3_P u M w $
----
l1: $ G ⇒ ⟨ kr_eeqv , scons x (scons t ∅) ⟩ ∈ lrel2 → dt u M x w r = dt u M t w r $ by imp_intro [#1]
l2: $ G ⇒ ∀ r (⟨ kr_eeqv , scons x (scons t ∅) ⟩ ∈ lrel2 → dt u M x w r = dt u M t w r) $ by all_intro [l1]
l3: $ G ⇒ ∀ t ∀ r (⟨ kr_eeqv , scons x (scons t ∅) ⟩ ∈ lrel2 → dt u M x w r = dt u M t w r) $ by all_intro [l2]
l4: $ G ⇒ x ∊ g3_P u M w $ by cab_intro [l3]

--| The invariance of the hook at a node of `kexa`.
lemma g3_minv_e (H: hyps) (M K S: class) (a b c d e: set): $ H ⇒ minv M $ > $ H ⇒ uadm a $ > $ H ⇒ d = ⟨ K , S ⟩ $ > $ H ⇒ K ∈ kexa $ > $ H ⇒ isset S $ > $ H ⇒ ra_eeqv d e ∈ lrel2 $ > $ H ⇒ b ∊ lvals $ > $ H ⇒ c ∊ fseq a $ > $ H ⇒ dt a M d b c = dt a M e b c $
----
l1: $ H ⇒ ∀ k ∀ q ∀ t ∀ w ∀ r (uadm a → k ∈ kexa → ⟨ kr_eeqv , scons ⟨ k , q ⟩ (scons t ∅) ⟩ ∈ lrel2 → w ∊ lvals → r ∊ fseq a → dt a M ⟨ k , q ⟩ w r = dt a M t w r) $ by all_elim (t := $ a $) [#1]
l1a: $ H , x = K , y = S ⇒ ∀ k ∀ q ∀ t ∀ w ∀ r (uadm a → k ∈ kexa → ⟨ kr_eeqv , scons ⟨ k , q ⟩ (scons t ∅) ⟩ ∈ lrel2 → w ∊ lvals → r ∊ fseq a → dt a M ⟨ k , q ⟩ w r = dt a M t w r) $ by weaken [l1]
l2: $ H , x = K , y = S ⇒ ∀ q ∀ t ∀ w ∀ r (uadm a → x ∈ kexa → ⟨ kr_eeqv , scons ⟨ x , q ⟩ (scons t ∅) ⟩ ∈ lrel2 → w ∊ lvals → r ∊ fseq a → dt a M ⟨ x , q ⟩ w r = dt a M t w r) $ by all_elim (t := $ x $) [l1a]
l3: $ H , x = K , y = S ⇒ ∀ t ∀ w ∀ r (uadm a → x ∈ kexa → ⟨ kr_eeqv , scons ⟨ x , y ⟩ (scons t ∅) ⟩ ∈ lrel2 → w ∊ lvals → r ∊ fseq a → dt a M ⟨ x , y ⟩ w r = dt a M t w r) $ by all_elim (t := $ y $) [l2]
l4: $ H , x = K , y = S ⇒ ∀ w ∀ r (uadm a → x ∈ kexa → ra_eeqv ⟨ x , y ⟩ e ∈ lrel2 → w ∊ lvals → r ∊ fseq a → dt a M ⟨ x , y ⟩ w r = dt a M e w r) $ by all_elim (t := $ e $) [l3]
l5: $ H , x = K , y = S ⇒ ∀ r (uadm a → x ∈ kexa → ra_eeqv ⟨ x , y ⟩ e ∈ lrel2 → b ∊ lvals → r ∊ fseq a → dt a M ⟨ x , y ⟩ b r = dt a M e b r) $ by all_elim (t := $ b $) [l4]
l6: $ H , x = K , y = S ⇒ uadm a → x ∈ kexa → ra_eeqv ⟨ x , y ⟩ e ∈ lrel2 → b ∊ lvals → c ∊ fseq a → dt a M ⟨ x , y ⟩ b c = dt a M e b c $ by all_elim (t := $ c $) [l5]
h1: $ H , x = K , y = S ⇒ uadm a $ by weaken [#2]
h2: $ H , x = K , y = S ⇒ K ∈ kexa $ by weaken [#4]
h3: $ H , x = K , y = S ⇒ x = K $ by ax
h4: $ H , x = K , y = S ⇒ K = x $ by eq_sym [h3]
h5: $ H , x = K , y = S ⇒ x ∈ kexa $ by wcel_eq_l [h4, h2]
h6: $ H , x = K , y = S ⇒ y = S $ by ax
h7: $ H , x = K , y = S ⇒ S = y $ by eq_sym [h6]
h8: $ H , x = K , y = S ⇒ d = ⟨ K , S ⟩ $ by weaken [#3]
h9: $ H , x = K , y = S ⇒ ⟨ K , S ⟩ = ⟨ x , y ⟩ $ by opair_eq [h4, h7]
h10: $ H , x = K , y = S ⇒ d = ⟨ x , y ⟩ $ by eq_trans [h8, h9]
h11: $ H , x = K , y = S ⇒ e = e $ by eq_refl
h12: $ H , x = K , y = S ⇒ ra_eeqv d e = ra_eeqv ⟨ x , y ⟩ e $ by ra_eeqv_eq [h10, h11]
h13: $ H , x = K , y = S ⇒ ra_eeqv d e ∈ lrel2 $ by weaken [#6]
h14: $ H , x = K , y = S ⇒ ra_eeqv ⟨ x , y ⟩ e ∈ lrel2 $ by wcel_eq_l [h12, h13]
h15: $ H , x = K , y = S ⇒ b ∊ lvals $ by weaken [#7]
h16: $ H , x = K , y = S ⇒ c ∊ fseq a $ by weaken [#8]
m1: $ H , x = K , y = S ⇒ x ∈ kexa → ra_eeqv ⟨ x , y ⟩ e ∈ lrel2 → b ∊ lvals → c ∊ fseq a → dt a M ⟨ x , y ⟩ b c = dt a M e b c $ by imp_elim [l6, h1]
m2: $ H , x = K , y = S ⇒ ra_eeqv ⟨ x , y ⟩ e ∈ lrel2 → b ∊ lvals → c ∊ fseq a → dt a M ⟨ x , y ⟩ b c = dt a M e b c $ by imp_elim [m1, h5]
m3: $ H , x = K , y = S ⇒ b ∊ lvals → c ∊ fseq a → dt a M ⟨ x , y ⟩ b c = dt a M e b c $ by imp_elim [m2, h14]
m4: $ H , x = K , y = S ⇒ c ∊ fseq a → dt a M ⟨ x , y ⟩ b c = dt a M e b c $ by imp_elim [m3, h15]
m5: $ H , x = K , y = S ⇒ dt a M ⟨ x , y ⟩ b c = dt a M e b c $ by imp_elim [m4, h16]
m7: $ H , x = K , y = S ⇒ dt a M d b c = dt a M e b c $ by g3_rw [h10, h11, m5]
k1: $ H ⇒ isset K $ by wcel_isset [#4]
k2: $ H , x = K ⇒ dt a M d b c = dt a M e b c $ by isset_elim [#5, m7]
k3: $ H ⇒ dt a M d b c = dt a M e b c $ by isset_elim [k1, k2]

--| The cases of `lrel2_eeqv_cases`, one lemma each: the two trees have the
--| same value at `r` when the children are in the induction's class.
lemma g3_k_refl (H: hyps) (M: class) (u w r z k j t e: set): $ H ⇒ minv M $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ g3_P u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = e ∧ t = e → dt u M z w r = dt u M t w r $
----
c0: $ H , z = e ∧ t = e ⇒ z = e ∧ t = e $ by ax
e0: $ H , z = e ∧ t = e ⇒ z = e $ by and_elim_l [c0]
r0: $ H , z = e ∧ t = e ⇒ t = e $ by and_elim_r [c0]
s1: $ H , z = e ∧ t = e ⇒ e = t $ by eq_sym [r0]
s2: $ H , z = e ∧ t = e ⇒ z = t $ by eq_trans [e0, s1]
q1: $ H , z = e ∧ t = e ⇒ u = u $ by eq_refl
q2: $ H , z = e ∧ t = e ⇒ M = M $ by eq_refl
q3: $ H , z = e ∧ t = e ⇒ w = w $ by eq_refl
q4: $ H , z = e ∧ t = e ⇒ r = r $ by eq_refl
s3: $ H , z = e ∧ t = e ⇒ dt u M z w r = dt u M t w r $ by dt_eq [q1, q2, s2, q3, q4]
fin: $ H ⇒ z = e ∧ t = e → dt u M z w r = dt u M t w r $ by imp_intro [s3]

lemma g3_k_bvar (H: hyps) (M: class) (u w r z k j t i: set): $ H ⇒ minv M $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ g3_P u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ → dt u M z w r = dt u M t w r $
----
c0: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ $ by ax
e0: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ $ by and_elim_l [c0]
r0: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ t = ⟨ kc_bvar , scons i ∅ ⟩ $ by and_elim_r [c0]
s1: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ ⟨ kc_bvar , scons i ∅ ⟩ = t $ by eq_sym [r0]
s2: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ z = t $ by eq_trans [e0, s1]
q1: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ u = u $ by eq_refl
q2: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ M = M $ by eq_refl
q3: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ w = w $ by eq_refl
q4: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ r = r $ by eq_refl
s3: $ H , z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ ⇒ dt u M z w r = dt u M t w r $ by dt_eq [q1, q2, s2, q3, q4]
fin: $ H ⇒ z = ⟨ kc_bvar , scons i ∅ ⟩ ∧ t = ⟨ kc_bvar , scons i ∅ ⟩ → dt u M z w r = dt u M t w r $ by imp_intro [s3]

lemma g3_k_srt (H: hyps) (M: class) (u w r z k j t l m: set): $ H ⇒ minv M $ > $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ crn j ⊆ g3_P u M w $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ z ∊ trees ω $ > $ H ⇒ ra_eeqv z t ∈ lrel2 $ > $ H ⇒ z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m → dt u M z w r = dt u M t w r $
----
c0: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m $ by ax
e0: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ z = ⟨ kc_srt , scons l ∅ ⟩ $ by and_elim_l [c0]
r0: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m $ by and_elim_r [c0]
e1: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ t = ⟨ kc_srt , scons m ∅ ⟩ $ by and_elim_l [r0]
r1: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ lveq l m $ by and_elim_r [r0]
p1: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ minv M $ by weaken [#1]
p2: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ uadm u $ by weaken [#2]
p3: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ w ∊ lvals $ by weaken [#3]
p4: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ crn j ⊆ g3_P u M w $ by weaken [#4]
p5: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ z = ⟨ k , j ⟩ $ by weaken [#5]
p6: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ z ∊ trees ω $ by weaken [#6]
p7: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ ra_eeqv z t ∈ lrel2 $ by weaken [#7]
kz: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ kc_srt ∈ kstr $ by kstr_srt
ize: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ isset ∅ $ by ax_empty
iz0: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ isset (scons l ∅) $ by scons_set [ize]
ite: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ isset ∅ $ by ax_empty
it0: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ isset (scons m ∅) $ by scons_set [ite]
ta: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ z ∊ trees ω ∧ t ∊ trees ω $ by g3_atoms [p7]
tt: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m ⇒ t ∊ trees ω $ by and_elim_r [ta]
b1: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m , r ∊ fseq u ⇒ z = ⟨ kc_srt , scons l ∅ ⟩ $ by weaken [e0]
b1t: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m , r ∊ fseq u ⇒ t = ⟨ kc_srt , scons m ∅ ⟩ $ by weaken [e1]
b2: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m , r ∊ fseq u ⇒ z ∊ trees ω $ by weaken [p6]
b2t: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m , r ∊ fseq u ⇒ t ∊ trees ω $ by weaken [tt]
b8: $ H , z = ⟨ kc_srt , scons l ∅ ⟩ ∧ t = ⟨ kc_srt , scons m ∅ ⟩ ∧ lveq l m , r ∊ fseq u ⇒ w ∊ lvals $ by weaken [p3]
