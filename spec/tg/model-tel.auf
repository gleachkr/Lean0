c4: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∊ fseq u $ by subset_elim [c4a, c4b]
c5: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ isset z $ by isset_var
c6: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest (scons x q) z = nest q ⟨ x , z ⟩ $ by nest_scons [c4, c5]
c7: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ v = nest g e $ by ax
c8: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest g e = v $ by eq_sym [c7]
c9: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ v = nest p z $ by weaken [b5]
c10: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest g e = nest p z $ by eq_trans [c8, c9]
c11: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest g e = nest (scons x q) z $ by eq_trans [c10, c3]
c12: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest g e = nest q ⟨ x , z ⟩ $ by eq_trans [c11, c6]
d1: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ g ∈ fseq u $ by weaken [g3]
d2: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∈ fseq u $ by welc_wcel [c4]
d3a: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ P ∈ trees ω $ by weaken [#2]
d3b: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ g ∊ esat u E P w $ by weaken [#5]
d3: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ cdm g = cdm q $ by esat_len [d3a, d3b, c4b]
d4: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ isset e $ by isset_var
