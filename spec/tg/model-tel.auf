d1: $ G , x0 = X ⇒ apn F (scons X S) = ap (apn F S) X $ by wcel_elim [wd1_13, c10]
d2: $ G ⇒ apn F (scons X S) = ap (apn F S) X $ by isset_elim [#1, d1]

--| The trees `x` such that for every derivable `pargs H d n x`, the paths of
--| `x` are one, with the window of `n` entries from `d` before the arguments
--| `A` of `H`'s one path, and the value of `x` is `H`'s applied to the window.
def i6_pap (U M H A W R: class) (.x .d .n: set): class = $ {x | ∀ d ∀ n (ra_pargs H d n x ∈ lrel → etel U (dnf U M) x W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin R (fv nvf d) (fv nvf n)) A ⟩ ⟩ ⟩ ∧ dt U M x W R = apn (dt U M H W R) (swin R (fv nvf d) (fv nvf n)))} $

lemma i6_pap_e (G: hyps) (M A: class) (u w r h x d n: set): $ G ⇒ x ∈ i6_pap u M h A w r $ > $ G ⇒ ra_pargs h d n x ∈ lrel $ > $ G ⇒ etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf d) (fv nvf n)) A ⟩ ⟩ ⟩ ∧ dt u M x w r = apn (dt u M h w r) (swin r (fv nvf d) (fv nvf n)) $
----
l0: $ G ⇒ x ∊ i6_pap u M h A w r $ by wcel_welc [#1]
l1: $ G ⇒ ∀ x2 ∀ x3 (ra_pargs h x2 x3 x ∈ lrel → etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf x2) (fv nvf x3)) A ⟩ ⟩ ⟩ ∧ dt u M x w r = apn (dt u M h w r) (swin r (fv nvf x2) (fv nvf x3))) $ by cab_elim [l0]
l2: $ G ⇒ ∀ x3 (ra_pargs h d x3 x ∈ lrel → etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf d) (fv nvf x3)) A ⟩ ⟩ ⟩ ∧ dt u M x w r = apn (dt u M h w r) (swin r (fv nvf d) (fv nvf x3))) $ by all_elim [l1]
l3: $ G ⇒ ra_pargs h d n x ∈ lrel → etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf d) (fv nvf n)) A ⟩ ⟩ ⟩ ∧ dt u M x w r = apn (dt u M h w r) (swin r (fv nvf d) (fv nvf n)) $ by all_elim [l2]
l4: $ G ⇒ etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf d) (fv nvf n)) A ⟩ ⟩ ⟩ ∧ dt u M x w r = apn (dt u M h w r) (swin r (fv nvf d) (fv nvf n)) $ by imp_elim [l3, #2]

lemma i6_pap_ec (G: hyps) (M A D: class) (u w r h x n: set): $ G ⇒ isset D $ > $ G ⇒ x ∈ i6_pap u M h A w r $ > $ G ⇒ ra_pargs h D n x ∈ lrel $ > $ G ⇒ etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf D) (fv nvf n)) A ⟩ ⟩ ⟩ ∧ dt u M x w r = apn (dt u M h w r) (swin r (fv nvf D) (fv nvf n)) $
----
