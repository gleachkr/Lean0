m1: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ b ∊ apn f (scons a g) $ by ax
m2: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ b ∈ apn f (scons a g) $ by welc_wcel [m1]
m3: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ isset b $ by isset_var
m4: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ b ∈ apn f (scons a g) ↔ nest (scons a g) b ∈ f $ by apn_wcel [m3]
m5: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ nest (scons a g) b ∈ f $ by bi_elim_l [m4, m2]
m6a: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ g ∊ fseq u $ by weaken [g2]
m6: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ nest (scons a g) b = nest g ⟨ a , b ⟩ $ by nest_scons [m6a, m3]
m7a: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ e = ⟨ a , b ⟩ $ by ax
m7b: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ ⟨ a , b ⟩ = e $ by eq_sym [m7a]
m7c: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ g = g $ by eq_refl
m7: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ nest g ⟨ a , b ⟩ = nest g e $ by nest_eq [m7c, m7b]
m8: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ nest (scons a g) b = nest g e $ by eq_trans [m6, m7]
m9: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ nest g e ∈ f $ by wcel_eq_l [m8, m5]
m10a: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ isset e $ by isset_var
m10: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ e ∈ apn f g ↔ nest g e ∈ f $ by apn_wcel [m10a]
m11: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ e ∈ apn f g $ by bi_elim_r [m10, m9]
m12: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) , e = ⟨ a , b ⟩ , a ∊ da (fv E A) w g , b ∊ apn f (scons a g) ⇒ e ∊ apn f g $ by wcel_welc [m11]
m13: $ G , e ∊ clam y (da (fv E A) w g) (apn f (scons y g)) ⇒ e ∊ apn f g $ by clam_elim_mem [m0, m12]
n1: $ G ⇒ apn f g = clam y (da (fv E A) w g) (apn f (scons y g)) $ by eq_intro [i4, m13]

lemma i5_ipi_cons {y q: set} (G: hyps) (E A P B Q: class) (u w: set): $ G ⇒ universe u $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ q (q ∊ esat u E P w → da (fv E A) w q ∈ u) $ > $ G ⇒ ∀ q (q ∊ esat u E P w → da (fv E Q) w q = cpi y (da (fv E A) w q) (da (fv E B) w (scons y q))) $ > $ G ⇒ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w = ipi u E P Q w $
----
a1: $ G , x ∊ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w ⇒ x ∊ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w $ by ax
a2: $ G , x ∊ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} ∧ ∀ q (q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w → apn x q ∈ da (fv E B) w q) $ by cab_elim [a1]
a3: $ G , x ∊ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ by and_elim_l [a2]
