k1g: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_srt , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_lvl ⇒ ⟨ kc_srt , scons x5 ∅ ⟩ = z $ by eq_sym [k1b]
