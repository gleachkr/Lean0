--| i7: the sequences that are empty or end in an entry.
def i7_snp (A: class) (.c .e .f: set): class = $ {c | c = ∅ ∨ ∃ e ∃ f (e ∊ fseq A ∧ f ∊ A ∧ c = ssnoc e f)} $

--| i7: one more entry in front of a sequence ending in `f`.
lemma i7_snoc_b (G: hyps) (A: class) (x y e f: set): $ G ⇒ x ∊ A $ > $ G ⇒ e ∊ fseq A $ > $ G ⇒ f ∊ A $ > $ G ⇒ y = ssnoc e f $ > $ G ⇒ scons x y ∈ i7_snp A $
----
a1: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ x ∊ A $ by weaken [#1]
a2: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ e ∊ fseq A $ by weaken [#2]
a3: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ f ∊ A $ by weaken [#3]
a4: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ y = ssnoc e f $ by weaken [#4]
a5: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = scons x y $ by ax
b1: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n = scons x e $ by ax
b2: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ m = scons f ∅ $ by ax
b3: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scons x e ∈ fseq A $ by scons_fseq [a1, a2]
b4: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scons x e = n $ by eq_sym [b1]
b5a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n ∈ fseq A $ by wcel_eq_l [b4, b3]
b5: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n ∊ fseq A $ by wcel_welc [b5a]
b6a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ∅ ∈ fseq A $ by fseq_empty
b6b: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ f ∈ A $ by welc_wcel [a3]
b6c: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scons f ∅ ∈ fseq A $ by scons_fseq_c [b6b, b6a]
b6d: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scons f ∅ = m $ by eq_sym [b2]
b6e: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ m ∈ fseq A $ by wcel_eq_l [b6d, b6c]
b6: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ m ∊ fseq A $ by wcel_welc [b6e]
c1: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ssnoc e f = scat e (scons f ∅) $ by ssnoc_scat [a2]
c2a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ e = e $ by eq_refl
c2: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scat e (scons f ∅) = scat e m $ by scat_eq [c2a, b6d]
c3: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scat (scons x e) m = scons x (scat e m) $ by scat_scons [a2, b6]
c4: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ssnoc n f = scat n (scons f ∅) $ by ssnoc_scat [b5]
c5a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n = n $ by eq_refl
c5: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scat n (scons f ∅) = scat n m $ by scat_eq [c5a, b6d]
c5b: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ m = m $ by eq_refl
c6: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scat (scons x e) m = scat n m $ by scat_eq [b4, c5b]
d1a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ssnoc e f = scat e m $ by eq_trans [c1, c2]
d1: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ y = scat e m $ by eq_trans [a4, d1a]
d2a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ x = x $ by eq_refl
d2: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scons x y = scons x (scat e m) $ by scons_eq [d2a, d1]
d3: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = scons x (scat e m) $ by eq_trans [a5, d2]
d4: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scons x (scat e m) = scat (scons x e) m $ by eq_sym [c3]
d5: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = scat (scons x e) m $ by eq_trans [d3, d4]
d6: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = scat n m $ by eq_trans [d5, c6]
d7a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ssnoc n f = scat n m $ by eq_trans [c4, c5]
d7b: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ scat n m = ssnoc n f $ by eq_sym [d7a]
d7: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = ssnoc n f $ by eq_trans [d6, d7b]
d8a: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ f ∊ A ∧ z = ssnoc n f $ by and_intro [a3, d7]
d8: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ n ∊ fseq A ∧ f ∊ A ∧ z = ssnoc n f $ by and_intro [b5, d8a]
d9: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ∃ x8 (n ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc n x8) $ by ex_intro [d8]
d10: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by ex_intro [d9]
d11: $ G , z = scons x y , n = scons x e , m = scons f ∅ ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by or_intro_r [d10]
e1: $ G , z = scons x y , n = scons x e ⇒ isset ∅ $ by ax_empty
e2: $ G , z = scons x y , n = scons x e ⇒ isset (scons f ∅) $ by scons_set [e1]
e3: $ G , z = scons x y , n = scons x e ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by isset_elim [e2, d11]
e4: $ G , z = scons x y ⇒ isset e $ by isset_var
e5: $ G , z = scons x y ⇒ isset (scons x e) $ by scons_set [e4]
e6: $ G , z = scons x y ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by isset_elim [e5, e3]
e7: $ G ⇒ isset y $ by isset_var
e8: $ G ⇒ isset (scons x y) $ by scons_set [e7]
e9: $ G ⇒ scons x y ∈ i7_snp A $ by wcel_cab_intro [e8, e6]

lemma i7_snoc_a (G: hyps) (A: class) (x y: set): $ G ⇒ x ∊ A $ > $ G ⇒ y ∊ fseq A $ > $ G ⇒ y = ∅ $ > $ G ⇒ scons x y ∈ i7_snp A $
----
f1: $ G , z = scons x y ⇒ y = ∅ $ by weaken [#3]
f2: $ G , z = scons x y ⇒ x = x $ by eq_refl
f3: $ G , z = scons x y ⇒ ssnoc y x = ssnoc ∅ x $ by ssnoc_eq [f1, f2]
f4: $ G , z = scons x y ⇒ ssnoc ∅ x = scons x ∅ $ by ssnoc_empty
f5: $ G , z = scons x y ⇒ scons x y = scons x ∅ $ by scons_eq [f2, f1]
f6: $ G , z = scons x y ⇒ z = scons x y $ by ax
f7: $ G , z = scons x y ⇒ z = scons x ∅ $ by eq_trans [f6, f5]
f8: $ G , z = scons x y ⇒ ssnoc y x = scons x ∅ $ by eq_trans [f3, f4]
f9: $ G , z = scons x y ⇒ scons x ∅ = ssnoc y x $ by eq_sym [f8]
f10: $ G , z = scons x y ⇒ z = ssnoc y x $ by eq_trans [f7, f9]
f11: $ G , z = scons x y ⇒ y ∊ fseq A $ by weaken [#2]
f12: $ G , z = scons x y ⇒ x ∊ A $ by weaken [#1]
f13a: $ G , z = scons x y ⇒ x ∊ A ∧ z = ssnoc y x $ by and_intro [f12, f10]
f13: $ G , z = scons x y ⇒ y ∊ fseq A ∧ x ∊ A ∧ z = ssnoc y x $ by and_intro [f11, f13a]
f14: $ G , z = scons x y ⇒ ∃ x8 (y ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc y x8) $ by ex_intro [f13]
f15: $ G , z = scons x y ⇒ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by ex_intro [f14]
f16: $ G , z = scons x y ⇒ z = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ z = ssnoc x7 x8) $ by or_intro_r [f15]
f17: $ G ⇒ isset y $ by isset_var
f18: $ G ⇒ isset (scons x y) $ by scons_set [f17]
f19: $ G ⇒ scons x y ∈ i7_snp A $ by wcel_cab_intro [f18, f16]

--| A sequence is empty or ends in an entry.
lemma i7_snoc_dec (G: hyps) (A: class) (v: set): $ G ⇒ v ∊ fseq A $ > $ G ⇒ v ∊ i7_snp A $
----
a1: $ G , z = ∅ ⇒ z = ∅ $ by ax
a2: $ G , z = ∅ ⇒ z = ∅ ∨ ∃ x5 ∃ x6 (x5 ∊ fseq A ∧ x6 ∊ A ∧ z = ssnoc x5 x6) $ by or_intro_l [a1]
a3: $ G ⇒ isset ∅ $ by ax_empty
a4: $ G ⇒ ∅ ∈ i7_snp A $ by wcel_cab_intro [a3, a2]
b1: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ y ∊ i7_snp A $ by ax
b2: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ y = ∅ ∨ ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) $ by cab_elim [b1]
b3: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ x ∊ A $ by ax
b4: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ y ∊ fseq A $ by ax
f1: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , y = ∅ ⇒ x ∊ A $ by weaken [b3]
f2: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , y = ∅ ⇒ y ∊ fseq A $ by weaken [b4]
f3: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , y = ∅ ⇒ y = ∅ $ by ax
f4: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , y = ∅ ⇒ scons x y ∈ i7_snp A $ by i7_snoc_a [f1, f2, f3]
g1: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 $ by ax
gp0: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x7 ∊ fseq A $ by and_elim_l [g1]
gp0r: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x8 ∊ A ∧ y = ssnoc x7 x8 $ by and_elim_r [g1]
gp1: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x8 ∊ A $ by and_elim_l [gp0r]
gp2: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ y = ssnoc x7 x8 $ by and_elim_r [gp0r]
g2: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ x ∊ A $ by weaken [b3]
g4a: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8 ⇒ scons x y ∈ i7_snp A $ by i7_snoc_b [g2, gp0, gp1, gp2]
g4: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) → scons x y ∈ i7_snp A $ by imp_intro [g4a]
ha1: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ ∀ x8 ((x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) → scons x y ∈ i7_snp A) $ by all_intro [g4]
hb1: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ (∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8)) → scons x y ∈ i7_snp A $ by i7_exi [ha1]
ha0: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ ∀ x7 ((∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8)) → scons x y ∈ i7_snp A) $ by all_intro [hb1]
hb0: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ (∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8)) → scons x y ∈ i7_snp A $ by i7_exi [ha0]
g9a: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A , ∃ x7 ∃ x8 (x7 ∊ fseq A ∧ x8 ∊ A ∧ y = ssnoc x7 x8) ⇒ scons x y ∈ i7_snp A $ by imp_use [hb0]
g9: $ G , x ∊ A , y ∊ fseq A , y ∊ i7_snp A ⇒ scons x y ∈ i7_snp A $ by or_elim [b2, f4, g9a]
k4: $ G , x ∊ A , y ∊ fseq A ⇒ y ∊ i7_snp A → scons x y ∈ i7_snp A $ by imp_intro [g9]
k5: $ G , x ∊ A ⇒ y ∊ fseq A → y ∊ i7_snp A → scons x y ∈ i7_snp A $ by imp_intro [k4]
k6: $ G ⇒ x ∊ A → y ∊ fseq A → y ∊ i7_snp A → scons x y ∈ i7_snp A $ by imp_intro [k5]
k7: $ G ⇒ ∀ y (x ∊ A → y ∊ fseq A → y ∊ i7_snp A → scons x y ∈ i7_snp A) $ by all_intro [k6]
k8: $ G ⇒ ∀ x ∀ y (x ∊ A → y ∊ fseq A → y ∊ i7_snp A → scons x y ∈ i7_snp A) $ by all_intro [k7]
k9: $ G ⇒ fseq A ⊆ i7_snp A $ by fseq_ind [a4, k8]
k10: $ G ⇒ v ∊ i7_snp A $ by subset_elim [k9, #1]

--| i7: the hypothesis on the projections' values in `lrel_qinst_sem`, and the induction's property.
def i7_qih (U M B E W S V J Z: class) (.i .b: set): fml = $ ∀ i ∀ b (i ∊ cdm V → b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf J) (fv nvf Z) → dt U M ⟨ kc_proj , scons B (scons b (scons E ∅)) ⟩ W S = fv V i) $

def i7_qip (U M B E W S: class) (.z .j .a .r .v .i .b: set): class = $ {z | ∀ j ∀ a ∀ r ∀ v (ra_qinst B E z j a r ∈ lrel → v ∊ fseq U → cdm v = fv nvf z → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf z) → dt U M ⟨ kc_proj , scons B (scons b (scons E ∅)) ⟩ W S = fv v i) → dt U M r W S = dt U M a W (scat v S))} $

lemma i7_qih_use (G: hyps) (M: class) (u w t1 t2 s v j y i b: set): $ G ⇒ i7_qih u M t1 t2 w s v j y $ > $ G ⇒ i ∊ cdm v $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) $ > $ G ⇒ dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $
----
l1: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ cdm v → x1 ∊ trees ω → nadd (fv nvf x1) (suc x0) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons x1 (scons t2 ∅)) ⟩ w s = fv v x0) $ by i7_id [#1]
l2: $ G ⇒ ∀ x1 (i ∊ cdm v → x1 ∊ trees ω → nadd (fv nvf x1) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons x1 (scons t2 ∅)) ⟩ w s = fv v i) $ by all_elim [l1]
l3: $ G ⇒ i ∊ cdm v → b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by all_elim [l2]
l4: $ G ⇒ b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by imp_elim [l3, #2]
l5: $ G ⇒ nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by imp_elim [l4, #3]
l6: $ G ⇒ dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by imp_elim [l5, #4]

lemma i7_qih_intro {i b: set} (G: hyps) (M: class) (u w t1 t2 s v j y: set): $ G , i ∊ cdm v , b ∊ trees ω , nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) ⇒ dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ > $ G ⇒ i7_qih u M t1 t2 w s v j y $
----
l1: $ G , i ∊ cdm v , b ∊ trees ω ⇒ nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by imp_intro [#1]
l2: $ G , i ∊ cdm v ⇒ b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by imp_intro [l1]
l3: $ G ⇒ i ∊ cdm v → b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i $ by imp_intro [l2]
l4: $ G ⇒ ∀ b (i ∊ cdm v → b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i) $ by all_intro [l3]
l5: $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → nadd (fv nvf b) (suc i) = nadd (fv nvf j) (fv nvf y) → dt u M ⟨ kc_proj , scons t1 (scons b (scons t2 ∅)) ⟩ w s = fv v i) $ by all_intro [l4]
l6: $ G ⇒ i7_qih u M t1 t2 w s v j y $ by i7_id [l5]

lemma i7_qi_c1 (G: hyps) (M: class) (u w t1 t2 s y j a r v x0 x1 x2 x3: set): $ G ⇒ s ∊ fseq u $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ cdm v = fv nvf y $ > $ G ⇒ (t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2) → dt u M r w s = dt u M a w (scat v s) $
----
a0: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 $ by ax
p0: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ t1 = x0 $ by and_elim_l [a0]
p0r: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 $ by and_elim_r [a0]
p1: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ t2 = x1 $ by and_elim_l [p0r]
p1r: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 $ by and_elim_r [p0r]
p2: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ y = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [p1r]
p2r: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ j = x3 ∧ a = x2 ∧ r = x2 $ by and_elim_r [p1r]
p3: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ j = x3 $ by and_elim_l [p2r]
p3r: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ a = x2 ∧ r = x2 $ by and_elim_r [p2r]
p4: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ a = x2 $ by and_elim_l [p3r]
p5: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ r = x2 $ by and_elim_r [p3r]
b1: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ nvf = nvf $ by eq_refl
b2: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ fv nvf y = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [b1, p2]
b3: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
b4a: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ cdm v = fv nvf y $ by weaken [#3]
b4b: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ cdm v = fv nvf ⟨ kc_nz , ∅ ⟩ $ by eq_trans [b4a, b2]
b4: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ cdm v = ∅ $ by eq_trans [b4b, b3]
b5a: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ v ∊ fseq u $ by weaken [#2]
b5: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ v = ∅ $ by fseq_len_zero [b5a, b4]
b6a: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ s = s $ by eq_refl
b6: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ scat v s = scat ∅ s $ by scat_eq [b5, b6a]
b7a: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ s ∊ fseq u $ by weaken [#1]
b7: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ scat ∅ s = s $ by scat_empty_l [b7a]
b8: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ scat v s = s $ by eq_trans [b6, b7]
b9: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ s = scat v s $ by eq_sym [b8]
c1: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ x2 = a $ by eq_sym [p4]
c2: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ r = a $ by eq_trans [p5, c1]
c3a: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ u = u $ by eq_refl
c3b: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ M = M $ by eq_refl
c3c: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ w = w $ by eq_refl
c3: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2 ⇒ dt u M r w s = dt u M a w (scat v s) $ by dt_eq [c3a, c3b, c2, c3c, b9]
c4: $ G ⇒ (t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x2) → dt u M r w s = dt u M a w (scat v s) $ by imp_intro [c3]

lemma i7_qi_c2b (G: hyps) (M: class) (u w t1 t2 s y k g j a r v x0 x1 x2 x3 x4 x5 x6 x7 x8: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ v ∊ fseq u $ > $ G ⇒ cdm v = fv nvf y $ > $ G ⇒ i7_qih u M t1 t2 w s v j y $ > $ G ⇒ crn g ⊆ i7_qip u M t1 t2 w s $ > $ G ⇒ y = ⟨ k , g ⟩ $ > $ G ⇒ x7 ∊ fseq u $ > $ G ⇒ x8 ∊ u $ > $ G ⇒ v = ssnoc x7 x8 $ > $ G ⇒ (t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_s , scons x6 ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x5 ∧ ra_inst x6 x2 ⟨ kc_proj , scons x0 (scons x3 (scons x1 ∅)) ⟩ x4 ∈ lrel ∧ ra_qinst x0 x1 x6 ⟨ kc_s , scons x3 ∅ ⟩ x4 x5 ∈ lrel) → dt u M r w s = dt u M a w (scat v s) $
----
