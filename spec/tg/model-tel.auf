--| The trees `x` such that for every derivable `spine H x n`, a well-sorted
--| `x` has arguments over `U`.
def i6_spf (U M H W R: class) (.x .n: set): class = $ {x | ∀ n (ra_spine H x n ∈ lrel → x ∊ ofsort lsig lopen ks_expr → sarg U (dnf U M) x W R ∈ fseq U)} $

lemma i6_spf_e (G: hyps) (M: class) (u w r h x n: set): $ G ⇒ x ∈ i6_spf u M h w r $ > $ G ⇒ ra_spine h x n ∈ lrel $ > $ G ⇒ x ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ sarg u (dnf u M) x w r ∈ fseq u $
----
l0: $ G ⇒ x ∊ i6_spf u M h w r $ by wcel_welc [#1]
l1: $ G ⇒ ∀ x2 (ra_spine h x x2 ∈ lrel → x ∊ ofsort lsig lopen ks_expr → sarg u (dnf u M) x w r ∈ fseq u) $ by cab_elim [l0]
l2: $ G ⇒ ra_spine h x n ∈ lrel → x ∊ ofsort lsig lopen ks_expr → sarg u (dnf u M) x w r ∈ fseq u $ by all_elim [l1]
l3: $ G ⇒ x ∊ ofsort lsig lopen ks_expr → sarg u (dnf u M) x w r ∈ fseq u $ by imp_elim [l2, #2]
l4: $ G ⇒ sarg u (dnf u M) x w r ∈ fseq u $ by imp_elim [l3, #3]

lemma i6_sf_step (G: hyps) (M: class) (u w r h k j: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) h w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ > $ G ⇒ trees ω ⊆ i6_spp u M h w r $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ i6_spf u M h w r $ > $ G ⇒ ⟨ k , j ⟩ ∈ i6_spf u M h w r $
----
