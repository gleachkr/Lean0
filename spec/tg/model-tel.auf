e4c: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J ⇒ scons x5 ∅ = scons t5 ∅ $ by scons_eq [e1e, e4b]
e4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J ⇒ ⟨ kc_s , scons x5 ∅ ⟩ = ⟨ kc_s , scons t5 ∅ ⟩ $ by opair_eq [e4a, e4c]
