--| The constructor lists `y` whose constructor at `m`, for every derivable
--| `ctors_wf D N Q L K C y`, is `E` and well formed.
def i9_cq (D N Q L K C J E: class) (.y .m: set): class = $ {y | ∀ m (ra_ctors_wf D N Q L K C y ∈ lrel3 J → ra_nth_ctor y m E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J)} $

lemma i9_cq_i {m: set} (G: hyps) (J D N Q L K C E: class) (y: set): $ G , ra_ctors_wf D N Q L K C y ∈ lrel3 J , ra_nth_ctor y m E ∈ lrel ⇒ ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $ > $ G ⇒ y ∊ i9_cq D N Q L K C J E $
----
l1: $ G , ra_ctors_wf D N Q L K C y ∈ lrel3 J ⇒ ra_nth_ctor y m E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $ by imp_intro [#1]
l2: $ G ⇒ ra_ctors_wf D N Q L K C y ∈ lrel3 J → ra_nth_ctor y m E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $ by imp_intro [l1]
l3: $ G ⇒ ∀ m (ra_ctors_wf D N Q L K C y ∈ lrel3 J → ra_nth_ctor y m E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J) $ by all_intro [l2]
l4: $ G ⇒ y ∊ i9_cq D N Q L K C J E $ by cab_intro [l3]

lemma i9_cq_e (G: hyps) (J D N Q L K C E: class) (y p: set): $ G ⇒ y ∊ i9_cq D N Q L K C J E $ > $ G ⇒ ra_ctors_wf D N Q L K C y ∈ lrel3 J $ > $ G ⇒ ra_nth_ctor y p E ∈ lrel $ > $ G ⇒ ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $
----
l1: $ G ⇒ ∀ m (ra_ctors_wf D N Q L K C y ∈ lrel3 J → ra_nth_ctor y m E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J) $ by cab_elim [#1]
l2: $ G ⇒ ra_ctors_wf D N Q L K C y ∈ lrel3 J → ra_nth_ctor y p E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $ by all_elim [l1]
l3: $ G ⇒ ra_nth_ctor y p E ∈ lrel → ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $ by imp_elim [l2, #2]
l4: $ G ⇒ ra_cwf D N Q L K C ⟨ kc_nz , ∅ ⟩ E ∈ lrel3 J $ by imp_elim [l3, #3]

