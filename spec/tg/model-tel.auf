d4: $ G ⇒ (∃ x (∃ f (∃ g (∃ t (∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)))))) → (∃ x (∃ f (∃ g (∃ t (∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)))))) $ by imp_intro [d4d]
e1a: $ G , v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⇒ v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} $ by ax
e1: $ G , v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⇒ ∃ x (∃ f (∃ g (∃ t (∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩))))) $ by cab_elim [e1a]
e2a: $ G , v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⇒ (∃ x (∃ f (∃ g (∃ t (∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)))))) → (∃ x (∃ f (∃ g (∃ t (∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)))))) $ by weaken [d4]
e2: $ G , v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⇒ ∃ x (∃ f (∃ g (∃ t (∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩))))) $ by imp_elim [e2a, e1]
e3: $ G , v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⇒ v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} $ by cab_intro [e2]
e4: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} $ by subset_intro [e3]

lemma i8_pi_eq (G: hyps) {x f g t a y: set} (U E X X2 T T2: class) (w q d e: set): $ G ⇒ X = X2 $ > $ G ⇒ T = T2 $ > $ G ⇒ ∀ x (x ∊ U → etel U E q w (scons x d) = etel U E q w (scons x e)) $ > $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} $
----
l1: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} $ by i8_pi_sub [#1, #2, #3]
l2: $ G ⇒ X2 = X $ by eq_sym [#1]
l3: $ G ⇒ T2 = T $ by eq_sym [#2]
m1: $ G , x ∊ U ⇒ ∀ x (x ∊ U → etel U E q w (scons x d) = etel U E q w (scons x e)) $ by weaken [#3]
m2: $ G , x ∊ U ⇒ x ∊ U → etel U E q w (scons x d) = etel U E q w (scons x e) $ by all_elim [m1]
m3a: $ G , x ∊ U ⇒ x ∊ U $ by ax
m3: $ G , x ∊ U ⇒ etel U E q w (scons x d) = etel U E q w (scons x e) $ by imp_elim [m2, m3a]
m4: $ G , x ∊ U ⇒ etel U E q w (scons x e) = etel U E q w (scons x d) $ by eq_sym [m3]
m5: $ G ⇒ x ∊ U → etel U E q w (scons x e) = etel U E q w (scons x d) $ by imp_intro [m4]
m6: $ G ⇒ ∀ x (x ∊ U → etel U E q w (scons x e) = etel U E q w (scons x d)) $ by all_intro [m5]
l5: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} $ by i8_pi_sub [l2, l3, m6]
l6: $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} $ by subset_antisym [l1, l5]

lemma i8_app_sub (G: hyps) {a y: set} (P P2 V V2: class): $ G ⇒ P = P2 $ > $ G ⇒ V = V2 $ > $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} $
----
a1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ $ by ax
a2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P $ by and_elim_l [a1]
a3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ $ by and_elim_r [a1]
b1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ P = P2 $ by weaken [#1]
b2: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 $ by wcel_eq_r [b1, a2]
b3: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ V = V2 $ by weaken [#2]
b4: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ a = a $ by eq_refl
b5: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ scons V a = scons V2 a $ by scons_eq [b3, b4]
b6: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ∅ = ∅ $ by eq_refl
b7: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , scons V a ⟩ = ⟨ ∅ , scons V2 a ⟩ $ by opair_eq [b6, b5]
b8: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ $ by opair_eq [b6, b7]
b9: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩ $ by opair_eq [b6, b8]
b10: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩ $ by eq_trans [a3, b9]
c1: $ G , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩ ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩ $ by and_intro [b2, b10]
c2: $ G ⇒ (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩) → (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩) $ by imp_intro [c1]
d1: $ G ⇒ ∀ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩) → (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)) $ by all_intro [c2]
e1a: $ G , v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⇒ v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} $ by ax
e1: $ G , v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩) $ by cab_elim [e1a]
e2a: $ G , v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⇒ ∀ a ((⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩) → (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)) $ by weaken [d1]
e2: $ G , v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ v = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩) $ by ex_mp [e2a, e1]
e3: $ G , v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⇒ v ∊ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} $ by cab_intro [e2]
e4: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} $ by subset_intro [e3]

lemma i8_app_eq (G: hyps) {a y: set} (P P2 V V2: class): $ G ⇒ P = P2 $ > $ G ⇒ V = V2 $ > $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} $
----
l1: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} $ by i8_app_sub [#1, #2]
l2: $ G ⇒ P2 = P $ by eq_sym [#1]
l3: $ G ⇒ V2 = V $ by eq_sym [#2]
l4: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} ⊆ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} $ by i8_app_sub [l2, l3]
l5: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V a ⟩ ⟩ ⟩)} = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ P2 ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons V2 a ⟩ ⟩ ⟩)} $ by subset_antisym [l1, l4]

lemma i8_cs_pi {i: set} (G: hyps i) (M: class) (u w z c p q d e: set): $ G ⇒ z = ⟨ kc_pi , scons p (scons q ∅) ⟩ $ > $ G ⇒ p ∊ i8_ecp u M w $ > $ G ⇒ q ∊ i8_ecp u M w $ > $ G ⇒ ra_closed c p ∈ lrel $ > $ G ⇒ ra_closed ⟨ kc_s , scons c ∅ ⟩ q ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) $ > $ G ⇒ etel u (dnf u M) z w d = etel u (dnf u M) z w e $
----
k0a: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
k0: $ G ⇒ isset kr_closed $ by wcel_isset [k0a]
k1: $ G ⇒ c ∊ trees ω ∧ p ∊ trees ω $ by lrel_args2 [#4, k0]
k2a: $ G ⇒ p ∊ trees ω $ by and_elim_r [k1]
k2: $ G ⇒ p ∈ trees ω $ by welc_wcel [k2a]
k3a: $ G ⇒ c ∊ trees ω $ by and_elim_l [k1]
k3: $ G ⇒ c ∈ trees ω $ by welc_wcel [k3a]
q1: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ h = ⟨ kc_s , scons c ∅ ⟩ $ by ax
q2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ⟨ kc_s , scons c ∅ ⟩ = h $ by eq_sym [q1]
q3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ scons q ∅ = scons q ∅ $ by eq_refl
q4: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ scons ⟨ kc_s , scons c ∅ ⟩ (scons q ∅) = scons h (scons q ∅) $ by scons_eq [q2, q3]
q5: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ kr_closed = kr_closed $ by eq_refl
q6: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ⟨ kr_closed , scons ⟨ kc_s , scons c ∅ ⟩ (scons q ∅) ⟩ = ⟨ kr_closed , scons h (scons q ∅) ⟩ $ by opair_eq [q5, q4]
q7: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ra_closed ⟨ kc_s , scons c ∅ ⟩ q ∈ lrel $ by weaken [#5]
q8: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ra_closed h q ∈ lrel $ by wcel_eq_l [q6, q7]
q9: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ isset kr_closed $ by weaken [k0]
q10: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ h ∊ trees ω ∧ q ∊ trees ω $ by lrel_args2 [q8, q9]
q11: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ q ∊ trees ω $ by and_elim_r [q10]
q12: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ q ∈ trees ω $ by welc_wcel [q11]
q13: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ nvf = nvf $ by eq_refl
q14: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ fv nvf h = fv nvf ⟨ kc_s , scons c ∅ ⟩ $ by fv_eq [q13, q1]
q15a: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ c ∈ trees ω $ by weaken [k3]
q15: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ fv nvf ⟨ kc_s , scons c ∅ ⟩ = suc (fv nvf c) $ by nvf_s [q15a]
q16: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ fv nvf h = suc (fv nvf c) $ by eq_trans [q14, q15]
q17a: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ isset c $ by isset_var
q17: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ fv nvf c ∈ ω $ by nvf_omega [q17a]
w1: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ z = ⟨ kc_pi , scons p (scons q ∅) ⟩ $ by weaken [#1]
w2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ p ∊ i8_ecp u M w $ by weaken [#2]
w3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ q ∊ i8_ecp u M w $ by weaken [#3]
w4: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ra_closed c p ∈ lrel $ by weaken [#4]
w6: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ w ∊ lvals $ by weaken [#6]
w7: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ d ∊ fseq u $ by weaken [#7]
w8: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ e ∊ fseq u $ by weaken [#8]
w9: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) $ by weaken [#9]
b0: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ x ∊ u $ by ax
b0a: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ q ∊ i8_ecp u M w $ by weaken [w3]
b0b: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ ra_closed h q ∈ lrel $ by weaken [q8]
b0c: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ fv nvf h = suc (fv nvf c) $ by weaken [q16]
b0d: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ fv nvf c ∈ ω $ by weaken [q17]
b0e: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ d ∊ fseq u $ by weaken [w7]
b0f: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ e ∊ fseq u $ by weaken [w8]
b0g: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) $ by weaken [w9]
b1: $ G , h = ⟨ kc_s , scons c ∅ ⟩ , x ∊ u ⇒ etel u (dnf u M) q w (scons x d) = etel u (dnf u M) q w (scons x e) $ by i8_body [b0a, b0b, b0c, b0d, b0, b0e, b0f, b0g]
b2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ x ∊ u → etel u (dnf u M) q w (scons x d) = etel u (dnf u M) q w (scons x e) $ by imp_intro [b1]
b3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ∀ x (x ∊ u → etel u (dnf u M) q w (scons x d) = etel u (dnf u M) q w (scons x e)) $ by all_intro [b2]
j1: $ _ ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) ↔ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by all_alpha
j2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) ↔ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by weaken [j1]
j3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by bi_elim_l [j2, w9]
v1: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ da (fv (dnf u M) p) w d = da (fv (dnf u M) p) w e $ by lrel_closed_sem [w4, w6, w7, w8, j3]
v2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) p w d = etel u (dnf u M) p w e $ by i8_ecp_e [w2, w4, w7, w8, w9]
v3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w d ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w d) t , a ⟩ ⟩ ⟩)} = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w e ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w e) t , a ⟩ ⟩ ⟩)} $ by i8_pi_eq [v1, v2, b3]
v4a: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ p ∈ trees ω $ by weaken [k2]
v4: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w d = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w d ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w d) t , a ⟩ ⟩ ⟩)} $ by etel_pi [v4a, q12, w6, w7]
v5: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w e = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w e ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w e) t , a ⟩ ⟩ ⟩)} $ by etel_pi [v4a, q12, w6, w8]
r1: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ w = w $ by eq_refl
r2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ d = d $ by eq_refl
r3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ e = e $ by eq_refl
v6: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) z w d = etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w d $ by etel_eq [w1, r1, r2]
v7: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) z w e = etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w e $ by etel_eq [w1, r1, r3]
f1: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) z w d = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w d ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w d) t , a ⟩ ⟩ ⟩)} $ by eq_trans [v6, v4]
f2: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) z w d = {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w e ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w e) t , a ⟩ ⟩ ⟩)} $ by eq_trans [f1, v3]
f3: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv (dnf u M) p) w e ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) p w e) t , a ⟩ ⟩ ⟩)} = etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w e $ by eq_sym [v5]
f4: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) z w d = etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w e $ by eq_trans [f2, f3]
f5: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) ⟨ kc_pi , scons p (scons q ∅) ⟩ w e = etel u (dnf u M) z w e $ by eq_sym [v7]
f6: $ G , h = ⟨ kc_s , scons c ∅ ⟩ ⇒ etel u (dnf u M) z w d = etel u (dnf u M) z w e $ by eq_trans [f4, f5]
z0: $ G ⇒ isset ⟨ kc_s , scons c ∅ ⟩ $ by opair_isset
z1: $ G ⇒ etel u (dnf u M) z w d = etel u (dnf u M) z w e $ by isset_elim [z0, f6]

lemma i8_cs_app {i: set} (G: hyps i) (M: class) (u w z c f g d e: set): $ G ⇒ z = ⟨ kc_app , scons f (scons g ∅) ⟩ $ > $ G ⇒ f ∊ i8_ecp u M w $ > $ G ⇒ ra_closed c f ∈ lrel $ > $ G ⇒ ra_closed c g ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) $ > $ G ⇒ etel u (dnf u M) z w d = etel u (dnf u M) z w e $
----
k0a: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
k0: $ G ⇒ isset kr_closed $ by wcel_isset [k0a]
k1: $ G ⇒ c ∊ trees ω ∧ f ∊ trees ω $ by lrel_args2 [#3, k0]
k2a: $ G ⇒ f ∊ trees ω $ by and_elim_r [k1]
k2: $ G ⇒ f ∈ trees ω $ by welc_wcel [k2a]
k3: $ G ⇒ c ∊ trees ω ∧ g ∊ trees ω $ by lrel_args2 [#4, k0]
k4a: $ G ⇒ g ∊ trees ω $ by and_elim_r [k3]
k4: $ G ⇒ g ∈ trees ω $ by welc_wcel [k4a]
j1: $ _ ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) ↔ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by all_alpha
j2: $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) ↔ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by weaken [j1]
j3: $ G ⇒ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by bi_elim_l [j2, #8]
v1: $ G ⇒ da (fv (dnf u M) g) w d = da (fv (dnf u M) g) w e $ by lrel_closed_sem [#4, #5, #6, #7, j3]
v2: $ G ⇒ etel u (dnf u M) f w d = etel u (dnf u M) f w e $ by i8_ecp_e [#2, #3, #6, #7, #8]
v3: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w d ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w d) a ⟩ ⟩ ⟩)} = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w e ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w e) a ⟩ ⟩ ⟩)} $ by i8_app_eq [v2, v1]
v4: $ G ⇒ etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w d = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w d ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w d) a ⟩ ⟩ ⟩)} $ by etel_app [k2, k4, #5, #6]
v5: $ G ⇒ etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w e = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w e ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w e) a ⟩ ⟩ ⟩)} $ by etel_app [k2, k4, #5, #7]
r1: $ G ⇒ w = w $ by eq_refl
r2: $ G ⇒ d = d $ by eq_refl
r3: $ G ⇒ e = e $ by eq_refl
v6: $ G ⇒ etel u (dnf u M) z w d = etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w d $ by etel_eq [#1, r1, r2]
v7: $ G ⇒ etel u (dnf u M) z w e = etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w e $ by etel_eq [#1, r1, r3]
f1: $ G ⇒ etel u (dnf u M) z w d = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w d ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w d) a ⟩ ⟩ ⟩)} $ by eq_trans [v6, v4]
f2: $ G ⇒ etel u (dnf u M) z w d = {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w e ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w e) a ⟩ ⟩ ⟩)} $ by eq_trans [f1, v3]
f3: $ G ⇒ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel u (dnf u M) f w e ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv (dnf u M) g) w e) a ⟩ ⟩ ⟩)} = etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w e $ by eq_sym [v5]
f4: $ G ⇒ etel u (dnf u M) z w d = etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w e $ by eq_trans [f2, f3]
f5: $ G ⇒ etel u (dnf u M) ⟨ kc_app , scons f (scons g ∅) ⟩ w e = etel u (dnf u M) z w e $ by eq_sym [v7]
f6: $ G ⇒ etel u (dnf u M) z w d = etel u (dnf u M) z w e $ by eq_trans [f4, f5]

lemma i8_cs_other (G: hyps) (E K S: class) (u w z k j d e: set): $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ K ∈ ω $ > $ G ⇒ ¬ kc_pi = K $ > $ G ⇒ ¬ kc_app = K $ > $ G ⇒ isset S $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ etel u E z w d = etel u E z w e $
----
a1: $ G ⇒ ⟨ k , j ⟩ = z $ by eq_sym [#2]
a2: $ G ⇒ ⟨ k , j ⟩ = ⟨ K , S ⟩ $ by eq_trans [a1, #1]
a3: $ G ⇒ isset k $ by isset_var
a4: $ G ⇒ isset j $ by isset_var
a5: $ G ⇒ isset K $ by wcel_isset [#4]
a6: $ G ⇒ k = K ∧ j = S $ by opair_inj_c [a2, a3, a4, a5, #7]
a7: $ G ⇒ j = S $ by and_elim_r [a6]
a8: $ G ⇒ j ∈ fseq (trees ω) $ by welc_wcel [#3]
a9: $ G ⇒ S ∈ fseq (trees ω) $ by wcel_eq_l [a7, a8]
b1: $ G ⇒ ¬ K = kc_pi $ by ne_sym [#5]
b2: $ G ⇒ ¬ K = kc_app $ by ne_sym [#6]
b3: $ G ⇒ w ∈ lvals $ by welc_wcel [#8]
b4: $ G ⇒ d ∈ fseq u $ by welc_wcel [#9]
b5: $ G ⇒ e ∈ fseq u $ by welc_wcel [#10]
c1: $ G ⇒ etel u E ⟨ K , S ⟩ w d = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_c [#4, a9, b1, b2, b3, b4]
c2: $ G ⇒ etel u E ⟨ K , S ⟩ w e = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_c [#4, a9, b1, b2, b3, b5]
r1: $ G ⇒ w = w $ by eq_refl
r2: $ G ⇒ d = d $ by eq_refl
r3: $ G ⇒ e = e $ by eq_refl
c3: $ G ⇒ etel u E z w d = etel u E ⟨ K , S ⟩ w d $ by etel_eq [#1, r1, r2]
c4: $ G ⇒ etel u E z w e = etel u E ⟨ K , S ⟩ w e $ by etel_eq [#1, r1, r3]
c5: $ G ⇒ etel u E z w d = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [c3, c1]
c6: $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = etel u E ⟨ K , S ⟩ w e $ by eq_sym [c2]
c7: $ G ⇒ etel u E z w d = etel u E ⟨ K , S ⟩ w e $ by eq_trans [c5, c6]
c8: $ G ⇒ etel u E ⟨ K , S ⟩ w e = etel u E z w e $ by eq_sym [c4]
c9: $ G ⇒ etel u E z w d = etel u E z w e $ by eq_trans [c7, c8]

lrel_closed_etel
----------------
