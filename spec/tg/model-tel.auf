n2e: $ G , h = ⟨ K , S ⟩ ⇒ t5 = t5 $ by eq_refl
n3: $ G , h = ⟨ K , S ⟩ ⇒ ra_rehead ⟨ K , S ⟩ t2 t3 t4 t5 = ra_rehead h t2 t3 t4 t5 $ by ra_rehead_eq [n2, n2b, n2c, n2d, n2e]
n4: $ G , h = ⟨ K , S ⟩ ⇒ ra_rehead h t2 t3 t4 t5 ∈ lrel $ by wcel_eq_l [n3, n1]
n5: $ G , h = ⟨ K , S ⟩ ⇒ h ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by i7_rh_args [n4]
n6: $ G , h = ⟨ K , S ⟩ ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by and_elim_r [n5]
n7: $ G , h = ⟨ K , S ⟩ ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by and_elim_r [n6]
n8: $ G , h = ⟨ K , S ⟩ ⇒ t3 ∊ trees ω $ by and_elim_l [n7]
n9: $ G , h = ⟨ K , S ⟩ ⇒ t3 ∊ i7_rhp u M h t2 w r $ by subset_elim [s15, n8]
n10: $ G , h = ⟨ K , S ⟩ ⇒ ∀ e ∀ f (ra_rehead h t2 t3 e f ∈ lrel → etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) e w r ∈ fseq i7_V ∧ dt u M f w r = apn (dt u M t2 w r) (sarg u (dnf u M) e w r)) $ by cab_elim [n9]

n11: $ G , h = ⟨ K , S ⟩ ⇒ ∀ f (ra_rehead h t2 t3 t4 f ∈ lrel → etel u (dnf u M) t4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t4 w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) t4 w r ∈ fseq i7_V ∧ dt u M f w r = apn (dt u M t2 w r) (sarg u (dnf u M) t4 w r)) $ by all_elim [n10]
n12: $ G , h = ⟨ K , S ⟩ ⇒ ra_rehead h t2 t3 t4 t5 ∈ lrel → etel u (dnf u M) t4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t4 w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) t4 w r ∈ fseq i7_V ∧ dt u M t5 w r = apn (dt u M t2 w r) (sarg u (dnf u M) t4 w r) $ by all_elim [n11]
n13: $ G , h = ⟨ K , S ⟩ ⇒ etel u (dnf u M) t4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t4 w r ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) t4 w r ∈ fseq i7_V ∧ dt u M t5 w r = apn (dt u M t2 w r) (sarg u (dnf u M) t4 w r) $ by imp_elim [n12, n4]
n14: $ G , h = ⟨ K , S ⟩ ⇒ sarg u (dnf u M) t4 w r ∈ fseq i7_V ∧ dt u M t5 w r = apn (dt u M t2 w r) (sarg u (dnf u M) t4 w r) $ by and_elim_r [n13]
n15: $ G , h = ⟨ K , S ⟩ ⇒ dt u M t5 w r = apn (dt u M t2 w r) (sarg u (dnf u M) t4 w r) $ by and_elim_r [n14]
z0: $ G ⇒ isset ⟨ K , S ⟩ $ by opair_isset
z1: $ G ⇒ dt u M t5 w r = apn (dt u M t2 w r) (sarg u (dnf u M) t4 w r) $ by isset_elim [z0, n15]

--| i7: a member of a trace of traces has its arguments in the domains.
lemma i7_cc {w r: set} (G: hyps w r) (U: class) (B: class w r) (d z x0 x1 q: set): $ G ⇒ d = ⟨ x0 , z ⟩ $ > $ G ⇒ z = ⟨ x1 , q ⟩ $ > $ G ⇒ d ∊ clam w lvals (clam r (fseq U) B) $ > $ G ⇒ x0 ∊ lvals ∧ x1 ∊ fseq U $
----
l1: $ G ⇒ d ∈ clam w lvals (clam r (fseq U) B) $ by welc_wcel [#3]
l2: $ G ⇒ ⟨ x0 , z ⟩ ∈ clam w lvals (clam r (fseq U) B) $ by wcel_eq_l [#1, l1]
l3: $ G ⇒ x0 ∊ lvals ∧ z ∊ clam r (fseq U) (⟦ w / x0 ⟧ B) $ by clam_elim [l2]
l4: $ G ⇒ x0 ∊ lvals $ by and_elim_l [l3]
l5: $ G ⇒ z ∊ clam r (fseq U) (⟦ w / x0 ⟧ B) $ by and_elim_r [l3]
l6: $ G ⇒ z ∈ clam r (fseq U) (⟦ w / x0 ⟧ B) $ by welc_wcel [l5]
l7: $ G ⇒ ⟨ x1 , q ⟩ ∈ clam r (fseq U) (⟦ w / x0 ⟧ B) $ by wcel_eq_l [#2, l6]
l8: $ G ⇒ x1 ∊ fseq U ∧ q ∊ (⟦ r / x1 ⟧ (⟦ w / x0 ⟧ B)) $ by clam_elim [l7]
l9: $ G ⇒ x1 ∊ fseq U $ by and_elim_l [l8]
l10: $ G ⇒ x0 ∊ lvals ∧ x1 ∊ fseq U $ by and_intro [l4, l9]

--| i7: a path of a telescope is at a level valuation and a valuation over `u`.
lemma i7_etel_dom (G: hyps) (E: class) (u o q x0 x1: set): $ G ⇒ o ∊ trees ω $ > $ G ⇒ q ∊ etel u E o x0 x1 $ > $ G ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $
----
p0: $ G ⇒ isset ω $ by omega_set
p1a: $ G , l = ω ⇒ l = ω $ by ax
p1b: $ G , l = ω ⇒ ω = l $ by eq_sym [p1a]
p1c: $ G , l = ω ⇒ trees ω = trees l $ by trees_eq [p1b]
p1d: $ G , l = ω ⇒ o ∊ trees ω $ by weaken [#1]
p1e: $ G , l = ω ⇒ o ∊ trees l $ by welc_eq [p1c, p1d]
p1: $ G , l = ω ⇒ ∃ k ∃ j (k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩) $ by trees_elim [p1e]
e0: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ $ by ax
e0a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ l = ω $ by ax
e0b: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ ω = l $ by eq_sym [e0a]
e0c: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ trees l = trees ω $ by trees_eq [e0a]
e0d: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ fseq (trees l) = fseq (trees ω) $ by fseq_eq [e0c]
e1a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ k ∊ l $ by and_elim_l [e0]
e1: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ k ∊ ω $ by welc_eq [e0a, e1a]
e1b: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ $ by and_elim_r [e0]
e2a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ j ∊ fseq (trees l) $ by and_elim_l [e1b]
e2: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ j ∊ fseq (trees ω) $ by welc_eq [e0d, e2a]
e3: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ o = ⟨ k , j ⟩ $ by and_elim_r [e1b]
e3b: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ c = ccom (etf u E) j $ by ax
e4: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ fv (etf u E) ⟨ k , j ⟩ = etb u E k j c $ by etf_node [e1, e2, e3b]
e5a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ etf u E = etf u E $ by eq_refl
e5: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ fv (etf u E) o = fv (etf u E) ⟨ k , j ⟩ $ by fv_eq [e5a, e3]
e6: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ fv (etf u E) o = etb u E k j c $ by eq_trans [e5, e4]
e7: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ q ∊ ap (ap (fv (etf u E) o) x0) x1 $ by weaken [#2]
e8a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ x0 = x0 $ by eq_refl
e8b: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ x1 = x1 $ by eq_refl
e8c: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ ap (fv (etf u E) o) x0 = ap (etb u E k j c) x0 $ by ap_eq [e6, e8a]
e8: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ q ∊ ap (ap (etb u E k j c) x0) x1 $ by welc_ap_eq [e8c, e8b, e7]
e9: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ ⟨ x1 , q ⟩ ∈ ap (etb u E k j c) x0 $ by ap_elim [e8]
f1: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 ⇒ z ∊ ap (etb u E k j c) x0 $ by ax
f2: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 ⇒ ⟨ x0 , z ⟩ ∈ etb u E k j c $ by ap_elim [f1]
g1: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c ⇒ d ∊ etb u E k j c $ by ax
