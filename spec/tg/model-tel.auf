--| The valuations `scat p g`, `g` satisfying `B` and `p` a valuation of the
--| telescope `X` over `g`.
def i6_rr (U M W X B: class) (.y .g .p: set): class = $ {y | ∃ g ∃ p (g ∊ sat U M B W ∧ p ∊ esat U (dsh U M g) X W ∧ y = scat p g)} $

lemma i6_tri_inj (G: hyps) (A B: class): $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ A = B $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ $ by opair_isset
l3: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by opair_isset
l4: $ G ⇒ ∅ = ∅ ∧ ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by opair_inj_c [#1, l1, l2, l1, l3]
l5: $ G ⇒ ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by and_elim_r [l4]
l6: $ G ⇒ isset ⟨ ∅ , A ⟩ $ by opair_isset
l7: $ G ⇒ isset ⟨ ∅ , B ⟩ $ by opair_isset
l8: $ G ⇒ ∅ = ∅ ∧ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by opair_inj_c [l5, l1, l6, l1, l7]
l9: $ G ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by and_elim_r [l8]
l10: $ G ⇒ ∅ = ∅ ∧ A = B $ by opair_inj_c [l9, l1, #2, l1, #3]
l11: $ G ⇒ A = B $ by and_elim_r [l10]

lemma i6_csn_elim (G: hyps) (A B: class): $ G ⇒ A ∈ csn B $ > $ G ⇒ A = B $
----
l1: $ G , z = A , z ∊ csn B ⇒ z ∊ csn B $ by ax
l2: $ G , z = A , z ∊ csn B ⇒ z = B $ by csn_elim [l1]
l3: $ G , z = A , z ∊ csn B ⇒ z = A $ by ax
l4: $ G , z = A , z ∊ csn B ⇒ A = z $ by eq_sym [l3]
l5: $ G , z = A , z ∊ csn B ⇒ A = B $ by eq_trans [l4, l2]
l6: $ G ⇒ A = B $ by wcel_elim [#1, l5]

lemma i6_csn_self (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ csn A $
----
l1: $ G , z = A ⇒ z = A $ by ax
l2: $ G , z = A ⇒ z ∊ csn A $ by csn_intro [l1]
l3: $ G , z = A ⇒ A ∈ csn A $ by wcel_intro [l1, l2]
l4: $ G ⇒ A ∈ csn A $ by isset_elim [#1, l3]

lemma i6_tree_eq {k j: set} (G H: hyps) (T: class) (c: fml): $ G ⇒ T ∈ trees ω $ > $ H , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ c $ > $ G , H ⇒ c $
----
a1: $ H , o = ω , x = T , x ∊ trees ω ⇒ o = ω $ by ax
a2: $ H , o = ω , x = T , x ∊ trees ω ⇒ ω = o $ by eq_sym [a1]
a3: $ H , o = ω , x = T , x ∊ trees ω ⇒ trees ω = trees o $ by trees_eq [a2]
a4: $ H , o = ω , x = T , x ∊ trees ω ⇒ x ∊ trees ω $ by ax
a5: $ H , o = ω , x = T , x ∊ trees ω ⇒ x ∊ trees o $ by welc_eq [a3, a4]
a6: $ H , o = ω , x = T , x ∊ trees ω ⇒ ∃ k ∃ j (k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩) $ by trees_elim [a5]
b1: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ $ by ax
b2: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ k ∊ o $ by and_elim_l [b1]
b3: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ $ by and_elim_r [b1]
b4: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees o) $ by and_elim_l [b3]
b5: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ x = ⟨ k , j ⟩ $ by and_elim_r [b3]
b6: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ o = ω $ by ax
b7: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ k ∊ ω $ by welc_eq [b6, b2]
b8: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ trees o = trees ω $ by trees_eq [b6]
b9: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ fseq (trees o) = fseq (trees ω) $ by fseq_eq [b8]
b10: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees ω) $ by welc_eq [b9, b4]
b11: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ x = T $ by ax
b12: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ T = x $ by eq_sym [b11]
b13: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ T = ⟨ k , j ⟩ $ by eq_trans [b12, b5]
c1: $ H , k ∊ ω , j ∊ fseq (trees ω) ⇒ T = ⟨ k , j ⟩ → c $ by imp_intro [#2]
c2: $ H , k ∊ ω ⇒ j ∊ fseq (trees ω) → T = ⟨ k , j ⟩ → c $ by imp_intro [c1]
c3: $ H ⇒ k ∊ ω → j ∊ fseq (trees ω) → T = ⟨ k , j ⟩ → c $ by imp_intro [c2]
wc4_1: $ H , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ , o = ω , x = T , x ∊ trees ω ⇒ k ∊ ω → j ∊ fseq (trees ω) → T = ⟨ k , j ⟩ → c $ by weaken [c3]
c4: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ k ∊ ω → j ∊ fseq (trees ω) → T = ⟨ k , j ⟩ → c $ by weaken [wc4_1]
c5: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees ω) → T = ⟨ k , j ⟩ → c $ by imp_elim [c4, b7]
c6: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ T = ⟨ k , j ⟩ → c $ by imp_elim [c5, b10]
c7: $ H , o = ω , x = T , x ∊ trees ω , k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩ ⇒ c $ by imp_elim [c6, b13]
d1: $ H , o = ω , x = T , x ∊ trees ω , ∃ j (k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩) ⇒ ∃ j (k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩) $ by ax
d2: $ H , o = ω , x = T , x ∊ trees ω , ∃ j (k ∊ o ∧ j ∊ fseq (trees o) ∧ x = ⟨ k , j ⟩) ⇒ c $ by ex_elim [d1, c7]
d3: $ H , o = ω , x = T , x ∊ trees ω ⇒ c $ by ex_elim [a6, d2]
wd4_2: $ G , H , o = ω ⇒ T ∈ trees ω $ by weaken [#1]
d4: $ G , H , o = ω ⇒ c $ by wcel_elim [wd4_2, d3]
d5: $ G ⇒ isset ω $ by omega_set
wd6_3: $ G , H ⇒ isset ω $ by weaken [d5]
d6: $ G , H ⇒ c $ by isset_elim [wd6_3, d4]

lemma i6_tind {k j: set} (G: hyps) (P: class): $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ P ⇒ ⟨ k , j ⟩ ∈ P $ > $ G ⇒ trees ω ⊆ P $
----
l1: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ P → ⟨ k , j ⟩ ∈ P $ by imp_intro [#1]
l2: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ P → ⟨ k , j ⟩ ∈ P $ by imp_intro [l1]
l3: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ P → ⟨ k , j ⟩ ∈ P $ by imp_intro [l2]
l4: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ P → ⟨ k , j ⟩ ∈ P) $ by all_intro [l3]
l5: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ P → ⟨ k , j ⟩ ∈ P) $ by all_intro [l4]
l6: $ G ⇒ isset ω $ by omega_set
l7: $ G ⇒ trees ω ⊆ P $ by trees_ind_c [l6, l5]

lemma i6_kid2 (G: hyps) (P K: class) (k j a b: set): $ G ⇒ crn j ⊆ P $ > $ G ⇒ ⟨ k , j ⟩ = ⟨ K , scons a (scons b ∅) ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ a ∈ P ∧ b ∈ P $
----
l1: $ G ⇒ isset k $ by isset_var
l2: $ G ⇒ isset j $ by isset_var
l3a: $ G ⇒ isset ∅ $ by ax_empty
l3b: $ G ⇒ isset (scons b ∅) $ by scons_set [l3a]
l3: $ G ⇒ isset (scons a (scons b ∅)) $ by scons_set [l3b]
l4: $ G ⇒ k = K ∧ j = scons a (scons b ∅) $ by opair_inj_c [#2, l1, l2, #3, l3]
l5: $ G ⇒ j = scons a (scons b ∅) $ by and_elim_r [l4]
l6: $ G ⇒ crn j = crn (scons a (scons b ∅)) $ by crn_eq [l5]
l7: $ G ⇒ crn (scons a (scons b ∅)) ⊆ P $ by subset_eq_l [l6, #1]
l8: $ G ⇒ isset a $ by isset_var
l9: $ G ⇒ a ∈ P $ by crn_scons_head [l8, l7]
l10: $ G ⇒ crn (scons b ∅) ⊆ P $ by crn_scons_tail [l7]
l11: $ G ⇒ isset b $ by isset_var
l12: $ G ⇒ b ∈ P $ by crn_scons_head [l11, l10]
l13: $ G ⇒ a ∈ P ∧ b ∈ P $ by and_intro [l9, l12]

lemma i6_esat_tr (G: hyps) (E T T2 W: class) (u p: set): $ G ⇒ T = T2 $ > $ G ⇒ p ∊ esat u E T W $ > $ G ⇒ p ∊ esat u E T2 W $
----
l1: $ G ⇒ esf u E = esf u E $ by eq_refl
l2: $ G ⇒ fv (esf u E) T = fv (esf u E) T2 $ by fv_eq [l1, #1]
l3: $ G ⇒ W = W $ by eq_refl
l4: $ G ⇒ p ∊ esat u E T2 W $ by welc_ap_eq [l2, l3, #2]

lemma i6_clam_dom {x: set} (G: hyps x) (A: class) (B: class x) (a b: set): $ G ⇒ ⟨ a , b ⟩ ∈ clam x A B $ > $ G ⇒ a ∊ A $
----
l1: $ G ⇒ a ∊ A ∧ b ∊ (⟦ x / a ⟧ B) $ by clam_elim [#1]
l2: $ G ⇒ a ∊ A $ by and_elim_l [l1]

lemma i6_esb_lv (G: hyps) (U E K S V: class) (a b: set): $ G ⇒ ⟨ a , b ⟩ ∈ esb U E K S V $ > $ G ⇒ a ∊ lvals $
----
c1: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V ⇒ z ∊ esb U E K S V $ by ax
c2: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)}) $ by cab_elim [c1]
c4: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V ⇒ z = ⟨ a , b ⟩ $ by ax
d1: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ K = kc_nil ∧ z ∊ clam w lvals (csn ∅) $ by ax
d2: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ z ∊ clam w lvals (csn ∅) $ by and_elim_r [d1]
wd3_4: $ G , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) , z = ⟨ a , b ⟩ , z ∊ esb U E K S V ⇒ z = ⟨ a , b ⟩ $ by weaken [c4]
d3: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ ⟨ a , b ⟩ ∈ clam w lvals (csn ∅) $ by wcel_intro [wd3_4, d2]
d4: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ a ∊ lvals $ by i6_clam_dom [d3]
e1: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} $ by ax
e2: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} $ by and_elim_r [e1]
we3_5: $ G , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} , z = ⟨ a , b ⟩ , z ∊ esb U E K S V ⇒ z = ⟨ a , b ⟩ $ by weaken [c4]
e3: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} ⇒ ⟨ a , b ⟩ ∈ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} $ by wcel_intro [we3_5, e2]
e4: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) w ∧ x ∊ da (fv E (fv S ∅)) w q ∧ r = scons x q)} ⇒ a ∊ lvals $ by i6_clam_dom [e3]
f1: $ G , z = ⟨ a , b ⟩ , z ∊ esb U E K S V ⇒ a ∊ lvals $ by or_elim [c2, d4, e4]
f2: $ G ⇒ a ∊ lvals $ by wcel_elim [#1, f1]

lemma i6_esat_lv (G: hyps) (E T: class) (u w p: set): $ G ⇒ T ∈ trees ω $ > $ G ⇒ p ∊ esat u E T w $ > $ G ⇒ w ∊ lvals $
----
n0: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ T = ⟨ k , j ⟩ $ by ax
wn1_6: $ G , T = ⟨ k , j ⟩ , j ∊ fseq (trees ω) , k ∊ ω ⇒ p ∊ esat u E T w $ by weaken [#2]
n1: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ p ∊ esat u E ⟨ k , j ⟩ w $ by i6_esat_tr [n0, wn1_6]
n1a: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ k ∊ ω $ by ax
n1b: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ j ∊ fseq (trees ω) $ by ax
n2: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ fv (esf u E) ⟨ k , j ⟩ = esb u E k j (ccom (esf u E) j) $ by esf_node [n1a, n1b]
n3: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ w = w $ by eq_refl
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ p ∊ ap (esb u E k j (ccom (esf u E) j)) w $ by welc_ap_eq [n2, n3, n1]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ ⟨ w , p ⟩ ∈ esb u E k j (ccom (esf u E) j) $ by ap_elim [n4]
n6: $ G , k ∊ ω , j ∊ fseq (trees ω) , T = ⟨ k , j ⟩ ⇒ w ∊ lvals $ by i6_esb_lv [n5]
n7: $ G ⇒ w ∊ lvals $ by i6_tree_eq [#1, n6]

lemma i6_sat_tr (G: hyps) (M T T2 W: class) (u p: set): $ G ⇒ T = T2 $ > $ G ⇒ p ∊ sat u M T W $ > $ G ⇒ p ∊ sat u M T2 W $
----
l1: $ G ⇒ stf u M = stf u M $ by eq_refl
l2: $ G ⇒ fv (stf u M) T = fv (stf u M) T2 $ by fv_eq [l1, #1]
l3: $ G ⇒ W = W $ by eq_refl
l4: $ G ⇒ p ∊ sat u M T2 W $ by welc_ap_eq [l2, l3, #2]

lemma i6_cap_nil (G: hyps) (M: class) (u w z x0 x1: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ z = ⟨ kc_nil , ∅ ⟩ $ > $ G ⇒ x1 = x0 $ > $ G ⇒ sat u M x1 w = i6_rr u M w z x0 $
----
a1: $ G , y ∊ sat u M x1 w ⇒ y ∊ sat u M x1 w $ by ax
wa3_1: $ G , y ∊ sat u M x1 w ⇒ x1 = x0 $ by weaken [#3]
a3: $ G , y ∊ sat u M x1 w ⇒ y ∊ sat u M x0 w $ by i6_sat_tr [wa3_1, a1]
a4: $ G , y ∊ sat u M x1 w ⇒ sat u M x0 w ⊆ fseq u $ by sat_fseq
a5: $ G , y ∊ sat u M x1 w ⇒ y ∊ fseq u $ by subset_elim [a4, a3]
a6: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ e = ∅ $ by ax
a7: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ e ∊ csn ∅ $ by csn_intro [a6]
wa8_2: $ G , e = ∅ , y ∊ sat u M x1 w ⇒ w ∊ lvals $ by weaken [#1]
a8: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ esat u (dsh u M y) ⟨ kc_nil , ∅ ⟩ w = csn ∅ $ by esat_nil [wa8_2]
a9: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ csn ∅ = esat u (dsh u M y) ⟨ kc_nil , ∅ ⟩ w $ by eq_sym [a8]
a10: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ e ∊ esat u (dsh u M y) ⟨ kc_nil , ∅ ⟩ w $ by welc_eq [a9, a7]
wa11_3: $ G , e = ∅ , y ∊ sat u M x1 w ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by weaken [#2]
a11: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ ⟨ kc_nil , ∅ ⟩ = z $ by eq_sym [wa11_3]
a12: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ e ∊ esat u (dsh u M y) z w $ by i6_esat_tr [a11, a10]
wa13_4: $ G , e = ∅ , y ∊ sat u M x1 w ⇒ y ∊ fseq u $ by weaken [a5]
a13: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ scat ∅ y = y $ by scat_empty_l [wa13_4]
a14: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ y = y $ by eq_refl
a15: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ scat e y = scat ∅ y $ by scat_eq [a6, a14]
a16: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ scat e y = y $ by eq_trans [a15, a13]
a17: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ y = scat e y $ by eq_sym [a16]
a18: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ e ∊ esat u (dsh u M y) z w ∧ y = scat e y $ by and_intro [a12, a17]
wa19_5: $ G , e = ∅ , y ∊ sat u M x1 w ⇒ y ∊ sat u M x0 w $ by weaken [a3]
a19: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ y ∊ sat u M x0 w ∧ e ∊ esat u (dsh u M y) z w ∧ y = scat e y $ by and_intro [wa19_5, a18]
a20: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ ∃ p (y ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M y) z w ∧ y = scat p y) $ by ex_intro [a19]
a21: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ ∃ g ∃ p (g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g) $ by ex_intro [a20]
a22: $ G , y ∊ sat u M x1 w , e = ∅ ⇒ y ∊ i6_rr u M w z x0 $ by cab_intro [a21]
a23a: $ G , y ∊ sat u M x1 w ⇒ isset ∅ $ by ax_empty
a23: $ G , y ∊ sat u M x1 w ⇒ y ∊ i6_rr u M w z x0 $ by isset_elim [a23a, a22]
b1: $ G , y ∊ i6_rr u M w z x0 ⇒ y ∊ i6_rr u M w z x0 $ by ax
b2: $ G , y ∊ i6_rr u M w z x0 ⇒ ∃ g ∃ p (g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g) $ by cab_elim [b1]
b3: $ G , y ∊ i6_rr u M w z x0 , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g ⇒ g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g $ by ax
b4: $ G , y ∊ i6_rr u M w z x0 , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g ⇒ g ∊ sat u M x0 w $ by and_elim_l [b3]
b5a: $ G , y ∊ i6_rr u M w z x0 , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g ⇒ p ∊ esat u (dsh u M g) z w ∧ y = scat p g $ by and_elim_r [b3]
b5: $ G , y ∊ i6_rr u M w z x0 , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g ⇒ p ∊ esat u (dsh u M g) z w $ by and_elim_l [b5a]
b5b: $ G , y ∊ i6_rr u M w z x0 , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g ⇒ y = scat p g $ by and_elim_r [b5a]
wb6_6: $ G , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g , y ∊ i6_rr u M w z x0 ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by weaken [#2]
b6: $ G , y ∊ i6_rr u M w z x0 , g ∊ sat u M x0 w ∧ p ∊ esat u (dsh u M g) z w ∧ y = scat p g ⇒ p ∊ esat u (dsh u M g) ⟨ kc_nil , ∅ ⟩ w $ by i6_esat_tr [wb6_6, b5]
