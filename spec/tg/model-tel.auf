p5: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ ap (apn x o) a ∈ da (fv E B) w (scons a o) $ by wcel_elim [o5, p4]
p6a: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ apn x q = ap (apn x o) a $ by eq_trans [o2, o3]
p6b: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ ap (apn x o) a = apn x q $ by eq_sym [p6a]
p6: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ apn x q ∈ da (fv E B) w (scons a o) $ by wcel_eq_l [p6b, p5]
p7a: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ fv E B = fv E B $ by eq_refl
p7b: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ w = w $ by eq_refl
p7c: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ scons a o = q $ by eq_sym [o1]
p7: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ da (fv E B) w (scons a o) = da (fv E B) w q $ by da_eq [p7a, p7b, p7c]
p8: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w , o ∊ esat u E P w , a ∊ da (fv E A) w o , q = scons a o ⇒ apn x q ∈ da (fv E B) w q $ by wcel_eq_r [p7, p6]
p9: $ G , x ∊ ipi u E P Q w , q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ⇒ apn x q ∈ da (fv E B) w q $ by i5_cons_el [n0a, n0b, n0c, n0, p8]
q1: $ G , x ∊ ipi u E P Q w ⇒ q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w → apn x q ∈ da (fv E B) w q $ by imp_intro [p9]
q2: $ G , x ∊ ipi u E P Q w ⇒ ∀ q (q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w → apn x q ∈ da (fv E B) w q) $ by all_intro [q1]
q3: $ G , x ∊ ipi u E P Q w ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} ∧ ∀ q (q ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w → apn x q ∈ da (fv E B) w q) $ by and_intro [m14, q2]
q4: $ G , x ∊ ipi u E P Q w ⇒ x ∊ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w $ by cab_intro [q3]
r1: $ G ⇒ ipi u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w = ipi u E P Q w $ by eq_intro [f7, q4]

lemma i5_dsh_in (G: hyps) (M A: class) (u w s q: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ A ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ dt u M A w (scat q s) ∈ u $
----
k1: $ G ⇒ scat q s ∈ fseq u $ by scat_fseq [#5, #3]
k2: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
m1a: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ uadm u $ by weaken [#1]
m1b: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ a ∊ ofsort lsig lopen ks_expr $ by ax
m1c: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ w ∈ lvals $ by weaken [k2]
m1d: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ scat q s ∈ fseq u $ by weaken [k1]
m1: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ dt u M a w (scat q s) ∈ u $ by dt_in_u_c [m1a, m1b, m1c, m1d]
m2a: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ u = u $ by eq_refl
m2b: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ M = M $ by eq_refl
m2c: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ a = A $ by ax
m2d: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ w = w $ by eq_refl
m2e: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ scat q s = scat q s $ by eq_refl
m2: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ dt u M a w (scat q s) = dt u M A w (scat q s) $ by dt_eq [m2a, m2b, m2c, m2d, m2e]
m3: $ G , a = A , a ∊ ofsort lsig lopen ks_expr ⇒ dt u M A w (scat q s) ∈ u $ by wcel_eq_l [m2, m1]
n1: $ G ⇒ dt u M A w (scat q s) ∈ u $ by wcel_elim [#4, m3]

lemma i5_dsh_body (G: hyps) (M B: class) (u w s q y: set): $ G ⇒ s ∊ fseq u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ y ∊ u $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ dt u M B w (scons y (scat q s)) = da (fv (dsh u M s) B) w (scons y q) $
----
k1: $ G ⇒ scons y q ∈ fseq u $ by scons_fseq [#4, #3]
k2: $ G ⇒ isset B $ by wcel_isset [#5]
k3: $ G ⇒ s ∈ fseq u $ by welc_wcel [#1]
k4: $ G ⇒ w ∈ lvals $ by welc_wcel [#2]
k5: $ G ⇒ da (fv (dsh u M s) B) w (scons y q) = dt u M B w (scat (scons y q) s) $ by dsh_da_c [k2, k3, k4, k1]
k6: $ G ⇒ scat (scons y q) s = scons y (scat q s) $ by scat_scons [#3, #1]
m2a: $ G ⇒ u = u $ by eq_refl
m2b: $ G ⇒ M = M $ by eq_refl
m2c: $ G ⇒ B = B $ by eq_refl
m2d: $ G ⇒ w = w $ by eq_refl
k7: $ G ⇒ dt u M B w (scat (scons y q) s) = dt u M B w (scons y (scat q s)) $ by dt_eq [m2a, m2b, m2c, m2d, k6]
k8: $ G ⇒ da (fv (dsh u M s) B) w (scons y q) = dt u M B w (scons y (scat q s)) $ by eq_trans [k5, k7]
k9: $ G ⇒ dt u M B w (scons y (scat q s)) = da (fv (dsh u M s) B) w (scons y q) $ by eq_sym [k8]

lemma i5_ilam_cons {y q: set} (G: hyps) (E A P B Q: class) (u w: set): $ G ⇒ universe u $ > $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ ∀ q (q ∊ esat u E P w → da (fv E A) w q ∈ u) $ > $ G ⇒ ∀ q (q ∊ esat u E P w → da (fv E Q) w q = clam y (da (fv E A) w q) (da (fv E B) w (scons y q))) $ > $ G ⇒ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w = ilam u E P Q w $
----
a1: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w ⇒ c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w $ by ax
a2: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w ⇒ ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z) $ by cab_elim [a1]
b1: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z $ by ax
b2: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by and_elim_l [b1]
b3: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ z ∊ da (fv E B) w p ∧ c = nest p z $ by and_elim_r [b1]
b4: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ z ∊ da (fv E B) w p $ by and_elim_l [b3]
b5: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ c = nest p z $ by and_elim_r [b3]
b6a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ A ∈ trees ω $ by weaken [#2]
b6b: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ P ∈ trees ω $ by weaken [#3]
b6c: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z ⇒ w ∊ lvals $ by weaken [#4]
c1: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ p = scons x q $ by ax
c2a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ fv E B = fv E B $ by eq_refl
c2b: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ w = w $ by eq_refl
c2: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ da (fv E B) w p = da (fv E B) w (scons x q) $ by da_eq [c2a, c2b, c1]
c3a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z ∊ da (fv E B) w p $ by weaken [b4]
c3: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z ∊ da (fv E B) w (scons x q) $ by welc_eq [c2, c3a]
c4a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ x ∊ da (fv E A) w q $ by ax
c4: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ ⟨ x , z ⟩ ∈ clam y (da (fv E A) w q) (da (fv E B) w (scons y q)) $ by clam_intro [c4a, c3]
c5a: $ G ⇒ q ∊ esat u E P w → da (fv E Q) w q = clam y (da (fv E A) w q) (da (fv E B) w (scons y q)) $ by all_elim [#6]
c5b: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∊ esat u E P w → da (fv E Q) w q = clam y (da (fv E A) w q) (da (fv E B) w (scons y q)) $ by weaken [c5a]
c5c: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∊ esat u E P w $ by ax
c5: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ da (fv E Q) w q = clam y (da (fv E A) w q) (da (fv E B) w (scons y q)) $ by imp_elim [c5b, c5c]
c6a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ clam y (da (fv E A) w q) (da (fv E B) w (scons y q)) = da (fv E Q) w q $ by eq_sym [c5]
c6: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ ⟨ x , z ⟩ ∈ da (fv E Q) w q $ by wcel_eq_r [c6a, c4]
c7a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z = z $ by eq_refl
c7b: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest p z = nest (scons x q) z $ by nest_eq [c1, c7a]
c7c: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ esat u E P w ⊆ fseq u $ by esat_fseq
c7d: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∊ fseq u $ by subset_elim [c7c, c5c]
c7e: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ isset z $ by isset_var
c7f: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest (scons x q) z = nest q ⟨ x , z ⟩ $ by nest_scons [c7d, c7e]
c7g: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c = nest p z $ by weaken [b5]
c7h: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c = nest (scons x q) z $ by eq_trans [c7g, c7b]
c7: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c = nest q ⟨ x , z ⟩ $ by eq_trans [c7h, c7f]
d1a: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ , v ∊ da (fv E Q) w q ⇒ v = ⟨ x , z ⟩ $ by ax
d1b: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ , v ∊ da (fv E Q) w q ⇒ ⟨ x , z ⟩ = v $ by eq_sym [d1a]
d1c: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ , v ∊ da (fv E Q) w q ⇒ q = q $ by eq_refl
d1d: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ , v ∊ da (fv E Q) w q ⇒ nest q ⟨ x , z ⟩ = nest q v $ by nest_eq [d1c, d1b]
d1e: $ G , c ∊ ilam u E ⟨ kc_cons , scons A (scons P ∅) ⟩ B w , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ z ∊ da (fv E B) w p ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ , v ∊ da (fv E Q) w q ⇒ c = nest q ⟨ x , z ⟩ $ by weaken [c7]
