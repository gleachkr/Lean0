l8: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ a = a $ by eq_refl
l9: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ b = b $ by eq_refl
l10a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ by weaken [#5]
