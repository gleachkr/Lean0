l4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ nadd (fv nvf d) (fv nvf t3) = nadd (fv nvf x4) (fv nvf x3) $ by nadd_eq [l2, l3]
l5: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ fv nvf x7 = nadd (fv nvf x4) (fv nvf x3) $ by lrel_add_sem [b9]
