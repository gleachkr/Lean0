lemma i7_pi_seq (G: hyps) (A: class) (q x n s: set): $ G ⇒ q ∊ fseq A $ > $ G ⇒ x ∊ A $ > $ G ⇒ n ∊ fseq A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ scat (ssnoc q x) (scat n s) = scat q (scat (scons x n) s) $
----
a1: $ G , c = scat n s ⇒ q ∊ fseq A $ by weaken [#1]
a2: $ G , c = scat n s ⇒ x ∊ A $ by weaken [#2]
a3: $ G , c = scat n s ⇒ n ∊ fseq A $ by weaken [#3]
a4: $ G , c = scat n s ⇒ s ∊ fseq A $ by weaken [#4]
a5: $ G , c = scat n s ⇒ c = scat n s $ by ax
a6: $ G , c = scat n s ⇒ scat n s = c $ by eq_sym [a5]
a7: $ G , c = scat n s ⇒ scat n s ∈ fseq A $ by scat_fseq [a3, a4]
a8: $ G , c = scat n s ⇒ c ∈ fseq A $ by wcel_eq_l [a6, a7]
a9: $ G , c = scat n s ⇒ c ∊ fseq A $ by wcel_welc [a8]
b1: $ G , c = scat n s ⇒ scat (ssnoc q x) c = scat q (scons x c) $ by i7_scat_snoc [a1, a2, a9]
b2: $ G , c = scat n s ⇒ scat (scons x n) s = scons x (scat n s) $ by scat_scons [a3, a4]
b3a: $ G , c = scat n s ⇒ x = x $ by eq_refl
b3: $ G , c = scat n s ⇒ scons x c = scons x (scat n s) $ by scons_eq [b3a, a5]
b4: $ G , c = scat n s ⇒ scons x (scat n s) = scat (scons x n) s $ by eq_sym [b2]
b5: $ G , c = scat n s ⇒ scons x c = scat (scons x n) s $ by eq_trans [b3, b4]
b6a: $ G , c = scat n s ⇒ q = q $ by eq_refl
b6: $ G , c = scat n s ⇒ scat q (scons x c) = scat q (scat (scons x n) s) $ by scat_eq [b6a, b5]
b7a: $ G , c = scat n s ⇒ ssnoc q x = ssnoc q x $ by eq_refl
b7: $ G , c = scat n s ⇒ scat (ssnoc q x) (scat n s) = scat (ssnoc q x) c $ by scat_eq [b7a, a6]
b8: $ G , c = scat n s ⇒ scat (ssnoc q x) (scat n s) = scat q (scons x c) $ by eq_trans [b7, b1]
b9: $ G , c = scat n s ⇒ scat (ssnoc q x) (scat n s) = scat q (scat (scons x n) s) $ by eq_trans [b8, b6]
c1a: $ G ⇒ scat n s ∈ fseq A $ by scat_fseq [#3, #4]
c1: $ G ⇒ isset (scat n s) $ by wcel_isset [c1a]
c2: $ G ⇒ scat (ssnoc q x) (scat n s) = scat q (scat (scons x n) s) $ by isset_elim [c1, b9]

lemma i7_pi_c3 (G: hyps) (M: class) (u w s y k g q i a r x0 x3 x5 x6 x7 x8: set): $ G ⇒ uadm u $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ y ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ q ∊ fseq u $ > $ G ⇒ cdm q = fv nvf i $ > $ G ⇒ crn g ⊆ i7_pip u M w s $ > $ G ⇒ y = ⟨ k , g ⟩ $ > $ G ⇒ (i = x0 ∧ y = ⟨ kc_app , scons x5 (scons x6 ∅) ⟩ ∧ a = x3 ∧ r = x8 ∧ ra_pinst ⟨ kc_s , scons x0 ∅ ⟩ x5 x3 x7 ∈ lrel ∧ ra_inst x0 x7 x6 x8 ∈ lrel) → etel u (dnf u M) y w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) y w s ∈ fseq u ∧ dt u M r w (scat q s) = dt u M a w (scat q (scat (sarg u (dnf u M) y w s) s)) $
