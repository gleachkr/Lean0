f3: $ G ⇒ t1 ∊ i5_pip u M w s $ by subset_elim [t9, f2]
f4: $ G ⇒ dt u M t3 w s = ipi u (dsh u M s) t1 t2 w $ by i5_pip_e [f3, #3, #1, #4]

def i5_lap (U M W S: class) (.y .b .t: set): class = $ {y | y ∊ ofsort lsig lopen ks_ctx → ∀ b ∀ t (⟨ kr_lams , scons y (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt U M t W S = ilam U (dsh U M S) y b W)} $

lemma i5_lap_e (G: hyps) (M: class) (u w s x c d: set): $ G ⇒ x ∊ i5_lap u M w s $ > $ G ⇒ x ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ra_lams x c d ∈ lrel $ > $ G ⇒ c ∊ trees ω $ > $ G ⇒ dt u M d w s = ilam u (dsh u M s) x c w $
----
l1: $ G ⇒ x ∊ ofsort lsig lopen ks_ctx → ∀ b ∀ t (⟨ kr_lams , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w) $ by cab_elim [#1]
l2: $ G ⇒ ∀ b ∀ t (⟨ kr_lams , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w) $ by imp_elim [l1, #2]
l3: $ G ⇒ ∀ t (⟨ kr_lams , scons x (scons c (scons t ∅)) ⟩ ∈ lrel → c ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x c w) $ by all_elim [l2]
l4: $ G ⇒ ⟨ kr_lams , scons x (scons c (scons d ∅)) ⟩ ∈ lrel → c ∊ trees ω → dt u M d w s = ilam u (dsh u M s) x c w $ by all_elim [l3]
l5: $ G ⇒ c ∊ trees ω → dt u M d w s = ilam u (dsh u M s) x c w $ by imp_elim [l4, #3]
l6: $ G ⇒ dt u M d w s = ilam u (dsh u M s) x c w $ by imp_elim [l5, #4]

lemma i5_lap_i {b t: set} (G: hyps) (M: class) (u w s x: set): $ G , x ∊ ofsort lsig lopen ks_ctx , ra_lams x b t ∈ lrel , b ∊ trees ω ⇒ dt u M t w s = ilam u (dsh u M s) x b w $ > $ G ⇒ x ∊ i5_lap u M w s $
----
l1: $ G , x ∊ ofsort lsig lopen ks_ctx , ra_lams x b t ∈ lrel ⇒ b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w $ by imp_intro [#1]
l2: $ G , x ∊ ofsort lsig lopen ks_ctx ⇒ ⟨ kr_lams , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w $ by imp_intro [l1]
l3: $ G , x ∊ ofsort lsig lopen ks_ctx ⇒ ∀ t (⟨ kr_lams , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w) $ by all_intro [l2]
l4: $ G , x ∊ ofsort lsig lopen ks_ctx ⇒ ∀ b ∀ t (⟨ kr_lams , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w) $ by all_intro [l3]
l5: $ G ⇒ x ∊ ofsort lsig lopen ks_ctx → ∀ b ∀ t (⟨ kr_lams , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ilam u (dsh u M s) x b w) $ by imp_intro [l4]
l6: $ G ⇒ x ∊ i5_lap u M w s $ by cab_intro [l5]

lemma i5_lams_nil (H: hyps) (M: class) (u w s z c d b: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M d w s = ilam u (dsh u M s) z c w $
----
a1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b $ by ax
a2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [a1]
a3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ c = b ∧ d = b $ by and_elim_r [a1]
a4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ c = b $ by and_elim_l [a3]
a5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ d = b $ by and_elim_r [a3]
a6: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ b = c $ by eq_sym [a4]
a7: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ d = c $ by eq_trans [a5, a6]
