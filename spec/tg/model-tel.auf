p1: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by imp_elim [o0, c1]
p2: $ G ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $ by wcel_elim [#1, p1]

--| i7: the property of the induction for `lrel_pinst_sem` (over the spine `z`).
def i7_pip (U M W S: class) (.z .i .a .r .q: set): class = $ {z | z ∊ ofsort lsig lopen ks_expr → ∀ i ∀ a ∀ r ∀ q (ra_pinst i z a r ∈ lrel → q ∊ fseq U → cdm q = fv nvf i → etel U (dnf U M) z W S = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg U (dnf U M) z W S ⟩ ⟩ ⟩ ∧ sarg U (dnf U M) z W S ∈ fseq U ∧ dt U M r W (scat q S) = dt U M a W (scat q (scat (sarg U (dnf U M) z W S) S)))} $

lemma i7_pi_head (G: hyps) (M K S0: class) (u w s y q a r: set): $ G ⇒ K ∈ ω $ > $ G ⇒ ¬ K = kc_pi $ > $ G ⇒ ¬ K = kc_app $ > $ G ⇒ S0 ∈ fseq (trees ω) $ > $ G ⇒ ⟨ K , S0 ⟩ ∈ trees ω $ > $ G ⇒ y = ⟨ K , S0 ⟩ $ > $ G ⇒ r = a $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ etel u (dnf u M) y w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) y w s ∈ fseq u ∧ dt u M r w (scat q s) = dt u M a w (scat q (scat (sarg u (dnf u M) y w s) s)) $
----
l1: $ G ⇒ sarg u (dnf u M) ⟨ K , S0 ⟩ w s = ∅ $ by sarg_other [#5, #2, #3, #8, #9]
l2: $ G ⇒ sarg u (dnf u M) y w s = sarg u (dnf u M) ⟨ K , S0 ⟩ w s $ by i7_sarg_eq [#6]
l3: $ G ⇒ sarg u (dnf u M) y w s = ∅ $ by eq_trans [l2, l1]
l4: $ G ⇒ w ∈ lvals $ by welc_wcel [#8]
l5: $ G ⇒ s ∈ fseq u $ by welc_wcel [#9]
l6: $ G ⇒ etel u (dnf u M) ⟨ K , S0 ⟩ w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_c [#1, #4, #2, #3, l4, l5]
l7a: $ G ⇒ w = w $ by eq_refl
l7b: $ G ⇒ s = s $ by eq_refl
l7: $ G ⇒ etel u (dnf u M) y w s = etel u (dnf u M) ⟨ K , S0 ⟩ w s $ by etel_eq [#6, l7a, l7b]
l8: $ G ⇒ etel u (dnf u M) y w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [l7, l6]
l9: $ G ⇒ ∅ = sarg u (dnf u M) y w s $ by eq_sym [l3]
l10: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ $ by i7_q_eq [l9]
l11: $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ $ by csn_eq [l10]
l12: $ G ⇒ etel u (dnf u M) y w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ $ by eq_trans [l8, l11]
l13: $ G ⇒ ∅ ∈ fseq u $ by fseq_empty
l14: $ G ⇒ sarg u (dnf u M) y w s ∈ fseq u $ by wcel_eq_l [l9, l13]
l15: $ G ⇒ scat (sarg u (dnf u M) y w s) s = scat ∅ s $ by scat_eq [l3, l7b]
l16: $ G ⇒ scat ∅ s = s $ by scat_empty_l [#9]
l17: $ G ⇒ scat (sarg u (dnf u M) y w s) s = s $ by eq_trans [l15, l16]
l18a: $ G ⇒ q = q $ by eq_refl
l18: $ G ⇒ scat q (scat (sarg u (dnf u M) y w s) s) = scat q s $ by scat_eq [l18a, l17]
l19: $ G ⇒ scat q s = scat q (scat (sarg u (dnf u M) y w s) s) $ by eq_sym [l18]
l20a: $ G ⇒ u = u $ by eq_refl
l20b: $ G ⇒ M = M $ by eq_refl
l20: $ G ⇒ dt u M r w (scat q s) = dt u M a w (scat q (scat (sarg u (dnf u M) y w s) s)) $ by dt_eq [l20a, l20b, #7, l7a, l19]
l21a: $ G ⇒ sarg u (dnf u M) y w s ∈ fseq u ∧ dt u M r w (scat q s) = dt u M a w (scat q (scat (sarg u (dnf u M) y w s) s)) $ by and_intro [l14, l20]
l21: $ G ⇒ etel u (dnf u M) y w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) y w s ∈ fseq u ∧ dt u M r w (scat q s) = dt u M a w (scat q (scat (sarg u (dnf u M) y w s) s)) $ by and_intro [l12, l21a]

lemma i7_pi_c1 (G: hyps) (M: class) (u w s y q i a r x0 x1 x2 x3: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ (i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3) → etel u (dnf u M) y w s = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) y w s ⟩ ⟩ ⟩ ∧ sarg u (dnf u M) y w s ∈ fseq u ∧ dt u M r w (scat q s) = dt u M a w (scat q (scat (sarg u (dnf u M) y w s) s)) $
----
a0: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 $ by ax
p0: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ i = x0 $ by and_elim_l [a0]
p0r: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 $ by and_elim_r [a0]
p1: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ $ by and_elim_l [p0r]
p1r: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ a = x3 ∧ r = x3 $ by and_elim_r [p0r]
p2: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ a = x3 $ by and_elim_l [p1r]
p3: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ r = x3 $ by and_elim_r [p1r]
b0: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ isset ∅ $ by ax_empty
bs0: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ isset (scons x2 ∅) $ by scons_set [b0]
bs1: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ isset (scons x1 (scons x2 ∅)) $ by scons_set [bs0]
b1: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ kc_ind_ty ∈ ω $ by kc_ind_ty_omega
b2: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ isset kc_ind_ty $ by wcel_isset [b1]
b3a: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ ¬ kc_pi = kc_ind_ty $ by kc_pi_ne_ind_ty
b3: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ ¬ kc_ind_ty = kc_pi $ by ne_sym [b3a]
b4a: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ ¬ kc_app = kc_ind_ty $ by kc_app_ne_ind_ty
b4: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ ¬ kc_ind_ty = kc_app $ by ne_sym [b4a]
b5a: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ y ∊ trees ω $ by weaken [#3]
b5b: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ y ∈ trees ω $ by welc_wcel [b5a]
b5: $ G , i = x0 ∧ y = ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∧ a = x3 ∧ r = x3 ⇒ ⟨ kc_ind_ty , scons x1 (scons x2 ∅) ⟩ ∈ trees ω $ by wcel_eq_l [p1, b5b]
