lemma i5_cons_in (G: hyps) (E A P: class) (u w a c: set): $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ c ∊ esat u E P w $ > $ G ⇒ a ∊ da (fv E A) w c $ > $ G ⇒ a ∊ u $ > $ G ⇒ scons a c ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $
----
k1: $ G ⇒ esat u E P w ⊆ fseq u $ by esat_fseq
k2: $ G ⇒ c ∊ fseq u $ by subset_elim [k1, #4]
k3: $ G ⇒ scons a c ∈ fseq u $ by scons_fseq [#6, k2]
k4: $ G ⇒ isset (scons a c) $ by wcel_isset [k3]
m1: $ G , v = scons a c ⇒ v = scons a c $ by ax
m1b: $ G , v = scons a c ⇒ scons a c = v $ by eq_sym [m1]
m2: $ G , v = scons a c ⇒ scons a c ∈ fseq u $ by weaken [k3]
m3: $ G , v = scons a c ⇒ v ∈ fseq u $ by wcel_eq_l [m1b, m2]
m4: $ G , v = scons a c ⇒ v ∊ fseq u $ by wcel_welc [m3]
m5a: $ G , v = scons a c ⇒ c ∊ esat u E P w $ by weaken [#4]
m5b: $ G , v = scons a c ⇒ a ∊ da (fv E A) w c $ by weaken [#5]
m5c: $ G , v = scons a c ⇒ a ∊ da (fv E A) w c ∧ v = scons a c $ by and_intro [m5b, m1]
m5: $ G , v = scons a c ⇒ c ∊ esat u E P w ∧ a ∊ da (fv E A) w c ∧ v = scons a c $ by and_intro [m5a, m5c]
m6: $ G , v = scons a c ⇒ ∃ q (q ∊ esat u E P w ∧ a ∊ da (fv E A) w q ∧ v = scons a q) $ by ex_intro [m5]
m7: $ G , v = scons a c ⇒ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ v = scons x q) $ by ex_intro [m6]
m8: $ G , v = scons a c ⇒ v ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ v = scons x q) $ by and_intro [m4, m7]
m9: $ G , v = scons a c ⇒ v ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by cab_intro [m8]
m10a: $ G , v = scons a c ⇒ A ∈ trees ω $ by weaken [#1]
m10b: $ G , v = scons a c ⇒ P ∈ trees ω $ by weaken [#2]
m10c: $ G , v = scons a c ⇒ w ∊ lvals $ by weaken [#3]
m10: $ G , v = scons a c ⇒ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by esat_cons [m10a, m10b, m10c]
m11: $ G , v = scons a c ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} = esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by eq_sym [m10]
m12: $ G , v = scons a c ⇒ v ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by welc_eq [m11, m9]
m13: $ G , v = scons a c ⇒ v ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by welc_wcel [m12]
m14: $ G , v = scons a c ⇒ scons a c ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by wcel_eq_l [m1, m13]
n1: $ G ⇒ scons a c ∈ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by isset_elim [k4, m14]

lemma i5_cons_el {x q: set} (G H: hyps) (E A P: class) (u w e: set) (d: fml): $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ e ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ > $ H , q ∊ esat u E P w , x ∊ da (fv E A) w q , e = scons x q ⇒ d $ > $ G , H ⇒ d $
----
k1: $ G ⇒ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by esat_cons [#1, #2, #3]
k2: $ G ⇒ e ∊ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ r = scons x q)} $ by welc_eq [k1, #4]
k3: $ G ⇒ e ∊ fseq u ∧ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q) $ by cab_elim [k2]
k4: $ G ⇒ ∃ x ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q) $ by and_elim_r [k3]
h1: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q $ by ax
h2: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ q ∊ esat u E P w $ by and_elim_l [h1]
h3: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ x ∊ da (fv E A) w q ∧ e = scons x q $ by and_elim_r [h1]
h4: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ x ∊ da (fv E A) w q $ by and_elim_l [h3]
h5: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ e = scons x q $ by and_elim_r [h3]
i1: $ H , q ∊ esat u E P w , x ∊ da (fv E A) w q ⇒ e = scons x q → d $ by imp_intro [#5]
i2: $ H , q ∊ esat u E P w ⇒ x ∊ da (fv E A) w q → e = scons x q → d $ by imp_intro [i1]
i3: $ H ⇒ q ∊ esat u E P w → x ∊ da (fv E A) w q → e = scons x q → d $ by imp_intro [i2]
i4: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ q ∊ esat u E P w → x ∊ da (fv E A) w q → e = scons x q → d $ by weaken [i3]
i5: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ x ∊ da (fv E A) w q → e = scons x q → d $ by imp_elim [i4, h2]
i6: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ e = scons x q → d $ by imp_elim [i5, h4]
i7: $ H , q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q ⇒ d $ by imp_elim [i6, h5]
e0: $ H , ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q) ⇒ ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q) $ by ax
e1: $ H , ∃ q (q ∊ esat u E P w ∧ x ∊ da (fv E A) w q ∧ e = scons x q) ⇒ d $ by ex_elim [e0, i7]
e2: $ G , H ⇒ d $ by ex_elim [k4, e1]

lemma i5_pts_fw {y p z: set} (G: hyps) (E A P: class) (u w f: set): $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ f ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ > $ G ⇒ f ⊆ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $
----
a0: $ G , c ∊ f ⇒ c ∊ f $ by ax
a0b: $ G , c ∊ f ⇒ f ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ by weaken [#4]
a1: $ G , c ∊ f ⇒ c ∊ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ by subset_elim [a0b, a0]
a2: $ G , c ∊ f ⇒ ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z) $ by cab_elim [a1]
b1: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z $ by ax
b2: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by and_elim_l [b1]
b3: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ c = nest p z $ by and_elim_r [b1]
b4: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ A ∈ trees ω $ by weaken [#1]
b5: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ P ∈ trees ω $ by weaken [#2]
b6: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ w ∊ lvals $ by weaken [#3]
c1: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c = nest p z $ by weaken [b3]
c2: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ p = scons x q $ by ax
c3: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z = z $ by eq_refl
c4: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest p z = nest (scons x q) z $ by nest_eq [c2, c3]
c5a: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ esat u E P w ⊆ fseq u $ by esat_fseq
c5b: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∊ esat u E P w $ by ax
c5: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ q ∊ fseq u $ by subset_elim [c5a, c5b]
c6: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ isset z $ by isset_var
c7: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest (scons x q) z = nest q ⟨ x , z ⟩ $ by nest_scons [c5, c6]
c8a: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c = nest (scons x q) z $ by eq_trans [c1, c4]
c8: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c = nest q ⟨ x , z ⟩ $ by eq_trans [c8a, c7]
c9a: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ isset x $ by isset_var
c9: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ isset ⟨ x , z ⟩ $ by opair_set_l [c9a]
d1: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ v = ⟨ x , z ⟩ $ by ax
d2: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ ⟨ x , z ⟩ = v $ by eq_sym [d1]
d3: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ q = q $ by eq_refl
d4: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ nest q ⟨ x , z ⟩ = nest q v $ by nest_eq [d3, d2]
d5a: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ c = nest q ⟨ x , z ⟩ $ by weaken [c8]
d5: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ c = nest q v $ by eq_trans [d5a, d4]
d6a: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ q ∊ esat u E P w $ by ax
d6: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ q ∊ esat u E P w ∧ c = nest q v $ by and_intro [d6a, d5]
d7: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ ∃ z (q ∊ esat u E P w ∧ c = nest q z) $ by ex_intro [d6]
d8: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ ∃ p ∃ z (p ∊ esat u E P w ∧ c = nest p z) $ by ex_intro [d7]
d9: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q , v = ⟨ x , z ⟩ ⇒ c ∊ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $ by cab_intro [d8]
d10: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ c ∊ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $ by isset_elim [c9, d9]
e1: $ G , c ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z ⇒ c ∊ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $ by i5_cons_el [b4, b5, b6, b2, d10]
e2a: $ G , c ∊ f , ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z) ⇒ ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z) $ by ax
e2: $ G , c ∊ f , ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ c = nest p z) ⇒ c ∊ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $ by ex_elim [e2a, e1]
e3: $ G , c ∊ f ⇒ c ∊ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $ by ex_elim [a2, e2]
e4: $ G ⇒ f ⊆ {y | ∃ p ∃ z (p ∊ esat u E P w ∧ y = nest p z)} $ by subset_intro [e3]

lemma i5_apn_fw {y p z: set} (G: hyps) (E A P: class) (u w f g: set): $ G ⇒ A ∈ trees ω $ > $ G ⇒ P ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ f ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ > $ G ⇒ g ∊ esat u E P w $ > $ G ⇒ apn f g = clam y (da (fv E A) w g) (apn f (scons y g)) $
----
g1: $ G ⇒ esat u E P w ⊆ fseq u $ by esat_fseq
g2: $ G ⇒ g ∊ fseq u $ by subset_elim [g1, #5]
g3: $ G ⇒ g ∈ fseq u $ by welc_wcel [g2]
a1: $ G , e ∊ apn f g ⇒ e ∊ apn f g $ by ax
a1b: $ G , e ∊ apn f g ⇒ e ∈ apn f g $ by welc_wcel [a1]
a2: $ G , e ∊ apn f g ⇒ isset e $ by isset_var
a3: $ G , e ∊ apn f g ⇒ e ∈ apn f g ↔ nest g e ∈ f $ by apn_wcel [a2]
a4: $ G , e ∊ apn f g ⇒ nest g e ∈ f $ by bi_elim_l [a3, a1b]
b0: $ G , e ∊ apn f g , v = nest g e , v ∊ f ⇒ v ∊ f $ by ax
b0b: $ G , e ∊ apn f g , v = nest g e , v ∊ f ⇒ f ⊆ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ by weaken [#4]
b1: $ G , e ∊ apn f g , v = nest g e , v ∊ f ⇒ v ∊ {y | ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ y = nest p z)} $ by subset_elim [b0b, b0]
b2: $ G , e ∊ apn f g , v = nest g e , v ∊ f ⇒ ∃ p ∃ z (p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z) $ by cab_elim [b1]
b3: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z ⇒ p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z $ by ax
b4: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z ⇒ p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w $ by and_elim_l [b3]
b5: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z ⇒ v = nest p z $ by and_elim_r [b3]
b6: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z ⇒ A ∈ trees ω $ by weaken [#1]
b7: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z ⇒ P ∈ trees ω $ by weaken [#2]
b8: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z ⇒ w ∊ lvals $ by weaken [#3]
