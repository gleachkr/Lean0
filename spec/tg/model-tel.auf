t1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_ecp u M w , z = ⟨ k , j ⟩ ⇒ z ∊ i8_ecp u M w $ by i8_ecp_i [s5]
t2a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_ecp u M w , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
t2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_ecp u M w , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ i8_ecp u M w $ by wcel_intro [t2a, t1]
t3a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_ecp u M w ⇒ isset ⟨ k , j ⟩ $ by opair_isset
t3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_ecp u M w ⇒ ⟨ k , j ⟩ ∈ i8_ecp u M w $ by isset_elim [t3a, t2]
t4: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ i8_ecp u M w → ⟨ k , j ⟩ ∈ i8_ecp u M w $ by imp_intro [t3]
t5: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ i8_ecp u M w → ⟨ k , j ⟩ ∈ i8_ecp u M w $ by imp_intro [t4]
t6: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i8_ecp u M w → ⟨ k , j ⟩ ∈ i8_ecp u M w $ by imp_intro [t5]
t7: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i8_ecp u M w → ⟨ k , j ⟩ ∈ i8_ecp u M w) $ by all_intro [t6]
t8: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i8_ecp u M w → ⟨ k , j ⟩ ∈ i8_ecp u M w) $ by all_intro [t7]
t9a: $ G ⇒ isset ω $ by omega_set
t9: $ G ⇒ trees ω ⊆ i8_ecp u M w $ by trees_ind_c [t9a, t8]
f4: $ G ⇒ t2 ∊ i8_ecp u M w $ by subset_elim [t9, #2]
f5: $ G ⇒ etel u (dnf u M) t2 w r = etel u (dnf u M) t2 w r2 $ by i8_ecp_e [f4, #1, #4, #5, #6]

--| The trees `y` with `iargs K m X y` for no `m`, or with paths (values) that follow `X`'s.
def i8_iae (U M W K X R R2: class) (.y .m: set): class = $ {y | ∀ m (ra_iargs K m X y ∈ lrel → etel U (dnf U M) y W R = etel U (dnf U M) y W R2)} $

lemma i8_iae_step {i: set} (G: hyps i) (M: class) (u w r r2 t1 t3 z k j x1 x2 x3 x4 x5: set): $ G ⇒ crn j ⊆ i8_iae u M w t1 t3 r r2 $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ t1 = x1 $ > $ G ⇒ t3 = x3 $ > $ G ⇒ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ $ > $ G ⇒ ra_iargs x1 x2 x3 x4 ∈ lrel $ > $ G ⇒ ra_closed x1 x5 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf t1 → fv r i = fv r2 i) $ > $ G ⇒ etel u (dnf u M) z w r = etel u (dnf u M) z w r2 $
----
a0: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
a1: $ G ⇒ isset kc_app $ by wcel_isset [a0]
a2a: $ G ⇒ isset ∅ $ by ax_empty
a2b: $ G ⇒ isset (scons x5 ∅) $ by scons_set [a2a]
a2: $ G ⇒ isset (scons x4 (scons x5 ∅)) $ by scons_set [a2b]
a3: $ G ⇒ crn (scons x4 (scons x5 ∅)) ⊆ i8_iae u M w t1 t3 r r2 $ by i8_ch [#1, #2, #5, a1, a2]
a4a: $ G ⇒ isset x4 $ by isset_var
a4b: $ G ⇒ x4 ∈ i8_iae u M w t1 t3 r r2 $ by crn_scons_head [a4a, a3]
a4: $ G ⇒ x4 ∊ i8_iae u M w t1 t3 r r2 $ by wcel_welc [a4b]
a5: $ G ⇒ ∀ m (ra_iargs t1 m t3 x4 ∈ lrel → etel u (dnf u M) x4 w r = etel u (dnf u M) x4 w r2) $ by cab_elim [a4]
a6: $ G ⇒ ra_iargs t1 x2 t3 x4 ∈ lrel → etel u (dnf u M) x4 w r = etel u (dnf u M) x4 w r2 $ by all_elim [a5]
b1: $ G ⇒ x1 = t1 $ by eq_sym [#3]
b2: $ G ⇒ x2 = x2 $ by eq_refl
b3: $ G ⇒ x3 = t3 $ by eq_sym [#4]
b4: $ G ⇒ x4 = x4 $ by eq_refl
b5: $ G ⇒ ra_iargs x1 x2 x3 x4 = ra_iargs t1 x2 t3 x4 $ by ra_iargs_eq [b1, b2, b3, b4]
b6: $ G ⇒ ra_iargs t1 x2 t3 x4 ∈ lrel $ by wcel_eq_l [b5, #6]
b7: $ G ⇒ etel u (dnf u M) x4 w r = etel u (dnf u M) x4 w r2 $ by imp_elim [a6, b6]
g0: $ G ⇒ nvf = nvf $ by eq_refl
g1: $ G ⇒ fv nvf t1 = fv nvf x1 $ by fv_eq [g0, #3]
g2: $ G ⇒ r = r $ by eq_refl
g3: $ G ⇒ r2 = r2 $ by eq_refl
g4: $ G ⇒ ∀ i (i ∊ fv nvf x1 → fv r i = fv r2 i) $ by i8_agr [g1, g2, g3, #11]
j1: $ _ ⇒ ∀ i (i ∊ fv nvf x1 → fv r i = fv r2 i) ↔ ∀ v (v ∊ fv nvf x1 → fv r v = fv r2 v) $ by all_alpha
j2: $ G ⇒ ∀ i (i ∊ fv nvf x1 → fv r i = fv r2 i) ↔ ∀ v (v ∊ fv nvf x1 → fv r v = fv r2 v) $ by weaken [j1]
j3: $ G ⇒ ∀ v (v ∊ fv nvf x1 → fv r v = fv r2 v) $ by bi_elim_l [j2, g4]
v1: $ G ⇒ da (fv (dnf u M) x5) w r = da (fv (dnf u M) x5) w r2 $ by lrel_closed_sem [#7, #8, #9, #10, j3]
k0a: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
k0: $ G ⇒ isset kr_closed $ by wcel_isset [k0a]
k1: $ G ⇒ x1 ∊ trees ω ∧ x5 ∊ trees ω $ by lrel_args2 [#7, k0]
k2a: $ G ⇒ x5 ∊ trees ω $ by and_elim_r [k1]
k2: $ G ⇒ x5 ∈ trees ω $ by welc_wcel [k2a]
k3a: $ G ⇒ kr_iargs ∈ ω $ by kr_iargs_omega
k3: $ G ⇒ isset kr_iargs $ by wcel_isset [k3a]
k4: $ G ⇒ x1 ∊ trees ω ∧ x2 ∊ trees ω ∧ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by lrel_args4 [#6, k3]
k5a: $ G ⇒ x2 ∊ trees ω ∧ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by and_elim_r [k4]
k5b: $ G ⇒ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by and_elim_r [k5a]
k5c: $ G ⇒ x4 ∊ trees ω $ by and_elim_r [k5b]
k5: $ G ⇒ x4 ∈ trees ω $ by welc_wcel [k5c]
r1: $ G ⇒ w = w $ by eq_refl
