c2: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ⟨ kc_nz , ∅ ⟩ = y $ by eq_sym [a5]
c3: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ e = e $ by eq_refl
