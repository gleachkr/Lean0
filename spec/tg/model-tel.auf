c3a: $ G , z = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ p = ⟨ kc_nz , ∅ ⟩ ∧ e = x1 ⇒ t1 = t1 $ by eq_refl
c3b: $ G , z = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ p = ⟨ kc_nz , ∅ ⟩ ∧ e = x1 ⇒ t2 = t2 $ by eq_refl
