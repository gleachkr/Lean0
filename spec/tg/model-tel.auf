--| `lrel_pargs_sem` for a head `t1` with one path, with no fields and the
--| arguments `A` (the statement as given fails at `pargs X d 0 X` for a `Π`
--| head, whose paths have fields).
lemma i6_pargs_sem (G: hyps) (M A V: class) (u w r t1 t2 t3 t4: set): $ G ⇒ ra_pargs t1 t2 t3 t4 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) t1 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ > $ G ⇒ A ∈ fseq V $ > $ G ⇒ etel u (dnf u M) t4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf t2) (fv nvf t3)) A ⟩ ⟩ ⟩ ∧ dt u M t4 w r = apn (dt u M t1 w r) (swin r (fv nvf t2) (fv nvf t3)) $
----
v0: $ G , x ∊ V ⇒ x = x $ by eq_refl
v1a: $ G , x ∊ V ⇒ x ∊ i6_vv $ by cab_intro [v0]
v1: $ G ⇒ V ⊆ i6_vv $ by subset_intro [v1a]
v2: $ G ⇒ fseq V ⊆ fseq i6_vv $ by fseq_mono [v1]
v3: $ G ⇒ A ∈ fseq i6_vv $ by wcel_subset [v2, #5]
p1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i6_pap u M t1 A w r ⇒ k ∊ ω $ by ax
p2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i6_pap u M t1 A w r ⇒ j ∊ fseq (trees ω) $ by ax
p3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i6_pap u M t1 A w r ⇒ crn j ⊆ i6_pap u M t1 A w r $ by ax
wp4_66: $ G , crn j ⊆ i6_pap u M t1 A w r , j ∊ fseq (trees ω) , k ∊ ω ⇒ w ∊ lvals $ by weaken [#2]
wp4_67: $ G , crn j ⊆ i6_pap u M t1 A w r , j ∊ fseq (trees ω) , k ∊ ω ⇒ r ∊ fseq u $ by weaken [#3]
wp4_68: $ G , crn j ⊆ i6_pap u M t1 A w r , j ∊ fseq (trees ω) , k ∊ ω ⇒ etel u (dnf u M) t1 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by weaken [#4]
wp4_69: $ G , crn j ⊆ i6_pap u M t1 A w r , j ∊ fseq (trees ω) , k ∊ ω ⇒ A ∈ fseq i6_vv $ by weaken [v3]
p4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i6_pap u M t1 A w r ⇒ ⟨ k , j ⟩ ∈ i6_pap u M t1 A w r $ by i6_pa_step [wp4_66, wp4_67, wp4_68, wp4_69, p1, p2, p3]
p5: $ G ⇒ trees ω ⊆ i6_pap u M t1 A w r $ by i6_tind [p4]
p6a: $ G ⇒ kr_pargs ∈ ω $ by kr_pargs_omega
p6b: $ G ⇒ isset kr_pargs $ by wcel_isset [p6a]
p6: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by lrel_args4 [#1, p6b]
p7a: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [p6]
p7b: $ G ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω $ by and_elim_r [p7a]
p7: $ G ⇒ t4 ∊ trees ω $ by and_elim_r [p7b]
p8: $ G ⇒ t4 ∊ i6_pap u M t1 A w r $ by subset_elim [p5, p7]
p9: $ G ⇒ t4 ∈ i6_pap u M t1 A w r $ by welc_wcel [p8]
p10: $ G ⇒ etel u (dnf u M) t4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf t2) (fv nvf t3)) A ⟩ ⟩ ⟩ ∧ dt u M t4 w r = apn (dt u M t1 w r) (swin r (fv nvf t2) (fv nvf t3)) $ by i6_pap_e [p9, #1]

lrel_pargs_sem
--------------
l1: $ G ⇒ etel u (dnf u M) t4 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scat (swin r (fv nvf t2) (fv nvf t3)) A ⟩ ⟩ ⟩ ∧ dt u M t4 w r = apn (dt u M t1 w r) (swin r (fv nvf t2) (fv nvf t3)) $ by i6_pargs_sem [#1, #2, #3, #4, #5]

--| i7: helpers for the clauses of `spine` at set variables, and rule cases.
lemma i7_in_l (G: hyps) (X A B: class): $ G ⇒ X ∈ A $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ A ⊆ A ∪ B $ by cun_subset_l
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

lemma i7_in_r (G: hyps) (X A B: class): $ G ⇒ X ∈ B $ > $ G ⇒ X ∈ A ∪ B $
----
l1: $ G ⇒ B ⊆ A ∪ B $ by cun_subset_r
l2: $ G ⇒ X ∈ A ∪ B $ by wcel_subset [l1, #1]

lemma i7_exi {x: set} (G: hyps) (p: fml x) (c: fml): $ G ⇒ ∀ x (p → c) $ > $ G ⇒ (∃ x p) → c $
----
l1: $ G , ∃ x p ⇒ ∃ x p $ by ax
l2: $ G , p ⇒ ∀ x (p → c) $ by weaken [#1]
l3: $ G , p ⇒ p → c $ by all_elim [l2]
l4: $ G , p ⇒ p $ by ax
l5: $ G , p ⇒ c $ by imp_elim [l3, l4]
l6: $ G , ∃ x p ⇒ c $ by ex_elim [l1, l5]
l7: $ G ⇒ (∃ x p) → c $ by imp_intro [l6]

lemma i7_or2 (G: hyps) (p q c: fml): $ G ⇒ p ∨ q $ > $ G ⇒ p → c $ > $ G ⇒ q → c $ > $ G ⇒ c $
----
l1: $ G , p ⇒ c $ by imp_use [#2]
l2: $ G , q ⇒ c $ by imp_use [#3]
l3: $ G ⇒ c $ by or_elim [#1, l1, l2]

lemma i7_lprog_spine (G: hyps) (P C: class): $ G ⇒ ⟨ P , C ⟩ ∈ pr_spine $ > $ G ⇒ P ∈ fseq latoms $ > $ G ⇒ C ∈ latoms $ > $ G ⇒ crn P ⊆ lrel $ > $ G ⇒ C ∈ lrel $
----
l1: $ G ⇒ ⟨ P , C ⟩ ∈ pr_pargs ∪ pr_spine $ by i7_in_r [#1]
l2: $ G ⇒ ⟨ P , C ⟩ ∈ (pr_pargs ∪ pr_spine) ∪ (pr_rehead ∪ (pr_has_arg ∪ pr_leaf_has)) $ by i7_in_l [l1]
l3: $ G ⇒ ⟨ P , C ⟩ ∈ ((pr_aux_of ∪ pr_pis) ∪ (pr_lams ∪ pr_tys_closed)) ∪ ((pr_pargs ∪ pr_spine) ∪ (pr_rehead ∪ (pr_has_arg ∪ pr_leaf_has))) $ by i7_in_r [l2]
l4: $ G ⇒ ⟨ P , C ⟩ ∈ (((pr_aux_of ∪ pr_pis) ∪ (pr_lams ∪ pr_tys_closed)) ∪ ((pr_pargs ∪ pr_spine) ∪ (pr_rehead ∪ (pr_has_arg ∪ pr_leaf_has)))) ∪ (((pr_pinst ∪ pr_sinst) ∪ (pr_iargs ∪ (pr_indapp ∪ pr_ipos))) ∪ ((pr_recfield ∪ pr_rst) ∪ (pr_nst_hit ∪ (pr_spz ∪ pr_spz_ctors)))) $ by i7_in_l [l3]
l5: $ G ⇒ ⟨ P , C ⟩ ∈ ((((pr_aux_of ∪ pr_pis) ∪ (pr_lams ∪ pr_tys_closed)) ∪ ((pr_pargs ∪ pr_spine) ∪ (pr_rehead ∪ (pr_has_arg ∪ pr_leaf_has)))) ∪ (((pr_pinst ∪ pr_sinst) ∪ (pr_iargs ∪ (pr_indapp ∪ pr_ipos))) ∪ ((pr_recfield ∪ pr_rst) ∪ (pr_nst_hit ∪ (pr_spz ∪ pr_spz_ctors))))) ∪ ((((pr_aux_data ∪ pr_mty) ∪ (pr_motives ∪ pr_ihty)) ∪ ((pr_mwalk ∪ pr_cminors) ∪ (pr_minors ∪ (pr_rtail ∪ pr_rec_ty)))) ∪ (((pr_ihval ∪ pr_rwalk) ∪ (pr_rec_rhs ∪ (pr_rec_rule ∪ pr_struct_like))) ∪ ((pr_field_ty ∪ pr_qinst) ∪ (pr_nonrec ∪ (pr_eta_ok ∪ pr_projs))))) $ by i7_in_l [l4]
l6: $ G ⇒ ⟨ P , C ⟩ ∈ (((((pr_le ∪ pr_add) ∪ (pr_lnth ∪ pr_linst)) ∪ ((pr_lsubst ∪ pr_closed) ∪ (pr_lift ∪ (pr_inst ∪ pr_lookup)))) ∪ (((pr_cinst ∪ pr_cext) ∪ (pr_clen ∪ pr_cnth)) ∪ ((pr_capp ∪ pr_bsucc) ∪ (pr_bdbl ∪ (pr_badd ∪ pr_baddc))))) ∪ ((((pr_bmul ∪ pr_bpow) ∪ (pr_band ∪ pr_bor)) ∪ ((pr_bxor ∪ pr_ind_data) ∪ (pr_ind_nested ∪ (pr_nth_ty ∪ pr_nth_ctor)))) ∪ (((pr_clen_c ∪ pr_ntys) ∪ (pr_minor_idx ∪ (pr_npis ∪ pr_nth_pi))) ∪ ((pr_isort ∪ pr_ind_arity) ∪ (pr_nidx ∪ (pr_nfields ∪ pr_ndecl)))))) ∪ (((((pr_aux_of ∪ pr_pis) ∪ (pr_lams ∪ pr_tys_closed)) ∪ ((pr_pargs ∪ pr_spine) ∪ (pr_rehead ∪ (pr_has_arg ∪ pr_leaf_has)))) ∪ (((pr_pinst ∪ pr_sinst) ∪ (pr_iargs ∪ (pr_indapp ∪ pr_ipos))) ∪ ((pr_recfield ∪ pr_rst) ∪ (pr_nst_hit ∪ (pr_spz ∪ pr_spz_ctors))))) ∪ ((((pr_aux_data ∪ pr_mty) ∪ (pr_motives ∪ pr_ihty)) ∪ ((pr_mwalk ∪ pr_cminors) ∪ (pr_minors ∪ (pr_rtail ∪ pr_rec_ty)))) ∪ (((pr_ihval ∪ pr_rwalk) ∪ (pr_rec_rhs ∪ (pr_rec_rule ∪ pr_struct_like))) ∪ ((pr_field_ty ∪ pr_qinst) ∪ (pr_nonrec ∪ (pr_eta_ok ∪ pr_projs)))))) $ by i7_in_r [l5]
l7: $ G ⇒ ⟨ P , C ⟩ ∈ fseq latoms × latoms $ by cxp_intro_c [#2, #3]
l8: $ G ⇒ ⟨ P , C ⟩ ∈ lprog $ by wcel_cin [l6, l7]
l9: $ G ⇒ hprog lprog latoms $ by lprog_hprog
l10: $ G ⇒ isset P $ by wcel_isset [#2]
l11: $ G ⇒ isset C $ by wcel_isset [#3]
l12: $ G ⇒ C ∈ lrel $ by horn_intro_c [l9, l8, l10, l11, #4]

lemma i7_spine_z (G: hyps) (h: set): $ G ⇒ h ∊ trees ω $ > $ G ⇒ ra_spine h h ⟨ kc_nz , ∅ ⟩ ∈ lrel $
----
l1: $ G , x = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ $ by ax
l2: $ G , x = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ∃ y (x = ⟨ ∅ , ra_spine y y ⟨ kc_nz , ∅ ⟩ ⟩) $ by ex_intro [l1]
l3: $ G , x = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ x ∊ cl_spine_z $ by cab_intro [l2]
l4: $ G , x = ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ⇒ ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ∈ cl_spine_z $ by wcel_intro [l1, l3]
l5: $ G ⇒ isset ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ $ by opair_isset
l6: $ G ⇒ ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ∈ cl_spine_z $ by isset_elim [l5, l4]
l7: $ G ⇒ ⟨ ∅ , ra_spine h h ⟨ kc_nz , ∅ ⟩ ⟩ ∈ pr_spine $ by i7_in_l [l6]
l8: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l9: $ G ⇒ crn ∅ ⊆ lrel $ by crn_empty_sub
l10: $ G ⇒ enc_nat nz ∈ trees ω $ by enc_nat_trees
l11: $ G ⇒ enc_nat nz = ⟨ kc_nz , ∅ ⟩ $ by eq_refl
l12: $ G ⇒ ⟨ kc_nz , ∅ ⟩ ∈ trees ω $ by wcel_eq_l [l11, l10]
l13: $ G ⇒ h ∈ trees ω $ by welc_wcel [#1]
l14: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
l15: $ G ⇒ scons ⟨ kc_nz , ∅ ⟩ ∅ ∈ fseq (trees ω) $ by scons_fseq_c [l12, l14]
l16: $ G ⇒ scons h (scons ⟨ kc_nz , ∅ ⟩ ∅) ∈ fseq (trees ω) $ by scons_fseq_c [l13, l15]
l17: $ G ⇒ scons h (scons h (scons ⟨ kc_nz , ∅ ⟩ ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [l13, l16]
l18: $ G ⇒ kr_spine ∈ ω $ by kr_spine_omega
l19: $ G ⇒ ra_spine h h ⟨ kc_nz , ∅ ⟩ ∈ latoms $ by cxp_intro_c [l18, l17]
l20: $ G ⇒ ra_spine h h ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by i7_lprog_spine [l7, l8, l19, l9]

lemma i7_spine_s (G: hyps) (h e a k: set): $ G ⇒ h ∊ trees ω $ > $ G ⇒ e ∊ trees ω $ > $ G ⇒ a ∊ trees ω $ > $ G ⇒ k ∊ trees ω $ > $ G ⇒ ra_spine h e k ∈ lrel $ > $ G ⇒ ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ∈ lrel $
----
l1: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ $ by ax
l2: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ ∃ x8 (x = ⟨ scons (ra_spine h e x8) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons x8 ∅ ⟩ ⟩) $ by ex_intro [l1]
l3: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ ∃ x7 ∃ x8 (x = ⟨ scons (ra_spine h e x8) ∅ , ra_spine h ⟨ kc_app , scons e (scons x7 ∅) ⟩ ⟨ kc_s , scons x8 ∅ ⟩ ⟩) $ by ex_intro [l2]
l4: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ ∃ x6 ∃ x7 ∃ x8 (x = ⟨ scons (ra_spine h x6 x8) ∅ , ra_spine h ⟨ kc_app , scons x6 (scons x7 ∅) ⟩ ⟨ kc_s , scons x8 ∅ ⟩ ⟩) $ by ex_intro [l3]
l5: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ ∃ x5 ∃ x6 ∃ x7 ∃ x8 (x = ⟨ scons (ra_spine x5 x6 x8) ∅ , ra_spine x5 ⟨ kc_app , scons x6 (scons x7 ∅) ⟩ ⟨ kc_s , scons x8 ∅ ⟩ ⟩) $ by ex_intro [l4]
l6: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ x ∊ cl_spine_s $ by cab_intro [l5]
l7: $ G , x = ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ⇒ ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ∈ cl_spine_s $ by wcel_intro [l1, l6]
l8: $ G ⇒ isset ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ $ by opair_isset
l9: $ G ⇒ ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ∈ cl_spine_s $ by isset_elim [l8, l7]
l10: $ G ⇒ ⟨ scons (ra_spine h e k) ∅ , ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ⟩ ∈ pr_spine $ by i7_in_r [l9]
l11: $ G ⇒ ra_spine h e k ∈ latoms $ by lrel_latoms [#5]
l12: $ G ⇒ ∅ ∈ fseq latoms $ by fseq_empty
l13: $ G ⇒ scons (ra_spine h e k) ∅ ∈ fseq latoms $ by scons_fseq_c [l11, l12]
l14: $ G ⇒ crn ∅ ⊆ lrel $ by crn_empty_sub
l15: $ G ⇒ crn (scons (ra_spine h e k) ∅) ⊆ lrel $ by crn_scons_sub [#5, l14]
t1: $ G ⇒ h ∈ trees ω $ by welc_wcel [#1]
t2: $ G ⇒ e ∈ trees ω $ by welc_wcel [#2]
t3: $ G ⇒ a ∈ trees ω $ by welc_wcel [#3]
t4: $ G ⇒ k ∈ trees ω $ by welc_wcel [#4]
t5: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
t6: $ G ⇒ scons a ∅ ∈ fseq (trees ω) $ by scons_fseq_c [t3, t5]
t7: $ G ⇒ scons e (scons a ∅) ∈ fseq (trees ω) $ by scons_fseq_c [t2, t6]
t8: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
t9: $ G ⇒ isset ω $ by omega_set
t10: $ G ⇒ ⟨ kc_app , scons e (scons a ∅) ⟩ ∈ trees ω $ by trees_intro_c [t9, t8, t7]
t11: $ G ⇒ scons k ∅ ∈ fseq (trees ω) $ by scons_fseq_c [t4, t5]
t12: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
t13: $ G ⇒ ⟨ kc_s , scons k ∅ ⟩ ∈ trees ω $ by trees_intro_c [t9, t12, t11]
t14: $ G ⇒ scons ⟨ kc_s , scons k ∅ ⟩ ∅ ∈ fseq (trees ω) $ by scons_fseq_c [t13, t5]
t15: $ G ⇒ scons ⟨ kc_app , scons e (scons a ∅) ⟩ (scons ⟨ kc_s , scons k ∅ ⟩ ∅) ∈ fseq (trees ω) $ by scons_fseq_c [t10, t14]
t16: $ G ⇒ scons h (scons ⟨ kc_app , scons e (scons a ∅) ⟩ (scons ⟨ kc_s , scons k ∅ ⟩ ∅)) ∈ fseq (trees ω) $ by scons_fseq_c [t1, t15]
t17: $ G ⇒ kr_spine ∈ ω $ by kr_spine_omega
t18: $ G ⇒ ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ∈ latoms $ by cxp_intro_c [t17, t16]
l16: $ G ⇒ ra_spine h ⟨ kc_app , scons e (scons a ∅) ⟩ ⟨ kc_s , scons k ∅ ⟩ ∈ lrel $ by i7_lprog_spine [l10, l13, t18, l15]

lemma i7_args5 (G: hyps) (K: class) (a b c d e: set): $ G ⇒ ⟨ K , scons a (scons b (scons c (scons d (scons e ∅)))) ⟩ ∈ lrel $ > $ G ⇒ isset K $ > $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω ∧ c ∊ trees ω ∧ d ∊ trees ω ∧ e ∊ trees ω $
----
l1: $ G ⇒ ⟨ K , scons a (scons b (scons c (scons d (scons e ∅)))) ⟩ ∈ latoms $ by lrel_latoms [#1]
e0: $ G ⇒ isset ∅ $ by ax_empty
e1: $ G ⇒ isset (scons e ∅) $ by scons_set [e0]
e2: $ G ⇒ isset (scons d (scons e ∅)) $ by scons_set [e1]
e3: $ G ⇒ isset (scons c (scons d (scons e ∅))) $ by scons_set [e2]
e4: $ G ⇒ isset (scons b (scons c (scons d (scons e ∅)))) $ by scons_set [e3]
e5: $ G ⇒ isset (scons a (scons b (scons c (scons d (scons e ∅))))) $ by scons_set [e4]
m1: $ G ⇒ K ∈ ω ∧ scons a (scons b (scons c (scons d (scons e ∅)))) ∈ fseq (trees ω) $ by cxp_elim_pair_c [l1, #2, e5]
m2: $ G ⇒ scons a (scons b (scons c (scons d (scons e ∅)))) ∈ fseq (trees ω) $ by and_elim_r [m1]
c0: $ G ⇒ crn (scons a (scons b (scons c (scons d (scons e ∅))))) ⊆ trees ω $ by fseq_crn_c [m2]
s0: $ G ⇒ isset a $ by isset_var
h0: $ G ⇒ a ∈ trees ω $ by crn_scons_head [s0, c0]
w0: $ G ⇒ a ∊ trees ω $ by wcel_welc [h0]
c1: $ G ⇒ crn (scons b (scons c (scons d (scons e ∅)))) ⊆ trees ω $ by crn_scons_tail [c0]
s1: $ G ⇒ isset b $ by isset_var
h1: $ G ⇒ b ∈ trees ω $ by crn_scons_head [s1, c1]
w1: $ G ⇒ b ∊ trees ω $ by wcel_welc [h1]
c2: $ G ⇒ crn (scons c (scons d (scons e ∅))) ⊆ trees ω $ by crn_scons_tail [c1]
s2: $ G ⇒ isset c $ by isset_var
h2: $ G ⇒ c ∈ trees ω $ by crn_scons_head [s2, c2]
w2: $ G ⇒ c ∊ trees ω $ by wcel_welc [h2]
c3: $ G ⇒ crn (scons d (scons e ∅)) ⊆ trees ω $ by crn_scons_tail [c2]
s3: $ G ⇒ isset d $ by isset_var
h3: $ G ⇒ d ∈ trees ω $ by crn_scons_head [s3, c3]
w3: $ G ⇒ d ∊ trees ω $ by wcel_welc [h3]
c4: $ G ⇒ crn (scons e ∅) ⊆ trees ω $ by crn_scons_tail [c3]
s4: $ G ⇒ isset e $ by isset_var
h4: $ G ⇒ e ∈ trees ω $ by crn_scons_head [s4, c4]
w4: $ G ⇒ e ∊ trees ω $ by wcel_welc [h4]
a4: $ G ⇒ d ∊ trees ω ∧ e ∊ trees ω $ by and_intro [w3, w4]
a3: $ G ⇒ c ∊ trees ω ∧ d ∊ trees ω ∧ e ∊ trees ω $ by and_intro [w2, a4]
a2: $ G ⇒ b ∊ trees ω ∧ c ∊ trees ω ∧ d ∊ trees ω ∧ e ∊ trees ω $ by and_intro [w1, a3]
a1: $ G ⇒ a ∊ trees ω ∧ b ∊ trees ω ∧ c ∊ trees ω ∧ d ∊ trees ω ∧ e ∊ trees ω $ by and_intro [w0, a2]

lemma i7_rh_args (G: hyps) (t1 t2 t3 t4 t5: set): $ G ⇒ ra_rehead t1 t2 t3 t4 t5 ∈ lrel $ > $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $
----
l1: $ G ⇒ kr_rehead ∈ ω $ by kr_rehead_omega
l2: $ G ⇒ isset kr_rehead $ by wcel_isset [l1]
l3: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by i7_args5 [#1, l2]

--| The property of the induction for `lrel_rehead_spine`.
def i7_rsp (A B: class) (.z .e .f: set): class = $ {z | ∀ e ∀ f (ra_rehead A B z e f ∈ lrel → ra_spine A e z ∈ lrel ∧ ra_spine B f z ∈ lrel)} $

lemma i7_rs_c1 (G: hyps) (t1 t2 y e f x4 x5: set): $ G ⇒ ra_rehead t1 t2 y e f ∈ lrel $ > $ G ⇒ (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $
----
a0: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 $ by ax
a1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t1 = x4 $ by and_elim_l [a0]
a2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 $ by and_elim_r [a0]
a3: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t2 = x5 $ by and_elim_l [a2]
a4: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 $ by and_elim_r [a2]
a5: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ y = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [a4]
a6: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ e = x4 ∧ f = x5 $ by and_elim_r [a4]
a7: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ e = x4 $ by and_elim_l [a6]
a8: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ f = x5 $ by and_elim_r [a6]
b0: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_rehead t1 t2 y e f ∈ lrel $ by weaken [#1]
b1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ y ∊ trees ω ∧ e ∊ trees ω ∧ f ∊ trees ω $ by i7_rh_args [b0]
b2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t1 ∊ trees ω $ by and_elim_l [b1]
b3: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t2 ∊ trees ω ∧ y ∊ trees ω ∧ e ∊ trees ω ∧ f ∊ trees ω $ by and_elim_r [b1]
b4: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t2 ∊ trees ω $ by and_elim_l [b3]
c1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t1 t1 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by i7_spine_z [b2]
c2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t2 t2 ⟨ kc_nz , ∅ ⟩ ∈ lrel $ by i7_spine_z [b4]
d1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ x4 = e $ by eq_sym [a7]
d2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t1 = e $ by eq_trans [a1, d1]
d3: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ x5 = f $ by eq_sym [a8]
d4: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t2 = f $ by eq_trans [a3, d3]
d5: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ⟨ kc_nz , ∅ ⟩ = y $ by eq_sym [a5]
d6: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t1 = t1 $ by eq_refl
d7: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ t2 = t2 $ by eq_refl
e1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t1 t1 ⟨ kc_nz , ∅ ⟩ = ra_spine t1 e y $ by ra_spine_eq [d6, d2, d5]
e2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t2 t2 ⟨ kc_nz , ∅ ⟩ = ra_spine t2 f y $ by ra_spine_eq [d7, d4, d5]
e3: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t1 e y ∈ lrel $ by wcel_eq_l [e1, c1]
e4: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t2 f y ∈ lrel $ by wcel_eq_l [e2, c2]
e5: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by and_intro [e3, e4]
e6: $ G ⇒ (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by imp_intro [e5]

lemma i7_rs_c2 (G: hyps) (t1 t2 k j y e f x4 x5 x6 x7 x8 x9: set): $ G ⇒ ra_rehead t1 t2 y e f ∈ lrel $ > $ G ⇒ crn j ⊆ i7_rsp t1 t2 $ > $ G ⇒ y = ⟨ k , j ⟩ $ > $ G ⇒ (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $
