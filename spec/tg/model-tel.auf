lemma i6_swin_zero_c (G: hyps) (R D N: class): $ G ⇒ N = ∅ $ > $ G ⇒ swin R D N = ∅ $
----
l1: $ G , x ∊ swin R D N ⇒ x ∊ swin R D N $ by ax
l2: $ G , x ∊ swin R D N ⇒ ∃ i (i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩) $ by cab_elim [l1]
l3: $ G , x ∊ swin R D N , i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩ ⇒ i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩ $ by ax
l4: $ G , x ∊ swin R D N , i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩ ⇒ i ∊ N $ by and_elim_l [l3]
wl5_1: $ G , i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩ , x ∊ swin R D N ⇒ N = ∅ $ by weaken [#1]
l5: $ G , x ∊ swin R D N , i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩ ⇒ i ∊ ∅ $ by welc_eq [wl5_1, l4]
l6: $ G , x ∊ swin R D N , i ∊ N ∧ x = ⟨ i , fv R (nadd D i) ⟩ ⇒ ⊥ $ by empty_elim [l5]
l7: $ G , x ∊ swin R D N ⇒ ⊥ $ by ex_elim [l2, l6]
l8: $ G ⇒ swin R D N = ∅ $ by empty_eq_intro [l7]

lemma i6_swin_mem (G: hyps) (A B C D E F: class) (z: set): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ > $ G ⇒ z ∊ swin A C E $ > $ G ⇒ z ∊ swin B D F $
----
l1: $ G ⇒ ∃ i (i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩) $ by cab_elim [#4]
l2: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ $ by ax
l3: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ i ∊ E $ by and_elim_l [l2]
l4: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ z = ⟨ i , fv A (nadd C i) ⟩ $ by and_elim_r [l2]
wl5_2: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ E = F $ by weaken [#3]
l5: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ i ∊ F $ by welc_eq [wl5_2, l3]
l6: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ i = i $ by eq_refl
wl7_3: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ C = D $ by weaken [#2]
l7: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ nadd C i = nadd D i $ by nadd_eq [wl7_3, l6]
wl8_4: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ A = B $ by weaken [#1]
l8: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ fv A (nadd C i) = fv B (nadd D i) $ by fv_eq [wl8_4, l7]
l9: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ ⟨ i , fv A (nadd C i) ⟩ = ⟨ i , fv B (nadd D i) ⟩ $ by opair_eq [l6, l8]
l10: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ z = ⟨ i , fv B (nadd D i) ⟩ $ by eq_trans [l4, l9]
l11: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ i ∊ F ∧ z = ⟨ i , fv B (nadd D i) ⟩ $ by and_intro [l5, l10]
l12: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ ∃ i (i ∊ F ∧ z = ⟨ i , fv B (nadd D i) ⟩) $ by ex_intro [l11]
l13: $ G , i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩ ⇒ z ∊ swin B D F $ by cab_intro [l12]
l14: $ G ⇒ z ∊ swin B D F $ by ex_elim [l1, l13]

lemma i6_swin_eq (G: hyps) (A B C D E F: class): $ G ⇒ A = B $ > $ G ⇒ C = D $ > $ G ⇒ E = F $ > $ G ⇒ swin A C E = swin B D F $
----
l1: $ G , z ∊ swin A C E ⇒ z ∊ swin A C E $ by ax
wl2_5: $ G , z ∊ swin A C E ⇒ A = B $ by weaken [#1]
wl2_6: $ G , z ∊ swin A C E ⇒ C = D $ by weaken [#2]
wl2_7: $ G , z ∊ swin A C E ⇒ E = F $ by weaken [#3]
l2: $ G , z ∊ swin A C E ⇒ z ∊ swin B D F $ by i6_swin_mem [wl2_5, wl2_6, wl2_7, l1]
l3: $ G ⇒ B = A $ by eq_sym [#1]
l4: $ G ⇒ D = C $ by eq_sym [#2]
l5: $ G ⇒ F = E $ by eq_sym [#3]
l6: $ G , z ∊ swin B D F ⇒ z ∊ swin B D F $ by ax
wl7_8: $ G , z ∊ swin B D F ⇒ B = A $ by weaken [l3]
wl7_9: $ G , z ∊ swin B D F ⇒ D = C $ by weaken [l4]
wl7_10: $ G , z ∊ swin B D F ⇒ F = E $ by weaken [l5]
l7: $ G , z ∊ swin B D F ⇒ z ∊ swin A C E $ by i6_swin_mem [wl7_8, wl7_9, wl7_10, l6]
l8: $ G ⇒ swin A C E = swin B D F $ by eq_intro [l2, l7]

lemma i6_swin_vv (G: hyps) (D N: class) (r: set): $ G ⇒ N ∈ ω $ > $ G ⇒ swin r D N ∈ fseq i6_vv $
----
l1: $ G ⇒ swin r D N = cres (cgr i (fv r (nadd D i))) N $ by i6_swin_cres
l2a: $ G , i ∊ N ⇒ isset r $ by isset_var
l2b: $ G , i ∊ N ⇒ isset (fv r (nadd D i)) $ by fv_set_l [l2a]
l2: $ G , i ∊ N ⇒ fv r (nadd D i) ∈ i6_vv $ by i6_vv_i [l2b]
l3: $ G ⇒ i ∊ N → fv r (nadd D i) ∈ i6_vv $ by imp_intro [l2]
l4: $ G ⇒ ∀ i (i ∊ N → fv r (nadd D i) ∈ i6_vv) $ by all_intro [l3]
l5: $ G ⇒ fn_into (cgr i (fv r (nadd D i))) N i6_vv $ by cgr_fn_into [l4]
l6: $ G ⇒ cres (cgr i (fv r (nadd D i))) N ∈ fseq i6_vv $ by cres_fseq [#1, l5]
l7: $ G ⇒ cres (cgr i (fv r (nadd D i))) N = swin r D N $ by eq_sym [l1]
l8: $ G ⇒ swin r D N ∈ fseq i6_vv $ by wcel_eq_l [l7, l6]

lemma i6_kid1 (G: hyps) (P K B: class) (k j a: set): $ G ⇒ crn j ⊆ P $ > $ G ⇒ ⟨ k , j ⟩ = ⟨ K , scons a B ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset B $ > $ G ⇒ a ∈ P $
----
l1: $ G ⇒ isset k $ by isset_var
l2: $ G ⇒ isset j $ by isset_var
l3: $ G ⇒ isset (scons a B) $ by scons_set [#4]
l4: $ G ⇒ k = K ∧ j = scons a B $ by opair_inj_c [#2, l1, l2, #3, l3]
l5: $ G ⇒ j = scons a B $ by and_elim_r [l4]
l6: $ G ⇒ crn j = crn (scons a B) $ by crn_eq [l5]
l7: $ G ⇒ crn (scons a B) ⊆ P $ by subset_eq_l [l6, #1]
l8: $ G ⇒ isset a $ by isset_var
l9: $ G ⇒ a ∈ P $ by crn_scons_head [l8, l7]

lemma i6_scat_scons_c (G: hyps) (V X S T: class): $ G ⇒ isset X $ > $ G ⇒ S ∈ fseq V $ > $ G ⇒ T ∈ fseq V $ > $ G ⇒ scat (scons X S) T = scons X (scat S T) $
----
c1: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ x1 ∊ fseq V $ by ax
c2: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ x2 ∊ fseq V $ by ax
c3: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scat (scons x0 x1) x2 = scons x0 (scat x1 x2) $ by scat_scons [c1, c2]
c4: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ x0 = X $ by ax
c5: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ x1 = S $ by ax
c6: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ x2 = T $ by ax
c7: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scons x0 x1 = scons X S $ by scons_eq [c4, c5]
c8: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scat (scons x0 x1) x2 = scat (scons X S) T $ by scat_eq [c7, c6]
c9: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scat x1 x2 = scat S T $ by scat_eq [c5, c6]
c10: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scons x0 (scat x1 x2) = scons X (scat S T) $ by scons_eq [c4, c9]
c11a: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scat (scons X S) T = scat (scons x0 x1) x2 $ by eq_sym [c8]
c11: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scat (scons X S) T = scons x0 (scat x1 x2) $ by eq_trans [c11a, c3]
c12: $ G , x0 = X , x1 = S , x1 ∊ fseq V , x2 = T , x2 ∊ fseq V ⇒ scat (scons X S) T = scons X (scat S T) $ by eq_trans [c11, c10]
wd1_11: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ T ∈ fseq V $ by weaken [#3]
d1: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ scat (scons X S) T = scons X (scat S T) $ by wcel_elim [wd1_11, c12]
wd2_12: $ G , x0 = X ⇒ S ∈ fseq V $ by weaken [#2]
d2: $ G , x0 = X ⇒ scat (scons X S) T = scons X (scat S T) $ by wcel_elim [wd2_12, d1]
d3: $ G ⇒ scat (scons X S) T = scons X (scat S T) $ by isset_elim [#1, d2]

lemma i6_apn_scons_c (G: hyps) (V F X S: class): $ G ⇒ isset X $ > $ G ⇒ S ∈ fseq V $ > $ G ⇒ apn F (scons X S) = ap (apn F S) X $
----
c1: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ x1 ∊ fseq V $ by ax
c2: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ apn F (scons x0 x1) = ap (apn F x1) x0 $ by apn_scons [c1]
c3: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ x0 = X $ by ax
c4: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ x1 = S $ by ax
c5: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ scons x0 x1 = scons X S $ by scons_eq [c3, c4]
c6: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ F = F $ by eq_refl
c7: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ apn F (scons x0 x1) = apn F (scons X S) $ by apn_eq [c6, c5]
c8: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ apn F x1 = apn F S $ by apn_eq [c6, c4]
c9: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ ap (apn F x1) x0 = ap (apn F S) X $ by ap_eq [c8, c3]
c10a: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ apn F (scons X S) = apn F (scons x0 x1) $ by eq_sym [c7]
c10b: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ apn F (scons X S) = ap (apn F x1) x0 $ by eq_trans [c10a, c2]
c10: $ G , x0 = X , x1 = S , x1 ∊ fseq V ⇒ apn F (scons X S) = ap (apn F S) X $ by eq_trans [c10b, c9]
