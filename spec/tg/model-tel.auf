b5c0: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w = w $ by eq_refl
b1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ilam u (dsh u M s) z c w = ilam u (dsh u M s) ⟨ kc_nil , ∅ ⟩ c w $ by i5_ilam_eq [a2, b0]
b2a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w ∊ lvals $ by weaken [#1]
b2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ilam u (dsh u M s) ⟨ kc_nil , ∅ ⟩ c w = da (fv (dsh u M s) c) w ∅ $ by ilam_nil [b2a]
b3a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ isset c $ by isset_var
b3b: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ s ∊ fseq u $ by weaken [#2]
b3c: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ s ∈ fseq u $ by welc_wcel [b3b]
b3d: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w ∈ lvals $ by welc_wcel [b2a]
b3e: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ∅ ∈ fseq u $ by fseq_empty
b3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ da (fv (dsh u M s) c) w ∅ = dt u M c w (scat ∅ s) $ by dsh_da_c [b3a, b3c, b3d, b3e]
b4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ scat ∅ s = s $ by scat_empty_l [b3b]
b5a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ u = u $ by eq_refl
b5b: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ M = M $ by eq_refl
b5c: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w = w $ by eq_refl
b5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M c w (scat ∅ s) = dt u M c w s $ by dt_eq [b5a, b5b, b0, b5c, b4]
b6a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ s = s $ by eq_refl
b6: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M d w s = dt u M c w s $ by dt_eq [b5a, b5b, a7, b5c, b6a]
c1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ilam u (dsh u M s) z c w = da (fv (dsh u M s) c) w ∅ $ by eq_trans [b1, b2]
c2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ilam u (dsh u M s) z c w = dt u M c w (scat ∅ s) $ by eq_trans [c1, b3]
c3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ilam u (dsh u M s) z c w = dt u M c w s $ by eq_trans [c2, b5]
c4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M c w s = ilam u (dsh u M s) z c w $ by eq_sym [c3]
c5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M d w s = ilam u (dsh u M s) z c w $ by eq_trans [b6, c4]

lemma i5_lams_cons (H: hyps) (M: class) (u w s z c d k j a b t p: set): $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ z ∊ ofsort lsig lopen ks_ctx $ > $ H ⇒ crn j ⊆ i5_lap u M w s $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ c ∊ trees ω $ > $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ dt u M d w s = ilam u (dsh u M s) z c w $
----
