--| The trees `x` such that for every derivable `capp x b c` the valuations
--| of `c` are those of `x` over those of `b`.
def i6_cap (U M W: class) (.x .b .c .y .g .p: set): class = $ {x | ∀ b ∀ c (ra_capp x b c ∈ lrel → sat U M c W = {y | ∃ g ∃ p (g ∊ sat U M b W ∧ p ∊ esat U (dsh U M g) x W ∧ y = scat p g)})} $

lemma i6_cap_e (G: hyps) (M: class) (u w x b c: set): $ G ⇒ x ∈ i6_cap u M w $ > $ G ⇒ ra_capp x b c ∈ lrel $ > $ G ⇒ sat u M c w = i6_rr u M w x b $
----
l0: $ G ⇒ x ∊ i6_cap u M w $ by wcel_welc [#1]
l1: $ G ⇒ ∀ x2 ∀ x3 (ra_capp x x2 x3 ∈ lrel → sat u M x3 w = {y | ∃ g ∃ p (g ∊ sat u M x2 w ∧ p ∊ esat u (dsh u M g) x w ∧ y = scat p g)}) $ by cab_elim [l0]
l2: $ G ⇒ ∀ x3 (ra_capp x b x3 ∈ lrel → sat u M x3 w = {y | ∃ g ∃ p (g ∊ sat u M b w ∧ p ∊ esat u (dsh u M g) x w ∧ y = scat p g)}) $ by all_elim [l1]
l3: $ G ⇒ ra_capp x b c ∈ lrel → sat u M c w = {y | ∃ g ∃ p (g ∊ sat u M b w ∧ p ∊ esat u (dsh u M g) x w ∧ y = scat p g)} $ by all_elim [l2]
l4: $ G ⇒ sat u M c w = i6_rr u M w x b $ by imp_elim [l3, #2]

lemma i6_cap_step (G: hyps) (M: class) (u w k j: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ i6_cap u M w $ > $ G ⇒ ⟨ k , j ⟩ ∈ i6_cap u M w $
----
a1: $ G , z = ⟨ k , j ⟩ , ra_capp z x0 x1 ∈ lrel ⇒ ra_capp z x0 x1 ∈ lrel $ by ax
a2: $ G , z = ⟨ k , j ⟩ , ra_capp z x0 x1 ∈ lrel ⇒ ∃ b (z = ⟨ kc_nil , ∅ ⟩ ∧ x0 = b ∧ x1 = b) ∨ ∃ a ∃ c ∃ b ∃ d (z = ⟨ kc_cons , scons a (scons c ∅) ⟩ ∧ x0 = b ∧ x1 = ⟨ kc_cons , scons a (scons d ∅) ⟩ ∧ ra_capp c b d ∈ lrel) $ by lrel_capp_cases [a1]
b1: $ G , z = ⟨ k , j ⟩ , ra_capp z x0 x1 ∈ lrel , z = ⟨ kc_nil , ∅ ⟩ ∧ x0 = b ∧ x1 = b ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ x0 = b ∧ x1 = b $ by ax
