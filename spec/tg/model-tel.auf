br2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel $ by and_elim_r [br1]
b3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ t3 = x3 $ by and_elim_l [br2]
br3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel $ by and_elim_r [br2]
b4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ d = x4 $ by and_elim_l [br3]
br4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel $ by and_elim_r [br3]
b5: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ z = x5 $ by and_elim_l [br4]
b6: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel $ by and_elim_r [br4]
l1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ nvf = nvf $ by eq_refl
l2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ fv nvf d = fv nvf x4 $ by fv_eq [l1, b4]
l3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ fv nvf t3 = fv nvf x3 $ by fv_eq [l1, b3]
l4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ nadd (fv nvf d) (fv nvf t3) = nadd (fv nvf x4) (fv nvf x3) $ by nadd_eq [l2, l3]
l8: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ a = a $ by eq_refl
l9: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_indapp x1 x2 x3 x4 x5 x8 ∈ lrel ⇒ b = b $ by eq_refl
