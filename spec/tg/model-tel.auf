-- Proofs for model-tel.mm0.

dsh_congr
---------
g1: $ (cv t) ≐ (cv t) $ by ceqt_refl
g2: $ (cv w) ≐ (cv w) $ by ceqt_refl
g3: $ (cv r) ≐ (cv r) $ by ceqt_refl
g4: $ (scat r E) ≐ (scat r F) $ by scat_congr [g3, #3]
g5: $ (dt A C t w (scat r E)) ≐ (dt B D t w (scat r F)) $ by dt_congr [#1, #2, g1, g2, g4]
g6: $ (fseq A) ≐ (fseq B) $ by fseq_congr [#1]
g7: $ (clam r (fseq A) (dt A C t w (scat r E))) ≐ (clam r (fseq B) (dt B D t w (scat r F))) $ by clam_congr [g6, g5]
g8: $ lvals ≐ lvals $ by ceqt_refl
g9: $ (clam w lvals (clam r (fseq A) (dt A C t w (scat r E)))) ≐ (clam w lvals (clam r (fseq B) (dt B D t w (scat r F)))) $ by clam_congr [g8, g7]
g10: $ (cgr t (clam w lvals (clam r (fseq A) (dt A C t w (scat r E))))) ≐ (cgr t (clam w lvals (clam r (fseq B) (dt B D t w (scat r F))))) $ by cgr_congr [g9]

sb_c_dsh
--------
l1: $ (⟦ x / t ⟧ (cgr y (clam w lvals (clam r (fseq A) (dt A B y w (scat r C)))))) ≐ cgr y (clam w lvals (clam r (fseq (⟦ x / t ⟧ A)) (dt (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) y w (scat r (⟦ x / t ⟧ C))))) $ by ceqt_refl

ilam_congr
----------
n1: $ (esat A C E J) ≐ (esat B D F K) $ by esat_congr [#1, #2, #3, #5]
s1: $ seqt p p $ by seqt_refl
n2: $ (p ∊ esat A C E J) ⟺ (p ∊ esat B D F K) $ by welc_congr [s1, n1]
m3: $ (fv C H) ≐ (fv D I) $ by fv_congr [#2, #4]
m4: $ (cv p) ≐ (cv p) $ by ceqt_refl
m5: $ (da (fv C H) J p) ≐ (da (fv D I) K p) $ by da_congr [m3, #5, m4]
s2: $ seqt z z $ by seqt_refl
m6: $ (z ∊ da (fv C H) J p) ⟺ (z ∊ da (fv D I) K p) $ by welc_congr [s2, m5]
n3: $ (y = nest p z) ⟺ (y = nest p z) $ by iff_refl
n4: $ (z ∊ da (fv C H) J p ∧ y = nest p z) ⟺ (z ∊ da (fv D I) K p ∧ y = nest p z) $ by and_congr [m6, n3]
n5: $ (p ∊ esat A C E J ∧ z ∊ da (fv C H) J p ∧ y = nest p z) ⟺ (p ∊ esat B D F K ∧ z ∊ da (fv D I) K p ∧ y = nest p z) $ by and_congr [n2, n4]
n6: $ (∃ z (p ∊ esat A C E J ∧ z ∊ da (fv C H) J p ∧ y = nest p z)) ⟺ (∃ z (p ∊ esat B D F K ∧ z ∊ da (fv D I) K p ∧ y = nest p z)) $ by ex_congr [n5]
n7: $ (∃ p ∃ z (p ∊ esat A C E J ∧ z ∊ da (fv C H) J p ∧ y = nest p z)) ⟺ (∃ p ∃ z (p ∊ esat B D F K ∧ z ∊ da (fv D I) K p ∧ y = nest p z)) $ by ex_congr [n6]
n8: $ {y | ∃ p ∃ z (p ∊ esat A C E J ∧ z ∊ da (fv C H) J p ∧ y = nest p z)} ≐ {y | ∃ p ∃ z (p ∊ esat B D F K ∧ z ∊ da (fv D I) K p ∧ y = nest p z)} $ by cab_congr [n7]

sb_c_ilam
---------
l1: $ (⟦ x / t ⟧ {y | ∃ p ∃ z (p ∊ esat A B C E ∧ z ∊ da (fv B D) E p ∧ y = nest p z)}) ≐ {y | ∃ p ∃ z (p ∊ esat (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ E) ∧ z ∊ da (fv (⟦ x / t ⟧ B) (⟦ x / t ⟧ D)) (⟦ x / t ⟧ E) p ∧ y = nest p z)} $ by ceqt_refl

eagv_congr
----------
c1: $ (cv t) ≐ (cv t) $ by ceqt_refl
c2: $ (cv w) ≐ (cv w) $ by ceqt_refl
c3: $ (cv r) ≐ (cv r) $ by ceqt_refl
n1: $ (w ∊ lvals) ⟺ (w ∊ lvals) $ by iff_refl
s3: $ seqt r r $ by seqt_refl
f1: $ (fseq A) ≐ (fseq B) $ by fseq_congr [#1]
n2: $ (r ∊ fseq A) ⟺ (r ∊ fseq B) $ by welc_congr [s3, f1]
m1: $ (fv C t) ≐ (fv D t) $ by fv_congr [#2, c1]
m2: $ (fv E t) ≐ (fv F t) $ by fv_congr [#3, c1]
m3: $ (da (fv C t) w r) ≐ (da (fv D t) w r) $ by da_congr [m1, c2, c3]
m4: $ (da (fv E t) w r) ≐ (da (fv F t) w r) $ by da_congr [m2, c2, c3]
m5: $ (da (fv C t) w r = da (fv E t) w r) ⟺ (da (fv D t) w r = da (fv F t) w r) $ by ceq_congr [m3, m4]
m6: $ (r ∊ fseq A → da (fv C t) w r = da (fv E t) w r) ⟺ (r ∊ fseq B → da (fv D t) w r = da (fv F t) w r) $ by im_congr [n2, m5]
m7: $ (w ∊ lvals → r ∊ fseq A → da (fv C t) w r = da (fv E t) w r) ⟺ (w ∊ lvals → r ∊ fseq B → da (fv D t) w r = da (fv F t) w r) $ by im_congr [n1, m6]
m8: $ (∀ r (w ∊ lvals → r ∊ fseq A → da (fv C t) w r = da (fv E t) w r)) ⟺ (∀ r (w ∊ lvals → r ∊ fseq B → da (fv D t) w r = da (fv F t) w r)) $ by all_congr [m7]
m9: $ (∀ w ∀ r (w ∊ lvals → r ∊ fseq A → da (fv C t) w r = da (fv E t) w r)) ⟺ (∀ w ∀ r (w ∊ lvals → r ∊ fseq B → da (fv D t) w r = da (fv F t) w r)) $ by all_congr [m8]
m10: $ (∀ t ∀ w ∀ r (w ∊ lvals → r ∊ fseq A → da (fv C t) w r = da (fv E t) w r)) ⟺ (∀ t ∀ w ∀ r (w ∊ lvals → r ∊ fseq B → da (fv D t) w r = da (fv F t) w r)) $ by all_congr [m9]

sb_f_eagv
---------
l1: $ [x/t] (∀ y ∀ w ∀ r (w ∊ lvals → r ∊ fseq A → da (fv B y) w r = da (fv C y) w r)) ⟺ ∀ y ∀ w ∀ r (w ∊ lvals → r ∊ fseq (⟦ x / t ⟧ A) → da (fv (⟦ x / t ⟧ B) y) w r = da (fv (⟦ x / t ⟧ C) y) w r) $ by iff_refl

sarg_congr
----------
n1: $ (etel A C E H J) ≐ (etel B D F I K) $ by etel_congr [#1, #2, #3, #4, #5]
c1: $ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ≐ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ by ceqt_refl
n2: $ (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel A C E H J) ⟺ (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel B D F I K) $ by wcel_congr [c1, n1]
n3: $ (y ∈ a) ⟺ (y ∈ a) $ by iff_refl
n4: $ (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ y ∈ a) ⟺ (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ y ∈ a) $ by and_congr [n2, n3]
n5: $ (∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ y ∈ a)) ⟺ (∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ y ∈ a)) $ by ex_congr [n4]
n6: $ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel A C E H J ∧ y ∈ a)} ≐ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel B D F I K ∧ y ∈ a)} $ by cab_congr [n5]

sb_c_sarg
---------
l1: $ (⟦ x / t ⟧ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel A B C D E ∧ y ∈ a)}) ≐ {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel (⟦ x / t ⟧ A) (⟦ x / t ⟧ B) (⟦ x / t ⟧ C) (⟦ x / t ⟧ D) (⟦ x / t ⟧ E) ∧ y ∈ a)} $ by ceqt_refl

swin_congr
----------
s1: $ seqt i i $ by seqt_refl
n1: $ (i ∊ E) ⟺ (i ∊ F) $ by welc_congr [s1, #3]
c1: $ (cv i) ≐ (cv i) $ by ceqt_refl
c2: $ (cv z) ≐ (cv z) $ by ceqt_refl
m1: $ (nadd C i) ≐ (nadd D i) $ by nadd_congr [#2, c1]
m2: $ (fv A (nadd C i)) ≐ (fv B (nadd D i)) $ by fv_congr [#1, m1]
m3: $ ⟨ i , fv A (nadd C i) ⟩ ≐ ⟨ i , fv B (nadd D i) ⟩ $ by opair_congr [c1, m2]
m4: $ (z = ⟨ i , fv A (nadd C i) ⟩) ⟺ (z = ⟨ i , fv B (nadd D i) ⟩) $ by ceq_congr [c2, m3]
m5: $ (i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩) ⟺ (i ∊ F ∧ z = ⟨ i , fv B (nadd D i) ⟩) $ by and_congr [n1, m4]
m6: $ (∃ i (i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩)) ⟺ (∃ i (i ∊ F ∧ z = ⟨ i , fv B (nadd D i) ⟩)) $ by ex_congr [m5]
m7: $ {z | ∃ i (i ∊ E ∧ z = ⟨ i , fv A (nadd C i) ⟩)} ≐ {z | ∃ i (i ∊ F ∧ z = ⟨ i , fv B (nadd D i) ⟩)} $ by cab_congr [m6]

sb_c_swin
---------
l1: $ (⟦ x / t ⟧ {z | ∃ i (i ∊ C ∧ z = ⟨ i , fv A (nadd B i) ⟩)}) ≐ {z | ∃ i (i ∊ (⟦ x / t ⟧ C) ∧ z = ⟨ i , fv (⟦ x / t ⟧ A) (nadd (⟦ x / t ⟧ B) i) ⟩)} $ by ceqt_refl

dsh_da
------
i1: $ G , x ∊ lvals , q ∊ fseq u ⇒ isset (dt u M t x (scat q S)) $ by dt_set
i2: $ G , x ∊ lvals ⇒ q ∊ fseq u → isset (dt u M t x (scat q S)) $ by imp_intro [i1]
i3: $ G , x ∊ lvals ⇒ ∀ q (q ∊ fseq u → isset (dt u M t x (scat q S))) $ by all_intro [i2]
i4a: $ G , x ∊ lvals ⇒ isset u $ by isset_var
i4: $ G , x ∊ lvals ⇒ isset (fseq u) $ by fseq_set [i4a]
i5: $ G , x ∊ lvals ⇒ isset (clam q (fseq u) (dt u M t x (scat q S))) $ by clam_set [i4, i3]
i6: $ G ⇒ x ∊ lvals → isset (clam q (fseq u) (dt u M t x (scat q S))) $ by imp_intro [i5]
i7: $ G ⇒ ∀ x (x ∊ lvals → isset (clam q (fseq u) (dt u M t x (scat q S)))) $ by all_intro [i6]
i8: $ G ⇒ isset lvals $ by lvals_set
i9: $ G ⇒ isset (clam x lvals (clam q (fseq u) (dt u M t x (scat q S)))) $ by clam_set [i8, i7]
l2: $ G ⇒ fv (dsh u M S) t = clam x lvals (clam q (fseq u) (dt u M t x (scat q S))) $ by fv_cgr [i9]
l3a: $ G ⇒ w = w $ by eq_refl
l3: $ G ⇒ ap (fv (dsh u M S) t) w = ap (clam x lvals (clam q (fseq u) (dt u M t x (scat q S)))) w $ by ap_eq [l2, l3a]
l4: $ G ⇒ ap (clam x lvals (clam q (fseq u) (dt u M t x (scat q S)))) w = clam q (fseq u) (dt u M t w (scat q S)) $ by clam_ap [#2]
l5: $ G ⇒ ap (fv (dsh u M S) t) w = clam q (fseq u) (dt u M t w (scat q S)) $ by eq_trans [l3, l4]
l6a: $ G ⇒ r = r $ by eq_refl
l6: $ G ⇒ ap (ap (fv (dsh u M S) t) w) r = ap (clam q (fseq u) (dt u M t w (scat q S))) r $ by ap_eq [l5, l6a]
l7: $ G ⇒ ap (clam q (fseq u) (dt u M t w (scat q S))) r = dt u M t w (scat r S) $ by clam_ap [#3]
l8: $ G ⇒ da (fv (dsh u M S) t) w r = dt u M t w (scat r S) $ by eq_trans [l6, l7]

dsh_da_c
--------
a1: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ S ∈ fseq u $ by weaken [#2]
a2: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ w ∊ lvals $ by ax
a3: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
d1: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ da (fv (dsh u M S) t) w r = dt u M t w (scat r S) $ by dsh_da [a1, a2, a3]
e1: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ t = T $ by ax
e2: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ w = W $ by ax
e3: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ r = R $ by ax
e1s: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ T = t $ by eq_sym [e1]
e2s: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ W = w $ by eq_sym [e2]
e3s: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ R = r $ by eq_sym [e3]
r1: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dsh u M S = dsh u M S $ by eq_refl
r2: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ fv (dsh u M S) T = fv (dsh u M S) t $ by fv_eq [r1, e1s]
d2: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ da (fv (dsh u M S) T) W R = da (fv (dsh u M S) t) w r $ by da_eq [r2, e2s, e3s]
r3: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ u = u $ by eq_refl
r4: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ M = M $ by eq_refl
r5: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ S = S $ by eq_refl
r6: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ scat r S = scat R S $ by scat_eq [e3, r5]
d3: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ dt u M t w (scat r S) = dt u M T W (scat R S) $ by dt_eq [r3, r4, e1, e2, r6]
d4: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ da (fv (dsh u M S) T) W R = dt u M t w (scat r S) $ by eq_trans [d2, d1]
d5: $ G , t = T , w = W , w ∊ lvals , r = R , r ∊ fseq u ⇒ da (fv (dsh u M S) T) W R = dt u M T W (scat R S) $ by eq_trans [d4, d3]
d6: $ G , t = T , w = W , w ∊ lvals ⇒ da (fv (dsh u M S) T) W R = dt u M T W (scat R S) $ by wcel_elim [#4, d5]
d7: $ G , t = T ⇒ da (fv (dsh u M S) T) W R = dt u M T W (scat R S) $ by wcel_elim [#3, d6]
d8: $ G ⇒ da (fv (dsh u M S) T) W R = dt u M T W (scat R S) $ by isset_elim [#1, d7]

eagv_dsh_nil
------------
a1: $ G , w ∊ lvals , r ∊ fseq u ⇒ ∅ ∈ fseq u $ by fseq_empty
a2: $ G , w ∊ lvals , r ∊ fseq u ⇒ w ∊ lvals $ by ax
a3: $ G , w ∊ lvals , r ∊ fseq u ⇒ r ∊ fseq u $ by ax
d1: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv (dsh u M ∅) t) w r = dt u M t w (scat r ∅) $ by dsh_da [a1, a2, a3]
d2: $ G , w ∊ lvals , r ∊ fseq u ⇒ scat r ∅ = r $ by scat_empty_r
r1: $ G , w ∊ lvals , r ∊ fseq u ⇒ u = u $ by eq_refl
r2: $ G , w ∊ lvals , r ∊ fseq u ⇒ M = M $ by eq_refl
r3: $ G , w ∊ lvals , r ∊ fseq u ⇒ t = t $ by eq_refl
r4: $ G , w ∊ lvals , r ∊ fseq u ⇒ w = w $ by eq_refl
d3: $ G , w ∊ lvals , r ∊ fseq u ⇒ dt u M t w (scat r ∅) = dt u M t w r $ by dt_eq [r1, r2, r3, r4, d2]
d4: $ G , w ∊ lvals , r ∊ fseq u ⇒ da (fv (dsh u M ∅) t) w r = dt u M t w r $ by eq_trans [d1, d3]
d6: $ G , w ∊ lvals ⇒ r ∊ fseq u → da (fv (dsh u M ∅) t) w r = da (fv (dnf u M) t) w r $ by imp_intro [d4]
d7: $ G ⇒ w ∊ lvals → r ∊ fseq u → da (fv (dsh u M ∅) t) w r = da (fv (dnf u M) t) w r $ by imp_intro [d6]
d8: $ G ⇒ ∀ r (w ∊ lvals → r ∊ fseq u → da (fv (dsh u M ∅) t) w r = da (fv (dnf u M) t) w r) $ by all_intro [d7]
d9: $ G ⇒ ∀ w ∀ r (w ∊ lvals → r ∊ fseq u → da (fv (dsh u M ∅) t) w r = da (fv (dnf u M) t) w r) $ by all_intro [d8]
d10: $ G ⇒ ∀ t ∀ w ∀ r (w ∊ lvals → r ∊ fseq u → da (fv (dsh u M ∅) t) w r = da (fv (dnf u M) t) w r) $ by all_intro [d9]

lemma i4_eagv_at (G: hyps) (U E E2 A W R: class):
  $ G ⇒ eagv U E E2 $ > $ G ⇒ isset A $ > $ G ⇒ W ∈ lvals $ > $ G ⇒ R ∈ fseq U $ >
  $ G ⇒ da (fv E A) W R = da (fv E2 A) W R $
----
a1: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ eagv U E E2 $ by weaken [#1]
a3: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ ∀ w ∀ r (w ∊ lvals → r ∊ fseq U → da (fv E t) w r = da (fv E2 t) w r) $ by all_elim [a1]
a4: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ ∀ r (w ∊ lvals → r ∊ fseq U → da (fv E t) w r = da (fv E2 t) w r) $ by all_elim [a3]
a5: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ w ∊ lvals → r ∊ fseq U → da (fv E t) w r = da (fv E2 t) w r $ by all_elim [a4]
a6a: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ w ∊ lvals $ by ax
a6: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ r ∊ fseq U → da (fv E t) w r = da (fv E2 t) w r $ by imp_elim [a5, a6a]
a7a: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ r ∊ fseq U $ by ax
a7: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ da (fv E t) w r = da (fv E2 t) w r $ by imp_elim [a6, a7a]
e1: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ t = A $ by ax
e2: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ w = W $ by ax
e3: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ r = R $ by ax
e1s: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ A = t $ by eq_sym [e1]
e2s: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ W = w $ by eq_sym [e2]
e3s: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ R = r $ by eq_sym [e3]
r1: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ E = E $ by eq_refl
r2: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ E2 = E2 $ by eq_refl
f1: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ fv E A = fv E t $ by fv_eq [r1, e1s]
f2: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ fv E2 t = fv E2 A $ by fv_eq [r2, e1]
d1: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ da (fv E A) W R = da (fv E t) w r $ by da_eq [f1, e2s, e3s]
d2: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ da (fv E2 t) w r = da (fv E2 A) W R $ by da_eq [f2, e2, e3]
d3: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ da (fv E A) W R = da (fv E2 t) w r $ by eq_trans [d1, a7]
d4: $ G , t = A , w = W , w ∊ lvals , r = R , r ∊ fseq U ⇒ da (fv E A) W R = da (fv E2 A) W R $ by eq_trans [d3, d2]
d5: $ G , t = A , w = W , w ∊ lvals ⇒ da (fv E A) W R = da (fv E2 A) W R $ by wcel_elim [#4, d4]
d6: $ G , t = A ⇒ da (fv E A) W R = da (fv E2 A) W R $ by wcel_elim [#3, d5]
d7: $ G ⇒ da (fv E A) W R = da (fv E2 A) W R $ by isset_elim [#2, d6]

lemma i4_apcc (G: hyps) (E I W: class) (u s c q: set):
  $ G ⇒ c = ccom (esf u E) s $ > $ G ⇒ isset I $ > $ G ⇒ q ∊ ap (fv c I) W $ > $ G ⇒ q ∊ fseq u $
----
a1: $ G ⇒ ⟨ W , q ⟩ ∈ fv c I $ by ap_elim [#3]
h1: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I ⇒ h ∊ ⋃ (ap c I) $ by ax
y1: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y ⇒ y ∊ ap c I $ by ax
y2: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y ⇒ ⟨ I , y ⟩ ∈ c $ by ap_elim [y1]
y3: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y ⇒ c = ccom (esf u E) s $ by weaken [#1]
y4: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y ⇒ ⟨ I , y ⟩ ∈ ccom (esf u E) s $ by wcel_eq_r [y3, y2]
z1: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ i = I $ by ax
z2: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ I = i $ by eq_sym [z1]
z3: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ y = y $ by eq_refl
z4: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ ⟨ I , y ⟩ = ⟨ i , y ⟩ $ by opair_eq [z2, z3]
z5: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ ⟨ I , y ⟩ ∈ ccom (esf u E) s $ by weaken [y4]
z6: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ ⟨ i , y ⟩ ∈ ccom (esf u E) s $ by wcel_eq_l [z4, z5]
j1: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ ⟨ j , y ⟩ ∈ esf u E $ by ax
j2: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ functional (esf u E) $ by esf_functional
j3: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ fv (esf u E) j = y $ by fv_val [j2, j1]
j4: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ h ∊ y $ by ax
j5: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ h = ⟨ W , q ⟩ $ by ax
j6: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ ⟨ W , q ⟩ ∈ y $ by wcel_intro [j5, j4]
j7: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ y = fv (esf u E) j $ by eq_sym [j3]
j8: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ ⟨ W , q ⟩ ∈ fv (esf u E) j $ by wcel_eq_r [j7, j6]
j9: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ q ∊ ap (fv (esf u E) j) W $ by ap_intro [j8]
j10: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ esat u E j W ⊆ fseq u $ by esat_fseq
j11: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I , ⟨ i , j ⟩ ∈ s , ⟨ j , y ⟩ ∈ esf u E ⇒ q ∊ fseq u $ by subset_elim [j10, j9]
z7: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y , i = I ⇒ q ∊ fseq u $ by ccom_elim [z6, j11]
y5: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I , y ∊ ap c I , h ∊ y ⇒ q ∊ fseq u $ by isset_elim [#2, z7]
h2: $ G , h = ⟨ W , q ⟩ , h ∊ fv c I ⇒ q ∊ fseq u $ by cuni_elim [h1, y5]
a4: $ G ⇒ q ∊ fseq u $ by wcel_elim [a1, h2]

lemma i4_esq_ex {x q: set} (G: hyps) (M M2 A Q: class) (w r: set):
  $ G ⇒ ∀ q (q ∊ Q → da (fv M A) w q = da (fv M2 A) w q) $ >
  $ G ⇒ (∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $
----
p1: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q $ by ax
p2: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ Q $ by and_elim_l [p1]
p3: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M A) w q ∧ r = scons x q $ by and_elim_r [p1]
p4: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M A) w q $ by and_elim_l [p3]
p5: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ r = scons x q $ by and_elim_r [p3]
s1: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∀ q (q ∊ Q → da (fv M A) w q = da (fv M2 A) w q) $ by weaken [#1]
s2: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ Q → da (fv M A) w q = da (fv M2 A) w q $ by all_elim [s1]
s3: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ da (fv M A) w q = da (fv M2 A) w q $ by imp_elim [s2, p2]
s4: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M2 A) w q $ by welc_eq [s3, p4]
s5: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ x ∊ da (fv M2 A) w q ∧ r = scons x q $ by and_intro [s4, p5]
s6: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q $ by and_intro [p2, s5]
s7: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_intro [s6]
s8: $ G , q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_intro [s7]
s9: $ G , ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
s10: $ G , ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_elim [s9, s8]
s11: $ G , ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q) $ by ax
s12: $ G , ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q) ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by ex_elim [s11, s10]
s13: $ G ⇒ (∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)) → ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q) $ by imp_intro [s12]

lemma i4_esq_eq {r x q: set} (G: hyps) (U M M2 A Q: class) (w: set):
  $ G ⇒ ∀ q (q ∊ Q → da (fv M A) w q = da (fv M2 A) w q) $ > $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $
----
h1: $ G , q ∊ Q ⇒ ∀ q (q ∊ Q → da (fv M A) w q = da (fv M2 A) w q) $ by weaken [#1]
h2: $ G , q ∊ Q ⇒ q ∊ Q → da (fv M A) w q = da (fv M2 A) w q $ by all_elim [h1]
h3: $ G , q ∊ Q ⇒ q ∊ Q $ by ax
h4: $ G , q ∊ Q ⇒ da (fv M A) w q = da (fv M2 A) w q $ by imp_elim [h2, h3]
h5: $ G , q ∊ Q ⇒ da (fv M2 A) w q = da (fv M A) w q $ by eq_sym [h4]
h6: $ G ⇒ q ∊ Q → da (fv M2 A) w q = da (fv M A) w q $ by imp_intro [h5]
h7: $ G ⇒ ∀ q (q ∊ Q → da (fv M2 A) w q = da (fv M A) w q) $ by all_intro [h6]
a1: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} $ by ax
a2: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by cab_elim [a1]
a3: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U $ by and_elim_l [a2]
a4: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by and_elim_r [a2]
a5c: $ G ⇒ (∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by i4_esq_ex [#1]
a5: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ (∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by weaken [a5c]
a6: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by imp_elim [a5, a4]
a7: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by and_intro [a3, a6]
a8: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $ by cab_intro [a7]
b1: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $ by ax
b2: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by cab_elim [b1]
b3: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U $ by and_elim_l [b2]
b4: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q) $ by and_elim_r [b2]
b5c: $ G ⇒ (∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by i4_esq_ex [h7]
b5: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ (∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ z = scons x q)) → ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by weaken [b5c]
b6: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by imp_elim [b5, b4]
b7: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ z = scons x q) $ by and_intro [b3, b6]
b8: $ G , z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} ⇒ z ∊ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} $ by cab_intro [b7]
e1: $ G ⇒ {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M A) w q ∧ r = scons x q)} = {r | r ∊ fseq U ∧ ∃ x ∃ q (q ∊ Q ∧ x ∊ da (fv M2 A) w q ∧ r = scons x q)} $ by eq_intro [a8, b8]

lemma i4_esb_eqv (G: hyps) (E E2 K: class) (u s c: set):
  $ G ⇒ c = ccom (esf u E) s $ > $ G ⇒ eagv u E E2 $ > $ G ⇒ esb u E K s c = esb u E2 K s c $
----
k0: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ c = ccom (esf u E) s $ by weaken [#1]
k0a: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ isset ∅ $ by ax_empty
k0b: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ isset (suc ∅) $ by suc_set [k0a]
k0c: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ q ∊ ap (fv c (suc ∅)) w $ by ax
k1: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ q ∊ fseq u $ by i4_apcc [k0, k0b, k0c]
k2a: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ isset s $ by isset_var
k2: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ isset (fv s ∅) $ by fv_set_l [k2a]
k3a: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ w ∊ lvals $ by ax
k3: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ w ∈ lvals $ by welc_wcel [k3a]
k4: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ q ∈ fseq u $ by welc_wcel [k1]
k5a: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ eagv u E E2 $ by weaken [#2]
k5: $ G , w ∊ lvals , q ∊ ap (fv c (suc ∅)) w ⇒ da (fv E (fv s ∅)) w q = da (fv E2 (fv s ∅)) w q $ by i4_eagv_at [k5a, k2, k3, k4]
k6: $ G , w ∊ lvals ⇒ q ∊ ap (fv c (suc ∅)) w → da (fv E (fv s ∅)) w q = da (fv E2 (fv s ∅)) w q $ by imp_intro [k5]
k7: $ G , w ∊ lvals ⇒ ∀ q (q ∊ ap (fv c (suc ∅)) w → da (fv E (fv s ∅)) w q = da (fv E2 (fv s ∅)) w q) $ by all_intro [k6]
e1: $ G , w ∊ lvals ⇒ {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by i4_esq_eq [k7]
e2: $ G ⇒ w ∊ lvals → {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by imp_intro [e1]
e3: $ G ⇒ ∀ w (w ∊ lvals → {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by all_intro [e2]
e4: $ G ⇒ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by clam_eq_body [e3]
e5: $ G ⇒ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by eq_sym [e4]
f1: $ G , z ∊ esb u E K s c ⇒ z ∊ esb u E K s c $ by ax
f2: $ G , z ∊ esb u E K s c ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) $ by cab_elim [f1]
f3: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ K = kc_nil ∧ z ∊ clam w lvals (csn ∅) $ by ax
f4: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_nil ∧ z ∊ clam w lvals (csn ∅) ⇒ (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)}) $ by or_intro_l [f3]
f5: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by ax
f6: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ K = kc_cons $ by and_elim_l [f5]
f7: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} $ by and_elim_r [f5]
f8a: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} = clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by weaken [e4]
f8: $ G , z ∊ esb u E K s c , (K = kc_nil ∧ z ∊ clam w lvals (csn ∅)) ∨ (K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)}) , K = kc_cons ∧ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E (fv s ∅)) w q ∧ r = scons x q)} ⇒ z ∊ clam w lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv c (suc ∅)) w ∧ x ∊ da (fv E2 (fv s ∅)) w q ∧ r = scons x q)} $ by welc_eq [f8a, f7]
