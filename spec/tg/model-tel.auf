cf1: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ a (t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel) ⇒ etel u (dnf u M) t5 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w r ⟩ ⟩ ⟩ ∧ dt u M t5 w r = apn (fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w r) $ by ex_elim [cx1, cf2]
cx0: $ G , ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ a (t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel) ⇒ ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ a (t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel) $ by ax
cf0: $ G , ∃ x0 ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ a (t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel) ⇒ etel u (dnf u M) t5 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w r ⟩ ⟩ ⟩ ∧ dt u M t5 w r = apn (fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w r) $ by ex_elim [cx0, cf1]
s2: $ G ⇒ etel u (dnf u M) t5 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w r ⟩ ⟩ ⟩ ∧ dt u M t5 w r = apn (fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w r) $ by cut [s1, cf0]

lemma i8_fva_c {i: set} (G: hyps i) (K A: class) (r r2: set): $ G ⇒ ∀ i (i ∊ K → fv r i = fv r2 i) $ > $ G ⇒ A ∈ K $ > $ G ⇒ fv r A = fv r2 A $
----
a1: $ G , v = A , v ∊ K ⇒ ∀ i (i ∊ K → fv r i = fv r2 i) $ by weaken [#1]
a2: $ G , v = A , v ∊ K ⇒ v ∊ K → fv r v = fv r2 v $ by all_elim [a1]
a3: $ G , v = A , v ∊ K ⇒ v ∊ K $ by ax
a4: $ G , v = A , v ∊ K ⇒ fv r v = fv r2 v $ by imp_elim [a2, a3]
a5: $ G , v = A , v ∊ K ⇒ v = A $ by ax
a5s: $ G , v = A , v ∊ K ⇒ A = v $ by eq_sym [a5]
a6: $ G , v = A , v ∊ K ⇒ r = r $ by eq_refl
a6b: $ G , v = A , v ∊ K ⇒ r2 = r2 $ by eq_refl
a7: $ G , v = A , v ∊ K ⇒ fv r A = fv r v $ by fv_eq [a6, a5s]
a8: $ G , v = A , v ∊ K ⇒ fv r2 v = fv r2 A $ by fv_eq [a6b, a5]
a9: $ G , v = A , v ∊ K ⇒ fv r A = fv r2 v $ by eq_trans [a7, a4]
a10: $ G , v = A , v ∊ K ⇒ fv r A = fv r2 A $ by eq_trans [a9, a8]
a11: $ G ⇒ fv r A = fv r2 A $ by wcel_elim [#2, a10]

lemma i8_fvs_c {i: set} (G: hyps i) (A: class) (r r2: set): $ G ⇒ ∀ i (fv r i ⊆ fv r2 i) $ > $ G ⇒ isset A $ > $ G ⇒ fv r A ⊆ fv r2 A $
----
a1: $ G , v = A ⇒ ∀ i (fv r i ⊆ fv r2 i) $ by weaken [#1]
a2: $ G , v = A ⇒ fv r v ⊆ fv r2 v $ by all_elim [a1]
a3: $ G , v = A ⇒ v = A $ by ax
a4: $ G , v = A ⇒ r = r $ by eq_refl
a4b: $ G , v = A ⇒ r2 = r2 $ by eq_refl
a5: $ G , v = A ⇒ fv r v = fv r A $ by fv_eq [a4, a3]
a6: $ G , v = A ⇒ fv r2 v = fv r2 A $ by fv_eq [a4b, a3]
a7: $ G , v = A ⇒ fv r A ⊆ fv r2 v $ by subset_eq_l [a5, a2]
a8: $ G , v = A ⇒ fv r A ⊆ fv r2 A $ by subset_eq_r [a6, a7]
a9: $ G ⇒ fv r A ⊆ fv r2 A $ by isset_elim [#2, a8]

lemma i8_swin_sub (G: hyps) {i: set} (D N: class) (r r2: set): $ G ⇒ D ∈ ω $ > $ G ⇒ N ∈ ω $ > $ G ⇒ ∀ i (i ∊ nadd D N → fv r i = fv r2 i) $ > $ G ⇒ swin r D N ⊆ swin r2 D N $
----
a1: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ $ by ax
a2: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∊ N $ by and_elim_l [a1]
a3: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ v = ⟨ j , fv r (nadd D j) ⟩ $ by and_elim_r [a1]
b1: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∈ N $ by welc_wcel [a2]
b2: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ N ∈ ω $ by weaken [#2]
b3: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∈ ω $ by omega_elem_omega_c [b1, b2]
b4: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ D ∈ ω $ by weaken [#1]
b5: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ nadd j D ∈ nadd N D $ by nadd_mono_lt_c [b3, b2, b4, b1]
b6: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ nadd j D = nadd D j $ by nadd_comm_c [b3, b4]
b7: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ nadd N D = nadd D N $ by nadd_comm_c [b2, b4]
b8: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ nadd D j ∈ nadd N D $ by wcel_eq_l [b6, b5]
b9: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ nadd D j ∈ nadd D N $ by wcel_eq_r [b7, b8]
b9a: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ ∀ i (i ∊ nadd D N → fv r i = fv r2 i) $ by weaken [#3]
b10: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ fv r (nadd D j) = fv r2 (nadd D j) $ by i8_fva_c [b9a, b9]
b11: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ j = j $ by eq_refl
b12: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ ⟨ j , fv r (nadd D j) ⟩ = ⟨ j , fv r2 (nadd D j) ⟩ $ by opair_eq [b11, b10]
b13: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ v = ⟨ j , fv r2 (nadd D j) ⟩ $ by eq_trans [a3, b12]
c1: $ G , j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∊ N ∧ v = ⟨ j , fv r2 (nadd D j) ⟩ $ by and_intro [a2, b13]
c2: $ G ⇒ (j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩) → (j ∊ N ∧ v = ⟨ j , fv r2 (nadd D j) ⟩) $ by imp_intro [c1]
d1: $ G ⇒ ∀ j ((j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩) → (j ∊ N ∧ v = ⟨ j , fv r2 (nadd D j) ⟩)) $ by all_intro [c2]
e1a: $ G , v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} ⇒ v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} $ by ax
e1: $ G , v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} ⇒ ∃ j (j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩) $ by cab_elim [e1a]
e2a: $ G , v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} ⇒ ∀ j ((j ∊ N ∧ v = ⟨ j , fv r (nadd D j) ⟩) → (j ∊ N ∧ v = ⟨ j , fv r2 (nadd D j) ⟩)) $ by weaken [d1]
e2: $ G , v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} ⇒ ∃ j (j ∊ N ∧ v = ⟨ j , fv r2 (nadd D j) ⟩) $ by ex_mp [e2a, e1]
e3: $ G , v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} ⇒ v ∊ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r2 (nadd D j) ⟩)} $ by cab_intro [e2]
e4: $ G ⇒ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩)} ⊆ {z | ∃ j (j ∊ N ∧ z = ⟨ j , fv r2 (nadd D j) ⟩)} $ by subset_intro [e3]

lemma i8_swin_eq (G: hyps) {i: set} (D N: class) (r r2: set): $ G ⇒ D ∈ ω $ > $ G ⇒ N ∈ ω $ > $ G ⇒ ∀ i (i ∊ nadd D N → fv r i = fv r2 i) $ > $ G ⇒ swin r D N = swin r2 D N $
----
l1: $ G ⇒ swin r D N ⊆ swin r2 D N $ by i8_swin_sub [#1, #2, #3]
m1: $ G , i ∊ nadd D N ⇒ ∀ i (i ∊ nadd D N → fv r i = fv r2 i) $ by weaken [#3]
m2: $ G , i ∊ nadd D N ⇒ i ∊ nadd D N → fv r i = fv r2 i $ by all_elim [m1]
m3a: $ G , i ∊ nadd D N ⇒ i ∊ nadd D N $ by ax
m3: $ G , i ∊ nadd D N ⇒ fv r i = fv r2 i $ by imp_elim [m2, m3a]
m4: $ G , i ∊ nadd D N ⇒ fv r2 i = fv r i $ by eq_sym [m3]
m5: $ G ⇒ i ∊ nadd D N → fv r2 i = fv r i $ by imp_intro [m4]
m6: $ G ⇒ ∀ i (i ∊ nadd D N → fv r2 i = fv r i) $ by all_intro [m5]
l2: $ G ⇒ swin r2 D N ⊆ swin r D N $ by i8_swin_sub [#1, #2, m6]
l3: $ G ⇒ swin r D N = swin r2 D N $ by subset_antisym [l1, l2]

lemma i8_apn_mono (G: hyps) (F F2 S: class): $ G ⇒ F ⊆ F2 $ > $ G ⇒ apn F S ⊆ apn F2 S $
----
a1: $ G , v ∊ apn F S ⇒ v ∊ apn F S $ by ax
a2: $ G , v ∊ apn F S ⇒ v ∈ apn F S $ by welc_wcel [a1]
a3: $ G , v ∊ apn F S ⇒ isset v $ by isset_var
a4: $ G , v ∊ apn F S ⇒ v ∈ apn F S ↔ nest S v ∈ F $ by apn_wcel [a3]
a5: $ G , v ∊ apn F S ⇒ nest S v ∈ F $ by bi_elim_l [a4, a2]
a6: $ G , v ∊ apn F S ⇒ F ⊆ F2 $ by weaken [#1]
a7: $ G , v ∊ apn F S ⇒ nest S v ∈ F2 $ by wcel_subset [a6, a5]
a8: $ G , v ∊ apn F S ⇒ v ∈ apn F2 S ↔ nest S v ∈ F2 $ by apn_wcel [a3]
a9: $ G , v ∊ apn F S ⇒ v ∈ apn F2 S $ by bi_elim_r [a8, a7]
a10: $ G , v ∊ apn F S ⇒ v ∊ apn F2 S $ by wcel_welc [a9]
a11: $ G ⇒ apn F S ⊆ apn F2 S $ by subset_intro [a10]

