q11: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ etel u (dnf u M) t5 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w r ⟩ ⟩ ⟩ $ by and_elim_l [q10]
q12: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ cdm (sarg u (dnf u M) t5 w r) = fv nvf x8 ∧ dt u M t5 w r = apn (dt u M ⟨ kc_bvar , scons x6 ∅ ⟩ w r) (sarg u (dnf u M) t5 w r) $ by and_elim_r [q10]
q13: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ dt u M t5 w r = apn (dt u M ⟨ kc_bvar , scons x6 ∅ ⟩ w r) (sarg u (dnf u M) t5 w r) $ by and_elim_r [q12]
q14a: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ kr_add ∈ ω $ by kr_add_omega
q14b: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ isset kr_add $ by wcel_isset [q14a]
q14c: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x5 ∊ trees ω ∧ x4 ∊ trees ω ∧ x6 ∊ trees ω $ by lrel_args3 [cl8, q14b]
q14d: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x4 ∊ trees ω ∧ x6 ∊ trees ω $ by and_elim_r [q14c]
q14e: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x6 ∊ trees ω $ by and_elim_r [q14d]
q14: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x6 ∈ trees ω $ by welc_wcel [q14e]
q15: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ dt u M ⟨ kc_bvar , scons x6 ∅ ⟩ w r = fv r (fv nvf x6) $ by dt_bvar [q14, q9w, q9r]
q16: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x6 = nadd (fv nvf x5) (fv nvf x4) $ by lrel_add_sem [cl8]
q17: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x5 = nadd (fv nvf x3) (fv nvf x2) $ by lrel_add_sem [cl7]
q18n: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ nvf = nvf $ by eq_refl
q18a: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x3 = t4 $ by eq_sym [cl3]
q18: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x3 = fv nvf t4 $ by fv_eq [q18n, q18a]
q19a: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x2 = t3 $ by eq_sym [cl2]
q19: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x2 = fv nvf t3 $ by fv_eq [q18n, q19a]
q20a: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ x4 = t6 $ by eq_sym [cl5]
q20: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x4 = fv nvf t6 $ by fv_eq [q18n, q20a]
q21: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ nadd (fv nvf x3) (fv nvf x2) = nadd (fv nvf t4) (fv nvf t3) $ by nadd_eq [q18, q19]
q22: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x5 = nadd (fv nvf t4) (fv nvf t3) $ by eq_trans [q17, q21]
q23: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ nadd (fv nvf x5) (fv nvf x4) = nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6) $ by nadd_eq [q22, q20]
q24: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv nvf x6 = nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6) $ by eq_trans [q16, q23]
q25a: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ r = r $ by eq_refl
q25: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ fv r (fv nvf x6) = fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6)) $ by fv_eq [q25a, q24]
q26: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ dt u M ⟨ kc_bvar , scons x6 ∅ ⟩ w r = fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6)) $ by eq_trans [q15, q25]
q27a: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ sarg u (dnf u M) t5 w r = sarg u (dnf u M) t5 w r $ by eq_refl
q27: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ apn (dt u M ⟨ kc_bvar , scons x6 ∅ ⟩ w r) (sarg u (dnf u M) t5 w r) = apn (fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w r) $ by apn_eq [q26, q27a]
q28: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ dt u M t5 w r = apn (fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w r) $ by eq_trans [q13, q27]
q29: $ G , t1 = x0 ∧ t2 = x1 ∧ t3 = x2 ∧ t4 = x3 ∧ t5 = a ∧ t6 = x4 ∧ ra_spine ⟨ kc_bvar , scons x6 ∅ ⟩ a x8 ∈ lrel ∧ ra_add x3 x2 x5 ∈ lrel ∧ ra_add x5 x4 x6 ∈ lrel ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_pargs ⟨ kc_bvar , scons x6 ∅ ⟩ x3 x2 x9 ∈ lrel ∧ ra_nidx x0 x4 x7 ∈ lrel ∧ ra_iargs x5 x7 x9 a ∈ lrel ⇒ etel u (dnf u M) t5 w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) t5 w r ⟩ ⟩ ⟩ ∧ dt u M t5 w r = apn (fv r (nadd (nadd (fv nvf t4) (fv nvf t3)) (fv nvf t6))) (sarg u (dnf u M) t5 w r) $ by and_intro [q11, q28]
