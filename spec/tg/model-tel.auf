s13: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d z ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) , ∀ i (fv a i ⊆ fv b i) , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ e ∃ h (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J) ⇒ etel u (dnf u M) z w a ⊆ etel u (dnf u M) z w b $ by imp_use [s12]
s16: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d z ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) , ∀ i (fv a i ⊆ fv b i) ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ f ∃ g ∃ l ∃ n ∃ o ∃ p ∃ q ∃ t ∃ x ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J)) → etel u (dnf u M) z w a ⊆ etel u (dnf u M) z w b $ by i9_cm_c2 [s4, s5, s6, s7, s9]
s17: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d z ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) , ∀ i (fv a i ⊆ fv b i) , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ f ∃ g ∃ l ∃ n ∃ o ∃ p ∃ q ∃ t ∃ x ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = f ∧ ra_indapp x1 x2 x3 x7 f x5 ∈ lrel ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 f g ∈ lrel ∧ ra_ind_data x1 l n o ∈ lrel ∧ ra_nth_ty o x5 p q ∈ lrel ∧ ra_pis n p t ∈ lrel ∧ ra_lift x8 ⟨ kc_nz , ∅ ⟩ t x ∈ lrel ∧ ra_sty x6 ⟨ kc_ind_ty , scons x1 (scons x5 ∅) ⟩ x g y ∈ lrel3 J) ⇒ etel u (dnf u M) z w a ⊆ etel u (dnf u M) z w b $ by imp_use [s16]
s22: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ , ra_cwf t1 t2 t3 t4 t5 c d z ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) , ∀ i (fv a i ⊆ fv b i) ⇒ etel u (dnf u M) z w a ⊆ etel u (dnf u M) z w b $ by or_elim [s11, s13, s17]
s23: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ ⇒ z ∊ i9_cm u M w J t1 t2 t3 t4 t5 $ by i9_cm_i [s22]
s24: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
s25: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5 $ by wcel_intro [s24, s23]
s26: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 ⇒ isset ⟨ k , j ⟩ $ by opair_isset
s27: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 ⇒ ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5 $ by isset_elim [s26, s25]
s28: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5 $ by imp_intro [s27]
s29: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5 $ by imp_intro [s28]
s30: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5 $ by imp_intro [s29]
s31: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5) $ by all_intro [s30]
s32: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 → ⟨ k , j ⟩ ∈ i9_cm u M w J t1 t2 t3 t4 t5) $ by all_intro [s31]
s33: $ G ⇒ isset ω $ by omega_set
s34: $ G ⇒ trees ω ⊆ i9_cm u M w J t1 t2 t3 t4 t5 $ by trees_ind_c [s33, s32]
s35: $ G ⇒ t8 ∊ i9_cm u M w J t1 t2 t3 t4 t5 $ by subset_elim [s34, #3]
s36: $ G ⇒ t7 ∈ trees ω $ by welc_wcel [#2]
s37: $ G ⇒ r ∈ fseq u $ by welc_wcel [#5]
s38: $ G ⇒ r2 ∈ fseq u $ by welc_wcel [#6]
s39: $ G ⇒ isset t6 $ by isset_var
s40: $ G ⇒ etel u (dnf u M) t8 w r ⊆ etel u (dnf u M) t8 w r2 $ by i9_cm_e [s35, s39, #1, s36, s37, s38, #7, #8]

--| Inversion of `tys_wf` at a `tcons`.
lemma i9_tw_tc (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 z a b c: set): $ G ⇒ ra_tys_wf t1 t2 t3 t4 t5 t6 z ∈ lrel3 J $ > $ G ⇒ z = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ $ > $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $
----
a1: $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩)) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) $ by lrel3_tys_wf_cases [#1]
n0: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by ax
n1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t1 = x1 $ by and_elim_l [n0]
nr1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [n0]
n2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t2 = x2 $ by and_elim_l [nr1]
nr2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [nr1]
n3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t3 = x3 $ by and_elim_l [nr2]
nr3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [nr2]
n4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t4 = x4 $ by and_elim_l [nr3]
nr4: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [nr3]
n5: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t5 = x5 $ by and_elim_l [nr4]
nr5: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [nr4]
n6: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ t6 = x6 $ by and_elim_l [nr5]
n7: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ z = ⟨ kc_tnil , ∅ ⟩ $ by and_elim_r [nr5]
n8: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ⟨ kc_tnil , ∅ ⟩ = z $ by eq_sym [n7]
n9a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ z = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ $ by weaken [#2]
n9: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ⟨ kc_tnil , ∅ ⟩ = ⟨ kc_tcons , scons a (scons b (scons c ∅)) ⟩ $ by eq_trans [n8, n9a]
n10a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil ∈ ω $ by kc_tnil_omega
n10b: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ isset kc_tnil $ by wcel_isset [n10a]
n10c: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
n10d: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tcons ∈ ω $ by kc_tcons_omega
n10e: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ isset kc_tcons $ by wcel_isset [n10d]
n10f: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ isset (scons c ∅) $ by scons_set [n10c]
n10g: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ isset (scons b (scons c ∅)) $ by scons_set [n10f]
n10h: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ isset (scons a (scons b (scons c ∅))) $ by scons_set [n10g]
n11: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil = kc_tcons ∧ ∅ = scons a (scons b (scons c ∅)) $ by opair_inj_c [n9, n10b, n10c, n10e, n10h]
n12: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ kc_tnil = kc_tcons $ by and_elim_l [n11]
n13: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ¬ kc_tnil = kc_tcons $ by kc_tnil_ne_tcons
n14: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ⊥ $ by not_elim [n13, n12]
n15: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tnil , ∅ ⟩ ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $ by bot_elim [n14]
