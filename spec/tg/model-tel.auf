lemma i9_agr {i: set} (G: hyps i) (K L A B C D: class): $ G ⇒ K = L $ > $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ ∀ i (i ∊ K → fv A i = fv B i) $ > $ G ⇒ ∀ i (i ∊ L → fv C i = fv D i) $
----
l1: $ G , j ∊ L ⇒ j ∊ L $ by ax
l2a: $ G , j ∊ L ⇒ K = L $ by weaken [#1]
l2: $ G , j ∊ L ⇒ L = K $ by eq_sym [l2a]
l3: $ G , j ∊ L ⇒ j ∊ K $ by welc_eq [l2, l1]
l4a: $ G , j ∊ L ⇒ ∀ i (i ∊ K → fv A i = fv B i) $ by weaken [#4]
l4: $ G , j ∊ L ⇒ j ∊ K → fv A j = fv B j $ by all_elim [l4a]
l5: $ G , j ∊ L ⇒ fv A j = fv B j $ by imp_elim [l4, l3]
l6: $ G , j ∊ L ⇒ j = j $ by eq_refl
l7a: $ G , j ∊ L ⇒ A = C $ by weaken [#2]
l7: $ G , j ∊ L ⇒ C = A $ by eq_sym [l7a]
l8: $ G , j ∊ L ⇒ fv C j = fv A j $ by fv_eq [l7, l6]
l9a: $ G , j ∊ L ⇒ B = D $ by weaken [#3]
l9: $ G , j ∊ L ⇒ fv B j = fv D j $ by fv_eq [l9a, l6]
l10: $ G , j ∊ L ⇒ fv C j = fv B j $ by eq_trans [l8, l5]
l11: $ G , j ∊ L ⇒ fv C j = fv D j $ by eq_trans [l10, l9]
l12: $ G ⇒ j ∊ L → fv C j = fv D j $ by imp_intro [l11]
l13: $ G ⇒ ∀ j (j ∊ L → fv C j = fv D j) $ by all_intro [l12]
l14: $ _ ⇒ ∀ j (j ∊ L → fv C j = fv D j) ↔ ∀ i (i ∊ L → fv C i = fv D i) $ by all_alpha
l15: $ G ⇒ ∀ j (j ∊ L → fv C j = fv D j) ↔ ∀ i (i ∊ L → fv C i = fv D i) $ by weaken [l14]
l16: $ G ⇒ ∀ i (i ∊ L → fv C i = fv D i) $ by bi_elim_l [l15, l13]

--| The children of a node at another presentation of it (copied from model-meta).
lemma i9_ch (G: hyps) (X K S: class) (z c j: set): $ G ⇒ crn j ⊆ X $ > $ G ⇒ z = ⟨ c , j ⟩ $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ > $ G ⇒ crn S ⊆ X $
----
l1: $ G ⇒ ⟨ c , j ⟩ = z $ by eq_sym [#2]
l2: $ G ⇒ ⟨ c , j ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #3]
l3: $ G ⇒ isset c $ by isset_var
l4: $ G ⇒ isset j $ by isset_var
l5: $ G ⇒ c = K ∧ j = S $ by opair_inj_c [l2, l3, l4, #4, #5]
l6: $ G ⇒ j = S $ by and_elim_r [l5]
l7: $ G ⇒ crn j = crn S $ by crn_eq [l6]
l8: $ G ⇒ crn S ⊆ X $ by subset_eq_l [l7, #1]

lemma i9_ztree (G: hyps) (k j z: set): $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ trees ω $
----
l1: $ G ⇒ ⟨ k , j ⟩ ∈ ω × fseq (trees ω) $ by cxp_intro [#1, #2]
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l2]
l4: $ G ⇒ ⟨ k , j ⟩ ∈ trees ω $ by wcel_eq_r [l3, l1]
l5: $ G ⇒ ⟨ k , j ⟩ = z $ by eq_sym [#3]
l6: $ G ⇒ z ∈ trees ω $ by wcel_eq_l [l5, l4]
l7: $ G ⇒ z ∊ trees ω $ by wcel_welc [l6]

--| The trees `y` with, at every depth `d` of a derivable `ipos D N Q d y`, the same
--| paths at valuations that agree below `d + Q`.
def i9_pe (U M W D N Q: class) (.y .d .a .b .i: set): class = $ {y | ∀ d ∀ a ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq U → b ∊ fseq U → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel U (dnf U M) y W a = etel U (dnf U M) y W b)} $

lemma i9_pe_i {d a b i: set} (G: hyps) (M D N Q: class) (u w y: set): $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) ⇒ etel u (dnf u M) y w a = etel u (dnf u M) y w b $ > $ G ⇒ y ∊ i9_pe u M w D N Q $
----
l1: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b $ by imp_intro [#1]
l2: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u ⇒ b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b $ by imp_intro [l1]
l3: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω ⇒ a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b $ by imp_intro [l2]
l4: $ G , ra_ipos D N Q d y ∈ lrel ⇒ d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b $ by imp_intro [l3]
l5: $ G ⇒ ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b $ by imp_intro [l4]
l6: $ G ⇒ ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b) $ by all_intro [l5]
l7: $ G ⇒ ∀ a ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b) $ by all_intro [l6]
l8: $ G ⇒ ∀ d ∀ a ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b) $ by all_intro [l7]
l9: $ G ⇒ y ∊ i9_pe u M w D N Q $ by cab_intro [l8]

lemma i9_pe_e {i: set} (G: hyps i) (M D N Q Dd A B: class) (u w y: set): $ G ⇒ y ∊ i9_pe u M w D N Q $ > $ G ⇒ ra_ipos D N Q Dd y ∈ lrel $ > $ G ⇒ Dd ∈ trees ω $ > $ G ⇒ A ∈ fseq u $ > $ G ⇒ B ∈ fseq u $ > $ G ⇒ ∀ i (i ∊ nadd (fv nvf Dd) (fv nvf Q) → fv A i = fv B i) $ > $ G ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w B $
----
c1: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ y ∊ i9_pe u M w D N Q $ by weaken [#1]
c2: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ d ∀ a ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b) $ by cab_elim [c1]
c3: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ a ∀ b (ra_ipos D N Q o y ∈ lrel → o ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv a i = fv b i) → etel u (dnf u M) y w a = etel u (dnf u M) y w b) $ by all_elim [c2]
c4: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ b (ra_ipos D N Q o y ∈ lrel → o ∊ trees ω → p ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv b i) → etel u (dnf u M) y w p = etel u (dnf u M) y w b) $ by all_elim [c3]
c5: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_ipos D N Q o y ∈ lrel → o ∊ trees ω → p ∊ fseq u → q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → etel u (dnf u M) y w p = etel u (dnf u M) y w q $ by all_elim [c4]
c6: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ o = Dd $ by ax
c6b: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ Dd = o $ by eq_sym [c6]
c7a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ D = D $ by eq_refl
c7b: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ N = N $ by eq_refl
c7c: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ Q = Q $ by eq_refl
c7d: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ y = y $ by eq_refl
c8: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_ipos D N Q Dd y = ra_ipos D N Q o y $ by ra_ipos_eq [c7a, c7b, c7c, c6b, c7d]
c9: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_ipos D N Q Dd y ∈ lrel $ by weaken [#2]
c10: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_ipos D N Q o y ∈ lrel $ by wcel_eq_l [c8, c9]
c11: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ o ∊ trees ω → p ∊ fseq u → q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → etel u (dnf u M) y w p = etel u (dnf u M) y w q $ by imp_elim [c5, c10]
c12a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ o ∊ trees ω $ by ax
c12: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ p ∊ fseq u → q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → etel u (dnf u M) y w p = etel u (dnf u M) y w q $ by imp_elim [c11, c12a]
c13a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ p ∊ fseq u $ by ax
c13: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → etel u (dnf u M) y w p = etel u (dnf u M) y w q $ by imp_elim [c12, c13a]
c14a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ q ∊ fseq u $ by ax
c14: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → etel u (dnf u M) y w p = etel u (dnf u M) y w q $ by imp_elim [c13, c14a]
k1: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ nvf = nvf $ by eq_refl
k2: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ fv nvf Dd = fv nvf o $ by fv_eq [k1, c6b]
k3: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ fv nvf Q = fv nvf Q $ by eq_refl
k4: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ nadd (fv nvf Dd) (fv nvf Q) = nadd (fv nvf o) (fv nvf Q) $ by nadd_eq [k2, k3]
k5a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ p = A $ by ax
k5: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ A = p $ by eq_sym [k5a]
k6a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ q = B $ by ax
k6: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ B = q $ by eq_sym [k6a]
k7: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf Dd) (fv nvf Q) → fv A i = fv B i) $ by weaken [#6]
k8: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) $ by i9_agr [k4, k5, k6, k7]
c16: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w p = etel u (dnf u M) y w q $ by imp_elim [c14, k8]
c17a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ w = w $ by eq_refl
c17: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w p $ by etel_eq [c7d, c17a, k5]
c18: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w q = etel u (dnf u M) y w B $ by etel_eq [c7d, c17a, k6a]
c19a: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w q $ by eq_trans [c17, c16]
c19: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w B $ by eq_trans [c19a, c18]
d1: $ G , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w B $ by wcel_elim [#5, c19]
d2: $ G , o = Dd , o ∊ trees ω ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w B $ by wcel_elim [#4, d1]
d3: $ G ⇒ etel u (dnf u M) y w A = etel u (dnf u M) y w B $ by wcel_elim [#3, d2]

--| The paths of a `Π` grow with the domain's value and the codomain's paths, when the
--| domain's paths stay.
lemma i9_epi_sub {x: set} (G: hyps) (M A B: class) (u w r s: set): $ G ⇒ A ∈ trees ω $ > $ G ⇒ B ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ dt u M A w r ⊆ dt u M A w s $ > $ G ⇒ etel u (dnf u M) A w r = etel u (dnf u M) A w s $ > $ G ⇒ ∀ x (x ∊ u → etel u (dnf u M) B w (scons x r) ⊆ etel u (dnf u M) B w (scons x s)) $ > $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r ⊆ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w s $
----
p1: $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ c (x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩)} $ by etel_pi [#1, #2, #3, #4]
p2: $ G ⇒ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w s = {y | ∃ x ∃ f ∃ g ∃ t ∃ c (x ∊ dt u M A w s ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x s) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w s) t , c ⟩ ⟩ ⟩)} $ by etel_pi [#1, #2, #3, #5]
h1: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r ⇒ v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r $ by ax
h2: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r ⇒ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r = {y | ∃ x ∃ f ∃ g ∃ t ∃ c (x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩)} $ by weaken [p1]
h3: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r ⇒ v ∊ {y | ∃ x ∃ f ∃ g ∃ t ∃ c (x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩)} $ by welc_eq [h2, h1]
h4: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r ⇒ ∃ x ∃ f ∃ g ∃ t ∃ c (x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩) $ by cab_elim [h3]
k0: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r , x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ ⇒ x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ $ by ax
k1: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r , x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ ⇒ x ∊ dt u M A w r $ by and_elim_l [k0]
k2: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r , x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ ⇒ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ $ by and_elim_r [k0]
k3: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r , x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ ⇒ x ∊ u $ by and_elim_l [k2]
k4: $ G , v ∊ etel u (dnf u M) ⟨ kc_pi , scons A (scons B ∅) ⟩ w r , x ∊ dt u M A w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , c ⟩ ⟩ ⟩ ∈ etel u (dnf u M) B w (scons x r) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (etel u (dnf u M) A w r) t , c ⟩ ⟩ ⟩ $ by and_elim_r [k2]
