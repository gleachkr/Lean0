l11: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ x5 ∊ trees ω $ by welc_eq_set [b7, l11a]
l12a: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ d = x4 ∧ z = x5 ∧ ra_add x4 x3 x7 ∈ lrel ∧ ra_closed x7 x5 ∈ lrel ⇒ w ∊ lvals $ by weaken [#2]
