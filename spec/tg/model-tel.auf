--| i7: the hypothesis on the block's types' values in `lrel_sinst_sem`, as a definition.
def i7_sih (U M D W V J: class) (.i .b: set): fml = $ ∀ i ∀ b (i ∊ cdm V → b ∊ trees ω → fv nvf b = nadd (fv nvf J) i → dt U M ⟨ kc_ind_ty , scons D (scons b ∅) ⟩ W ∅ = fv V i) $

--| The property of the induction for `lrel_sinst_sem` (over the valuation `v`).
def i7_sip (U M D N K W P S: class) (.v .j .e .f .i .b: set): class = $ {v | ∀ j ∀ e ∀ f (ra_sinst D j N K e f ∈ lrel → j ∊ trees ω → nadd (fv nvf j) (cdm v) = fv nvf N → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt U M ⟨ kc_ind_ty , scons D (scons b ∅) ⟩ W ∅ = fv v i) → dt U M f W (scat P S) = dt U M e W (scat P (scat v S)))} $

lemma i7_id (G: hyps) (p: fml): $ G ⇒ p $ > $ G ⇒ p $
----
l1: $ G , p ⇒ p $ by ax
l2: $ G ⇒ p → p $ by imp_intro [l1]
l3: $ G ⇒ p $ by imp_elim [l2, #1]

lemma i7_sih_use (G: hyps) (M: class) (u w t1 v j i b: set): $ G ⇒ i7_sih u M t1 w v j $ > $ G ⇒ i ∊ cdm v $ > $ G ⇒ b ∊ trees ω $ > $ G ⇒ fv nvf b = nadd (fv nvf j) i $ > $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $
----
l1: $ G ⇒ ∀ x0 ∀ x1 (x0 ∊ cdm v → x1 ∊ trees ω → fv nvf x1 = nadd (fv nvf j) x0 → dt u M ⟨ kc_ind_ty , scons t1 (scons x1 ∅) ⟩ w ∅ = fv v x0) $ by i7_id [#1]
l2: $ G ⇒ ∀ x1 (i ∊ cdm v → x1 ∊ trees ω → fv nvf x1 = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons x1 ∅) ⟩ w ∅ = fv v i) $ by all_elim [l1]
l3: $ G ⇒ i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by all_elim [l2]
l4: $ G ⇒ b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_elim [l3, #2]
l5: $ G ⇒ fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_elim [l4, #3]
l6: $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_elim [l5, #4]

lemma i7_sih_intro {i b: set} (G: hyps) (M: class) (u w t1 v j: set): $ G , i ∊ cdm v , b ∊ trees ω , fv nvf b = nadd (fv nvf j) i ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ > $ G ⇒ i7_sih u M t1 w v j $
----
l1: $ G , i ∊ cdm v , b ∊ trees ω ⇒ fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_intro [#1]
l2: $ G , i ∊ cdm v ⇒ b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_intro [l1]
l3: $ G ⇒ i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i $ by imp_intro [l2]
l4: $ G ⇒ ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) $ by all_intro [l3]
l5: $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf j) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) $ by all_intro [l4]
l6: $ G ⇒ i7_sih u M t1 w v j $ by i7_id [l5]

lemma i7_sih_zero (G: hyps) (M: class) (u w t1 v j: set): $ G ⇒ i7_sih u M t1 w v j $ > $ G ⇒ ∅ ∈ cdm v $ > $ G ⇒ j ∊ trees ω $ > $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v ∅ $
----
l1: $ G , n = ∅ ⇒ n = ∅ $ by ax
l2: $ G , n = ∅ ⇒ ∅ = n $ by eq_sym [l1]
l2a: $ G , n = ∅ ⇒ ∅ ∈ cdm v $ by weaken [#2]
l3: $ G , n = ∅ ⇒ n ∈ cdm v $ by wcel_eq_l [l2, l2a]
l4: $ G , n = ∅ ⇒ n ∊ cdm v $ by wcel_welc [l3]
l5a: $ G , n = ∅ ⇒ isset j $ by isset_var
l5b: $ G , n = ∅ ⇒ fv nvf j ∈ ω $ by nvf_omega [l5a]
l5: $ G , n = ∅ ⇒ isset (fv nvf j) $ by wcel_isset [l5b]
l6: $ G , n = ∅ ⇒ nadd (fv nvf j) ∅ = fv nvf j $ by nadd_zero_c [l5]
l7a: $ G , n = ∅ ⇒ fv nvf j = fv nvf j $ by eq_refl
l7: $ G , n = ∅ ⇒ nadd (fv nvf j) n = nadd (fv nvf j) ∅ $ by nadd_eq [l7a, l1]
l8: $ G , n = ∅ ⇒ nadd (fv nvf j) n = fv nvf j $ by eq_trans [l7, l6]
l9: $ G , n = ∅ ⇒ fv nvf j = nadd (fv nvf j) n $ by eq_sym [l8]
l10a: $ G , n = ∅ ⇒ i7_sih u M t1 w v j $ by weaken [#1]
l10b: $ G , n = ∅ ⇒ j ∊ trees ω $ by weaken [#3]
l10: $ G , n = ∅ ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v n $ by i7_sih_use [l10a, l4, l10b, l9]
l11a: $ G , n = ∅ ⇒ v = v $ by eq_refl
l11: $ G , n = ∅ ⇒ fv v n = fv v ∅ $ by fv_eq [l11a, l1]
l12: $ G , n = ∅ ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v ∅ $ by eq_trans [l10, l11]
l13: $ G ⇒ isset ∅ $ by ax_empty
l14: $ G ⇒ dt u M ⟨ kc_ind_ty , scons t1 (scons j ∅) ⟩ w ∅ = fv v ∅ $ by isset_elim [l13, l12]

--| `∅` is below every successor number.
lemma i7_zero_suc (G: hyps) (A: class): $ G ⇒ A ∈ ω $ > $ G ⇒ ∅ ∈ suc A $
----
l1: $ G , a = A , a ∊ ω ⇒ a ∊ ω $ by ax
l2: $ G , a = A , a ∊ ω ⇒ ∅ ∈ a ∨ ∅ = a $ by omega_zero_le [l1]
l3: $ G , a = A , a ∊ ω , ∅ ∈ a ⇒ ∅ ∈ a $ by ax
l4: $ G , a = A , a ∊ ω , ∅ ∈ a ⇒ ∅ ∈ suc a $ by suc_mem_r [l3]
l5: $ G , a = A , a ∊ ω , ∅ = a ⇒ isset a $ by isset_var
l6: $ G , a = A , a ∊ ω , ∅ = a ⇒ a ∈ suc a $ by suc_mem [l5]
l7: $ G , a = A , a ∊ ω , ∅ = a ⇒ ∅ = a $ by ax
l8: $ G , a = A , a ∊ ω , ∅ = a ⇒ a = ∅ $ by eq_sym [l7]
l9: $ G , a = A , a ∊ ω , ∅ = a ⇒ ∅ ∈ suc a $ by wcel_eq_l [l8, l6]
l10: $ G , a = A , a ∊ ω ⇒ ∅ ∈ suc a $ by or_elim [l2, l4, l9]
l11: $ G , a = A , a ∊ ω ⇒ a = A $ by ax
l12: $ G , a = A , a ∊ ω ⇒ suc a = suc A $ by suc_eq [l11]
l13: $ G , a = A , a ∊ ω ⇒ ∅ ∈ suc A $ by wcel_eq_r [l12, l10]
l14: $ G ⇒ ∅ ∈ suc A $ by wcel_elim [#1, l13]

--| `a + (b + 1) ≠ a`, at classes.
lemma i7_nsne (G: hyps) (A B: class): $ G ⇒ A ∈ ω $ > $ G ⇒ B ∈ ω $ > $ G ⇒ nadd A (suc B) = A $ > $ G ⇒ ⊥ $
----
l1: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ a ∊ ω $ by ax
l2: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ b ∊ ω $ by ax
l3: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ a = A $ by ax
l4: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ b = B $ by ax
l5: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ suc b = suc B $ by suc_eq [l4]
l6: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nadd a (suc b) = nadd A (suc B) $ by nadd_eq [l3, l5]
l7: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nadd A (suc B) = A $ by weaken [#3]
l8: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ A = a $ by eq_sym [l3]
l9: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nadd a (suc b) = A $ by eq_trans [l6, l7]
l10: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ nadd a (suc b) = a $ by eq_trans [l9, l8]
l11: $ G , a = A , a ∊ ω , b = B , b ∊ ω ⇒ ⊥ $ by nadd_suc_ne [l1, l2, l10]
l12: $ G , a = A , a ∊ ω ⇒ ⊥ $ by wcel_elim [#2, l11]
l13: $ G ⇒ ⊥ $ by wcel_elim [#1, l12]

lemma i7_si_b1 (G: hyps) (M: class) (u w t1 t3 t4 p s z j e f x0 x1 x2 x3: set): $ G ⇒ z = ∅ $ > $ G ⇒ s ∊ fseq u $ > $ G ⇒ (t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3) → dt u M f w (scat p s) = dt u M e w (scat p (scat z s)) $
----
a0: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 $ by ax
p0: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t1 = x0 $ by and_elim_l [a0]
p0r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 $ by and_elim_r [a0]
p1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ j = x1 $ by and_elim_l [p0r]
p1r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 $ by and_elim_r [p0r]
p2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t3 = x1 $ by and_elim_l [p1r]
p2r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t4 = x2 ∧ e = x3 ∧ f = x3 $ by and_elim_r [p1r]
p3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ t4 = x2 $ by and_elim_l [p2r]
p3r: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ e = x3 ∧ f = x3 $ by and_elim_r [p2r]
p4: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ e = x3 $ by and_elim_l [p3r]
p5: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ f = x3 $ by and_elim_r [p3r]
b2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ x3 = e $ by eq_sym [p4]
b3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ f = e $ by eq_trans [p5, b2]
c1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ z = ∅ $ by weaken [#1]
c2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ s = s $ by eq_refl
c3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat z s = scat ∅ s $ by scat_eq [c1, c2]
c4: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ s ∊ fseq u $ by weaken [#2]
c5: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat ∅ s = s $ by scat_empty_l [c4]
c6: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat z s = s $ by eq_trans [c3, c5]
c7: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ p = p $ by eq_refl
c8: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat p (scat z s) = scat p s $ by scat_eq [c7, c6]
c9: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ scat p s = scat p (scat z s) $ by eq_sym [c8]
d1: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ u = u $ by eq_refl
d2: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ M = M $ by eq_refl
d3: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ w = w $ by eq_refl
d4: $ G , t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3 ⇒ dt u M f w (scat p s) = dt u M e w (scat p (scat z s)) $ by dt_eq [d1, d2, b3, d3, c9]
d5: $ G ⇒ (t1 = x0 ∧ j = x1 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x3) → dt u M f w (scat p s) = dt u M e w (scat p (scat z s)) $ by imp_intro [d4]

lemma i7_si_b2 (G: hyps) (M: class) (u w t1 t3 t4 p s z j e f x0 x1 x2 x3 x4 x5 x6: set): $ G ⇒ z = ∅ $ > $ G ⇒ j ∊ trees ω $ > $ G ⇒ nadd (fv nvf j) (cdm z) = fv nvf t3 $ > $ G ⇒ (t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel) → dt u M f w (scat p s) = dt u M e w (scat p (scat z s)) $
----
a0: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel $ by ax
p0: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ t1 = x0 $ by and_elim_l [a0]
p0r: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel $ by and_elim_r [a0]
p1: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ j = x4 $ by and_elim_l [p0r]
p1r: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel $ by and_elim_r [p0r]
p2: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ t3 = x1 $ by and_elim_l [p1r]
p2r: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel $ by and_elim_r [p1r]
p3: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ t4 = x2 $ by and_elim_l [p2r]
p3r: $ G , t1 = x0 ∧ j = x4 ∧ t3 = x1 ∧ t4 = x2 ∧ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel ⇒ e = x3 ∧ f = x6 ∧ ra_le ⟨ kc_s , scons x4 ∅ ⟩ x1 ∈ lrel ∧ ra_inst x2 x3 ⟨ kc_ind_ty , scons x0 (scons x4 ∅) ⟩ x5 ∈ lrel ∧ ra_sinst x0 ⟨ kc_s , scons x4 ∅ ⟩ x1 x2 x5 x6 ∈ lrel $ by and_elim_r [p2r]
