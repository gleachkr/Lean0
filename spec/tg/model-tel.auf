e4: $ G , z = ⟨ k , j ⟩ , ra_spine h z n ∈ lrel , z ∊ ofsort lsig lopen ks_expr , ∃ x2 ∃ e ∃ a ∃ c (h = x2 ∧ z = ⟨ kc_app , scons e (scons a ∅) ⟩ ∧ n = ⟨ kc_s , scons c ∅ ⟩ ∧ ra_spine x2 e c ∈ lrel) ⇒ (sarg u (dnf u M) z w r) ∈ fseq u $ by ex_elim [e4a, e3]
g7: $ G , z = ⟨ k , j ⟩ , ra_spine h z n ∈ lrel , z ∊ ofsort lsig lopen ks_expr ⇒ (sarg u (dnf u M) z w r) ∈ fseq u $ by or_elim [a2, b26, e4]
h0: $ G , z = ⟨ k , j ⟩ , ra_spine h z n ∈ lrel ⇒ z ∊ ofsort lsig lopen ks_expr → (sarg u (dnf u M) z w r) ∈ fseq u $ by imp_intro [g7]
h1: $ G , z = ⟨ k , j ⟩ ⇒ ra_spine h z n ∈ lrel → z ∊ ofsort lsig lopen ks_expr → (sarg u (dnf u M) z w r) ∈ fseq u $ by imp_intro [h0]
h2: $ G , z = ⟨ k , j ⟩ ⇒ ∀ n (ra_spine h z n ∈ lrel → z ∊ ofsort lsig lopen ks_expr → (sarg u (dnf u M) z w r) ∈ fseq u) $ by all_intro [h1]
h5: $ G ⇒ isset ⟨ k , j ⟩ $ by opair_isset
h6: $ G ⇒ ⟨ k , j ⟩ ∈ i6_spf u M h w r $ by wcel_cab_intro [h5, h2]

