f6: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ p ∊ ofsort lsig lopen ks_ctx $ by and_elim_r [f4]
