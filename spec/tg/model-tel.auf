a8: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel $ by and_elim_r [a6]
a9: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ $ by and_elim_l [a8]
a10: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ ra_rehead x4 x5 x9 x6 x7 ∈ lrel $ by and_elim_r [a8]
b1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ x4 = t1 $ by eq_sym [a1]
b2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ x5 = t2 $ by eq_sym [a3]
b3: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ x9 = x9 $ by eq_refl
b4: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ x6 = x6 $ by eq_refl
b5: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ x7 = x7 $ by eq_refl
b6: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ ra_rehead x4 x5 x9 x6 x7 = ra_rehead t1 t2 x9 x6 x7 $ by ra_rehead_eq [b1, b2, b3, b4, b5]
b7: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ ra_rehead t1 t2 x9 x6 x7 ∈ lrel $ by wcel_eq_l [b6, a10]
c1: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by weaken [#3]
c2: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ ⟨ k , j ⟩ = y $ by eq_sym [c1]
c3: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ ⟨ k , j ⟩ = ⟨ kc_s , scons x9 ∅ ⟩ $ by eq_trans [c2, a5]
c4: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ isset k $ by isset_var
c5: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ isset j $ by isset_var
c6: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ kc_s ∈ ω $ by kc_s_omega
c7: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ isset kc_s $ by wcel_isset [c6]
c8: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ isset ∅ $ by ax_empty
c9: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ isset (scons x9 ∅) $ by scons_set [c8]
c10: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ k = kc_s ∧ j = scons x9 ∅ $ by opair_inj_c [c3, c4, c5, c7, c9]
c11: $ G , t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel ⇒ j = scons x9 ∅ $ by and_elim_r [c10]
