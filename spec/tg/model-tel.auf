f3a: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ x = x $ by eq_refl
f3: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ scons x q = scons x g $ by scons_eq [f3a, e2]
f4: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ p = scons x g $ by eq_trans [c1, f3]
f5: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest p z = nest (scons x g) z $ by nest_eq [f4, c2]
f6: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ nest (scons x g) z ∈ f $ by wcel_eq_l [f5, f2]
f7: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z ∈ apn f (scons x g) ↔ nest (scons x g) z ∈ f $ by apn_wcel [c5]
f8: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z ∈ apn f (scons x g) $ by bi_elim_r [f7, f6]
f9: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ z ∊ apn f (scons x g) $ by wcel_welc [f8]
h1: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ ⟨ x , z ⟩ ∈ clam y (da (fv E A) w g) (apn f (scons y g)) $ by clam_intro [e4, f9]
h2: $ G , e ∊ apn f g , v = nest g e , v ∊ f , p ∊ esat u E ⟨ kc_cons , scons A (scons P ∅) ⟩ w ∧ v = nest p z , q ∊ esat u E P w , x ∊ da (fv E A) w q , p = scons x q ⇒ ⟨ x , z ⟩ = e $ by eq_sym [d8]
