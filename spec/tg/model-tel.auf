e1b: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel $ by and_elim_r [e0]
e2: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ c = b $ by and_elim_l [e1b]
e2b: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel $ by and_elim_r [e1b]
e3: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ d = t $ by and_elim_l [e2b]
e4: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ ra_lams p ⟨ kc_lam , scons a (scons b ∅) ⟩ t ∈ lrel $ by and_elim_r [e2b]
