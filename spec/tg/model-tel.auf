b2: $ G ⇒ ∀ x9 ((t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [b1]
b3: $ G ⇒ (∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_exi [b2]
b4: $ G ⇒ ∀ x8 ((∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [b3]
b5: $ G ⇒ (∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_exi [b4]
b6: $ G ⇒ ∀ x7 ((∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [b5]
b7: $ G ⇒ (∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_exi [b6]
b8: $ G ⇒ ∀ x6 ((∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [b7]
b9: $ G ⇒ (∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_exi [b8]
b10: $ G ⇒ ∀ x5 ((∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [b9]
b11: $ G ⇒ (∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_exi [b10]
b12: $ G ⇒ ∀ x4 ((∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [b11]
b13: $ G ⇒ (∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 (t1 = x4 ∧ t2 = x5 ∧ y = ⟨ kc_s , scons x9 ∅ ⟩ ∧ e = ⟨ kc_app , scons x6 (scons x8 ∅) ⟩ ∧ f = ⟨ kc_app , scons x7 (scons x8 ∅) ⟩ ∧ ra_rehead x4 x5 x9 x6 x7 ∈ lrel)) → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_exi [b12]
d1: $ G ⇒ ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_or2 [c0, a5, b13]

lrel_rehead_spine
-----------------
s1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ , ra_rehead t1 t2 y e f ∈ lrel ⇒ crn j ⊆ i7_rsp t1 t2 $ by ax
s2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ , ra_rehead t1 t2 y e f ∈ lrel ⇒ y = ⟨ k , j ⟩ $ by ax
s3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ , ra_rehead t1 t2 y e f ∈ lrel ⇒ ra_rehead t1 t2 y e f ∈ lrel $ by ax
s4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ , ra_rehead t1 t2 y e f ∈ lrel ⇒ ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by i7_rs_step [s1, s2, s3]
s5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ ⇒ ra_rehead t1 t2 y e f ∈ lrel → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel $ by imp_intro [s4]
s6: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ ⇒ ∀ f (ra_rehead t1 t2 y e f ∈ lrel → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [s5]
s7: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 , y = ⟨ k , j ⟩ ⇒ ∀ e ∀ f (ra_rehead t1 t2 y e f ∈ lrel → ra_spine t1 e y ∈ lrel ∧ ra_spine t2 f y ∈ lrel) $ by all_intro [s6]
s8: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 ⇒ isset ⟨ k , j ⟩ $ by opair_isset
s9: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i7_rsp t1 t2 ⇒ ⟨ k , j ⟩ ∈ i7_rsp t1 t2 $ by wcel_cab_intro [s8, s7]
s10: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ i7_rsp t1 t2 → ⟨ k , j ⟩ ∈ i7_rsp t1 t2 $ by imp_intro [s9]
s11: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ i7_rsp t1 t2 → ⟨ k , j ⟩ ∈ i7_rsp t1 t2 $ by imp_intro [s10]
s12: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i7_rsp t1 t2 → ⟨ k , j ⟩ ∈ i7_rsp t1 t2 $ by imp_intro [s11]
s13: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i7_rsp t1 t2 → ⟨ k , j ⟩ ∈ i7_rsp t1 t2) $ by all_intro [s12]
s14: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i7_rsp t1 t2 → ⟨ k , j ⟩ ∈ i7_rsp t1 t2) $ by all_intro [s13]
m0: $ G ⇒ isset ω $ by omega_set
s15: $ G ⇒ trees ω ⊆ i7_rsp t1 t2 $ by trees_ind_c [m0, s14]
m1: $ G ⇒ t1 ∊ trees ω ∧ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by i7_rh_args [#1]
m2: $ G ⇒ t2 ∊ trees ω ∧ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by and_elim_r [m1]
m3: $ G ⇒ t3 ∊ trees ω ∧ t4 ∊ trees ω ∧ t5 ∊ trees ω $ by and_elim_r [m2]
m4: $ G ⇒ t3 ∊ trees ω $ by and_elim_l [m3]
m5: $ G ⇒ t3 ∊ i7_rsp t1 t2 $ by subset_elim [s15, m4]
m6: $ G ⇒ ∀ e ∀ f (ra_rehead t1 t2 t3 e f ∈ lrel → ra_spine t1 e t3 ∈ lrel ∧ ra_spine t2 f t3 ∈ lrel) $ by cab_elim [m5]
m7: $ G ⇒ ∀ f (ra_rehead t1 t2 t3 t4 f ∈ lrel → ra_spine t1 t4 t3 ∈ lrel ∧ ra_spine t2 f t3 ∈ lrel) $ by all_elim [m6]
m8: $ G ⇒ ra_rehead t1 t2 t3 t4 t5 ∈ lrel → ra_spine t1 t4 t3 ∈ lrel ∧ ra_spine t2 t5 t3 ∈ lrel $ by all_elim [m7]
m9: $ G ⇒ ra_spine t1 t4 t3 ∈ lrel ∧ ra_spine t2 t5 t3 ∈ lrel $ by imp_elim [m8, #1]

--| i7: the universal class (for sequences of arbitrary sets).
def i7_V (.x: set): class = $ {x | x = x} $

lemma i7_inV (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ i7_V $
----
l1: $ G , z = A ⇒ z = z $ by eq_refl
l2: $ G ⇒ A ∈ {x | x = x} $ by wcel_cab_intro [#1, l1]

lemma i7_q_inj (G: hyps) (A B: class): $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ isset B $ > $ G ⇒ A = B $
----
l1: $ G ⇒ isset ∅ $ by ax_empty
l2: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ $ by opair_isset
l3: $ G ⇒ isset ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by opair_isset
l4: $ G ⇒ ∅ = ∅ ∧ ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by opair_inj_c [#1, l1, l2, l1, l3]
l5: $ G ⇒ ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by and_elim_r [l4]
l6: $ G ⇒ isset ⟨ ∅ , A ⟩ $ by opair_isset
l7: $ G ⇒ isset ⟨ ∅ , B ⟩ $ by opair_isset
l8: $ G ⇒ ∅ = ∅ ∧ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by opair_inj_c [l5, l1, l6, l1, l7]
l9: $ G ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by and_elim_r [l8]
l10: $ G ⇒ ∅ = ∅ ∧ A = B $ by opair_inj_c [l9, l1, #2, l1, #3]
l11: $ G ⇒ A = B $ by and_elim_r [l10]

lemma i7_q_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by opair_eq [l1, #1]
l3: $ G ⇒ ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by opair_eq [l1, l2]
l4: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ by opair_eq [l1, l3]

--| A class in a singleton is its element.
lemma i7_wcel_csn (G: hyps) (A B: class): $ G ⇒ A ∈ csn B $ > $ G ⇒ A = B $
----
l1: $ G , z = A , z ∊ csn B ⇒ z ∊ csn B $ by ax
l2: $ G , z = A , z ∊ csn B ⇒ z = B $ by csn_elim [l1]
l3: $ G , z = A , z ∊ csn B ⇒ z = A $ by ax
l4: $ G , z = A , z ∊ csn B ⇒ A = z $ by eq_sym [l3]
l5: $ G , z = A , z ∊ csn B ⇒ A = B $ by eq_trans [l4, l2]
l6: $ G ⇒ A = B $ by wcel_elim [#1, l5]

--| A set is in its singleton.
lemma i7_csn_self (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ csn A $
----
l1: $ G , z = A ⇒ z = A $ by ax
l2: $ G , z = A ⇒ z ∊ csn A $ by csn_intro [l1]
l3: $ G , z = A ⇒ A ∈ csn A $ by wcel_intro [l1, l2]
l4: $ G ⇒ A ∈ csn A $ by isset_elim [#1, l3]

--| The arguments of a telescope with the one fieldless path `⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩`.
lemma i7_sarg_csn (G: hyps) (U E T W R A: class): $ G ⇒ etel U E T W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ sarg U E T W R = A $
----
a1: $ G , x ∊ sarg U E T W R ⇒ x ∊ sarg U E T W R $ by ax
a2: $ G , x ∊ sarg U E T W R ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a) $ by cab_elim [a1]
b1: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a $ by ax
b2: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R $ by and_elim_l [b1]
b3: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ x ∈ a $ by and_elim_r [b1]
b4: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ etel U E T W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by weaken [#1]
b5: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by wcel_eq_r [b4, b2]
b6: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by i7_wcel_csn [b5]
b7: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ isset a $ by isset_var
b8: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ isset A $ by weaken [#2]
b9: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ a = A $ by i7_q_inj [b6, b7, b8]
b10: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ x ∈ A $ by wcel_eq_r [b9, b3]
b11: $ G , x ∊ sarg U E T W R , ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a ⇒ x ∊ A $ by wcel_welc [b10]
a3: $ G , x ∊ sarg U E T W R ⇒ x ∊ A $ by ex_elim [a2, b11]
d1: $ G , x ∊ A , a = A ⇒ a = A $ by ax
d2: $ G , x ∊ A , a = A ⇒ isset ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by opair_isset
d3: $ G , x ∊ A , a = A ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by i7_csn_self [d2]
d4: $ G , x ∊ A , a = A ⇒ etel U E T W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by weaken [#1]
d5: $ G , x ∊ A , a = A ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = etel U E T W R $ by eq_sym [d4]
d6: $ G , x ∊ A , a = A ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ ∈ etel U E T W R $ by wcel_eq_r [d5, d3]
d7: $ G , x ∊ A , a = A ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ by i7_q_eq [d1]
d8: $ G , x ∊ A , a = A ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ $ by eq_sym [d7]
d9: $ G , x ∊ A , a = A ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R $ by wcel_eq_l [d8, d6]
d10: $ G , x ∊ A , a = A ⇒ A = a $ by eq_sym [d1]
d11: $ G , x ∊ A , a = A ⇒ x ∊ A $ by ax
d12: $ G , x ∊ A , a = A ⇒ x ∊ a $ by welc_eq [d10, d11]
d13: $ G , x ∊ A , a = A ⇒ x ∈ a $ by welc_wcel [d12]
d14: $ G , x ∊ A , a = A ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a $ by and_intro [d9, d13]
d15: $ G , x ∊ A , a = A ⇒ ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ etel U E T W R ∧ x ∈ a) $ by ex_intro [d14]
d16: $ G , x ∊ A , a = A ⇒ x ∊ sarg U E T W R $ by cab_intro [d15]
d17: $ G , x ∊ A ⇒ isset A $ by weaken [#2]
d18: $ G , x ∊ A ⇒ x ∊ sarg U E T W R $ by isset_elim [d17, d16]
e1: $ G ⇒ sarg U E T W R = A $ by eq_intro [a3, d18]

--| An application of a telescope with one fieldless path has one fieldless path.
lemma i7_etel_app_csn (G: hyps) (E F A2 A: class) (u w r: set): $ G ⇒ F ∈ trees ω $ > $ G ⇒ A2 ∈ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u E F w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ $ > $ G ⇒ isset A $ > $ G ⇒ etel u E ⟨ kc_app , scons F (scons A2 ∅) ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E A2) w r) A ⟩ ⟩ ⟩ $
