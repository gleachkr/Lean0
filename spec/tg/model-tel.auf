z0d: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_s , scons x6 ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x5 ∧ ra_inst x6 x2 ⟨ kc_proj , scons x0 (scons x3 (scons x1 ∅)) ⟩ x4 ∈ lrel ∧ ra_qinst x0 x1 x6 ⟨ kc_s , scons x3 ∅ ⟩ x4 x5 ∈ lrel , q = ⟨ kc_s , scons j ∅ ⟩ , c = ⟨ kc_proj , scons t1 (scons j (scons t2 ∅)) ⟩ , n = fv nvf x6 ⇒ ∅ = ∅ $ by eq_refl
z0e: $ G , t1 = x0 ∧ t2 = x1 ∧ y = ⟨ kc_s , scons x6 ∅ ⟩ ∧ j = x3 ∧ a = x2 ∧ r = x5 ∧ ra_inst x6 x2 ⟨ kc_proj , scons x0 (scons x3 (scons x1 ∅)) ⟩ x4 ∈ lrel ∧ ra_qinst x0 x1 x6 ⟨ kc_s , scons x3 ∅ ⟩ x4 x5 ∈ lrel , q = ⟨ kc_s , scons j ∅ ⟩ , c = ⟨ kc_proj , scons t1 (scons j (scons t2 ∅)) ⟩ , n = fv nvf x6 ⇒ scons x1 ∅ = scons t2 ∅ $ by scons_eq [z0c, z0d]
