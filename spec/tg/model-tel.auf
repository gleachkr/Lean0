lemma i8_lprog3_congr (J J2: class): $ J ≐ J2 $ > $ lprog3 J ≐ lprog3 J2 $
-----
l1: $ (((((((cl_sty_nil ∪ (cl_sty_app J)) ∪ ((cl_cwf_pi J) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J)) ∪ (cl_tys_ty_nil ∪ (cl_tys_ty_cons J))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (cl_fprops_s J)) ∪ pr_proj_ok) ∪ ((cl_add_eqs_i J) ∪ ((cl_pred_eqs_i J) ∪ (cl_sub_eqs_i J)))))) ∪ (((((cl_mul_eqs_i J) ∪ (cl_pow_eqs_i J)) ∪ ((cl_beq_eqs_i J) ∪ (cl_ble_eqs_i J))) ∪ (((cl_shl_eqs_i J) ∪ (cl_shr_eqs_i J)) ∪ ((cl_dec_eqs_i J) ∪ (cl_ite_eqs_i J)))) ∪ ((((cl_natle_dec_i J) ∪ (cl_nateq_dec_i J)) ∪ ((cl_bool_dec_i J) ∪ (cl_div_eqs_i J))) ∪ (((cl_mod_eqs_i J) ∪ (cl_fix_eqs_i J)) ∪ ((cl_gcd_eqs_i J) ∪ ((cl_bitwise_eqs_i J) ∪ (cl_bitop_eqs_i J))))))) ∩ (fseq latoms × latoms)) ≐ (((((((cl_sty_nil ∪ (cl_sty_app J2)) ∪ ((cl_cwf_pi J2) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J2)) ∪ (cl_tys_ty_nil ∪ (cl_tys_ty_cons J2))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J2))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (cl_fprops_s J2)) ∪ pr_proj_ok) ∪ ((cl_add_eqs_i J2) ∪ ((cl_pred_eqs_i J2) ∪ (cl_sub_eqs_i J2)))))) ∪ (((((cl_mul_eqs_i J2) ∪ (cl_pow_eqs_i J2)) ∪ ((cl_beq_eqs_i J2) ∪ (cl_ble_eqs_i J2))) ∪ (((cl_shl_eqs_i J2) ∪ (cl_shr_eqs_i J2)) ∪ ((cl_dec_eqs_i J2) ∪ (cl_ite_eqs_i J2)))) ∪ ((((cl_natle_dec_i J2) ∪ (cl_nateq_dec_i J2)) ∪ ((cl_bool_dec_i J2) ∪ (cl_div_eqs_i J2))) ∪ (((cl_mod_eqs_i J2) ∪ (cl_fix_eqs_i J2)) ∪ ((cl_gcd_eqs_i J2) ∪ ((cl_bitwise_eqs_i J2) ∪ (cl_bitop_eqs_i J2))))))) ∩ (fseq latoms × latoms)) $ by cin_congr [cun_congr [cun_congr [cun_congr [cun_congr [cun_congr [cun_congr [ceqt_refl [], i8_cg_cl_sty_app [#1]], cun_congr [i8_cg_cl_cwf_pi [#1], ceqt_refl []]], cun_congr [ceqt_refl [], ceqt_refl []]], cun_congr [cun_congr [cun_congr [ceqt_refl [], i8_cg_cl_ctx_wf_cons [#1]], cun_congr [ceqt_refl [], i8_cg_cl_tys_ty_cons [#1]]], cun_congr [ceqt_refl [], ceqt_refl []]]], cun_congr [cun_congr [cun_congr [ceqt_refl [], ceqt_refl []], cun_congr [cun_congr [ceqt_refl [], cun_congr [ceqt_refl [], i8_cg_cl_fir_prop [#1]]], ceqt_refl []]], cun_congr [cun_congr [cun_congr [ceqt_refl [], i8_cg_cl_fprops_s [#1]], ceqt_refl []], cun_congr [i8_cg_cl_add_eqs_i [#1], cun_congr [i8_cg_cl_pred_eqs_i [#1], i8_cg_cl_sub_eqs_i [#1]]]]]], cun_congr [cun_congr [cun_congr [cun_congr [i8_cg_cl_mul_eqs_i [#1], i8_cg_cl_pow_eqs_i [#1]], cun_congr [i8_cg_cl_beq_eqs_i [#1], i8_cg_cl_ble_eqs_i [#1]]], cun_congr [cun_congr [i8_cg_cl_shl_eqs_i [#1], i8_cg_cl_shr_eqs_i [#1]], cun_congr [i8_cg_cl_dec_eqs_i [#1], i8_cg_cl_ite_eqs_i [#1]]]], cun_congr [cun_congr [cun_congr [i8_cg_cl_natle_dec_i [#1], i8_cg_cl_nateq_dec_i [#1]], cun_congr [i8_cg_cl_bool_dec_i [#1], i8_cg_cl_div_eqs_i [#1]]], cun_congr [cun_congr [i8_cg_cl_mod_eqs_i [#1], i8_cg_cl_fix_eqs_i [#1]], cun_congr [i8_cg_cl_gcd_eqs_i [#1], cun_congr [i8_cg_cl_bitwise_eqs_i [#1], i8_cg_cl_bitop_eqs_i [#1]]]]]]], ceqt_refl []]

lemma i8_sb_lprog3 {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (lprog3 J)) ≐ lprog3 (⟦ x / t ⟧ J) $
-----
l1: $ (⟦ x / t ⟧ (((((((cl_sty_nil ∪ (cl_sty_app J)) ∪ ((cl_cwf_pi J) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J)) ∪ (cl_tys_ty_nil ∪ (cl_tys_ty_cons J))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (cl_fprops_s J)) ∪ pr_proj_ok) ∪ ((cl_add_eqs_i J) ∪ ((cl_pred_eqs_i J) ∪ (cl_sub_eqs_i J)))))) ∪ (((((cl_mul_eqs_i J) ∪ (cl_pow_eqs_i J)) ∪ ((cl_beq_eqs_i J) ∪ (cl_ble_eqs_i J))) ∪ (((cl_shl_eqs_i J) ∪ (cl_shr_eqs_i J)) ∪ ((cl_dec_eqs_i J) ∪ (cl_ite_eqs_i J)))) ∪ ((((cl_natle_dec_i J) ∪ (cl_nateq_dec_i J)) ∪ ((cl_bool_dec_i J) ∪ (cl_div_eqs_i J))) ∪ (((cl_mod_eqs_i J) ∪ (cl_fix_eqs_i J)) ∪ ((cl_gcd_eqs_i J) ∪ ((cl_bitwise_eqs_i J) ∪ (cl_bitop_eqs_i J))))))) ∩ (fseq latoms × latoms))) ≐ (((((((cl_sty_nil ∪ (⟦ x / t ⟧ (cl_sty_app J))) ∪ ((⟦ x / t ⟧ (cl_cwf_pi J)) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (⟦ x / t ⟧ (cl_ctx_wf_cons J))) ∪ (cl_tys_ty_nil ∪ (⟦ x / t ⟧ (cl_tys_ty_cons J)))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (⟦ x / t ⟧ (cl_fir_prop J)))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (⟦ x / t ⟧ (cl_fprops_s J))) ∪ pr_proj_ok) ∪ ((⟦ x / t ⟧ (cl_add_eqs_i J)) ∪ ((⟦ x / t ⟧ (cl_pred_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_sub_eqs_i J))))))) ∪ (((((⟦ x / t ⟧ (cl_mul_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_pow_eqs_i J))) ∪ ((⟦ x / t ⟧ (cl_beq_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_ble_eqs_i J)))) ∪ (((⟦ x / t ⟧ (cl_shl_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_shr_eqs_i J))) ∪ ((⟦ x / t ⟧ (cl_dec_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_ite_eqs_i J))))) ∪ ((((⟦ x / t ⟧ (cl_natle_dec_i J)) ∪ (⟦ x / t ⟧ (cl_nateq_dec_i J))) ∪ ((⟦ x / t ⟧ (cl_bool_dec_i J)) ∪ (⟦ x / t ⟧ (cl_div_eqs_i J)))) ∪ (((⟦ x / t ⟧ (cl_mod_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_fix_eqs_i J))) ∪ ((⟦ x / t ⟧ (cl_gcd_eqs_i J)) ∪ ((⟦ x / t ⟧ (cl_bitwise_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_bitop_eqs_i J)))))))) ∩ (fseq latoms × latoms)) $ by ceqt_refl
l2: $ (((((((cl_sty_nil ∪ (⟦ x / t ⟧ (cl_sty_app J))) ∪ ((⟦ x / t ⟧ (cl_cwf_pi J)) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (⟦ x / t ⟧ (cl_ctx_wf_cons J))) ∪ (cl_tys_ty_nil ∪ (⟦ x / t ⟧ (cl_tys_ty_cons J)))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (⟦ x / t ⟧ (cl_fir_prop J)))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (⟦ x / t ⟧ (cl_fprops_s J))) ∪ pr_proj_ok) ∪ ((⟦ x / t ⟧ (cl_add_eqs_i J)) ∪ ((⟦ x / t ⟧ (cl_pred_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_sub_eqs_i J))))))) ∪ (((((⟦ x / t ⟧ (cl_mul_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_pow_eqs_i J))) ∪ ((⟦ x / t ⟧ (cl_beq_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_ble_eqs_i J)))) ∪ (((⟦ x / t ⟧ (cl_shl_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_shr_eqs_i J))) ∪ ((⟦ x / t ⟧ (cl_dec_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_ite_eqs_i J))))) ∪ ((((⟦ x / t ⟧ (cl_natle_dec_i J)) ∪ (⟦ x / t ⟧ (cl_nateq_dec_i J))) ∪ ((⟦ x / t ⟧ (cl_bool_dec_i J)) ∪ (⟦ x / t ⟧ (cl_div_eqs_i J)))) ∪ (((⟦ x / t ⟧ (cl_mod_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_fix_eqs_i J))) ∪ ((⟦ x / t ⟧ (cl_gcd_eqs_i J)) ∪ ((⟦ x / t ⟧ (cl_bitwise_eqs_i J)) ∪ (⟦ x / t ⟧ (cl_bitop_eqs_i J)))))))) ∩ (fseq latoms × latoms)) ≐ (((((((cl_sty_nil ∪ (cl_sty_app (⟦ x / t ⟧ J))) ∪ ((cl_cwf_pi (⟦ x / t ⟧ J)) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (cl_ctx_wf_cons (⟦ x / t ⟧ J))) ∪ (cl_tys_ty_nil ∪ (cl_tys_ty_cons (⟦ x / t ⟧ J)))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop (⟦ x / t ⟧ J)))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (cl_fprops_s (⟦ x / t ⟧ J))) ∪ pr_proj_ok) ∪ ((cl_add_eqs_i (⟦ x / t ⟧ J)) ∪ ((cl_pred_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_sub_eqs_i (⟦ x / t ⟧ J))))))) ∪ (((((cl_mul_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_pow_eqs_i (⟦ x / t ⟧ J))) ∪ ((cl_beq_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_ble_eqs_i (⟦ x / t ⟧ J)))) ∪ (((cl_shl_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_shr_eqs_i (⟦ x / t ⟧ J))) ∪ ((cl_dec_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_ite_eqs_i (⟦ x / t ⟧ J))))) ∪ ((((cl_natle_dec_i (⟦ x / t ⟧ J)) ∪ (cl_nateq_dec_i (⟦ x / t ⟧ J))) ∪ ((cl_bool_dec_i (⟦ x / t ⟧ J)) ∪ (cl_div_eqs_i (⟦ x / t ⟧ J)))) ∪ (((cl_mod_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_fix_eqs_i (⟦ x / t ⟧ J))) ∪ ((cl_gcd_eqs_i (⟦ x / t ⟧ J)) ∪ ((cl_bitwise_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_bitop_eqs_i (⟦ x / t ⟧ J)))))))) ∩ (fseq latoms × latoms)) $ by cin_congr [cun_congr [cun_congr [cun_congr [cun_congr [cun_congr [cun_congr [ceqt_refl [], i8_sb_cl_sty_app []], cun_congr [i8_sb_cl_cwf_pi [], ceqt_refl []]], cun_congr [ceqt_refl [], ceqt_refl []]], cun_congr [cun_congr [cun_congr [ceqt_refl [], i8_sb_cl_ctx_wf_cons []], cun_congr [ceqt_refl [], i8_sb_cl_tys_ty_cons []]], cun_congr [ceqt_refl [], ceqt_refl []]]], cun_congr [cun_congr [cun_congr [ceqt_refl [], ceqt_refl []], cun_congr [cun_congr [ceqt_refl [], cun_congr [ceqt_refl [], i8_sb_cl_fir_prop []]], ceqt_refl []]], cun_congr [cun_congr [cun_congr [ceqt_refl [], i8_sb_cl_fprops_s []], ceqt_refl []], cun_congr [i8_sb_cl_add_eqs_i [], cun_congr [i8_sb_cl_pred_eqs_i [], i8_sb_cl_sub_eqs_i []]]]]], cun_congr [cun_congr [cun_congr [cun_congr [i8_sb_cl_mul_eqs_i [], i8_sb_cl_pow_eqs_i []], cun_congr [i8_sb_cl_beq_eqs_i [], i8_sb_cl_ble_eqs_i []]], cun_congr [cun_congr [i8_sb_cl_shl_eqs_i [], i8_sb_cl_shr_eqs_i []], cun_congr [i8_sb_cl_dec_eqs_i [], i8_sb_cl_ite_eqs_i []]]], cun_congr [cun_congr [cun_congr [i8_sb_cl_natle_dec_i [], i8_sb_cl_nateq_dec_i []], cun_congr [i8_sb_cl_bool_dec_i [], i8_sb_cl_div_eqs_i []]], cun_congr [cun_congr [i8_sb_cl_mod_eqs_i [], i8_sb_cl_fix_eqs_i []], cun_congr [i8_sb_cl_gcd_eqs_i [], cun_congr [i8_sb_cl_bitwise_eqs_i [], i8_sb_cl_bitop_eqs_i []]]]]]], ceqt_refl []]
l3: $ (⟦ x / t ⟧ (((((((cl_sty_nil ∪ (cl_sty_app J)) ∪ ((cl_cwf_pi J) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (cl_ctx_wf_cons J)) ∪ (cl_tys_ty_nil ∪ (cl_tys_ty_cons J))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop J))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (cl_fprops_s J)) ∪ pr_proj_ok) ∪ ((cl_add_eqs_i J) ∪ ((cl_pred_eqs_i J) ∪ (cl_sub_eqs_i J)))))) ∪ (((((cl_mul_eqs_i J) ∪ (cl_pow_eqs_i J)) ∪ ((cl_beq_eqs_i J) ∪ (cl_ble_eqs_i J))) ∪ (((cl_shl_eqs_i J) ∪ (cl_shr_eqs_i J)) ∪ ((cl_dec_eqs_i J) ∪ (cl_ite_eqs_i J)))) ∪ ((((cl_natle_dec_i J) ∪ (cl_nateq_dec_i J)) ∪ ((cl_bool_dec_i J) ∪ (cl_div_eqs_i J))) ∪ (((cl_mod_eqs_i J) ∪ (cl_fix_eqs_i J)) ∪ ((cl_gcd_eqs_i J) ∪ ((cl_bitwise_eqs_i J) ∪ (cl_bitop_eqs_i J))))))) ∩ (fseq latoms × latoms))) ≐ (((((((cl_sty_nil ∪ (cl_sty_app (⟦ x / t ⟧ J))) ∪ ((cl_cwf_pi (⟦ x / t ⟧ J)) ∪ cl_cwf_res)) ∪ (pr_ctors_wf ∪ pr_tys_wf)) ∪ (((cl_ctx_wf_nil ∪ (cl_ctx_wf_cons (⟦ x / t ⟧ J))) ∪ (cl_tys_ty_nil ∪ (cl_tys_ty_cons (⟦ x / t ⟧ J)))) ∪ (pr_tys_ok ∪ pr_ind_wf))) ∪ (((pr_nst_ok ∪ pr_large) ∪ ((cl_fir_res ∪ (cl_fir_arg ∪ (cl_fir_prop (⟦ x / t ⟧ J)))) ∪ pr_elim_ok)) ∪ (((cl_fprops_z ∪ (cl_fprops_s (⟦ x / t ⟧ J))) ∪ pr_proj_ok) ∪ ((cl_add_eqs_i (⟦ x / t ⟧ J)) ∪ ((cl_pred_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_sub_eqs_i (⟦ x / t ⟧ J))))))) ∪ (((((cl_mul_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_pow_eqs_i (⟦ x / t ⟧ J))) ∪ ((cl_beq_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_ble_eqs_i (⟦ x / t ⟧ J)))) ∪ (((cl_shl_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_shr_eqs_i (⟦ x / t ⟧ J))) ∪ ((cl_dec_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_ite_eqs_i (⟦ x / t ⟧ J))))) ∪ ((((cl_natle_dec_i (⟦ x / t ⟧ J)) ∪ (cl_nateq_dec_i (⟦ x / t ⟧ J))) ∪ ((cl_bool_dec_i (⟦ x / t ⟧ J)) ∪ (cl_div_eqs_i (⟦ x / t ⟧ J)))) ∪ (((cl_mod_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_fix_eqs_i (⟦ x / t ⟧ J))) ∪ ((cl_gcd_eqs_i (⟦ x / t ⟧ J)) ∪ ((cl_bitwise_eqs_i (⟦ x / t ⟧ J)) ∪ (cl_bitop_eqs_i (⟦ x / t ⟧ J)))))))) ∩ (fseq latoms × latoms)) $ by ceqt_trans [l1, l2]

lemma i8_lrel3_congr (J J2: class): $ J ≐ J2 $ > $ lrel3 J ≐ lrel3 J2 $
-----
l1: $ horn (lprog3 J) ≐ horn (lprog3 J2) $ by horn_congr [i8_lprog3_congr [#1]]

lemma i8_sb_lrel3 {x: set} (t: set x) (J: class x): $ (⟦ x / t ⟧ (lrel3 J)) ≐ lrel3 (⟦ x / t ⟧ J) $
-----
l1: $ (⟦ x / t ⟧ (horn (lprog3 J))) ≐ horn (⟦ x / t ⟧ (lprog3 J)) $ by sb_c_horn
l2: $ horn (⟦ x / t ⟧ (lprog3 J)) ≐ horn (lprog3 (⟦ x / t ⟧ J)) $ by horn_congr [i8_sb_lprog3 []]
l3: $ (⟦ x / t ⟧ (horn (lprog3 J))) ≐ horn (lprog3 (⟦ x / t ⟧ J)) $ by ceqt_trans [l1, l2]

icwf_congr
----------
c1: $ (cv p) ≐ (cv p) $ by ceqt_refl
ct: $ (cv t) ≐ (cv t) $ by ceqt_refl
cn: $ (cv n) ≐ (cv n) $ by ceqt_refl
cm: $ (cv m) ≐ (cv m) $ by ceqt_refl
cl: $ (cv l) ≐ (cv l) $ by ceqt_refl
cx: $ (cv x) ≐ (cv x) $ by ceqt_refl
cj: $ (cv j) ≐ (cv j) $ by ceqt_refl
cc: $ (cv c) ≐ (cv c) $ by ceqt_refl
ck: $ (cv k) ≐ (cv k) $ by ceqt_refl
ci: $ (cv i) ≐ (cv i) $ by ceqt_refl
c0: $ ⟨ kc_nz , ∅ ⟩ ≐ ⟨ kc_nz , ∅ ⟩ $ by ceqt_refl
n1: $ (iprt C p t) ⟺ (iprt D p t) $ by iprt_congr [#2, c1, ct]
n2: $ (ra_clen p m ∈ lrel) ⟺ (ra_clen p m ∈ lrel) $ by iff_refl
n3: $ (ictk C j c k) ⟺ (ictk D j c k) $ by ictk_congr [#2, cj, cc, ck]
k1: $ lrel3 A ≐ lrel3 B $ by i8_lrel3_congr [#1]
n4: $ (ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k) ≐ (ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k) $ by ra_cwf_congr [#2, cn, cm, cl, ci, cx, c0, ck]
n5: $ (ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A) ⟺ (ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B) $ by wcel_congr [n4, k1]
n6a: $ (fv nvf i = j) ⟺ (fv nvf i = j) $ by iff_refl
n6: $ (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A) ⟺ (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B) $ by and_congr [n6a, n5]
n7: $ (∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)) ⟺ (∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)) $ by ex_congr [n6]
n8: $ (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)) ⟺ (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)) $ by im_congr [n3, n7]
n9: $ (∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A))) ⟺ (∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B))) $ by all_congr [n8]
n10: $ (∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A))) ⟺ (∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B))) $ by all_congr [n9]
n11: $ (∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A))) ⟺ (∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B))) $ by all_congr [n10]
n12: $ (ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A))) ⟺ (ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B))) $ by and_congr [n2, n11]
n13: $ (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A))) ⟺ (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B))) $ by and_congr [n1, n12]
ex: $ (∃ x (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ (∃ x (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)))) $ by ex_congr [n13]
el: $ (∃ l ∃ x (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ (∃ l ∃ x (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)))) $ by ex_congr [ex]
em: $ (∃ m ∃ l ∃ x (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ (∃ m ∃ l ∃ x (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)))) $ by ex_congr [el]
en: $ (∃ n ∃ m ∃ l ∃ x (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ (∃ n ∃ m ∃ l ∃ x (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)))) $ by ex_congr [em]
et: $ (∃ t ∃ n ∃ m ∃ l ∃ x (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ (∃ t ∃ n ∃ m ∃ l ∃ x (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)))) $ by ex_congr [en]
ep: $ (∃ p ∃ t ∃ n ∃ m ∃ l ∃ x (iprt C p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk C j c k → ∃ i (fv nvf i = j ∧ ra_cwf C n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ (∃ p ∃ t ∃ n ∃ m ∃ l ∃ x (iprt D p t ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk D j c k → ∃ i (fv nvf i = j ∧ ra_cwf D n m l i x ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 B)))) $ by ex_congr [et]

sb_f_icwf
---------
l1: $ [x/t] (∃ p ∃ q ∃ n ∃ m ∃ l ∃ y (iprt B p q ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk B j c k → ∃ i (fv nvf i = j ∧ ra_cwf B n m l i y ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ ∃ p ∃ q ∃ n ∃ m ∃ l ∃ y (iprt (⟦ x / t ⟧ B) p q ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk (⟦ x / t ⟧ B) j c k → ∃ i (fv nvf i = j ∧ ra_cwf (⟦ x / t ⟧ B) n m l i y ⟨ kc_nz , ∅ ⟩ k ∈ (⟦ x / t ⟧ (lrel3 A))))) $ by iff_refl
l2: $ (∃ p ∃ q ∃ n ∃ m ∃ l ∃ y (iprt (⟦ x / t ⟧ B) p q ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk (⟦ x / t ⟧ B) j c k → ∃ i (fv nvf i = j ∧ ra_cwf (⟦ x / t ⟧ B) n m l i y ⟨ kc_nz , ∅ ⟩ k ∈ (⟦ x / t ⟧ (lrel3 A)))))) ⟺ ∃ p ∃ q ∃ n ∃ m ∃ l ∃ y (iprt (⟦ x / t ⟧ B) p q ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk (⟦ x / t ⟧ B) j c k → ∃ i (fv nvf i = j ∧ ra_cwf (⟦ x / t ⟧ B) n m l i y ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 (⟦ x / t ⟧ A)))) $ by ex_congr [ex_congr [ex_congr [ex_congr [ex_congr [ex_congr [and_congr [iff_refl [], and_congr [iff_refl [], all_congr [all_congr [all_congr [im_congr [iff_refl [], ex_congr [and_congr [iff_refl [], wcel_congr [ceqt_refl [], i8_sb_lrel3 []]]]]]]]]]]]]]]]
l3: $ [x/t] (∃ p ∃ q ∃ n ∃ m ∃ l ∃ y (iprt B p q ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk B j c k → ∃ i (fv nvf i = j ∧ ra_cwf B n m l i y ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 A)))) ⟺ ∃ p ∃ q ∃ n ∃ m ∃ l ∃ y (iprt (⟦ x / t ⟧ B) p q ∧ ra_clen p m ∈ lrel ∧ ∀ j ∀ c ∀ k (ictk (⟦ x / t ⟧ B) j c k → ∃ i (fv nvf i = j ∧ ra_cwf (⟦ x / t ⟧ B) n m l i y ⟨ kc_nz , ∅ ⟩ k ∈ lrel3 (⟦ x / t ⟧ A)))) $ by iff_trans [l1, l2]

lemma i8_or_case (G: hyps) (p q c: fml): $ G , p ⇒ c $ > $ G , q ⇒ c $ > $ G , p ∨ q ⇒ c $
----
l1: $ G , p ∨ q ⇒ p ∨ q $ by ax
l2: $ G , p ∨ q , p ⇒ c $ by weaken [#1]
l3: $ G , p ∨ q , q ⇒ c $ by weaken [#2]
l4: $ G , p ∨ q ⇒ c $ by or_elim [l1, l2, l3]

--| The trees `y` whose paths are the same at valuations that agree below any `k` with
--| `closed k y` derivable.
def i8_ecp (U M W: class) (.y .k .a .b .i: set): class = $ {y | ∀ k ∀ a ∀ b (⟨ kr_closed , scons k (scons y ∅) ⟩ ∈ lrel → a ∊ fseq U → b ∊ fseq U → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel U (dnf U M) y W a = etel U (dnf U M) y W b)} $

lemma i8_ecp_e {i: set} (G: hyps i) (M: class) (u w x c d e: set): $ G ⇒ x ∊ i8_ecp u M w $ > $ G ⇒ ra_closed c x ∈ lrel $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) $ > $ G ⇒ etel u (dnf u M) x w d = etel u (dnf u M) x w e $
----
l1: $ G ⇒ ∀ k ∀ a ∀ b (⟨ kr_closed , scons k (scons x ∅) ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b) $ by cab_elim [#1]
l2: $ G ⇒ ∀ a ∀ b (⟨ kr_closed , scons c (scons x ∅) ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf c → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b) $ by all_elim [l1]
l3: $ G ⇒ ∀ b (⟨ kr_closed , scons c (scons x ∅) ⟩ ∈ lrel → d ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf c → fv d i = fv b i) → etel u (dnf u M) x w d = etel u (dnf u M) x w b) $ by all_elim [l2]
l4: $ G ⇒ ⟨ kr_closed , scons c (scons x ∅) ⟩ ∈ lrel → d ∊ fseq u → e ∊ fseq u → ∀ i (i ∊ fv nvf c → fv d i = fv e i) → etel u (dnf u M) x w d = etel u (dnf u M) x w e $ by all_elim [l3]
l5: $ G ⇒ d ∊ fseq u → e ∊ fseq u → ∀ i (i ∊ fv nvf c → fv d i = fv e i) → etel u (dnf u M) x w d = etel u (dnf u M) x w e $ by imp_elim [l4, #2]
l6: $ G ⇒ e ∊ fseq u → ∀ i (i ∊ fv nvf c → fv d i = fv e i) → etel u (dnf u M) x w d = etel u (dnf u M) x w e $ by imp_elim [l5, #3]
l7: $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) → etel u (dnf u M) x w d = etel u (dnf u M) x w e $ by imp_elim [l6, #4]
l8: $ G ⇒ etel u (dnf u M) x w d = etel u (dnf u M) x w e $ by imp_elim [l7, #5]

lemma i8_ecp_i {k a b i: set} (G: hyps) (M: class) (u w x: set): $ G , ra_closed k x ∈ lrel , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ fv nvf k → fv a i = fv b i) ⇒ etel u (dnf u M) x w a = etel u (dnf u M) x w b $ > $ G ⇒ x ∊ i8_ecp u M w $
----
l1: $ G , ra_closed k x ∈ lrel , a ∊ fseq u , b ∊ fseq u ⇒ ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b $ by imp_intro [#1]
l2: $ G , ra_closed k x ∈ lrel , a ∊ fseq u ⇒ b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b $ by imp_intro [l1]
l3: $ G , ra_closed k x ∈ lrel ⇒ a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b $ by imp_intro [l2]
l4: $ G ⇒ ⟨ kr_closed , scons k (scons x ∅) ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b $ by imp_intro [l3]
l5: $ G ⇒ ∀ b (⟨ kr_closed , scons k (scons x ∅) ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b) $ by all_intro [l4]
l6: $ G ⇒ ∀ a ∀ b (⟨ kr_closed , scons k (scons x ∅) ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b) $ by all_intro [l5]
l7: $ G ⇒ ∀ k ∀ a ∀ b (⟨ kr_closed , scons k (scons x ∅) ⟩ ∈ lrel → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ fv nvf k → fv a i = fv b i) → etel u (dnf u M) x w a = etel u (dnf u M) x w b) $ by all_intro [l6]
l8: $ G ⇒ x ∊ i8_ecp u M w $ by cab_intro [l7]

lemma i8_agr {i: set} (G: hyps i) (K L A B C D: class): $ G ⇒ K = L $ > $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ ∀ i (i ∊ K → fv A i = fv B i) $ > $ G ⇒ ∀ i (i ∊ L → fv C i = fv D i) $
----
l1: $ G , j ∊ L ⇒ j ∊ L $ by ax
l2a: $ G , j ∊ L ⇒ K = L $ by weaken [#1]
l2: $ G , j ∊ L ⇒ L = K $ by eq_sym [l2a]
l3: $ G , j ∊ L ⇒ j ∊ K $ by welc_eq [l2, l1]
l4a: $ G , j ∊ L ⇒ ∀ i (i ∊ K → fv A i = fv B i) $ by weaken [#4]
l4: $ G , j ∊ L ⇒ j ∊ K → fv A j = fv B j $ by all_elim [l4a]
l5: $ G , j ∊ L ⇒ fv A j = fv B j $ by imp_elim [l4, l3]
l6: $ G , j ∊ L ⇒ j = j $ by eq_refl
l7a: $ G , j ∊ L ⇒ A = C $ by weaken [#2]
l7: $ G , j ∊ L ⇒ C = A $ by eq_sym [l7a]
l8: $ G , j ∊ L ⇒ fv C j = fv A j $ by fv_eq [l7, l6]
l9a: $ G , j ∊ L ⇒ B = D $ by weaken [#3]
l9: $ G , j ∊ L ⇒ fv B j = fv D j $ by fv_eq [l9a, l6]
l10: $ G , j ∊ L ⇒ fv C j = fv B j $ by eq_trans [l8, l5]
l11: $ G , j ∊ L ⇒ fv C j = fv D j $ by eq_trans [l10, l9]
l12: $ G ⇒ j ∊ L → fv C j = fv D j $ by imp_intro [l11]
l13: $ G ⇒ ∀ j (j ∊ L → fv C j = fv D j) $ by all_intro [l12]
l14: $ _ ⇒ ∀ j (j ∊ L → fv C j = fv D j) ↔ ∀ i (i ∊ L → fv C i = fv D i) $ by all_alpha
l15: $ G ⇒ ∀ j (j ∊ L → fv C j = fv D j) ↔ ∀ i (i ∊ L → fv C i = fv D i) $ by weaken [l14]
l16: $ G ⇒ ∀ i (i ∊ L → fv C i = fv D i) $ by bi_elim_l [l15, l13]

lemma i8_ch (G: hyps) (X K S: class) (z c j: set): $ G ⇒ crn j ⊆ X $ > $ G ⇒ z = ⟨ c , j ⟩ $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ > $ G ⇒ crn S ⊆ X $
----
l1: $ G ⇒ ⟨ c , j ⟩ = z $ by eq_sym [#2]
l2: $ G ⇒ ⟨ c , j ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #3]
l3: $ G ⇒ isset c $ by isset_var
l4: $ G ⇒ isset j $ by isset_var
l5: $ G ⇒ c = K ∧ j = S $ by opair_inj_c [l2, l3, l4, #4, #5]
l6: $ G ⇒ j = S $ by and_elim_r [l5]
l7: $ G ⇒ crn j = crn S $ by crn_eq [l6]
l8: $ G ⇒ crn S ⊆ X $ by subset_eq_l [l7, #1]

lemma i8_ztree (G: hyps) (k j z: set): $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ trees ω $
----
l1: $ G ⇒ ⟨ k , j ⟩ ∈ ω × fseq (trees ω) $ by cxp_intro [#1, #2]
l2: $ G ⇒ isset ω $ by omega_set
l3: $ G ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [l2]
l4: $ G ⇒ ⟨ k , j ⟩ ∈ trees ω $ by wcel_eq_r [l3, l1]
l5: $ G ⇒ ⟨ k , j ⟩ = z $ by eq_sym [#3]
l6: $ G ⇒ z ∈ trees ω $ by wcel_eq_l [l5, l4]
l7: $ G ⇒ z ∊ trees ω $ by wcel_welc [l6]

lemma i8_ecp_ec {i: set} (G: hyps i) (M: class) (u w x k: set) (A B: class): $ G ⇒ x ∊ i8_ecp u M w $ > $ G ⇒ ra_closed k x ∈ lrel $ > $ G ⇒ A ∈ fseq u $ > $ G ⇒ B ∈ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf k → fv A i = fv B i) $ > $ G ⇒ etel u (dnf u M) x w A = etel u (dnf u M) x w B $
----
h1: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ a = A $ by ax
h1s: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ A = a $ by eq_sym [h1]
h2: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ b = B $ by ax
h2s: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ B = b $ by eq_sym [h2]
h3: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ fv nvf k = fv nvf k $ by eq_refl
h4a: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ ∀ i (i ∊ fv nvf k → fv A i = fv B i) $ by weaken [#5]
h4: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ ∀ i (i ∊ fv nvf k → fv a i = fv b i) $ by i8_agr [h3, h1s, h2s, h4a]
h5a: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ x ∊ i8_ecp u M w $ by weaken [#1]
h5b: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ ra_closed k x ∈ lrel $ by weaken [#2]
h5c: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ a ∊ fseq u $ by ax
h5d: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ b ∊ fseq u $ by ax
h5: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ etel u (dnf u M) x w a = etel u (dnf u M) x w b $ by i8_ecp_e [h5a, h5b, h5c, h5d, h4]
r3: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ x = x $ by eq_refl
r4: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ w = w $ by eq_refl
h6: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ etel u (dnf u M) x w A = etel u (dnf u M) x w a $ by etel_eq [r3, r4, h1s]
h7: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ etel u (dnf u M) x w b = etel u (dnf u M) x w B $ by etel_eq [r3, r4, h2]
h8: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ etel u (dnf u M) x w A = etel u (dnf u M) x w b $ by eq_trans [h6, h5]
h9: $ G , a = A , a ∊ fseq u , b = B , b ∊ fseq u ⇒ etel u (dnf u M) x w A = etel u (dnf u M) x w B $ by eq_trans [h8, h7]
h10: $ G , a = A , a ∊ fseq u ⇒ etel u (dnf u M) x w A = etel u (dnf u M) x w B $ by wcel_elim [#4, h9]
h11: $ G ⇒ etel u (dnf u M) x w A = etel u (dnf u M) x w B $ by wcel_elim [#3, h10]

lemma i8_body {i: set} (G: hyps i) (M: class) (u w b y c x d e: set): $ G ⇒ b ∊ i8_ecp u M w $ > $ G ⇒ ra_closed y b ∈ lrel $ > $ G ⇒ fv nvf y = suc (fv nvf c) $ > $ G ⇒ fv nvf c ∈ ω $ > $ G ⇒ x ∊ u $ > $ G ⇒ d ∊ fseq u $ > $ G ⇒ e ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) $ > $ G ⇒ etel u (dnf u M) b w (scons x d) = etel u (dnf u M) b w (scons x e) $
----
p1: $ G ⇒ scons x d ∈ fseq u $ by scons_fseq [#5, #6]
p2: $ G ⇒ scons x e ∈ fseq u $ by scons_fseq [#5, #7]
p3y1: $ _ ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) ↔ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by all_alpha
p3y2: $ G ⇒ ∀ i (i ∊ fv nvf c → fv d i = fv e i) ↔ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by weaken [p3y1]
p3y3: $ G ⇒ ∀ j (j ∊ fv nvf c → fv d j = fv e j) $ by bi_elim_l [p3y2, #8]
p3y4: $ G ⇒ ∀ j (j ∊ suc (fv nvf c) → fv (scons x d) j = fv (scons x e) j) $ by scons_agree [#4, p3y3]
p3y5: $ G ⇒ suc (fv nvf c) = fv nvf y $ by eq_sym [#3]
p3y6: $ G ⇒ scons x d = scons x d $ by eq_refl
p3y7: $ G ⇒ scons x e = scons x e $ by eq_refl
p3y8: $ G ⇒ ∀ j (j ∊ fv nvf y → fv (scons x d) j = fv (scons x e) j) $ by i8_agr [p3y5, p3y6, p3y7, p3y4]
p3y9: $ _ ⇒ ∀ j (j ∊ fv nvf y → fv (scons x d) j = fv (scons x e) j) ↔ ∀ i (i ∊ fv nvf y → fv (scons x d) i = fv (scons x e) i) $ by all_alpha
p3y10: $ G ⇒ ∀ j (j ∊ fv nvf y → fv (scons x d) j = fv (scons x e) j) ↔ ∀ i (i ∊ fv nvf y → fv (scons x d) i = fv (scons x e) i) $ by weaken [p3y9]
p3: $ G ⇒ ∀ i (i ∊ fv nvf y → fv (scons x d) i = fv (scons x e) i) $ by bi_elim_l [p3y10, p3y8]
p4: $ G ⇒ etel u (dnf u M) b w (scons x d) = etel u (dnf u M) b w (scons x e) $ by i8_ecp_ec [#1, #2, p1, p2, p3]

lemma i8_pi_sub (G: hyps) {x f g t a y: set} (U E X X2 T T2: class) (w q d e: set): $ G ⇒ X = X2 $ > $ G ⇒ T = T2 $ > $ G ⇒ ∀ x (x ∊ U → etel U E q w (scons x d) = etel U E q w (scons x e)) $ > $ G ⇒ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩)} ⊆ {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ X2 ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T2 t , a ⟩ ⟩ ⟩)} $
----
a1: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ $ by ax
a2: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ x ∊ X $ by and_elim_l [a1]
a3: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ $ by and_elim_r [a1]
a4: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ x ∊ U $ by and_elim_l [a3]
a5: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ $ by and_elim_r [a3]
a6: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) $ by and_elim_l [a5]
a7: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ $ by and_elim_r [a5]
b1: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ X = X2 $ by weaken [#1]
b2: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ x ∊ X2 $ by welc_eq [b1, a2]
b3: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ ∀ x (x ∊ U → etel U E q w (scons x d) = etel U E q w (scons x e)) $ by weaken [#3]
b4: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ x ∊ U → etel U E q w (scons x d) = etel U E q w (scons x e) $ by all_elim [b3]
b5: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ etel U E q w (scons x d) = etel U E q w (scons x e) $ by imp_elim [b4, a4]
b6: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x e) $ by wcel_eq_r [b5, a6]
b7: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ T = T2 $ by weaken [#2]
b8: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ t = t $ by eq_refl
b9: $ G , x ∊ X ∧ x ∊ U ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E q w (scons x d) ∧ v = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons T t , a ⟩ ⟩ ⟩ ⇒ scons T t = scons T2 t $ by scons_eq [b7, b8]
