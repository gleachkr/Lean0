h5: $ G ⇒ dt u M t5 W R = ∅ $ by or_elim [a1, e12, h4]

--| Class form of `i9_ipos_out` in the depth.
lemma i9_ipos_out_c (G: hyps) (M W R T: class) (u t1 t2 t3 t5: set): $ G ⇒ ra_ipos t1 t2 t3 T t5 ∈ lrel $ > $ G ⇒ isset T $ > $ G ⇒ t5 ∊ trees ω $ > $ G ⇒ ¬ R ∈ fseq u $ > $ G ⇒ dt u M t5 W R = ∅ $
----
l1: $ G , o = T ⇒ o = T $ by ax
l2: $ G , o = T ⇒ T = o $ by eq_sym [l1]
l3a: $ G , o = T ⇒ t1 = t1 $ by eq_refl
l3b: $ G , o = T ⇒ t2 = t2 $ by eq_refl
l3c: $ G , o = T ⇒ t3 = t3 $ by eq_refl
l3d: $ G , o = T ⇒ t5 = t5 $ by eq_refl
l4: $ G , o = T ⇒ ra_ipos t1 t2 t3 T t5 = ra_ipos t1 t2 t3 o t5 $ by ra_ipos_eq [l3a, l3b, l3c, l2, l3d]
l5: $ G , o = T ⇒ ra_ipos t1 t2 t3 T t5 ∈ lrel $ by weaken [#1]
l6: $ G , o = T ⇒ ra_ipos t1 t2 t3 o t5 ∈ lrel $ by wcel_eq_l [l4, l5]
l7: $ G , o = T ⇒ t5 ∊ trees ω $ by weaken [#3]
l8: $ G , o = T ⇒ ¬ R ∈ fseq u $ by weaken [#4]
l9: $ G , o = T ⇒ dt u M t5 W R = ∅ $ by i9_ipos_out [l6, l7, l8]
l10: $ G ⇒ dt u M t5 W R = ∅ $ by isset_elim [#2, l9]

--| Traces into larger unions.
lemma i9_clam_sub {x: set} (G: hyps) (A: class) (B C: class x): $ G ⇒ ∀ x (x ∊ A → B ⊆ C) $ > $ G ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $
----
n1: $ G , c ∊ clam x A (⋃ B) ⇒ c ∊ clam x A (⋃ B) $ by ax
n2: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ b ∊ ⋃ (⟦ x / a ⟧ B) $ by ax
n3a: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ ∀ x (x ∊ A → B ⊆ C) $ by weaken [#1]
n3b: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ a ∊ A → (⟦ x / a ⟧ B) ⊆ (⟦ x / a ⟧ C) $ by all_elim [n3a]
n3c: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ a ∊ A $ by ax
n3d: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ (⟦ x / a ⟧ B) ⊆ (⟦ x / a ⟧ C) $ by imp_elim [n3b, n3c]
n3e0: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ e ∊ (⟦ x / a ⟧ B) $ by ax
n3e: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ e ∊ (⟦ x / a ⟧ C) $ by subset_elim [n3d, n3e0]
n3f: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ b ∊ e $ by ax
n3: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) , e ∊ (⟦ x / a ⟧ B) , b ∊ e ⇒ b ∊ ⋃ (⟦ x / a ⟧ C) $ by cuni_intro [n3f, n3e]
n4: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ b ∊ ⋃ (⟦ x / a ⟧ C) $ by cuni_elim [n2, n3]
n5a: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ a ∊ A $ by ax
n5: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ ⟨ a , b ⟩ ∈ clam x A (⋃ C) $ by clam_intro [n5a, n4]
n6: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ c = ⟨ a , b ⟩ $ by ax
n7: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ ⟨ a , b ⟩ = c $ by eq_sym [n6]
n8: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ c ∈ clam x A (⋃ C) $ by wcel_eq_l [n7, n5]
n9: $ G , c ∊ clam x A (⋃ B) , c = ⟨ a , b ⟩ , a ∊ A , b ∊ ⋃ (⟦ x / a ⟧ B) ⇒ c ∊ clam x A (⋃ C) $ by wcel_welc [n8]
n10: $ G , c ∊ clam x A (⋃ B) ⇒ c ∊ clam x A (⋃ C) $ by clam_elim_mem [n1, n9]
n11: $ G ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $ by subset_intro [n10]

--| The function space grows with its codomain.
lemma i9_cpi_mono {x: set} (G: hyps) (A: class) (B C: class x): $ G ⇒ ∀ x (x ∊ A → B ⊆ C) $ > $ G ⇒ cpi x A B ⊆ cpi x A C $
----
l1: $ G , f ∊ cpi x A B ⇒ f ∊ cpi x A B $ by ax
l2: $ G , f ∊ cpi x A B ⇒ f ⊆ clam x A (⋃ B) $ by cpi_elim_sub [l1]
l3a: $ G ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $ by i9_clam_sub [#1]
l3: $ G , f ∊ cpi x A B ⇒ clam x A (⋃ B) ⊆ clam x A (⋃ C) $ by weaken [l3a]
l4: $ G , f ∊ cpi x A B ⇒ f ⊆ clam x A (⋃ C) $ by subset_trans [l2, l3]
m0: $ G , f ∊ cpi x A B , y ∊ A ⇒ f ∊ cpi x A B $ by weaken [l1]
m0b: $ G , f ∊ cpi x A B , y ∊ A ⇒ y ∊ A $ by ax
m1: $ G , f ∊ cpi x A B , y ∊ A ⇒ ap f y ∈ (⟦ x / y ⟧ B) $ by cpi_elim_ap [m0, m0b]
m2: $ G , f ∊ cpi x A B , y ∊ A ⇒ ∀ x (x ∊ A → B ⊆ C) $ by weaken [#1]
m3: $ G , f ∊ cpi x A B , y ∊ A ⇒ y ∊ A → (⟦ x / y ⟧ B) ⊆ (⟦ x / y ⟧ C) $ by all_elim [m2]
m4: $ G , f ∊ cpi x A B , y ∊ A ⇒ (⟦ x / y ⟧ B) ⊆ (⟦ x / y ⟧ C) $ by imp_elim [m3, m0b]
m5: $ G , f ∊ cpi x A B , y ∊ A ⇒ ap f y ∈ (⟦ x / y ⟧ C) $ by wcel_subset [m4, m1]
m6: $ G , f ∊ cpi x A B ⇒ y ∊ A → ap f y ∈ (⟦ x / y ⟧ C) $ by imp_intro [m5]
m7: $ G , f ∊ cpi x A B ⇒ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ C)) $ by all_intro [m6]
m8: $ _ ⇒ ∀ x (x ∊ A → ap f x ∈ C) ↔ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ C)) $ by all_alpha
m9: $ G , f ∊ cpi x A B ⇒ ∀ x (x ∊ A → ap f x ∈ C) ↔ ∀ y (y ∊ A → ap f y ∈ (⟦ x / y ⟧ C)) $ by weaken [m8]
m10: $ G , f ∊ cpi x A B ⇒ ∀ x (x ∊ A → ap f x ∈ C) $ by bi_elim_r [m9, m7]
l6: $ G , f ∊ cpi x A B ⇒ f ∊ cpi x A C $ by cpi_intro [l4, m10]
l7: $ G ⇒ cpi x A B ⊆ cpi x A C $ by subset_intro [l6]

--| Entrywise inclusion survives a common head.
lemma i9_scons_sub {i: set} (G: hyps) (x a b: set): $ G ⇒ ∀ i (fv a i ⊆ fv b i) $ > $ G ⇒ ∀ i (fv (scons x a) i ⊆ fv (scons x b) i) $
----
q0: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z ⇒ z ∊ ap (scons x a) i $ by ax
q1: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z ⇒ ⟨ i , z ⟩ ∈ scons x a $ by cab_elim [q0]
q2a: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z ⇒ isset i $ by isset_var
q2b: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z ⇒ isset x $ by isset_var
q3: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z ⇒ (i = ∅ ∧ z = x) ∨ ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) $ by scons_pair [q1, q2a, q2b]
r0: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ i = ∅ ∧ z = x $ by ax
r1: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ i = ∅ $ by and_elim_l [r0]
r2: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ z = x $ by and_elim_r [r0]
r2b: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ y ∊ z $ by ax
r3: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ y ∊ x $ by welc_eq [r2, r2b]
r4: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ fv (scons x b) ∅ = x $ by scons_fv_zero
r5: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ x = fv (scons x b) ∅ $ by eq_sym [r4]
r6a: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ scons x b = scons x b $ by eq_refl
r6: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ fv (scons x b) i = fv (scons x b) ∅ $ by fv_eq [r6a, r1]
r7: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ fv (scons x b) ∅ = fv (scons x b) i $ by eq_sym [r6]
r8: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ x = fv (scons x b) i $ by eq_trans [r5, r7]
r9: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = ∅ ∧ z = x ⇒ y ∊ fv (scons x b) i $ by welc_eq [r8, r3]
s0: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ i = suc j ∧ ⟨ j , z ⟩ ∈ a $ by ax
s1: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ i = suc j $ by and_elim_l [s0]
s2: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ ⟨ j , z ⟩ ∈ a $ by and_elim_r [s0]
s3: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ z ∊ ap a j $ by cab_intro [s2]
s3b: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ y ∊ z $ by ax
s4: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ y ∊ fv a j $ by cuni_intro [s3b, s3]
s5: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ ∀ i (fv a i ⊆ fv b i) $ by weaken [#1]
s6: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ fv a j ⊆ fv b j $ by all_elim [s5]
s7: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ y ∊ fv b j $ by subset_elim [s6, s4]
s8: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ fv (scons x b) (suc j) = fv b j $ by scons_fv_suc
s9a: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ scons x b = scons x b $ by eq_refl
s9: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ fv (scons x b) i = fv (scons x b) (suc j) $ by fv_eq [s9a, s1]
s10: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ fv (scons x b) i = fv b j $ by eq_trans [s9, s8]
s11: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ fv b j = fv (scons x b) i $ by eq_sym [s10]
s12: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , i = suc j ∧ ⟨ j , z ⟩ ∈ a ⇒ y ∊ fv (scons x b) i $ by welc_eq [s11, s7]
s13: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) ⇒ ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) $ by ax
s14: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z , ∃ j (i = suc j ∧ ⟨ j , z ⟩ ∈ a) ⇒ y ∊ fv (scons x b) i $ by ex_elim [s13, s12]
t1: $ G , y ∊ fv (scons x a) i , z ∊ ap (scons x a) i , y ∊ z ⇒ y ∊ fv (scons x b) i $ by or_elim [q3, r9, s14]
t2: $ G , y ∊ fv (scons x a) i ⇒ y ∊ fv (scons x a) i $ by ax
t3: $ G , y ∊ fv (scons x a) i ⇒ y ∊ fv (scons x b) i $ by cuni_elim [t2, t1]
t4: $ G ⇒ fv (scons x a) i ⊆ fv (scons x b) i $ by subset_intro [t3]
t5: $ G ⇒ ∀ i (fv (scons x a) i ⊆ fv (scons x b) i) $ by all_intro [t4]

--| Entrywise inclusion under equal valuations.
lemma i9_sagr {i: set} (G: hyps i) (A B C D: class): $ G ⇒ A = C $ > $ G ⇒ B = D $ > $ G ⇒ ∀ i (fv A i ⊆ fv B i) $ > $ G ⇒ ∀ i (fv C i ⊆ fv D i) $
----
l2: $ G ⇒ j = j $ by eq_refl
l3: $ G ⇒ fv A j = fv C j $ by fv_eq [#1, l2]
l4: $ G ⇒ fv B j = fv D j $ by fv_eq [#2, l2]
l5: $ G ⇒ fv A j ⊆ fv B j $ by all_elim [#3]
l6: $ G ⇒ fv C j ⊆ fv B j $ by subset_eq_l [l3, l5]
l7: $ G ⇒ fv C j ⊆ fv D j $ by subset_eq_r [l4, l6]
l8: $ G ⇒ ∀ j (fv C j ⊆ fv D j) $ by all_intro [l7]
l9: $ _ ⇒ ∀ j (fv C j ⊆ fv D j) ↔ ∀ i (fv C i ⊆ fv D i) $ by all_alpha
l10: $ G ⇒ ∀ j (fv C j ⊆ fv D j) ↔ ∀ i (fv C i ⊆ fv D i) $ by weaken [l9]
l11: $ G ⇒ ∀ i (fv C i ⊆ fv D i) $ by bi_elim_l [l10, l8]

--| The trees `y` whose value, at every depth `d` of a derivable `ipos D N Q d y`, grows
--| with the entries of valuations that agree below `d + Q`.
def i9_pm (U M W D N Q: class) (.y .d .a .b .i: set): class = $ {y | ∀ d ∀ a ∀ b (ra_ipos D N Q d y ∈ lrel → d ∊ trees ω → a ∊ fseq U → b ∊ fseq U → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → dt U M y W a ⊆ dt U M y W b)} $

lemma i9_pm_i {d a b i: set} (G: hyps) (M D N Q: class) (u w y: set): $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) , ∀ i (fv a i ⊆ fv b i) ⇒ dt u M y w a ⊆ dt u M y w b $ > $ G ⇒ y ∊ i9_pm u M w D N Q $
----
l0: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) ⇒ ∀ i (fv a i ⊆ fv b i) → dt u M y w a ⊆ dt u M y w b $ by imp_intro [#1]
l1: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → dt u M y w a ⊆ dt u M y w b $ by imp_intro [l0]
l2: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω , a ∊ fseq u ⇒ b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → dt u M y w a ⊆ dt u M y w b $ by imp_intro [l1]
l3: $ G , ra_ipos D N Q d y ∈ lrel , d ∊ trees ω ⇒ a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → dt u M y w a ⊆ dt u M y w b $ by imp_intro [l2]
