k0k: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar = kc_app $ by and_elim_l [k0j]
