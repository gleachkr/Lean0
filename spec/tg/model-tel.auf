lemma i5_nsub {y p z: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $
----
a1: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} $ by ax
a2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ ∃ p ∃ z (p ∊ A ∧ v = nest p z) $ by cab_elim [a1]
b1: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ A ∧ v = nest p z $ by ax
b2: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ A $ by and_elim_l [b1]
b3: $ G , p ∊ A ∧ v = nest p z ⇒ v = nest p z $ by and_elim_r [b1]
b4: $ G , p ∊ A ∧ v = nest p z ⇒ A = B $ by weaken [#1]
b5: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ B $ by welc_eq [b4, b2]
b6: $ G , p ∊ A ∧ v = nest p z ⇒ p ∊ B ∧ v = nest p z $ by and_intro [b5, b3]
b7: $ G , p ∊ A ∧ v = nest p z ⇒ ∃ z (p ∊ B ∧ v = nest p z) $ by ex_intro [b6]
b8: $ G , p ∊ A ∧ v = nest p z ⇒ ∃ p ∃ z (p ∊ B ∧ v = nest p z) $ by ex_intro [b7]
b9: $ G , p ∊ A ∧ v = nest p z ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by cab_intro [b8]
e0: $ G , ∃ z (p ∊ A ∧ v = nest p z) ⇒ ∃ z (p ∊ A ∧ v = nest p z) $ by ax
e1: $ G , ∃ z (p ∊ A ∧ v = nest p z) ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by ex_elim [e0, b9]
e2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by ex_elim [a2, e1]
e3: $ G ⇒ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by subset_intro [e2]

lemma i5_ipi_sub (G: hyps) (U E E2 P P2 F F2 W W2: class): $ G ⇒ esat U E P W = esat U E2 P2 W2 $ > $ G ⇒ fv E F = fv E2 F2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ipi U E P F W ⊆ ipi U E2 P2 F2 W2 $
----
c1: $ G , x ∊ ipi U E P F W ⇒ x ∊ ipi U E P F W $ by ax
c2: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E P W → apn x q ∈ da (fv E F) W q) $ by cab_elim [c1]
c3: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} $ by and_elim_l [c2]
c4a: $ G , x ∊ ipi U E P F W ⇒ esat U E P W = esat U E2 P2 W2 $ by weaken [#1]
c4: $ G , x ∊ ipi U E P F W ⇒ {y | ∃ p ∃ z (p ∊ esat U E P W ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ esat U E2 P2 W2 ∧ y = nest p z)} $ by i5_nsub [c4a]
c5: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E2 P2 W2 ∧ y = nest p z)} $ by subset_trans [c3, c4]
c6: $ G , x ∊ ipi U E P F W ⇒ ∀ q (q ∊ esat U E P W → apn x q ∈ da (fv E F) W q) $ by and_elim_r [c2]
d5: $ G , x ∊ ipi U E P F W ⇒ q ∊ esat U E P W → apn x q ∈ da (fv E F) W q $ by all_elim [c6]
d1: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q ∊ esat U E2 P2 W2 $ by ax
d2: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ esat U E P W = esat U E2 P2 W2 $ by weaken [#1]
d3: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ esat U E2 P2 W2 = esat U E P W $ by eq_sym [d2]
d4: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q ∊ esat U E P W $ by welc_eq [d3, d1]
d6: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q ∊ esat U E P W → apn x q ∈ da (fv E F) W q $ by weaken [d5]
d7: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ apn x q ∈ da (fv E F) W q $ by imp_elim [d6, d4]
d8: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ fv E F = fv E2 F2 $ by weaken [#2]
d9: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ W = W2 $ by weaken [#3]
d10: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ q = q $ by eq_refl
d11: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ da (fv E F) W q = da (fv E2 F2) W2 q $ by da_eq [d8, d9, d10]
d12: $ G , x ∊ ipi U E P F W , q ∊ esat U E2 P2 W2 ⇒ apn x q ∈ da (fv E2 F2) W2 q $ by wcel_eq_r [d11, d7]
d13: $ G , x ∊ ipi U E P F W ⇒ q ∊ esat U E2 P2 W2 → apn x q ∈ da (fv E2 F2) W2 q $ by imp_intro [d12]
d14: $ G , x ∊ ipi U E P F W ⇒ ∀ q (q ∊ esat U E2 P2 W2 → apn x q ∈ da (fv E2 F2) W2 q) $ by all_intro [d13]
d15: $ G , x ∊ ipi U E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat U E2 P2 W2 ∧ y = nest p z)} ∧ ∀ q (q ∊ esat U E2 P2 W2 → apn x q ∈ da (fv E2 F2) W2 q) $ by and_intro [c5, d14]
d16: $ G , x ∊ ipi U E P F W ⇒ x ∊ ipi U E2 P2 F2 W2 $ by cab_intro [d15]
d17: $ G ⇒ ipi U E P F W ⊆ ipi U E2 P2 F2 W2 $ by subset_intro [d16]

lemma i5_ipi_eq (G: hyps) (U E P P2 F F2 W: class) (W2: class): $ G ⇒ P = P2 $ > $ G ⇒ F = F2 $ > $ G ⇒ W = W2 $ > $ G ⇒ ipi U E P F W = ipi U E P2 F2 W2 $
----
e1b: $ G ⇒ esf U E = esf U E $ by eq_refl
e2: $ G ⇒ fv (esf U E) P = fv (esf U E) P2 $ by fv_eq [e1b, #1]
e3: $ G ⇒ esat U E P W = esat U E P2 W2 $ by ap_eq [e2, #3]
e4: $ G ⇒ E = E $ by eq_refl
e5: $ G ⇒ fv E F = fv E F2 $ by fv_eq [e4, #2]
e6: $ G ⇒ ipi U E P F W ⊆ ipi U E P2 F2 W2 $ by i5_ipi_sub [e3, e5, #3]
e7: $ G ⇒ P2 = P $ by eq_sym [#1]
e8: $ G ⇒ F2 = F $ by eq_sym [#2]
e9: $ G ⇒ W2 = W $ by eq_sym [#3]
e10: $ G ⇒ fv (esf U E) P2 = fv (esf U E) P $ by fv_eq [e1b, e7]
e11: $ G ⇒ esat U E P2 W2 = esat U E P W $ by ap_eq [e10, e9]
e12: $ G ⇒ fv E F2 = fv E F $ by fv_eq [e4, e8]
e13: $ G ⇒ ipi U E P2 F2 W2 ⊆ ipi U E P F W $ by i5_ipi_sub [e11, e12, e9]
e14: $ G ⇒ ipi U E P F W = ipi U E P2 F2 W2 $ by subset_antisym [e6, e13]

lemma i5_ilam_sub (G: hyps) (U E P P2 F F2 W: class): $ G ⇒ esat U E P W = esat U E P2 W $ > $ G ⇒ fv E F = fv E F2 $ > $ G ⇒ ilam U E P F W ⊆ ilam U E P2 F2 W $
----
a1: $ G , c ∊ ilam U E P F W ⇒ c ∊ ilam U E P F W $ by ax
a2: $ G , c ∊ ilam U E P F W ⇒ ∃ p ∃ z (p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z) $ by cab_elim [a1]
b1: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z $ by ax
b2: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ p ∊ esat U E P W $ by and_elim_l [b1]
b3: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ z ∊ da (fv E F) W p ∧ c = nest p z $ by and_elim_r [b1]
b4: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ z ∊ da (fv E F) W p $ by and_elim_l [b3]
b5: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ c = nest p z $ by and_elim_r [b3]
b6: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ esat U E P W = esat U E P2 W $ by weaken [#1]
b7: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ p ∊ esat U E P2 W $ by welc_eq [b6, b2]
b8a: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ fv E F = fv E F2 $ by weaken [#2]
b8b: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ W = W $ by eq_refl
b8c: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ p = p $ by eq_refl
b8: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ da (fv E F) W p = da (fv E F2) W p $ by da_eq [b8a, b8b, b8c]
b9: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ z ∊ da (fv E F2) W p $ by welc_eq [b8, b4]
b10a: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ z ∊ da (fv E F2) W p ∧ c = nest p z $ by and_intro [b9, b5]
b10: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ p ∊ esat U E P2 W ∧ z ∊ da (fv E F2) W p ∧ c = nest p z $ by and_intro [b7, b10a]
b11: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ ∃ z (p ∊ esat U E P2 W ∧ z ∊ da (fv E F2) W p ∧ c = nest p z) $ by ex_intro [b10]
b12: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ ∃ p ∃ z (p ∊ esat U E P2 W ∧ z ∊ da (fv E F2) W p ∧ c = nest p z) $ by ex_intro [b11]
b13: $ G , c ∊ ilam U E P F W , p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z ⇒ c ∊ ilam U E P2 F2 W $ by cab_intro [b12]
c1a: $ G , c ∊ ilam U E P F W , ∃ z (p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z) ⇒ ∃ z (p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z) $ by ax
c1: $ G , c ∊ ilam U E P F W , ∃ z (p ∊ esat U E P W ∧ z ∊ da (fv E F) W p ∧ c = nest p z) ⇒ c ∊ ilam U E P2 F2 W $ by ex_elim [c1a, b13]
c2: $ G , c ∊ ilam U E P F W ⇒ c ∊ ilam U E P2 F2 W $ by ex_elim [a2, c1]
c3: $ G ⇒ ilam U E P F W ⊆ ilam U E P2 F2 W $ by subset_intro [c2]

lemma i5_ilam_eq (G: hyps) (U E P P2 F F2 W: class): $ G ⇒ P = P2 $ > $ G ⇒ F = F2 $ > $ G ⇒ ilam U E P F W = ilam U E P2 F2 W $
----
e1: $ G ⇒ esf U E = esf U E $ by eq_refl
e2: $ G ⇒ fv (esf U E) P = fv (esf U E) P2 $ by fv_eq [e1, #1]
e2b: $ G ⇒ W = W $ by eq_refl
e3: $ G ⇒ esat U E P W = esat U E P2 W $ by ap_eq [e2, e2b]
e4: $ G ⇒ E = E $ by eq_refl
e5: $ G ⇒ fv E F = fv E F2 $ by fv_eq [e4, #2]
e6: $ G ⇒ ilam U E P F W ⊆ ilam U E P2 F2 W $ by i5_ilam_sub [e3, e5]
e7: $ G ⇒ P2 = P $ by eq_sym [#1]
e8: $ G ⇒ F2 = F $ by eq_sym [#2]
e10: $ G ⇒ fv (esf U E) P2 = fv (esf U E) P $ by fv_eq [e1, e7]
e11: $ G ⇒ esat U E P2 W = esat U E P W $ by ap_eq [e10, e2b]
e12: $ G ⇒ fv E F2 = fv E F $ by fv_eq [e4, e8]
e13: $ G ⇒ ilam U E P2 F2 W ⊆ ilam U E P F W $ by i5_ilam_sub [e11, e12]
e14: $ G ⇒ ilam U E P F W = ilam U E P2 F2 W $ by subset_antisym [e6, e13]

lemma i5_ch (G: hyps) (X K S: class) (z c j: set): $ G ⇒ crn j ⊆ X $ > $ G ⇒ z = ⟨ c , j ⟩ $ > $ G ⇒ z = ⟨ K , S ⟩ $ > $ G ⇒ isset K $ > $ G ⇒ isset S $ > $ G ⇒ crn S ⊆ X $
----
l1: $ G ⇒ ⟨ c , j ⟩ = z $ by eq_sym [#2]
l2: $ G ⇒ ⟨ c , j ⟩ = ⟨ K , S ⟩ $ by eq_trans [l1, #3]
l3: $ G ⇒ isset c $ by isset_var
l4: $ G ⇒ isset j $ by isset_var
l5: $ G ⇒ c = K ∧ j = S $ by opair_inj_c [l2, l3, l4, #4, #5]
l6: $ G ⇒ j = S $ by and_elim_r [l5]
l7: $ G ⇒ crn j = crn S $ by crn_eq [l6]
l8: $ G ⇒ crn S ⊆ X $ by subset_eq_l [l7, #1]

lemma i5_ctx_kids (H: hyps) (z a p: set): $ H ⇒ z ∊ ofsort lsig lopen ks_ctx $ > $ H ⇒ z = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ > $ H ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $
----
k1: $ H ⇒ (z = ⟨ kc_nil , ∅ ⟩) ∨ ∃ x ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by ofsort_ctx_cases [#1]
n1: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by ax
n2: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ ⟨ kc_nil , ∅ ⟩ = z $ by eq_sym [n1]
n3a: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ z = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by weaken [#2]
n3: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ ⟨ kc_nil , ∅ ⟩ = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by eq_trans [n2, n3a]
n4a: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ kc_nil ∈ ω $ by kc_nil_omega
n4b: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ isset kc_nil $ by wcel_isset [n4a]
n4c: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
n4d: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ kc_cons ∈ ω $ by kc_cons_omega
n4e: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ isset kc_cons $ by wcel_isset [n4d]
n4f: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ isset (scons p ∅) $ by scons_set [n4c]
n4g: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ isset (scons a (scons p ∅)) $ by scons_set [n4f]
n5: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ kc_nil = kc_cons ∧ ∅ = scons a (scons p ∅) $ by opair_inj_c [n3, n4b, n4c, n4e, n4g]
n6: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ kc_nil = kc_cons $ by and_elim_l [n5]
n7: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ ¬ kc_nil = kc_cons $ by kc_nil_ne_cons
n8: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ ⊥ $ by not_elim [n7, n6]
n9: $ H , z = ⟨ kc_nil , ∅ ⟩ ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by bot_elim [n8]
c1: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx $ by ax
c2: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ z = ⟨ kc_cons , scons x (scons y ∅) ⟩ $ by and_elim_l [c1]
c3: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx $ by and_elim_r [c1]
c4: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ x ∊ ofsort lsig lopen ks_expr $ by and_elim_l [c3]
c5: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ y ∊ ofsort lsig lopen ks_ctx $ by and_elim_r [c3]
c6a: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ ⟨ kc_cons , scons x (scons y ∅) ⟩ = z $ by eq_sym [c2]
c6b: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ z = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by weaken [#2]
c6: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ ⟨ kc_cons , scons x (scons y ∅) ⟩ = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by eq_trans [c6a, c6b]
c7a: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ kc_cons ∈ ω $ by kc_cons_omega
c7b: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset kc_cons $ by wcel_isset [c7a]
c7c: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset ∅ $ by ax_empty
c7d: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset (scons y ∅) $ by scons_set [c7c]
c7e: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset (scons x (scons y ∅)) $ by scons_set [c7d]
c7f: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset (scons p ∅) $ by scons_set [c7c]
c7g: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset (scons a (scons p ∅)) $ by scons_set [c7f]
c8: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ kc_cons = kc_cons ∧ scons x (scons y ∅) = scons a (scons p ∅) $ by opair_inj_c [c6, c7b, c7e, c7b, c7g]
c9: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ scons x (scons y ∅) = scons a (scons p ∅) $ by and_elim_r [c8]
c10a: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset x $ by isset_var
c10b: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset y $ by isset_var
c10c: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset a $ by isset_var
c10d: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ isset p $ by isset_var
c10: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ x = a ∧ y = p $ by scons2_inj [c10a, c10c, c10b, c10d, c9]
c11: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ x = a $ by and_elim_l [c10]
c12: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ y = p $ by and_elim_r [c10]
c13: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ a ∊ ofsort lsig lopen ks_expr $ by welc_eq_set [c11, c4]
c14: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ p ∊ ofsort lsig lopen ks_ctx $ by welc_eq_set [c12, c5]
c15: $ H , z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by and_intro [c13, c14]
d1a: $ H , ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) ⇒ ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by ax
d1: $ H , ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by ex_elim [d1a, c15]
d2a: $ H , ∃ x ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) ⇒ ∃ x ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) $ by ax
d2: $ H , ∃ x ∃ y (z = ⟨ kc_cons , scons x (scons y ∅) ⟩ ∧ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_ctx) ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by ex_elim [d2a, d1]
d3: $ H ⇒ a ∊ ofsort lsig lopen ks_expr ∧ p ∊ ofsort lsig lopen ks_ctx $ by or_elim [k1, n9, d2]

def i5_pip (U M W S: class) (.y .b .t: set): class = $ {y | y ∊ ofsort lsig lopen ks_ctx → ∀ b ∀ t (⟨ kr_pis , scons y (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt U M t W S = ipi U (dsh U M S) y b W)} $

lemma i5_pip_e (G: hyps) (M: class) (u w s x c d: set): $ G ⇒ x ∊ i5_pip u M w s $ > $ G ⇒ x ∊ ofsort lsig lopen ks_ctx $ > $ G ⇒ ra_pis x c d ∈ lrel $ > $ G ⇒ c ∊ trees ω $ > $ G ⇒ dt u M d w s = ipi u (dsh u M s) x c w $
----
l1: $ G ⇒ x ∊ ofsort lsig lopen ks_ctx → ∀ b ∀ t (⟨ kr_pis , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w) $ by cab_elim [#1]
l2: $ G ⇒ ∀ b ∀ t (⟨ kr_pis , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w) $ by imp_elim [l1, #2]
l3: $ G ⇒ ∀ t (⟨ kr_pis , scons x (scons c (scons t ∅)) ⟩ ∈ lrel → c ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x c w) $ by all_elim [l2]
l4: $ G ⇒ ⟨ kr_pis , scons x (scons c (scons d ∅)) ⟩ ∈ lrel → c ∊ trees ω → dt u M d w s = ipi u (dsh u M s) x c w $ by all_elim [l3]
l5: $ G ⇒ c ∊ trees ω → dt u M d w s = ipi u (dsh u M s) x c w $ by imp_elim [l4, #3]
l6: $ G ⇒ dt u M d w s = ipi u (dsh u M s) x c w $ by imp_elim [l5, #4]

lemma i5_pip_i {b t: set} (G: hyps) (M: class) (u w s x: set): $ G , x ∊ ofsort lsig lopen ks_ctx , ra_pis x b t ∈ lrel , b ∊ trees ω ⇒ dt u M t w s = ipi u (dsh u M s) x b w $ > $ G ⇒ x ∊ i5_pip u M w s $
----
l1: $ G , x ∊ ofsort lsig lopen ks_ctx , ra_pis x b t ∈ lrel ⇒ b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w $ by imp_intro [#1]
l2: $ G , x ∊ ofsort lsig lopen ks_ctx ⇒ ⟨ kr_pis , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w $ by imp_intro [l1]
l3: $ G , x ∊ ofsort lsig lopen ks_ctx ⇒ ∀ t (⟨ kr_pis , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w) $ by all_intro [l2]
l4: $ G , x ∊ ofsort lsig lopen ks_ctx ⇒ ∀ b ∀ t (⟨ kr_pis , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w) $ by all_intro [l3]
l5: $ G ⇒ x ∊ ofsort lsig lopen ks_ctx → ∀ b ∀ t (⟨ kr_pis , scons x (scons b (scons t ∅)) ⟩ ∈ lrel → b ∊ trees ω → dt u M t w s = ipi u (dsh u M s) x b w) $ by imp_intro [l4]
l6: $ G ⇒ x ∊ i5_pip u M w s $ by cab_intro [l5]

lemma i5_pis_nil (H: hyps) (M: class) (u w s z c d b: set): $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M d w s = ipi u (dsh u M s) z c w $
----
a1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b $ by ax
a2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ z = ⟨ kc_nil , ∅ ⟩ $ by and_elim_l [a1]
a3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ c = b ∧ d = b $ by and_elim_r [a1]
a4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ c = b $ by and_elim_l [a3]
a5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ d = b $ by and_elim_r [a3]
a6: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ b = c $ by eq_sym [a4]
a7: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ d = c $ by eq_trans [a5, a6]
b0: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ c = c $ by eq_refl
b5c0: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w = w $ by eq_refl
b1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ipi u (dsh u M s) z c w = ipi u (dsh u M s) ⟨ kc_nil , ∅ ⟩ c w $ by i5_ipi_eq [a2, b0, b5c0]
b2a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w ∊ lvals $ by weaken [#1]
b2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ipi u (dsh u M s) ⟨ kc_nil , ∅ ⟩ c w = da (fv (dsh u M s) c) w ∅ $ by ipi_nil [b2a]
b3a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ isset c $ by isset_var
b3b: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ s ∊ fseq u $ by weaken [#2]
b3c: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ s ∈ fseq u $ by welc_wcel [b3b]
b3d: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w ∈ lvals $ by welc_wcel [b2a]
b3e: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ∅ ∈ fseq u $ by fseq_empty
b3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ da (fv (dsh u M s) c) w ∅ = dt u M c w (scat ∅ s) $ by dsh_da_c [b3a, b3c, b3d, b3e]
b4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ scat ∅ s = s $ by scat_empty_l [b3b]
b5a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ u = u $ by eq_refl
b5b: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ M = M $ by eq_refl
b5c: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ w = w $ by eq_refl
b5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M c w (scat ∅ s) = dt u M c w s $ by dt_eq [b5a, b5b, b0, b5c, b4]
b6a: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ s = s $ by eq_refl
b6: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M d w s = dt u M c w s $ by dt_eq [b5a, b5b, a7, b5c, b6a]
c1: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ipi u (dsh u M s) z c w = da (fv (dsh u M s) c) w ∅ $ by eq_trans [b1, b2]
c2: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ipi u (dsh u M s) z c w = dt u M c w (scat ∅ s) $ by eq_trans [c1, b3]
c3: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ ipi u (dsh u M s) z c w = dt u M c w s $ by eq_trans [c2, b5]
c4: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M c w s = ipi u (dsh u M s) z c w $ by eq_sym [c3]
c5: $ H , z = ⟨ kc_nil , ∅ ⟩ ∧ c = b ∧ d = b ⇒ dt u M d w s = ipi u (dsh u M s) z c w $ by eq_trans [b6, c4]

lemma i5_pis_cons (H: hyps) (M: class) (u w s z c d k j a b t p: set): $ H ⇒ uadm u $ > $ H ⇒ w ∊ lvals $ > $ H ⇒ s ∊ fseq u $ > $ H ⇒ z ∊ ofsort lsig lopen ks_ctx $ > $ H ⇒ crn j ⊆ i5_pip u M w s $ > $ H ⇒ z = ⟨ k , j ⟩ $ > $ H ⇒ c ∊ trees ω $ > $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ dt u M d w s = ipi u (dsh u M s) z c w $
----
e0: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel $ by ax
e1: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ z = ⟨ kc_cons , scons a (scons p ∅) ⟩ $ by and_elim_l [e0]
e1b: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel $ by and_elim_r [e0]
e2: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ c = b $ by and_elim_l [e1b]
e2b: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel $ by and_elim_r [e1b]
e3: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ d = t $ by and_elim_l [e2b]
e4: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel $ by and_elim_r [e2b]
f0a: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ crn j ⊆ i5_pip u M w s $ by weaken [#5]
f0b: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ z = ⟨ k , j ⟩ $ by weaken [#6]
f0c: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ kc_cons ∈ ω $ by kc_cons_omega
f0d: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ isset kc_cons $ by wcel_isset [f0c]
f0e: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ isset ∅ $ by ax_empty
f0f: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ isset (scons p ∅) $ by scons_set [f0e]
f0g: $ H , z = ⟨ kc_cons , scons a (scons p ∅) ⟩ ∧ c = b ∧ d = t ∧ ra_pis p ⟨ kc_pi , scons a (scons b ∅) ⟩ t ∈ lrel ⇒ isset (scons a (scons p ∅)) $ by scons_set [f0f]
