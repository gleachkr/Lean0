c5: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ra_spine ⟨ K , S ⟩ e y ∈ lrel $ by wcel_eq_l [c4, c1]
w2: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ⟨ K , S ⟩ ∈ trees ω $ by weaken [#2]
w3: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ¬ K = kc_pi $ by weaken [#3]
w4: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ ¬ K = kc_app $ by weaken [#4]
w5: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ w ∊ lvals $ by weaken [#5]
w6: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ r ∊ fseq u $ by weaken [#6]
c6: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ ∧ cdm (sarg u (dnf u M) e w r) = fv nvf y ∧ dt u M e w r = apn (dt u M ⟨ K , S ⟩ w r) (sarg u (dnf u M) e w r) $ by lrel_spine_sem [c5, w2, w3, w4, b5, w5, w6]
c7: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ etel u (dnf u M) e w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg u (dnf u M) e w r ⟩ ⟩ ⟩ $ by and_elim_l [c6]
g1: $ G , h = x4 ∧ t2 = x5 ∧ y = ⟨ kc_nz , ∅ ⟩ ∧ e = x4 ∧ f = x5 ⇒ sarg u (dnf u M) ⟨ K , S ⟩ w r = ∅ $ by sarg_other [w2, w3, w4, w5, w6]
