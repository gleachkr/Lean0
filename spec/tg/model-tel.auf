k0m: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ ⊥ $ by not_elim [k0n, k0k]
