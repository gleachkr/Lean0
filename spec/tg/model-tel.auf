m4: $ G ⇒ v ∊ i7_sip u M t1 t3 t4 w p s $ by subset_elim [m3, #9]
m5: $ G ⇒ ∀ x7 ∀ x8 ∀ x9 (ra_sinst t1 x7 t3 t4 x8 x9 ∈ lrel → x7 ∊ trees ω → nadd (fv nvf x7) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf x7) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M x9 w (scat p s) = dt u M x8 w (scat p (scat v s))) $ by cab_elim [m4]
m6: $ G ⇒ ∀ x8 ∀ x9 (ra_sinst t1 t2 t3 t4 x8 x9 ∈ lrel → t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M x9 w (scat p s) = dt u M x8 w (scat p (scat v s))) $ by all_elim [m5]
m7: $ G ⇒ ∀ x9 (ra_sinst t1 t2 t3 t4 t5 x9 ∈ lrel → t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M x9 w (scat p s) = dt u M t5 w (scat p (scat v s))) $ by all_elim [m6]
m8: $ G ⇒ ra_sinst t1 t2 t3 t4 t5 t6 ∈ lrel → t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M t6 w (scat p s) = dt u M t5 w (scat p (scat v s)) $ by all_elim [m7]
m9: $ G ⇒ t2 ∊ trees ω → nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M t6 w (scat p s) = dt u M t5 w (scat p (scat v s)) $ by imp_elim [m8, #1]
m10: $ G ⇒ nadd (fv nvf t2) (cdm v) = fv nvf t3 → ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M t6 w (scat p s) = dt u M t5 w (scat p (scat v s)) $ by imp_elim [m9, #4]
m11: $ G ⇒ ∀ i ∀ b (i ∊ cdm v → b ∊ trees ω → fv nvf b = nadd (fv nvf t2) i → dt u M ⟨ kc_ind_ty , scons t1 (scons b ∅) ⟩ w ∅ = fv v i) → dt u M t6 w (scat p s) = dt u M t5 w (scat p (scat v s)) $ by imp_elim [m10, #10]
m12: $ G ⇒ dt u M t6 w (scat p s) = dt u M t5 w (scat p (scat v s)) $ by imp_elim [m11, #11]

--| Concatenation after a sequence ending in `x`.
lemma i7_scat_snoc (G: hyps) (A: class) (e x s: set): $ G ⇒ e ∊ fseq A $ > $ G ⇒ x ∊ A $ > $ G ⇒ s ∊ fseq A $ > $ G ⇒ scat (ssnoc e x) s = scat e (scons x s) $
----
a1: $ G , m = scons x ∅ ⇒ e ∊ fseq A $ by weaken [#1]
a2: $ G , m = scons x ∅ ⇒ x ∊ A $ by weaken [#2]
a3: $ G , m = scons x ∅ ⇒ s ∊ fseq A $ by weaken [#3]
a4: $ G , m = scons x ∅ ⇒ m = scons x ∅ $ by ax
a5: $ G , m = scons x ∅ ⇒ scons x ∅ = m $ by eq_sym [a4]
b1a: $ G , m = scons x ∅ ⇒ ∅ ∈ fseq A $ by fseq_empty
b1b: $ G , m = scons x ∅ ⇒ x ∈ A $ by welc_wcel [a2]
b1c: $ G , m = scons x ∅ ⇒ scons x ∅ ∈ fseq A $ by scons_fseq_c [b1b, b1a]
b1d: $ G , m = scons x ∅ ⇒ m ∈ fseq A $ by wcel_eq_l [a5, b1c]
b1: $ G , m = scons x ∅ ⇒ m ∊ fseq A $ by wcel_welc [b1d]
c1: $ G , m = scons x ∅ ⇒ ssnoc e x = scat e (scons x ∅) $ by ssnoc_scat [a1]
c2a: $ G , m = scons x ∅ ⇒ e = e $ by eq_refl
c2: $ G , m = scons x ∅ ⇒ scat e (scons x ∅) = scat e m $ by scat_eq [c2a, a5]
c3: $ G , m = scons x ∅ ⇒ ssnoc e x = scat e m $ by eq_trans [c1, c2]
c4a: $ G , m = scons x ∅ ⇒ s = s $ by eq_refl
c4: $ G , m = scons x ∅ ⇒ scat (ssnoc e x) s = scat (scat e m) s $ by scat_eq [c3, c4a]
c5: $ G , m = scons x ∅ ⇒ scat (scat e m) s = scat e (scat m s) $ by scat_assoc [a1, b1, a3]
c6: $ G , m = scons x ∅ ⇒ scat m s = scat (scons x ∅) s $ by scat_eq [a4, c4a]
c7: $ G , m = scons x ∅ ⇒ scat (scons x ∅) s = scons x s $ by scat_scons_empty [a3]
c8: $ G , m = scons x ∅ ⇒ scat m s = scons x s $ by eq_trans [c6, c7]
c9: $ G , m = scons x ∅ ⇒ scat e (scat m s) = scat e (scons x s) $ by scat_eq [c2a, c8]
c10: $ G , m = scons x ∅ ⇒ scat (ssnoc e x) s = scat e (scat m s) $ by eq_trans [c4, c5]
c11: $ G , m = scons x ∅ ⇒ scat (ssnoc e x) s = scat e (scons x s) $ by eq_trans [c10, c9]
c12: $ G ⇒ isset ∅ $ by ax_empty
c13: $ G ⇒ isset (scons x ∅) $ by scons_set [c12]
c14: $ G ⇒ scat (ssnoc e x) s = scat e (scons x s) $ by isset_elim [c13, c11]

--| i7: the children of an application of sort `expr` are of sort `expr`.
lemma i7_app_sorts (G: hyps) (x y: set): $ G ⇒ ⟨ kc_app , scons x (scons y ∅) ⟩ ∈ ofsort lsig lopen ks_expr $ > $ G ⇒ x ∊ ofsort lsig lopen ks_expr ∧ y ∊ ofsort lsig lopen ks_expr $
----
c0: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z ∊ ofsort lsig lopen ks_expr $ by ax
c1: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ ∃ x5 (z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat) ∨ ∃ x5 (z = ⟨ kc_srt , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x5 ∃ x6 (z = ⟨ kc_app , scons x5 (scons x6 ∅) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_expr ∧ x6 ∊ ofsort lsig lopen ks_expr) ∨ ∃ x5 ∃ x6 (z = ⟨ kc_lam , scons x5 (scons x6 ∅) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_expr ∧ x6 ∊ ofsort lsig lopen ks_expr) ∨ ∃ x5 ∃ x6 (z = ⟨ kc_pi , scons x5 (scons x6 ∅) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_expr ∧ x6 ∊ ofsort lsig lopen ks_expr) ∨ ∃ x5 ∃ x6 (z = ⟨ kc_cst , scons x5 (scons x6 ∅) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_atom ∧ x6 ∊ ofsort lsig lopen ks_lvls) ∨ ∃ x5 (z = ⟨ kc_lit , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_bin) ∨ ∃ x5 ∃ x6 (z = ⟨ kc_ind_ty , scons x5 (scons x6 ∅) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_ind ∧ x6 ∊ ofsort lsig lopen ks_nat) ∨ ∃ x5 ∃ x6 ∃ x7 (z = ⟨ kc_ind_ctor , scons x5 (scons x6 (scons x7 ∅)) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_ind ∧ x6 ∊ ofsort lsig lopen ks_nat ∧ x7 ∊ ofsort lsig lopen ks_nat) ∨ ∃ x5 ∃ x6 ∃ x7 (z = ⟨ kc_ind_rec , scons x5 (scons x6 (scons x7 ∅)) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_ind ∧ x6 ∊ ofsort lsig lopen ks_nat ∧ x7 ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x5 ∃ x6 ∃ x7 (z = ⟨ kc_proj , scons x5 (scons x6 (scons x7 ∅)) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_blk ∧ x6 ∊ ofsort lsig lopen ks_nat ∧ x7 ∊ ofsort lsig lopen ks_expr) ∨ ∃ x5 (z = ⟨ kc_quot , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x5 (z = ⟨ kc_quot_mk , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x5 ∃ x6 (z = ⟨ kc_quot_lift , scons x5 (scons x6 ∅) ⟩ ∧ x5 ∊ ofsort lsig lopen ks_lvl ∧ x6 ∊ ofsort lsig lopen ks_lvl) ∨ ∃ x5 (z = ⟨ kc_quot_ind , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_lvl) $ by ofsort_expr_cases [c0]
c2: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ z = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by ax
c3: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ isset ∅ $ by ax_empty
c4: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ isset (scons y ∅) $ by scons_set [c3]
c5: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ isset (scons x (scons y ∅)) $ by scons_set [c4]
c6: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ kc_app ∈ ω $ by kc_app_omega
c7: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr ⇒ isset kc_app $ by wcel_isset [c6]
k0a: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat $ by ax
k0b: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_bvar , scons x5 ∅ ⟩ $ by and_elim_l [k0a]
k0f: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ z = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by weaken [c2]
k0g: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ ⟨ kc_bvar , scons x5 ∅ ⟩ = z $ by eq_sym [k0b]
k0h: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ ⟨ kc_bvar , scons x5 ∅ ⟩ = ⟨ kc_app , scons x (scons y ∅) ⟩ $ by eq_trans [k0g, k0f]
k0i0: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
k0i: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ isset kc_bvar $ by wcel_isset [k0i0]
