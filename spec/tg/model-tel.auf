--| The trees `y` whose paths, at every context `c` and depth `d` of a derivable
--| `cwf D N Q L K c d y`, grow with the entries of valuations that agree below `d + Q`.
def i9_cm (U M W J D N Q L K: class) (.y .c .d .a .b .i: set): class = $ {y | ∀ c ∀ d ∀ a ∀ b (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq U → b ∊ fseq U → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel U (dnf U M) y W a ⊆ etel U (dnf U M) y W b)} $

lemma i9_cm_i {c d a b i: set} (G: hyps) (J M D N Q L K: class) (u w y: set): $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) , ∀ i (fv a i ⊆ fv b i) ⇒ etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ > $ G ⇒ y ∊ i9_cm u M w J D N Q L K $
----
l0: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u , ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) ⇒ ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ by imp_intro [#1]
l1: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u , b ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ by imp_intro [l0]
l2: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω , a ∊ fseq u ⇒ b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ by imp_intro [l1]
l3: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J , d ∊ trees ω ⇒ a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ by imp_intro [l2]
l4: $ G , ra_cwf D N Q L K c d y ∈ lrel3 J ⇒ d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ by imp_intro [l3]
l5: $ G ⇒ ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b $ by imp_intro [l4]
l6: $ G ⇒ ∀ b (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by all_intro [l5]
l7: $ G ⇒ ∀ a ∀ b (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by all_intro [l6]
l8: $ G ⇒ ∀ d ∀ a ∀ b (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by all_intro [l7]
l8b: $ G ⇒ ∀ c ∀ d ∀ a ∀ b (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by all_intro [l8]
l9: $ G ⇒ y ∊ i9_cm u M w J D N Q L K $ by cab_intro [l8b]

lemma i9_cm_e {i: set} (G: hyps i) (J M D N Q L K C Dd A B: class) (u w y: set): $ G ⇒ y ∊ i9_cm u M w J D N Q L K $ > $ G ⇒ isset C $ > $ G ⇒ ra_cwf D N Q L K C Dd y ∈ lrel3 J $ > $ G ⇒ Dd ∈ trees ω $ > $ G ⇒ A ∈ fseq u $ > $ G ⇒ B ∈ fseq u $ > $ G ⇒ ∀ i (i ∊ nadd (fv nvf Dd) (fv nvf Q) → fv A i = fv B i) $ > $ G ⇒ ∀ i (fv A i ⊆ fv B i) $ > $ G ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w B $
----
c1: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ y ∊ i9_cm u M w J D N Q L K $ by weaken [#1]
c2: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ c ∀ d ∀ a ∀ b (ra_cwf D N Q L K c d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by cab_elim [c1]
c2b: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ d ∀ a ∀ b (ra_cwf D N Q L K n d y ∈ lrel3 J → d ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf d) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by all_elim [c2]
c3: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ a ∀ b (ra_cwf D N Q L K n o y ∈ lrel3 J → o ∊ trees ω → a ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv a i = fv b i) → ∀ i (fv a i ⊆ fv b i) → etel u (dnf u M) y w a ⊆ etel u (dnf u M) y w b) $ by all_elim [c2b]
c4: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ b (ra_cwf D N Q L K n o y ∈ lrel3 J → o ∊ trees ω → p ∊ fseq u → b ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv b i) → ∀ i (fv p i ⊆ fv b i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w b) $ by all_elim [c3]
c5: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_cwf D N Q L K n o y ∈ lrel3 J → o ∊ trees ω → p ∊ fseq u → q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → ∀ i (fv p i ⊆ fv q i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by all_elim [c4]
c6: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ o = Dd $ by ax
c6b: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ Dd = o $ by eq_sym [c6]
c6c: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ n = C $ by ax
c6d: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ C = n $ by eq_sym [c6c]
c7a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ D = D $ by eq_refl
c7b: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ N = N $ by eq_refl
c7c: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ Q = Q $ by eq_refl
c7d: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ y = y $ by eq_refl
c7e: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ L = L $ by eq_refl
c7f: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ K = K $ by eq_refl
c8: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_cwf D N Q L K C Dd y = ra_cwf D N Q L K n o y $ by ra_cwf_eq [c7a, c7b, c7c, c7e, c7f, c6d, c6b, c7d]
c9: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_cwf D N Q L K C Dd y ∈ lrel3 J $ by weaken [#3]
c10: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ra_cwf D N Q L K n o y ∈ lrel3 J $ by wcel_eq_l [c8, c9]
c11: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ o ∊ trees ω → p ∊ fseq u → q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → ∀ i (fv p i ⊆ fv q i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by imp_elim [c5, c10]
c12a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ o ∊ trees ω $ by ax
c12: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ p ∊ fseq u → q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → ∀ i (fv p i ⊆ fv q i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by imp_elim [c11, c12a]
c13a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ p ∊ fseq u $ by ax
c13: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ q ∊ fseq u → ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → ∀ i (fv p i ⊆ fv q i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by imp_elim [c12, c13a]
c14a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ q ∊ fseq u $ by ax
c14: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) → ∀ i (fv p i ⊆ fv q i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by imp_elim [c13, c14a]
k1: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ nvf = nvf $ by eq_refl
k2: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ fv nvf Dd = fv nvf o $ by fv_eq [k1, c6b]
k3: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ fv nvf Q = fv nvf Q $ by eq_refl
k4: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ nadd (fv nvf Dd) (fv nvf Q) = nadd (fv nvf o) (fv nvf Q) $ by nadd_eq [k2, k3]
k5a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ p = A $ by ax
k5: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ A = p $ by eq_sym [k5a]
k6a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ q = B $ by ax
k6: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ B = q $ by eq_sym [k6a]
k7: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf Dd) (fv nvf Q) → fv A i = fv B i) $ by weaken [#7]
k8: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (i ∊ nadd (fv nvf o) (fv nvf Q) → fv p i = fv q i) $ by i9_agr [k4, k5, k6, k7]
k9: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (fv A i ⊆ fv B i) $ by weaken [#8]
k10: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (fv p i ⊆ fv q i) $ by i9_sagr [k5, k6, k9]
c15: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ ∀ i (fv p i ⊆ fv q i) → etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by imp_elim [c14, k8]
c16: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w p ⊆ etel u (dnf u M) y w q $ by imp_elim [c15, k10]
c17a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ w = w $ by eq_refl
c17: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w p = etel u (dnf u M) y w A $ by etel_eq [c7d, c17a, k5a]
c18: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w q = etel u (dnf u M) y w B $ by etel_eq [c7d, c17a, k6a]
c19a: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w q $ by subset_eq_l [c17, c16]
c19: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u , q = B , q ∊ fseq u ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w B $ by subset_eq_r [c18, c19a]
d1: $ G , n = C , o = Dd , o ∊ trees ω , p = A , p ∊ fseq u ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w B $ by wcel_elim [#6, c19]
d2: $ G , n = C , o = Dd , o ∊ trees ω ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w B $ by wcel_elim [#5, d1]
d3: $ G , n = C ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w B $ by wcel_elim [#4, d2]
d4: $ G ⇒ etel u (dnf u M) y w A ⊆ etel u (dnf u M) y w B $ by isset_elim [#2, d3]

--| The step of `lrel_cwf_mono` at `cwf_pi`: the rest's paths at `v :: a`, `v :: b`.
lemma i9_cm_st {i v: set} (G: hyps) (J M C: class) (u w a b t1 t2 t3 t4 t5 d x0: set): $ G ⇒ ra_cwf t1 t2 t3 t4 t5 C ⟨ kc_s , scons d ∅ ⟩ x0 ∈ lrel3 J $ > $ G ⇒ isset C $ > $ G ⇒ x0 ∊ i9_cm u M w J t1 t2 t3 t4 t5 $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ b ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ > $ G ⇒ ∀ i (fv a i ⊆ fv b i) $ > $ G ⇒ ∀ v (v ∊ u → etel u (dnf u M) x0 w (scons v a) ⊆ etel u (dnf u M) x0 w (scons v b)) $
----
q4a: $ G ⇒ isset ω $ by omega_set
q4b: $ G ⇒ kc_s ∈ ω $ by kc_s_omega
q4c: $ G ⇒ d ∈ trees ω $ by welc_wcel [#4]
q4d: $ G ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
q4e: $ G ⇒ scons d ∅ ∈ fseq (trees ω) $ by scons_fseq_c [q4c, q4d]
q4: $ G ⇒ ⟨ kc_s , scons d ∅ ⟩ ∈ trees ω $ by trees_intro_c [q4a, q4b, q4e]
q7a: $ G ⇒ fv nvf ⟨ kc_s , scons d ∅ ⟩ = suc (fv nvf d) $ by nvf_s [q4c]
q7b: $ G ⇒ fv nvf t3 = fv nvf t3 $ by eq_refl
q7c: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3) = nadd (suc (fv nvf d)) (fv nvf t3) $ by nadd_eq [q7a, q7b]
q7d0: $ G ⇒ functional nvf $ by nvf_functional
q7d: $ G ⇒ isset (fv nvf d) $ by fv_set [q7d0]
q7e: $ G ⇒ isset t3 $ by isset_var
q7f: $ G ⇒ fv nvf t3 ∈ ω $ by nvf_omega [q7e]
q7g: $ G ⇒ nadd (suc (fv nvf d)) (fv nvf t3) = suc (nadd (fv nvf d) (fv nvf t3)) $ by suc_nadd_c [q7d, q7f]
q7h: $ G ⇒ nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3) = suc (nadd (fv nvf d) (fv nvf t3)) $ by eq_trans [q7c, q7g]
q7i: $ G ⇒ suc (nadd (fv nvf d) (fv nvf t3)) = nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3) $ by eq_sym [q7h]
q7j: $ G ⇒ isset d $ by isset_var
q7k: $ G ⇒ fv nvf d ∈ ω $ by nvf_omega [q7j]
q7l: $ G ⇒ nadd (fv nvf d) (fv nvf t3) ∈ ω $ by nadd_omega_c [q7k, q7f]
v1: $ G , v ∊ u ⇒ v ∊ u $ by ax
v2: $ G , v ∊ u ⇒ a ∊ fseq u $ by weaken [#5]
v3: $ G , v ∊ u ⇒ b ∊ fseq u $ by weaken [#6]
v4: $ G , v ∊ u ⇒ scons v a ∈ fseq u $ by scons_fseq [v1, v2]
v5: $ G , v ∊ u ⇒ scons v b ∈ fseq u $ by scons_fseq [v1, v3]
v6: $ G , v ∊ u ⇒ nadd (fv nvf d) (fv nvf t3) ∈ ω $ by weaken [q7l]
v7: $ G , v ∊ u ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ by weaken [#7]
v8: $ G , v ∊ u ⇒ ∀ i (i ∊ suc (nadd (fv nvf d) (fv nvf t3)) → fv (scons v a) i = fv (scons v b) i) $ by scons_agree [v6, v7]
v9: $ G , v ∊ u ⇒ suc (nadd (fv nvf d) (fv nvf t3)) = nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3) $ by weaken [q7i]
v10: $ G , v ∊ u ⇒ scons v a = scons v a $ by eq_refl
v11: $ G , v ∊ u ⇒ scons v b = scons v b $ by eq_refl
v12: $ G , v ∊ u ⇒ ∀ i (i ∊ nadd (fv nvf ⟨ kc_s , scons d ∅ ⟩) (fv nvf t3) → fv (scons v a) i = fv (scons v b) i) $ by i9_agr [v9, v10, v11, v8]
v13: $ G , v ∊ u ⇒ x0 ∊ i9_cm u M w J t1 t2 t3 t4 t5 $ by weaken [#3]
v14: $ G , v ∊ u ⇒ ra_cwf t1 t2 t3 t4 t5 C ⟨ kc_s , scons d ∅ ⟩ x0 ∈ lrel3 J $ by weaken [#1]
v15: $ G , v ∊ u ⇒ ⟨ kc_s , scons d ∅ ⟩ ∈ trees ω $ by weaken [q4]
v16a: $ G , v ∊ u ⇒ ∀ i (fv a i ⊆ fv b i) $ by weaken [#8]
v16b: $ G , v ∊ u ⇒ ∀ i (fv (scons v a) i ⊆ fv (scons v b) i) $ by i9_scons_sub [v16a]
v16c: $ G , v ∊ u ⇒ isset C $ by weaken [#2]
v16: $ G , v ∊ u ⇒ etel u (dnf u M) x0 w (scons v a) ⊆ etel u (dnf u M) x0 w (scons v b) $ by i9_cm_e [v13, v16c, v14, v15, v4, v5, v12, v16b]
w1: $ G ⇒ v ∊ u → etel u (dnf u M) x0 w (scons v a) ⊆ etel u (dnf u M) x0 w (scons v b) $ by imp_intro [v16]
w2: $ G ⇒ ∀ v (v ∊ u → etel u (dnf u M) x0 w (scons v a) ⊆ etel u (dnf u M) x0 w (scons v b)) $ by all_intro [w1]

--| `lrel_cwf_mono`, the case `cwf_pi`.
lemma i9_cm_c1 {i x1 x2 x3 x4 x5 x6 x7 x8 x9 x0 e h: set} (G: hyps) (J M: class) (u w a b t1 t2 t3 t4 t5 c d z k j: set): $ G ⇒ crn j ⊆ i9_cm u M w J t1 t2 t3 t4 t5 $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ z ∊ trees ω $ > $ G ⇒ d ∊ trees ω $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ a ∊ fseq u $ > $ G ⇒ b ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ nadd (fv nvf d) (fv nvf t3) → fv a i = fv b i) $ > $ G ⇒ ∀ i (fv a i ⊆ fv b i) $ > $ G ⇒ (∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 ∃ x6 ∃ x7 ∃ x8 ∃ x9 ∃ x0 ∃ e ∃ h (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J)) → etel u (dnf u M) z w a ⊆ etel u (dnf u M) z w b $
----
b0: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J $ by ax
b1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ t1 = x1 $ by and_elim_l [b0]
br1: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J $ by and_elim_r [b0]
b2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ t2 = x2 $ by and_elim_l [br1]
br2: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J $ by and_elim_r [br1]
b3: $ G , t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ c = x6 ∧ d = x7 ∧ z = ⟨ kc_pi , scons x9 (scons x0 ∅) ⟩ ∧ ra_add x7 x3 x8 ∈ lrel ∧ ra_sinst x1 ⟨ kc_nz , ∅ ⟩ x2 x8 x9 e ∈ lrel ∧ ra_deq x6 e e ⟨ kc_srt , scons h ∅ ⟩ ∈ J ∧ ra_ulevel x4 h ∈ lrel2 ∧ ra_ipos x1 x2 x3 x7 x9 ∈ lrel ∧ ra_cwf x1 x2 x3 x4 x5 ⟨ kc_cons , scons e (scons x6 ∅) ⟩ ⟨ kc_s , scons x7 ∅ ⟩ x0 ∈ lrel3 J ⇒ t3 = x3 $ by and_elim_l [br2]
