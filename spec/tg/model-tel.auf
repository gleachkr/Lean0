d2: $ G ⇒ etel u E ⟨ kc_app , scons e (scons b ∅) ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E b) w r) X ⟩ ⟩ ⟩ $ by eq_trans [l1, d1]

--| The trees `x` such that for every derivable `spine H x n` the paths of `x`
--| are one with no fields and the arguments `sarg`, a sequence of length `n`,
--| and the value of `x` is `H`'s applied to them.
def i6_spp (U M H W R: class) (.x .n: set): class = $ {x | ∀ n (ra_spine H x n ∈ lrel → etel U (dnf U M) x W R = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , sarg U (dnf U M) x W R ⟩ ⟩ ⟩ ∧ sarg U (dnf U M) x W R ∈ fseq i6_vv ∧ cdm (sarg U (dnf U M) x W R) = fv nvf n ∧ dt U M x W R = apn (dt U M H W R) (sarg U (dnf U M) x W R))} $

lemma i6_spp_e (G: hyps) (M: class) (u w r h x n: set): $ G ⇒ x ∈ i6_spp u M h w r $ > $ G ⇒ ra_spine h x n ∈ lrel $ > $ G ⇒ etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (sarg u (dnf u M) x w r) ⟩ ⟩ ⟩ ∧ (sarg u (dnf u M) x w r) ∈ fseq i6_vv ∧ cdm (sarg u (dnf u M) x w r) = fv nvf n ∧ dt u M x w r = apn (dt u M h w r) (sarg u (dnf u M) x w r) $
----
l0: $ G ⇒ x ∊ i6_spp u M h w r $ by wcel_welc [#1]
l1: $ G ⇒ ∀ x2 (ra_spine h x x2 ∈ lrel → etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (sarg u (dnf u M) x w r) ⟩ ⟩ ⟩ ∧ (sarg u (dnf u M) x w r) ∈ fseq i6_vv ∧ cdm (sarg u (dnf u M) x w r) = fv nvf x2 ∧ dt u M x w r = apn (dt u M h w r) (sarg u (dnf u M) x w r)) $ by cab_elim [l0]
l2: $ G ⇒ ra_spine h x n ∈ lrel → etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (sarg u (dnf u M) x w r) ⟩ ⟩ ⟩ ∧ (sarg u (dnf u M) x w r) ∈ fseq i6_vv ∧ cdm (sarg u (dnf u M) x w r) = fv nvf n ∧ dt u M x w r = apn (dt u M h w r) (sarg u (dnf u M) x w r) $ by all_elim [l1]
l3: $ G ⇒ etel u (dnf u M) x w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (sarg u (dnf u M) x w r) ⟩ ⟩ ⟩ ∧ (sarg u (dnf u M) x w r) ∈ fseq i6_vv ∧ cdm (sarg u (dnf u M) x w r) = fv nvf n ∧ dt u M x w r = apn (dt u M h w r) (sarg u (dnf u M) x w r) $ by imp_elim [l2, #2]

lemma i6_sp_step (G: hyps) (M: class) (u w r h k j: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ etel u (dnf u M) h w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ > $ G ⇒ k ∊ ω $ > $ G ⇒ j ∊ fseq (trees ω) $ > $ G ⇒ crn j ⊆ i6_spp u M h w r $ > $ G ⇒ ⟨ k , j ⟩ ∈ i6_spp u M h w r $
----
a1: $ G , z = ⟨ k , j ⟩ , ra_spine h z n ∈ lrel ⇒ ra_spine h z n ∈ lrel $ by ax
a2: $ G , z = ⟨ k , j ⟩ , ra_spine h z n ∈ lrel ⇒ ∃ x2 (h = x2 ∧ z = x2 ∧ n = ⟨ kc_nz , ∅ ⟩) ∨ ∃ x2 ∃ e ∃ a ∃ c (h = x2 ∧ z = ⟨ kc_app , scons e (scons a ∅) ⟩ ∧ n = ⟨ kc_s , scons c ∅ ⟩ ∧ ra_spine x2 e c ∈ lrel) $ by lrel_spine_cases [a1]
gu: $ G ⇒ u = u $ by eq_refl
gm: $ G ⇒ M = M $ by eq_refl
