lemma i9_cq_ca {x1 x2: set} (G: hyps) (J: class) (t1 t2 t3 t4 t5 t6 z p e: set): $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 z ∈ lrel3 J $ > $ G ⇒ (∃ x1 ∃ x2 (z = ⟨ kc_ccons , scons x1 (scons x2 ∅) ⟩ ∧ p = ⟨ kc_nz , ∅ ⟩ ∧ e = x1)) → ra_cwf t1 t2 t3 t4 t5 t6 ⟨ kc_nz , ∅ ⟩ e ∈ lrel3 J $
----
