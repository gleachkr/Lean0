q8: $ G , z ∊ etb u E2 K s V ⇒ (K = kc_pi ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ x ∃ f ∃ g ∃ t ∃ a (x ∊ da (fv E (fv s ∅)) w r ∧ x ∊ u ∧ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ da (fv V (suc ∅)) w (scons x r) ∧ y = ⟨ ssnoc f x , ⟨ scons x g , ⟨ scons (da (fv V ∅) w r) t , a ⟩ ⟩ ⟩)})) ∨ (K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv V ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , (scons (da (fv E (fv s (suc ∅))) w r) a) ⟩ ⟩ ⟩)})) ∨ (¬ K = kc_pi ∧ ¬ K = kc_app ∧ z ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by cut [q2, q7a]
q9: $ G , z ∊ etb u E2 K s V ⇒ z ∊ etb u E K s V $ by cab_intro [q8]
z1: $ G ⇒ etb u E K s V = etb u E2 K s V $ by eq_intro [p9, q9]

lemma i4_et_node {x9: set} (G: hyps x9) (E E2: class) (u k s: set):
  $ G ⇒ eagv u E E2 $ > $ G ⇒ k ∊ ω $ > $ G ⇒ s ∊ fseq (trees ω) $ > $ G ⇒ crn s ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ > $ G ⇒ ⟨ k , s ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $
----
y0: $ G , y ∊ crn s ⇒ y ∊ crn s $ by ax
y3: $ G , y ∊ crn s ⇒ crn s ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by weaken [#4]
y4a: $ G , y ∊ crn s ⇒ y ∈ crn s $ by welc_wcel [y0]
y4: $ G , y ∊ crn s ⇒ y ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by wcel_subset [y3, y4a]
y5: $ G , y ∊ crn s ⇒ y ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by wcel_welc [y4]
y7: $ G , y ∊ crn s ⇒ fv (etf u E) y = fv (etf u E2) y $ by cab_elim [y5]
y8: $ G ⇒ y ∊ crn s → fv (etf u E) y = fv (etf u E2) y $ by imp_intro [y7]
y9: $ G ⇒ ∀ y (y ∊ crn s → fv (etf u E) y = fv (etf u E2) y) $ by all_intro [y8]
v1a: $ G ⇒ functional (etf u E) $ by etf_functional
v1b: $ G ⇒ functional (etf u E2) $ by etf_functional
v1c: $ G ⇒ crn s ⊆ trees ω $ by fseq_crn [#3]
v1d: $ G ⇒ cdm (etf u E) = trees ω $ by etf_cdm
v1e: $ G ⇒ cdm (etf u E2) = trees ω $ by etf_cdm
v1f: $ G ⇒ trees ω = cdm (etf u E) $ by eq_sym [v1d]
v1g: $ G ⇒ trees ω = cdm (etf u E2) $ by eq_sym [v1e]
v1h: $ G ⇒ crn s ⊆ cdm (etf u E) $ by subset_eq_r [v1f, v1c]
v1i: $ G ⇒ crn s ⊆ cdm (etf u E2) $ by subset_eq_r [v1g, v1c]
v1: $ G ⇒ ccom (etf u E) s = ccom (etf u E2) s $ by ccom_eq_vals [v1a, v1b, v1h, v1i, y9]
m0: $ G , c = ccom (etf u E) s ⇒ c = ccom (etf u E) s $ by ax
m0a: $ G , c = ccom (etf u E) s ⇒ k ∊ ω $ by weaken [#2]
m0b: $ G , c = ccom (etf u E) s ⇒ s ∊ fseq (trees ω) $ by weaken [#3]
m1: $ G , c = ccom (etf u E) s ⇒ fv (etf u E) ⟨ k , s ⟩ = etb u E k s c $ by etf_node [m0a, m0b, m0]
m2a: $ G , c = ccom (etf u E) s ⇒ ccom (etf u E) s = ccom (etf u E2) s $ by weaken [v1]
m2b: $ G , c = ccom (etf u E) s ⇒ c = ccom (etf u E2) s $ by eq_trans [m0, m2a]
m2: $ G , c = ccom (etf u E) s ⇒ fv (etf u E2) ⟨ k , s ⟩ = etb u E2 k s c $ by etf_node [m0a, m0b, m2b]
m3a: $ G , c = ccom (etf u E) s ⇒ eagv u E E2 $ by weaken [#1]
m3: $ G , c = ccom (etf u E) s ⇒ etb u E k s c = etb u E2 k s c $ by i4_etb_eqv [m3a]
m4a: $ G , c = ccom (etf u E) s ⇒ etb u E2 k s c = fv (etf u E2) ⟨ k , s ⟩ $ by eq_sym [m2]
m4b: $ G , c = ccom (etf u E) s ⇒ fv (etf u E) ⟨ k , s ⟩ = etb u E2 k s c $ by eq_trans [m1, m3]
m4: $ G , c = ccom (etf u E) s ⇒ fv (etf u E) ⟨ k , s ⟩ = fv (etf u E2) ⟨ k , s ⟩ $ by eq_trans [m4b, m4a]
w1: $ G ⇒ isset s $ by isset_var
w2: $ G ⇒ isset (ccom (etf u E) s) $ by ccom_set [v1a, w1]
w3: $ G ⇒ fv (etf u E) ⟨ k , s ⟩ = fv (etf u E2) ⟨ k , s ⟩ $ by isset_elim [w2, m4]
z1: $ G , z = ⟨ k , s ⟩ ⇒ z = ⟨ k , s ⟩ $ by ax
z2: $ G , z = ⟨ k , s ⟩ ⇒ ⟨ k , s ⟩ = z $ by eq_sym [z1]
z3: $ G , z = ⟨ k , s ⟩ ⇒ etf u E = etf u E $ by eq_refl
z4: $ G , z = ⟨ k , s ⟩ ⇒ etf u E2 = etf u E2 $ by eq_refl
z5: $ G , z = ⟨ k , s ⟩ ⇒ fv (etf u E) z = fv (etf u E) ⟨ k , s ⟩ $ by fv_eq [z3, z1]
z6: $ G , z = ⟨ k , s ⟩ ⇒ fv (etf u E2) ⟨ k , s ⟩ = fv (etf u E2) z $ by fv_eq [z4, z2]
z7: $ G , z = ⟨ k , s ⟩ ⇒ fv (etf u E) ⟨ k , s ⟩ = fv (etf u E2) ⟨ k , s ⟩ $ by weaken [w3]
z8: $ G , z = ⟨ k , s ⟩ ⇒ fv (etf u E) z = fv (etf u E2) ⟨ k , s ⟩ $ by eq_trans [z5, z7]
z9: $ G , z = ⟨ k , s ⟩ ⇒ fv (etf u E) z = fv (etf u E2) z $ by eq_trans [z8, z6]
w5: $ G ⇒ isset ⟨ k , s ⟩ $ by opair_isset
w6: $ G ⇒ ⟨ k , s ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by wcel_cab_intro [w5, z9]

etel_agv
--------
n0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ eagv u E E2 $ by weaken [#2]
n1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ k ∊ ω $ by ax
n2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ j ∊ fseq (trees ω) $ by ax
n3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by ax
n4: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ ⟨ k , j ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by i4_et_node [n0, n1, n2, n3]
n5: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} → ⟨ k , j ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by imp_intro [n4]
n6: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} → ⟨ k , j ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by imp_intro [n5]
n7: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} → ⟨ k , j ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by imp_intro [n6]
n8: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} → ⟨ k , j ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9}) $ by all_intro [n7]
n9: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} → ⟨ k , j ⟩ ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9}) $ by all_intro [n8]
n10: $ G ⇒ isset ω $ by omega_set
n11: $ G ⇒ trees ω ⊆ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by trees_ind_c [n10, n9]
n12: $ G ⇒ T ∈ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by wcel_subset [n11, #1]
t1: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} $ by ax
t5: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ fv (etf u E) b = fv (etf u E2) b $ by cab_elim [t1]
t3c: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ b = T $ by ax
t3d: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ T = b $ by eq_sym [t3c]
t6a: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ (etf u E) = (etf u E) $ by eq_refl
t6b: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ (etf u E2) = (etf u E2) $ by eq_refl
t6: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ fv (etf u E) T = fv (etf u E) b $ by fv_eq [t6a, t3d]
t7: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ fv (etf u E2) b = fv (etf u E2) T $ by fv_eq [t6b, t3c]
t8: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ fv (etf u E) T = fv (etf u E2) b $ by eq_trans [t6, t5]
t9: $ G , b = T , b ∊ {x9 | fv (etf u E) x9 = fv (etf u E2) x9} ⇒ fv (etf u E) T = fv (etf u E2) T $ by eq_trans [t8, t7]
t10: $ G ⇒ fv (etf u E) T = fv (etf u E2) T $ by wcel_elim [n12, t9]
t11: $ G ⇒ W = W $ by eq_refl
t11a: $ G ⇒ R = R $ by eq_refl
t12: $ G ⇒ etel u E T W R = etel u E2 T W R $ by da_eq [t10, t11, t11a]

lemma i4_esb_pair_lv (G: hyps) (M K S V W: class) (u y: set): $ G ⇒ ⟨ W , y ⟩ ∈ esb u M K S V $ > $ G ⇒ W ∈ lvals $
----
r1: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V ⇒ c ∊ esb u M K S V $ by ax
r2: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V ⇒ (K = kc_nil ∧ c ∊ (clam g lvals (csn ∅))) ∨ (K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) })) $ by cab_elim [r1]
r3: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) $ by ax
r4: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ c ∊ (clam g lvals (csn ∅)) $ by and_elim_r [r3]
s1: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ c = ⟨ W , y ⟩ $ by ax
s2: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ c = ⟨ a , b ⟩ $ by ax
s3: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ⟨ W , y ⟩ = c $ by eq_sym [s1]
s4: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ ⟨ W , y ⟩ = ⟨ a , b ⟩ $ by eq_trans [s3, s2]
s5: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset W $ by opair_eq_isset [s4]
s6: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset y $ by isset_var
s7: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset a $ by isset_var
s8: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ isset b $ by isset_var
s9: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ W = a ∧ y = b $ by opair_inj_c [s4, s5, s6, s7, s8]
s10: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ W = a $ by and_elim_l [s9]
s11: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ a = W $ by eq_sym [s10]
s12: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ a ∊ lvals $ by ax
s13: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) , c = ⟨ a , b ⟩ , a ∊ lvals , b ∊ csn ∅ ⇒ W ∈ lvals $ by wcel_intro [s11, s12]
s18: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_nil ∧ c ∊ (clam g lvals (csn ∅)) ⇒ W ∈ lvals $ by clam_elim_mem [r4, s13]
t3: $ G , c = ⟨ W , y ⟩ , c ∊ esb u M K S V , K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) ⇒ K = kc_cons ∧ c ∊ (clam g lvals {r | r ∊ fseq u ∧ ∃ x ∃ q (q ∊ ap (fv V (suc ∅)) g ∧ x ∊ da (fv M (fv S ∅)) g q ∧ r = scons x q) }) $ by ax
