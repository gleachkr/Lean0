wp6_36: $ G , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , n = N , n ∊ ω , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , x5 = suc x1 , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} ⇒ R = R $ by weaken [gr]
p6: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ fv R (nadd D (suc x1)) = fv R (nadd D x5) $ by fv_eq [wp6_36, p5]
wp7_37: $ G , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , n = N , n ∊ ω , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , x5 = suc x1 , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} ⇒ x2 = fv R (nadd D (suc x1)) $ by weaken [n24]
p7: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ x2 = fv R (nadd D x5) $ by eq_trans [wp7_37, p6]
p8: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ ⟨ suc x1 , x2 ⟩ = ⟨ x5 , fv R (nadd D x5) ⟩ $ by opair_eq [p2, p7]
wp9_38: $ G , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , n = N , n ∊ ω , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , x5 = suc x1 , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} ⇒ z = ⟨ suc x1 , x2 ⟩ $ by weaken [k4]
p9: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ z = ⟨ x5 , fv R (nadd D x5) ⟩ $ by eq_trans [wp9_38, p8]
p10: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ x5 ∊ suc N ∧ z = ⟨ x5 , fv R (nadd D x5) ⟩ $ by and_intro [p4, p9]
p11: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ ∃ i (i ∊ suc N ∧ z = ⟨ i , fv R (nadd D i) ⟩) $ by ex_intro [p10]
p12: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ , x5 = suc x1 ⇒ z ∊ swin R D (suc N) $ by cab_intro [p11]
p13: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ ⇒ isset (suc x1) $ by suc_set [n7]
p14: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) , i ∊ N ∧ x4 = ⟨ i , fv R (nadd (suc D) i) ⟩ ⇒ z ∊ swin R D (suc N) $ by isset_elim [p13, p12]
p15: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) , x4 = ⟨ x1 , x2 ⟩ , x4 ∊ (swin R (suc D) N) ⇒ z ∊ swin R D (suc N) $ by ex_elim [m2, p14]
p16: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N) ⇒ z ∊ swin R D (suc N) $ by wcel_elim [k5, p15]
p17: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N)) ⇒ ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N)) $ by ax
p18: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} , ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N)) ⇒ z ∊ swin R D (suc N) $ by ex_elim [p17, p16]
p19: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) , z ∊ {z | ∃ x1 ∃ x2 (z = ⟨ suc x1 , x2 ⟩ ∧ ⟨ x1 , x2 ⟩ ∈ (swin R (suc D) N))} ⇒ z ∊ swin R D (suc N) $ by ex_elim [k2, p18]
q1: $ G , n = N , n ∊ ω , z ∊ scons (fv R D) (swin R (suc D) N) ⇒ z ∊ swin R D (suc N) $ by or_elim [g1, h19, p19]
r1: $ G , n = N , n ∊ ω ⇒ swin R D (suc N) = scons (fv R D) (swin R (suc D) N) $ by eq_intro [d4, q1]
r2: $ G ⇒ swin R D (suc N) = scons (fv R D) (swin R (suc D) N) $ by wcel_elim [#3, r1]

swin_suc
--------
l1: $ G ⇒ swin R D (suc N) = scons (fv R D) (swin R (suc D) N) $ by i6_swin_suc [#1, #2, #3]

lemma i6_fvr (G: hyps) (I: class) (u r: set): $ G ⇒ uadm u $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ fv r I ∈ u $
----
l1: $ G ⇒ isset I ∨ ¬ isset I $ by excluded_middle
a0: $ G , isset I ⇒ isset I $ by ax
b1: $ G , isset I , i = I ⇒ i ∊ cdm r ∨ ¬ i ∊ cdm r $ by excluded_middle
b3: $ G , isset I , i = I , i ∊ cdm r ⇒ i ∊ cdm r $ by ax
wb4_1: $ G , i = I , i ∊ cdm r , isset I ⇒ r ∊ fseq u $ by weaken [#2]
b4: $ G , isset I , i = I , i ∊ cdm r ⇒ fv r i ∈ u $ by fseq_fv [wb4_1, b3]
b5: $ G , isset I , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ ¬ i ∊ cdm r $ by ax
b6: $ G , isset I , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ i ∊ cdm r $ by ax
b7: $ G , isset I , i = I , ¬ i ∊ cdm r , i ∊ cdm r ⇒ ⊥ $ by not_elim [b5, b6]
b8: $ G , isset I , i = I , ¬ i ∊ cdm r ⇒ i ∊ cdm r → ⊥ $ by imp_intro [b7]
b9: $ G , isset I , i = I , ¬ i ∊ cdm r ⇒ fv r i = ∅ $ by fv_empty [b8]
wb11_2: $ G , i = I , isset I , ¬ i ∊ cdm r ⇒ uadm u $ by weaken [#1]
b11: $ G , isset I , i = I , ¬ i ∊ cdm r ⇒ ∅ ∈ u $ by uadm_empty [wb11_2]
b12: $ G , isset I , i = I , ¬ i ∊ cdm r ⇒ ∅ = fv r i $ by eq_sym [b9]
b13: $ G , isset I , i = I , ¬ i ∊ cdm r ⇒ fv r i ∈ u $ by wcel_eq_l [b12, b11]
b14: $ G , isset I , i = I ⇒ fv r i ∈ u $ by or_elim [b1, b4, b13]
b15: $ G , isset I , i = I ⇒ r = r $ by eq_refl
b16: $ G , isset I , i = I ⇒ i = I $ by ax
b17: $ G , isset I , i = I ⇒ fv r i = fv r I $ by fv_eq [b15, b16]
b18: $ G , isset I , i = I ⇒ fv r I ∈ u $ by wcel_eq_l [b17, b14]
b19: $ G , isset I ⇒ fv r I ∈ u $ by isset_elim [a0, b18]
c1: $ G , ¬ isset I , x ∊ fv r I ⇒ x ∊ fv r I $ by ax
c2: $ G , ¬ isset I , x ∊ fv r I , y ∊ ap r I , x ∊ y ⇒ y ∊ ap r I $ by ax
c3: $ G , ¬ isset I , x ∊ fv r I , y ∊ ap r I , x ∊ y ⇒ ⟨ I , y ⟩ ∈ r $ by ap_elim [c2]
wc4_3: $ G , x ∊ fv r I , x ∊ y , y ∊ ap r I , ¬ isset I ⇒ r ∊ fseq u $ by weaken [#2]
c4: $ G , ¬ isset I , x ∊ fv r I , y ∊ ap r I , x ∊ y ⇒ rel r $ by fseq_rel [wc4_3]
c5: $ G , ¬ isset I , x ∊ fv r I , y ∊ ap r I , x ∊ y ⇒ isset I $ by rel_pair_isset [c4, c3]
c6: $ G , ¬ isset I , x ∊ fv r I , y ∊ ap r I , x ∊ y ⇒ ¬ isset I $ by ax
c7: $ G , ¬ isset I , x ∊ fv r I , y ∊ ap r I , x ∊ y ⇒ ⊥ $ by not_elim [c6, c5]
c8: $ G , ¬ isset I , x ∊ fv r I ⇒ ⊥ $ by cuni_elim [c1, c7]
c9: $ G , ¬ isset I ⇒ fv r I = ∅ $ by empty_eq_intro [c8]
wc10_4: $ G , ¬ isset I ⇒ uadm u $ by weaken [#1]
c10: $ G , ¬ isset I ⇒ ∅ ∈ u $ by uadm_empty [wc10_4]
c11: $ G , ¬ isset I ⇒ ∅ = fv r I $ by eq_sym [c9]
c12: $ G , ¬ isset I ⇒ fv r I ∈ u $ by wcel_eq_l [c11, c10]
l2: $ G ⇒ fv r I ∈ u $ by or_elim [l1, b19, c12]

lemma i6_swin_cres {i: set} (G: hyps) (D N: class) (r: set): $ G ⇒ swin r D N = cres (cgr i (fv r (nadd D i))) N $
----
a1: $ G , z ∊ swin r D N ⇒ z ∊ swin r D N $ by ax
a2: $ G , z ∊ swin r D N ⇒ ∃ j (j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩) $ by cab_elim [a1]
b1: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ $ by ax
b2: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ ⇒ j ∊ N $ by and_elim_l [b1]
b3: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ ⇒ z = ⟨ j , fv r (nadd D j) ⟩ $ by and_elim_r [b1]
b4a: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ ⇒ isset r $ by isset_var
b4: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ ⇒ isset (fv r (nadd D j)) $ by fv_set_l [b4a]
b5: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ v = fv r (nadd D j) $ by ax
b6: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ ⟨ j , v ⟩ ∈ (cgr i (fv r (nadd D i))) $ by cgr_intro [b5]
wb7_5: $ G , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) , z ∊ swin r D N ⇒ j ∊ N $ by weaken [b2]
b7: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ ⟨ j , v ⟩ ∈ cres (cgr i (fv r (nadd D i))) N $ by cres_intro [wb7_5, b6]
b8: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ fv r (nadd D j) = v $ by eq_sym [b5]
b8a: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ j = j $ by eq_refl
b9: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ ⟨ j , fv r (nadd D j) ⟩ = ⟨ j , v ⟩ $ by opair_eq [b8a, b8]
wb10_6: $ G , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) , z ∊ swin r D N ⇒ z = ⟨ j , fv r (nadd D j) ⟩ $ by weaken [b3]
b10: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ z = ⟨ j , v ⟩ $ by eq_trans [wb10_6, b9]
b10a: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ ⟨ j , v ⟩ = z $ by eq_sym [b10]
b11a: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ z ∈ cres (cgr i (fv r (nadd D i))) N $ by wcel_eq_l [b10a, b7]
b11: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ , v = fv r (nadd D j) ⇒ z ∊ cres (cgr i (fv r (nadd D i))) N $ by wcel_welc [b11a]
b12: $ G , z ∊ swin r D N , j ∊ N ∧ z = ⟨ j , fv r (nadd D j) ⟩ ⇒ z ∊ cres (cgr i (fv r (nadd D i))) N $ by isset_elim [b4, b11]
b13: $ G , z ∊ swin r D N ⇒ z ∊ cres (cgr i (fv r (nadd D i))) N $ by ex_elim [a2, b12]
c1: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N ⇒ z ∊ cres (cgr i (fv r (nadd D i))) N $ by ax
c2: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N ⇒ ∃ x ∃ y (z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i)))) $ by cab_elim [c1]
d1: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N , z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) ⇒ z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) $ by ax
d2: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N , z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) ⇒ z = ⟨ x , y ⟩ $ by and_elim_l [d1]
d3: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N , z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) ⇒ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) $ by and_elim_r [d1]
d4: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N , z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) ⇒ x ∊ N $ by and_elim_l [d3]
d5: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N , z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) ⇒ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) $ by and_elim_r [d3]
d6: $ G , z ∊ cres (cgr i (fv r (nadd D i))) N , z = ⟨ x , y ⟩ ∧ x ∊ N ∧ ⟨ x , y ⟩ ∈ (cgr i (fv r (nadd D i))) ⇒ y = fv r (nadd D x) $ by cgr_elim [d5]
