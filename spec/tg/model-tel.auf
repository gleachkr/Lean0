h3d: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c , ¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ z = ⟨ x1 , q ⟩ $ by weaken [g4]
h3: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c , ¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by i7_cc [h3c, h3d, h3b]
h4a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c , (k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv j (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ (k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv j (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) $ by ax
h4b: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c , (k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv j (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv j (suc ∅))) w r) a ⟩ ⟩ ⟩)}) ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by weaken [h2]
h4c: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c , (k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv j (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) , ¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩)) ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by weaken [h3]
h4: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c , (k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) {y | ∃ a (⟨ ∅ , ⟨ ∅ , ⟨ ∅ , a ⟩ ⟩ ⟩ ∈ da (fv c ∅) w r ∧ y = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , scons (da (fv E (fv j (suc ∅))) w r) a ⟩ ⟩ ⟩)})) ∨ (¬ k = kc_pi ∧ ¬ k = kc_app ∧ d ∊ clam w lvals (clam r (fseq u) (csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩))) ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by or_elim [h4a, h4b, h4c]
h5: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 , d = ⟨ x0 , z ⟩ , d ∊ etb u E k j c ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by or_elim [g2, h1, h4]
f3: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j , z = ⟨ x1 , q ⟩ , z ∊ ap (etb u E k j c) x0 ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by wcel_elim [f2, h5]
e10: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ , c = ccom (etf u E) j ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by wcel_elim [e9, f3]
e11a: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ ⇒ functional (etf u E) $ by etf_functional
e11b: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ ⇒ isset j $ by isset_var
e11: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ ⇒ isset (ccom (etf u E) j) $ by ccom_set [e11a, e11b]
e12: $ G , l = ω , k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩ ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by isset_elim [e11, e10]
e13: $ G , l = ω , ∃ j (k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩) ⇒ ∃ j (k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩) $ by ax
e14: $ G , l = ω , ∃ j (k ∊ l ∧ j ∊ fseq (trees l) ∧ o = ⟨ k , j ⟩) ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by ex_elim [e13, e12]
e15: $ G , l = ω ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by ex_elim [p1, e14]
e16: $ G ⇒ x0 ∊ lvals ∧ x1 ∊ fseq u $ by isset_elim [p0, e15]

--| The property of the induction for `lrel_npis_sem`.
def i7_npp (U E W: class) (.z .n .f .g .t .a .r: set): class = $ {z | ∀ n ∀ f ∀ g ∀ t ∀ a ∀ r (ra_npis z n ∈ lrel → ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel U E z W r → cdm f = fv nvf n)} $

--| A field sequence equal to `∅` has no fields: the number of fields at `nz`.
lemma i7_np_zero (G: hyps) (f n: set): $ G ⇒ f = ∅ $ > $ G ⇒ n = ⟨ kc_nz , ∅ ⟩ $ > $ G ⇒ cdm f = fv nvf n $
----
l1: $ G ⇒ cdm f = cdm ∅ $ by cdm_eq [#1]
l2: $ G ⇒ cdm ∅ = ∅ $ by cdm_empty
l3: $ G ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
l4: $ G ⇒ nvf = nvf $ by eq_refl
l5: $ G ⇒ fv nvf n = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [l4, #2]
l6: $ G ⇒ fv nvf n = ∅ $ by eq_trans [l5, l3]
l7: $ G ⇒ ∅ = fv nvf n $ by eq_sym [l6]
l8: $ G ⇒ cdm f = ∅ $ by eq_trans [l1, l2]
l9: $ G ⇒ cdm f = fv nvf n $ by eq_trans [l8, l7]

lemma i7_np_c1 (G: hyps) (E: class) (u w y n f g t a r x2: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r $ > $ G ⇒ (y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩) → cdm f = fv nvf n $
----
a0: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ $ by ax
a1: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ y = ⟨ kc_bvar , scons x2 ∅ ⟩ $ by and_elim_l [a0]
a2: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ n = ⟨ kc_nz , ∅ ⟩ $ by and_elim_r [a0]
b1: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ y ∊ trees ω $ by weaken [#3]
b2: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ y ∈ trees ω $ by welc_wcel [b1]
b3: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ kc_bvar , scons x2 ∅ ⟩ ∈ trees ω $ by wcel_eq_l [a1, b2]
b4: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ isset ω $ by omega_set
b5: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ kc_bvar ∈ ω $ by kc_bvar_omega
b6: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ isset kc_bvar $ by wcel_isset [b5]
b7: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ x2 ∊ trees ω $ by trees_kids1 [b4, b3, b6]
b8: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ x2 ∈ trees ω $ by welc_wcel [b7]
b9: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ∅ ∈ fseq (trees ω) $ by fseq_empty
b10: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ scons x2 ∅ ∈ fseq (trees ω) $ by scons_fseq_c [b8, b9]
b11: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_bvar = kc_pi $ by kc_bvar_ne_pi
b12: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ¬ kc_bvar = kc_app $ by kc_bvar_ne_app
b13: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ w ∊ lvals $ by weaken [#1]
b14: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ w ∈ lvals $ by welc_wcel [b13]
b15: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ r ∊ fseq u $ by weaken [#2]
b16: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ r ∈ fseq u $ by welc_wcel [b15]
e1: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ etel u E ⟨ kc_bvar , scons x2 ∅ ⟩ w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by etel_other_c [b5, b10, b11, b12, b14, b16]
e1a: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ w = w $ by eq_refl
e1b: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ r = r $ by eq_refl
e2: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ etel u E y w r = etel u E ⟨ kc_bvar , scons x2 ∅ ⟩ w r $ by etel_eq [a1, e1a, e1b]
e3: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ etel u E y w r = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by eq_trans [e2, e1]
e4: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r $ by weaken [#4]
e5: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by wcel_eq_r [e3, e4]
e6: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ ⟩ $ by i7_wcel_csn [e5]
e7: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ isset f $ by isset_var
e8: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ isset ⟨ g , ⟨ t , a ⟩ ⟩ $ by opair_isset
e9: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ isset ∅ $ by ax_empty
e10: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ isset ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ $ by opair_isset
e11: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ f = ∅ ∧ ⟨ g , ⟨ t , a ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ∅ ⟩ ⟩ $ by opair_inj_c [e6, e7, e8, e9, e10]
e12: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ f = ∅ $ by and_elim_l [e11]
e13: $ G , y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩ ⇒ cdm f = fv nvf n $ by i7_np_zero [e12, a2]
e14: $ G ⇒ (y = ⟨ kc_bvar , scons x2 ∅ ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩) → cdm f = fv nvf n $ by imp_intro [e13]

lemma i7_np_c2 (G: hyps) (E: class) (u w y n f g t a r x3 x4: set): $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ y ∊ trees ω $ > $ G ⇒ ⟨ f , ⟨ g , ⟨ t , a ⟩ ⟩ ⟩ ∈ etel u E y w r $ > $ G ⇒ (y = ⟨ kc_app , scons x3 (scons x4 ∅) ⟩ ∧ n = ⟨ kc_nz , ∅ ⟩) → cdm f = fv nvf n $
