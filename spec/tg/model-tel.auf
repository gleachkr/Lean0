lemma i4_esat_lv (G: hyps) (E P W: class) (u q: set):
  $ G ⇒ P ∈ trees ω $ > $ G ⇒ q ∊ esat u E P W $ > $ G ⇒ W ∈ lvals $
----
a1: $ G ⇒ ⟨ W , q ⟩ ∈ fv (esf u E) P $ by ap_elim [#2]
b1: $ G , t = P , t ∊ trees ω ⇒ t ∊ trees ω $ by ax
b2w: $ G , t = P , t ∊ trees ω ⇒ isset ω $ by omega_set
b2: $ G , t = P , t ∊ trees ω ⇒ ω × fseq (trees ω) = trees ω $ by trees_fix_c [b2w]
b3: $ G , t = P , t ∊ trees ω ⇒ trees ω = ω × fseq (trees ω) $ by eq_sym [b2]
b4: $ G , t = P , t ∊ trees ω ⇒ t ∊ ω × fseq (trees ω) $ by welc_eq [b3, b1]
d1: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ k ∊ ω $ by ax
d2: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ j ∊ fseq (trees ω) $ by ax
d3: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ fv (esf u E) ⟨ k , j ⟩ = esb u E k j (ccom (esf u E) j) $ by esf_node [d1, d2]
d4: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ t = P $ by ax
d5: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ P = t $ by eq_sym [d4]
d6: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ t = ⟨ k , j ⟩ $ by ax
d7: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ P = ⟨ k , j ⟩ $ by eq_trans [d5, d6]
d8: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ esf u E = esf u E $ by eq_refl
d9: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ fv (esf u E) P = fv (esf u E) ⟨ k , j ⟩ $ by fv_eq [d8, d7]
d10: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ fv (esf u E) P = esb u E k j (ccom (esf u E) j) $ by eq_trans [d9, d3]
d11a: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ ⟨ W , q ⟩ ∈ fv (esf u E) P $ by weaken [a1]
d11: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ ⟨ W , q ⟩ ∈ esb u E k j (ccom (esf u E) j) $ by wcel_eq_r [d10, d11a]
d12: $ G , t = P , t ∊ trees ω , t = ⟨ k , j ⟩ , k ∊ ω , j ∊ fseq (trees ω) ⇒ W ∈ lvals $ by i4_esb_pair_lv [d11]
e1: $ G , t = P , t ∊ trees ω ⇒ W ∈ lvals $ by cxp_elim [b4, d12]
e2: $ G ⇒ W ∈ lvals $ by wcel_elim [#1, e1]

lemma i4_nsp_sub {y p z: set} (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $
----
a1: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} $ by ax
a2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ ∃ p ∃ z (p ∊ A ∧ v = nest p z) $ by cab_elim [a1]
b1: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ p ∊ A ∧ v = nest p z $ by ax
b2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ p ∊ A $ by and_elim_l [b1]
b3: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ v = nest p z $ by and_elim_r [b1]
b4: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ A = B $ by weaken [#1]
b5: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ p ∊ B $ by welc_eq [b4, b2]
b6: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ p ∊ B ∧ v = nest p z $ by and_intro [b5, b3]
b7: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ ∃ z (p ∊ B ∧ v = nest p z) $ by ex_intro [b6]
b8: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , p ∊ A ∧ v = nest p z ⇒ ∃ p ∃ z (p ∊ B ∧ v = nest p z) $ by ex_intro [b7]
c1: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , ∃ z (p ∊ A ∧ v = nest p z) ⇒ ∃ z (p ∊ A ∧ v = nest p z) $ by ax
c2: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} , ∃ z (p ∊ A ∧ v = nest p z) ⇒ ∃ p ∃ z (p ∊ B ∧ v = nest p z) $ by ex_elim [c1, b8]
c3: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ ∃ p ∃ z (p ∊ B ∧ v = nest p z) $ by ex_elim [a2, c2]
c4: $ G , v ∊ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⇒ v ∊ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by cab_intro [c3]
c5: $ G ⇒ {y | ∃ p ∃ z (p ∊ A ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ B ∧ y = nest p z)} $ by subset_intro [c4]

lemma i4_ipi_sub {q: set} (G: hyps) (E E2 P F W: class) (u: set):
  $ G ⇒ esat u E P W = esat u E2 P W $ > $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ >
  $ G ⇒ ipi u E P F W ⊆ ipi u E2 P F W $
----
a1: $ G , x ∊ ipi u E P F W ⇒ x ∊ ipi u E P F W $ by ax
a2: $ G , x ∊ ipi u E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat u E P W → apn x q ∈ da (fv E F) W q) $ by cab_elim [a1]
a3: $ G , x ∊ ipi u E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E P W ∧ y = nest p z)} $ by and_elim_l [a2]
a4: $ G , x ∊ ipi u E P F W ⇒ ∀ q (q ∊ esat u E P W → apn x q ∈ da (fv E F) W q) $ by and_elim_r [a2]
a5: $ G , x ∊ ipi u E P F W ⇒ esat u E P W = esat u E2 P W $ by weaken [#1]
a6: $ G , x ∊ ipi u E P F W ⇒ {y | ∃ p ∃ z (p ∊ esat u E P W ∧ y = nest p z)} ⊆ {y | ∃ p ∃ z (p ∊ esat u E2 P W ∧ y = nest p z)} $ by i4_nsp_sub [a5]
a7: $ G , x ∊ ipi u E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E2 P W ∧ y = nest p z)} $ by subset_trans [a3, a6]
b1: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ q ∊ esat u E2 P W $ by ax
b2a: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ esat u E P W = esat u E2 P W $ by weaken [#1]
b2: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ esat u E2 P W = esat u E P W $ by eq_sym [b2a]
b3: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ q ∊ esat u E P W $ by welc_eq [b2, b1]
b4: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ ∀ q (q ∊ esat u E P W → apn x q ∈ da (fv E F) W q) $ by weaken [a4]
b5: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ q ∊ esat u E P W → apn x q ∈ da (fv E F) W q $ by all_elim [b4]
b6: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ apn x q ∈ da (fv E F) W q $ by imp_elim [b5, b3]
b7: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ by weaken [#2]
b8: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q $ by all_elim [b7]
b9: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ da (fv E F) W q = da (fv E2 F) W q $ by imp_elim [b8, b3]
b10: $ G , x ∊ ipi u E P F W , q ∊ esat u E2 P W ⇒ apn x q ∈ da (fv E2 F) W q $ by wcel_eq_r [b9, b6]
b11: $ G , x ∊ ipi u E P F W ⇒ q ∊ esat u E2 P W → apn x q ∈ da (fv E2 F) W q $ by imp_intro [b10]
b12: $ G , x ∊ ipi u E P F W ⇒ ∀ q (q ∊ esat u E2 P W → apn x q ∈ da (fv E2 F) W q) $ by all_intro [b11]
c1: $ G , x ∊ ipi u E P F W ⇒ x ⊆ {y | ∃ p ∃ z (p ∊ esat u E2 P W ∧ y = nest p z)} ∧ ∀ q (q ∊ esat u E2 P W → apn x q ∈ da (fv E2 F) W q) $ by and_intro [a7, b12]
c2: $ G , x ∊ ipi u E P F W ⇒ x ∊ ipi u E2 P F W $ by cab_intro [c1]
c3: $ G ⇒ ipi u E P F W ⊆ ipi u E2 P F W $ by subset_intro [c2]

lemma i4_ilam_sub {q: set} (G: hyps) (E E2 P F W: class) (u: set):
  $ G ⇒ esat u E P W = esat u E2 P W $ > $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ >
  $ G ⇒ ilam u E P F W ⊆ ilam u E2 P F W $
----
a1: $ G , v ∊ ilam u E P F W ⇒ v ∊ ilam u E P F W $ by ax
a2: $ G , v ∊ ilam u E P F W ⇒ ∃ p ∃ z (p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z) $ by cab_elim [a1]
b1: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z $ by ax
b2: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ p ∊ esat u E P W $ by and_elim_l [b1]
b3: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ z ∊ da (fv E F) W p ∧ v = nest p z $ by and_elim_r [b1]
b4: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ z ∊ da (fv E F) W p $ by and_elim_l [b3]
b5: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ v = nest p z $ by and_elim_r [b3]
b6: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ esat u E P W = esat u E2 P W $ by weaken [#1]
b7: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ p ∊ esat u E2 P W $ by welc_eq [b6, b2]
b8: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ by weaken [#2]
b9: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ p ∊ esat u E P W → da (fv E F) W p = da (fv E2 F) W p $ by all_elim [b8]
b10: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ da (fv E F) W p = da (fv E2 F) W p $ by imp_elim [b9, b2]
b11: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ z ∊ da (fv E2 F) W p $ by welc_eq [b10, b4]
b12: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ z ∊ da (fv E2 F) W p ∧ v = nest p z $ by and_intro [b11, b5]
b13: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ p ∊ esat u E2 P W ∧ z ∊ da (fv E2 F) W p ∧ v = nest p z $ by and_intro [b7, b12]
b14: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ ∃ z (p ∊ esat u E2 P W ∧ z ∊ da (fv E2 F) W p ∧ v = nest p z) $ by ex_intro [b13]
b15: $ G , v ∊ ilam u E P F W , p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z ⇒ ∃ p ∃ z (p ∊ esat u E2 P W ∧ z ∊ da (fv E2 F) W p ∧ v = nest p z) $ by ex_intro [b14]
c1: $ G , v ∊ ilam u E P F W , ∃ z (p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z) ⇒ ∃ z (p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z) $ by ax
c2: $ G , v ∊ ilam u E P F W , ∃ z (p ∊ esat u E P W ∧ z ∊ da (fv E F) W p ∧ v = nest p z) ⇒ ∃ p ∃ z (p ∊ esat u E2 P W ∧ z ∊ da (fv E2 F) W p ∧ v = nest p z) $ by ex_elim [c1, b15]
c3: $ G , v ∊ ilam u E P F W ⇒ ∃ p ∃ z (p ∊ esat u E2 P W ∧ z ∊ da (fv E2 F) W p ∧ v = nest p z) $ by ex_elim [a2, c2]
c4: $ G , v ∊ ilam u E P F W ⇒ v ∊ ilam u E2 P F W $ by cab_intro [c3]
c5: $ G ⇒ ilam u E P F W ⊆ ilam u E2 P F W $ by subset_intro [c4]

lemma i4_agv_hyp {q: set} (G: hyps) (E E2 P F W: class) (u: set):
  $ G ⇒ P ∈ trees ω $ > $ G ⇒ eagv u E E2 $ > $ G ⇒ isset F $ >
  $ G ⇒ esat u E P W = esat u E2 P W ∧ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧
      esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $
----
e0: $ G ⇒ esat u E P W = esat u E2 P W $ by esat_agv [#1, #2]
e0s: $ G ⇒ esat u E2 P W = esat u E P W $ by eq_sym [e0]
q1: $ G , q ∊ esat u E P W ⇒ q ∊ esat u E P W $ by ax
q1a: $ G , q ∊ esat u E P W ⇒ P ∈ trees ω $ by weaken [#1]
q2: $ G , q ∊ esat u E P W ⇒ W ∈ lvals $ by i4_esat_lv [q1a, q1]
q3: $ G , q ∊ esat u E P W ⇒ esat u E P W ⊆ fseq u $ by esat_fseq
q4: $ G , q ∊ esat u E P W ⇒ q ∊ fseq u $ by subset_elim [q3, q1]
q5: $ G , q ∊ esat u E P W ⇒ q ∈ fseq u $ by welc_wcel [q4]
q6: $ G , q ∊ esat u E P W ⇒ eagv u E E2 $ by weaken [#2]
q7: $ G , q ∊ esat u E P W ⇒ isset F $ by weaken [#3]
q8: $ G , q ∊ esat u E P W ⇒ da (fv E F) W q = da (fv E2 F) W q $ by i4_eagv_at [q6, q7, q2, q5]
q9: $ G ⇒ q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q $ by imp_intro [q8]
h1: $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ by all_intro [q9]
r1: $ G , q ∊ esat u E2 P W ⇒ q ∊ esat u E2 P W $ by ax
r1a: $ G , q ∊ esat u E2 P W ⇒ P ∈ trees ω $ by weaken [#1]
r2: $ G , q ∊ esat u E2 P W ⇒ W ∈ lvals $ by i4_esat_lv [r1a, r1]
r3: $ G , q ∊ esat u E2 P W ⇒ esat u E2 P W ⊆ fseq u $ by esat_fseq
r4: $ G , q ∊ esat u E2 P W ⇒ q ∊ fseq u $ by subset_elim [r3, r1]
r5: $ G , q ∊ esat u E2 P W ⇒ q ∈ fseq u $ by welc_wcel [r4]
r6: $ G , q ∊ esat u E2 P W ⇒ eagv u E E2 $ by weaken [#2]
r7: $ G , q ∊ esat u E2 P W ⇒ isset F $ by weaken [#3]
r8: $ G , q ∊ esat u E2 P W ⇒ da (fv E F) W q = da (fv E2 F) W q $ by i4_eagv_at [r6, r7, r2, r5]
r8s: $ G , q ∊ esat u E2 P W ⇒ da (fv E2 F) W q = da (fv E F) W q $ by eq_sym [r8]
r9: $ G ⇒ q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q $ by imp_intro [r8s]
h2: $ G ⇒ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by all_intro [r9]
k1: $ G ⇒ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_intro [e0s, h2]
k2: $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_intro [h1, k1]
k3: $ G ⇒ esat u E P W = esat u E2 P W ∧ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_intro [e0, k2]

lemma i4_ipi_agv (G: hyps) (E E2 P F W: class) (u: set):
  $ G ⇒ P ∈ trees ω $ > $ G ⇒ eagv u E E2 $ > $ G ⇒ isset F $ > $ G ⇒ ipi u E P F W = ipi u E2 P F W $
----
k0: $ G ⇒ esat u E P W = esat u E2 P W ∧ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by i4_agv_hyp [#1, #2, #3]
k1: $ G ⇒ esat u E P W = esat u E2 P W $ by and_elim_l [k0]
k2: $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_elim_r [k0]
k3: $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ by and_elim_l [k2]
k4: $ G ⇒ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_elim_r [k2]
k5: $ G ⇒ esat u E2 P W = esat u E P W $ by and_elim_l [k4]
k6: $ G ⇒ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_elim_r [k4]
s1: $ G ⇒ ipi u E P F W ⊆ ipi u E2 P F W $ by i4_ipi_sub [k1, k3]
s2: $ G ⇒ ipi u E2 P F W ⊆ ipi u E P F W $ by i4_ipi_sub [k5, k6]
s3: $ G ⇒ ipi u E P F W = ipi u E2 P F W $ by subset_antisym [s1, s2]

lemma i4_ilam_agv (G: hyps) (E E2 P F W: class) (u: set):
  $ G ⇒ P ∈ trees ω $ > $ G ⇒ eagv u E E2 $ > $ G ⇒ isset F $ > $ G ⇒ ilam u E P F W = ilam u E2 P F W $
----
k0: $ G ⇒ esat u E P W = esat u E2 P W ∧ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by i4_agv_hyp [#1, #2, #3]
k1: $ G ⇒ esat u E P W = esat u E2 P W $ by and_elim_l [k0]
k2: $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) ∧ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_elim_r [k0]
k3: $ G ⇒ ∀ q (q ∊ esat u E P W → da (fv E F) W q = da (fv E2 F) W q) $ by and_elim_l [k2]
k4: $ G ⇒ esat u E2 P W = esat u E P W ∧ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_elim_r [k2]
k5: $ G ⇒ esat u E2 P W = esat u E P W $ by and_elim_l [k4]
k6: $ G ⇒ ∀ q (q ∊ esat u E2 P W → da (fv E2 F) W q = da (fv E F) W q) $ by and_elim_r [k4]
s1: $ G ⇒ ilam u E P F W ⊆ ilam u E2 P F W $ by i4_ilam_sub [k1, k3]
s2: $ G ⇒ ilam u E2 P F W ⊆ ilam u E P F W $ by i4_ilam_sub [k5, k6]
s3: $ G ⇒ ilam u E P F W = ilam u E2 P F W $ by subset_antisym [s1, s2]

ipi_agv
-------
l0: $ G ⇒ isset F $ by wcel_isset [#2]
l1: $ G ⇒ ipi u E P F W = ipi u E2 P F W $ by i4_ipi_agv [#1, #3, l0]

ilam_agv
--------
l0: $ G ⇒ isset F $ by wcel_isset [#2]
l1: $ G ⇒ ilam u E P F W = ilam u E2 P F W $ by i4_ilam_agv [#1, #3, l0]

ilam_nil
--------
a1: $ G , v ∊ ilam u E ⟨ kc_nil , ∅ ⟩ F w ⇒ v ∊ ilam u E ⟨ kc_nil , ∅ ⟩ F w $ by ax
a2: $ G , v ∊ ilam u E ⟨ kc_nil , ∅ ⟩ F w ⇒ ∃ p ∃ z (p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ z ∊ da (fv E F) w p ∧ v = nest p z) $ by cab_elim [a1]
b1: $ G , v ∊ ilam u E ⟨ kc_nil , ∅ ⟩ F w , p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ z ∊ da (fv E F) w p ∧ v = nest p z ⇒ p ∊ esat u E ⟨ kc_nil , ∅ ⟩ w ∧ z ∊ da (fv E F) w p ∧ v = nest p z $ by ax
