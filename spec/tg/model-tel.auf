lemma i6_app_sorted (G: hyps) (z e a: set): $ G ⇒ z ∊ ofsort lsig lopen ks_expr $ > $ G ⇒ z = ⟨ kc_app , scons e (scons a ∅) ⟩ $ > $ G ⇒ e ∊ ofsort lsig lopen ks_expr ∧ a ∊ ofsort lsig lopen ks_expr $
