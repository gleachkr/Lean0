k0j0: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ isset kc_app $ by weaken [c7]
k0j1: $ G , z = ⟨ kc_app , scons x (scons y ∅) ⟩ , z ∊ ofsort lsig lopen ks_expr , z = ⟨ kc_bvar , scons x5 ∅ ⟩ ∧ x5 ∊ ofsort lsig lopen ks_nat ⇒ isset (scons x (scons y ∅)) $ by weaken [c5]
