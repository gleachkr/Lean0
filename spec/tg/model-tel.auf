c1x0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ , ra_iargs t1 m t3 z ∈ lrel , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (t1 = x1 ∧ m = ⟨ kc_s , scons x2 ∅ ⟩ ∧ t3 = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_iargs x1 x2 x3 x4 ∈ lrel ∧ ra_closed x1 x5 ∈ lrel) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (t1 = x1 ∧ m = ⟨ kc_s , scons x2 ∅ ⟩ ∧ t3 = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_iargs x1 x2 x3 x4 ∈ lrel ∧ ra_closed x1 x5 ∈ lrel) $ by ax
c1f0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ , ra_iargs t1 m t3 z ∈ lrel , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (t1 = x1 ∧ m = ⟨ kc_s , scons x2 ∅ ⟩ ∧ t3 = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_iargs x1 x2 x3 x4 ∈ lrel ∧ ra_closed x1 x5 ∈ lrel) ⇒ etel u (dnf u M) z w r = etel u (dnf u M) z w r2 $ by ex_elim [c1x0, c1f1]
o0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ , ra_iargs t1 m t3 z ∈ lrel , ∃ x1 ∃ x3 (t1 = x1 ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ t3 = x3 ∧ z = x3) ∨ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x5 (t1 = x1 ∧ m = ⟨ kc_s , scons x2 ∅ ⟩ ∧ t3 = x3 ∧ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ ∧ ra_iargs x1 x2 x3 x4 ∈ lrel ∧ ra_closed x1 x5 ∈ lrel) ⇒ etel u (dnf u M) z w r = etel u (dnf u M) z w r2 $ by i8_or_case [c0f0, c1f0]
s5: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ , ra_iargs t1 m t3 z ∈ lrel ⇒ etel u (dnf u M) z w r = etel u (dnf u M) z w r2 $ by cut [s4, o0]
t0: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ ⇒ ra_iargs t1 m t3 z ∈ lrel → etel u (dnf u M) z w r = etel u (dnf u M) z w r2 $ by imp_intro [s5]
t0b: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ ⇒ ∀ m (ra_iargs t1 m t3 z ∈ lrel → etel u (dnf u M) z w r = etel u (dnf u M) z w r2) $ by all_intro [t0]
t1: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ ⇒ z ∊ i8_iae u M w t1 t3 r r2 $ by cab_intro [t0b]
t2a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ ⇒ z = ⟨ k , j ⟩ $ by ax
t2: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 , z = ⟨ k , j ⟩ ⇒ ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2 $ by wcel_intro [t2a, t1]
t3a: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 ⇒ isset ⟨ k , j ⟩ $ by opair_isset
t3: $ G , k ∊ ω , j ∊ fseq (trees ω) , crn j ⊆ i8_iae u M w t1 t3 r r2 ⇒ ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2 $ by isset_elim [t3a, t2]
t4: $ G , k ∊ ω , j ∊ fseq (trees ω) ⇒ crn j ⊆ i8_iae u M w t1 t3 r r2 → ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2 $ by imp_intro [t3]
t5: $ G , k ∊ ω ⇒ j ∊ fseq (trees ω) → crn j ⊆ i8_iae u M w t1 t3 r r2 → ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2 $ by imp_intro [t4]
t6: $ G ⇒ k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i8_iae u M w t1 t3 r r2 → ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2 $ by imp_intro [t5]
t7: $ G ⇒ ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i8_iae u M w t1 t3 r r2 → ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2) $ by all_intro [t6]
t8: $ G ⇒ ∀ k ∀ j (k ∊ ω → j ∊ fseq (trees ω) → crn j ⊆ i8_iae u M w t1 t3 r r2 → ⟨ k , j ⟩ ∈ i8_iae u M w t1 t3 r r2) $ by all_intro [t7]
t9a: $ G ⇒ isset ω $ by omega_set
t9: $ G ⇒ trees ω ⊆ i8_iae u M w t1 t3 r r2 $ by trees_ind_c [t9a, t8]
f1: $ G ⇒ t4 ∊ i8_iae u M w t1 t3 r r2 $ by subset_elim [t9, #2]
f2: $ G ⇒ ∀ m (ra_iargs t1 m t3 t4 ∈ lrel → etel u (dnf u M) t4 w r = etel u (dnf u M) t4 w r2) $ by cab_elim [f1]
f3: $ G ⇒ ra_iargs t1 t2 t3 t4 ∈ lrel → etel u (dnf u M) t4 w r = etel u (dnf u M) t4 w r2 $ by all_elim [f2]
f4: $ G ⇒ etel u (dnf u M) t4 w r = etel u (dnf u M) t4 w r2 $ by imp_elim [f3, #1]

--| The trees `y` with `iargs K m X y` for no `m`, or with paths (values) that follow `X`'s.
def i8_iam (U M W K X R R2: class) (.y .m: set): class = $ {y | ∀ m (ra_iargs K m X y ∈ lrel → dt U M y W R ⊆ dt U M y W R2)} $

lemma i8_iam_step {i: set} (G: hyps i) (M: class) (u w r r2 t1 t3 z k j x1 x2 x3 x4 x5: set): $ G ⇒ crn j ⊆ i8_iam u M w t1 t3 r r2 $ > $ G ⇒ z = ⟨ k , j ⟩ $ > $ G ⇒ t1 = x1 $ > $ G ⇒ t3 = x3 $ > $ G ⇒ z = ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ $ > $ G ⇒ ra_iargs x1 x2 x3 x4 ∈ lrel $ > $ G ⇒ ra_closed x1 x5 ∈ lrel $ > $ G ⇒ w ∊ lvals $ > $ G ⇒ r ∊ fseq u $ > $ G ⇒ r2 ∊ fseq u $ > $ G ⇒ ∀ i (i ∊ fv nvf t1 → fv r i = fv r2 i) $ > $ G ⇒ dt u M z w r ⊆ dt u M z w r2 $
----
a0: $ G ⇒ kc_app ∈ ω $ by kc_app_omega
a1: $ G ⇒ isset kc_app $ by wcel_isset [a0]
a2a: $ G ⇒ isset ∅ $ by ax_empty
a2b: $ G ⇒ isset (scons x5 ∅) $ by scons_set [a2a]
a2: $ G ⇒ isset (scons x4 (scons x5 ∅)) $ by scons_set [a2b]
a3: $ G ⇒ crn (scons x4 (scons x5 ∅)) ⊆ i8_iam u M w t1 t3 r r2 $ by i8_ch [#1, #2, #5, a1, a2]
a4a: $ G ⇒ isset x4 $ by isset_var
a4b: $ G ⇒ x4 ∈ i8_iam u M w t1 t3 r r2 $ by crn_scons_head [a4a, a3]
a4: $ G ⇒ x4 ∊ i8_iam u M w t1 t3 r r2 $ by wcel_welc [a4b]
a5: $ G ⇒ ∀ m (ra_iargs t1 m t3 x4 ∈ lrel → dt u M x4 w r ⊆ dt u M x4 w r2) $ by cab_elim [a4]
a6: $ G ⇒ ra_iargs t1 x2 t3 x4 ∈ lrel → dt u M x4 w r ⊆ dt u M x4 w r2 $ by all_elim [a5]
b1: $ G ⇒ x1 = t1 $ by eq_sym [#3]
b2: $ G ⇒ x2 = x2 $ by eq_refl
b3: $ G ⇒ x3 = t3 $ by eq_sym [#4]
b4: $ G ⇒ x4 = x4 $ by eq_refl
b5: $ G ⇒ ra_iargs x1 x2 x3 x4 = ra_iargs t1 x2 t3 x4 $ by ra_iargs_eq [b1, b2, b3, b4]
b6: $ G ⇒ ra_iargs t1 x2 t3 x4 ∈ lrel $ by wcel_eq_l [b5, #6]
b7: $ G ⇒ dt u M x4 w r ⊆ dt u M x4 w r2 $ by imp_elim [a6, b6]
g0: $ G ⇒ nvf = nvf $ by eq_refl
g1: $ G ⇒ fv nvf t1 = fv nvf x1 $ by fv_eq [g0, #3]
g2: $ G ⇒ r = r $ by eq_refl
g3: $ G ⇒ r2 = r2 $ by eq_refl
g4: $ G ⇒ ∀ i (i ∊ fv nvf x1 → fv r i = fv r2 i) $ by i8_agr [g1, g2, g3, #11]
j1: $ _ ⇒ ∀ i (i ∊ fv nvf x1 → fv r i = fv r2 i) ↔ ∀ v (v ∊ fv nvf x1 → fv r v = fv r2 v) $ by all_alpha
j2: $ G ⇒ ∀ i (i ∊ fv nvf x1 → fv r i = fv r2 i) ↔ ∀ v (v ∊ fv nvf x1 → fv r v = fv r2 v) $ by weaken [j1]
j3: $ G ⇒ ∀ v (v ∊ fv nvf x1 → fv r v = fv r2 v) $ by bi_elim_l [j2, g4]
v1: $ G ⇒ da (fv (dnf u M) x5) w r = da (fv (dnf u M) x5) w r2 $ by lrel_closed_sem [#7, #8, #9, #10, j3]
k0a: $ G ⇒ kr_closed ∈ ω $ by kr_closed_omega
k0: $ G ⇒ isset kr_closed $ by wcel_isset [k0a]
k1: $ G ⇒ x1 ∊ trees ω ∧ x5 ∊ trees ω $ by lrel_args2 [#7, k0]
k2a: $ G ⇒ x5 ∊ trees ω $ by and_elim_r [k1]
k2: $ G ⇒ x5 ∈ trees ω $ by welc_wcel [k2a]
k3a: $ G ⇒ kr_iargs ∈ ω $ by kr_iargs_omega
k3: $ G ⇒ isset kr_iargs $ by wcel_isset [k3a]
k4: $ G ⇒ x1 ∊ trees ω ∧ x2 ∊ trees ω ∧ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by lrel_args4 [#6, k3]
k5a: $ G ⇒ x2 ∊ trees ω ∧ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by and_elim_r [k4]
k5b: $ G ⇒ x3 ∊ trees ω ∧ x4 ∊ trees ω $ by and_elim_r [k5a]
k5c: $ G ⇒ x4 ∊ trees ω $ by and_elim_r [k5b]
k5: $ G ⇒ x4 ∈ trees ω $ by welc_wcel [k5c]
r1: $ G ⇒ w = w $ by eq_refl
r0: $ G ⇒ u = u $ by eq_refl
r00: $ G ⇒ M = M $ by eq_refl
v4: $ G ⇒ dt u M ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ w r = ap (dt u M x4 w r) (dt u M x5 w r) $ by dt_app [k5, k2, #8, #9]
v5: $ G ⇒ dt u M ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ w r2 = ap (dt u M x4 w r2) (dt u M x5 w r2) $ by dt_app [k5, k2, #8, #10]
v6: $ G ⇒ dt u M z w r = dt u M ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ w r $ by dt_eq [r0, r00, #5, r1, g2]
v7: $ G ⇒ dt u M z w r2 = dt u M ⟨ kc_app , scons x4 (scons x5 ∅) ⟩ w r2 $ by dt_eq [r0, r00, #5, r1, g3]
m1: $ G ⇒ ap (dt u M x4 w r) (dt u M x5 w r) ⊆ ap (dt u M x4 w r2) (dt u M x5 w r) $ by ap_mono [b7]
m2a: $ G ⇒ dt u M x4 w r2 = dt u M x4 w r2 $ by eq_refl
m2: $ G ⇒ ap (dt u M x4 w r2) (dt u M x5 w r) = ap (dt u M x4 w r2) (dt u M x5 w r2) $ by ap_eq [m2a, v1]
m3: $ G ⇒ ap (dt u M x4 w r) (dt u M x5 w r) ⊆ ap (dt u M x4 w r2) (dt u M x5 w r2) $ by subset_eq_r [m2, m1]
m4: $ G ⇒ dt u M z w r = ap (dt u M x4 w r) (dt u M x5 w r) $ by eq_trans [v6, v4]
m5: $ G ⇒ ap (dt u M x4 w r) (dt u M x5 w r) = dt u M z w r $ by eq_sym [m4]
m6: $ G ⇒ dt u M z w r ⊆ ap (dt u M x4 w r2) (dt u M x5 w r2) $ by subset_eq_l [m5, m3]
m7: $ G ⇒ dt u M z w r2 = ap (dt u M x4 w r2) (dt u M x5 w r2) $ by eq_trans [v7, v5]
m8: $ G ⇒ ap (dt u M x4 w r2) (dt u M x5 w r2) = dt u M z w r2 $ by eq_sym [m7]
m9: $ G ⇒ dt u M z w r ⊆ dt u M z w r2 $ by subset_eq_r [m8, m6]

lrel_iargs_mono
---------------
