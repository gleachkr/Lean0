xb16: $ G , ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $ by ex_elim [xb15, xb14]
xb17: $ G , ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) $ by ax
xb18: $ G , ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $ by ex_elim [xb17, xb16]
xb19: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) $ by ax
xb20: $ G , ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $ by ex_elim [xb19, xb18]
xb21: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) $ by ax
xb22: $ G , ∃ x1 ∃ x2 ∃ x3 ∃ x4 ∃ x7 ∃ x5 ∃ x8 ∃ x6 ∃ x9 ∃ x0 ∃ y (t1 = x1 ∧ t2 = x2 ∧ t3 = x3 ∧ t4 = x4 ∧ t5 = x5 ∧ t6 = x6 ∧ z = ⟨ kc_tcons , scons x9 (scons x0 (scons y ∅)) ⟩ ∧ ra_isort x9 x8 x7 ∈ lrel ∧ lveq x7 x4 ∧ ra_ctors_wf x1 x2 x3 x4 x5 x6 x0 ∈ lrel3 J ∧ ra_tys_wf x1 x2 x3 x4 ⟨ kc_s , scons x5 ∅ ⟩ x6 y ∈ lrel3 J) ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $ by ex_elim [xb21, xb20]
g1: $ G ⇒ ra_ctors_wf t1 t2 t3 t4 t5 t6 b ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons t5 ∅ ⟩ t6 c ∈ lrel3 J $ by or_elim [a1, xa12, xb22]

--| The type lists `y` whose type at `m`, for every derivable `tys_wf D N Q L s C y` from
--| `s`, has its constructors well formed at number `s + m`.
def i9_tq (D N Q L C J F E: class) (.y .m .d .i: set): class = $ {y | ∀ m ∀ d (ra_tys_wf D N Q L d C y ∈ lrel3 J → ra_nth_ty y m F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J))} $

lemma i9_tq_i {m d i: set} (G: hyps) (J D N Q L C F E: class) (y: set): $ G , ra_tys_wf D N Q L d C y ∈ lrel3 J , ra_nth_ty y m F E ∈ lrel , d ∊ trees ω ⇒ ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ > $ G ⇒ y ∊ i9_tq D N Q L C J F E $
----
l1: $ G , ra_tys_wf D N Q L d C y ∈ lrel3 J , ra_nth_ty y m F E ∈ lrel ⇒ d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by imp_intro [#1]
l2: $ G , ra_tys_wf D N Q L d C y ∈ lrel3 J ⇒ ra_nth_ty y m F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by imp_intro [l1]
l3: $ G ⇒ ra_tys_wf D N Q L d C y ∈ lrel3 J → ra_nth_ty y m F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by imp_intro [l2]
l4: $ G ⇒ ∀ d (ra_tys_wf D N Q L d C y ∈ lrel3 J → ra_nth_ty y m F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J)) $ by all_intro [l3]
l5: $ G ⇒ ∀ m ∀ d (ra_tys_wf D N Q L d C y ∈ lrel3 J → ra_nth_ty y m F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J)) $ by all_intro [l4]
l6: $ G ⇒ y ∊ i9_tq D N Q L C J F E $ by cab_intro [l5]

lemma i9_tq_e {i: set} (G: hyps i) (J D N Q L C F E: class) (y p q: set): $ G ⇒ y ∊ i9_tq D N Q L C J F E $ > $ G ⇒ ra_tys_wf D N Q L q C y ∈ lrel3 J $ > $ G ⇒ ra_nth_ty y p F E ∈ lrel $ > $ G ⇒ q ∊ trees ω $ > $ G ⇒ ∃ i (fv nvf i = nadd (fv nvf q) (fv nvf p) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $
----
l1: $ G ⇒ ∀ m ∀ d (ra_tys_wf D N Q L d C y ∈ lrel3 J → ra_nth_ty y m F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf m) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J)) $ by cab_elim [#1]
l2: $ G ⇒ ∀ d (ra_tys_wf D N Q L d C y ∈ lrel3 J → ra_nth_ty y p F E ∈ lrel → d ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf d) (fv nvf p) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J)) $ by all_elim [l1]
l3: $ G ⇒ ra_tys_wf D N Q L q C y ∈ lrel3 J → ra_nth_ty y p F E ∈ lrel → q ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf q) (fv nvf p) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by all_elim [l2]
l4: $ G ⇒ ra_nth_ty y p F E ∈ lrel → q ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf q) (fv nvf p) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by imp_elim [l3, #2]
l5: $ G ⇒ q ∊ trees ω → ∃ i (fv nvf i = nadd (fv nvf q) (fv nvf p) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by imp_elim [l4, #3]
l6: $ G ⇒ ∃ i (fv nvf i = nadd (fv nvf q) (fv nvf p) ∧ ra_ctors_wf D N Q L i C E ∈ lrel3 J) $ by imp_elim [l5, #4]

--| `lrel3_tys_wf_nth` at the first type.
lemma i9_tq_ca {i x1 x2 x3: set} (G: hyps) (J: class) (t1 t2 t3 t4 t6 s z m f e: set): $ G ⇒ ra_tys_wf t1 t2 t3 t4 s t6 z ∈ lrel3 J $ > $ G ⇒ (∃ x1 ∃ x2 ∃ x3 (z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2)) → ∃ i (fv nvf i = nadd (fv nvf s) (fv nvf m) ∧ ra_ctors_wf t1 t2 t3 t4 i t6 e ∈ lrel3 J) $
----
b0: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 $ by ax
b1: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ $ by and_elim_l [b0]
br1: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 $ by and_elim_r [b0]
b2: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ m = ⟨ kc_nz , ∅ ⟩ $ by and_elim_l [br1]
br2: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ f = x1 ∧ e = x2 $ by and_elim_r [br1]
b3: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ f = x1 $ by and_elim_l [br2]
b4: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ e = x2 $ by and_elim_r [br2]
c0: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ ra_tys_wf t1 t2 t3 t4 s t6 z ∈ lrel3 J $ by weaken [#1]
c1: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ ra_ctors_wf t1 t2 t3 t4 s t6 x2 ∈ lrel3 J ∧ ra_tys_wf t1 t2 t3 t4 ⟨ kc_s , scons s ∅ ⟩ t6 x3 ∈ lrel3 J $ by i9_tw_tc [c0, b1]
c2: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ ra_ctors_wf t1 t2 t3 t4 s t6 x2 ∈ lrel3 J $ by and_elim_l [c1]
c3: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ x2 = e $ by eq_sym [b4]
c3a: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ t1 = t1 $ by eq_refl
c3b: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ t2 = t2 $ by eq_refl
c3c: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ t3 = t3 $ by eq_refl
c3d: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ t4 = t4 $ by eq_refl
c3e: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ s = s $ by eq_refl
c3f: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ t6 = t6 $ by eq_refl
c4: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ ra_ctors_wf t1 t2 t3 t4 s t6 x2 = ra_ctors_wf t1 t2 t3 t4 s t6 e $ by ra_ctors_wf_eq [c3a, c3b, c3c, c3d, c3e, c3f, c3]
c5: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ ra_ctors_wf t1 t2 t3 t4 s t6 e ∈ lrel3 J $ by wcel_eq_l [c4, c2]
c6a: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ nvf = nvf $ by eq_refl
c6: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ fv nvf m = fv nvf ⟨ kc_nz , ∅ ⟩ $ by fv_eq [c6a, b2]
c7: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ fv nvf ⟨ kc_nz , ∅ ⟩ = ∅ $ by nvf_nz
c8: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ fv nvf m = ∅ $ by eq_trans [c6, c7]
c9a: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ fv nvf s = fv nvf s $ by eq_refl
c9: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ nadd (fv nvf s) (fv nvf m) = nadd (fv nvf s) ∅ $ by nadd_eq [c9a, c8]
c10a: $ G , z = ⟨ kc_tcons , scons x1 (scons x2 (scons x3 ∅)) ⟩ ∧ m = ⟨ kc_nz , ∅ ⟩ ∧ f = x1 ∧ e = x2 ⇒ functional nvf $ by nvf_functional
