swin_fseq
---------
l1: $ G ⇒ swin r D N = cres (cgr i (fv r (nadd D i))) N $ by i6_swin_cres
wl2_7: $ G , i ∊ N ⇒ uadm u $ by weaken [#1]
wl2_8: $ G , i ∊ N ⇒ r ∊ fseq u $ by weaken [#2]
l2: $ G , i ∊ N ⇒ fv r (nadd D i) ∈ u $ by i6_fvr [wl2_7, wl2_8]
l3: $ G ⇒ i ∊ N → fv r (nadd D i) ∈ u $ by imp_intro [l2]
l4: $ G ⇒ ∀ i (i ∊ N → fv r (nadd D i) ∈ u) $ by all_intro [l3]
l5: $ G ⇒ fn_into (cgr i (fv r (nadd D i))) N u $ by cgr_fn_into [l4]
l6: $ G ⇒ cres (cgr i (fv r (nadd D i))) N ∈ fseq u $ by cres_fseq [#3, l5]
l7: $ G ⇒ cres (cgr i (fv r (nadd D i))) N = swin r D N $ by eq_sym [l1]
l8: $ G ⇒ swin r D N ∈ fseq u $ by wcel_eq_l [l7, l6]

--| The class of all sets.
def i6_vv (.x: set): class = $ {x | x = x} $

lemma i6_vv_i (G: hyps) (A: class): $ G ⇒ isset A $ > $ G ⇒ A ∈ i6_vv $
----
l1: $ G , x = A ⇒ x = x $ by eq_refl
l2: $ G , x = A ⇒ x ∊ i6_vv $ by cab_intro [l1]
l3: $ G , x = A ⇒ x = A $ by ax
l4: $ G , x = A ⇒ A ∈ i6_vv $ by wcel_intro [l3, l2]
l5: $ G ⇒ A ∈ i6_vv $ by isset_elim [#1, l4]

lemma i6_tri_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $
----
l1: $ G ⇒ ∅ = ∅ $ by eq_refl
l2: $ G ⇒ ⟨ ∅ , A ⟩ = ⟨ ∅ , B ⟩ $ by opair_eq [l1, #1]
l3: $ G ⇒ ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ $ by opair_eq [l1, l2]
l4: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ by opair_eq [l1, l3]

lemma i6_tri_csn_eq (G: hyps) (A B: class): $ G ⇒ A = B $ > $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $
----
l1: $ G ⇒ ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ by i6_tri_eq [#1]
l2: $ G ⇒ csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , A ⟩ ⟩ ⟩ = csn ⟨ ∅ , ⟨ ∅ , ⟨ ∅ , B ⟩ ⟩ ⟩ $ by csn_eq [l1]

