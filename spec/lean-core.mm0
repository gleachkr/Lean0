delimiter $ ( ) . # $;

--| LeanTT: Lean 4's kernel as an MM0 theory, transcribed from Lean4Lean
--| (digama0/lean4lean @ 67f63b0: Theory/VLevel.lean, Theory/VExpr.lean,
--| Theory/Typing/Basic.lean), with the kernel's inductive types, quotients and
--| literals (notes/audit-lean-mm0.md §4 and §5).
--|
--| The spec is four files. This one is the core: levels, expressions,
--| contexts, and the judgment with its rules. `lean-ind.mm0` adds inductive
--| types (a schema over blocks as data), `lean-quot.mm0` the quotient
--| primitives (with Lean's `Eq`), and `lean-lit.mm0` Nat literals and the
--| accelerated operations (with Lean's `Nat`); each adds its expression
--| constructors with their clauses of the core's relations. `lean.mm0` imports
--| them all, and `lean0 spec` prints them as one text.
--|
--| Each file is in three parts. Part I, Syntax, declares the sorts (naturals,
--| levels, expressions, contexts, binary numerals, inductive blocks as data: all
--| closed first-order syntax, no sort admits bound variables) and relations on
--| them that are the graphs of functions, or predicates, on syntax, defined by
--| clauses that recurse on their inputs: lifting and substitution, the reading
--| of an inductive block, the recursor's type and rules, and so on. Nothing in
--| Part I mentions level equivalence or the judgment. Part II declares those
--| two relations, `≈` and `⊢`, and the relations defined over them in the same
--| way (the well-formedness of an inductive block, its elimination level, the
--| defining equations of the literal operations). Part III states the rules:
--| the axioms concluding `≈` and `⊢`, which are the theory, each argued in the
--| audit. `lean0 modes` checks mechanically that every relation of Parts I and
--| II is well-moded and that the clauses of each function are pairwise
--| exclusive (`mm0kit/src/modes.rs`), so that the two parts read as the
--| definition of the kernel's meta-operations and Part III as the rules over
--| them.
--|
--| Deviations from the verbatim presentation (see notes/audit-lean-mm0.md §10):
--| * There is no environment term and no `const` constructor. A Lean
--|   definition is an MM0 `def` returning `expr` whose arguments are its
--|   universe parameters (so δ is MM0 unfolding and `instL` is MM0
--|   substitution). An inductive block is a data term `ind_mk b P T N` (a
--|   generated `def X_D (us): ind`), and its types, constructors and recursors
--|   are `ind_ty D i`, `ind_ctor D i c` and `ind_rec D i v`, typed by the
--|   schema once the certificate proves the block legal (`ind_wf`).
--|   A nested block is the mutual block the kernel checks in its place,
--|   with the nested occurrences restored in what it states (`N` lists them).
--|   Axioms and opaques are atoms at their levels (`cst`), each with one
--|   generated axiom, its `constDF` instance.
--| * Universe parameters are MM0 variables of sort `lvl`, so the `l.WF U`
--|   side conditions are vacuous and are dropped.
--| * Meta-level operations (liftN, inst, Lookup) are syntax-directed
--|   relations, proved node by node.
--| * Nat literals are a primitive `lit` over binary numerals (an extension;
--|   Lean4Lean unfolds literals to `Nat.succ`/`Nat.zero`), tied to Lean's
--|   `Nat` by `lit_zero`/`lit_succ`. The accelerated operations are rules
--|   over the defining equations Lean4Lean checks (`add_eqs`, `nat_add_lit`,
--|   ...). For the operations Lean defines by fuel and well-founded
--|   recursion they are rules over proofs of characterizing equations
--|   instead (`divmod_eqs`, `gcd_eqs`, `land_eqs`, ...; a departure from
--|   Lean4Lean).
--| * Lean's `Nat` and `Eq` are the blocks `nat_D` and `eq_D` (data the
--|   checker compares with the export), and the quotient primitives are
--|   constants (`cst` of atoms of the spec, as are `propext`, `Quot.sound`
--|   and `Classical.choice`) with the kernel's types and reduction rule.
--| * Two admissible rules are axioms: `instDF` (substitution, Lean4Lean's
--|   theorem `IsDefEq.instN`), so that a substituted term's typing need not
--|   be derived again, and `weakDF` (weakening, `IsDefEq.weakN`), so that a
--|   derivation made in a shorter context can be used in a longer one.
--| * `eeqv_df`: expressions of the same shape at equivalent levels are
--|   definitionally equal (generalizing `sortDF` and `constDF`).
--|
--| Notations: `⟦ Γ ⊢ e ≡ e2 : A ⟧` for the judgment and `⟨ Γ ⊢ e : A ⟩` for typing,
--| `λ A. e`, `Π A. B`, `f @ a`, `#i` for a bound variable, `Γ ▷ A` and `[]`
--| for contexts (`Γ ▷ A` is the definition `snoc`, `A :: Γ`; the other lists
--| are written with `::`), `a ⊔ b` for `max`, `≤`, `<` and `≈` (level equivalence), the
--| numerals `0` to `9` (`nz` and the definitions `n1` to `n9`), `Sort u` for
--| `srt u`, `Prop` for `Sort lz`, and `ℕ` for `nat_ty`. The arithmetic relations
--| are written as equations in brackets, one opening bracket per relation:
--| `⦃ i + n = j ⦄` for `add i n j` on the unary numerals, and on the binary ones
--| `⟪ a + b = c ⟫` (`badd`), `⟪₁ a + b + 1 = c ⟫` (`baddc`), `⟪ₛ a + 1 = b ⟫`
--| (`bsucc`), `⟪₂ 2 * a = b ⟫` (`bdbl`), `⟪ₘ a * b = c ⟫` (`bmul`),
--| `⟪ₚ a ^ b = c ⟫` (`bpow`), and `⟪ₐ a &&& b = c ⟫`, `⟪ₒ a ||| b = c ⟫`,
--| `⟪ₓ a ^^^ b = c ⟫` (`band`, `bor`, `bxor`). Likewise substitution, lifting
--| and lookup: `⟮ e [ #k ↦ a ] = e2 ⟯` (`inst k e a e2`), `⟮ₗ e [ #k ↑ n ] = e2 ⟯`
--| (`lift n k e e2`), `⟮ₖ G ∋ #k : A ⟯` (`lookup G k A`), and at levels
--| `⟮ᵤ l [ n ↦ a ] = l2 ⟯` (`lsubst n l a l2`). The Unicode ones have an ASCII form
--| too (`[[ G |- e == e2 : A ]]`, `<< G |- e : A >>`, `\ A. e`, `\Pi A. B`, `\/`,
--| `<=`, `~=`, `{| i + n = j |}`, and `{+| .. |}`, `{+1| .. |}`, `{s| .. |}`,
--| `{2| .. |}`, `{*| .. |}`, `{^| .. |}`, `{and| .. |}`, `{or| .. |}`,
--| `{xor| .. |}`, `{:=| e [ #k := a ] = e2 |}`, `{up| e [ #k ^ n ] = e2 |}`,
--| `{at| G !! #k : A |}`, `{u:=| l [ n := a ] = l2 |}`), declared first; the Unicode one is declared last, the form
--| Aufbau prints. A term with a notation can still be written as an application
--| (`deq G e e2 A`), as the generated statements are.
--|
--| @hole _wff
strict provable sort wff;

---------------------------------------------------------------------------
-- PART I: SYNTAX
-- Every relation here is the graph of a function (its mode, which arguments are
-- inputs, is in `mm0kit/src/modes.rs`) or a predicate on syntax, defined by
-- clauses that recurse on their inputs; nothing mentions `≈` or `⊢`.
---------------------------------------------------------------------------

-- Unary naturals (de Bruijn indices) ---------------------------------------

--| @hole _n
strict free sort nat;
term nz: nat;
term s: nat > nat;

-- The numerals `0` to `9`: `0` is `nz`, and `n1` to `n9` are the definitions
-- `s 0` to `s 8`. Larger numbers are written with `s`.
prefix nz: $0$ prec max;
def n1: nat = $ s 0 $; prefix n1: $1$ prec max;
def n2: nat = $ s 1 $; prefix n2: $2$ prec max;
def n3: nat = $ s 2 $; prefix n3: $3$ prec max;
def n4: nat = $ s 3 $; prefix n4: $4$ prec max;
def n5: nat = $ s 4 $; prefix n5: $5$ prec max;
def n6: nat = $ s 5 $; prefix n6: $6$ prec max;
def n7: nat = $ s 6 $; prefix n7: $7$ prec max;
def n8: nat = $ s 7 $; prefix n8: $8$ prec max;
def n9: nat = $ s 8 $; prefix n9: $9$ prec max;

--| `le i n`: i ≤ n.
term le: nat > nat > wff;
infixl le: $<=$ prec 50;
infixl le: $≤$ prec 50;
axiom le_z (n: nat): $ 0 ≤ n $;
axiom le_s (i n: nat): $ i ≤ n $ > $ s i ≤ s n $;

--| `lt i n`: i < n.
def lt (i n: nat): wff = $ s i ≤ n $;
infixl lt: $<$ prec 50;

--| `add i n j`: i + n = j.
term add: nat > nat > nat > wff;
notation add (i n j: nat): wff = (${|$:0) i ($+$:0) n ($=$:0) j ($|}$:0);
notation add (i n j: nat): wff = ($⦃$:0) i ($+$:0) n ($=$:0) j ($⦄$:0);
axiom add_z (i: nat): $ ⦃ i + 0 = i ⦄ $;
axiom add_s (i n j: nat): $ ⦃ i + n = j ⦄ $ > $ ⦃ i + s n = s j ⦄ $;

-- Universe levels (VLevel.lean:8-13) ---------------------------------------

--| @hole _l
strict free sort lvl;
term lz: lvl;
term ls: lvl > lvl;
term lmax: lvl > lvl > lvl;
infixl lmax: $\/$ prec 65;
infixl lmax: $⊔$ prec 65;
term limax: lvl > lvl > lvl;

--| `lparam i`: an object-level level parameter, for the case split
--| `leqv_cases` (Part III); it only ever occurs inside `leqv` proofs.
term lparam: nat > lvl;

--| Lists of levels.
--| @hole _ls
strict free sort lvls;
term lnil: lvls;
term lcons: lvl > lvls > lvls;

--| `lnth S n a`: the `n`th element of `S` is `a`.
term lnth: lvls > nat > lvl > wff;
axiom lnth_z (a: lvl) (S: lvls): $ lnth (lcons a S) 0 a $;
axiom lnth_s (a b: lvl) (S: lvls) (n: nat): $ lnth S n b $ > $ lnth (lcons a S) (s n) b $;

--| `linst S l l2`: `l2` is `l` with each `lparam i` replaced by the `i`th
--| element of `S`.
term linst: lvls > lvl > lvl > wff;
axiom linst_z (S: lvls): $ linst S lz lz $;
axiom linst_s (S: lvls) (a a2: lvl): $ linst S a a2 $ > $ linst S (ls a) (ls a2) $;
axiom linst_max (S: lvls) (a b a2 b2: lvl):
  $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (a ⊔ b) (a2 ⊔ b2) $;
axiom linst_imax (S: lvls) (a b a2 b2: lvl):
  $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (limax a b) (limax a2 b2) $;
axiom linst_param (S: lvls) (n: nat) (a: lvl): $ lnth S n a $ > $ linst S (lparam n) a $;

--| `⟮ᵤ l [ n ↦ a ] = l2 ⟯` (`lsubst n l a l2`): `l2` is `l` with `lparam n`
--| replaced by `a`.
term lsubst: nat > lvl > lvl > lvl > wff;
notation lsubst (n: nat) (l a l2: lvl): wff = (${u:=|$:0) l ($[$:0) n ($:=$:0) a ($]$:0) ($=$:0) l2 ($|}$:0);
notation lsubst (n: nat) (l a l2: lvl): wff = ($⟮ᵤ$:0) l ($[$:0) n ($↦$:0) a ($]$:0) ($=$:0) l2 ($⟯$:0);
axiom lsubst_z (n: nat) (a: lvl): $ ⟮ᵤ lz [ n ↦ a ] = lz ⟯ $;
axiom lsubst_s (n: nat) (b a b2: lvl): $ ⟮ᵤ b [ n ↦ a ] = b2 ⟯ $ > $ ⟮ᵤ ls b [ n ↦ a ] = ls b2 ⟯ $;
axiom lsubst_max (n: nat) (b c a b2 c2: lvl):
  $ ⟮ᵤ b [ n ↦ a ] = b2 ⟯ $ > $ ⟮ᵤ c [ n ↦ a ] = c2 ⟯ $ > $ ⟮ᵤ b ⊔ c [ n ↦ a ] = b2 ⊔ c2 ⟯ $;
axiom lsubst_imax (n: nat) (b c a b2 c2: lvl):
  $ ⟮ᵤ b [ n ↦ a ] = b2 ⟯ $ > $ ⟮ᵤ c [ n ↦ a ] = c2 ⟯ $ > $ ⟮ᵤ limax b c [ n ↦ a ] = limax b2 c2 ⟯ $;
axiom lsubst_eq (n: nat) (a: lvl): $ ⟮ᵤ lparam n [ n ↦ a ] = a ⟯ $;
axiom lsubst_lt (n m: nat) (a: lvl): $ m < n $ > $ ⟮ᵤ lparam m [ n ↦ a ] = lparam m ⟯ $;
axiom lsubst_gt (n m: nat) (a: lvl): $ n < m $ > $ ⟮ᵤ lparam m [ n ↦ a ] = lparam m ⟯ $;

-- Expressions (VExpr.lean:7-13), without `const` ---------------------------

--| @hole _e
strict free sort expr;
term bvar: nat > expr;
prefix bvar: $#$ prec max;
term srt: lvl > expr;
prefix srt: $Sort$ prec max;
--| The sort of propositions.
def Prop: expr = $ Sort lz $;
term app: expr > expr > expr;
infixl app: $@$ prec 1000;
term lam: expr > expr > expr;
notation lam (A e: expr): expr = ($\$:20) A ($.$:0) e;
notation lam (A e: expr): expr = ($λ$:20) A ($.$:0) e;
--| `forallE` in Lean4Lean.
term pi: expr > expr > expr;
notation pi (A B: expr): expr = ($\Pi$:20) A ($.$:0) B;
notation pi (A B: expr): expr = ($Π$:20) A ($.$:0) B;
--| An opaque constant (a Lean axiom, an opaque definition, a constant left to
--| the generated axioms): an atom, which a certificate declares as
--| `term X_atom: atom` and uses in exactly one definition
--| `def X (us): expr = $ cst X_atom (lcons u1 ... lnil) $`, at its universe
--| levels. Nothing in the spec tells two atoms apart; that each constant has
--| its own is checked by `lean0 check` (audit §8).
strict free sort atom;
term cst: atom > lvls > expr;

--| `closed k e`: every loose bound variable of `e` is below `k`
--| (`ClosedN e k`, VExpr.lean:99-104).
term closed: nat > expr > wff;
axiom closed_bvar (i k: nat): $ i < k $ > $ closed k #i $;
axiom closed_srt (k: nat) (l: lvl): $ closed k (Sort l) $;
axiom closed_app (k: nat) (f a: expr):
  $ closed k f $ > $ closed k a $ > $ closed k (f @ a) $;
axiom closed_lam (k: nat) (A b: expr):
  $ closed k A $ > $ closed (s k) b $ > $ closed k (λ A. b) $;
axiom closed_pi (k: nat) (A b: expr):
  $ closed k A $ > $ closed (s k) b $ > $ closed k (Π A. b) $;
axiom closed_cst (k: nat) (a: atom) (S: lvls): $ closed k (cst a S) $;

--| `⟮ₗ e [ #k ↑ n ] = e2 ⟯` (`lift n k e e2`): `e2` is `e` with the variables
--| from `#k` up raised by `n`; those below the cutoff `k` are bound inside
--| `e` and stay (`e2 = liftN n e k`, VExpr.lean:17, 38-44).
term lift: nat > nat > expr > expr > wff;
notation lift (n k: nat) (e e2: expr): wff = (${up|$:0) e ($[$:0) ($#$:max) k ($^$:0) n ($]$:0) ($=$:0) e2 ($|}$:0);
notation lift (n k: nat) (e e2: expr): wff = ($⟮ₗ$:0) e ($[$:0) ($#$:max) k ($↑$:0) n ($]$:0) ($=$:0) e2 ($⟯$:0);
--| `⟮₀ e ↑ n = e2 ⟯` (`lift0 n e e2`): the lift at the cutoff `0`, which raises
--| every free variable of `e` by `n`.
def lift0 (n: nat) (e e2: expr): wff = $ ⟮ₗ e [ #0 ↑ n ] = e2 ⟯ $;
notation lift0 (n: nat) (e e2: expr): wff = (${up0|$:0) e ($^$:0) n ($=$:0) e2 ($|}$:0);
notation lift0 (n: nat) (e e2: expr): wff = ($⟮₀$:0) e ($↑$:0) n ($=$:0) e2 ($⟯$:0);
axiom lift_bvar_lt (n k i: nat): $ i < k $ > $ ⟮ₗ #i [ #k ↑ n ] = #i ⟯ $;
axiom lift_bvar_ge (n k i j: nat):
  $ k ≤ i $ > $ ⦃ i + n = j ⦄ $ > $ ⟮ₗ #i [ #k ↑ n ] = #j ⟯ $;
axiom lift_srt (n k: nat) (l: lvl): $ ⟮ₗ Sort l [ #k ↑ n ] = Sort l ⟯ $;
axiom lift_app (n k: nat) (f a f2 a2: expr):
  $ ⟮ₗ f [ #k ↑ n ] = f2 ⟯ $ > $ ⟮ₗ a [ #k ↑ n ] = a2 ⟯ $ > $ ⟮ₗ f @ a [ #k ↑ n ] = f2 @ a2 ⟯ $;
axiom lift_lam (n k: nat) (A b A2 b2: expr):
  $ ⟮ₗ A [ #k ↑ n ] = A2 ⟯ $ > $ ⟮ₗ b [ #(s k) ↑ n ] = b2 ⟯ $ > $ ⟮ₗ λ A. b [ #k ↑ n ] = λ A2. b2 ⟯ $;
axiom lift_pi (n k: nat) (A b A2 b2: expr):
  $ ⟮ₗ A [ #k ↑ n ] = A2 ⟯ $ > $ ⟮ₗ b [ #(s k) ↑ n ] = b2 ⟯ $ > $ ⟮ₗ Π A. b [ #k ↑ n ] = Π A2. b2 ⟯ $;
--| Admissible (by induction on `e`): `ClosedN.liftN_eq`, VExpr.lean:117.
axiom lift_closed (n j k: nat) (e: expr):
  $ closed j e $ > $ j ≤ k $ > $ ⟮ₗ e [ #k ↑ n ] = e ⟯ $;

--| `⟮ e [ #k ↦ a ] = e2 ⟯` (`inst k e a e2`): `e2` is `e` with `a` for the
--| variable `#k`, and the variables above it lowered by one
--| (`e2 = inst e a k`, VExpr.lean:187-188, 240-246).
term inst: nat > expr > expr > expr > wff;
notation inst (k: nat) (e a e2: expr): wff = (${:=|$:0) e ($[$:0) ($#$:max) k ($:=$:0) a ($]$:0) ($=$:0) e2 ($|}$:0);
notation inst (k: nat) (e a e2: expr): wff = ($⟮$:0) e ($[$:0) ($#$:max) k ($↦$:0) a ($]$:0) ($=$:0) e2 ($⟯$:0);
axiom inst_bvar_lt (k i: nat) (a: expr): $ i < k $ > $ ⟮ #i [ #k ↦ a ] = #i ⟯ $;
axiom inst_bvar_eq (k: nat) (a a2: expr): $ ⟮₀ a ↑ k = a2 ⟯ $ > $ ⟮ #k [ #k ↦ a ] = a2 ⟯ $;
axiom inst_bvar_gt (k i: nat) (a: expr):
  $ k ≤ i $ > $ ⟮ #(s i) [ #k ↦ a ] = #i ⟯ $;
axiom inst_srt (k: nat) (l: lvl) (a: expr): $ ⟮ Sort l [ #k ↦ a ] = Sort l ⟯ $;
axiom inst_app (k: nat) (f x a f2 x2: expr):
  $ ⟮ f [ #k ↦ a ] = f2 ⟯ $ > $ ⟮ x [ #k ↦ a ] = x2 ⟯ $ > $ ⟮ f @ x [ #k ↦ a ] = f2 @ x2 ⟯ $;
axiom inst_lam (k: nat) (A b a A2 b2: expr):
  $ ⟮ A [ #k ↦ a ] = A2 ⟯ $ > $ ⟮ b [ #(s k) ↦ a ] = b2 ⟯ $ > $ ⟮ λ A. b [ #k ↦ a ] = λ A2. b2 ⟯ $;
axiom inst_pi (k: nat) (A b a A2 b2: expr):
  $ ⟮ A [ #k ↦ a ] = A2 ⟯ $ > $ ⟮ b [ #(s k) ↦ a ] = b2 ⟯ $ > $ ⟮ Π A. b [ #k ↦ a ] = Π A2. b2 ⟯ $;
--| Admissible (by induction on `e`): `ClosedN.instN_eq`, VExpr.lean:482.
axiom inst_closed (j k: nat) (e a: expr):
  $ closed j e $ > $ j ≤ k $ > $ ⟮ e [ #k ↦ a ] = e ⟯ $;

-- Contexts (Typing/Basic.lean:6-8) -----------------------------------------

--| Innermost binder first; each entry is a type relative to the tail.
--| @hole _G
strict free sort ctx;
term nil: ctx;
prefix nil: $[]$ prec max;
term cons: expr > ctx > ctx;
infixr cons: $::$ prec 60;
--| `G ▷ A` (`snoc G A`) is `A :: G`: the context `G` extended by a variable of
--| type `A`. A context is written with `▷`, outermost variable first, so that
--| each type stands to the right of the variables it mentions; `#0` is the
--| last entry.
def snoc (G: ctx) (A: expr): ctx = $ A :: G $;
infixl snoc: $|>$ prec 62;
infixl snoc: $▷$ prec 62;

--| `⟮ₖ G ∋ #k : A ⟯` (`lookup G k A`): the variable `#k` of `G` has type `A`,
--| its entry lifted over the entries up to it.
term lookup: ctx > nat > expr > wff;
notation lookup (G: ctx) (k: nat) (A: expr): wff = (${at|$:0) G ($!!$:0) ($#$:max) k ($:$:0) A ($|}$:0);
notation lookup (G: ctx) (k: nat) (A: expr): wff = ($⟮ₖ$:0) G ($∋$:0) ($#$:max) k ($:$:0) A ($⟯$:0);
axiom lookup_z (A A2: expr) (G: ctx):
  $ ⟮₀ A ↑ 1 = A2 ⟯ $ > $ ⟮ₖ G ▷ A ∋ #0 : A2 ⟯ $;
axiom lookup_s (A B B2: expr) (G: ctx) (n: nat):
  $ ⟮ₖ G ∋ #n : B ⟯ $ > $ ⟮₀ B ↑ 1 = B2 ⟯ $ > $ ⟮ₖ G ▷ A ∋ #(s n) : B2 ⟯ $;

--| `cinst k G0 A0 a G1 G`: `G1` is `G0` extended by `A0` and then `k` more
--| entries, and `G` is `G1` without `A0`, with `a` substituted for it in the
--| `k` entries above it (`Ctx.InstN`, Typing/Lemmas.lean:86).
term cinst: nat > ctx > expr > expr > ctx > ctx > wff;
axiom cinst_z (G0: ctx) (A0 a: expr): $ cinst 0 G0 A0 a (G0 ▷ A0) G0 $;
axiom cinst_s (k: nat) (G0 G1 G: ctx) (A0 a A A2: expr):
  $ cinst k G0 A0 a G1 G $ > $ ⟮ A [ #k ↦ a ] = A2 ⟯ $ >
  $ cinst (s k) G0 A0 a (G1 ▷ A) (G ▷ A2) $;

--| `cext n G G2`: `G2` is `G` extended by `n` more entries
--| (`Ctx.LiftN n 0 G G2`, the `zero` case, Typing/Lemmas.lean:9).
term cext: nat > ctx > ctx > wff;
axiom cext_z (G: ctx): $ cext 0 G G $;
axiom cext_s (n: nat) (G G2: ctx) (A: expr):
  $ cext n G G2 $ > $ cext (s n) G (G2 ▷ A) $;

--| Contexts as lists: `clen G n` is the length, `cnth G n A` entry `n` as
--| written (`lookup` lifts it), `capp P G G2` the concatenation `P ++ G`.
term clen: ctx > nat > wff;
axiom clen_nil: $ clen [] 0 $;
axiom clen_cons (A: expr) (G: ctx) (n: nat): $ clen G n $ > $ clen (G ▷ A) (s n) $;
term cnth: ctx > nat > expr > wff;
axiom cnth_z (A: expr) (G: ctx): $ cnth (G ▷ A) 0 A $;
axiom cnth_s (A B: expr) (G: ctx) (n: nat): $ cnth G n B $ > $ cnth (G ▷ A) (s n) B $;
term capp: ctx > ctx > ctx > wff;
axiom capp_nil (G: ctx): $ capp [] G G $;
axiom capp_cons (A: expr) (P G G2: ctx): $ capp P G G2 $ > $ capp (P ▷ A) G (G2 ▷ A) $;

---------------------------------------------------------------------------
-- PART II: DEFINITIONS OVER LEVEL EQUIVALENCE AND THE JUDGMENT
-- The relations `≈` and `⊢` (their axioms are Part III), and the predicates
-- defined over them by clauses as in Part I: a typing or equivalence premise
-- is a side condition of the clause.
---------------------------------------------------------------------------

-- Level equivalence (VLevel.lean:58) ---------------------------------------

--| `leqv l l2`: `l ≈ l2`, semantic equivalence of levels (VLevel.lean:58:
--| equal evaluation under every assignment of the level variables, including
--| the `lparam`s). Its axioms are in Part III.
term leqv: lvl > lvl > wff;
infixl leqv: $~=$ prec 50;
infixl leqv: $≈$ prec 50;

--| `ulevel l s`: a field in `srt s` may belong to a type in `srt l`: the type
--| is a proposition, or `s ≤ l`.
term ulevel: lvl > lvl > wff;
axiom ulevel_prop (l u: lvl): $ l ≈ lz $ > $ ulevel l u $;
axiom ulevel_le (l u: lvl): $ l ⊔ u ≈ l $ > $ ulevel l u $;

-- The judgment `Γ ⊢ e ≡ e2 : A` (IsDefEq, Typing/Basic.lean:18-56) ---------

--| The judgment `Γ ⊢ e ≡ e2 : A` (IsDefEq, Typing/Basic.lean:18-56). Its
--| rules are in Part III.
term deq: ctx > expr > expr > expr > wff;
notation deq (G: ctx) (e e2 A: expr): wff = ($[[$:0) G ($|-$:0) e ($==$:0) e2 ($:$:0) A ($]]$:0);
notation deq (G: ctx) (e e2 A: expr): wff = ($⟦$:0) G ($⊢$:0) e ($≡$:0) e2 ($:$:0) A ($⟧$:0);

--| `Γ ⊢ e : A` is the diagonal of the judgment.
def ty (G: ctx) (e A: expr): wff = $ ⟦ G ⊢ e ≡ e : A ⟧ $;
notation ty (G: ctx) (e A: expr): wff = ($<<$:0) G ($|-$:0) e ($:$:0) A ($>>$:0);
notation ty (G: ctx) (e A: expr): wff = ($⟨$:0) G ($⊢$:0) e ($:$:0) A ($⟩$:0);

-- Typed application spines -------------------------------------------------

--| `sty G h A e T`: `e` is the head `h` applied to arguments, each typed at
--| its binder's type in the telescope `A` (instantiated with the arguments
--| before it, with no conversion between the steps), and `T` is what is left
--| of `A` after the last one. The inductive schema types a constructor's
--| result and a nested occurrence this way (`cwf`, `nst_ty`), rather than as
--| a whole: that the arguments are in the head's domain is then stated, not
--| read off a derivation by inversion (audit §4).
term sty: ctx > expr > expr > expr > expr > wff;
axiom sty_nil (G: ctx) (h A: expr): $ sty G h A h A $;
axiom sty_app (G: ctx) (h A f a B C C2: expr):
  $ sty G h A f (Π B. C) $ > $ ⟨ G ⊢ a : B ⟩ $ > $ ⟮ C [ #0 ↦ a ] = C2 ⟯ $ > $ sty G h A (f @ a) C2 $;

-- Level equivalence of expressions -----------------------------------------

--| `eeqv e e2`: `e` and `e2` agree except at levels, which are equivalent.
--| Two such expressions denote the same thing, so `e ≡ e2` (`eeqv_df`, Part
--| III). `eeqv_refl` covers every identical subterm (an opaque constant at the
--| same levels among them).
term eeqv: expr > expr > wff;
axiom eeqv_refl (e: expr): $ eeqv e e $;
term ceqv: ctx > ctx > wff;
axiom eeqv_bvar (i: nat): $ eeqv #i #i $;
axiom eeqv_srt (l l2: lvl): $ l ≈ l2 $ > $ eeqv (Sort l) (Sort l2) $;
axiom eeqv_app (f a f2 a2: expr): $ eeqv f f2 $ > $ eeqv a a2 $ > $ eeqv (f @ a) (f2 @ a2) $;
axiom eeqv_lam (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (λ A. b) (λ A2. b2) $;
axiom eeqv_pi (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (Π A. b) (Π A2. b2) $;
--| `lseqv S S2`: the level lists are equivalent entry by entry.
term lseqv: lvls > lvls > wff;
axiom lseqv_nil: $ lseqv lnil lnil $;
axiom lseqv_cons (l l2: lvl) (S S2: lvls): $ l ≈ l2 $ > $ lseqv S S2 $ > $ lseqv (lcons l S) (lcons l2 S2) $;
axiom eeqv_cst (a: atom) (S S2: lvls): $ lseqv S S2 $ > $ eeqv (cst a S) (cst a S2) $;
axiom ceqv_nil: $ ceqv [] [] $;
axiom ceqv_cons (A A2: expr) (G G2: ctx): $ eeqv A A2 $ > $ ceqv G G2 $ > $ ceqv (G ▷ A) (G2 ▷ A2) $;

---------------------------------------------------------------------------
-- PART III: THE RULES
-- The axioms concluding `≈` and `⊢`: the theory. Each is argued in
-- notes/audit-lean-mm0.md (§2 for the core, §6 for the admissible rules; §4
-- for inductive types and quotients and §5 for literals, in their files).
---------------------------------------------------------------------------

-- Level equivalence (VLevel.lean:58) ---------------------------------------
-- Each axiom is valid under `VLevel.eval`, where `imax a b = if b = 0 then 0
-- else max a b`. These axioms alone are incomplete (notes/audit-lean-mm0.md
-- §3); `leqv_cases` completes them. A case split must substitute the
-- parameter inside an arbitrary level, which cannot be stated over MM0
-- variables, so a goal's variables are first abstracted to object-level
-- parameters `lparam i` (`leqv_inst` puts the original levels back), and
-- `leqv_cases` splits on one of those. The semantics of `leqv` (equal value
-- under every assignment) covers `lparam`s like any other level variable, and
-- with the axioms for the `imax`-free cases this decides `leqv` completely
-- (notes/audit-lean-mm0.md §4).

axiom leqv_refl (a: lvl): $ a ≈ a $;
axiom leqv_symm (a b: lvl): $ a ≈ b $ > $ b ≈ a $;
axiom leqv_trans (a b c: lvl): $ a ≈ b $ > $ b ≈ c $ > $ a ≈ c $;
axiom leqv_succ (a b: lvl): $ a ≈ b $ > $ ls a ≈ ls b $;
axiom leqv_max (a b c d: lvl):
  $ a ≈ b $ > $ c ≈ d $ > $ a ⊔ c ≈ b ⊔ d $;
axiom leqv_imax (a b c d: lvl):
  $ a ≈ b $ > $ c ≈ d $ > $ limax a c ≈ limax b d $;
axiom lmax_comm (a b: lvl): $ a ⊔ b ≈ b ⊔ a $;
axiom lmax_assoc (a b c: lvl): $ a ⊔ b ⊔ c ≈ a ⊔ (b ⊔ c) $;
axiom lmax_idem (a: lvl): $ a ⊔ a ≈ a $;
axiom lmax_zero (a: lvl): $ lz ⊔ a ≈ a $;
axiom lmax_succ (a b: lvl): $ ls a ⊔ ls b ≈ ls (a ⊔ b) $;
axiom lmax_succ_self (a: lvl): $ a ⊔ ls a ≈ ls a $;
axiom limax_zero (a: lvl): $ limax a lz ≈ lz $;
axiom limax_zero_l (a: lvl): $ limax lz a ≈ a $;
--| `imax 1 a = a`: if `a = 0` both are 0, otherwise `max 1 a = a`. nanoda's level `simplify`
--| applies it (and `limax_zero_l`) whenever it puts a `Sort` in weak head normal form.
axiom limax_one (a: lvl): $ limax (ls lz) a ≈ a $;
--| `imax a (b+1) = max a (b+1)`: the second argument is not zero.
axiom limax_succ (a b: lvl): $ limax a (ls b) ≈ a ⊔ ls b $;
axiom limax_self (a: lvl): $ limax a a ≈ a $;
--| `imax a (max b c) = max (imax a b) (imax a c)`: `max b c` is zero only
--| when `b` and `c` are.
axiom limax_max (a b c: lvl):
  $ limax a (b ⊔ c) ≈ limax a b ⊔ limax a c $;
--| `imax a (imax b c) = max (imax a c) (imax b c)`: both sides are zero when
--| `c` is, and `max a (max b c)` otherwise.
axiom limax_imax (a b c: lvl):
  $ limax a (limax b c) ≈ limax a c ⊔ limax b c $;

--| Case split on `lparam n`: zero, or the successor of some level (which is
--| again called `lparam n`).
axiom leqv_cases (n: nat) (l r l0 r0 l1 r1: lvl):
  $ ⟮ᵤ l [ n ↦ lz ] = l0 ⟯ $ > $ ⟮ᵤ r [ n ↦ lz ] = r0 ⟯ $ > $ l0 ≈ r0 $ >
  $ ⟮ᵤ l [ n ↦ ls (lparam n) ] = l1 ⟯ $ > $ ⟮ᵤ r [ n ↦ ls (lparam n) ] = r1 ⟯ $ > $ l1 ≈ r1 $ >
  $ l ≈ r $;
--| Instantiating the parameters of an equivalence.
axiom leqv_inst (S: lvls) (l r l2 r2: lvl):
  $ l ≈ r $ > $ linst S l l2 $ > $ linst S r r2 $ > $ l2 ≈ r2 $;

-- The judgment (IsDefEq, Typing/Basic.lean:18-56) --------------------------

--| A variable has the type its context gives it.
axiom bvar (G: ctx) (i: nat) (A: expr):
  $ ⟮ₖ G ∋ #i : A ⟯ $ > $ ⟨ G ⊢ #i : A ⟩ $;
axiom symm (G: ctx) (e e2 A: expr):
  $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e2 ≡ e : A ⟧ $;
axiom trans (G: ctx) (e1 e2 e3 A: expr):
  $ ⟦ G ⊢ e1 ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e2 ≡ e3 : A ⟧ $ > $ ⟦ G ⊢ e1 ≡ e3 : A ⟧ $;
--| `Sort l ≡ Sort l2 : Sort (l+1)` for equivalent levels `l`, `l2`.
axiom sortDF (G: ctx) (l l2: lvl):
  $ l ≈ l2 $ > $ ⟦ G ⊢ Sort l ≡ Sort l2 : Sort (ls l) ⟧ $;
--| `f a ≡ f2 a2 : B[a]` from `f ≡ f2 : (x : A) → B` and `a ≡ a2 : A`.
axiom appDF (G: ctx) (f f2 A B a a2 R: expr):
  $ ⟦ G ⊢ f ≡ f2 : Π A. B ⟧ $ > $ ⟦ G ⊢ a ≡ a2 : A ⟧ $ > $ ⟮ B [ #0 ↦ a ] = R ⟯ $ >
  $ ⟦ G ⊢ f @ a ≡ f2 @ a2 : R ⟧ $;
--| `(fun x : A => b) ≡ (fun x : A2 => b2) : (x : A) → B` from
--| `A ≡ A2 : Sort u` and, with `x : A`, `b ≡ b2 : B`.
axiom lamDF (G: ctx) (u: lvl) (A A2 b b2 B: expr):
  $ ⟦ G ⊢ A ≡ A2 : Sort u ⟧ $ > $ ⟦ G ▷ A ⊢ b ≡ b2 : B ⟧ $ >
  $ ⟦ G ⊢ λ A. b ≡ λ A2. b2 : Π A. B ⟧ $;
--| `((x : A) → B) ≡ ((x : A2) → B2) : Sort (imax u v)` from
--| `A ≡ A2 : Sort u` and, with `x : A`, `B ≡ B2 : Sort v`.
axiom forallEDF (G: ctx) (u v: lvl) (A A2 B B2: expr):
  $ ⟦ G ⊢ A ≡ A2 : Sort u ⟧ $ > $ ⟦ G ▷ A ⊢ B ≡ B2 : Sort v ⟧ $ >
  $ ⟦ G ⊢ Π A. B ≡ Π A2. B2 : Sort (limax u v) ⟧ $;
--| Conversion: `e ≡ e2 : B` from `e ≡ e2 : A` and `A ≡ B : Sort u`.
axiom defeqDF (G: ctx) (u: lvl) (A B e e2: expr):
  $ ⟦ G ⊢ A ≡ B : Sort u ⟧ $ > $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e ≡ e2 : B ⟧ $;
--| Beta: `(fun x : A => e) a ≡ e[a] : B[a]`, for `e : B` with `x : A`, and
--| `a : A`.
axiom beta (G: ctx) (A e B a r R: expr):
  $ ⟨ G ▷ A ⊢ e : B ⟩ $ > $ ⟨ G ⊢ a : A ⟩ $ > $ ⟮ e [ #0 ↦ a ] = r ⟯ $ > $ ⟮ B [ #0 ↦ a ] = R ⟯ $ >
  $ ⟦ G ⊢ (λ A. e) @ a ≡ r : R ⟧ $;
--| Eta: `(fun x : A => e x) ≡ e : (x : A) → B`, for `e : (x : A) → B`.
axiom eta (G: ctx) (A B e e1: expr):
  $ ⟨ G ⊢ e : Π A. B ⟩ $ > $ ⟮₀ e ↑ 1 = e1 ⟯ $ >
  $ ⟦ G ⊢ λ A. e1 @ #0 ≡ e : Π A. B ⟧ $;
--| Proof irrelevance: `h ≡ h2 : p` for two proofs of a proposition `p`.
axiom proofIrrel (G: ctx) (p h h2: expr):
  $ ⟨ G ⊢ p : Prop ⟩ $ > $ ⟨ G ⊢ h : p ⟩ $ > $ ⟨ G ⊢ h2 : p ⟩ $ >
  $ ⟦ G ⊢ h ≡ h2 : p ⟧ $;

-- Admissible rules (theorems of Lean4Lean, here axioms) --------------------

--| Substitution: `IsDefEq.instN`, Typing/Lemmas.lean:634 (see
--| notes/audit-lean-mm0.md §6).
axiom instDF (k: nat) (G0 G1 G: ctx) (A0 a e e2 A r r2 R: expr):
  $ ⟨ G0 ⊢ a : A0 ⟩ $ > $ cinst k G0 A0 a G1 G $ > $ ⟦ G1 ⊢ e ≡ e2 : A ⟧ $ >
  $ ⟮ e [ #k ↦ a ] = r ⟯ $ > $ ⟮ e2 [ #k ↦ a ] = r2 ⟯ $ > $ ⟮ A [ #k ↦ a ] = R ⟯ $ >
  $ ⟦ G ⊢ r ≡ r2 : R ⟧ $;

--| Weakening: `IsDefEq.weakN`, Typing/Lemmas.lean:501, for `Ctx.LiftN n 0`
--| (see notes/audit-lean-mm0.md §6).
axiom weakDF (n: nat) (G G2: ctx) (e e2 A r r2 R: expr):
  $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ cext n G G2 $ >
  $ ⟮₀ e ↑ n = r ⟯ $ > $ ⟮₀ e2 ↑ n = r2 ⟯ $ > $ ⟮₀ A ↑ n = R ⟯ $ >
  $ ⟦ G2 ⊢ r ≡ r2 : R ⟧ $;

-- Level equivalence of expressions -----------------------------------------

--| Expressions of the same shape at equivalent levels denote the same value,
--| so they are definitionally equal (this generalizes `sortDF` and `constDF`).
axiom eeqv_df (G: ctx) (e e2 A: expr): $ ⟨ G ⊢ e : A ⟩ $ > $ eeqv e e2 $ > $ ⟦ G ⊢ e ≡ e2 : A ⟧ $;

-- Statements ---------------------------------------------------------------

--| `inh G A`: `A` is inhabited in `Γ`. Theorems are stated this way so that
--| their proof terms stay inside the proof file.
term inh: ctx > expr > wff;
--| A type with a term is inhabited.
axiom inh_i (G: ctx) (e A: expr): $ ⟨ G ⊢ e : A ⟩ $ > $ inh G A $;
