import "lean-ind.mm0";

-- LeanTT, quotients: the primitives `Quot`, `Quot.mk`, `Quot.lift` and
-- `Quot.ind` as constants with the kernel's types and reduction rules, and
-- Lean's `Eq` (notes/audit-lean-mm0.md §4). See lean-core.mm0 for the spec's
-- organization and notations.

---------------------------------------------------------------------------
-- PART I: SYNTAX
---------------------------------------------------------------------------

-- Lean's `Eq`, the quotient primitives, and the axioms `propext`,
-- `Quot.sound` and `Classical.choice` ----------------------------------------
-- (notes/audit-lean-mm0.md §4.) `eq_D` is the data of the block `Eq` as Lean's
-- prelude declares it (the type of `Quot.lift` mentions `Eq`), and `iff_D`
-- that of `Iff` (the type of `propext` mentions it), `nonempty_D` that of
-- `Nonempty` (the type of `Classical.choice`). The four quotient primitives
-- and the three axioms are constants like any Lean axiom (`cst` of an atom),
-- but with atoms of the spec, so that Part III can state their types as
-- rules (and `closed_cst`, `eeqv_cst` and `afree_cst` apply); `lean0 check`
-- reads the statements between the `lean0-check` marks (written in prefix form
-- for that) and compares the export's `Eq` and quotient declarations with
-- them. A certificate proves `tys_ok` and `ind_wf` for the block like any
-- other. The quotient primitives' types and reduction rules are in Part III.

-- lean0-check: begin
--| The inductive block of `Eq`.
term eq_blk: blk;
--| The inductive block of `Eq`: its parameters, types and constructors.
def eq_D (u: lvl): ind = $ ind_mk eq_blk (cons (bvar nz) (cons (srt u) nil)) (tcons (pi (bvar (s nz)) (srt lz)) (ccons (app (app (app (bvar (s (s nz))) (bvar (s nz))) (bvar nz)) (bvar nz)) cnil) tnil) nil $;
--| The atom of Lean quotient primitive `Quot`.
term quot_atom: atom;
--| Lean quotient primitive `Quot`.
def quot (u: lvl): expr = $ cst quot_atom (lcons u lnil) $;
--| The atom of Lean quotient primitive `Quot.mk`.
term quot_mk_atom: atom;
--| Lean quotient primitive `Quot.mk`.
def quot_mk (u: lvl): expr = $ cst quot_mk_atom (lcons u lnil) $;
--| The atom of Lean quotient primitive `Quot.lift`.
term quot_lift_atom: atom;
--| Lean quotient primitive `Quot.lift`.
def quot_lift (u v: lvl): expr = $ cst quot_lift_atom (lcons u (lcons v lnil)) $;
--| The atom of Lean quotient primitive `Quot.ind`.
term quot_ind_atom: atom;
--| Lean quotient primitive `Quot.ind`.
def quot_ind (u: lvl): expr = $ cst quot_ind_atom (lcons u lnil) $;
--| The inductive block of `Iff`.
term iff_blk: blk;
--| The inductive block of `Iff`: its parameters, types and constructors.
def iff_D: ind = $ ind_mk iff_blk (cons (srt lz) (cons (srt lz) nil)) (tcons (srt lz) (ccons (pi (pi (bvar (s nz)) (bvar (s nz))) (pi (pi (bvar (s nz)) (bvar (s (s (s nz))))) (app (app (bvar (s (s (s (s nz))))) (bvar (s (s (s nz))))) (bvar (s (s nz)))))) cnil) tnil) nil $;
--| The atom of Lean axiom `propext`.
term propext_atom: atom;
--| Lean axiom `propext`.
def propext: expr = $ cst propext_atom lnil $;
--| The atom of Lean axiom `Quot.sound`.
term quot_sound_atom: atom;
--| Lean axiom `Quot.sound`.
def quot_sound (u: lvl): expr = $ cst quot_sound_atom (lcons u lnil) $;
--| The inductive block of `Nonempty`.
term nonempty_blk: blk;
--| The inductive block of `Nonempty`: its parameters, types and constructors.
def nonempty_D (u: lvl): ind = $ ind_mk nonempty_blk (cons (srt u) nil) (tcons (srt lz) (ccons (pi (bvar nz) (app (bvar (s (s nz))) (bvar (s nz)))) cnil) tnil) nil $;
--| The atom of Lean axiom `Classical.choice`.
term choice_atom: atom;
--| Lean axiom `Classical.choice`.
def choice (u: lvl): expr = $ cst choice_atom (lcons u lnil) $;
-- lean0-check: end

---------------------------------------------------------------------------
-- PART II: DEFINITIONS OVER LEVEL EQUIVALENCE AND THE JUDGMENT
---------------------------------------------------------------------------

-- (Nothing here: the quotient primitives are constants, whose level
-- equivalence is `eeqv_cst`.)

---------------------------------------------------------------------------
-- PART III: THE RULES
---------------------------------------------------------------------------

-- Quotients (audit §4) -----------------------------------------------------
-- The kernel's types of the primitives (`Quot.lift`'s mentions `Eq`), and
-- `Quot.lift` reduces on `Quot.mk`. `Quot.ind` on `Quot.mk` needs no rule:
-- both sides prove one proposition (`proof_irrel`).

--| `Quot : Π (α : Sort u), (α → α → Prop) → Sort u`
axiom quot_ty (G: ctx) (u: lvl):
  $ ⟦ₜ G ⊢ quot u : Π (Sort u), Π (Π #0, Π #1, Prop), Sort u ⟧ $;
--| `Quot.mk : Π (α : Sort u) (r : α → α → Prop), α → Quot r`
axiom quot_mk_ty (G: ctx) (u: lvl):
  $ ⟦ₜ G ⊢ quot_mk u : Π (Sort u), Π (Π #0, Π #1, Prop), Π #1, quot u @ #2 @ #1 ⟧ $;
--| `Quot.lift : Π (α : Sort u) (r : α → α → Prop) (β : Sort v) (f : α → β).
--|   (Π a b. r a b → Eq (f a) (f b)) → Quot r → β`
axiom quot_lift_ty (G: ctx) (u v: lvl):
  $ ⟦ₜ G ⊢ quot_lift u v : Π (Sort u), Π (Π #0, Π #1, Prop), Π (Sort v), Π (Π #2, #1),
      Π (Π #3, Π #4, Π (#4 @ #1 @ #0), ind_ty (eq_D v) 0 @ #4 @ (#3 @ #2) @ (#3 @ #1)),
      Π (quot u @ #4 @ #3), #3 ⟧ $;
--| `Quot.ind : Π (α : Sort u) (r : α → α → Prop) (β : Quot r → Prop).
--|   (Π a. β (Quot.mk r a)) → Π q. β q`
axiom quot_ind_ty (G: ctx) (u: lvl):
  $ ⟦ₜ G ⊢ quot_ind u : Π (Sort u), Π (Π #0, Π #1, Prop), Π (Π (quot u @ #1 @ #0), Prop),
      Π (Π #2, #1 @ (quot_mk u @ #3 @ #2 @ #0)), Π (quot u @ #3 @ #2), #2 @ #0 ⟧ $;

--| `Quot.lift f h (Quot.mk r a) ≡ f a` as a closed equation: stated once, in
--| the context of the primitive's own variables (`α`, `r`, `β`, `f`, `h`,
--| `a`, in the context's order). No typing
--| premise: every argument is a variable of the context. Instances follow
--| by `weak_base_df` and `inst_df`.
axiom quot_lift_mk (u v: lvl):
  $ ⟦ [] ▷ Sort u ▷ (Π #0, Π #1, Prop) ▷ Sort v ▷ (Π #2, #1) ▷
      (Π #3, Π #4, Π (#4 @ #1 @ #0), ind_ty (eq_D v) 0 @ #4 @ (#3 @ #2) @ (#3 @ #1)) ▷ #4
    ⊢ quot_lift u v @ #5 @ #4 @ #3 @ #2 @ #1 @ (quot_mk u @ #5 @ #4 @ #0) ≡ #2 @ #0 : #3 ⟧ $;

-- Lean's axioms `propext`, `Quot.sound` and `Classical.choice` (audit §4) ----
-- The three axioms of Lean's library that hold in the model outright, with the
-- types Lean gives them: a certificate that uses them assumes nothing.

--| `propext : Π (a b : Prop), (a ↔ b) → a = b`
axiom propext_ty (G: ctx):
  $ ⟦ₜ G ⊢ propext : Π Prop, Π Prop, Π (ind_ty iff_D 0 @ #1 @ #0), ind_ty (eq_D (ls lz)) 0 @ Prop @ #2 @ #1 ⟧ $;
--| `Quot.sound : Π (α : Sort u) (r : α → α → Prop) (a b : α).
--|   r a b → Quot.mk r a = Quot.mk r b`
axiom quot_sound_ty (G: ctx) (u: lvl):
  $ ⟦ₜ G ⊢ quot_sound u : Π (Sort u), Π (Π #0, Π #1, Prop), Π #1, Π #2, Π (#2 @ #1 @ #0),
      ind_ty (eq_D u) 0 @ (quot u @ #4 @ #3) @ (quot_mk u @ #4 @ #3 @ #2) @ (quot_mk u @ #4 @ #3 @ #1) ⟧ $;
--| `Classical.choice : Π (α : Sort u), Nonempty α → α`
axiom choice_ty (G: ctx) (u: lvl):
  $ ⟦ₜ G ⊢ choice u : Π (Sort u), Π (ind_ty (nonempty_D u) 0 @ #0), #1 ⟧ $;
