delimiter $ ( ) . # $;

--| LeanTT: Lean 4's kernel as an MM0 theory, transcribed from Lean4Lean
--| (digama0/lean4lean @ 67f63b0: Theory/VLevel.lean, Theory/VExpr.lean,
--| Theory/Typing/Basic.lean), with the kernel's inductive types, quotients and
--| literals (notes/audit-lean-mm0.md §4 and §5).
--|
--| The file is in three parts. Part I, Syntax, declares the sorts (naturals,
--| levels, expressions, contexts, binary numerals, inductive blocks as data: all
--| closed first-order syntax, no sort admits bound variables) and relations on
--| them that are the graphs of functions, or predicates, on syntax, defined by
--| clauses that recurse on their inputs: lifting and substitution, the reading
--| of an inductive block, the recursor's type and rules, and so on. Nothing in
--| Part I mentions level equivalence or the judgment. Part II declares those
--| two relations, `≈` and `⊢`, and the relations defined over them in the same
--| way (the well-formedness of an inductive block, its elimination level, the
--| defining equations of the literal operations). Part III states the rules:
--| the axioms concluding `≈` and `⊢`, which are the theory, each argued in the
--| audit. `lean0 modes` checks mechanically that every relation of Parts I and
--| II is well-moded and that the clauses of each function are pairwise
--| exclusive (`mm0kit/src/modes.rs`), so that the two parts read as the
--| definition of the kernel's meta-operations and Part III as the rules over
--| them.
--|
--| Deviations from the verbatim presentation (see notes/audit-lean-mm0.md §10):
--| * There is no environment term and no `const` constructor. A Lean
--|   definition is an MM0 `def` returning `expr` whose arguments are its
--|   universe parameters (so δ is MM0 unfolding and `instL` is MM0
--|   substitution). An inductive block is a data term `ind_mk b P T` (a
--|   generated `def X_D (us): ind`), and its types, constructors and recursors
--|   are `ind_ty D i`, `ind_ctor D i c` and `ind_rec D i v`, typed by the
--|   schema once the certificate proves the block legal (`ind_wf`).
--|   A nested block is the mutual block the kernel checks in its place,
--|   with the nested occurrences restored in what it states (`ind_mkn`).
--|   Axioms and opaques are atoms at their levels (`cst`), each with one
--|   generated axiom, its `constDF` instance.
--| * Universe parameters are MM0 variables of sort `lvl`, so the `l.WF U`
--|   side conditions are vacuous and are dropped.
--| * Meta-level operations (liftN, inst, Lookup) are syntax-directed
--|   relations, proved node by node.
--| * Nat literals are a primitive `lit` over binary numerals (an extension;
--|   Lean4Lean unfolds literals to `Nat.succ`/`Nat.zero`), tied to Lean's
--|   `Nat` by `lit_zero`/`lit_succ`. The accelerated operations are rules
--|   over the defining equations Lean4Lean checks (`add_eqs`, `nat_add_lit`,
--|   ...; `div_eqs`, `gcd_eqs`, `bitwise_eqs`, ... for the operations defined
--|   by fuel and well-founded recursion).
--| * Lean's `Nat` and `Eq` are the blocks `nat_D` and `eq_D` (data the
--|   checker compares with the export), and the quotient primitives are
--|   constants with the kernel's types and reduction rules.
--| * Two admissible rules are axioms: `instDF` (substitution, Lean4Lean's
--|   theorem `IsDefEq.instN`), so that a substituted term's typing need not
--|   be derived again, and `weakDF` (weakening, `IsDefEq.weakN`), so that a
--|   derivation made in a shorter context can be used in a longer one.
--| * `eeqv_df`: expressions of the same shape at equivalent levels are
--|   definitionally equal (generalizing `sortDF` and `constDF`).
--|
--| Notations: `⟦ Γ ⊢ e ≡ e2 : A ⟧` for the judgment and `⟨ Γ ⊢ e : A ⟩` for typing,
--| `λ A. e`, `Π A. B`, `f @ a`, `#i` for a bound variable, `A :: Γ` and `[]`
--| for contexts, `a ⊔ b` for `max`, `≤`, `<` and `≈` (level equivalence), the
--| numerals `0` to `9` (`nz` and the definitions `n1` to `n9`), `Prop` for
--| `srt lz`, and `ℕ` for `nat_ty`. The Unicode ones have an ASCII form too
--| (`[[ G |- e == e2 : A ]]`, `<< G |- e : A >>`, `\ A. e`, `\Pi A. B`, `\/`,
--| `<=`, `~=`), declared first; the Unicode one is declared last, the form
--| Aufbau prints. A term with a notation can still be written as an application
--| (`deq G e e2 A`), as the generated statements are.
--|
--| @hole _wff
strict provable sort wff;

---------------------------------------------------------------------------
-- PART I: SYNTAX
-- Every relation here is the graph of a function (its mode, which arguments are
-- inputs, is in `mm0kit/src/modes.rs`) or a predicate on syntax, defined by
-- clauses that recurse on their inputs; nothing mentions `≈` or `⊢`.
---------------------------------------------------------------------------

-- Unary naturals (de Bruijn indices) ---------------------------------------

--| @hole _n
strict free sort nat;
term nz: nat;
term s: nat > nat;

-- The numerals `0` to `9`: `0` is `nz`, and `n1` to `n9` are the definitions
-- `s 0` to `s 8`. Larger numbers are written with `s`.
prefix nz: $0$ prec max;
def n1: nat = $ s 0 $; prefix n1: $1$ prec max;
def n2: nat = $ s 1 $; prefix n2: $2$ prec max;
def n3: nat = $ s 2 $; prefix n3: $3$ prec max;
def n4: nat = $ s 3 $; prefix n4: $4$ prec max;
def n5: nat = $ s 4 $; prefix n5: $5$ prec max;
def n6: nat = $ s 5 $; prefix n6: $6$ prec max;
def n7: nat = $ s 6 $; prefix n7: $7$ prec max;
def n8: nat = $ s 7 $; prefix n8: $8$ prec max;
def n9: nat = $ s 8 $; prefix n9: $9$ prec max;

--| `le i n`: i ≤ n.
term le: nat > nat > wff;
infixl le: $<=$ prec 50;
infixl le: $≤$ prec 50;
axiom le_z (n: nat): $ 0 ≤ n $;
axiom le_s (i n: nat): $ i ≤ n $ > $ s i ≤ s n $;

--| `lt i n`: i < n.
def lt (i n: nat): wff = $ s i ≤ n $;
infixl lt: $<$ prec 50;

--| `add i n j`: i + n = j.
term add: nat > nat > nat > wff;
axiom add_z (i: nat): $ add i 0 i $;
axiom add_s (i n j: nat): $ add i n j $ > $ add i (s n) (s j) $;

-- Universe levels (VLevel.lean:8-13) ---------------------------------------

--| @hole _l
strict free sort lvl;
term lz: lvl;
term ls: lvl > lvl;
term lmax: lvl > lvl > lvl;
infixl lmax: $\/$ prec 65;
infixl lmax: $⊔$ prec 65;
term limax: lvl > lvl > lvl;

--| `lparam i`: an object-level level parameter, for the case split
--| `leqv_cases` (Part III); it only ever occurs inside `leqv` proofs.
term lparam: nat > lvl;

--| Lists of levels.
--| @hole _ls
strict free sort lvls;
term lnil: lvls;
term lcons: lvl > lvls > lvls;

--| `lnth S n a`: the `n`th element of `S` is `a`.
term lnth: lvls > nat > lvl > wff;
axiom lnth_z (a: lvl) (S: lvls): $ lnth (lcons a S) 0 a $;
axiom lnth_s (a b: lvl) (S: lvls) (n: nat): $ lnth S n b $ > $ lnth (lcons a S) (s n) b $;

--| `linst S l l2`: `l2` is `l` with each `lparam i` replaced by the `i`th
--| element of `S`.
term linst: lvls > lvl > lvl > wff;
axiom linst_z (S: lvls): $ linst S lz lz $;
axiom linst_s (S: lvls) (a a2: lvl): $ linst S a a2 $ > $ linst S (ls a) (ls a2) $;
axiom linst_max (S: lvls) (a b a2 b2: lvl):
  $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (a ⊔ b) (a2 ⊔ b2) $;
axiom linst_imax (S: lvls) (a b a2 b2: lvl):
  $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (limax a b) (limax a2 b2) $;
axiom linst_param (S: lvls) (n: nat) (a: lvl): $ lnth S n a $ > $ linst S (lparam n) a $;

--| `lsubst n l a l2`: `l2` is `l` with `lparam n` replaced by `a`.
term lsubst: nat > lvl > lvl > lvl > wff;
axiom lsubst_z (n: nat) (a: lvl): $ lsubst n lz a lz $;
axiom lsubst_s (n: nat) (b a b2: lvl): $ lsubst n b a b2 $ > $ lsubst n (ls b) a (ls b2) $;
axiom lsubst_max (n: nat) (b c a b2 c2: lvl):
  $ lsubst n b a b2 $ > $ lsubst n c a c2 $ > $ lsubst n (b ⊔ c) a (b2 ⊔ c2) $;
axiom lsubst_imax (n: nat) (b c a b2 c2: lvl):
  $ lsubst n b a b2 $ > $ lsubst n c a c2 $ > $ lsubst n (limax b c) a (limax b2 c2) $;
axiom lsubst_eq (n: nat) (a: lvl): $ lsubst n (lparam n) a a $;
axiom lsubst_lt (n m: nat) (a: lvl): $ m < n $ > $ lsubst n (lparam m) a (lparam m) $;
axiom lsubst_gt (n m: nat) (a: lvl): $ n < m $ > $ lsubst n (lparam m) a (lparam m) $;

-- Expressions (VExpr.lean:7-13), without `const` ---------------------------

--| @hole _e
strict free sort expr;
term bvar: nat > expr;
prefix bvar: $#$ prec max;
term srt: lvl > expr;
--| The sort of propositions.
def Prop: expr = $ srt lz $;
term app: expr > expr > expr;
infixl app: $@$ prec 1000;
term lam: expr > expr > expr;
notation lam (A e: expr): expr = ($\$:20) A ($.$:0) e;
notation lam (A e: expr): expr = ($λ$:20) A ($.$:0) e;
--| `forallE` in Lean4Lean.
term pi: expr > expr > expr;
notation pi (A B: expr): expr = ($\Pi$:20) A ($.$:0) B;
notation pi (A B: expr): expr = ($Π$:20) A ($.$:0) B;
--| An opaque constant (a Lean axiom, an opaque definition, a constant left to
--| the generated axioms): an atom, which a certificate declares as
--| `term X_atom: atom` and uses in exactly one definition
--| `def X (us): expr = $ cst X_atom (lcons u1 ... lnil) $`, at its universe
--| levels. Nothing in the spec tells two atoms apart; that each constant has
--| its own is checked by `lean0 check` (audit §8).
strict free sort atom;
term cst: atom > lvls > expr;

--| `closed k e`: every loose bound variable of `e` is below `k`
--| (`ClosedN e k`, VExpr.lean:99-104).
term closed: nat > expr > wff;
axiom closed_bvar (i k: nat): $ i < k $ > $ closed k #i $;
axiom closed_srt (k: nat) (l: lvl): $ closed k (srt l) $;
axiom closed_app (k: nat) (f a: expr):
  $ closed k f $ > $ closed k a $ > $ closed k (f @ a) $;
axiom closed_lam (k: nat) (A b: expr):
  $ closed k A $ > $ closed (s k) b $ > $ closed k (λ A. b) $;
axiom closed_pi (k: nat) (A b: expr):
  $ closed k A $ > $ closed (s k) b $ > $ closed k (Π A. b) $;
axiom closed_cst (k: nat) (a: atom) (S: lvls): $ closed k (cst a S) $;

--| `lift n k e e2`: `e2 = liftN n e k` (VExpr.lean:17, 38-44).
term lift: nat > nat > expr > expr > wff;
axiom lift_bvar_lt (n k i: nat): $ i < k $ > $ lift n k #i #i $;
axiom lift_bvar_ge (n k i j: nat):
  $ k ≤ i $ > $ add i n j $ > $ lift n k #i #j $;
axiom lift_srt (n k: nat) (l: lvl): $ lift n k (srt l) (srt l) $;
axiom lift_app (n k: nat) (f a f2 a2: expr):
  $ lift n k f f2 $ > $ lift n k a a2 $ > $ lift n k (f @ a) (f2 @ a2) $;
axiom lift_lam (n k: nat) (A b A2 b2: expr):
  $ lift n k A A2 $ > $ lift n (s k) b b2 $ > $ lift n k (λ A. b) (λ A2. b2) $;
axiom lift_pi (n k: nat) (A b A2 b2: expr):
  $ lift n k A A2 $ > $ lift n (s k) b b2 $ > $ lift n k (Π A. b) (Π A2. b2) $;
--| Admissible (by induction on `e`): `ClosedN.liftN_eq`, VExpr.lean:117.
axiom lift_closed (n j k: nat) (e: expr):
  $ closed j e $ > $ j ≤ k $ > $ lift n k e e $;

--| `inst k e a e2`: `e2 = inst e a k` (VExpr.lean:187-188, 240-246).
term inst: nat > expr > expr > expr > wff;
axiom inst_bvar_lt (k i: nat) (a: expr): $ i < k $ > $ inst k #i a #i $;
axiom inst_bvar_eq (k: nat) (a a2: expr): $ lift k 0 a a2 $ > $ inst k #k a a2 $;
axiom inst_bvar_gt (k i: nat) (a: expr):
  $ k ≤ i $ > $ inst k #(s i) a #i $;
axiom inst_srt (k: nat) (l: lvl) (a: expr): $ inst k (srt l) a (srt l) $;
axiom inst_app (k: nat) (f x a f2 x2: expr):
  $ inst k f a f2 $ > $ inst k x a x2 $ > $ inst k (f @ x) a (f2 @ x2) $;
axiom inst_lam (k: nat) (A b a A2 b2: expr):
  $ inst k A a A2 $ > $ inst (s k) b a b2 $ > $ inst k (λ A. b) a (λ A2. b2) $;
axiom inst_pi (k: nat) (A b a A2 b2: expr):
  $ inst k A a A2 $ > $ inst (s k) b a b2 $ > $ inst k (Π A. b) a (Π A2. b2) $;
--| Admissible (by induction on `e`): `ClosedN.instN_eq`, VExpr.lean:482.
axiom inst_closed (j k: nat) (e a: expr):
  $ closed j e $ > $ j ≤ k $ > $ inst k e a e $;

-- Contexts (Typing/Basic.lean:6-8) -----------------------------------------

--| Innermost binder first; each entry is a type relative to the tail.
--| @hole _G
strict free sort ctx;
term nil: ctx;
prefix nil: $[]$ prec max;
term cons: expr > ctx > ctx;
infixr cons: $::$ prec 60;

term lookup: ctx > nat > expr > wff;
axiom lookup_z (A A2: expr) (G: ctx):
  $ lift 1 0 A A2 $ > $ lookup (A :: G) 0 A2 $;
axiom lookup_s (A B B2: expr) (G: ctx) (n: nat):
  $ lookup G n B $ > $ lift 1 0 B B2 $ > $ lookup (A :: G) (s n) B2 $;

--| `cinst k G0 A0 a G1 G`: `G1` is `G0` extended by `A0` and then `k` more
--| entries, and `G` is `G1` without `A0`, with `a` substituted for it in the
--| `k` entries above it (`Ctx.InstN`, Typing/Lemmas.lean:86).
term cinst: nat > ctx > expr > expr > ctx > ctx > wff;
axiom cinst_z (G0: ctx) (A0 a: expr): $ cinst 0 G0 A0 a (A0 :: G0) G0 $;
axiom cinst_s (k: nat) (G0 G1 G: ctx) (A0 a A A2: expr):
  $ cinst k G0 A0 a G1 G $ > $ inst k A a A2 $ >
  $ cinst (s k) G0 A0 a (A :: G1) (A2 :: G) $;

--| `cext n G G2`: `G2` is `G` extended by `n` more entries
--| (`Ctx.LiftN n 0 G G2`, the `zero` case, Typing/Lemmas.lean:9).
term cext: nat > ctx > ctx > wff;
axiom cext_z (G: ctx): $ cext 0 G G $;
axiom cext_s (n: nat) (G G2: ctx) (A: expr):
  $ cext n G G2 $ > $ cext (s n) G (A :: G2) $;

--| Contexts as lists: `clen G n` is the length, `cnth G n A` entry `n` as
--| written (`lookup` lifts it), `capp P G G2` the concatenation `P ++ G`.
--| Lengths and entries: of a context, of a constructor list, and `ntys T n m`
--| for `n` types with `m` constructors in all.
term clen: ctx > nat > wff;
axiom clen_nil: $ clen [] 0 $;
axiom clen_cons (A: expr) (G: ctx) (n: nat): $ clen G n $ > $ clen (A :: G) (s n) $;
term cnth: ctx > nat > expr > wff;
axiom cnth_z (A: expr) (G: ctx): $ cnth (A :: G) 0 A $;
axiom cnth_s (A B: expr) (G: ctx) (n: nat): $ cnth G n B $ > $ cnth (A :: G) (s n) B $;
term capp: ctx > ctx > ctx > wff;
axiom capp_nil (G: ctx): $ capp [] G G $;
axiom capp_cons (A: expr) (P G G2: ctx): $ capp P G G2 $ > $ capp (A :: P) G (A :: G2) $;

-- Nat literals: binary numerals (notes/audit-lean-mm0.md §5) ---------------

--| Binary numerals: `b0` is 0, `bd0 n` is 2n and `bd1 n` is 2n+1. Each
--| relation below is syntax-directed, and each axiom is true when every
--| numeral is read as its value (so a non-canonical numeral such as
--| `bd0 b0` is harmless; generated proofs only use canonical ones).
--| @hole _b
strict free sort bin;
term b0: bin;
term bd0: bin > bin;
term bd1: bin > bin;

--| `bsucc a b`: a + 1 = b.
term bsucc: bin > bin > wff;
axiom bsucc_0: $ bsucc b0 (bd1 b0) $;
axiom bsucc_d0 (a: bin): $ bsucc (bd0 a) (bd1 a) $;
axiom bsucc_d1 (a b: bin): $ bsucc a b $ > $ bsucc (bd1 a) (bd0 b) $;

--| `bdbl a b`: 2a = b (`bd0`, except that 2·0 is `b0`).
term bdbl: bin > bin > wff;
axiom bdbl_0: $ bdbl b0 b0 $;
axiom bdbl_d0 (a: bin): $ bdbl (bd0 a) (bd0 (bd0 a)) $;
axiom bdbl_d1 (a: bin): $ bdbl (bd1 a) (bd0 (bd1 a)) $;

--| `badd a b c`: a + b = c. `baddc a b c`: a + b + 1 = c (with carry).
term badd: bin > bin > bin > wff;
term baddc: bin > bin > bin > wff;
axiom badd_0l (b: bin): $ badd b0 b b $;
axiom badd_0r (a: bin): $ badd a b0 a $;
axiom badd_00 (a b c: bin): $ badd a b c $ > $ badd (bd0 a) (bd0 b) (bd0 c) $;
axiom badd_01 (a b c: bin): $ badd a b c $ > $ badd (bd0 a) (bd1 b) (bd1 c) $;
axiom badd_10 (a b c: bin): $ badd a b c $ > $ badd (bd1 a) (bd0 b) (bd1 c) $;
axiom badd_11 (a b c: bin): $ baddc a b c $ > $ badd (bd1 a) (bd1 b) (bd0 c) $;
axiom baddc_0l (b c: bin): $ bsucc b c $ > $ baddc b0 b c $;
axiom baddc_0r (a c: bin): $ bsucc a c $ > $ baddc a b0 c $;
axiom baddc_00 (a b c: bin): $ badd a b c $ > $ baddc (bd0 a) (bd0 b) (bd1 c) $;
axiom baddc_01 (a b c: bin): $ baddc a b c $ > $ baddc (bd0 a) (bd1 b) (bd0 c) $;
axiom baddc_10 (a b c: bin): $ baddc a b c $ > $ baddc (bd1 a) (bd0 b) (bd0 c) $;
axiom baddc_11 (a b c: bin): $ baddc a b c $ > $ baddc (bd1 a) (bd1 b) (bd1 c) $;

--| `bmul a b c`: a · b = c (by the bits of `b`).
term bmul: bin > bin > bin > wff;
axiom bmul_0 (a: bin): $ bmul a b0 b0 $;
axiom bmul_d0 (a b c d: bin): $ bmul a b c $ > $ bdbl c d $ > $ bmul a (bd0 b) d $;
axiom bmul_d1 (a b c d e: bin):
  $ bmul a b c $ > $ bdbl c d $ > $ badd d a e $ > $ bmul a (bd1 b) e $;

--| `bpow a b c`: a ^ b = c (by the bits of `b`; 0 ^ 0 = 1).
term bpow: bin > bin > bin > wff;
axiom bpow_0 (a: bin): $ bpow a b0 (bd1 b0) $;
axiom bpow_d0 (a b c d: bin): $ bpow a b c $ > $ bmul c c d $ > $ bpow a (bd0 b) d $;
axiom bpow_d1 (a b c d e: bin):
  $ bpow a b c $ > $ bmul c c d $ > $ bmul d a e $ > $ bpow a (bd1 b) e $;

--| `band a b c`, `bor a b c`, `bxor a b c`: bitwise and, or and exclusive or.
term band: bin > bin > bin > wff;
axiom band_0l (b: bin): $ band b0 b b0 $;
axiom band_0r (a: bin): $ band a b0 b0 $;
axiom band_00 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd0 a) (bd0 b) d $;
axiom band_01 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd0 a) (bd1 b) d $;
axiom band_10 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd1 a) (bd0 b) d $;
axiom band_11 (a b c: bin): $ band a b c $ > $ band (bd1 a) (bd1 b) (bd1 c) $;
term bor: bin > bin > bin > wff;
axiom bor_0l (b: bin): $ bor b0 b b $;
axiom bor_0r (a: bin): $ bor a b0 a $;
axiom bor_00 (a b c: bin): $ bor a b c $ > $ bor (bd0 a) (bd0 b) (bd0 c) $;
axiom bor_01 (a b c: bin): $ bor a b c $ > $ bor (bd0 a) (bd1 b) (bd1 c) $;
axiom bor_10 (a b c: bin): $ bor a b c $ > $ bor (bd1 a) (bd0 b) (bd1 c) $;
axiom bor_11 (a b c: bin): $ bor a b c $ > $ bor (bd1 a) (bd1 b) (bd1 c) $;
term bxor: bin > bin > bin > wff;
axiom bxor_0l (b: bin): $ bxor b0 b b $;
axiom bxor_0r (a: bin): $ bxor a b0 a $;
axiom bxor_00 (a b c d: bin): $ bxor a b c $ > $ bdbl c d $ > $ bxor (bd0 a) (bd0 b) d $;
axiom bxor_01 (a b c: bin): $ bxor a b c $ > $ bxor (bd0 a) (bd1 b) (bd1 c) $;
axiom bxor_10 (a b c: bin): $ bxor a b c $ > $ bxor (bd1 a) (bd0 b) (bd1 c) $;
axiom bxor_11 (a b c d: bin): $ bxor a b c $ > $ bdbl c d $ > $ bxor (bd1 a) (bd1 b) d $;

--| `lit n`: the Nat literal with value `n`, read as `Nat.succ^n Nat.zero`
--| (Lean4Lean's translation of literals). `lit_zero` and `lit_succ` (Part III)
--| relate it to Lean's `Nat`, and the rules for the accelerated operations
--| follow them (`nat_add_lit`, ...; notes/audit-lean-mm0.md §5).
term lit: bin > expr;
axiom closed_lit (k: nat) (n: bin): $ closed k (lit n) $;
--| The literals `0`, `1` and `2`.
def lit0: expr = $ lit b0 $;
def lit1: expr = $ lit (bd1 b0) $;
def lit2: expr = $ lit (bd0 (bd1 b0)) $;

-- Inductive blocks as data (notes/audit-lean-mm0.md §4) --------------------
-- Not in Lean4Lean, whose `VInductDecl.WF` is left as `sorry`. A schema: an
-- inductive block is a term of sort `ind`, the certificate proves it well
-- formed (`ind_wf`, Part II), and the types, constructors and recursors, their
-- iota rules, projections and structure eta follow from the rules of Part III.
-- The relations transcribe Lean's kernel (`inductive.cpp`; Lean4Lean's
-- `Inductive/Add.lean` is the port read for this): every one is
-- syntax-directed over the declaration.
--
-- A block `ind_mk b P T` has an atom `b` (a `term` of sort `blk` per block,
-- so that structurally equal declarations stay distinct), the parameters as
-- a telescope `P` (a `ctx`: innermost parameter first, each type under the
-- earlier ones) and the types `T`: for each type its type `F` (under `P`:
-- `Π indices. srt l`) and the types of its constructors. A constructor's
-- type `K` is written under `P` and, outside `P`, under the block's `n`
-- types themselves: at depth `d` inside `K`, parameter `q` (0 outermost) is
-- `#(d + np - 1 - q)` and type `j` is `#(d + np + j)`. So "no occurrence
-- of the types being declared" is `closed (d + np)`, and instantiating the
-- types (`sinst`) is `inst`.
--
-- Counting conventions: `np` parameters, `n` types, `m` constructors in all,
-- `nf` fields of a constructor, `nidx` indices of a type; motive `j` is the
-- `j`th binder after the parameters and minor `k` the `k`th after the motives.

--| @hole _blk
strict free sort blk;
--| @hole _ind
strict free sort ind;
--| @hole _tys
strict free sort tys;
--| @hole _ctors
strict free sort ctors;
term ind_mk: blk > ctx > tys > ind;
term tnil: tys;
--| `tcons F C T`: a type whose type is `F`, with constructors `C`, then `T`.
term tcons: expr > ctors > tys > tys;
term cnil: ctors;
term ccons: expr > ctors > ctors;

--| A nested block `ind_mkn b P T N` is the mutual block the kernel checks in
--| its place: `T` lists the declared types and then one auxiliary type per
--| nested occurrence `I Ds` of an earlier block `I` in the constructors (in
--| the kernel's order), and `N` lists the occurrences, each `ind_ty I i @ Ds`
--| written like a constructor type at depth 0 (a `ctx` used as a list; `Ds`
--| mention the block's types). An auxiliary type must have `I`'s type and
--| constructors at `Ds` with the occurrences replaced by the auxiliary types
--| (`spz`), and the kernel adds auxiliary types for all of `I`'s block at
--| once (`nst_ok`). So an auxiliary type denotes the occurrence itself, and
--| the block's constructors, recursors and rules are stated with the
--| occurrences restored (`rst`, the kernel's `restoreNested`): the auxiliary
--| type `ind_ty D j ps is` is read as `I Ds[ps] is` and its constructor
--| `ind_ctor D j c ps fs` as `ind_ctor I i c Ds[ps] fs`. Its recursor is the
--| block's (`X.rec_k` for the `k`th auxiliary type) and reduces on `I`'s
--| constructors (`ind_iota_nst`).
term ind_mkn: blk > ctx > tys > ctx > ind;

--| Type `i`, constructor `c` of type `i`, and the recursor of type `i` with
--| motives in `srt v`, of a block.
term ind_ty: ind > nat > expr;
term ind_ctor: ind > nat > nat > expr;
term ind_rec: ind > nat > lvl > expr;
--| `proj b i e`: field `i` of `e`, a structure of the block with atom `b`.
term proj: blk > nat > expr > expr;

axiom closed_ind_ty (k: nat) (D: ind) (i: nat): $ closed k (ind_ty D i) $;
axiom closed_ind_ctor (k: nat) (D: ind) (i c: nat): $ closed k (ind_ctor D i c) $;
axiom closed_ind_rec (k: nat) (D: ind) (i: nat) (v: lvl): $ closed k (ind_rec D i v) $;
axiom closed_proj (k: nat) (b: blk) (i: nat) (e: expr):
  $ closed k e $ > $ closed k (proj b i e) $;
axiom lift_proj (n k: nat) (b: blk) (i: nat) (e e2: expr):
  $ lift n k e e2 $ > $ lift n k (proj b i e) (proj b i e2) $;
axiom inst_proj (k: nat) (b: blk) (i: nat) (e a e2: expr):
  $ inst k e a e2 $ > $ inst k (proj b i e) a (proj b i e2) $;

-- Reading the declaration --------------------------------------------------

--| The parts of a block. (Clauses take a variable `D` and read it through
--| `ind_data`, so that a block named by a definition stays folded.)
term ind_data: ind > blk > ctx > tys > wff;
axiom ind_data_i (b: blk) (P: ctx) (T: tys): $ ind_data (ind_mk b P T) b P T $;
axiom ind_data_n (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_data (ind_mkn b P T N) b P T $;
--| `ind_nested D N`: the occurrences of `D` (none for `ind_mk`).
term ind_nested: ind > ctx > wff;
axiom ind_nested_mk (b: blk) (P: ctx) (T: tys): $ ind_nested (ind_mk b P T) [] $;
axiom ind_nested_mkn (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_nested (ind_mkn b P T N) N $;

--| `nth_ty T i F C`: type `i` of `T` has type `F` and constructors `C`.
term nth_ty: tys > nat > expr > ctors > wff;
axiom nth_ty_z (F: expr) (C: ctors) (T: tys): $ nth_ty (tcons F C T) 0 F C $;
axiom nth_ty_s (F F2: expr) (C C2: ctors) (T: tys) (i: nat):
  $ nth_ty T i F C $ > $ nth_ty (tcons F2 C2 T) (s i) F C $;
term nth_ctor: ctors > nat > expr > wff;
axiom nth_ctor_z (K: expr) (C: ctors): $ nth_ctor (ccons K C) 0 K $;
axiom nth_ctor_s (K K2: expr) (C: ctors) (c: nat):
  $ nth_ctor C c K $ > $ nth_ctor (ccons K2 C) (s c) K $;

--| Lengths: of a constructor list, and `ntys T n m` for `n` types with `m`
--| constructors in all.
term clen_c: ctors > nat > wff;
axiom clen_c_nil: $ clen_c cnil 0 $;
axiom clen_c_cons (K: expr) (C: ctors) (n: nat): $ clen_c C n $ > $ clen_c (ccons K C) (s n) $;
term ntys: tys > nat > nat > wff;
axiom ntys_nil: $ ntys tnil 0 0 $;
axiom ntys_cons (F: expr) (C: ctors) (T: tys) (n m c m2: nat):
  $ ntys T n m $ > $ clen_c C c $ > $ add m c m2 $ > $ ntys (tcons F C T) (s n) m2 $;
--| `minor_idx T i c k`: constructor `c` of type `i` has minor premise `k`.
term minor_idx: tys > nat > nat > nat > wff;
axiom minor_idx_z (F: expr) (C: ctors) (T: tys) (c: nat): $ minor_idx (tcons F C T) 0 c c $;
axiom minor_idx_s (F: expr) (C: ctors) (T: tys) (i c k nc k2: nat):
  $ clen_c C nc $ > $ minor_idx T i c k $ > $ add nc k k2 $ > $ minor_idx (tcons F C T) (s i) c k2 $;
--| `npis e n`: `e` is `n` binders `Π` over an application or a variable.
term npis: expr > nat > wff;
axiom npis_bvar (i: nat): $ npis #i 0 $;
axiom npis_app (f a: expr): $ npis (f @ a) 0 $;
axiom npis_pi (A B: expr) (n: nat): $ npis B n $ > $ npis (Π A. B) (s n) $;
--| `nth_pi e i A`: the `i`th binder type of `e`.
term nth_pi: expr > nat > expr > wff;
axiom nth_pi_z (A B: expr): $ nth_pi (Π A. B) 0 A $;
axiom nth_pi_s (A A2 B: expr) (i: nat): $ nth_pi B i A $ > $ nth_pi (Π A2. B) (s i) A $;
--| `isort F k l`: `F` is `k` binders over `srt l`.
term isort: expr > nat > lvl > wff;
axiom isort_srt (l: lvl): $ isort (srt l) 0 l $;
axiom isort_pi (A B: expr) (k: nat) (l: lvl): $ isort B k l $ > $ isort (Π A. B) (s k) l $;
--| Derived counts of a block: `ind_arity D np n m`, `nidx D i k` (indices of
--| type `i`) and `nfields D i c nf`.
term ind_arity: ind > nat > nat > nat > wff;
axiom ind_arity_i (D: ind) (b: blk) (P: ctx) (T: tys) (np n m: nat):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ ind_arity D np n m $;
term nidx: ind > nat > nat > wff;
axiom nidx_i (D: ind) (b: blk) (P: ctx) (T: tys) (i k: nat) (F: expr) (C: ctors) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ isort F k l $ > $ nidx D i k $;
term nfields: ind > nat > nat > nat > wff;
axiom nfields_i (D: ind) (b: blk) (P: ctx) (T: tys) (i c nf: nat) (F K: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ npis K nf $ > $ nfields D i c nf $;
--| `ndecl N n n0`: `n0` declared types among `n`; `aux_of D N j X`: the
--| occurrence of auxiliary type `j` (entry `j - n0` of `N`).
term ndecl: ctx > nat > nat > wff;
axiom ndecl_nil (n: nat): $ ndecl [] n n $;
axiom ndecl_cons (X: expr) (N: ctx) (n n0: nat): $ ndecl N n n0 $ > $ ndecl (X :: N) (s n) n0 $;
term aux_of: ind > ctx > nat > expr > wff;
axiom aux_of_i (D: ind) (N: ctx) (j np n m n0 k: nat) (X: expr):
  $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ add n0 k j $ > $ cnth N k X $ > $ aux_of D N j X $;

-- Telescopes and applications ----------------------------------------------

--| `pis P b T`: `T = Π P. b`; `lams P b T`: `T = λ P. b`.
term pis: ctx > expr > expr > wff;
axiom pis_nil (b: expr): $ pis [] b b $;
axiom pis_cons (A b T: expr) (P: ctx): $ pis P (Π A. b) T $ > $ pis (A :: P) b T $;
term lams: ctx > expr > expr > wff;
axiom lams_nil (b: expr): $ lams [] b b $;
axiom lams_cons (A b T: expr) (P: ctx): $ lams P (λ A. b) T $ > $ lams (A :: P) b T $;
--| `tys_closed P T`: each type's type over the parameters is closed with them,
--| `Π P. F` closed (a block is a closed constant: it mentions no variable of
--| the context it is used in).
term tys_closed: ctx > tys > wff;
axiom tys_closed_nil (P: ctx): $ tys_closed P tnil $;
axiom tys_closed_cons (P: ctx) (F R: expr) (C: ctors) (T: tys):
  $ pis P F R $ > $ closed 0 R $ > $ tys_closed P T $ > $ tys_closed P (tcons F C T) $;

--| `pargs X d n e`: `e = X @ #(d+n-1) @ ... @ #d` (the `n` variables above
--| depth `d`). `spine h e k`: `e` is `h` applied to `k` arguments; read with
--| `k` given it takes `k` arguments off `e`, and with `h` given by its head (a
--| constant or a variable, not an application) it counts the arguments down to
--| that head. `rehead Y X k e e2`: `e = Y @ a1 .. ak` and `e2 = X @ a1 .. ak`.
--| `has_arg e a`: `a` is an argument of `e`.
term pargs: expr > nat > nat > expr > wff;
axiom pargs_z (X: expr) (d: nat): $ pargs X d 0 X $;
axiom pargs_s (X e: expr) (d n: nat): $ pargs X (s d) n e $ > $ pargs X d (s n) (e @ #d) $;
term spine: expr > expr > nat > wff;
axiom spine_z (h: expr): $ spine h h 0 $;
axiom spine_s (h e a: expr) (k: nat): $ spine h e k $ > $ spine h (e @ a) (s k) $;
term rehead: expr > expr > nat > expr > expr > wff;
axiom rehead_z (Y X: expr): $ rehead Y X 0 Y X $;
axiom rehead_s (Y X e e2 a: expr) (k: nat): $ rehead Y X k e e2 $ > $ rehead Y X (s k) (e @ a) (e2 @ a) $;
--| `has_arg e a`: `a` is an argument of `e`. `leaf_has j e`: `#j` (at the
--| binder's depth) is an argument of the result under the remaining binders.
term has_arg: expr > expr > wff;
axiom has_arg_z (e a: expr): $ has_arg (e @ a) a $;
axiom has_arg_s (e a b: expr): $ has_arg e a $ > $ has_arg (e @ b) a $;
term leaf_has: nat > expr > wff;
axiom leaf_has_pi (j: nat) (A B: expr): $ leaf_has (s j) B $ > $ leaf_has j (Π A. B) $;
axiom leaf_has_app (j: nat) (e: expr): $ has_arg e #j $ > $ leaf_has j e $;
--| `pinst i S A R`: `S` is a block's type or constructor applied to `p0 ..
--| p(np-1)`; `R` is `A` (under `i` binders over the block's parameters) with
--| the parameters put in, outermost first (`p0` at `#(i + np - 1)`, then
--| `p1` at `#(i + np - 2)`, ...: each substituted term is lifted over the
--| binders below it).
term pinst: nat > expr > expr > expr > wff;
axiom pinst_head (i: nat) (D: ind) (j: nat) (A: expr): $ pinst i (ind_ty D j) A A $;
axiom pinst_head_c (i: nat) (D: ind) (j c: nat) (A: expr): $ pinst i (ind_ctor D j c) A A $;
axiom pinst_app (i: nat) (S a A A1 R: expr): $ pinst (s i) S A A1 $ > $ inst i A1 a R $ > $ pinst i (S @ a) A R $;

-- Lean's `Nat` and `Eq`, and the quotient primitives -----------------------
-- (notes/audit-lean-mm0.md §4 and §5.) `nat_D` and `eq_D` are the data of the
-- blocks `Nat` and `Eq` as Lean's prelude declares them; `lean0 check` reads
-- the statements between the `lean0-check` marks (written in prefix form for
-- that) and compares the export's `Nat`, `Eq` and quotient declarations with
-- them. A certificate proves `tys_ok` and `ind_wf` for the two blocks like any
-- other. The quotient primitives' types and reduction rules are in Part III.

-- lean0-check: begin
--| The inductive block of `Nat`.
term nat_blk: blk;
--| The inductive block of `Nat`: its parameters, types and constructors.
def nat_D: ind = $ ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar nz) (ccons (pi (bvar nz) (bvar (s nz))) cnil)) tnil) $;
--| The inductive block of `Eq`.
term eq_blk: blk;
--| The inductive block of `Eq`: its parameters, types and constructors.
def eq_D (u: lvl): ind = $ ind_mk eq_blk (cons (bvar nz) (cons (srt u) nil)) (tcons (pi (bvar (s nz)) (srt lz)) (ccons (app (app (app (bvar (s (s nz))) (bvar (s nz))) (bvar nz)) (bvar nz)) cnil) tnil) $;
--| Lean quotient primitive `Quot`.
term quot (u: lvl): expr;
--| Lean quotient primitive `Quot.mk`.
term quot_mk (u: lvl): expr;
--| Lean quotient primitive `Quot.lift`.
term quot_lift (u v: lvl): expr;
--| Lean quotient primitive `Quot.ind`.
term quot_ind (u: lvl): expr;
-- lean0-check: end

axiom closed_quot (k: nat) (u: lvl): $ closed k (quot u) $;
axiom closed_quot_mk (k: nat) (u: lvl): $ closed k (quot_mk u) $;
axiom closed_quot_lift (k: nat) (u v: lvl): $ closed k (quot_lift u v) $;
axiom closed_quot_ind (k: nat) (u: lvl): $ closed k (quot_ind u) $;

--| Lean's `Nat`, `Nat.zero` and `Nat.succ`.
def nat_ty: expr = $ ind_ty nat_D 0 $;
prefix nat_ty: $ℕ$ prec max;
def nat_zero: expr = $ ind_ctor nat_D 0 0 $;
def nat_succ: expr = $ ind_ctor nat_D 0 1 $;

-- Occurrences of the block (`isValidIndApp`, `checkPositivity`, `isRecArg`) ---

--| `sinst D j n k e e2`: `e2` is `e` with the variables `#k .. #(k+n-j-1)`
--| replaced by `ind_ty D j .. ind_ty D (n-1)` (the block's types, which are
--| closed).
term sinst: ind > nat > nat > nat > expr > expr > wff;
axiom sinst_done (D: ind) (n k: nat) (e: expr): $ sinst D n n k e e $;
axiom sinst_step (D: ind) (j n k: nat) (e e1 e2: expr):
  $ j < n $ > $ inst k e (ind_ty D j) e1 $ > $ sinst D (s j) n k e1 e2 $ > $ sinst D j n k e e2 $;
--| `iargs k m X A`: `A` is `X` applied to `m` arguments, each `closed k`.
term iargs: nat > nat > expr > expr > wff;
axiom iargs_z (k: nat) (X: expr): $ iargs k 0 X X $;
axiom iargs_s (k m: nat) (X A a: expr): $ iargs k m X A $ > $ closed k a $ > $ iargs k (s m) X (A @ a) $;
--| `indapp D n np d A j`: at depth `d`, `A` is type `j` of the block applied
--| to the parameters and to its indices, which do not mention the block
--| (`isValidIndApp`).
term indapp: ind > nat > nat > nat > expr > nat > wff;
axiom indapp_i (D: ind) (n np d j k t m na: nat) (X A: expr):
  $ spine #t A na $ > $ add d np k $ > $ add k j t $ > $ j < n $ > $ pargs #t d np X $ > $ nidx D j m $ >
  $ iargs k m X A $ > $ indapp D n np d A j $;
--| `ipos D n np d A`: `A` is a positive field type at depth `d`: no occurrence
--| of the block, or `Π` over a domain without one, or a valid occurrence
--| (`checkPositivity`). `recfield D n np d A j`: `A` is a recursive field
--| (`Π ys. ` a valid occurrence of type `j`; `isRecArg`).
term ipos: ind > nat > nat > nat > expr > wff;
axiom ipos_closed (D: ind) (n np d k: nat) (A: expr): $ add d np k $ > $ closed k A $ > $ ipos D n np d A $;
axiom ipos_pi (D: ind) (n np d k: nat) (A B: expr):
  $ add d np k $ > $ closed k A $ > $ ipos D n np (s d) B $ > $ ipos D n np d (Π A. B) $;
axiom ipos_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ ipos D n np d A $;
term recfield: ind > nat > nat > nat > expr > nat > wff;
axiom recfield_pi (D: ind) (n np d j: nat) (A B: expr):
  $ recfield D n np (s d) B j $ > $ recfield D n np d (Π A. B) j $;
axiom recfield_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ recfield D n np d A j $;

-- Nested occurrences (`ElimNestedInductive`): restoring and specializing ---

--| `rst D N e e2`: `e2` is `e` with the auxiliary types and constructors
--| restored: nothing when there are no occurrences (`rst_nil`), else from
--| the outside in, `rst_refl` for the subterms left as they are (the clauses
--| are tried in this order, so that an unknown `e2` is computed).
term rst: ind > ctx > expr > expr > wff;
axiom rst_nil (D: ind) (e: expr): $ rst D [] e e $;
axiom rst_ty (D: ind) (N: ctx) (j np n m na k: nat) (e S X X1 X2 e2: expr):
  $ spine (ind_ty D j) e na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ >
  $ add np k na $ > $ spine S e k $ > $ pinst 0 S X1 X2 $ > $ rehead S X2 k e e2 $ > $ rst D N e e2 $;
axiom rst_ctor (D I: ind) (N: ctx) (j c i np n m na k npi: nat) (e S X X1 X2 Y e2: expr):
  $ spine (ind_ctor D j c) e na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ >
  $ add np k na $ > $ spine S e k $ > $ pinst 0 S X1 X2 $ > $ spine (ind_ty I i) X2 npi $ >
  $ rehead (ind_ty I i) (ind_ctor I i c) npi X2 Y $ > $ rehead S Y k e e2 $ > $ rst D N e e2 $;
axiom rst_app (D: ind) (N: ctx) (f a f2 a2: expr): $ rst D N f f2 $ > $ rst D N a a2 $ > $ rst D N (f @ a) (f2 @ a2) $;
axiom rst_lam (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (λ A. b) (λ A2. b2) $;
axiom rst_pi (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (Π A. b) (Π A2. b2) $;
axiom rst_proj (D: ind) (N: ctx) (b: blk) (i: nat) (e e2: expr): $ rst D N e e2 $ > $ rst D N (proj b i e) (proj b i e2) $;
axiom rst_refl (D: ind) (N: ctx) (e: expr): $ rst D N e e $;
term nst_hit: ctx > nat > nat > nat > expr > expr > wff;
--| `nst_hit N j d np e e2`: `e` is an occurrence of `N` (the first entry being
--| auxiliary type `j`) lifted to depth `d` and applied to more arguments,
--| and `e2` its replacement. The entries are tried in order: the first
--| clause fails as a whole when the entry is not `e`'s.
axiom nst_hit_z (X S Y e e2: expr) (N: ctx) (I: ind) (i j d np na npi r a t: nat):
  $ spine (ind_ty I i) X npi $ > $ spine (ind_ty I i) e na $ > $ add npi r na $ > $ lift d 0 X S $ > $ spine S e r $ >
  $ add np j a $ > $ add d a t $ > $ pargs #t d np Y $ > $ rehead S Y r e e2 $ > $ nst_hit (X :: N) j d np e e2 $;
axiom nst_hit_s (X e e2: expr) (N: ctx) (j d np: nat): $ nst_hit N (s j) d np e e2 $ > $ nst_hit (X :: N) j d np e e2 $;
--| `spz D N d e e2`: `e2` is `e` (at depth `d` in a constructor type) with
--| each occurrence `I Ds is` of `N` replaced by its auxiliary type
--| `#(d + np + j)` applied to the block's parameters and to `is`
--| (`replaceAllNested`: from the outside in, so `is` stay as they are).
term spz: ind > ctx > nat > expr > expr > wff;
axiom spz_refl (D: ind) (N: ctx) (d: nat) (e: expr): $ spz D N d e e $;
axiom spz_hit (D: ind) (N: ctx) (d np n m n0: nat) (e e2: expr):
  $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ nst_hit N n0 d np e e2 $ > $ spz D N d e e2 $;
axiom spz_app (D: ind) (N: ctx) (d: nat) (f a f2 a2: expr): $ spz D N d f f2 $ > $ spz D N d a a2 $ > $ spz D N d (f @ a) (f2 @ a2) $;
axiom spz_lam (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (λ A. b) (λ A2. b2) $;
axiom spz_pi (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (Π A. b) (Π A2. b2) $;
axiom spz_proj (D: ind) (N: ctx) (d: nat) (b: blk) (i: nat) (e e2: expr): $ spz D N d e e2 $ > $ spz D N d (proj b i e) (proj b i e2) $;
--| `afree e`: `e` mentions no auxiliary type and no constructor of one: at
--| `ind_ty D j` and `ind_ctor D j c` the number `j` is one of `D`'s declared
--| types. Lean's terms are such; `spz_ctors` requires it of a restored
--| constructor, which makes the restoration unique (`rst` alone may leave
--| any subterm as it is).
term afree: expr > wff;
axiom afree_bvar (i: nat): $ afree #i $;
axiom afree_srt (l: lvl): $ afree (srt l) $;
axiom afree_app (f a: expr): $ afree f $ > $ afree a $ > $ afree (f @ a) $;
axiom afree_lam (A b: expr): $ afree A $ > $ afree b $ > $ afree (λ A. b) $;
axiom afree_pi (A b: expr): $ afree A $ > $ afree b $ > $ afree (Π A. b) $;
axiom afree_cst (a: atom) (S: lvls): $ afree (cst a S) $;
axiom afree_lit (n: bin): $ afree (lit n) $;
axiom afree_ind_ty (D: ind) (N: ctx) (j np n m n0: nat):
  $ ind_nested D N $ > $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ j < n0 $ > $ afree (ind_ty D j) $;
axiom afree_ind_ctor (D: ind) (N: ctx) (j c np n m n0: nat):
  $ ind_nested D N $ > $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ j < n0 $ > $ afree (ind_ctor D j c) $;
axiom afree_ind_rec (D: ind) (i: nat) (v: lvl): $ afree (ind_rec D i v) $;
axiom afree_proj (b: blk) (i: nat) (e: expr): $ afree e $ > $ afree (proj b i e) $;
axiom afree_quot (u: lvl): $ afree (quot u) $;
axiom afree_quot_mk (u: lvl): $ afree (quot_mk u) $;
axiom afree_quot_lift (u v: lvl): $ afree (quot_lift u v) $;
axiom afree_quot_ind (u: lvl): $ afree (quot_ind u) $;
--| `spz_ctors D N I X ni npi C C2`: `C2` is the constructors `C` of a type of
--| `I` at the occurrence `X`, specialized: `I`'s types put in, `I`'s own
--| occurrences restored (it may be nested itself), the parameters replaced
--| by `Ds` (`pinst`), then `spz`.
term spz_ctors: ind > ctx > ind > expr > nat > nat > ctors > ctors > wff;
axiom spz_ctors_nil (D: ind) (N: ctx) (I: ind) (X: expr) (ni npi: nat): $ spz_ctors D N I X ni npi cnil cnil $;
axiom spz_ctors_cons (D I: ind) (N NI: ctx) (X K K1 K2 K3 K4: expr) (ni npi: nat) (C C2: ctors):
  $ sinst I 0 ni npi K K1 $ > $ ind_nested I NI $ > $ rst I NI K1 K2 $ > $ afree K2 $ > $ pinst 0 X K2 K3 $ >
  $ spz D N 0 K3 K4 $ >
  $ spz_ctors D N I X ni npi C C2 $ > $ spz_ctors D N I X ni npi (ccons K C) (ccons K4 C2) $;
--| `aux_data D I X j i`: type `j` of `D` has the type of `I`'s type `i` at
--| `X`'s arguments and its constructors specialized.
term aux_data: ind > ind > expr > nat > nat > wff;
axiom aux_data_i (D I: ind) (b bi: blk) (P Pi N: ctx) (T Ti: tys) (j i npi ni mi: nat) (X F Fi: expr) (C Ci: ctors):
  $ ind_data D b P T $ > $ ind_nested D N $ > $ ind_data I bi Pi Ti $ > $ nth_ty T j F C $ > $ nth_ty Ti i Fi Ci $ >
  $ pinst 0 X Fi F $ > $ ind_arity I npi ni mi $ > $ spz_ctors D N I X ni npi Ci C $ > $ aux_data D I X j i $;

-- The recursor's type (`mkRecInfos`) ---------------------------------------

--| `mty D np j d v F M`: `M` is the type of motive `j`, read off `F` (the
--| type's type lifted over the `j` earlier motives) at depth `d`:
--| `Π indices. Π (ind_ty D j params indices). srt v`.
term mty: ind > nat > nat > nat > lvl > expr > expr > wff;
axiom mty_pi (D: ind) (np j d: nat) (v: lvl) (A B M: expr):
  $ mty D np j (s d) v B M $ > $ mty D np j d v (Π A. B) (Π A. M) $;
axiom mty_srt (D: ind) (np j d k: nat) (v l: lvl) (X I: expr):
  $ add d j k $ > $ pargs (ind_ty D j) k np X $ > $ pargs X 0 d I $ > $ mty D np j d v (srt l) (Π I. srt v) $;
--| `motives D np v j T M`: the motives of the types `j`.. of `T`, as a context
--| (innermost first; motive `j` outermost).
term motives: ind > nat > lvl > nat > tys > ctx > wff;
axiom motives_nil (D: ind) (np j: nat) (v: lvl): $ motives D np v j tnil [] $;
axiom motives_cons (D: ind) (np j: nat) (v: lvl) (F F2 Mj: expr) (C: ctors) (T: tys) (Mr M: ctx):
  $ lift j 0 F F2 $ > $ mty D np j 0 v F2 Mj $ > $ motives D np v (s j) T Mr $ > $ capp Mr (Mj :: []) M $ >
  $ motives D np v j (tcons F C T) M $;
--| `ihty D np n mo fld y j A IH`: the type of the inductive hypothesis for a
--| recursive field on type `j` (`recfield`'s), of type `A = Π ys. ind_ty D j params indices` (`A` already
--| over the fields and the minors before it): `Π ys. motive_j indices (field
--| ys)`, with the motives `mo` binders above depth 0 and the field at `#fld`.
term ihty: ind > nat > nat > nat > nat > nat > nat > expr > expr > wff;
axiom ihty_pi (D: ind) (np n mo fld y j: nat) (A B IH: expr):
  $ ihty D np n mo fld (s y) j B IH $ > $ ihty D np n mo fld y j (Π A. B) (Π A. IH) $;
axiom ihty_app (D: ind) (np n mo fld y j ni k a b mj f: nat) (Y X U A: expr):
  $ spine (ind_ty D j) A k $ > $ nidx D j ni $ > $ add np ni k $ > $ rehead Y #mj ni A X $ > $ spine (ind_ty D j) Y np $ >
  $ add y mo a $ > $ add a n b $ > $ add mj (s j) b $ > $ add y fld f $ > $ pargs #f 0 y U $ >
  $ ihty D np n mo fld y j A (X @ U) $;
--| `mwalk D np n k i c nf d r Ihs K Min`: `Min` is the rest of the type of
--| minor `k` (for constructor `c` of type `i`, with `nf` fields), read off
--| the constructor type `K` at depth `d`, after `r` recursive fields whose
--| inductive hypotheses are `Ihs` (innermost first): `Π fields. Π Ihs. motive_i indices
--| (ind_ctor D i c params fields)`. Field types are put over the minors and
--| motives (`lift`, with the block's types put in).
term mwalk: ind > nat > nat > nat > nat > nat > nat > nat > nat > ctx > expr > expr > wff;
axiom mwalk_pi_nr (D: ind) (np n k i c nf d r dp kn: nat) (Ihs: ctx) (A A3 B Min: expr):
  $ add d np dp $ > $ closed dp A $ > $ add k n kn $ > $ lift kn d A A3 $ >
  $ mwalk D np n k i c nf (s d) r Ihs B Min $ > $ mwalk D np n k i c nf d r Ihs (Π A. B) (Π A3. Min) $;
axiom mwalk_pi_rec (D: ind) (np n k i c nf d r dp kn j a sh fld mo: nat) (Ihs: ctx) (A A2 A3 A4 B IH Min: expr):
  $ add d np dp $ > $ recfield D n np d A j $ > $ sinst D 0 n dp A A2 $ > $ add k n kn $ > $ lift kn d A2 A3 $ >
  $ add r nf a $ > $ add sh d a $ > $ add fld 1 sh $ > $ add a k mo $ > $ lift sh 0 A3 A4 $ >
  $ ihty D np n mo fld 0 j A4 IH $ >
  $ mwalk D np n k i c nf (s d) (s r) (IH :: Ihs) B Min $ > $ mwalk D np n k i c nf d r Ihs (Π A. B) (Π A3. Min) $;
axiom mwalk_res (D: ind) (np n k i c d r dp kn h0 h1 h ni mi a b: nat) (Ihs: ctx) (K K2 K3 Y X Y1 Y2 Min: expr):
  $ add d np dp $ > $ add k n kn $ > $ add dp i h0 $ > $ add h0 kn h1 $ > $ add h1 r h $ >
  $ lift kn d K K2 $ > $ lift r 0 K2 K3 $ > $ nidx D i ni $ > $ rehead Y #mi ni K3 X $ > $ spine #h Y np $ >
  $ add r d a $ > $ add a kn b $ > $ add mi (s i) b $ > $ pargs (ind_ctor D i c) b np Y1 $ > $ pargs Y1 r d Y2 $ >
  $ pis Ihs (X @ Y2) Min $ > $ mwalk D np n k i c d d r Ihs K Min $;
--| `cminors D np n k i c C M`: the minors of constructors `c`.. (`C`) of type
--| `i`, from minor `k`; `minors D np n k i T M`: of types `i`.. (`T`). Both
--| as contexts, innermost first.
term cminors: ind > nat > nat > nat > nat > nat > ctors > ctx > wff;
axiom cminors_nil (D: ind) (np n k i c: nat): $ cminors D np n k i c cnil [] $;
axiom cminors_cons (D: ind) (np n k i c nf: nat) (K Min: expr) (C: ctors) (M1 M: ctx):
  $ npis K nf $ > $ mwalk D np n k i c nf 0 0 [] K Min $ > $ cminors D np n (s k) i (s c) C M1 $ >
  $ capp M1 (Min :: []) M $ > $ cminors D np n k i c (ccons K C) M $;
term minors: ind > nat > nat > nat > nat > tys > ctx > wff;
axiom minors_nil (D: ind) (np n k i: nat): $ minors D np n k i tnil [] $;
axiom minors_cons (D: ind) (np n k i nc k2: nat) (F: expr) (C: ctors) (T: tys) (M1 M2 M: ctx):
  $ cminors D np n k i 0 C M1 $ > $ clen_c C nc $ > $ add k nc k2 $ > $ minors D np n k2 (s i) T M2 $ >
  $ capp M2 M1 M $ > $ minors D np n k i (tcons F C T) M $;
--| `rtail D np n m i d F B`: `B = Π indices. Π (ind_ty D i params indices).
--| motive_i indices major`, read off `F` (lifted over the motives and
--| minors) at depth `d`.
term rtail: ind > nat > nat > nat > nat > nat > expr > expr > wff;
axiom rtail_pi (D: ind) (np n m i d: nat) (A B B2: expr):
  $ rtail D np n m i (s d) B B2 $ > $ rtail D np n m i d (Π A. B) (Π A. B2) $;
axiom rtail_srt (D: ind) (np n m i d mn dmn mi: nat) (l: lvl) (X I X2: expr):
  $ add m n mn $ > $ add d mn dmn $ > $ pargs (ind_ty D i) dmn np X $ > $ pargs X 0 d I $ >
  $ add mi i dmn $ > $ pargs #mi 1 d X2 $ > $ rtail D np n m i d (srt l) (Π I. X2 @ #0) $;
--| `rec_ty D v i R`: the type of the recursor of type `i` with motives in
--| `srt v`: `Π params. Π motives. Π minors. Π indices. Π major. motive_i
--| indices major`.
term rec_ty: ind > lvl > nat > expr > wff;
axiom rec_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i np n m mn: nat) (M N: ctx) (F F2 B R1 R2 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v 0 T M $ > $ minors D np n 0 0 T N $ >
  $ nth_ty T i F C $ > $ add m n mn $ > $ lift mn 0 F F2 $ > $ rtail D np n m i 0 F2 B $ >
  $ pis N B R1 $ > $ pis M R1 R2 $ > $ pis P R2 R $ > $ rec_ty D v i R $;
--| `ctor_ty D i c R`: the type of constructor `c` of type `i`: `Π params.` its
--| data type with the block's types applied to the parameters for the type
--| variables (`sinst`), restored (`rst`).
term ctor_ty: ind > nat > nat > expr > wff;
axiom ctor_ty_i (D: ind) (b: blk) (P N: ctx) (T: tys) (i c np n m: nat) (F K K2 K3 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ clen P np $ > $ ntys T n m $ >
  $ sinst D 0 n np K K2 $ > $ ind_nested D N $ > $ rst D N K2 K3 $ > $ pis P K3 R $ > $ ctor_ty D i c R $;

-- The recursor's rules (`mkRecRules`) --------------------------------------

--| `ihval D np n m v nf fld y j A IH`: the inductive hypothesis of a recursive
--| field on type `j` (`recfield`'s): `λ ys. ind_rec D j v params motives minors indices (field ys)`, read
--| off the field's type `A` (over all `nf` fields, the field at `#fld`).
term ihval: ind > nat > nat > nat > lvl > nat > nat > nat > nat > expr > expr > wff;
axiom ihval_lam (D: ind) (np n m: nat) (v: lvl) (nf fld y j: nat) (A B IH: expr):
  $ ihval D np n m v nf fld (s y) j B IH $ > $ ihval D np n m v nf fld y j (Π A. B) (λ A. IH) $;
axiom ihval_app (D: ind) (np n m: nat) (v: lvl) (nf fld y j ni k a mn b f: nat) (Y X1 X2 X3 U A: expr):
  $ spine (ind_ty D j) A k $ > $ nidx D j ni $ > $ add np ni k $ > $ rehead Y X2 ni A X3 $ > $ spine (ind_ty D j) Y np $ >
  $ add y nf a $ > $ add m n mn $ > $ add a mn b $ > $ pargs (ind_rec D j v) b np X1 $ > $ pargs X1 a mn X2 $ >
  $ add y fld f $ > $ pargs #f 0 y U $ > $ ihval D np n m v nf fld y j A (X3 @ U) $;
--| `rwalk D np n m v nf d Acc K Val`: `Val = λ fields. Acc ihs`, read off the
--| constructor type `K` at depth `d`, where `Acc` is the minor applied to
--| the fields and `ihs` the inductive hypotheses of the recursive fields.
term rwalk: ind > nat > nat > nat > lvl > nat > nat > expr > expr > expr > wff;
axiom rwalk_pi_nr (D: ind) (np n m: nat) (v: lvl) (nf d dp mn: nat) (Acc A A3 B Val: expr):
  $ add d np dp $ > $ closed dp A $ > $ add m n mn $ > $ lift mn d A A3 $ >
  $ rwalk D np n m v nf (s d) Acc B Val $ > $ rwalk D np n m v nf d Acc (Π A. B) (λ A3. Val) $;
axiom rwalk_pi_rec (D: ind) (np n m: nat) (v: lvl) (nf d dp mn j sh fld: nat) (Acc A A2 A3 A4 B IH Val: expr):
  $ add d np dp $ > $ recfield D n np d A j $ > $ sinst D 0 n dp A A2 $ > $ add m n mn $ > $ lift mn d A2 A3 $ >
  $ add sh d nf $ > $ add fld 1 sh $ > $ lift sh 0 A3 A4 $ > $ ihval D np n m v nf fld 0 j A4 IH $ >
  $ rwalk D np n m v nf (s d) (Acc @ IH) B Val $ > $ rwalk D np n m v nf d Acc (Π A. B) (λ A3. Val) $;
axiom rwalk_res (D: ind) (np n m: nat) (v: lvl) (d: nat) (Acc K: expr):
  $ npis K 0 $ > $ rwalk D np n m v d d Acc K Acc $;
--| `rec_rhs D v i c R`: the right-hand side of the recursor's rule for
--| constructor `c` of type `i`: `λ params. λ motives. λ minors. λ fields.
--| minor_k fields ihs`.
term rec_rhs: ind > lvl > nat > nat > expr > wff;
axiom rec_rhs_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i c np n m k nf a mk: nat) (M N: ctx) (F K Acc Val R1 R2 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v 0 T M $ > $ minors D np n 0 0 T N $ >
  $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ minor_idx T i c k $ > $ npis K nf $ >
  $ add nf m a $ > $ add mk (s k) a $ > $ pargs #mk 0 nf Acc $ > $ rwalk D np n m v nf 0 Acc K Val $ >
  $ lams N Val R1 $ > $ lams M R1 R2 $ > $ lams P R2 R $ > $ rec_rhs D v i c R $;

-- Structures: fields, projections and eta ----------------------------------

--| `struct_like D j`: type `j` has one constructor and no indices (the kernel's
--| `is_structure_like`; a type of a mutual block may qualify).
term struct_like: ind > nat > wff;
axiom struct_like_i (D: ind) (b: blk) (P: ctx) (T: tys) (j: nat) (F K: expr) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ isort F 0 l $ > $ struct_like D j $;
--| `field_ty D j i A`: the type of field `i` of the constructor of type `j`,
--| under the parameters and the earlier fields, with the block's types put in.
term field_ty: ind > nat > nat > expr > wff;
axiom field_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K K2 A: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T j F C $ > $ nth_ctor C 0 K $ > $ clen P np $ > $ ntys T n m $ >
  $ sinst D 0 n np K K2 $ > $ nth_pi K2 i A $ > $ field_ty D j i A $;
--| `qinst b e k j A R`: `R` is `A` with the `k` remaining fields `j`,
--| `j+1`, ... (field `j` at `#(k-1)`) replaced by the projections of `e`.
term qinst: blk > expr > nat > nat > expr > expr > wff;
axiom qinst_z (b: blk) (e A: expr) (j: nat): $ qinst b e 0 j A A $;
axiom qinst_s (b: blk) (e A A1 R: expr) (k j: nat):
  $ inst k A (proj b j e) A1 $ > $ qinst b e k (s j) A1 R $ > $ qinst b e (s k) j A R $;
--| Structure eta is for a structure whose fields do not mention the block
--| (`nonrec`, `eta_ok`); `projs b e k Y M`: `M = Y @ proj b 0 e @ .. @ proj b (k-1) e`.
term nonrec: nat > nat > expr > wff;
axiom nonrec_pi (np d k: nat) (A B: expr): $ add d np k $ > $ closed k A $ > $ nonrec np (s d) B $ > $ nonrec np d (Π A. B) $;
axiom nonrec_res (np d: nat) (K: expr): $ npis K 0 $ > $ nonrec np d K $;
term eta_ok: ind > nat > wff;
axiom eta_ok_i (D: ind) (b: blk) (P: ctx) (T: tys) (j np: nat) (F K: expr):
  $ struct_like D j $ > $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ clen P np $ > $ nonrec np 0 K $ >
  $ eta_ok D j $;
term projs: blk > expr > nat > expr > expr > wff;
axiom projs_z (b: blk) (e Y: expr): $ projs b e 0 Y Y $;
axiom projs_s (b: blk) (e Y M: expr) (k: nat): $ projs b e k Y M $ > $ projs b e (s k) Y (M @ proj b k e) $;

---------------------------------------------------------------------------
-- PART II: DEFINITIONS OVER LEVEL EQUIVALENCE AND THE JUDGMENT
-- The relations `≈` and `⊢` (their axioms are Part III), and the predicates
-- defined over them by clauses as in Part I: a typing or equivalence premise
-- is a side condition of the clause.
---------------------------------------------------------------------------

-- Level equivalence (VLevel.lean:58) ---------------------------------------

--| `leqv l l2`: `l ≈ l2`, semantic equivalence of levels (VLevel.lean:58:
--| equal evaluation under every assignment of the level variables, including
--| the `lparam`s). Its axioms are in Part III.
term leqv: lvl > lvl > wff;
infixl leqv: $~=$ prec 50;
infixl leqv: $≈$ prec 50;

--| `ulevel l s`: a field in `srt s` may belong to a type in `srt l`: the type
--| is a proposition, or `s ≤ l`.
term ulevel: lvl > lvl > wff;
axiom ulevel_prop (l u: lvl): $ l ≈ lz $ > $ ulevel l u $;
axiom ulevel_le (l u: lvl): $ l ⊔ u ≈ l $ > $ ulevel l u $;

-- The judgment `Γ ⊢ e ≡ e2 : A` (IsDefEq, Typing/Basic.lean:18-56) ---------

--| The judgment `Γ ⊢ e ≡ e2 : A` (IsDefEq, Typing/Basic.lean:18-56). Its
--| rules are in Part III.
term deq: ctx > expr > expr > expr > wff;
notation deq (G: ctx) (e e2 A: expr): wff = ($[[$:0) G ($|-$:0) e ($==$:0) e2 ($:$:0) A ($]]$:0);
notation deq (G: ctx) (e e2 A: expr): wff = ($⟦$:0) G ($⊢$:0) e ($≡$:0) e2 ($:$:0) A ($⟧$:0);

--| `Γ ⊢ e : A` is the diagonal of the judgment.
def ty (G: ctx) (e A: expr): wff = $ ⟦ G ⊢ e ≡ e : A ⟧ $;
notation ty (G: ctx) (e A: expr): wff = ($<<$:0) G ($|-$:0) e ($:$:0) A ($>>$:0);
notation ty (G: ctx) (e A: expr): wff = ($⟨$:0) G ($⊢$:0) e ($:$:0) A ($⟩$:0);

-- Typed application spines -------------------------------------------------

--| `sty G h A e T`: `e` is the head `h` applied to arguments, each typed at
--| its binder's type in the telescope `A` (instantiated with the arguments
--| before it, with no conversion between the steps), and `T` is what is left
--| of `A` after the last one. The reduction rules of the recursors and of the
--| quotient primitives (Part III) take this premise, with the head's own type
--| as `A`, rather than a typing of their whole left side: that the arguments
--| are in the head's domain is then stated, not read off a derivation by
--| inversion (audit §4).
term sty: ctx > expr > expr > expr > expr > wff;
axiom sty_nil (G: ctx) (h A: expr): $ sty G h A h A $;
axiom sty_app (G: ctx) (h A f a B C C2: expr):
  $ sty G h A f (Π B. C) $ > $ ⟨ G ⊢ a : B ⟩ $ > $ inst 0 C a C2 $ > $ sty G h A (f @ a) C2 $;
--| `aeq G e e2`: `e` and `e2` are one head applied to arguments that are
--| definitionally equal one by one. The iota rules compare the type of the
--| major premise's constructor application with the recursor's this way: an
--| equation of the two types as wholes would not give the arguments' (it is
--| the injectivity of the type, which the rules do not assume; audit §4).
term aeq: ctx > expr > expr > wff;
axiom aeq_nil (G: ctx) (h: expr): $ aeq G h h $;
axiom aeq_app (G: ctx) (f f2 a a2 A: expr):
  $ aeq G f f2 $ > $ ⟦ G ⊢ a ≡ a2 : A ⟧ $ > $ aeq G (f @ a) (f2 @ a2) $;

-- Level equivalence of expressions -----------------------------------------

--| `eeqv e e2`: `e` and `e2` agree except at levels, which are equivalent.
--| Two such expressions denote the same thing, so `e ≡ e2` (`eeqv_df`, Part
--| III). `eeqv_refl` covers every identical subterm (an opaque constant at the
--| same levels among them).
term eeqv: expr > expr > wff;
axiom eeqv_refl (e: expr): $ eeqv e e $;
term ind_eqv: ind > ind > wff;
term ceqv: ctx > ctx > wff;
term teqv: tys > tys > wff;
term cseqv: ctors > ctors > wff;
axiom eeqv_bvar (i: nat): $ eeqv #i #i $;
axiom eeqv_srt (l l2: lvl): $ l ≈ l2 $ > $ eeqv (srt l) (srt l2) $;
axiom eeqv_app (f a f2 a2: expr): $ eeqv f f2 $ > $ eeqv a a2 $ > $ eeqv (f @ a) (f2 @ a2) $;
axiom eeqv_lam (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (λ A. b) (λ A2. b2) $;
axiom eeqv_pi (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (Π A. b) (Π A2. b2) $;
axiom eeqv_lit (n: bin): $ eeqv (lit n) (lit n) $;
--| `lseqv S S2`: the level lists are equivalent entry by entry.
term lseqv: lvls > lvls > wff;
axiom lseqv_nil: $ lseqv lnil lnil $;
axiom lseqv_cons (l l2: lvl) (S S2: lvls): $ l ≈ l2 $ > $ lseqv S S2 $ > $ lseqv (lcons l S) (lcons l2 S2) $;
axiom eeqv_cst (a: atom) (S S2: lvls): $ lseqv S S2 $ > $ eeqv (cst a S) (cst a S2) $;
axiom eeqv_ind_ty (D D2: ind) (i: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ty D i) (ind_ty D2 i) $;
axiom eeqv_ind_ctor (D D2: ind) (i c: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ctor D i c) (ind_ctor D2 i c) $;
axiom eeqv_ind_rec (D D2: ind) (i: nat) (v v2: lvl):
  $ ind_eqv D D2 $ > $ v ≈ v2 $ > $ eeqv (ind_rec D i v) (ind_rec D2 i v2) $;
axiom eeqv_proj (b: blk) (i: nat) (e e2: expr): $ eeqv e e2 $ > $ eeqv (proj b i e) (proj b i e2) $;
axiom eeqv_quot (u u2: lvl): $ leqv u u2 $ > $ eeqv (quot u) (quot u2) $;
axiom eeqv_quot_mk (u u2: lvl): $ leqv u u2 $ > $ eeqv (quot_mk u) (quot_mk u2) $;
axiom eeqv_quot_lift (u v u2 v2: lvl):
  $ leqv u u2 $ > $ leqv v v2 $ > $ eeqv (quot_lift u v) (quot_lift u2 v2) $;
axiom eeqv_quot_ind (u u2: lvl): $ leqv u u2 $ > $ eeqv (quot_ind u) (quot_ind u2) $;
axiom ind_eqv_i (D D2: ind) (b: blk) (P P2 N N2: ctx) (T T2: tys):
  $ ind_data D b P T $ > $ ind_data D2 b P2 T2 $ > $ ceqv P P2 $ > $ teqv T T2 $ >
  $ ind_nested D N $ > $ ind_nested D2 N2 $ > $ ceqv N N2 $ > $ ind_eqv D D2 $;
axiom ceqv_nil: $ ceqv [] [] $;
axiom ceqv_cons (A A2: expr) (G G2: ctx): $ eeqv A A2 $ > $ ceqv G G2 $ > $ ceqv (A :: G) (A2 :: G2) $;
axiom teqv_nil: $ teqv tnil tnil $;
axiom teqv_cons (F F2: expr) (C C2: ctors) (T T2: tys):
  $ eeqv F F2 $ > $ cseqv C C2 $ > $ teqv T T2 $ > $ teqv (tcons F C T) (tcons F2 C2 T2) $;
axiom cseqv_nil: $ cseqv cnil cnil $;
axiom cseqv_cons (K K2: expr) (C C2: ctors): $ eeqv K K2 $ > $ cseqv C C2 $ > $ cseqv (ccons K C) (ccons K2 C2) $;

-- Well-formedness of an inductive block ------------------------------------
-- `checkInductiveTypes` and `checkConstructors`; for a nested block, `nst_ok`:
-- the occurrences come in groups, one per declared type of a well-formed block
-- `I`, each auxiliary type with `I`'s data specialized.

--| `cwf D n np l i Ctx d K`: `K`, the rest of a constructor type of type `i`
--| at depth `d`, is well formed in `Ctx` (the fields so far, with the block's
--| types put in, over the parameters and `G`): each field type is a type of
--| an allowed level and positive, a recursive field (`cwf_pi_rec`) is not
--| mentioned in the rest of the type, and the result is type `i` applied to
--| the parameters and indices, each argument typed at its binder's type in
--| type `i`'s type (`checkConstructors`, whose `checkType` of the whole
--| constructor type types the indices). The kernel's typing implies that a
--| recursive field is not mentioned later (a term mentioning a field of type
--| `T` mentions `T`, which neither a positive field's domain nor an index may
--| do); the model sees only that the typings hold, not that they are
--| derivable, so the spec states it (`#0` does not occur in `B` when `B` is
--| the lift of something: the `inst` premise only computes that).
term cwf: ind > nat > nat > lvl > nat > ctx > nat > expr > wff;
axiom cwf_pi (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2: expr) (u: lvl):
  $ add d np k $ > $ closed k A $ > $ sinst D 0 n k A A2 $ > $ ⟨ Ctx ⊢ A2 : srt u ⟩ $ > $ ulevel l u $ >
  $ cwf D n np l i (A2 :: Ctx) (s d) B $ > $ cwf D n np l i Ctx d (Π A. B) $;
axiom cwf_pi_rec (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2 B2: expr) (u: lvl):
  $ add d np k $ > $ sinst D 0 n k A A2 $ > $ ⟨ Ctx ⊢ A2 : srt u ⟩ $ > $ ulevel l u $ > $ ipos D n np d A $ >
  $ inst 0 B (srt lz) B2 $ > $ lift 1 0 B2 B $ >
  $ cwf D n np l i (A2 :: Ctx) (s d) B $ > $ cwf D n np l i Ctx d (Π A. B) $;
axiom cwf_res (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (K K2: expr) (b: blk) (P: ctx)
    (T: tys) (F: expr) (C: ctors) (R R2 S: expr):
  $ indapp D n np d K i $ > $ add d np k $ > $ sinst D 0 n k K K2 $ > $ ind_data D b P T $ > $ nth_ty T i F C $ >
  $ pis P F R $ > $ lift k 0 R R2 $ > $ sty Ctx (ind_ty D i) R2 K2 S $ > $ cwf D n np l i Ctx d K $;
--| `ctors_wf D n np l i Ctx C`: the constructors `C` of type `i` are well
--| formed, and each is closed over the parameters and the types (`Π P. K`
--| mentions only the `n` types: a constructor is a closed constant, as
--| `tys_closed` for the types' types).
term ctors_wf: ind > nat > nat > lvl > nat > ctx > ctors > wff;
axiom ctors_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ ctors_wf D n np l i Ctx cnil $;
axiom ctors_wf_cons (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (K: expr) (C: ctors) (b: blk) (P: ctx)
    (T: tys) (R: expr):
  $ ind_data D b P T $ > $ pis P K R $ > $ closed n R $ >
  $ cwf D n np l i Ctx 0 K $ > $ ctors_wf D n np l i Ctx C $ > $ ctors_wf D n np l i Ctx (ccons K C) $;
--| `tys_wf D n np l i Ctx T`: the types `i`.. of `T`, in `Ctx = P ++ G`: each
--| type's type is `Π indices. srt l` (all in the same universe `l`,
--| `checkInductiveTypes`) and its constructors are well formed.
term tys_wf: ind > nat > nat > lvl > nat > ctx > tys > wff;
axiom tys_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ tys_wf D n np l i Ctx tnil $;
axiom tys_wf_cons (D: ind) (n np: nat) (l l2: lvl) (i k: nat) (Ctx: ctx) (F: expr) (C: ctors) (T: tys):
  $ isort F k l2 $ > $ l2 ≈ l $ > $ ctors_wf D n np l i Ctx C $ > $ tys_wf D n np l (s i) Ctx T $ >
  $ tys_wf D n np l i Ctx (tcons F C T) $;
--| `ctx_wf G P`: each parameter type is a type over the earlier ones.
term ctx_wf: ctx > ctx > wff;
axiom ctx_wf_nil (G: ctx): $ ctx_wf G [] $;
axiom ctx_wf_cons (G P G2: ctx) (A: expr) (u: lvl):
  $ ctx_wf G P $ > $ capp P G G2 $ > $ ⟨ G2 ⊢ A : srt u ⟩ $ > $ ctx_wf G (A :: P) $;
--| `tys_ty Ctx T`: each type's type is binders over a sort (`isort`) and a type
--| in `Ctx = P ++ G`.
term tys_ty: ctx > tys > wff;
axiom tys_ty_nil (Ctx: ctx): $ tys_ty Ctx tnil $;
axiom tys_ty_cons (Ctx: ctx) (F: expr) (C: ctors) (T: tys) (u l: lvl) (k: nat):
  $ isort F k l $ > $ ⟨ Ctx ⊢ F : srt u ⟩ $ > $ tys_ty Ctx T $ > $ tys_ty Ctx (tcons F C T) $;
--| `tys_ok G D`: the parameters and the types' types are closed, the
--| parameters are types over the earlier ones and the types' types are types:
--| what typing `ind_ty D i` needs (the kernel adds the types before it checks
--| the constructors; a block whose constructors are not legal denotes a family
--| of empty types).
term tys_ok: ctx > ind > wff;
axiom tys_ok_i (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys):
  $ ind_data D b P T $ > $ tys_closed P T $ > $ ctx_wf G P $ > $ capp P G G2 $ > $ tys_ty G2 T $ > $ tys_ok G D $;
--| A well-formed block, in context `G` (`ind_wf_i`, after `nst_ok` below).
term ind_wf: ctx > ind > wff;
--| `nst_ok G D j N2`: the occurrences `N2` (from auxiliary type `j` on) come
--| in groups, one per declared type of a well-formed block `I` in order with
--| the same arguments (`nst_group`, types `i` to `ni0`; `I.all` excludes
--| `I`'s own auxiliary types), each with the data of `aux_data` (Part I).
--| `I` declares a type (`0 < ni0`), and a group's arguments are typed
--| (`nst_ty`).
term nst_ok: ctx > ind > nat > ctx > wff;
term nst_group: ctx > ind > ind > expr > nat > nat > nat > ctx > ctx > wff;
--| `nst_ty G D I X`: the arguments of the occurrence `X` of `I`'s first type
--| are typed at `I`'s parameters under the block's (`sty`, with the block's
--| types put in: as in `cwf_res`, a head applied to arguments of other types
--| has no meaning; audit §4). They mention no variable of `G` (`closed`):
--| the block's constants are closed.
term nst_ty: ctx > ind > ind > expr > wff;
axiom nst_ty_i (G G2: ctx) (D I: ind) (b bi: blk) (P Pi: ctx) (T Ti: tys) (np n m: nat) (X X1 Fi RI S: expr) (Ci: ctors):
  $ ind_data D b P T $ > $ capp P G G2 $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ > $ closed np X1 $ >
  $ ind_data I bi Pi Ti $ > $ nth_ty Ti 0 Fi Ci $ > $ pis Pi Fi RI $ > $ sty G2 (ind_ty I 0) RI X1 S $ > $ nst_ty G D I X $;
axiom nst_ok_nil (G: ctx) (D: ind) (j: nat): $ nst_ok G D j [] $;
axiom nst_ok_cons (G: ctx) (D I: ind) (j j2 npi ni mi ni0: nat) (X: expr) (N2 N3 NI: ctx):
  $ spine (ind_ty I 0) X npi $ > $ ind_wf G I $ > $ ind_arity I npi ni mi $ > $ ind_nested I NI $ > $ ndecl NI ni ni0 $ >
  $ 0 < ni0 $ > $ nst_ty G D I X $ >
  $ nst_group G D I X j 0 ni0 (X :: N2) N3 $ > $ add j ni0 j2 $ > $ nst_ok G D j2 N3 $ > $ nst_ok G D j (X :: N2) $;
axiom nst_group_done (G: ctx) (D I: ind) (X0: expr) (j ni: nat) (N: ctx): $ nst_group G D I X0 j ni ni N N $;
axiom nst_group_cons (G: ctx) (D I: ind) (X0 X: expr) (j i ni npi: nat) (N N2: ctx):
  $ i < ni $ > $ spine (ind_ty I 0) X0 npi $ > $ rehead (ind_ty I 0) (ind_ty I i) npi X0 X $ > $ aux_data D I X j i $ >
  $ nst_group G D I X0 (s j) (s i) ni N N2 $ > $ nst_group G D I X0 j i ni (X :: N) N2 $;
--| A well-formed block, in context `G` (`l`, the block's universe, is the first
--| type's).
axiom ind_wf_i (G G2: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (np n m k n0: nat) (l: lvl) (F: expr) (C: ctors):
  $ tys_ok G D $ > $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ >
  $ nth_ty T 0 F C $ > $ isort F k l $ > $ tys_wf D n np l 0 G2 T $ >
  $ ind_nested D N $ > $ ndecl N n n0 $ > $ nst_ok G D n0 N $ > $ ind_wf G D $;

-- The elimination level (`isLargeEliminator`) ------------------------------

--| `elim_ok G D v`: the recursor may have motives in `srt v`: always for
--| `v ≈ 0`; for every `v` when the types are never propositions, or the block
--| is one type with no constructors, or one type with one constructor whose
--| fields that are not propositions all appear as arguments of its result.
term large: ctx > ind > wff;
--| `fir D np Ctx d K`: each remaining field is a proposition or an argument
--| of the result.
term fir: ind > nat > ctx > nat > expr > wff;
term elim_ok: ctx > ind > lvl > wff;
axiom elim_prop (G: ctx) (D: ind) (v: lvl): $ v ≈ lz $ > $ elim_ok G D v $;
axiom elim_large (G: ctx) (D: ind) (v: lvl): $ large G D $ > $ elim_ok G D v $;
axiom large_nz (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (k: nat) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T 0 F C $ > $ isort F k l $ > $ ls lz ⊔ l ≈ l $ > $ large G D $;
axiom large_empty (G: ctx) (D: ind) (b: blk) (P: ctx) (F: expr):
  $ ind_data D b P (tcons F cnil tnil) $ > $ large G D $;
axiom large_single (G G2: ctx) (D: ind) (b: blk) (P: ctx) (F K: expr) (np: nat):
  $ ind_data D b P (tcons F (ccons K cnil) tnil) $ > $ clen P np $ > $ capp P G G2 $ > $ fir D np G2 0 K $ >
  $ large G D $;
--| `fir D np Ctx d K`: each remaining field is a proposition or an argument
--| of the result; `leaf_has j e`: `#j` (at the binder's depth) is an argument
--| of the result under the remaining binders.
axiom fir_res (D: ind) (np: nat) (Ctx: ctx) (d: nat) (K: expr):
  $ indapp D 1 np d K 0 $ > $ fir D np Ctx d K $;
axiom fir_arg (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr):
  $ leaf_has 0 B $ > $ add d np k $ > $ sinst D 0 1 k A A2 $ > $ fir D np (A2 :: Ctx) (s d) B $ >
  $ fir D np Ctx d (Π A. B) $;
axiom fir_prop (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr):
  $ add d np k $ > $ sinst D 0 1 k A A2 $ > $ ⟨ Ctx ⊢ A2 : Prop ⟩ $ > $ fir D np (A2 :: Ctx) (s d) B $ >
  $ fir D np Ctx d (Π A. B) $;

-- Projections from a structure that may be a proposition (`infer_proj`) ----

--| `proj_ok G D j i`: field `i` of type `j` may be projected: the type's sort
--| is at least 1, or the fields up to `i` are all propositions (nanoda's
--| `infer_proj`, which requires only the projected and the dependent ones).
term fprops: ind > nat > nat > ctx > nat > nat > expr > wff;
term proj_ok: ctx > ind > nat > nat > wff;
axiom proj_ok_sort (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i: nat) (F: expr) (C: ctors) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T j F C $ > $ isort F 0 l $ > $ ls lz ⊔ l ≈ l $ > $ proj_ok G D j i $;
axiom proj_ok_prop (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K: expr) (C: ctors):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ > $ nth_ty T j F C $ > $ nth_ctor C 0 K $ >
  $ fprops D n np G2 0 (s i) K $ > $ proj_ok G D j i $;
--| `fprops D n np Ctx d cnt K`: the next `cnt` fields of `K` are propositions.
axiom fprops_z (D: ind) (n np: nat) (Ctx: ctx) (d: nat) (K: expr): $ fprops D n np Ctx d 0 K $;
axiom fprops_s (D: ind) (n np: nat) (Ctx: ctx) (d cnt k: nat) (A A2 B: expr):
  $ add d np k $ > $ sinst D 0 n k A A2 $ > $ ⟨ Ctx ⊢ A2 : Prop ⟩ $ > $ fprops D n np (A2 :: Ctx) (s d) cnt B $ >
  $ fprops D n np Ctx d (s cnt) (Π A. B) $;

-- The defining equations of the literal operations (audit §5) --------------
-- The kernel computes `Nat.add` and the other accelerated operations on
-- literals with GMP. Each `*_eqs` relation states, of a closed function of the
-- right type, the defining equations Lean4Lean checks of the environment's
-- function (`Primitive.lean`), over fresh variables (`#0` and `#1` of
-- type `ℕ`); the rules `nat_*_lit` (Part III) then give the operation's
-- value on literals. A certificate proves the equations of the environment's
-- `Nat.add` (and so on) once, when it is declared. `Nat.pred`, `Nat.add` and
-- `Nat.mul` enter the equations of `Nat.sub`, `Nat.mul`, `Nat.pow` and
-- `Nat.shiftLeft` with their own, and `Nat.shiftRight` is computed a shift at
-- a time from the divisions by 2.

--| `add_eqs G f`: `f` is closed, `f : Nat → Nat → Nat`, `f x 0 ≡ x` and
--| `f x (succ y) ≡ succ (f x y)`: Lean's `Nat.add`.
term add_eqs: ctx > expr > wff;
axiom add_eqs_i (G: ctx) (f: expr):
  $ closed 0 f $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ (nat_succ @ #0) ≡ nat_succ @ (f @ #1 @ #0) : ℕ ⟧ $ >
  $ add_eqs G f $;
--| `pred_eqs G p`: `p 0 ≡ 0` and `p (succ x) ≡ x`: Lean's `Nat.pred`.
term pred_eqs: ctx > expr > wff;
axiom pred_eqs_i (G: ctx) (p: expr):
  $ closed 0 p $ > $ ⟨ G ⊢ p : Π ℕ. ℕ ⟩ $ >
  $ ⟦ G ⊢ p @ nat_zero ≡ nat_zero : ℕ ⟧ $ >
  $ ⟦ ℕ :: G ⊢ p @ (nat_succ @ #0) ≡ #0 : ℕ ⟧ $ >
  $ pred_eqs G p $;
--| `sub_eqs G f p`: with `pred_eqs G p`, `f x 0 ≡ x` and `f x (succ y) ≡ p (f x y)`:
--| Lean's `Nat.sub`.
term sub_eqs: ctx > expr > expr > wff;
axiom sub_eqs_i (G: ctx) (f p: expr):
  $ pred_eqs G p $ > $ closed 0 f $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ (nat_succ @ #0) ≡ p @ (f @ #1 @ #0) : ℕ ⟧ $ >
  $ sub_eqs G f p $;
--| `mul_eqs G f fa`: with `add_eqs G fa`, `f x 0 ≡ 0` and `f x (succ y) ≡ fa (f x y) x`:
--| Lean's `Nat.mul`.
term mul_eqs: ctx > expr > expr > wff;
axiom mul_eqs_i (G: ctx) (f fa: expr):
  $ add_eqs G fa $ > $ closed 0 f $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ #0 @ nat_zero ≡ nat_zero : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ (nat_succ @ #0) ≡ fa @ (f @ #1 @ #0) @ #1 : ℕ ⟧ $ >
  $ mul_eqs G f fa $;
--| `pow_eqs G f fm fa`: with `mul_eqs G fm fa`, `f x 0 ≡ succ 0` and
--| `f x (succ y) ≡ fm (f x y) x`: Lean's `Nat.pow`.
term pow_eqs: ctx > expr > expr > expr > wff;
axiom pow_eqs_i (G: ctx) (f fm fa: expr):
  $ mul_eqs G fm fa $ > $ closed 0 f $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ #0 @ nat_zero ≡ nat_succ @ nat_zero : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ (nat_succ @ #0) ≡ fm @ (f @ #1 @ #0) @ #1 : ℕ ⟧ $ >
  $ pow_eqs G f fm fa $;
--| `beq_eqs G f B t u`: `f : Nat → Nat → B` with `f 0 0 ≡ t`, `f 0 (succ y) ≡ u`,
--| `f (succ x) 0 ≡ u` and `f (succ x) (succ y) ≡ f x y`, where `B`, `t` and `u` are
--| closed: Lean's `Nat.beq`, with `Bool`, `true` and `false`.
term beq_eqs: ctx > expr > expr > expr > expr > wff;
axiom beq_eqs_i (G: ctx) (f B t u: expr):
  $ closed 0 f $ > $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ >
  $ ⟨ G ⊢ f : Π ℕ. Π ℕ. B ⟩ $ >
  $ ⟦ G ⊢ f @ nat_zero @ nat_zero ≡ t : B ⟧ $ >
  $ ⟦ ℕ :: G ⊢ f @ nat_zero @ (nat_succ @ #0) ≡ u : B ⟧ $ >
  $ ⟦ ℕ :: G ⊢ f @ (nat_succ @ #0) @ nat_zero ≡ u : B ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ (nat_succ @ #1) @ (nat_succ @ #0) ≡ f @ #1 @ #0 : B ⟧ $ >
  $ beq_eqs G f B t u $;
--| `ble_eqs G f B t u`: `f 0 y ≡ t`, `f (succ x) 0 ≡ u` and `f (succ x) (succ y) ≡ f x y`:
--| Lean's `Nat.ble`.
term ble_eqs: ctx > expr > expr > expr > expr > wff;
axiom ble_eqs_i (G: ctx) (f B t u: expr):
  $ closed 0 f $ > $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ >
  $ ⟨ G ⊢ f : Π ℕ. Π ℕ. B ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ nat_zero @ #0 ≡ t : B ⟧ $ >
  $ ⟦ ℕ :: G ⊢ f @ (nat_succ @ #0) @ nat_zero ≡ u : B ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ (nat_succ @ #1) @ (nat_succ @ #0) ≡ f @ #1 @ #0 : B ⟧ $ >
  $ ble_eqs G f B t u $;
--| `shl_eqs G f fm fa`: with `mul_eqs G fm fa`, `f x 0 ≡ x` and
--| `f x (succ y) ≡ f (fm 2 x) y`: Lean's `Nat.shiftLeft`.
term shl_eqs: ctx > expr > expr > expr > wff;
axiom shl_eqs_i (G: ctx) (f fm fa: expr):
  $ mul_eqs G fm fa $ > $ closed 0 f $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ (nat_succ @ #0) ≡ f @ (fm @ lit (bd0 (bd1 b0)) @ #1) @ #0 : ℕ ⟧ $ >
  $ shl_eqs G f fm fa $;
--| `shr_eqs G f fd`: `f x 0 ≡ x` and `f x (succ y) ≡ fd (f x y) 2`, with `fd` closed:
--| Lean's `Nat.shiftRight`, with `Nat.div`.
term shr_eqs: ctx > expr > expr > wff;
axiom shr_eqs_i (G: ctx) (f fd: expr):
  $ closed 0 f $ > $ closed 0 fd $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ #0 @ nat_zero ≡ #0 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ (nat_succ @ #0) ≡ fd @ (f @ #1 @ #0) @ lit (bd0 (bd1 b0)) : ℕ ⟧ $ >
  $ shr_eqs G f fd $;

-- The division-like operations (audit §5) ----------------------------------
-- Lean4Lean's checks of `Nat.div`, `Nat.mod`, `Nat.gcd` and `Nat.bitwise`
-- (`Condition.check`, `checkNatDITE`, `checkITE`, `checkNatFuelRec`,
-- `unfoldNatWellFounded` and its probes) go through conditionals on decided
-- propositions, fuel recursion and the well-founded fixpoint
-- `WellFounded.Nat.fix`. The relations below state those checks over
-- variables standing for Lean's `@dite Nat`, `@ite Nat`, `Decidable.intro`,
-- `Nat.decLe`, the proof terms, and so on: nothing is assumed of them beyond
-- the equations.

--| `dec_eqs G B t u Not Dec dite T R ofT ofF`: a reflection of decisions
--| (Lean4Lean's `Reflection`): `R p b H : Dec p` decides the proposition `p`
--| by the Bool `b`, given `H : T p b`, and the dependent conditional at
--| `ℕ` reduces on it: `dite p (R p t H) a b ≡ a (ofT p H)` and
--| `dite p (R p u H) a b ≡ b (ofF p H)` (`checkNatDITE`), for fresh
--| `p : Prop`, `H`, `a` and `b`. In Lean, `Decidable.intro`, `Bool.Reflects`
--| and `@dite Nat`.
term dec_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom dec_eqs_i (G: ctx) (B t u Not Dec dite T R ofT ofF: expr):
  $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ > $ closed 0 Not $ > $ closed 0 Dec $ >
  $ closed 0 dite $ > $ closed 0 T $ > $ closed 0 R $ > $ closed 0 ofT $ > $ closed 0 ofF $ >
  $ ⟨ G ⊢ ofT : Π Prop. Π (T @ #0 @ t). #1 ⟩ $ >
  $ ⟨ G ⊢ ofF : Π Prop. Π (T @ #0 @ u). Not @ #1 ⟩ $ >
  $ ⟦ (Π (Not @ #2). ℕ) :: (Π #1. ℕ) :: (T @ #0 @ t) :: Prop :: G ⊢
      dite @ #3 @ (R @ #3 @ t @ #2) @ #1 @ #0 ≡ #1 @ (ofT @ #3 @ #2) : ℕ ⟧ $ >
  $ ⟦ (Π (Not @ #2). ℕ) :: (Π #1. ℕ) :: (T @ #0 @ u) :: Prop :: G ⊢
      dite @ #3 @ (R @ #3 @ u @ #2) @ #1 @ #0 ≡ #0 @ (ofF @ #3 @ #2) : ℕ ⟧ $ >
  $ dec_eqs G B t u Not Dec dite T R ofT ofF $;
--| `ite_eqs G B t u T R ite`: the conditional at `ℕ` reduces on the
--| reflection: `ite p (R p t H) a b ≡ a` and `ite p (R p u H) a b ≡ b`
--| (`checkITE`). In Lean, `@ite Nat`.
term ite_eqs: ctx > expr > expr > expr > expr > expr > expr > wff;
axiom ite_eqs_i (G: ctx) (B t u T R ite: expr):
  $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ > $ closed 0 T $ > $ closed 0 R $ > $ closed 0 ite $ >
  $ ⟦ ℕ :: ℕ :: (T @ #0 @ t) :: Prop :: G ⊢
      ite @ #3 @ (R @ #3 @ t @ #2) @ #1 @ #0 ≡ #1 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: (T @ #0 @ u) :: Prop :: G ⊢
      ite @ #3 @ (R @ #3 @ u @ #2) @ #1 @ #0 ≡ #0 : ℕ ⟧ $ >
  $ ite_eqs G B t u T R ite $;
--| `natle_dec G B t u Not Dec dite T R ofT ofF leN dleN ble pf`: with the
--| reflection, `dleN x y ≡ R (leN x y) (ble x y) (pf x y)` for fresh `x y`,
--| where `ble` has `Nat.ble`'s equations (`Condition.natLE`): Lean's
--| `Nat.decLe` decides `≤` by `Nat.ble`.
term natle_dec: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom natle_dec_i (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf: expr):
  $ dec_eqs G B t u Not Dec dite T R ofT ofF $ > $ ble_eqs G ble B t u $ >
  $ closed 0 leN $ > $ closed 0 dleN $ > $ closed 0 pf $ >
  $ ⟨ G ⊢ leN : Π ℕ. Π ℕ. Prop ⟩ $ >
  $ ⟨ G ⊢ pf : Π ℕ. Π ℕ. T @ (leN @ #1 @ #0) @ (ble @ #1 @ #0) ⟩ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢
      dleN @ #1 @ #0 ≡ R @ (leN @ #1 @ #0) @ (ble @ #1 @ #0) @ (pf @ #1 @ #0) : Dec @ (leN @ #1 @ #0) ⟧ $ >
  $ natle_dec G B t u Not Dec dite T R ofT ofF leN dleN ble pf $;
--| `nateq_dec G ... eqN deqN beq pq`: likewise `deqN x y ≡ R (eqN x y) (beq x y) (pq x y)`
--| with `Nat.beq`'s equations (`Condition.natEq`): Lean's `Nat.decEq`.
term nateq_dec: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom nateq_dec_i (G: ctx) (B t u Not Dec dite T R ofT ofF eqN deqN beq pq: expr):
  $ dec_eqs G B t u Not Dec dite T R ofT ofF $ > $ beq_eqs G beq B t u $ >
  $ closed 0 eqN $ > $ closed 0 deqN $ > $ closed 0 pq $ >
  $ ⟨ G ⊢ eqN : Π ℕ. Π ℕ. Prop ⟩ $ >
  $ ⟨ G ⊢ pq : Π ℕ. Π ℕ. T @ (eqN @ #1 @ #0) @ (beq @ #1 @ #0) ⟩ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢
      deqN @ #1 @ #0 ≡ R @ (eqN @ #1 @ #0) @ (beq @ #1 @ #0) @ (pq @ #1 @ #0) : Dec @ (eqN @ #1 @ #0) ⟧ $ >
  $ nateq_dec G B t u Not Dec dite T R ofT ofF eqN deqN beq pq $;
--| `bool_dec G B t u Not dite ite bp bd`: a condition on a Bool
--| (`Condition.bool`: `bp b` is `b = true`, decided by `bd b`): the
--| conditionals at `ℕ` reduce on `bp t` and `bp u`, for fresh `a b`:
--| `dite (bp t) (bd t) (λ _. a) (λ _. b) ≡ a`, `ite (bp t) (bd t) a b ≡ a`,
--| and the `u` cases to `b`.
term bool_dec: ctx > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom bool_dec_i (G: ctx) (B t u Not dite ite bp bd: expr):
  $ closed 0 B $ > $ closed 0 t $ > $ closed 0 u $ > $ closed 0 Not $ >
  $ closed 0 dite $ > $ closed 0 ite $ > $ closed 0 bp $ > $ closed 0 bd $ >
  $ ⟦ ℕ :: ℕ :: G ⊢
      dite @ (bp @ t) @ (bd @ t) @ (λ (bp @ t). #2) @ (λ (Not @ (bp @ t)). #1) ≡ #1 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢
      dite @ (bp @ u) @ (bd @ u) @ (λ (bp @ u). #2) @ (λ (Not @ (bp @ u)). #1) ≡ #0 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ ite @ (bp @ t) @ (bd @ t) @ #1 @ #0 ≡ #1 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ ite @ (bp @ u) @ (bd @ u) @ #1 @ #0 ≡ #0 : ℕ ⟧ $ >
  $ bool_dec G B t u Not dite ite bp bd $;
--| `div_eqs G ... leN dleN ble pf sub p f go pfs lem`: Lean4Lean's
--| `checkNatDiv`: with `Nat.decLe`'s reflection and `Nat.sub`'s equations,
--| `f x y ≡ dite (leN 1 y) (dleN 1 y) (λ hy. go y hy (succ x) x (pfs x)) (λ _. 0)`
--| and, for `hy : leN 1 y` and `h : leN (succ x) (succ fuel)`,
--| `go y hy (succ fuel) x h ≡ dite (leN y x) (dleN y x)
--|   (λ h2. succ (go y hy fuel (sub x y) (lem x y fuel hy h2 h))) (λ _. 0)`:
--| Lean's `Nat.div` and `Nat.div.go` (fuel recursion, the proofs
--| `Nat.lt_succ_self` and `Nat.div_rec_fuel_lemma`).
term div_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom div_eqs_i (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem: expr):
  $ natle_dec G B t u Not Dec dite T R ofT ofF leN dleN ble pf $ > $ sub_eqs G sub p $ >
  $ closed 0 f $ > $ closed 0 go $ > $ closed 0 pfs $ > $ closed 0 lem $ >
  $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟨ G ⊢ go : Π ℕ. Π (leN @ lit1 @ #0). Π ℕ. Π ℕ. Π (leN @ (nat_succ @ #0) @ #1). ℕ ⟩ $ >
  $ ⟨ G ⊢ pfs : Π ℕ. leN @ (nat_succ @ #0) @ (nat_succ @ #0) ⟩ $ >
  $ ⟨ G ⊢ lem : Π ℕ. Π ℕ. Π ℕ. Π (leN @ lit1 @ #1). Π (leN @ #2 @ #3).
      Π (leN @ (nat_succ @ #4) @ (nat_succ @ #2)). leN @ (nat_succ @ (sub @ #5 @ #4)) @ #3 ⟩ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢
      f @ #1 @ #0 ≡ dite @ (leN @ lit1 @ #0) @ (dleN @ lit1 @ #0)
        @ (λ (leN @ lit1 @ #0). go @ #1 @ #0 @ (nat_succ @ #2) @ #2 @ (pfs @ #2))
        @ (λ (Not @ (leN @ lit1 @ #0)). lit0) : ℕ ⟧ $ >
  $ ⟦ (leN @ (nat_succ @ #3) @ (nat_succ @ #0)) :: ℕ :: (leN @ lit1 @ #0) :: ℕ :: ℕ :: G ⊢
      go @ #3 @ #2 @ (nat_succ @ #1) @ #4 @ #0 ≡ dite @ (leN @ #3 @ #4) @ (dleN @ #3 @ #4)
        @ (λ (leN @ #3 @ #4). nat_succ @ (go @ #4 @ #3 @ #2 @ (sub @ #5 @ #4) @ (lem @ #5 @ #4 @ #2 @ #3 @ #0 @ #1)))
        @ (λ (Not @ (leN @ #3 @ #4)). lit0) : ℕ ⟧ $ >
  $ div_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem $;
--| `mod_eqs G ... sub p ite f go pfs lem`: Lean4Lean's `checkNatMod`: `f 0 x ≡ 0`,
--| `f (succ x) y ≡ ite (leN y (succ x)) (dleN y (succ x))
--|   (dite (leN 1 y) (dleN 1 y) (λ hy. go y hy (succ (succ x)) (succ x) (pfs (succ x))) (λ _. succ x))
--|   (succ x)`,
--| and `go y hy (succ fuel) x h ≡ dite (leN y x) (dleN y x)
--|   (λ h2. go y hy fuel (sub x y) (lem x y fuel hy h2 h)) (λ _. x)`:
--| Lean's `Nat.mod`, `Nat.modCore` and `Nat.modCore.go`.
term mod_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom mod_eqs_i (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem: expr):
  $ natle_dec G B t u Not Dec dite T R ofT ofF leN dleN ble pf $ > $ sub_eqs G sub p $ >
  $ ite_eqs G B t u T R ite $ >
  $ closed 0 f $ > $ closed 0 go $ > $ closed 0 pfs $ > $ closed 0 lem $ >
  $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟨ G ⊢ go : Π ℕ. Π (leN @ lit1 @ #0). Π ℕ. Π ℕ. Π (leN @ (nat_succ @ #0) @ #1). ℕ ⟩ $ >
  $ ⟨ G ⊢ pfs : Π ℕ. leN @ (nat_succ @ #0) @ (nat_succ @ #0) ⟩ $ >
  $ ⟨ G ⊢ lem : Π ℕ. Π ℕ. Π ℕ. Π (leN @ lit1 @ #1). Π (leN @ #2 @ #3).
      Π (leN @ (nat_succ @ #4) @ (nat_succ @ #2)). leN @ (nat_succ @ (sub @ #5 @ #4)) @ #3 ⟩ $ >
  $ ⟦ ℕ :: G ⊢ f @ lit0 @ #0 ≡ lit0 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢
      f @ (nat_succ @ #1) @ #0 ≡ ite @ (leN @ #0 @ (nat_succ @ #1)) @ (dleN @ #0 @ (nat_succ @ #1))
        @ (dite @ (leN @ lit1 @ #0) @ (dleN @ lit1 @ #0)
          @ (λ (leN @ lit1 @ #0). go @ #1 @ #0 @ (nat_succ @ (nat_succ @ #2)) @ (nat_succ @ #2) @ (pfs @ (nat_succ @ #2)))
          @ (λ (Not @ (leN @ lit1 @ #0)). nat_succ @ #2))
        @ (nat_succ @ #1) : ℕ ⟧ $ >
  $ ⟦ (leN @ (nat_succ @ #3) @ (nat_succ @ #0)) :: ℕ :: (leN @ lit1 @ #0) :: ℕ :: ℕ :: G ⊢
      go @ #3 @ #2 @ (nat_succ @ #1) @ #4 @ #0 ≡ dite @ (leN @ #3 @ #4) @ (dleN @ #3 @ #4)
        @ (λ (leN @ #3 @ #4). go @ #4 @ #3 @ #2 @ (sub @ #5 @ #4) @ (lem @ #5 @ #4 @ #2 @ #3 @ #0 @ #1))
        @ (λ (Not @ (leN @ #3 @ #4)). #5) : ℕ ⟧ $ >
  $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem $;
--| The type of the functional of a well-founded fixpoint over the measure
--| `hm : al → nat`: `Π x : al. (Π y : al. ltN (hm y) (hm x) → motive y) → motive x`.
def fix_fty (al motive hm ltN: expr): expr =
  $ Π al. Π (Π al. Π (ltN @ (hm @ #0) @ (hm @ #1)). motive @ #1). motive @ #1 $;
--| `fix_eqs G ite bp bd beq fix go eager al motive hm ltN pfx pfgo`: Lean's
--| `WellFounded.Nat.fix` at the type `al` with the measure `hm`
--| (`unfoldNatWellFounded`): for every functional `F` and `x : al`,
--| `fix al motive hm F x ≡ go al motive hm F (eager (succ (hm x))) x (pfx x)`;
--| `eager x ≡ ite (bp (beq x x)) (bd (beq x x)) x x` (`WellFounded.Nat.eager`,
--| which keeps the fuel from reducing until it is a numeral); and the fuel
--| recursion `go al motive hm F (succ t) x h ≡ F x (λ y hy. go al motive hm F t y (pfgo t x h y hy))`.
term fix_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom fix_eqs_i (G: ctx) (ite bp bd beq fix go eager al motive hm ltN pfx pfgo: expr):
  $ closed 0 ite $ > $ closed 0 bp $ > $ closed 0 bd $ > $ closed 0 beq $ >
  $ closed 0 fix $ > $ closed 0 go $ > $ closed 0 eager $ > $ closed 0 al $ > $ closed 0 motive $ >
  $ closed 0 hm $ > $ closed 0 ltN $ > $ closed 0 pfx $ > $ closed 0 pfgo $ >
  $ ⟨ G ⊢ ltN : Π ℕ. Π ℕ. Prop ⟩ $ >
  $ ⟨ G ⊢ go @ al @ motive @ hm : Π (fix_fty al motive hm ltN). Π ℕ. Π al. Π (ltN @ (hm @ #0) @ #1). motive @ #1 ⟩ $ >
  $ ⟨ G ⊢ pfx : Π al. ltN @ (hm @ #0) @ (eager @ (nat_succ @ (hm @ #0))) ⟩ $ >
  $ ⟨ G ⊢ pfgo : Π ℕ. Π al. Π (ltN @ (hm @ #0) @ (nat_succ @ #1)). Π al. Π (ltN @ (hm @ #0) @ (hm @ #2)).
      ltN @ (hm @ #1) @ #4 ⟩ $ >
  $ ⟦ al :: fix_fty al motive hm ltN :: G ⊢
      fix @ al @ motive @ hm @ #1 @ #0 ≡ go @ al @ motive @ hm @ #1 @ (eager @ (nat_succ @ (hm @ #0))) @ #0 @ (pfx @ #0) : motive @ #0 ⟧ $ >
  $ ⟦ ℕ :: G ⊢ eager @ #0 ≡ ite @ (bp @ (beq @ #0 @ #0)) @ (bd @ (beq @ #0 @ #0)) @ #0 @ #0 : ℕ ⟧ $ >
  $ ⟦ (ltN @ (hm @ #0) @ (nat_succ @ #1)) :: al :: ℕ :: fix_fty al motive hm ltN :: G ⊢
      go @ al @ motive @ hm @ #3 @ (nat_succ @ #2) @ #1 @ #0
        ≡ #3 @ #1 @ (λ al. λ (ltN @ (hm @ #0) @ (hm @ #2)). go @ al @ motive @ hm @ #5 @ #4 @ #1 @ (pfgo @ #4 @ #3 @ #2 @ #1 @ #0)) : motive @ #1 ⟧ $ >
  $ fix_eqs G ite bp bd beq fix go eager al motive hm ltN pfx pfgo $;
--| `gcd_eqs G ... f pack F pfF`: Lean4Lean's `checkNatGcd`: with `Nat.mod`'s
--| equations, `Nat.decEq`'s reflection, the Bool condition and the fixpoint,
--| `f m n ≡ fix al motive hm F (pack m n)`, `hm (pack m n) ≡ m` (the measure
--| is the first argument), and the probes of the functional:
--| `F (pack 0 n) ih ≡ n` and, given `H : Not (eqN (succ m) 0)`,
--| `F (pack (succ m) n) ih ≡ ih (pack (fm n (succ m)) (succ m)) (pfF (succ m) n H)`.
term gcd_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom gcd_eqs_i (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem eqN deqN beq pq bp bd fix go eager al motive hm ltN pfx pfgo f pack F pfF: expr):
  $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem $ >
  $ nateq_dec G B t u Not Dec dite T R ofT ofF eqN deqN beq pq $ >
  $ bool_dec G B t u Not dite ite bp bd $ >
  $ fix_eqs G ite bp bd beq fix go eager al motive hm ltN pfx pfgo $ >
  $ closed 0 f $ > $ closed 0 pack $ > $ closed 0 F $ > $ closed 0 pfF $ >
  $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟨ G ⊢ F : fix_fty al motive hm ltN ⟩ $ > $ ⟨ G ⊢ pack : Π ℕ. Π ℕ. al ⟩ $ >
  $ ⟨ G ⊢ pfF : Π ℕ. Π ℕ. Π (Not @ (eqN @ #1 @ lit0)).
      ltN @ (hm @ (pack @ (fm @ #1 @ #2) @ #2)) @ (hm @ (pack @ #2 @ #1)) ⟩ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ f @ #1 @ #0 ≡ fix @ al @ motive @ hm @ F @ (pack @ #1 @ #0) : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ hm @ (pack @ #1 @ #0) ≡ #1 : ℕ ⟧ $ >
  $ ⟦ (Π al. Π (ltN @ (hm @ #0) @ (hm @ (pack @ lit0 @ #1))). motive @ #1) :: ℕ :: G ⊢
      F @ (pack @ lit0 @ #1) @ #0 ≡ #1 : motive @ (pack @ lit0 @ #1) ⟧ $ >
  $ ⟦ (Π al. Π (ltN @ (hm @ #0) @ (hm @ (pack @ (nat_succ @ #3) @ #2))). motive @ #1)
        :: (Not @ (eqN @ (nat_succ @ #1) @ lit0)) :: ℕ :: ℕ :: G ⊢
      F @ (pack @ (nat_succ @ #3) @ #2) @ #0
        ≡ #0 @ (pack @ (fm @ #2 @ (nat_succ @ #3)) @ (nat_succ @ #3)) @ (pfF @ (nat_succ @ #3) @ #2 @ #1)
        : motive @ (pack @ (nat_succ @ #3) @ #2) ⟧ $ >
  $ gcd_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem eqN deqN beq pq bp bd fix go eager al motive hm ltN pfx pfgo f pack F pfF $;
--| `bitwise_eqs G ... fb pack Fb pfB dec`: Lean4Lean's `checkNatBitwise`:
--| with the equations of `Nat.div`, `Nat.mod` and `Nat.add`, `Nat.decEq`'s
--| reflection, the Bool condition and the fixpoint, for a fresh
--| `bf : B → B → B`: `fb bf n m ≡ fix al motive hm (Fb bf) (pack n m)`,
--| `hm (pack n m) ≡ n`, `motive (pack n m) ≡ ℕ` (the type of the recursive
--| call `r` below), `dec p (R p b H) ≡ b` (`Decidable.decide` of a
--| reflected decision is its Bool), and the probe of the functional at
--| `pack n m`: `Fb bf (pack n m) ih ≡`
--|   `dite (eqN n 0) (deqN n 0) (λ _. dite (bp (bf u t)) (bd (bf u t)) (λ _. m) (λ _. 0))`
--|   `(λ h. dite (eqN m 0) (deqN m 0) (λ _. dite (bp (bf t u)) (bd (bf t u)) (λ _. n) (λ _. 0))`
--|   `(λ _. dite (bp (bf b1 b2)) (bd (bf b1 b2)) (λ _. fa (fa r r) 1) (λ _. fa r r)))`
--| where `bi = dec (eqN (fm x 2) 1) (deqN (fm x 2) 1)` is the low bit of `x` and
--| `r = ih (pack (fd n 2) (fd m 2)) (pfB n m h)` the recursive call.
term bitwise_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom bitwise_eqs_i (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec: expr):
  $ div_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god pfs lem $ >
  $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem $ >
  $ nateq_dec G B t u Not Dec dite T R ofT ofF eqN deqN beq pq $ >
  $ bool_dec G B t u Not dite ite bp bd $ >
  $ add_eqs G fa $ >
  $ fix_eqs G ite bp bd beq fix go eager al motive hm ltN pfx pfgo $ >
  $ closed 0 fb $ > $ closed 0 pack $ > $ closed 0 Fb $ > $ closed 0 pfB $ > $ closed 0 dec $ >
  $ ⟨ G ⊢ fb : Π (Π B. Π B. B). Π ℕ. Π ℕ. ℕ ⟩ $ >
  $ ⟨ G ⊢ Fb : Π (Π B. Π B. B). fix_fty al motive hm ltN ⟩ $ > $ ⟨ G ⊢ pack : Π ℕ. Π ℕ. al ⟩ $ >
  $ ⟨ G ⊢ pfB : Π ℕ. Π ℕ. Π (Not @ (eqN @ #1 @ lit0)).
      ltN @ (hm @ (pack @ (fd @ #2 @ lit2) @ (fd @ #1 @ lit2))) @ (hm @ (pack @ #2 @ #1)) ⟩ $ >
  $ ⟦ ℕ :: ℕ :: (Π B. Π B. B) :: G ⊢
      fb @ #2 @ #1 @ #0 ≡ fix @ al @ motive @ hm @ (Fb @ #2) @ (pack @ #1 @ #0) : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ hm @ (pack @ #1 @ #0) ≡ #1 : ℕ ⟧ $ >
  $ ⟦ ℕ :: ℕ :: G ⊢ motive @ (pack @ #1 @ #0) ≡ ℕ : srt (ls lz) ⟧ $ >
  $ ⟦ (T @ #1 @ #0) :: B :: Prop :: G ⊢ dec @ #2 @ (R @ #2 @ #1 @ #0) ≡ #1 : B ⟧ $ >
  $ ⟦ (Π al. Π (ltN @ (hm @ #0) @ (hm @ (pack @ #2 @ #1))). motive @ #1) :: ℕ :: ℕ :: (Π B. Π B. B) :: G ⊢
      Fb @ #3 @ (pack @ #2 @ #1) @ #0
        ≡ dite @ (eqN @ #2 @ lit0) @ (deqN @ #2 @ lit0)
          @ (λ (eqN @ #2 @ lit0). dite @ (bp @ (#4 @ u @ t)) @ (bd @ (#4 @ u @ t))
              @ (λ (bp @ (#4 @ u @ t)). #3) @ (λ (Not @ (bp @ (#4 @ u @ t))). lit0))
          @ (λ (Not @ (eqN @ #2 @ lit0)). dite @ (eqN @ #2 @ lit0) @ (deqN @ #2 @ lit0)
              @ (λ (eqN @ #2 @ lit0). dite @ (bp @ (#5 @ t @ u)) @ (bd @ (#5 @ t @ u))
                  @ (λ (bp @ (#5 @ t @ u)). #5) @ (λ (Not @ (bp @ (#5 @ t @ u))). lit0))
              @ (λ (Not @ (eqN @ #2 @ lit0)).
                  dite @ (bp @ (#5 @ (dec @ (eqN @ (fm @ #4 @ lit2) @ lit1) @ (deqN @ (fm @ #4 @ lit2) @ lit1)) @ (dec @ (eqN @ (fm @ #3 @ lit2) @ lit1) @ (deqN @ (fm @ #3 @ lit2) @ lit1))))
                    @ (bd @ (#5 @ (dec @ (eqN @ (fm @ #4 @ lit2) @ lit1) @ (deqN @ (fm @ #4 @ lit2) @ lit1)) @ (dec @ (eqN @ (fm @ #3 @ lit2) @ lit1) @ (deqN @ (fm @ #3 @ lit2) @ lit1))))
                    @ (λ (bp @ (#5 @ (dec @ (eqN @ (fm @ #4 @ lit2) @ lit1) @ (deqN @ (fm @ #4 @ lit2) @ lit1)) @ (dec @ (eqN @ (fm @ #3 @ lit2) @ lit1) @ (deqN @ (fm @ #3 @ lit2) @ lit1)))).
                        fa @ (fa @ (#3 @ (pack @ (fd @ #5 @ lit2) @ (fd @ #4 @ lit2)) @ (pfB @ #5 @ #4 @ #2)) @ (#3 @ (pack @ (fd @ #5 @ lit2) @ (fd @ #4 @ lit2)) @ (pfB @ #5 @ #4 @ #2))) @ lit1)
                    @ (λ (Not @ (bp @ (#5 @ (dec @ (eqN @ (fm @ #4 @ lit2) @ lit1) @ (deqN @ (fm @ #4 @ lit2) @ lit1)) @ (dec @ (eqN @ (fm @ #3 @ lit2) @ lit1) @ (deqN @ (fm @ #3 @ lit2) @ lit1))))).
                        fa @ (#3 @ (pack @ (fd @ #5 @ lit2) @ (fd @ #4 @ lit2)) @ (pfB @ #5 @ #4 @ #2)) @ (#3 @ (pack @ (fd @ #5 @ lit2) @ (fd @ #4 @ lit2)) @ (pfB @ #5 @ #4 @ #2)))))
        : motive @ (pack @ #2 @ #1) ⟧ $ >
  $ bitwise_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec $;
--| `bitop_eqs G ... f bf r1 r2 r3 r4`: `f ≡ fb bf` for a Bool function `bf`
--| with the truth table `bf t t ≡ r1`, `bf t u ≡ r2`, `bf u t ≡ r3`,
--| `bf u u ≡ r4` (`checkNatLAnd`, `checkNatLOr`, `checkNatXor`): Lean's
--| `Nat.land`, `Nat.lor` and `Nat.xor` are `Nat.bitwise and`, `Nat.bitwise or`
--| and `Nat.bitwise bne`.
term bitop_eqs: ctx > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > expr > wff;
axiom bitop_eqs_i (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf r1 r2 r3 r4: expr):
  $ bitwise_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec $ >
  $ closed 0 f $ > $ closed 0 bf $ > $ ⟨ G ⊢ f : Π ℕ. Π ℕ. ℕ ⟩ $ > $ ⟨ G ⊢ bf : Π B. Π B. B ⟩ $ >
  $ ⟦ G ⊢ f ≡ fb @ bf : Π ℕ. Π ℕ. ℕ ⟧ $ >
  $ ⟦ G ⊢ bf @ t @ t ≡ r1 : B ⟧ $ > $ ⟦ G ⊢ bf @ t @ u ≡ r2 : B ⟧ $ >
  $ ⟦ G ⊢ bf @ u @ t ≡ r3 : B ⟧ $ > $ ⟦ G ⊢ bf @ u @ u ≡ r4 : B ⟧ $ >
  $ bitop_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf r1 r2 r3 r4 $;

---------------------------------------------------------------------------
-- PART III: THE RULES
-- The axioms concluding `≈` and `⊢`: the theory. Each is argued in
-- notes/audit-lean-mm0.md (§2 for the core, §4 for inductive types and
-- quotients, §5 for literals, §6 for the admissible rules).
---------------------------------------------------------------------------

-- Level equivalence (VLevel.lean:58) ---------------------------------------
-- Each axiom is valid under `VLevel.eval`, where `imax a b = if b = 0 then 0
-- else max a b`. These axioms alone are incomplete (notes/audit-lean-mm0.md
-- §3); `leqv_cases` completes them. A case split must substitute the
-- parameter inside an arbitrary level, which cannot be stated over MM0
-- variables, so a goal's variables are first abstracted to object-level
-- parameters `lparam i` (`leqv_inst` puts the original levels back), and
-- `leqv_cases` splits on one of those. The semantics of `leqv` (equal value
-- under every assignment) covers `lparam`s like any other level variable, and
-- with the axioms for the `imax`-free cases this decides `leqv` completely
-- (notes/audit-lean-mm0.md §4).

axiom leqv_refl (a: lvl): $ a ≈ a $;
axiom leqv_symm (a b: lvl): $ a ≈ b $ > $ b ≈ a $;
axiom leqv_trans (a b c: lvl): $ a ≈ b $ > $ b ≈ c $ > $ a ≈ c $;
axiom leqv_succ (a b: lvl): $ a ≈ b $ > $ ls a ≈ ls b $;
axiom leqv_max (a b c d: lvl):
  $ a ≈ b $ > $ c ≈ d $ > $ a ⊔ c ≈ b ⊔ d $;
axiom leqv_imax (a b c d: lvl):
  $ a ≈ b $ > $ c ≈ d $ > $ limax a c ≈ limax b d $;
axiom lmax_comm (a b: lvl): $ a ⊔ b ≈ b ⊔ a $;
axiom lmax_assoc (a b c: lvl): $ a ⊔ b ⊔ c ≈ a ⊔ (b ⊔ c) $;
axiom lmax_idem (a: lvl): $ a ⊔ a ≈ a $;
axiom lmax_zero (a: lvl): $ lz ⊔ a ≈ a $;
axiom lmax_succ (a b: lvl): $ ls a ⊔ ls b ≈ ls (a ⊔ b) $;
axiom lmax_succ_self (a: lvl): $ a ⊔ ls a ≈ ls a $;
axiom limax_zero (a: lvl): $ limax a lz ≈ lz $;
axiom limax_zero_l (a: lvl): $ limax lz a ≈ a $;
--| `imax 1 a = a`: if `a = 0` both are 0, otherwise `max 1 a = a`. nanoda's level `simplify`
--| applies it (and `limax_zero_l`) whenever it puts a `Sort` in weak head normal form.
axiom limax_one (a: lvl): $ limax (ls lz) a ≈ a $;
axiom limax_succ (a b: lvl): $ limax a (ls b) ≈ a ⊔ ls b $;
axiom limax_self (a: lvl): $ limax a a ≈ a $;
axiom limax_max (a b c: lvl):
  $ limax a (b ⊔ c) ≈ limax a b ⊔ limax a c $;
axiom limax_imax (a b c: lvl):
  $ limax a (limax b c) ≈ limax a c ⊔ limax b c $;

--| Case split on `lparam n`: zero, or the successor of some level (which is
--| again called `lparam n`).
axiom leqv_cases (n: nat) (l r l0 r0 l1 r1: lvl):
  $ lsubst n l lz l0 $ > $ lsubst n r lz r0 $ > $ l0 ≈ r0 $ >
  $ lsubst n l (ls (lparam n)) l1 $ > $ lsubst n r (ls (lparam n)) r1 $ > $ l1 ≈ r1 $ >
  $ l ≈ r $;
--| Instantiating the parameters of an equivalence.
axiom leqv_inst (S: lvls) (l r l2 r2: lvl):
  $ l ≈ r $ > $ linst S l l2 $ > $ linst S r r2 $ > $ l2 ≈ r2 $;

-- The judgment (IsDefEq, Typing/Basic.lean:18-56) --------------------------

axiom bvar (G: ctx) (i: nat) (A: expr):
  $ lookup G i A $ > $ ⟨ G ⊢ #i : A ⟩ $;
axiom symm (G: ctx) (e e2 A: expr):
  $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e2 ≡ e : A ⟧ $;
axiom trans (G: ctx) (e1 e2 e3 A: expr):
  $ ⟦ G ⊢ e1 ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e2 ≡ e3 : A ⟧ $ > $ ⟦ G ⊢ e1 ≡ e3 : A ⟧ $;
axiom sortDF (G: ctx) (l l2: lvl):
  $ l ≈ l2 $ > $ ⟦ G ⊢ srt l ≡ srt l2 : srt (ls l) ⟧ $;
axiom appDF (G: ctx) (f f2 A B a a2 R: expr):
  $ ⟦ G ⊢ f ≡ f2 : Π A. B ⟧ $ > $ ⟦ G ⊢ a ≡ a2 : A ⟧ $ > $ inst 0 B a R $ >
  $ ⟦ G ⊢ f @ a ≡ f2 @ a2 : R ⟧ $;
axiom lamDF (G: ctx) (u: lvl) (A A2 b b2 B: expr):
  $ ⟦ G ⊢ A ≡ A2 : srt u ⟧ $ > $ ⟦ A :: G ⊢ b ≡ b2 : B ⟧ $ >
  $ ⟦ G ⊢ λ A. b ≡ λ A2. b2 : Π A. B ⟧ $;
axiom forallEDF (G: ctx) (u v: lvl) (A A2 B B2: expr):
  $ ⟦ G ⊢ A ≡ A2 : srt u ⟧ $ > $ ⟦ A :: G ⊢ B ≡ B2 : srt v ⟧ $ >
  $ ⟦ G ⊢ Π A. B ≡ Π A2. B2 : srt (limax u v) ⟧ $;
axiom defeqDF (G: ctx) (u: lvl) (A B e e2: expr):
  $ ⟦ G ⊢ A ≡ B : srt u ⟧ $ > $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⟦ G ⊢ e ≡ e2 : B ⟧ $;
axiom beta (G: ctx) (A e B a r R: expr):
  $ ⟨ A :: G ⊢ e : B ⟩ $ > $ ⟨ G ⊢ a : A ⟩ $ > $ inst 0 e a r $ > $ inst 0 B a R $ >
  $ ⟦ G ⊢ (λ A. e) @ a ≡ r : R ⟧ $;
axiom eta (G: ctx) (A B e e1: expr):
  $ ⟨ G ⊢ e : Π A. B ⟩ $ > $ lift 1 0 e e1 $ >
  $ ⟦ G ⊢ λ A. e1 @ #0 ≡ e : Π A. B ⟧ $;
axiom proofIrrel (G: ctx) (p h h2: expr):
  $ ⟨ G ⊢ p : Prop ⟩ $ > $ ⟨ G ⊢ h : p ⟩ $ > $ ⟨ G ⊢ h2 : p ⟩ $ >
  $ ⟦ G ⊢ h ≡ h2 : p ⟧ $;

-- Admissible rules (theorems of Lean4Lean, here axioms) --------------------

--| Substitution: `IsDefEq.instN`, Typing/Lemmas.lean:634 (see
--| notes/audit-lean-mm0.md §6).
axiom instDF (k: nat) (G0 G1 G: ctx) (A0 a e e2 A r r2 R: expr):
  $ ⟨ G0 ⊢ a : A0 ⟩ $ > $ cinst k G0 A0 a G1 G $ > $ ⟦ G1 ⊢ e ≡ e2 : A ⟧ $ >
  $ inst k e a r $ > $ inst k e2 a r2 $ > $ inst k A a R $ >
  $ ⟦ G ⊢ r ≡ r2 : R ⟧ $;

--| Weakening: `IsDefEq.weakN`, Typing/Lemmas.lean:501, for `Ctx.LiftN n 0`
--| (see notes/audit-lean-mm0.md §6).
axiom weakDF (n: nat) (G G2: ctx) (e e2 A r r2 R: expr):
  $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ cext n G G2 $ >
  $ lift n 0 e r $ > $ lift n 0 e2 r2 $ > $ lift n 0 A R $ >
  $ ⟦ G2 ⊢ r ≡ r2 : R ⟧ $;

-- Level equivalence of expressions -----------------------------------------

--| Expressions of the same shape at equivalent levels denote the same value,
--| so they are definitionally equal (this generalizes `sortDF` and `constDF`).
axiom eeqv_df (G: ctx) (e e2 A: expr): $ ⟨ G ⊢ e : A ⟩ $ > $ eeqv e e2 $ > $ ⟦ G ⊢ e ≡ e2 : A ⟧ $;

-- Inductive types: typing, iota, projections and eta (audit §4) ------------

axiom ind_ty_ty (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (i: nat) (F R: expr) (C: ctors):
  $ tys_ok G D $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ pis P F R $ > $ ⟨ G ⊢ ind_ty D i : R ⟩ $;
axiom ind_ctor_ty (G: ctx) (D: ind) (i c: nat) (R: expr):
  $ ind_wf G D $ > $ ctor_ty D i c R $ > $ ⟨ G ⊢ ind_ctor D i c : R ⟩ $;
axiom ind_rec_ty (G: ctx) (D: ind) (N: ctx) (i: nat) (v: lvl) (R0 R: expr):
  $ ind_wf G D $ > $ elim_ok G D v $ > $ rec_ty D v i R0 $ > $ ind_nested D N $ > $ rst D N R0 R $ > $ ⟨ G ⊢ ind_rec D i v : R ⟩ $;
--| Iota: `ind_rec D i v ps ms ns is (ind_ctor D2 i c qs fs) ≡ R ps ms ns fs`
--| when the recursor's arguments before the major premise have their binders'
--| types in the recursor's type (`sty`, which leaves `Π TY. C`), the
--| constructor is the block's up to its levels (`eeqv`), its arguments `qs fs`
--| have their binders' types in its type at `D` (`sty`, which leaves `T2`),
--| and the arguments of `T2` are those of `TY`, one by one (`aeq`: the
--| parameters `qs` are the recursor's `ps`, the constructor's indices are `is`).
axiom ind_iota (G: ctx) (D D2: ind) (N: ctx) (i c: nat) (v: lvl) (np n m a0 a ni k nf nq: nat)
    (Rh R e3 e4 Y maj rhs0 rhs R0 RT TY C CT T2 T: expr):
  $ spine (ind_rec D i v) e4 k $ > $ spine (ind_ctor D2 i c) maj nq $ > $ ind_wf G D $ > $ elim_ok G D v $ >
  $ ind_nested D N $ > $ rec_rhs D v i c Rh $ > $ rst D N Rh R $ >
  $ ind_arity D np n m $ > $ add np n a0 $ > $ add a0 m a $ > $ nidx D i ni $ > $ add a ni k $ > $ nfields D i c nf $ >
  $ add np nf nq $ > $ rehead (ind_rec D i v) R a e3 rhs0 $ > $ spine e3 e4 ni $ > $ spine Y maj nf $ >
  $ rehead Y rhs0 nf maj rhs $ > $ rec_ty D v i R0 $ > $ rst D N R0 RT $ >
  $ sty G (ind_rec D i v) RT e4 (Π TY. C) $ > $ inst 0 C maj T $ >
  $ eeqv (ind_ctor D i c) (ind_ctor D2 i c) $ > $ ctor_ty D i c CT $ > $ sty G (ind_ctor D2 i c) CT maj T2 $ > $ aeq G T2 TY $ >
  $ ⟦ G ⊢ e4 @ maj ≡ rhs : T ⟧ $;
--| Iota of the recursor of an auxiliary type `i` (the occurrence `I Ds`) on
--| `I`'s constructor `c`: `ind_rec D i v ps ms ns is (ind_ctor I2 ii c qs fs)
--| ≡ R ps ms ns fs`, with `ind_iota`'s typing premises at `I`'s constructor
--| (`aeq` makes `qs` the occurrence's arguments at `ps`); the fields are the
--| last `nf` arguments of the major premise, as in `inductive_reduce_rec`.
axiom ind_iota_nst (G: ctx) (D I I2: ind) (N: ctx) (i ii c: nat) (v: lvl) (np n m a0 a ni k nf nq npi: nat)
    (Rh R e3 e4 X Y maj rhs0 rhs R0 RT TY C CT T2 T: expr):
  $ spine (ind_rec D i v) e4 k $ > $ spine (ind_ctor I2 ii c) maj nq $ > $ ind_wf G D $ > $ elim_ok G D v $ >
  $ ind_nested D N $ > $ aux_of D N i X $ > $ spine (ind_ty I ii) X npi $ > $ rec_rhs D v i c Rh $ > $ rst D N Rh R $ >
  $ ind_arity D np n m $ > $ add np n a0 $ > $ add a0 m a $ > $ nidx D i ni $ > $ add a ni k $ > $ nfields D i c nf $ >
  $ add npi nf nq $ > $ rehead (ind_rec D i v) R a e3 rhs0 $ > $ spine e3 e4 ni $ > $ spine Y maj nf $ >
  $ rehead Y rhs0 nf maj rhs $ > $ rec_ty D v i R0 $ > $ rst D N R0 RT $ >
  $ sty G (ind_rec D i v) RT e4 (Π TY. C) $ > $ inst 0 C maj T $ >
  $ eeqv (ind_ctor I ii c) (ind_ctor I2 ii c) $ > $ ctor_ty I ii c CT $ > $ sty G (ind_ctor I2 ii c) CT maj T2 $ > $ aeq G T2 TY $ >
  $ ⟦ G ⊢ e4 @ maj ≡ rhs : T ⟧ $;
axiom proj_ty (G: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (j i np: nat) (e e2 S A A1 A2 R: expr):
  $ ⟦ G ⊢ e ≡ e2 : S ⟧ $ > $ spine (ind_ty D j) S np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ struct_like D j $ >
  $ proj_ok G D j i $ > $ clen P np $ > $ field_ty D j i A $ > $ ind_nested D N $ > $ rst D N A A2 $ > $ pinst i S A2 A1 $ >
  $ qinst b e i 0 A1 R $ >
  $ ⟦ G ⊢ proj b i e ≡ proj b i e2 : R ⟧ $;
--| `proj b i (ind_ctor D2 j nz qs fs) ≡ fs[i]` when the field may be projected
--| (`proj_ok`) and the constructor's arguments have their binders' types in
--| its type (`sty`).
axiom proj_mk (G: ctx) (D2: ind) (b: blk) (j i np n m nf nq ii: nat) (M Y f T CT S: expr):
  $ spine (ind_ctor D2 j 0) M nq $ > $ ind_arity D2 np n m $ > $ nfields D2 j 0 nf $ > $ add np nf nq $ >
  $ add ii (s i) nf $ > $ spine (Y @ f) M ii $ > $ ind_wf G D2 $ > $ proj_ok G D2 j i $ >
  $ ctor_ty D2 j 0 CT $ > $ sty G (ind_ctor D2 j 0) CT M S $ >
  $ ⟨ G ⊢ proj b i M : T ⟩ $ > $ ⟦ G ⊢ proj b i M ≡ f : T ⟧ $;
axiom ind_eta (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j np nf: nat) (e S Y M: expr):
  $ ⟨ G ⊢ e : S ⟩ $ > $ spine (ind_ty D j) S np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ eta_ok D j $ > $ clen P np $ >
  $ rehead (ind_ty D j) (ind_ctor D j 0) np S Y $ > $ nfields D j 0 nf $ > $ projs b e nf Y M $ > $ ⟦ G ⊢ e ≡ M : S ⟧ $;

-- Quotients (audit §4) -----------------------------------------------------
-- The kernel's types of the primitives (`Quot.lift`'s mentions `Eq`), and
-- `Quot.lift` and `Quot.ind` reduce on `Quot.mk`.

--| `Quot : Π (α : Sort u). (α → α → Prop) → Sort u`
axiom quot_ty (G: ctx) (u: lvl):
  $ ⟨ G ⊢ quot u : Π (srt u). Π (Π #0. Π #1. Prop). srt u ⟩ $;
--| `Quot.mk : Π (α : Sort u) (r : α → α → Prop). α → Quot r`
axiom quot_mk_ty (G: ctx) (u: lvl):
  $ ⟨ G ⊢ quot_mk u : Π (srt u). Π (Π #0. Π #1. Prop). Π #1. quot u @ #2 @ #1 ⟩ $;
--| `Quot.lift : Π (α : Sort u) (r : α → α → Prop) (β : Sort v) (f : α → β).
--|   (Π a b. r a b → Eq (f a) (f b)) → Quot r → β`
axiom quot_lift_ty (G: ctx) (u v: lvl):
  $ ⟨ G ⊢ quot_lift u v : Π (srt u). Π (Π #0. Π #1. Prop). Π (srt v). Π (Π #2. #1).
      Π (Π #3. Π #4. Π (#4 @ #1 @ #0). ind_ty (eq_D v) 0 @ #4 @ (#3 @ #2) @ (#3 @ #1)).
      Π (quot u @ #4 @ #3). #3 ⟩ $;
--| `Quot.ind : Π (α : Sort u) (r : α → α → Prop) (β : Quot r → Prop).
--|   (Π a. β (Quot.mk r a)) → Π q. β q`
axiom quot_ind_ty (G: ctx) (u: lvl):
  $ ⟨ G ⊢ quot_ind u : Π (srt u). Π (Π #0. Π #1. Prop). Π (Π (quot u @ #1 @ #0). Prop).
      Π (Π #2. #1 @ (quot_mk u @ #3 @ #2 @ #0)). Π (quot u @ #3 @ #2). #2 @ #0 ⟩ $;

--| Reduction of `Quot.lift f h (Quot.mk r a)` to `f a` and of
--| `Quot.ind h (Quot.mk r a)` to `h a`, when every argument has its binder's
--| type in the primitive's type (`sty`), as nanoda's `reduce_quot`, which
--| checks only the spine: the typing makes the constructor's `α` and `r` the
--| primitive's.
--| `quot_lift_mk` also takes `a` at `f`'s domain, the typing of its right
--| side's argument: the typing of `Quot.mk r a` as a whole does not give it
--| when `α` is a proposition (audit §4).
axiom quot_lift_mk (G: ctx) (u v: lvl) (x1 x2 x3 x4 x5: expr) (v1: lvl) (y1 y2 a T: expr):
  $ sty G (quot_lift u v) (Π (srt u). Π (Π #0. Π #1. Prop). Π (srt v). Π (Π #2. #1).
      Π (Π #3. Π #4. Π (#4 @ #1 @ #0). ind_ty (eq_D v) 0 @ #4 @ (#3 @ #2) @ (#3 @ #1)).
      Π (quot u @ #4 @ #3). #3)
      (quot_lift u v @ x1 @ x2 @ x3 @ x4 @ x5 @ (quot_mk v1 @ y1 @ y2 @ a)) T $ >
  $ ⟨ G ⊢ a : x1 ⟩ $ >
  $ ⟦ G ⊢ quot_lift u v @ x1 @ x2 @ x3 @ x4 @ x5 @ (quot_mk v1 @ y1 @ y2 @ a) ≡ x4 @ a : T ⟧ $;
axiom quot_ind_mk (G: ctx) (u: lvl) (x1 x2 x3 x4: expr) (v1: lvl) (y1 y2 a T: expr):
  $ sty G (quot_ind u) (Π (srt u). Π (Π #0. Π #1. Prop). Π (Π (quot u @ #1 @ #0). Prop).
      Π (Π #2. #1 @ (quot_mk u @ #3 @ #2 @ #0)). Π (quot u @ #3 @ #2). #2 @ #0)
      (quot_ind u @ x1 @ x2 @ x3 @ x4 @ (quot_mk v1 @ y1 @ y2 @ a)) T $ >
  $ ⟦ G ⊢ quot_ind u @ x1 @ x2 @ x3 @ x4 @ (quot_mk v1 @ y1 @ y2 @ a) ≡ x4 @ a : T ⟧ $;

-- Literals (audit §5) ------------------------------------------------------
-- The ties to Lean's `Nat`, and the value of each accelerated operation on
-- literals, given its defining equations (Part II), with the value forced by
-- a binary-arithmetic premise.

--| The literal `0` is `Nat.zero`, and `n+1` is `Nat.succ n`.
axiom lit_zero (G: ctx): $ ⟦ G ⊢ lit b0 ≡ ind_ctor nat_D 0 0 : ind_ty nat_D 0 ⟧ $;
axiom lit_succ (G: ctx) (a b: bin):
  $ bsucc a b $ > $ ⟦ G ⊢ lit b ≡ ind_ctor nat_D 0 1 @ lit a : ind_ty nat_D 0 ⟧ $;

--| `f a b ≡ a + b` on literals, with `f` Lean's `Nat.add` (`add_eqs`, Part II).
axiom nat_add_lit (G: ctx) (f: expr) (a b c: bin):
  $ add_eqs G f $ > $ badd a b c $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
--| `f a b ≡ a - b` on literals: `c + b = a`, or `a + c = b` and the difference is 0.
axiom nat_sub_lit (G: ctx) (f p: expr) (a b c: bin):
  $ sub_eqs G f p $ > $ badd c b a $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
axiom nat_sub_lit0 (G: ctx) (f p: expr) (a b c: bin):
  $ sub_eqs G f p $ > $ badd a c b $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit b0 : ℕ ⟧ $;
--| `f a b ≡ a · b` on literals.
axiom nat_mul_lit (G: ctx) (f fa: expr) (a b c: bin):
  $ mul_eqs G f fa $ > $ bmul a b c $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
--| `f a b ≡ a ^ b` on literals.
axiom nat_pow_lit (G: ctx) (f fm fa: expr) (a b c: bin):
  $ pow_eqs G f fm fa $ > $ bpow a b c $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
--| `f a a ≡ t`, and `f a b ≡ u` when `a + c + 1 = b` or `b + c + 1 = a`.
axiom nat_beq_lit (G: ctx) (f B t u: expr) (a: bin):
  $ beq_eqs G f B t u $ > $ ⟦ G ⊢ f @ lit a @ lit a ≡ t : B ⟧ $;
axiom nat_beq_lit_lt (G: ctx) (f B t u: expr) (a b c: bin):
  $ beq_eqs G f B t u $ > $ baddc a c b $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ u : B ⟧ $;
axiom nat_beq_lit_gt (G: ctx) (f B t u: expr) (a b c: bin):
  $ beq_eqs G f B t u $ > $ baddc b c a $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ u : B ⟧ $;
--| `f a b ≡ t` when `a + c = b`, and `≡ u` when `b + c + 1 = a`.
axiom nat_ble_lit (G: ctx) (f B t u: expr) (a b c: bin):
  $ ble_eqs G f B t u $ > $ badd a c b $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ t : B ⟧ $;
axiom nat_ble_lit_gt (G: ctx) (f B t u: expr) (a b c: bin):
  $ ble_eqs G f B t u $ > $ baddc b c a $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ u : B ⟧ $;
--| `f a b ≡ a · 2^b` on literals.
axiom nat_shl_lit (G: ctx) (f fm fa: expr) (a b p c: bin):
  $ shl_eqs G f fm fa $ > $ bpow (bd0 (bd1 b0)) b p $ > $ bmul a p c $ >
  $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
--| `f a b` on literals, a shift at a time: `f a 0 ≡ a`, and `f a (b+1) ≡ c2` from
--| `f a b ≡ c` and `fd c 2 ≡ c2` (the division by 2, as the certificate derives it).
axiom nat_shr_lit_z (G: ctx) (f fd: expr) (a: bin):
  $ shr_eqs G f fd $ > $ ⟦ G ⊢ f @ lit a @ lit b0 ≡ lit a : ℕ ⟧ $;
axiom nat_shr_lit_s (G: ctx) (f fd: expr) (a b b2 c c2: bin):
  $ shr_eqs G f fd $ > $ bsucc b b2 $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $ >
  $ ⟦ G ⊢ fd @ lit c @ lit (bd0 (bd1 b0)) ≡ lit c2 : ℕ ⟧ $ >
  $ ⟦ G ⊢ f @ lit a @ lit b2 ≡ lit c2 : ℕ ⟧ $;
--| `f a b ≡ q` on literals when `q·b + r = a` and `r < b`, and `f a 0 ≡ 0`.
axiom nat_div_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem: expr) (a b q m r x: bin):
  $ div_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem $ >
  $ bmul q b m $ > $ badd m r a $ > $ baddc r x b $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit q : ℕ ⟧ $;
axiom nat_div_lit0 (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem: expr) (a: bin):
  $ div_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p f go pfs lem $ >
  $ ⟦ G ⊢ f @ lit a @ lit0 ≡ lit0 : ℕ ⟧ $;
--| `f a b ≡ r` on literals when `q·b + r = a` and `r < b`, and `f a 0 ≡ a`.
axiom nat_mod_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem: expr) (a b q m r x: bin):
  $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem $ >
  $ bmul q b m $ > $ badd m r a $ > $ baddc r x b $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit r : ℕ ⟧ $;
axiom nat_mod_lit0 (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem: expr) (a: bin):
  $ mod_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite f go pfs lem $ >
  $ ⟦ G ⊢ f @ lit a @ lit0 ≡ lit a : ℕ ⟧ $;
--| `f a b ≡ g` on literals when `g` divides `a` and `b` and `x·a = y·b + g`
--| (or `y·b = x·a + g`).
axiom nat_gcd_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem eqN deqN beq pq bp bd fix go eager al motive hm ltN pfx pfgo f pack F pfF: expr) (a b g p2 q x y m n: bin):
  $ gcd_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem eqN deqN beq pq bp bd fix go eager al motive hm ltN pfx pfgo f pack F pfF $ >
  $ bmul g p2 a $ > $ bmul g q b $ > $ bmul x a m $ > $ bmul y b n $ > $ badd n g m $ >
  $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit g : ℕ ⟧ $;
axiom nat_gcd_lit2 (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem eqN deqN beq pq bp bd fix go eager al motive hm ltN pfx pfgo f pack F pfF: expr) (a b g p2 q x y m n: bin):
  $ gcd_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p ite fm gom pfs lem eqN deqN beq pq bp bd fix go eager al motive hm ltN pfx pfgo f pack F pfF $ >
  $ bmul g p2 a $ > $ bmul g q b $ > $ bmul x a m $ > $ bmul y b n $ > $ badd m g n $ >
  $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit g : ℕ ⟧ $;
--| `f a b` on literals for the truth tables of and, or and xor.
axiom nat_land_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf: expr) (a b c: bin):
  $ bitop_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf t u u u $ >
  $ band a b c $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
axiom nat_lor_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf: expr) (a b c: bin):
  $ bitop_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf t t t u $ >
  $ bor a b c $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;
axiom nat_xor_lit (G: ctx) (B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf: expr) (a b c: bin):
  $ bitop_eqs G B t u Not Dec dite T R ofT ofF leN dleN ble pf sub p fd god fm gom pfs lem ite eqN deqN beq pq bp bd fa fix go eager al motive hm ltN pfx pfgo fb pack Fb pfB dec f bf u t t u $ >
  $ bxor a b c $ > $ ⟦ G ⊢ f @ lit a @ lit b ≡ lit c : ℕ ⟧ $;

-- Statements ---------------------------------------------------------------

--| `inh G A`: `A` is inhabited in `Γ`. Theorems are stated this way so that
--| their proof terms stay inside the proof file.
term inh: ctx > expr > wff;
axiom inh_i (G: ctx) (e A: expr): $ ⟨ G ⊢ e : A ⟩ $ > $ inh G A $;
