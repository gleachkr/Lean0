delimiter $ ( ) , . $;

--| LeanTT core, transcribed from Lean4Lean (digama0/lean4lean @ 67f63b0):
--|   Theory/VLevel.lean, Theory/VExpr.lean, Theory/Typing/Basic.lean.
--|
--| Deviations from the verbatim presentation (see notes/audit-lean-mm0.md §10):
--| * There is no environment term and no `const` constructor. A Lean
--|   definition is an MM0 `def` returning `expr` whose arguments are its
--|   universe parameters (so δ is MM0 unfolding and `instL` is MM0
--|   substitution). An inductive block is a data term `ind_mk b P T` (a
--|   generated `def X_D (us): ind`), and its types, constructors and recursors
--|   are `ind_ty D i`, `ind_ctor D i c` and `ind_rec D i v`, typed by the
--|   schema below once the certificate proves the block legal (`ind_wf`).
--|   A nested block is the mutual block the kernel checks in its place,
--|   with the nested occurrences restored in what it states (`ind_mkn`).
--|   Axioms and opaques are MM0 `term`s, each with two generated axioms:
--|   its `constDF` instance and `closed k (c us)` for every `k`.
--| * Universe parameters are MM0 variables of sort `lvl`, so the `l.WF U`
--|   side conditions are vacuous and are dropped.
--| * Meta-level operations (liftN, inst, Lookup) are syntax-directed
--|   relations, proved node by node.
--| * Nat literals are a primitive `lit` over binary numerals (an extension;
--|   Lean4Lean unfolds literals to `Nat.succ`/`Nat.zero`), tied to Lean's
--|   `Nat` by `lit_zero`/`lit_succ`.
--| * Lean's `Nat` and `Eq` are the blocks `nat_D` and `eq_D` (data the
--|   checker compares with the export), and the quotient primitives are
--|   constants with the kernel's types and reduction rules.
--| * Two admissible rules are axioms: `instDF` (substitution, Lean4Lean's
--|   theorem `IsDefEq.instN`), so that a substituted term's typing need not
--|   be derived again, and `weakDF` (weakening, `IsDefEq.weakN`), so that a
--|   derivation made in a shorter context can be used in a longer one.
--| * `eeqv_df`: expressions of the same shape at equivalent levels are
--|   definitionally equal (generalizing `sortDF` and `constDF`).
--|
--| Everything here is closed first-order syntax: no sort admits bound
--| variables.
--|
--| Notations: `⊢ Γ, e ≡ e2 : A` for the judgment and `⊩ Γ, e : A` for typing,
--| `λ A. e`, `Π A. B`, `f @ a`, `# i` for a bound variable, `A :: Γ` and `[]`
--| for contexts, `a ⊔ b` for `max`, and `≤`, `<` and `≈` (level equivalence).
--| Each has an ASCII form too (`|- G, e == e2 : A`, `||- G, e : A`, `\ A. e`,
--| `\Pi A. B`, `\/`, `<=`, `~=`), declared first; the Unicode one is declared
--| last, the form Aufbau prints. A term with a notation can still be written as
--| an application (`deq G e e2 A`), as the generated statements are.

--| @hole _wff
strict provable sort wff;

---------------------------------------------------------------------------
-- Unary naturals (de Bruijn indices)
---------------------------------------------------------------------------

--| @hole _n
strict free sort nat;
term z: nat;
term s: nat > nat;

--| `le i n`: i ≤ n.
term le: nat > nat > wff;
infixl le: $<=$ prec 50;
infixl le: $≤$ prec 50;
axiom le_z (n: nat): $ z ≤ n $;
axiom le_s (i n: nat): $ i ≤ n $ > $ s i ≤ s n $;

--| `lt i n`: i < n.
def lt (i n: nat): wff = $ s i ≤ n $;
infixl lt: $<$ prec 50;

--| `add i n j`: i + n = j.
term add: nat > nat > nat > wff;
axiom add_z (i: nat): $ add i z i $;
axiom add_s (i n j: nat): $ add i n j $ > $ add i (s n) (s j) $;

---------------------------------------------------------------------------
-- Universe levels (VLevel.lean:8-13)
---------------------------------------------------------------------------

--| @hole _l
strict free sort lvl;
term lz: lvl;
term ls: lvl > lvl;
term lmax: lvl > lvl > lvl;
infixl lmax: $\/$ prec 65;
infixl lmax: $⊔$ prec 65;
term limax: lvl > lvl > lvl;

--| `leqv l l2`: a sound approximation of semantic equivalence `l ≈ l2`
--| (VLevel.lean:58, equal evaluation under every assignment of the level
--| variables). Each axiom below is valid under `VLevel.eval`, where
--| `imax a b = if b = 0 then 0 else max a b`. These axioms alone are
--| incomplete (notes/audit-lean-mm0.md); `leqv_cases` below completes them.
term leqv: lvl > lvl > wff;
infixl leqv: $~=$ prec 50;
infixl leqv: $≈$ prec 50;
axiom leqv_refl (a: lvl): $ a ≈ a $;
axiom leqv_symm (a b: lvl): $ a ≈ b $ > $ b ≈ a $;
axiom leqv_trans (a b c: lvl): $ a ≈ b $ > $ b ≈ c $ > $ a ≈ c $;
axiom leqv_succ (a b: lvl): $ a ≈ b $ > $ ls a ≈ ls b $;
axiom leqv_max (a b c d: lvl):
  $ a ≈ b $ > $ c ≈ d $ > $ a ⊔ c ≈ b ⊔ d $;
axiom leqv_imax (a b c d: lvl):
  $ a ≈ b $ > $ c ≈ d $ > $ limax a c ≈ limax b d $;
axiom lmax_comm (a b: lvl): $ a ⊔ b ≈ b ⊔ a $;
axiom lmax_assoc (a b c: lvl): $ a ⊔ b ⊔ c ≈ a ⊔ (b ⊔ c) $;
axiom lmax_idem (a: lvl): $ a ⊔ a ≈ a $;
axiom lmax_zero (a: lvl): $ lz ⊔ a ≈ a $;
axiom lmax_succ (a b: lvl): $ ls a ⊔ ls b ≈ ls (a ⊔ b) $;
axiom lmax_succ_self (a: lvl): $ a ⊔ ls a ≈ ls a $;
axiom limax_zero (a: lvl): $ limax a lz ≈ lz $;
axiom limax_zero_l (a: lvl): $ limax lz a ≈ a $;
--| `imax 1 a = a`: if `a = 0` both are 0, otherwise `max 1 a = a`. nanoda's level `simplify`
--| applies it (and `limax_zero_l`) whenever it puts a `Sort` in weak head normal form.
axiom limax_one (a: lvl): $ limax (ls lz) a ≈ a $;
axiom limax_succ (a b: lvl): $ limax a (ls b) ≈ a ⊔ ls b $;
axiom limax_self (a: lvl): $ limax a a ≈ a $;
axiom limax_max (a b c: lvl):
  $ limax a (b ⊔ c) ≈ limax a b ⊔ limax a c $;
axiom limax_imax (a b c: lvl):
  $ limax a (limax b c) ≈ limax a c ⊔ limax b c $;

--| Proof by cases on a universe parameter. A case split must substitute the
--| parameter inside an arbitrary level, which cannot be stated over MM0
--| variables. So a goal's variables are first abstracted to object-level
--| parameters `lparam i` (`leqv_inst` puts the original levels back), and
--| `leqv_cases` splits on one of those. The semantics of `leqv` (equal value
--| under every assignment) covers `lparam`s like any other level variable. With
--| the axioms above for the `imax`-free cases, this decides `leqv` completely
--| (notes/audit-lean-mm0.md §4). `lparam` only ever occurs inside `leqv` proofs.
term lparam: nat > lvl;

--| Lists of levels.
--| @hole _ls
strict free sort lvls;
term lnil: lvls;
term lcons: lvl > lvls > lvls;

--| `lnth S n a`: the `n`th element of `S` is `a`.
term lnth: lvls > nat > lvl > wff;
axiom lnth_z (a: lvl) (S: lvls): $ lnth (lcons a S) z a $;
axiom lnth_s (a b: lvl) (S: lvls) (n: nat): $ lnth S n b $ > $ lnth (lcons a S) (s n) b $;

--| `linst S l l2`: `l2` is `l` with each `lparam i` replaced by the `i`th
--| element of `S`.
term linst: lvls > lvl > lvl > wff;
axiom linst_z (S: lvls): $ linst S lz lz $;
axiom linst_s (S: lvls) (a a2: lvl): $ linst S a a2 $ > $ linst S (ls a) (ls a2) $;
axiom linst_max (S: lvls) (a b a2 b2: lvl):
  $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (a ⊔ b) (a2 ⊔ b2) $;
axiom linst_imax (S: lvls) (a b a2 b2: lvl):
  $ linst S a a2 $ > $ linst S b b2 $ > $ linst S (limax a b) (limax a2 b2) $;
axiom linst_param (S: lvls) (n: nat) (a: lvl): $ lnth S n a $ > $ linst S (lparam n) a $;

--| `lsubst n l a l2`: `l2` is `l` with `lparam n` replaced by `a`.
term lsubst: nat > lvl > lvl > lvl > wff;
axiom lsubst_z (n: nat) (a: lvl): $ lsubst n lz a lz $;
axiom lsubst_s (n: nat) (b a b2: lvl): $ lsubst n b a b2 $ > $ lsubst n (ls b) a (ls b2) $;
axiom lsubst_max (n: nat) (b c a b2 c2: lvl):
  $ lsubst n b a b2 $ > $ lsubst n c a c2 $ > $ lsubst n (b ⊔ c) a (b2 ⊔ c2) $;
axiom lsubst_imax (n: nat) (b c a b2 c2: lvl):
  $ lsubst n b a b2 $ > $ lsubst n c a c2 $ > $ lsubst n (limax b c) a (limax b2 c2) $;
axiom lsubst_eq (n: nat) (a: lvl): $ lsubst n (lparam n) a a $;
axiom lsubst_lt (n m: nat) (a: lvl): $ m < n $ > $ lsubst n (lparam m) a (lparam m) $;
axiom lsubst_gt (n m: nat) (a: lvl): $ n < m $ > $ lsubst n (lparam m) a (lparam m) $;

--| Case split on `lparam n`: zero, or the successor of some level (which is
--| again called `lparam n`).
axiom leqv_cases (n: nat) (l r l0 r0 l1 r1: lvl):
  $ lsubst n l lz l0 $ > $ lsubst n r lz r0 $ > $ l0 ≈ r0 $ >
  $ lsubst n l (ls (lparam n)) l1 $ > $ lsubst n r (ls (lparam n)) r1 $ > $ l1 ≈ r1 $ >
  $ l ≈ r $;
--| Instantiating the parameters of an equivalence.
axiom leqv_inst (S: lvls) (l r l2 r2: lvl):
  $ l ≈ r $ > $ linst S l l2 $ > $ linst S r r2 $ > $ l2 ≈ r2 $;

---------------------------------------------------------------------------
-- Expressions (VExpr.lean:7-13), without `const`
---------------------------------------------------------------------------

--| @hole _e
strict free sort expr;
term bvar: nat > expr;
prefix bvar: $#$ prec max;
term srt: lvl > expr;
term app: expr > expr > expr;
infixl app: $@$ prec 1000;
term lam: expr > expr > expr;
notation lam (A e: expr): expr = ($\$:20) A ($.$:0) e;
notation lam (A e: expr): expr = ($λ$:20) A ($.$:0) e;
--| `forallE` in Lean4Lean.
term pi: expr > expr > expr;
notation pi (A B: expr): expr = ($\Pi$:20) A ($.$:0) B;
notation pi (A B: expr): expr = ($Π$:20) A ($.$:0) B;

--| `closed k e`: every loose bound variable of `e` is below `k`
--| (`ClosedN e k`, VExpr.lean:99-104).
term closed: nat > expr > wff;
axiom closed_bvar (i k: nat): $ i < k $ > $ closed k # i $;
axiom closed_srt (k: nat) (l: lvl): $ closed k (srt l) $;
axiom closed_app (k: nat) (f a: expr):
  $ closed k f $ > $ closed k a $ > $ closed k (f @ a) $;
axiom closed_lam (k: nat) (A b: expr):
  $ closed k A $ > $ closed (s k) b $ > $ closed k (λ A. b) $;
axiom closed_pi (k: nat) (A b: expr):
  $ closed k A $ > $ closed (s k) b $ > $ closed k (Π A. b) $;

--| `lift n k e e2`: `e2 = liftN n e k` (VExpr.lean:17, 38-44).
term lift: nat > nat > expr > expr > wff;
axiom lift_bvar_lt (n k i: nat): $ i < k $ > $ lift n k # i # i $;
axiom lift_bvar_ge (n k i j: nat):
  $ k ≤ i $ > $ add i n j $ > $ lift n k # i # j $;
axiom lift_srt (n k: nat) (l: lvl): $ lift n k (srt l) (srt l) $;
axiom lift_app (n k: nat) (f a f2 a2: expr):
  $ lift n k f f2 $ > $ lift n k a a2 $ > $ lift n k (f @ a) (f2 @ a2) $;
axiom lift_lam (n k: nat) (A b A2 b2: expr):
  $ lift n k A A2 $ > $ lift n (s k) b b2 $ > $ lift n k (λ A. b) (λ A2. b2) $;
axiom lift_pi (n k: nat) (A b A2 b2: expr):
  $ lift n k A A2 $ > $ lift n (s k) b b2 $ > $ lift n k (Π A. b) (Π A2. b2) $;
--| Admissible (by induction on `e`): `ClosedN.liftN_eq`, VExpr.lean:117.
axiom lift_closed (n j k: nat) (e: expr):
  $ closed j e $ > $ j ≤ k $ > $ lift n k e e $;

--| `inst k e a e2`: `e2 = inst e a k` (VExpr.lean:187-188, 240-246).
term inst: nat > expr > expr > expr > wff;
axiom inst_bvar_lt (k i: nat) (a: expr): $ i < k $ > $ inst k # i a # i $;
axiom inst_bvar_eq (k: nat) (a a2: expr): $ lift k z a a2 $ > $ inst k # k a a2 $;
axiom inst_bvar_gt (k i: nat) (a: expr):
  $ k ≤ i $ > $ inst k # (s i) a # i $;
axiom inst_srt (k: nat) (l: lvl) (a: expr): $ inst k (srt l) a (srt l) $;
axiom inst_app (k: nat) (f x a f2 x2: expr):
  $ inst k f a f2 $ > $ inst k x a x2 $ > $ inst k (f @ x) a (f2 @ x2) $;
axiom inst_lam (k: nat) (A b a A2 b2: expr):
  $ inst k A a A2 $ > $ inst (s k) b a b2 $ > $ inst k (λ A. b) a (λ A2. b2) $;
axiom inst_pi (k: nat) (A b a A2 b2: expr):
  $ inst k A a A2 $ > $ inst (s k) b a b2 $ > $ inst k (Π A. b) a (Π A2. b2) $;
--| Admissible (by induction on `e`): `ClosedN.instN_eq`, VExpr.lean:482.
axiom inst_closed (j k: nat) (e a: expr):
  $ closed j e $ > $ j ≤ k $ > $ inst k e a e $;

---------------------------------------------------------------------------
-- Contexts (Typing/Basic.lean:6-8)
---------------------------------------------------------------------------

--| Innermost binder first; each entry is a type relative to the tail.
--| @hole _G
strict free sort ctx;
term nil: ctx;
prefix nil: $[]$ prec max;
term cons: expr > ctx > ctx;
infixr cons: $::$ prec 60;

term lookup: ctx > nat > expr > wff;
axiom lookup_z (A A2: expr) (G: ctx):
  $ lift (s z) z A A2 $ > $ lookup (A :: G) z A2 $;
axiom lookup_s (A B B2: expr) (G: ctx) (n: nat):
  $ lookup G n B $ > $ lift (s z) z B B2 $ > $ lookup (A :: G) (s n) B2 $;

--| `cinst k G0 A0 a G1 G`: `G1` is `G0` extended by `A0` and then `k` more
--| entries, and `G` is `G1` without `A0`, with `a` substituted for it in the
--| `k` entries above it (`Ctx.InstN`, Typing/Lemmas.lean:86).
term cinst: nat > ctx > expr > expr > ctx > ctx > wff;
axiom cinst_z (G0: ctx) (A0 a: expr): $ cinst z G0 A0 a (A0 :: G0) G0 $;
axiom cinst_s (k: nat) (G0 G1 G: ctx) (A0 a A A2: expr):
  $ cinst k G0 A0 a G1 G $ > $ inst k A a A2 $ >
  $ cinst (s k) G0 A0 a (A :: G1) (A2 :: G) $;

--| `cext n G G2`: `G2` is `G` extended by `n` more entries
--| (`Ctx.LiftN n 0 G G2`, the `zero` case, Typing/Lemmas.lean:9).
term cext: nat > ctx > ctx > wff;
axiom cext_z (G: ctx): $ cext z G G $;
axiom cext_s (n: nat) (G G2: ctx) (A: expr):
  $ cext n G G2 $ > $ cext (s n) G (A :: G2) $;

---------------------------------------------------------------------------
-- The judgment `Γ ⊢ e ≡ e2 : A` (IsDefEq, Typing/Basic.lean:18-56)
---------------------------------------------------------------------------

term deq: ctx > expr > expr > expr > wff;
notation deq (G: ctx) (e e2 A: expr): wff = ($|-$:0) G ($,$:0) e ($==$:0) e2 ($:$:0) A;
notation deq (G: ctx) (e e2 A: expr): wff = ($⊢$:0) G ($,$:0) e ($≡$:0) e2 ($:$:0) A;

--| `Γ ⊢ e : A` is the diagonal of the judgment.
def ty (G: ctx) (e A: expr): wff = $ ⊢ G, e ≡ e : A $;
notation ty (G: ctx) (e A: expr): wff = ($||-$:0) G ($,$:0) e ($:$:0) A;
notation ty (G: ctx) (e A: expr): wff = ($⊩$:0) G ($,$:0) e ($:$:0) A;

axiom bvar (G: ctx) (i: nat) (A: expr):
  $ lookup G i A $ > $ ⊢ G, # i ≡ # i : A $;
axiom symm (G: ctx) (e e2 A: expr):
  $ ⊢ G, e ≡ e2 : A $ > $ ⊢ G, e2 ≡ e : A $;
axiom trans (G: ctx) (e1 e2 e3 A: expr):
  $ ⊢ G, e1 ≡ e2 : A $ > $ ⊢ G, e2 ≡ e3 : A $ > $ ⊢ G, e1 ≡ e3 : A $;
axiom sortDF (G: ctx) (l l2: lvl):
  $ l ≈ l2 $ > $ ⊢ G, srt l ≡ srt l2 : srt (ls l) $;
axiom appDF (G: ctx) (f f2 A B a a2 R: expr):
  $ ⊢ G, f ≡ f2 : Π A. B $ > $ ⊢ G, a ≡ a2 : A $ > $ inst z B a R $ >
  $ ⊢ G, f @ a ≡ f2 @ a2 : R $;
axiom lamDF (G: ctx) (u: lvl) (A A2 b b2 B: expr):
  $ ⊢ G, A ≡ A2 : srt u $ > $ ⊢ A :: G, b ≡ b2 : B $ >
  $ ⊢ G, λ A. b ≡ λ A2. b2 : Π A. B $;
axiom forallEDF (G: ctx) (u v: lvl) (A A2 B B2: expr):
  $ ⊢ G, A ≡ A2 : srt u $ > $ ⊢ A :: G, B ≡ B2 : srt v $ >
  $ ⊢ G, Π A. B ≡ Π A2. B2 : srt (limax u v) $;
axiom defeqDF (G: ctx) (u: lvl) (A B e e2: expr):
  $ ⊢ G, A ≡ B : srt u $ > $ ⊢ G, e ≡ e2 : A $ > $ ⊢ G, e ≡ e2 : B $;
axiom beta (G: ctx) (A e B a r R: expr):
  $ ⊢ A :: G, e ≡ e : B $ > $ ⊢ G, a ≡ a : A $ > $ inst z e a r $ > $ inst z B a R $ >
  $ ⊢ G, (λ A. e) @ a ≡ r : R $;
axiom eta (G: ctx) (A B e e1: expr):
  $ ⊢ G, e ≡ e : Π A. B $ > $ lift (s z) z e e1 $ >
  $ ⊢ G, λ A. e1 @ # z ≡ e : Π A. B $;
axiom proofIrrel (G: ctx) (p h h2: expr):
  $ ⊢ G, p ≡ p : srt lz $ > $ ⊢ G, h ≡ h : p $ > $ ⊢ G, h2 ≡ h2 : p $ >
  $ ⊢ G, h ≡ h2 : p $;

---------------------------------------------------------------------------
-- Admissible rules (theorems of Lean4Lean, here axioms)
---------------------------------------------------------------------------

--| Substitution: `IsDefEq.instN`, Typing/Lemmas.lean:634 (see
--| notes/audit-lean-mm0.md §6).
axiom instDF (k: nat) (G0 G1 G: ctx) (A0 a e e2 A r r2 R: expr):
  $ ⊢ G0, a ≡ a : A0 $ > $ cinst k G0 A0 a G1 G $ > $ ⊢ G1, e ≡ e2 : A $ >
  $ inst k e a r $ > $ inst k e2 a r2 $ > $ inst k A a R $ >
  $ ⊢ G, r ≡ r2 : R $;

--| Weakening: `IsDefEq.weakN`, Typing/Lemmas.lean:501, for `Ctx.LiftN n 0`
--| (see notes/audit-lean-mm0.md §6).
axiom weakDF (n: nat) (G G2: ctx) (e e2 A r r2 R: expr):
  $ ⊢ G, e ≡ e2 : A $ > $ cext n G G2 $ >
  $ lift n z e r $ > $ lift n z e2 r2 $ > $ lift n z A R $ >
  $ ⊢ G2, r ≡ r2 : R $;

---------------------------------------------------------------------------
-- Nat literals (notes/audit-lean-mm0.md §5; an extension of Lean4Lean's theory)
---------------------------------------------------------------------------

--| Binary numerals: `b0` is 0, `bd0 n` is 2n and `bd1 n` is 2n+1. Each
--| relation below is syntax-directed, and each axiom is true when every
--| numeral is read as its value (so a non-canonical numeral such as
--| `bd0 b0` is harmless; generated proofs only use canonical ones).
--| @hole _b
strict free sort bin;
term b0: bin;
term bd0: bin > bin;
term bd1: bin > bin;

--| `bsucc a b`: a + 1 = b.
term bsucc: bin > bin > wff;
axiom bsucc_0: $ bsucc b0 (bd1 b0) $;
axiom bsucc_d0 (a: bin): $ bsucc (bd0 a) (bd1 a) $;
axiom bsucc_d1 (a b: bin): $ bsucc a b $ > $ bsucc (bd1 a) (bd0 b) $;

--| `bdbl a b`: 2a = b (`bd0`, except that 2·0 is `b0`).
term bdbl: bin > bin > wff;
axiom bdbl_0: $ bdbl b0 b0 $;
axiom bdbl_d0 (a: bin): $ bdbl (bd0 a) (bd0 (bd0 a)) $;
axiom bdbl_d1 (a: bin): $ bdbl (bd1 a) (bd0 (bd1 a)) $;

--| `badd a b c`: a + b = c. `baddc a b c`: a + b + 1 = c (with carry).
term badd: bin > bin > bin > wff;
term baddc: bin > bin > bin > wff;
axiom badd_0l (b: bin): $ badd b0 b b $;
axiom badd_0r (a: bin): $ badd a b0 a $;
axiom badd_00 (a b c: bin): $ badd a b c $ > $ badd (bd0 a) (bd0 b) (bd0 c) $;
axiom badd_01 (a b c: bin): $ badd a b c $ > $ badd (bd0 a) (bd1 b) (bd1 c) $;
axiom badd_10 (a b c: bin): $ badd a b c $ > $ badd (bd1 a) (bd0 b) (bd1 c) $;
axiom badd_11 (a b c: bin): $ baddc a b c $ > $ badd (bd1 a) (bd1 b) (bd0 c) $;
axiom baddc_0l (b c: bin): $ bsucc b c $ > $ baddc b0 b c $;
axiom baddc_0r (a c: bin): $ bsucc a c $ > $ baddc a b0 c $;
axiom baddc_00 (a b c: bin): $ badd a b c $ > $ baddc (bd0 a) (bd0 b) (bd1 c) $;
axiom baddc_01 (a b c: bin): $ baddc a b c $ > $ baddc (bd0 a) (bd1 b) (bd0 c) $;
axiom baddc_10 (a b c: bin): $ baddc a b c $ > $ baddc (bd1 a) (bd0 b) (bd0 c) $;
axiom baddc_11 (a b c: bin): $ baddc a b c $ > $ baddc (bd1 a) (bd1 b) (bd1 c) $;

--| `bmul a b c`: a · b = c (by the bits of `b`).
term bmul: bin > bin > bin > wff;
axiom bmul_0 (a: bin): $ bmul a b0 b0 $;
axiom bmul_d0 (a b c d: bin): $ bmul a b c $ > $ bdbl c d $ > $ bmul a (bd0 b) d $;
axiom bmul_d1 (a b c d e: bin):
  $ bmul a b c $ > $ bdbl c d $ > $ badd d a e $ > $ bmul a (bd1 b) e $;

--| `bpow a b c`: a ^ b = c (by the bits of `b`; 0 ^ 0 = 1).
term bpow: bin > bin > bin > wff;
axiom bpow_0 (a: bin): $ bpow a b0 (bd1 b0) $;
axiom bpow_d0 (a b c d: bin): $ bpow a b c $ > $ bmul c c d $ > $ bpow a (bd0 b) d $;
axiom bpow_d1 (a b c d e: bin):
  $ bpow a b c $ > $ bmul c c d $ > $ bmul d a e $ > $ bpow a (bd1 b) e $;

--| `band a b c`, `bor a b c`, `bxor a b c`: bitwise and, or and exclusive or.
term band: bin > bin > bin > wff;
axiom band_0l (b: bin): $ band b0 b b0 $;
axiom band_0r (a: bin): $ band a b0 b0 $;
axiom band_00 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd0 a) (bd0 b) d $;
axiom band_01 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd0 a) (bd1 b) d $;
axiom band_10 (a b c d: bin): $ band a b c $ > $ bdbl c d $ > $ band (bd1 a) (bd0 b) d $;
axiom band_11 (a b c: bin): $ band a b c $ > $ band (bd1 a) (bd1 b) (bd1 c) $;
term bor: bin > bin > bin > wff;
axiom bor_0l (b: bin): $ bor b0 b b $;
axiom bor_0r (a: bin): $ bor a b0 a $;
axiom bor_00 (a b c: bin): $ bor a b c $ > $ bor (bd0 a) (bd0 b) (bd0 c) $;
axiom bor_01 (a b c: bin): $ bor a b c $ > $ bor (bd0 a) (bd1 b) (bd1 c) $;
axiom bor_10 (a b c: bin): $ bor a b c $ > $ bor (bd1 a) (bd0 b) (bd1 c) $;
axiom bor_11 (a b c: bin): $ bor a b c $ > $ bor (bd1 a) (bd1 b) (bd1 c) $;
term bxor: bin > bin > bin > wff;
axiom bxor_0l (b: bin): $ bxor b0 b b $;
axiom bxor_0r (a: bin): $ bxor a b0 a $;
axiom bxor_00 (a b c d: bin): $ bxor a b c $ > $ bdbl c d $ > $ bxor (bd0 a) (bd0 b) d $;
axiom bxor_01 (a b c: bin): $ bxor a b c $ > $ bxor (bd0 a) (bd1 b) (bd1 c) $;
axiom bxor_10 (a b c: bin): $ bxor a b c $ > $ bxor (bd1 a) (bd0 b) (bd1 c) $;
axiom bxor_11 (a b c d: bin): $ bxor a b c $ > $ bdbl c d $ > $ bxor (bd1 a) (bd1 b) d $;

--| `lit n`: the Nat literal with value `n`, read as `Nat.succ^n Nat.zero`
--| (Lean4Lean's translation of literals). `lit_zero` and `lit_succ` (below,
--| after the inductive schema) relate it to Lean's `Nat`; the axioms for the
--| accelerated operations are generated with each operation (`Nat_add_lit`,
--| ...); see notes/audit-lean-mm0.md.
term lit: bin > expr;
axiom closed_lit (k: nat) (n: bin): $ closed k (lit n) $;

---------------------------------------------------------------------------
-- Inductive types (notes/audit-lean-mm0.md §4; not in Lean4Lean, whose
-- `VInductDecl.WF` is left as `sorry`). A schema: an inductive block is a
-- term of sort `ind`, the certificate proves it well formed (`ind_wf`), and
-- the types, constructors and recursors, their iota rules, projections and
-- structure eta follow from the axioms below. The rules transcribe Lean's
-- kernel (`inductive.cpp`; Lean4Lean's `Inductive/Add.lean` is the port read
-- for this): every relation below is syntax-directed over the declaration.
--
-- A block `ind_mk b P T` has an atom `b` (a `term` of sort `blk` per block,
-- so that structurally equal declarations stay distinct), the parameters as
-- a telescope `P` (a `ctx`: innermost parameter first, each type under the
-- earlier ones) and the types `T`: for each type its type `F` (under `P`:
-- `Π indices. srt l`) and the types of its constructors. A constructor's
-- type `K` is written under `P` and, outside `P`, under the block's `n`
-- types themselves: at depth `d` inside `K`, parameter `q` (0 outermost) is
-- `# (d + np - 1 - q)` and type `j` is `# (d + np + j)`. So "no occurrence
-- of the types being declared" is `closed (d + np)`, and instantiating the
-- types (`sinst`) is `inst`.
--
-- Counting conventions: `np` parameters, `n` types, `m` constructors in all,
-- `nf` fields of a constructor, `nidx` indices of a type; motive `j` is the
-- `j`th binder after the parameters and minor `k` the `k`th after the motives.
---------------------------------------------------------------------------

--| @hole _blk
strict free sort blk;
--| @hole _ind
strict free sort ind;
--| @hole _tys
strict free sort tys;
--| @hole _ctors
strict free sort ctors;
term ind_mk: blk > ctx > tys > ind;
term tnil: tys;
--| `tcons F C T`: a type whose type is `F`, with constructors `C`, then `T`.
term tcons: expr > ctors > tys > tys;
term cnil: ctors;
term ccons: expr > ctors > ctors;

--| Type `i`, constructor `c` of type `i`, and the recursor of type `i` with
--| motives in `srt v`, of a block.
term ind_ty: ind > nat > expr;
term ind_ctor: ind > nat > nat > expr;
term ind_rec: ind > nat > lvl > expr;
--| `proj b i e`: field `i` of `e`, a structure of the block with atom `b`.
term proj: blk > nat > expr > expr;

axiom closed_ind_ty (k: nat) (D: ind) (i: nat): $ closed k (ind_ty D i) $;
axiom closed_ind_ctor (k: nat) (D: ind) (i c: nat): $ closed k (ind_ctor D i c) $;
axiom closed_ind_rec (k: nat) (D: ind) (i: nat) (v: lvl): $ closed k (ind_rec D i v) $;
axiom closed_proj (k: nat) (b: blk) (i: nat) (e: expr):
  $ closed k e $ > $ closed k (proj b i e) $;
axiom lift_proj (n k: nat) (b: blk) (i: nat) (e e2: expr):
  $ lift n k e e2 $ > $ lift n k (proj b i e) (proj b i e2) $;
axiom inst_proj (k: nat) (b: blk) (i: nat) (e a e2: expr):
  $ inst k e a e2 $ > $ inst k (proj b i e) a (proj b i e2) $;

-- Reading the declaration ---------------------------------------------------

--| The parts of a block. (Clauses take a variable `D` and read it through
--| `ind_data`, so that a block named by a definition stays folded.)
term ind_data: ind > blk > ctx > tys > wff;
axiom ind_data_i (b: blk) (P: ctx) (T: tys): $ ind_data (ind_mk b P T) b P T $;

--| `nth_ty T i F C`: type `i` of `T` has type `F` and constructors `C`.
term nth_ty: tys > nat > expr > ctors > wff;
axiom nth_ty_z (F: expr) (C: ctors) (T: tys): $ nth_ty (tcons F C T) z F C $;
axiom nth_ty_s (F F2: expr) (C C2: ctors) (T: tys) (i: nat):
  $ nth_ty T i F C $ > $ nth_ty (tcons F2 C2 T) (s i) F C $;
term nth_ctor: ctors > nat > expr > wff;
axiom nth_ctor_z (K: expr) (C: ctors): $ nth_ctor (ccons K C) z K $;
axiom nth_ctor_s (K K2: expr) (C: ctors) (c: nat):
  $ nth_ctor C c K $ > $ nth_ctor (ccons K2 C) (s c) K $;

--| Lengths: of a context, of a constructor list, and `ntys T n m` for `n`
--| types with `m` constructors in all.
term clen: ctx > nat > wff;
axiom clen_nil: $ clen [] z $;
axiom clen_cons (A: expr) (G: ctx) (n: nat): $ clen G n $ > $ clen (A :: G) (s n) $;
term clen_c: ctors > nat > wff;
axiom clen_c_nil: $ clen_c cnil z $;
axiom clen_c_cons (K: expr) (C: ctors) (n: nat): $ clen_c C n $ > $ clen_c (ccons K C) (s n) $;
term ntys: tys > nat > nat > wff;
axiom ntys_nil: $ ntys tnil z z $;
axiom ntys_cons (F: expr) (C: ctors) (T: tys) (n m c m2: nat):
  $ ntys T n m $ > $ clen_c C c $ > $ add m c m2 $ > $ ntys (tcons F C T) (s n) m2 $;
--| `minor_idx T i c k`: constructor `c` of type `i` has minor premise `k`.
term minor_idx: tys > nat > nat > nat > wff;
axiom minor_idx_z (F: expr) (C: ctors) (T: tys) (c: nat): $ minor_idx (tcons F C T) z c c $;
axiom minor_idx_s (F: expr) (C: ctors) (T: tys) (i c k nc k2: nat):
  $ clen_c C nc $ > $ minor_idx T i c k $ > $ add nc k k2 $ > $ minor_idx (tcons F C T) (s i) c k2 $;
--| `npis e n`: `e` is `n` binders `Π` over an application or a variable.
term npis: expr > nat > wff;
axiom npis_bvar (i: nat): $ npis # i z $;
axiom npis_app (f a: expr): $ npis (f @ a) z $;
axiom npis_pi (A B: expr) (n: nat): $ npis B n $ > $ npis (Π A. B) (s n) $;
--| `nth_pi e i A`: the `i`th binder type of `e`.
term nth_pi: expr > nat > expr > wff;
axiom nth_pi_z (A B: expr): $ nth_pi (Π A. B) z A $;
axiom nth_pi_s (A A2 B: expr) (i: nat): $ nth_pi B i A $ > $ nth_pi (Π A2. B) (s i) A $;
--| `isort F k l`: `F` is `k` binders over `srt l`.
term isort: expr > nat > lvl > wff;
axiom isort_srt (l: lvl): $ isort (srt l) z l $;
axiom isort_pi (A B: expr) (k: nat) (l: lvl): $ isort B k l $ > $ isort (Π A. B) (s k) l $;
--| Derived counts of a block: `ind_arity D np n m`, `nidx D i k` (indices of
--| type `i`) and `nfields D i c nf`.
term ind_arity: ind > nat > nat > nat > wff;
axiom ind_arity_i (D: ind) (b: blk) (P: ctx) (T: tys) (np n m: nat):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ ind_arity D np n m $;
term nidx: ind > nat > nat > wff;
axiom nidx_i (D: ind) (b: blk) (P: ctx) (T: tys) (i k: nat) (F: expr) (C: ctors) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ isort F k l $ > $ nidx D i k $;
term nfields: ind > nat > nat > nat > wff;
axiom nfields_i (D: ind) (b: blk) (P: ctx) (T: tys) (i c nf: nat) (F K: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ npis K nf $ > $ nfields D i c nf $;

-- Telescopes and applications ------------------------------------------------

--| `pis P b T`: `T = Π P. b`; `lams P b T`: `T = λ P. b`; `capp P G G2`:
--| `G2 = P ++ G`.
term pis: ctx > expr > expr > wff;
axiom pis_nil (b: expr): $ pis [] b b $;
axiom pis_cons (A b T: expr) (P: ctx): $ pis P (Π A. b) T $ > $ pis (A :: P) b T $;
term lams: ctx > expr > expr > wff;
axiom lams_nil (b: expr): $ lams [] b b $;
axiom lams_cons (A b T: expr) (P: ctx): $ lams P (λ A. b) T $ > $ lams (A :: P) b T $;
term capp: ctx > ctx > ctx > wff;
axiom capp_nil (G: ctx): $ capp [] G G $;
axiom capp_cons (A: expr) (P G G2: ctx): $ capp P G G2 $ > $ capp (A :: P) G (A :: G2) $;

--| `pargs X d n e`: `e = X @ # (d+n-1) @ ... @ # d` (the `n` variables above
--| depth `d`). `napp f n e`: `e` is `f` applied to `n` arguments. `rehead Y X
--| k e e2`: `e = Y @ a1 .. ak` and `e2 = X @ a1 .. ak`. `drop k e e2`: `e` is
--| `e2` applied to `k` arguments. `argat k e a`: `a` is the `k`th argument of
--| `e` from the outside. `has_arg e a`: `a` is an argument of `e`.
term pargs: expr > nat > nat > expr > wff;
axiom pargs_z (X: expr) (d: nat): $ pargs X d z X $;
axiom pargs_s (X e: expr) (d n: nat): $ pargs X (s d) n e $ > $ pargs X d (s n) (e @ # d) $;
term napp: expr > nat > expr > wff;
axiom napp_z (f: expr): $ napp f z f $;
axiom napp_s (f e a: expr) (n: nat): $ napp f n e $ > $ napp f (s n) (e @ a) $;
term rehead: expr > expr > nat > expr > expr > wff;
axiom rehead_z (Y X: expr): $ rehead Y X z Y X $;
axiom rehead_s (Y X e e2 a: expr) (k: nat): $ rehead Y X k e e2 $ > $ rehead Y X (s k) (e @ a) (e2 @ a) $;
term drop: nat > expr > expr > wff;
axiom drop_z (e: expr): $ drop z e e $;
axiom drop_s (e e2 a: expr) (k: nat): $ drop k e e2 $ > $ drop (s k) (e @ a) e2 $;
term argat: nat > expr > expr > wff;
axiom argat_z (e a: expr): $ argat z (e @ a) a $;
axiom argat_s (e a b: expr) (k: nat): $ argat k e a $ > $ argat (s k) (e @ b) a $;
term has_arg: expr > expr > wff;
axiom has_arg_z (e a: expr): $ has_arg (e @ a) a $;
axiom has_arg_s (e a b: expr): $ has_arg e a $ > $ has_arg (e @ b) a $;
--| `pinst i S A R`: `S` is a block's type or constructor applied to `p0 ..
--| p(np-1)`; `R` is `A` (under `i` binders over the block's parameters) with
--| the parameters put in, outermost first (`p0` at `# (i + np - 1)`, then
--| `p1` at `# (i + np - 2)`, ...: each substituted term is lifted over the
--| binders below it).
term pinst: nat > expr > expr > expr > wff;
axiom pinst_head (i: nat) (D: ind) (j: nat) (A: expr): $ pinst i (ind_ty D j) A A $;
axiom pinst_head_c (i: nat) (D: ind) (j c: nat) (A: expr): $ pinst i (ind_ctor D j c) A A $;
axiom pinst_app (i: nat) (S a A A1 R: expr): $ pinst (s i) S A A1 $ > $ inst i A1 a R $ > $ pinst i (S @ a) A R $;
--| `spine_ty e D j k`: `e` is `ind_ty D j` applied to `k` arguments; `spine_ctor`
--| and `spine_rec` likewise for a constructor and a recursor.
term spine_ty: expr > ind > nat > nat > wff;
axiom spine_ty_z (D: ind) (j: nat): $ spine_ty (ind_ty D j) D j z $;
axiom spine_ty_s (e a: expr) (D: ind) (j k: nat): $ spine_ty e D j k $ > $ spine_ty (e @ a) D j (s k) $;
term spine_ctor: expr > ind > nat > nat > nat > wff;
axiom spine_ctor_z (D: ind) (i c: nat): $ spine_ctor (ind_ctor D i c) D i c z $;
axiom spine_ctor_s (e a: expr) (D: ind) (i c k: nat): $ spine_ctor e D i c k $ > $ spine_ctor (e @ a) D i c (s k) $;
term spine_rec: expr > ind > nat > lvl > nat > wff;
axiom spine_rec_z (D: ind) (i: nat) (v: lvl): $ spine_rec (ind_rec D i v) D i v z $;
axiom spine_rec_s (e a: expr) (D: ind) (i: nat) (v: lvl) (k: nat): $ spine_rec e D i v k $ > $ spine_rec (e @ a) D i v (s k) $;

-- Well-formedness ---------------------------------------------------------------

--| `sinst D j n k e e2`: `e2` is `e` with the variables `# k .. # (k+n-j-1)`
--| replaced by `ind_ty D j .. ind_ty D (n-1)` (the block's types, which are
--| closed).
term sinst: ind > nat > nat > nat > expr > expr > wff;
axiom sinst_done (D: ind) (n k: nat) (e: expr): $ sinst D n n k e e $;
axiom sinst_step (D: ind) (j n k: nat) (e e1 e2: expr):
  $ j < n $ > $ inst k e (ind_ty D j) e1 $ > $ sinst D (s j) n k e1 e2 $ > $ sinst D j n k e e2 $;
--| `iargs k m X A`: `A` is `X` applied to `m` arguments, each `closed k`.
term iargs: nat > nat > expr > expr > wff;
axiom iargs_z (k: nat) (X: expr): $ iargs k z X X $;
axiom iargs_s (k m: nat) (X A a: expr): $ iargs k m X A $ > $ closed k a $ > $ iargs k (s m) X (A @ a) $;
--| `bvar_head e t`: the head of the application `e` is `# t`.
term bvar_head: expr > nat > wff;
axiom bvar_head_z (t: nat): $ bvar_head # t t $;
axiom bvar_head_s (e a: expr) (t: nat): $ bvar_head e t $ > $ bvar_head (e @ a) t $;
--| `indapp D n np d A j`: at depth `d`, `A` is type `j` of the block applied
--| to the parameters and to its indices, which do not mention the block
--| (`isValidIndApp`).
term indapp: ind > nat > nat > nat > expr > nat > wff;
axiom indapp_i (D: ind) (n np d j k t m: nat) (X A: expr):
  $ bvar_head A t $ > $ add d np k $ > $ add k j t $ > $ j < n $ > $ pargs # t d np X $ > $ nidx D j m $ >
  $ iargs k m X A $ > $ indapp D n np d A j $;
--| `ipos D n np d A`: `A` is a positive field type at depth `d`: no occurrence
--| of the block, or `Π` over a domain without one, or a valid occurrence
--| (`checkPositivity`). `recfield D n np d A j`: `A` is a recursive field
--| (`Π ys. ` a valid occurrence of type `j`; `isRecArg`).
term ipos: ind > nat > nat > nat > expr > wff;
axiom ipos_closed (D: ind) (n np d k: nat) (A: expr): $ add d np k $ > $ closed k A $ > $ ipos D n np d A $;
axiom ipos_pi (D: ind) (n np d k: nat) (A B: expr):
  $ add d np k $ > $ closed k A $ > $ ipos D n np (s d) B $ > $ ipos D n np d (Π A. B) $;
axiom ipos_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ ipos D n np d A $;
term recfield: ind > nat > nat > nat > expr > nat > wff;
axiom recfield_pi (D: ind) (n np d j: nat) (A B: expr):
  $ recfield D n np (s d) B j $ > $ recfield D n np d (Π A. B) j $;
axiom recfield_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ recfield D n np d A j $;
--| `ulevel l s`: a field in `srt s` may belong to a type in `srt l`: the type
--| is a proposition, or `s ≤ l`.
term ulevel: lvl > lvl > wff;
axiom ulevel_prop (l u: lvl): $ l ≈ lz $ > $ ulevel l u $;
axiom ulevel_le (l u: lvl): $ l ⊔ u ≈ l $ > $ ulevel l u $;
--| `cwf D n np l i Ctx d K`: `K`, the rest of a constructor type of type `i`
--| at depth `d`, is well formed in `Ctx` (the fields so far, with the block's
--| types put in, over the parameters and `G`): each field type is a type of
--| an allowed level and positive, and the result is type `i` applied to the
--| parameters and indices (`checkConstructors`).
term cwf: ind > nat > nat > lvl > nat > ctx > nat > expr > wff;
axiom cwf_pi (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2: expr) (u: lvl):
  $ add d np k $ > $ sinst D z n k A A2 $ > $ ⊩ Ctx, A2 : srt u $ > $ ulevel l u $ > $ ipos D n np d A $ >
  $ cwf D n np l i (A2 :: Ctx) (s d) B $ > $ cwf D n np l i Ctx d (Π A. B) $;
axiom cwf_res (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d: nat) (K: expr):
  $ indapp D n np d K i $ > $ cwf D n np l i Ctx d K $;
term ctors_wf: ind > nat > nat > lvl > nat > ctx > ctors > wff;
axiom ctors_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ ctors_wf D n np l i Ctx cnil $;
axiom ctors_wf_cons (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (K: expr) (C: ctors):
  $ cwf D n np l i Ctx z K $ > $ ctors_wf D n np l i Ctx C $ > $ ctors_wf D n np l i Ctx (ccons K C) $;
--| `tys_wf D n np l i Ctx T`: the types `i`.. of `T`, in `Ctx = P ++ G`: each
--| type's type is `Π indices. srt l` (all in the same universe `l`,
--| `checkInductiveTypes`) and its constructors are well formed.
term tys_wf: ind > nat > nat > lvl > nat > ctx > tys > wff;
axiom tys_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ tys_wf D n np l i Ctx tnil $;
axiom tys_wf_cons (D: ind) (n np: nat) (l l2: lvl) (i k: nat) (Ctx: ctx) (F: expr) (C: ctors) (T: tys):
  $ isort F k l2 $ > $ l2 ≈ l $ > $ ctors_wf D n np l i Ctx C $ > $ tys_wf D n np l (s i) Ctx T $ >
  $ tys_wf D n np l i Ctx (tcons F C T) $;
--| `ctx_wf G P`: each parameter type is a type over the earlier ones.
term ctx_wf: ctx > ctx > wff;
axiom ctx_wf_nil (G: ctx): $ ctx_wf G [] $;
axiom ctx_wf_cons (G P G2: ctx) (A: expr) (u: lvl):
  $ ctx_wf G P $ > $ capp P G G2 $ > $ ⊩ G2, A : srt u $ > $ ctx_wf G (A :: P) $;
--| `tys_ty Ctx T`: each type's type is a type in `Ctx = P ++ G`.
term tys_ty: ctx > tys > wff;
axiom tys_ty_nil (Ctx: ctx): $ tys_ty Ctx tnil $;
axiom tys_ty_cons (Ctx: ctx) (F: expr) (C: ctors) (T: tys) (u: lvl):
  $ ⊩ Ctx, F : srt u $ > $ tys_ty Ctx T $ > $ tys_ty Ctx (tcons F C T) $;
--| `tys_ok G D`: the parameters are types over the earlier ones and the types'
--| types are types: what typing `ind_ty D i` needs (the kernel adds the types
--| before it checks the constructors; a block whose constructors are not
--| legal denotes a family of empty types).
term tys_ok: ctx > ind > wff;
axiom tys_ok_i (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys):
  $ ind_data D b P T $ > $ ctx_wf G P $ > $ capp P G G2 $ > $ tys_ty G2 T $ > $ tys_ok G D $;
--| A well-formed block, in context `G`.
term ind_wf: ctx > ind > wff;

-- Nested inductive types (`ElimNestedInductive`) ------------------------------------

--| A nested block `ind_mkn b P T N` is the mutual block the kernel checks in
--| its place: `T` lists the declared types and then one auxiliary type per
--| nested occurrence `I Ds` of an earlier block `I` in the constructors (in
--| the kernel's order), and `N` lists the occurrences, each `ind_ty I i @ Ds`
--| written like a constructor type at depth 0 (a `ctx` used as a list; `Ds`
--| mention the block's types). An auxiliary type must have `I`'s type and
--| constructors at `Ds` with the occurrences replaced by the auxiliary types
--| (`spz`), and the kernel adds auxiliary types for all of `I`'s block at
--| once (`nst_ok`). So an auxiliary type denotes the occurrence itself, and
--| the block's constructors, recursors and rules are stated with the
--| occurrences restored (`rst`, the kernel's `restoreNested`): the auxiliary
--| type `ind_ty D j ps is` is read as `I Ds[ps] is` and its constructor
--| `ind_ctor D j c ps fs` as `ind_ctor I i c Ds[ps] fs`. Its recursor is the
--| block's (`X.rec_k` for the `k`th auxiliary type) and reduces on `I`'s
--| constructors (`ind_iota_nst`).
term ind_mkn: blk > ctx > tys > ctx > ind;
axiom ind_data_n (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_data (ind_mkn b P T N) b P T $;
--| `ind_nested D N`: the occurrences of `D` (none for `ind_mk`).
term ind_nested: ind > ctx > wff;
axiom ind_nested_mk (b: blk) (P: ctx) (T: tys): $ ind_nested (ind_mk b P T) [] $;
axiom ind_nested_mkn (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_nested (ind_mkn b P T N) N $;
--| `ndecl N n n0`: `n0` declared types among `n`; `nst_at N n0 j X`: the
--| occurrence of auxiliary type `j`, when the first auxiliary type is `n0`.
term ndecl: ctx > nat > nat > wff;
axiom ndecl_nil (n: nat): $ ndecl [] n n $;
axiom ndecl_cons (X: expr) (N: ctx) (n n0: nat): $ ndecl N n n0 $ > $ ndecl (X :: N) (s n) n0 $;
term nst_at: ctx > nat > nat > expr > wff;
axiom nst_at_z (X: expr) (N: ctx) (j: nat): $ nst_at (X :: N) j j X $;
axiom nst_at_s (X X2: expr) (N: ctx) (n0 j: nat): $ nst_at N (s n0) j X $ > $ nst_at (X2 :: N) n0 j X $;
term aux_of: ind > ctx > nat > expr > wff;
axiom aux_of_i (D: ind) (N: ctx) (j np n m n0: nat) (X: expr):
  $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ nst_at N n0 j X $ > $ aux_of D N j X $;
--| `rst D N e e2`: `e2` is `e` with the auxiliary types and constructors
--| restored: nothing when there are no occurrences (`rst_nil`), else from
--| the outside in, `rst_refl` for the subterms left as they are (the clauses
--| are tried in this order, so that an unknown `e2` is computed).
term rst: ind > ctx > expr > expr > wff;
axiom rst_nil (D: ind) (e: expr): $ rst D [] e e $;
axiom rst_ty (D: ind) (N: ctx) (j np n m na k: nat) (e S X X1 X2 e2: expr):
  $ spine_ty e D j na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D z n np X X1 $ >
  $ add np k na $ > $ drop k e S $ > $ pinst z S X1 X2 $ > $ rehead S X2 k e e2 $ > $ rst D N e e2 $;
axiom rst_ctor (D I: ind) (N: ctx) (j c i np n m na k npi: nat) (e S X X1 X2 Y e2: expr):
  $ spine_ctor e D j c na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D z n np X X1 $ >
  $ add np k na $ > $ drop k e S $ > $ pinst z S X1 X2 $ > $ spine_ty X2 I i npi $ >
  $ rehead (ind_ty I i) (ind_ctor I i c) npi X2 Y $ > $ rehead S Y k e e2 $ > $ rst D N e e2 $;
axiom rst_app (D: ind) (N: ctx) (f a f2 a2: expr): $ rst D N f f2 $ > $ rst D N a a2 $ > $ rst D N (f @ a) (f2 @ a2) $;
axiom rst_lam (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (λ A. b) (λ A2. b2) $;
axiom rst_pi (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (Π A. b) (Π A2. b2) $;
axiom rst_proj (D: ind) (N: ctx) (b: blk) (i: nat) (e e2: expr): $ rst D N e e2 $ > $ rst D N (proj b i e) (proj b i e2) $;
axiom rst_refl (D: ind) (N: ctx) (e: expr): $ rst D N e e $;
term nst_hit: ctx > nat > nat > nat > expr > expr > wff;
--| `nst_hit N j d np e e2`: `e` is an occurrence of `N` (the first entry being
--| auxiliary type `j`) lifted to depth `d` and applied to more arguments,
--| and `e2` its replacement. The entries are tried in order: the first
--| clause fails as a whole when the entry is not `e`'s.
axiom nst_hit_z (X S Y e e2: expr) (N: ctx) (I: ind) (i j d np na npi r a t: nat):
  $ spine_ty X I i npi $ > $ spine_ty e I i na $ > $ add npi r na $ > $ lift d z X S $ > $ drop r e S $ >
  $ add np j a $ > $ add d a t $ > $ pargs # t d np Y $ > $ rehead S Y r e e2 $ > $ nst_hit (X :: N) j d np e e2 $;
axiom nst_hit_s (X e e2: expr) (N: ctx) (j d np: nat): $ nst_hit N (s j) d np e e2 $ > $ nst_hit (X :: N) j d np e e2 $;
--| `spz D N d e e2`: `e2` is `e` (at depth `d` in a constructor type) with
--| each occurrence `I Ds is` of `N` replaced by its auxiliary type
--| `# (d + np + j)` applied to the block's parameters and to `is`
--| (`replaceAllNested`: from the outside in, so `is` stay as they are).
term spz: ind > ctx > nat > expr > expr > wff;
axiom spz_refl (D: ind) (N: ctx) (d: nat) (e: expr): $ spz D N d e e $;
axiom spz_hit (D: ind) (N: ctx) (d np n m n0: nat) (e e2: expr):
  $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ nst_hit N n0 d np e e2 $ > $ spz D N d e e2 $;
axiom spz_app (D: ind) (N: ctx) (d: nat) (f a f2 a2: expr): $ spz D N d f f2 $ > $ spz D N d a a2 $ > $ spz D N d (f @ a) (f2 @ a2) $;
axiom spz_lam (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (λ A. b) (λ A2. b2) $;
axiom spz_pi (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (Π A. b) (Π A2. b2) $;
axiom spz_proj (D: ind) (N: ctx) (d: nat) (b: blk) (i: nat) (e e2: expr): $ spz D N d e e2 $ > $ spz D N d (proj b i e) (proj b i e2) $;
--| `spz_ctors D N I X ni npi C C2`: `C2` is the constructors `C` of a type of
--| `I` at the occurrence `X`, specialized: `I`'s types put in, `I`'s own
--| occurrences restored (it may be nested itself), the parameters replaced
--| by `Ds` (`pinst`), then `spz`.
term spz_ctors: ind > ctx > ind > expr > nat > nat > ctors > ctors > wff;
axiom spz_ctors_nil (D: ind) (N: ctx) (I: ind) (X: expr) (ni npi: nat): $ spz_ctors D N I X ni npi cnil cnil $;
axiom spz_ctors_cons (D I: ind) (N NI: ctx) (X K K1 K2 K3 K4: expr) (ni npi: nat) (C C2: ctors):
  $ sinst I z ni npi K K1 $ > $ ind_nested I NI $ > $ rst I NI K1 K2 $ > $ pinst z X K2 K3 $ > $ spz D N z K3 K4 $ >
  $ spz_ctors D N I X ni npi C C2 $ > $ spz_ctors D N I X ni npi (ccons K C) (ccons K4 C2) $;
--| `aux_data D I X j i`: type `j` of `D` has the type of `I`'s type `i` at
--| `X`'s arguments and its constructors specialized.
term aux_data: ind > ind > expr > nat > nat > wff;
axiom aux_data_i (D I: ind) (b bi: blk) (P Pi N: ctx) (T Ti: tys) (j i npi ni mi: nat) (X F Fi: expr) (C Ci: ctors):
  $ ind_data D b P T $ > $ ind_nested D N $ > $ ind_data I bi Pi Ti $ > $ nth_ty T j F C $ > $ nth_ty Ti i Fi Ci $ >
  $ pinst z X Fi F $ > $ ind_arity I npi ni mi $ > $ spz_ctors D N I X ni npi Ci C $ > $ aux_data D I X j i $;
--| `nst_ok G D j N2`: the occurrences `N2` (from auxiliary type `j` on) come
--| in groups, one per declared type of a well-formed block `I` in order with
--| the same arguments (`nst_group`, types `i` to `ni0`; `I.all` excludes
--| `I`'s own auxiliary types), each with the data above.
term nst_ok: ctx > ind > nat > ctx > wff;
term nst_group: ctx > ind > ind > expr > nat > nat > nat > ctx > ctx > wff;
axiom nst_ok_nil (G: ctx) (D: ind) (j: nat): $ nst_ok G D j [] $;
axiom nst_ok_cons (G: ctx) (D I: ind) (j j2 npi ni mi ni0: nat) (X: expr) (N2 N3 NI: ctx):
  $ spine_ty X I z npi $ > $ ind_wf G I $ > $ ind_arity I npi ni mi $ > $ ind_nested I NI $ > $ ndecl NI ni ni0 $ >
  $ nst_group G D I X j z ni0 (X :: N2) N3 $ > $ add j ni0 j2 $ > $ nst_ok G D j2 N3 $ > $ nst_ok G D j (X :: N2) $;
axiom nst_group_done (G: ctx) (D I: ind) (X0: expr) (j ni: nat) (N: ctx): $ nst_group G D I X0 j ni ni N N $;
axiom nst_group_cons (G: ctx) (D I: ind) (X0 X: expr) (j i ni npi: nat) (N N2: ctx):
  $ i < ni $ > $ spine_ty X0 I z npi $ > $ rehead (ind_ty I z) (ind_ty I i) npi X0 X $ > $ aux_data D I X j i $ >
  $ nst_group G D I X0 (s j) (s i) ni N N2 $ > $ nst_group G D I X0 j i ni (X :: N) N2 $;

--| A well-formed block, in context `G` (`l`, the block's universe, is the first
--| type's).
axiom ind_wf_i (G G2: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (np n m k n0: nat) (l: lvl) (F: expr) (C: ctors):
  $ tys_ok G D $ > $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ >
  $ nth_ty T z F C $ > $ isort F k l $ > $ tys_wf D n np l z G2 T $ >
  $ ind_nested D N $ > $ ndecl N n n0 $ > $ nst_ok G D n0 N $ > $ ind_wf G D $;

-- The elimination level (`isLargeEliminator`) --------------------------------------

--| `elim_ok G D v`: the recursor may have motives in `srt v`: always for
--| `v ≈ 0`; for every `v` when the types are never propositions, or the block
--| is one type with no constructors, or one type with one constructor whose
--| fields that are not propositions all appear as arguments of its result.
term large: ctx > ind > wff;
term fir: ind > nat > ctx > nat > expr > wff;
term leaf_has: nat > expr > wff;
term elim_ok: ctx > ind > lvl > wff;
axiom elim_prop (G: ctx) (D: ind) (v: lvl): $ v ≈ lz $ > $ elim_ok G D v $;
axiom elim_large (G: ctx) (D: ind) (v: lvl): $ large G D $ > $ elim_ok G D v $;
axiom large_nz (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (k: nat) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T z F C $ > $ isort F k l $ > $ ls lz ⊔ l ≈ l $ > $ large G D $;
axiom large_empty (G: ctx) (D: ind) (b: blk) (P: ctx) (F: expr):
  $ ind_data D b P (tcons F cnil tnil) $ > $ large G D $;
axiom large_single (G G2: ctx) (D: ind) (b: blk) (P: ctx) (F K: expr) (np: nat):
  $ ind_data D b P (tcons F (ccons K cnil) tnil) $ > $ clen P np $ > $ capp P G G2 $ > $ fir D np G2 z K $ >
  $ large G D $;
--| `fir D np Ctx d K`: each remaining field is a proposition or an argument
--| of the result; `leaf_has j e`: `# j` (at the binder's depth) is an argument
--| of the result under the remaining binders.
axiom fir_res (D: ind) (np: nat) (Ctx: ctx) (d: nat) (K: expr):
  $ indapp D (s z) np d K z $ > $ fir D np Ctx d K $;
axiom fir_arg (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr):
  $ leaf_has z B $ > $ add d np k $ > $ sinst D z (s z) k A A2 $ > $ fir D np (A2 :: Ctx) (s d) B $ >
  $ fir D np Ctx d (Π A. B) $;
axiom fir_prop (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr):
  $ add d np k $ > $ sinst D z (s z) k A A2 $ > $ ⊩ Ctx, A2 : srt lz $ > $ fir D np (A2 :: Ctx) (s d) B $ >
  $ fir D np Ctx d (Π A. B) $;
axiom leaf_has_pi (j: nat) (A B: expr): $ leaf_has (s j) B $ > $ leaf_has j (Π A. B) $;
axiom leaf_has_app (j: nat) (e: expr): $ has_arg e # j $ > $ leaf_has j e $;

-- The recursor's type (`mkRecInfos`) ---------------------------------------------

--| `mty D np j d v F M`: `M` is the type of motive `j`, read off `F` (the
--| type's type lifted over the `j` earlier motives) at depth `d`:
--| `Π indices. Π (ind_ty D j params indices). srt v`.
term mty: ind > nat > nat > nat > lvl > expr > expr > wff;
axiom mty_pi (D: ind) (np j d: nat) (v: lvl) (A B M: expr):
  $ mty D np j (s d) v B M $ > $ mty D np j d v (Π A. B) (Π A. M) $;
axiom mty_srt (D: ind) (np j d k: nat) (v l: lvl) (X I: expr):
  $ add d j k $ > $ pargs (ind_ty D j) k np X $ > $ pargs X z d I $ > $ mty D np j d v (srt l) (Π I. srt v) $;
--| `motives D np v j T M`: the motives of the types `j`.. of `T`, as a context
--| (innermost first; motive `j` outermost).
term motives: ind > nat > lvl > nat > tys > ctx > wff;
axiom motives_nil (D: ind) (np j: nat) (v: lvl): $ motives D np v j tnil [] $;
axiom motives_cons (D: ind) (np j: nat) (v: lvl) (F F2 Mj: expr) (C: ctors) (T: tys) (Mr M: ctx):
  $ lift j z F F2 $ > $ mty D np j z v F2 Mj $ > $ motives D np v (s j) T Mr $ > $ capp Mr (Mj :: []) M $ >
  $ motives D np v j (tcons F C T) M $;
--| `ihty D np n mo fld y A IH`: the type of the inductive hypothesis for a
--| recursive field of type `A = Π ys. ind_ty D j params indices` (`A` already
--| over the fields and the minors before it): `Π ys. motive_j indices (field
--| ys)`, with the motives `mo` binders above depth 0 and the field at `# fld`.
term ihty: ind > nat > nat > nat > nat > nat > expr > expr > wff;
axiom ihty_pi (D: ind) (np n mo fld y: nat) (A B IH: expr):
  $ ihty D np n mo fld (s y) B IH $ > $ ihty D np n mo fld y (Π A. B) (Π A. IH) $;
axiom ihty_app (D: ind) (np n mo fld y j ni k a b mj f: nat) (Y X U A: expr):
  $ spine_ty A D j k $ > $ nidx D j ni $ > $ add np ni k $ > $ rehead Y # mj ni A X $ > $ napp (ind_ty D j) np Y $ >
  $ add y mo a $ > $ add a n b $ > $ add mj (s j) b $ > $ add y fld f $ > $ pargs # f z y U $ >
  $ ihty D np n mo fld y A (X @ U) $;
--| `mwalk D np n k i c nf d r Ihs K Min`: `Min` is the rest of the type of
--| minor `k` (for constructor `c` of type `i`, with `nf` fields), read off
--| the constructor type `K` at depth `d`, after `r` recursive fields whose
--| inductive hypotheses are `Ihs` (innermost first): `Π fields. Π Ihs. motive_i indices
--| (ind_ctor D i c params fields)`. Field types are put over the minors and
--| motives (`lift`, with the block's types put in).
term mwalk: ind > nat > nat > nat > nat > nat > nat > nat > nat > ctx > expr > expr > wff;
axiom mwalk_pi_nr (D: ind) (np n k i c nf d r dp kn: nat) (Ihs: ctx) (A A3 B Min: expr):
  $ add d np dp $ > $ closed dp A $ > $ add k n kn $ > $ lift kn d A A3 $ >
  $ mwalk D np n k i c nf (s d) r Ihs B Min $ > $ mwalk D np n k i c nf d r Ihs (Π A. B) (Π A3. Min) $;
axiom mwalk_pi_rec (D: ind) (np n k i c nf d r dp kn j a sh fld mo: nat) (Ihs: ctx) (A A2 A3 A4 B IH Min: expr):
  $ add d np dp $ > $ recfield D n np d A j $ > $ sinst D z n dp A A2 $ > $ add k n kn $ > $ lift kn d A2 A3 $ >
  $ add r nf a $ > $ add sh d a $ > $ add fld (s z) sh $ > $ add a k mo $ > $ lift sh z A3 A4 $ >
  $ ihty D np n mo fld z A4 IH $ >
  $ mwalk D np n k i c nf (s d) (s r) (IH :: Ihs) B Min $ > $ mwalk D np n k i c nf d r Ihs (Π A. B) (Π A3. Min) $;
axiom mwalk_res (D: ind) (np n k i c d r dp kn h0 h1 h ni mi a b: nat) (Ihs: ctx) (K K2 K3 Y X Y1 Y2 Min: expr):
  $ add d np dp $ > $ add k n kn $ > $ add dp i h0 $ > $ add h0 kn h1 $ > $ add h1 r h $ >
  $ lift kn d K K2 $ > $ lift r z K2 K3 $ > $ nidx D i ni $ > $ rehead Y # mi ni K3 X $ > $ napp # h np Y $ >
  $ add r d a $ > $ add a kn b $ > $ add mi (s i) b $ > $ pargs (ind_ctor D i c) b np Y1 $ > $ pargs Y1 r d Y2 $ >
  $ pis Ihs (X @ Y2) Min $ > $ mwalk D np n k i c d d r Ihs K Min $;
--| `cminors D np n k i c C M`: the minors of constructors `c`.. (`C`) of type
--| `i`, from minor `k`; `minors D np n k i T M`: of types `i`.. (`T`). Both
--| as contexts, innermost first.
term cminors: ind > nat > nat > nat > nat > nat > ctors > ctx > wff;
axiom cminors_nil (D: ind) (np n k i c: nat): $ cminors D np n k i c cnil [] $;
axiom cminors_cons (D: ind) (np n k i c nf: nat) (K Min: expr) (C: ctors) (M1 M: ctx):
  $ npis K nf $ > $ mwalk D np n k i c nf z z [] K Min $ > $ cminors D np n (s k) i (s c) C M1 $ >
  $ capp M1 (Min :: []) M $ > $ cminors D np n k i c (ccons K C) M $;
term minors: ind > nat > nat > nat > nat > tys > ctx > wff;
axiom minors_nil (D: ind) (np n k i: nat): $ minors D np n k i tnil [] $;
axiom minors_cons (D: ind) (np n k i nc k2: nat) (F: expr) (C: ctors) (T: tys) (M1 M2 M: ctx):
  $ cminors D np n k i z C M1 $ > $ clen_c C nc $ > $ add k nc k2 $ > $ minors D np n k2 (s i) T M2 $ >
  $ capp M2 M1 M $ > $ minors D np n k i (tcons F C T) M $;
--| `rtail D np n m i d F B`: `B = Π indices. Π (ind_ty D i params indices).
--| motive_i indices major`, read off `F` (lifted over the motives and
--| minors) at depth `d`.
term rtail: ind > nat > nat > nat > nat > nat > expr > expr > wff;
axiom rtail_pi (D: ind) (np n m i d: nat) (A B B2: expr):
  $ rtail D np n m i (s d) B B2 $ > $ rtail D np n m i d (Π A. B) (Π A. B2) $;
axiom rtail_srt (D: ind) (np n m i d mn dmn mi: nat) (l: lvl) (X I X2: expr):
  $ add m n mn $ > $ add d mn dmn $ > $ pargs (ind_ty D i) dmn np X $ > $ pargs X z d I $ >
  $ add mi i dmn $ > $ pargs # mi (s z) d X2 $ > $ rtail D np n m i d (srt l) (Π I. X2 @ # z) $;
--| `rec_ty D v i R`: the type of the recursor of type `i` with motives in
--| `srt v`: `Π params. Π motives. Π minors. Π indices. Π major. motive_i
--| indices major`.
term rec_ty: ind > lvl > nat > expr > wff;
axiom rec_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i np n m mn: nat) (M N: ctx) (F F2 B R1 R2 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v z T M $ > $ minors D np n z z T N $ >
  $ nth_ty T i F C $ > $ add m n mn $ > $ lift mn z F F2 $ > $ rtail D np n m i z F2 B $ >
  $ pis N B R1 $ > $ pis M R1 R2 $ > $ pis P R2 R $ > $ rec_ty D v i R $;

-- The recursor's rules (`mkRecRules`) ----------------------------------------------

--| `ihval D np n m v nf fld y A IH`: the inductive hypothesis of a recursive
--| field: `λ ys. ind_rec D j v params motives minors indices (field ys)`, read
--| off the field's type `A` (over all `nf` fields, the field at `# fld`).
term ihval: ind > nat > nat > nat > lvl > nat > nat > nat > expr > expr > wff;
axiom ihval_lam (D: ind) (np n m: nat) (v: lvl) (nf fld y: nat) (A B IH: expr):
  $ ihval D np n m v nf fld (s y) B IH $ > $ ihval D np n m v nf fld y (Π A. B) (λ A. IH) $;
axiom ihval_app (D: ind) (np n m: nat) (v: lvl) (nf fld y j ni k a mn b f: nat) (Y X1 X2 X3 U A: expr):
  $ spine_ty A D j k $ > $ nidx D j ni $ > $ add np ni k $ > $ rehead Y X2 ni A X3 $ > $ napp (ind_ty D j) np Y $ >
  $ add y nf a $ > $ add m n mn $ > $ add a mn b $ > $ pargs (ind_rec D j v) b np X1 $ > $ pargs X1 a mn X2 $ >
  $ add y fld f $ > $ pargs # f z y U $ > $ ihval D np n m v nf fld y A (X3 @ U) $;
--| `rwalk D np n m v nf d Acc K Val`: `Val = λ fields. Acc ihs`, read off the
--| constructor type `K` at depth `d`, where `Acc` is the minor applied to
--| the fields and `ihs` the inductive hypotheses of the recursive fields.
term rwalk: ind > nat > nat > nat > lvl > nat > nat > expr > expr > expr > wff;
axiom rwalk_pi_nr (D: ind) (np n m: nat) (v: lvl) (nf d dp mn: nat) (Acc A A3 B Val: expr):
  $ add d np dp $ > $ closed dp A $ > $ add m n mn $ > $ lift mn d A A3 $ >
  $ rwalk D np n m v nf (s d) Acc B Val $ > $ rwalk D np n m v nf d Acc (Π A. B) (λ A3. Val) $;
axiom rwalk_pi_rec (D: ind) (np n m: nat) (v: lvl) (nf d dp mn j sh fld: nat) (Acc A A2 A3 A4 B IH Val: expr):
  $ add d np dp $ > $ recfield D n np d A j $ > $ sinst D z n dp A A2 $ > $ add m n mn $ > $ lift mn d A2 A3 $ >
  $ add sh d nf $ > $ add fld (s z) sh $ > $ lift sh z A3 A4 $ > $ ihval D np n m v nf fld z A4 IH $ >
  $ rwalk D np n m v nf (s d) (Acc @ IH) B Val $ > $ rwalk D np n m v nf d Acc (Π A. B) (λ A3. Val) $;
axiom rwalk_bvar (D: ind) (np n m: nat) (v: lvl) (d h: nat) (Acc: expr):
  $ rwalk D np n m v d d Acc # h Acc $;
axiom rwalk_app (D: ind) (np n m: nat) (v: lvl) (d: nat) (Acc f a: expr):
  $ rwalk D np n m v d d Acc (f @ a) Acc $;
--| `rec_rhs D v i c R`: the right-hand side of the recursor's rule for
--| constructor `c` of type `i`: `λ params. λ motives. λ minors. λ fields.
--| minor_k fields ihs`.
term rec_rhs: ind > lvl > nat > nat > expr > wff;
axiom rec_rhs_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i c np n m k nf a mk: nat) (M N: ctx) (F K Acc Val R1 R2 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ motives D np v z T M $ > $ minors D np n z z T N $ >
  $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ minor_idx T i c k $ > $ npis K nf $ >
  $ add nf m a $ > $ add mk (s k) a $ > $ pargs # mk z nf Acc $ > $ rwalk D np n m v nf z Acc K Val $ >
  $ lams N Val R1 $ > $ lams M R1 R2 $ > $ lams P R2 R $ > $ rec_rhs D v i c R $;

-- Typing and reduction --------------------------------------------------------------

axiom ind_ty_ty (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (i: nat) (F R: expr) (C: ctors):
  $ tys_ok G D $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ pis P F R $ > $ ⊩ G, ind_ty D i : R $;
axiom ind_ctor_ty (G: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (i c np n m: nat) (F K K2 K3 R: expr) (C: ctors):
  $ ind_wf G D $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ clen P np $ > $ ntys T n m $ >
  $ sinst D z n np K K2 $ > $ ind_nested D N $ > $ rst D N K2 K3 $ > $ pis P K3 R $ > $ ⊩ G, ind_ctor D i c : R $;
axiom ind_rec_ty (G: ctx) (D: ind) (N: ctx) (i: nat) (v: lvl) (R0 R: expr):
  $ ind_wf G D $ > $ elim_ok G D v $ > $ rec_ty D v i R0 $ > $ ind_nested D N $ > $ rst D N R0 R $ > $ ⊩ G, ind_rec D i v : R $;
--| `rec_rule D v i c R`: the rule's right-hand side, restored.
term rec_rule: ind > lvl > nat > nat > expr > wff;
axiom rec_rule_i (D: ind) (N: ctx) (v: lvl) (i c: nat) (R0 R: expr):
  $ rec_rhs D v i c R0 $ > $ ind_nested D N $ > $ rst D N R0 R $ > $ rec_rule D v i c R $;
--| Iota: `ind_rec D i v ps ms ns is (ind_ctor D2 i c qs fs) ≡ R ps ms ns fs`
--| whenever the left side is well typed (which makes `D2` an instance of `D`
--| at equivalent levels and `qs`, `is` agree with the recursor's, as in
--| nanoda's `reduce_rec`).
axiom ind_iota (G: ctx) (D D2: ind) (i c: nat) (v: lvl) (np n m a0 a ni k nf nq: nat) (R e3 e4 Y maj rhs0 rhs T: expr):
  $ spine_rec e4 D i v k $ > $ spine_ctor maj D2 i c nq $ > $ ind_wf G D $ > $ elim_ok G D v $ > $ rec_rule D v i c R $ >
  $ ind_arity D np n m $ > $ add np n a0 $ > $ add a0 m a $ > $ nidx D i ni $ > $ add a ni k $ > $ nfields D i c nf $ >
  $ add np nf nq $ > $ rehead (ind_rec D i v) R a e3 rhs0 $ > $ drop ni e4 e3 $ > $ drop nf maj Y $ >
  $ rehead Y rhs0 nf maj rhs $ > $ ⊩ G, e4 @ maj : T $ > $ ⊢ G, e4 @ maj ≡ rhs : T $;
--| Iota of the recursor of an auxiliary type `i` (the occurrence `I Ds`) on
--| `I`'s constructor `c`: `ind_rec D i v ps ms ns is (ind_ctor I2 ii c qs fs)
--| ≡ R ps ms ns fs` when well typed (which makes `I2` an instance of `I` and
--| `qs` the occurrence's arguments at `ps`); the fields are the last `nf`
--| arguments of the major premise, as in `inductive_reduce_rec`.
axiom ind_iota_nst (G: ctx) (D I I2: ind) (N: ctx) (i ii c: nat) (v: lvl) (np n m a0 a ni k nf nq npi: nat)
    (R e3 e4 X Y maj rhs0 rhs T: expr):
  $ spine_rec e4 D i v k $ > $ spine_ctor maj I2 ii c nq $ > $ ind_wf G D $ > $ elim_ok G D v $ >
  $ ind_nested D N $ > $ aux_of D N i X $ > $ spine_ty X I ii npi $ > $ rec_rule D v i c R $ >
  $ ind_arity D np n m $ > $ add np n a0 $ > $ add a0 m a $ > $ nidx D i ni $ > $ add a ni k $ > $ nfields D i c nf $ >
  $ add npi nf nq $ > $ rehead (ind_rec D i v) R a e3 rhs0 $ > $ drop ni e4 e3 $ > $ drop nf maj Y $ >
  $ rehead Y rhs0 nf maj rhs $ > $ ⊩ G, e4 @ maj : T $ > $ ⊢ G, e4 @ maj ≡ rhs : T $;

-- Structures: projections and eta ------------------------------------------------------

--| `struct_like D j`: type `j` has one constructor and no indices (the kernel's
--| `is_structure_like`; a type of a mutual block may qualify).
term struct_like: ind > nat > wff;
axiom struct_like_i (D: ind) (b: blk) (P: ctx) (T: tys) (j: nat) (F K: expr) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ isort F z l $ > $ struct_like D j $;
--| `field_ty D j i A`: the type of field `i` of the constructor of type `j`,
--| under the parameters and the earlier fields, with the block's types put in.
term field_ty: ind > nat > nat > expr > wff;
axiom field_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K K2 A: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T j F C $ > $ nth_ctor C z K $ > $ clen P np $ > $ ntys T n m $ >
  $ sinst D z n np K K2 $ > $ nth_pi K2 i A $ > $ field_ty D j i A $;
--| `proj_ok G D j i`: field `i` of type `j` may be projected: the type's sort
--| is at least 1, or the fields up to `i` are all propositions (nanoda's
--| `infer_proj`, which requires only the projected and the dependent ones).
term fprops: ind > nat > nat > ctx > nat > nat > expr > wff;
term proj_ok: ctx > ind > nat > nat > wff;
axiom proj_ok_sort (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i: nat) (F: expr) (C: ctors) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T j F C $ > $ isort F z l $ > $ ls lz ⊔ l ≈ l $ > $ proj_ok G D j i $;
axiom proj_ok_prop (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K: expr) (C: ctors):
  $ ind_data D b P T $ > $ clen P np $ > $ ntys T n m $ > $ capp P G G2 $ > $ nth_ty T j F C $ > $ nth_ctor C z K $ >
  $ fprops D n np G2 z (s i) K $ > $ proj_ok G D j i $;
--| `fprops D n np Ctx d cnt K`: the next `cnt` fields of `K` are propositions.
axiom fprops_z (D: ind) (n np: nat) (Ctx: ctx) (d: nat) (K: expr): $ fprops D n np Ctx d z K $;
axiom fprops_s (D: ind) (n np: nat) (Ctx: ctx) (d cnt k: nat) (A A2 B: expr):
  $ add d np k $ > $ sinst D z n k A A2 $ > $ ⊩ Ctx, A2 : srt lz $ > $ fprops D n np (A2 :: Ctx) (s d) cnt B $ >
  $ fprops D n np Ctx d (s cnt) (Π A. B) $;
--| `qinst b e k j A R`: `R` is `A` with the `k` remaining fields `j`,
--| `j+1`, ... (field `j` at `# (k-1)`) replaced by the projections of `e`.
term qinst: blk > expr > nat > nat > expr > expr > wff;
axiom qinst_z (b: blk) (e A: expr) (j: nat): $ qinst b e z j A A $;
axiom qinst_s (b: blk) (e A A1 R: expr) (k j: nat):
  $ inst k A (proj b j e) A1 $ > $ qinst b e k (s j) A1 R $ > $ qinst b e (s k) j A R $;
axiom proj_ty (G: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (j i np: nat) (e e2 S A A1 A2 R: expr):
  $ ⊢ G, e ≡ e2 : S $ > $ spine_ty S D j np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ struct_like D j $ >
  $ proj_ok G D j i $ > $ clen P np $ > $ field_ty D j i A $ > $ ind_nested D N $ > $ rst D N A A2 $ > $ pinst i S A2 A1 $ >
  $ qinst b e i z A1 R $ >
  $ ⊢ G, proj b i e ≡ proj b i e2 : R $;
--| `proj b i (ind_ctor D2 j z qs fs) ≡ fs[i]` when well typed.
axiom proj_mk (G: ctx) (D2: ind) (b: blk) (j i np n m nf nq ii: nat) (M f T: expr):
  $ spine_ctor M D2 j z nq $ > $ ind_arity D2 np n m $ > $ nfields D2 j z nf $ > $ add np nf nq $ >
  $ add ii (s i) nf $ > $ argat ii M f $ > $ ⊩ G, proj b i M : T $ > $ ⊢ G, proj b i M ≡ f : T $;
--| Structure eta, for a structure whose fields do not mention the block.
term nonrec: nat > nat > expr > wff;
axiom nonrec_pi (np d k: nat) (A B: expr): $ add d np k $ > $ closed k A $ > $ nonrec np (s d) B $ > $ nonrec np d (Π A. B) $;
axiom nonrec_bvar (np d i: nat): $ nonrec np d # i $;
axiom nonrec_app (np d: nat) (f a: expr): $ nonrec np d (f @ a) $;
term eta_ok: ind > nat > wff;
axiom eta_ok_i (D: ind) (b: blk) (P: ctx) (T: tys) (j np: nat) (F K: expr):
  $ struct_like D j $ > $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ clen P np $ > $ nonrec np z K $ >
  $ eta_ok D j $;
--| `projs b e k Y M`: `M = Y @ proj b 0 e @ .. @ proj b (k-1) e`.
term projs: blk > expr > nat > expr > expr > wff;
axiom projs_z (b: blk) (e Y: expr): $ projs b e z Y Y $;
axiom projs_s (b: blk) (e Y M: expr) (k: nat): $ projs b e k Y M $ > $ projs b e (s k) Y (M @ proj b k e) $;
axiom ind_eta (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j np nf: nat) (e S Y M: expr):
  $ ⊩ G, e : S $ > $ spine_ty S D j np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ eta_ok D j $ > $ clen P np $ >
  $ rehead (ind_ty D j) (ind_ctor D j z) np S Y $ > $ nfields D j z nf $ > $ projs b e nf Y M $ > $ ⊢ G, e ≡ M : S $;

-- Level equivalence of expressions --------------------------------------------------

--| `eeqv e e2`: `e` and `e2` agree except at levels, which are equivalent.
--| Two such expressions denote the same thing, so `e ≡ e2` (`eeqv_df`; this
--| generalizes `sortDF` and `constDF`). `eeqv_refl` covers every identical
--| subterm (an opaque constant at the same levels among them).
term eeqv: expr > expr > wff;
axiom eeqv_refl (e: expr): $ eeqv e e $;
term ind_eqv: ind > ind > wff;
term ceqv: ctx > ctx > wff;
term teqv: tys > tys > wff;
term cseqv: ctors > ctors > wff;
axiom eeqv_bvar (i: nat): $ eeqv # i # i $;
axiom eeqv_srt (l l2: lvl): $ l ≈ l2 $ > $ eeqv (srt l) (srt l2) $;
axiom eeqv_app (f a f2 a2: expr): $ eeqv f f2 $ > $ eeqv a a2 $ > $ eeqv (f @ a) (f2 @ a2) $;
axiom eeqv_lam (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (λ A. b) (λ A2. b2) $;
axiom eeqv_pi (A b A2 b2: expr): $ eeqv A A2 $ > $ eeqv b b2 $ > $ eeqv (Π A. b) (Π A2. b2) $;
axiom eeqv_lit (n: bin): $ eeqv (lit n) (lit n) $;
axiom eeqv_ind_ty (D D2: ind) (i: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ty D i) (ind_ty D2 i) $;
axiom eeqv_ind_ctor (D D2: ind) (i c: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ctor D i c) (ind_ctor D2 i c) $;
axiom eeqv_ind_rec (D D2: ind) (i: nat) (v v2: lvl):
  $ ind_eqv D D2 $ > $ v ≈ v2 $ > $ eeqv (ind_rec D i v) (ind_rec D2 i v2) $;
axiom eeqv_proj (b: blk) (i: nat) (e e2: expr): $ eeqv e e2 $ > $ eeqv (proj b i e) (proj b i e2) $;
axiom ind_eqv_i (D D2: ind) (b: blk) (P P2 N N2: ctx) (T T2: tys):
  $ ind_data D b P T $ > $ ind_data D2 b P2 T2 $ > $ ceqv P P2 $ > $ teqv T T2 $ >
  $ ind_nested D N $ > $ ind_nested D2 N2 $ > $ ceqv N N2 $ > $ ind_eqv D D2 $;
axiom ceqv_nil: $ ceqv [] [] $;
axiom ceqv_cons (A A2: expr) (G G2: ctx): $ eeqv A A2 $ > $ ceqv G G2 $ > $ ceqv (A :: G) (A2 :: G2) $;
axiom teqv_nil: $ teqv tnil tnil $;
axiom teqv_cons (F F2: expr) (C C2: ctors) (T T2: tys):
  $ eeqv F F2 $ > $ cseqv C C2 $ > $ teqv T T2 $ > $ teqv (tcons F C T) (tcons F2 C2 T2) $;
axiom cseqv_nil: $ cseqv cnil cnil $;
axiom cseqv_cons (K K2: expr) (C C2: ctors): $ eeqv K K2 $ > $ cseqv C C2 $ > $ cseqv (ccons K C) (ccons K2 C2) $;
axiom eeqv_df (G: ctx) (e e2 A: expr): $ ⊩ G, e : A $ > $ eeqv e e2 $ > $ ⊢ G, e ≡ e2 : A $;

---------------------------------------------------------------------------
-- Lean's `Nat` and `Eq`, the quotient primitives, and the literal ties
-- (notes/audit-lean-mm0.md §4 and §5). `nat_D` and `eq_D` are the data of
-- the blocks `Nat` and `Eq` as Lean's prelude declares them; `lean0 check`
-- reads the statements between the `lean0-check` marks (written in prefix
-- form for that) and compares the export's `Nat`, `Eq` and quotient
-- declarations with them. A certificate proves `tys_ok` and `ind_wf` for
-- the two blocks like any other. The quotient primitives have the types
-- the kernel gives them (`Quot.lift`'s mentions `Eq`), and `Quot.lift` and
-- `Quot.ind` reduce on `Quot.mk`; `lit n` is `Nat.succ^n Nat.zero`.
---------------------------------------------------------------------------

-- lean0-check: begin
--| The inductive block of `Nat`.
term nat_blk: blk;
--| The inductive block of `Nat`: its parameters, types and constructors.
def nat_D: ind = $ ind_mk nat_blk nil (tcons (srt (ls lz)) (ccons (bvar z) (ccons (pi (bvar z) (bvar (s z))) cnil)) tnil) $;
--| The inductive block of `Eq`.
term eq_blk: blk;
--| The inductive block of `Eq`: its parameters, types and constructors.
def eq_D (u: lvl): ind = $ ind_mk eq_blk (cons (bvar z) (cons (srt u) nil)) (tcons (pi (bvar (s z)) (srt lz)) (ccons (app (app (app (bvar (s (s z))) (bvar (s z))) (bvar z)) (bvar z)) cnil) tnil) $;
--| Lean quotient primitive `Quot`.
term quot (u: lvl): expr;
--| Lean quotient primitive `Quot.mk`.
term quot_mk (u: lvl): expr;
--| Lean quotient primitive `Quot.lift`.
term quot_lift (u v: lvl): expr;
--| Lean quotient primitive `Quot.ind`.
term quot_ind (u: lvl): expr;
-- lean0-check: end

axiom closed_quot (k: nat) (u: lvl): $ closed k (quot u) $;
axiom closed_quot_mk (k: nat) (u: lvl): $ closed k (quot_mk u) $;
axiom closed_quot_lift (k: nat) (u v: lvl): $ closed k (quot_lift u v) $;
axiom closed_quot_ind (k: nat) (u: lvl): $ closed k (quot_ind u) $;
axiom eeqv_quot (u u2: lvl): $ leqv u u2 $ > $ eeqv (quot u) (quot u2) $;
axiom eeqv_quot_mk (u u2: lvl): $ leqv u u2 $ > $ eeqv (quot_mk u) (quot_mk u2) $;
axiom eeqv_quot_lift (u v u2 v2: lvl):
  $ leqv u u2 $ > $ leqv v v2 $ > $ eeqv (quot_lift u v) (quot_lift u2 v2) $;
axiom eeqv_quot_ind (u u2: lvl): $ leqv u u2 $ > $ eeqv (quot_ind u) (quot_ind u2) $;

--| `Quot : Π (α : Sort u). (α → α → Prop) → Sort u`
axiom quot_ty (G: ctx) (u: lvl):
  $ ty G (quot u) (pi (srt u) (pi (pi (bvar z) (pi (bvar (s z)) (srt lz))) (srt u))) $;
--| `Quot.mk : Π (α : Sort u) (r : α → α → Prop). α → Quot r`
axiom quot_mk_ty (G: ctx) (u: lvl):
  $ ty G (quot_mk u) (pi (srt u) (pi (pi (bvar z) (pi (bvar (s z)) (srt lz))) (pi (bvar (s z)) (app (app (quot u) (bvar (s (s z)))) (bvar (s z)))))) $;
--| `Quot.lift : Π (α : Sort u) (r : α → α → Prop) (β : Sort v) (f : α → β).
--|   (Π a b. r a b → Eq (f a) (f b)) → Quot r → β`
axiom quot_lift_ty (G: ctx) (u v: lvl):
  $ ty G (quot_lift u v) (pi (srt u) (pi (pi (bvar z) (pi (bvar (s z)) (srt lz))) (pi (srt v) (pi (pi (bvar (s (s z))) (bvar (s z))) (pi (pi (bvar (s (s (s z)))) (pi (bvar (s (s (s (s z))))) (pi (app (app (bvar (s (s (s (s z))))) (bvar (s z))) (bvar z)) (app (app (app (ind_ty (eq_D v) z) (bvar (s (s (s (s z)))))) (app (bvar (s (s (s z)))) (bvar (s (s z))))) (app (bvar (s (s (s z)))) (bvar (s z))))))) (pi (app (app (quot u) (bvar (s (s (s (s z)))))) (bvar (s (s (s z))))) (bvar (s (s (s z)))))))))) $;
--| `Quot.ind : Π (α : Sort u) (r : α → α → Prop) (β : Quot r → Prop).
--|   (Π a. β (Quot.mk r a)) → Π q. β q`
axiom quot_ind_ty (G: ctx) (u: lvl):
  $ ty G (quot_ind u) (pi (srt u) (pi (pi (bvar z) (pi (bvar (s z)) (srt lz))) (pi (pi (app (app (quot u) (bvar (s z))) (bvar z)) (srt lz)) (pi (pi (bvar (s (s z))) (app (bvar (s z)) (app (app (app (quot_mk u) (bvar (s (s (s z))))) (bvar (s (s z)))) (bvar z)))) (pi (app (app (quot u) (bvar (s (s (s z))))) (bvar (s (s z)))) (app (bvar (s (s z))) (bvar z))))))) $;

--| Reduction of `Quot.lift f h (Quot.mk r a)` to `f a` and of
--| `Quot.ind h (Quot.mk r a)` to `h a`, when the left side is well typed (as
--| nanoda's `reduce_quot`, which checks only the spine: typing makes the
--| constructor's `α` and `r` the primitive's).
axiom quot_lift_mk (G: ctx) (u v: lvl) (x1 x2 x3 x4 x5: expr) (v1: lvl) (y1 y2 a T: expr):
  $ ty G (app (app (app (app (app (app (quot_lift u v) x1) x2) x3) x4) x5) (app (app (app (quot_mk v1) y1) y2) a)) T $ >
  $ deq G (app (app (app (app (app (app (quot_lift u v) x1) x2) x3) x4) x5) (app (app (app (quot_mk v1) y1) y2) a)) (app x4 a) T $;
axiom quot_ind_mk (G: ctx) (u: lvl) (x1 x2 x3 x4: expr) (v1: lvl) (y1 y2 a T: expr):
  $ ty G (app (app (app (app (app (quot_ind u) x1) x2) x3) x4) (app (app (app (quot_mk v1) y1) y2) a)) T $ >
  $ deq G (app (app (app (app (app (quot_ind u) x1) x2) x3) x4) (app (app (app (quot_mk v1) y1) y2) a)) (app x4 a) T $;

--| The literal `0` is `Nat.zero`, and `n+1` is `Nat.succ n`.
axiom lit_zero (G: ctx): $ deq G (lit b0) (ind_ctor nat_D z z) (ind_ty nat_D z) $;
axiom lit_succ (G: ctx) (a b: bin):
  $ bsucc a b $ > $ deq G (lit b) (app (ind_ctor nat_D z (s z)) (lit a)) (ind_ty nat_D z) $;

---------------------------------------------------------------------------
-- Statements
---------------------------------------------------------------------------

--| `inh G A`: `A` is inhabited in `Γ`. Theorems are stated this way so that
--| their proof terms stay inside the proof file.
term inh: ctx > expr > wff;
axiom inh_i (G: ctx) (e A: expr): $ ⊢ G, e ≡ e : A $ > $ inh G A $;
