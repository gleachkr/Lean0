import "lean-core.mm0";

-- LeanTT, inductive types: blocks as data, their well-formedness, and the
-- rules of their types, constructors, recursors (iota), projections and
-- structure eta (notes/audit-lean-mm0.md §4). See lean-core.mm0 for the
-- spec's organization and notations.

---------------------------------------------------------------------------
-- PART I: SYNTAX
---------------------------------------------------------------------------

-- Inductive blocks as data (notes/audit-lean-mm0.md §4) --------------------
-- Not in Lean4Lean, whose `VInductDecl.WF` is left as `sorry`. A schema: an
-- inductive block is a term of sort `ind`, the certificate proves it well
-- formed (`ind_wf`, Part II), and the types, constructors and recursors, their
-- iota rules, projections and structure eta follow from the rules of Part III.
-- The relations transcribe Lean's kernel (`inductive.cpp`; Lean4Lean's
-- `Inductive/Add.lean` is the port read for this): every one is
-- syntax-directed over the declaration.
--
-- A block `ind_mk b P T N` has an atom `b` (a `term` of sort `blk` per block,
-- so that structurally equal declarations stay distinct), the parameters as
-- a telescope `P` (a `ctx`: innermost parameter first, each type under the
-- earlier ones) and the types `T`: for each type its type `F` (under `P`:
-- `Π indices, srt l`) and the types of its constructors; `N` lists its nested
-- occurrences (below; `[]` for a block without any). A constructor's
-- type `K` is written under `P` and, outside `P`, under the block's `n`
-- types themselves: at depth `d` inside `K`, parameter `q` (0 outermost) is
-- `#(d + np - 1 - q)` and type `j` is `#(d + np + j)`. So "no occurrence
-- of the types being declared" is `closed (d + np)`, and instantiating the
-- types (`sinst`) is `inst`.
--
-- Counting conventions: `np` parameters, `n` types, `m` constructors in all,
-- `nf` fields of a constructor, `nidx` indices of a type; motive `j` is the
-- `j`th binder after the parameters and minor `k` the `k`th after the motives.

--| @hole _blk
strict free sort blk;
--| @hole _ind
strict free sort ind;
--| @hole _tys
strict free sort tys;
--| @hole _ctors
strict free sort ctors;
term tnil: tys;
--| `tcons F C T`: a type whose type is `F`, with constructors `C`, then `T`.
term tcons: expr > ctors > tys > tys;
term cnil: ctors;
term ccons: expr > ctors > ctors;

--| A block `ind_mk b P T N`. A nested block is the mutual block the kernel checks in
--| its place: `T` lists the declared types and then one auxiliary type per
--| nested occurrence `I Ds` of an earlier block `I` in the constructors (in
--| the kernel's order), and `N` lists the occurrences, each `ind_ty I i @ Ds`
--| written like a constructor type at depth 0 (a `ctx` used as a list; `Ds`
--| mention the block's types). An auxiliary type must have `I`'s type and
--| constructors at `Ds` with the occurrences replaced by the auxiliary types
--| (`spz`), and the kernel adds auxiliary types for all of `I`'s block at
--| once (`nst_ok`). So an auxiliary type denotes the occurrence itself, and
--| the block's constructors, recursors and rules are stated with the
--| occurrences restored (`rst`, the kernel's `restoreNested`): the auxiliary
--| type `ind_ty D j ps is` is read as `I Ds[ps] is` and its constructor
--| `ind_ctor D j c ps fs` as `ind_ctor I i c Ds[ps] fs`. Its recursor is the
--| block's (`X.rec_k` for the `k`th auxiliary type) and reduces on `I`'s
--| constructors (`ind_iota_nst`).
term ind_mk: blk > ctx > tys > ctx > ind;

--| Type `i`, constructor `c` of type `i`, and the recursor of type `i` with
--| motives in `srt v`, of a block.
term ind_ty: ind > nat > expr;
term ind_ctor: ind > nat > nat > expr;
term ind_rec: ind > nat > lvl > expr;
--| `proj b i e`: field `i` of `e`, a structure of the block with atom `b`.
term proj: blk > nat > expr > expr;

axiom closed_ind_ty (k: nat) (D: ind) (i: nat): $ closed k (ind_ty D i) $;
axiom closed_ind_ctor (k: nat) (D: ind) (i c: nat): $ closed k (ind_ctor D i c) $;
axiom closed_ind_rec (k: nat) (D: ind) (i: nat) (v: lvl): $ closed k (ind_rec D i v) $;
axiom closed_proj (k: nat) (b: blk) (i: nat) (e: expr):
  $ closed k e $ > $ closed k (proj b i e) $;
axiom lift_proj (n k: nat) (b: blk) (i: nat) (e e2: expr):
  $ ⟮ₗ [ #k ↑ n ] e = e2 ⟯ $ > $ ⟮ₗ [ #k ↑ n ] proj b i e = proj b i e2 ⟯ $;
axiom inst_proj (k: nat) (b: blk) (i: nat) (e a e2: expr):
  $ ⟮ [ #k ↦ a ] e = e2 ⟯ $ > $ ⟮ [ #k ↦ a ] proj b i e = proj b i e2 ⟯ $;

-- Reading the declaration --------------------------------------------------

--| The parts of a block. (Clauses take a variable `D` and read it through
--| `ind_data`, so that a block named by a definition stays folded.)
term ind_data: ind > blk > ctx > tys > wff;
axiom ind_data_i (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_data (ind_mk b P T N) b P T $;
--| `ind_nested D N`: the nested occurrences of `D`.
term ind_nested: ind > ctx > wff;
axiom ind_nested_i (b: blk) (P: ctx) (T: tys) (N: ctx): $ ind_nested (ind_mk b P T N) N $;

--| `nth_ty T i F C`: type `i` of `T` has type `F` and constructors `C`.
term nth_ty: tys > nat > expr > ctors > wff;
axiom nth_ty_z (F: expr) (C: ctors) (T: tys): $ nth_ty (tcons F C T) 0 F C $;
axiom nth_ty_s (F F2: expr) (C C2: ctors) (T: tys) (i: nat):
  $ nth_ty T i F C $ > $ nth_ty (tcons F2 C2 T) (s i) F C $;
term nth_ctor: ctors > nat > expr > wff;
axiom nth_ctor_z (K: expr) (C: ctors): $ nth_ctor (ccons K C) 0 K $;
axiom nth_ctor_s (K K2: expr) (C: ctors) (c: nat):
  $ nth_ctor C c K $ > $ nth_ctor (ccons K2 C) (s c) K $;

--| Lengths: of a constructor list, and `ntys T n m` for `n` types with `m`
--| constructors in all.
term clen_c: ctors > nat > wff;
axiom clen_c_nil: $ clen_c cnil 0 $;
axiom clen_c_cons (K: expr) (C: ctors) (n: nat): $ clen_c C n $ > $ clen_c (ccons K C) (s n) $;
term ntys: tys > nat > nat > wff;
axiom ntys_nil: $ ntys tnil 0 0 $;
axiom ntys_cons (F: expr) (C: ctors) (T: tys) (n m c m2: nat):
  $ ntys T n m $ > $ clen_c C c $ > $ ⦃ m + c = m2 ⦄ $ > $ ntys (tcons F C T) (s n) m2 $;
--| `minor_idx T i c k`: constructor `c` of type `i` has minor premise `k`.
term minor_idx: tys > nat > nat > nat > wff;
axiom minor_idx_z (F: expr) (C: ctors) (T: tys) (c: nat): $ minor_idx (tcons F C T) 0 c c $;
axiom minor_idx_s (F: expr) (C: ctors) (T: tys) (i c k nc k2: nat):
  $ clen_c C nc $ > $ minor_idx T i c k $ > $ ⦃ nc + k = k2 ⦄ $ > $ minor_idx (tcons F C T) (s i) c k2 $;
--| `npis e n`: `e` is `n` binders `Π` over an application or a variable.
term npis: expr > nat > wff;
axiom npis_bvar (i: nat): $ npis #i 0 $;
axiom npis_app (f a: expr): $ npis (f @ a) 0 $;
axiom npis_pi (A B: expr) (n: nat): $ npis B n $ > $ npis (Π A, B) (s n) $;
--| `nth_pi e i A`: the `i`th binder type of `e`.
term nth_pi: expr > nat > expr > wff;
axiom nth_pi_z (A B: expr): $ nth_pi (Π A, B) 0 A $;
axiom nth_pi_s (A A2 B: expr) (i: nat): $ nth_pi B i A $ > $ nth_pi (Π A2, B) (s i) A $;
--| `isort F k l`: `F` is `k` binders over `srt l`.
term isort: expr > nat > lvl > wff;
axiom isort_srt (l: lvl): $ isort (Sort l) 0 l $;
axiom isort_pi (A B: expr) (k: nat) (l: lvl): $ isort B k l $ > $ isort (Π A, B) (s k) l $;
--| Derived counts of a block: `ind_arity D np n m`, `nidx D i k` (indices of
--| type `i`) and `nfields D i c nf`.
term ind_arity: ind > nat > nat > nat > wff;
axiom ind_arity_i (D: ind) (b: blk) (P: ctx) (T: tys) (np n m: nat):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ ind_arity D np n m $;
term nidx: ind > nat > nat > wff;
axiom nidx_i (D: ind) (b: blk) (P: ctx) (T: tys) (i k: nat) (F: expr) (C: ctors) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ isort F k l $ > $ nidx D i k $;
term nfields: ind > nat > nat > nat > wff;
axiom nfields_i (D: ind) (b: blk) (P: ctx) (T: tys) (i c nf: nat) (F K: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ npis K nf $ > $ nfields D i c nf $;
--| `ndecl N n n0`: `n0` declared types among `n`; `aux_of D N j X`: the
--| occurrence of auxiliary type `j` (entry `j - n0` of `N`).
term ndecl: ctx > nat > nat > wff;
axiom ndecl_nil (n: nat): $ ndecl [] n n $;
axiom ndecl_cons (X: expr) (N: ctx) (n n0: nat): $ ndecl N n n0 $ > $ ndecl (X :: N) (s n) n0 $;
term aux_of: ind > ctx > nat > expr > wff;
axiom aux_of_i (D: ind) (N: ctx) (j np n m n0 k: nat) (X: expr):
  $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ ⦃ n0 + k = j ⦄ $ > $ cnth N k X $ > $ aux_of D N j X $;

-- Telescopes and applications ----------------------------------------------

--| `⌊Π P, b = T ⌋` (`pis P b T`): `T` is `b` under the binders `Π` of the
--| telescope `P`, outermost first; `⌊λ P, b = T ⌋` (`lams P b T`) likewise with `λ`.
term pis: ctx > expr > expr > wff;
notation pis (P: ctx) (b T: expr): wff = ($<_\Pi$:0) P ($,$:5) b ($=$:50) T ($_>$:0);
notation pis (P: ctx) (b T: expr): wff = ($⌊Π$:0) P ($,$:5) b ($=$:50) T ($⌋$:0);
axiom pis_nil (b: expr): $ ⌊Π [], b = b ⌋ $;
axiom pis_cons (A b T: expr) (P: ctx): $ ⌊Π P, (Π A, b) = T ⌋ $ > $ ⌊Π P ▷ A, b = T ⌋ $;
term lams: ctx > expr > expr > wff;
notation lams (P: ctx) (b T: expr): wff = ($<_\$:0) P ($,$:5) b ($=$:50) T ($_>$:0);
notation lams (P: ctx) (b T: expr): wff = ($⌊λ$:0) P ($,$:5) b ($=$:50) T ($⌋$:0);
axiom lams_nil (b: expr): $ ⌊λ [], b = b ⌋ $;
axiom lams_cons (A b T: expr) (P: ctx): $ ⌊λ P, (λ A, b) = T ⌋ $ > $ ⌊λ P ▷ A, b = T ⌋ $;
--| `tys_closed P T`: each type's type over the parameters is closed with them,
--| `Π P, F` closed (a block is a closed constant: it mentions no variable of
--| the context it is used in).
term tys_closed: ctx > tys > wff;
axiom tys_closed_nil (P: ctx): $ tys_closed P tnil $;
axiom tys_closed_cons (P: ctx) (F R: expr) (C: ctors) (T: tys):
  $ ⌊Π P, F = R ⌋ $ > $ closed 0 R $ > $ tys_closed P T $ > $ tys_closed P (tcons F C T) $;

--| `pargs X d n e`: `e = X @ #(d+n-1) @ ... @ #d` (the `n` variables above
--| depth `d`). `spine h e k`: `e` is `h` applied to `k` arguments; read with
--| `k` given it takes `k` arguments off `e`, and with `h` given by its head (a
--| constant or a variable, not an application) it counts the arguments down to
--| that head. `rehead Y X k e e2`: `e = Y @ a1 .. ak` and `e2 = X @ a1 .. ak`.
--| `has_arg e a`: `a` is an argument of `e`.
term pargs: expr > nat > nat > expr > wff;
axiom pargs_z (X: expr) (d: nat): $ pargs X d 0 X $;
axiom pargs_s (X e: expr) (d n: nat): $ pargs X (s d) n e $ > $ pargs X d (s n) (e @ #d) $;
term spine: expr > expr > nat > wff;
axiom spine_z (h: expr): $ spine h h 0 $;
axiom spine_s (h e a: expr) (k: nat): $ spine h e k $ > $ spine h (e @ a) (s k) $;
term rehead: expr > expr > nat > expr > expr > wff;
axiom rehead_z (Y X: expr): $ rehead Y X 0 Y X $;
axiom rehead_s (Y X e e2 a: expr) (k: nat): $ rehead Y X k e e2 $ > $ rehead Y X (s k) (e @ a) (e2 @ a) $;
--| `has_arg e a`: `a` is an argument of `e`. `leaf_has j e`: `#j` (at the
--| binder's depth) is an argument of the result under the remaining binders.
term has_arg: expr > expr > wff;
axiom has_arg_z (e a: expr): $ has_arg (e @ a) a $;
axiom has_arg_s (e a b: expr): $ has_arg e a $ > $ has_arg (e @ b) a $;
term leaf_has: nat > expr > wff;
axiom leaf_has_pi (j: nat) (A B: expr): $ leaf_has (s j) B $ > $ leaf_has j (Π A, B) $;
axiom leaf_has_app (j: nat) (e: expr): $ has_arg e #j $ > $ leaf_has j e $;
--| `pinst i S A R`: `S` is a block's type or constructor applied to `p0 ..
--| p(np-1)`; `R` is `A` (under `i` binders over the block's parameters) with
--| the parameters put in, outermost first (`p0` at `#(i + np - 1)`, then
--| `p1` at `#(i + np - 2)`, ...: each substituted term is lifted over the
--| binders below it).
term pinst: nat > expr > expr > expr > wff;
axiom pinst_head (i: nat) (D: ind) (j: nat) (A: expr): $ pinst i (ind_ty D j) A A $;
axiom pinst_head_c (i: nat) (D: ind) (j c: nat) (A: expr): $ pinst i (ind_ctor D j c) A A $;
axiom pinst_app (i: nat) (S a A A1 R: expr): $ pinst (s i) S A A1 $ > $ ⟮ [ #i ↦ a ] A1 = R ⟯ $ > $ pinst i (S @ a) A R $;

-- Occurrences of the block (`isValidIndApp`, `checkPositivity`, `isRecArg`) ---

--| `sinst D j n k e e2`: `e2` is `e` with the variables `#k .. #(k+n-j-1)`
--| replaced by `ind_ty D j .. ind_ty D (n-1)` (the block's types, which are
--| closed).
term sinst: ind > nat > nat > nat > expr > expr > wff;
axiom sinst_done (D: ind) (n k: nat) (e: expr): $ sinst D n n k e e $;
axiom sinst_step (D: ind) (j n k: nat) (e e1 e2: expr):
  $ j < n $ > $ ⟮ [ #k ↦ ind_ty D j ] e = e1 ⟯ $ > $ sinst D (s j) n k e1 e2 $ > $ sinst D j n k e e2 $;
--| `iargs k m X A`: `A` is `X` applied to `m` arguments, each `closed k`.
term iargs: nat > nat > expr > expr > wff;
axiom iargs_z (k: nat) (X: expr): $ iargs k 0 X X $;
axiom iargs_s (k m: nat) (X A a: expr): $ iargs k m X A $ > $ closed k a $ > $ iargs k (s m) X (A @ a) $;
--| `indapp D n np d A j`: at depth `d`, `A` is type `j` of the block applied
--| to the parameters and to its indices, which do not mention the block
--| (`isValidIndApp`).
term indapp: ind > nat > nat > nat > expr > nat > wff;
axiom indapp_i (D: ind) (n np d j k t m na: nat) (X A: expr):
  $ spine #t A na $ > $ ⦃ d + np = k ⦄ $ > $ ⦃ k + j = t ⦄ $ > $ j < n $ > $ pargs #t d np X $ > $ nidx D j m $ >
  $ iargs k m X A $ > $ indapp D n np d A j $;
--| `ipos D n np d A`: `A` is a positive field type at depth `d`: no occurrence
--| of the block, or `Π` over a domain without one, or a valid occurrence
--| (`checkPositivity`). `recfield D n np d A j`: `A` is a recursive field
--| (`Π ys, ` a valid occurrence of type `j`; `isRecArg`).
term ipos: ind > nat > nat > nat > expr > wff;
axiom ipos_closed (D: ind) (n np d k: nat) (A: expr): $ ⦃ d + np = k ⦄ $ > $ closed k A $ > $ ipos D n np d A $;
axiom ipos_pi (D: ind) (n np d k: nat) (A B: expr):
  $ ⦃ d + np = k ⦄ $ > $ closed k A $ > $ ipos D n np (s d) B $ > $ ipos D n np d (Π A, B) $;
axiom ipos_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ ipos D n np d A $;
term recfield: ind > nat > nat > nat > expr > nat > wff;
axiom recfield_pi (D: ind) (n np d j: nat) (A B: expr):
  $ recfield D n np (s d) B j $ > $ recfield D n np d (Π A, B) j $;
axiom recfield_app (D: ind) (n np d j: nat) (A: expr): $ indapp D n np d A j $ > $ recfield D n np d A j $;

-- Nested occurrences (`ElimNestedInductive`): restoring and specializing ---

--| `rst D N e e2`: `e2` is `e` with the auxiliary types and constructors
--| restored: nothing when there are no occurrences (`rst_nil`), else from
--| the outside in, `rst_refl` for the subterms left as they are (the clauses
--| are tried in this order, so that an unknown `e2` is computed).
term rst: ind > ctx > expr > expr > wff;
axiom rst_nil (D: ind) (e: expr): $ rst D [] e e $;
axiom rst_ty (D: ind) (N: ctx) (j np n m na k: nat) (e S X X1 X2 e2: expr):
  $ spine (ind_ty D j) e na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ >
  $ ⦃ np + k = na ⦄ $ > $ spine S e k $ > $ pinst 0 S X1 X2 $ > $ rehead S X2 k e e2 $ > $ rst D N e e2 $;
axiom rst_ctor (D I: ind) (N: ctx) (j c i np n m na k npi: nat) (e S X X1 X2 Y e2: expr):
  $ spine (ind_ctor D j c) e na $ > $ aux_of D N j X $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ >
  $ ⦃ np + k = na ⦄ $ > $ spine S e k $ > $ pinst 0 S X1 X2 $ > $ spine (ind_ty I i) X2 npi $ >
  $ rehead (ind_ty I i) (ind_ctor I i c) npi X2 Y $ > $ rehead S Y k e e2 $ > $ rst D N e e2 $;
axiom rst_app (D: ind) (N: ctx) (f a f2 a2: expr): $ rst D N f f2 $ > $ rst D N a a2 $ > $ rst D N (f @ a) (f2 @ a2) $;
axiom rst_lam (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (λ A, b) (λ A2, b2) $;
axiom rst_pi (D: ind) (N: ctx) (A b A2 b2: expr): $ rst D N A A2 $ > $ rst D N b b2 $ > $ rst D N (Π A, b) (Π A2, b2) $;
axiom rst_proj (D: ind) (N: ctx) (b: blk) (i: nat) (e e2: expr): $ rst D N e e2 $ > $ rst D N (proj b i e) (proj b i e2) $;
axiom rst_refl (D: ind) (N: ctx) (e: expr): $ rst D N e e $;
--| `crst D N G G2`: the context `G2` is `G` with each entry restored.
term crst: ind > ctx > ctx > ctx > wff;
axiom crst_nil (D: ind) (N: ctx): $ crst D N [] [] $;
axiom crst_cons (D: ind) (N: ctx) (A A2: expr) (G G2: ctx):
  $ rst D N A A2 $ > $ crst D N G G2 $ > $ crst D N (G ▷ A) (G2 ▷ A2) $;
term nst_hit: ctx > nat > nat > nat > expr > expr > wff;
--| `nst_hit N j d np e e2`: `e` is an occurrence of `N` (the first entry being
--| auxiliary type `j`) lifted to depth `d` and applied to more arguments,
--| and `e2` its replacement. The entries are tried in order: the first
--| clause fails as a whole when the entry is not `e`'s.
axiom nst_hit_z (X S Y e e2: expr) (N: ctx) (I: ind) (i j d np na npi r a t: nat):
  $ spine (ind_ty I i) X npi $ > $ spine (ind_ty I i) e na $ > $ ⦃ npi + r = na ⦄ $ > $ ⟮₀ X ↑ d = S ⟯ $ > $ spine S e r $ >
  $ ⦃ np + j = a ⦄ $ > $ ⦃ d + a = t ⦄ $ > $ pargs #t d np Y $ > $ rehead S Y r e e2 $ > $ nst_hit (X :: N) j d np e e2 $;
axiom nst_hit_s (X e e2: expr) (N: ctx) (j d np: nat): $ nst_hit N (s j) d np e e2 $ > $ nst_hit (X :: N) j d np e e2 $;
--| `spz D N d e e2`: `e2` is `e` (at depth `d` in a constructor type) with
--| each occurrence `I Ds is` of `N` replaced by its auxiliary type
--| `#(d + np + j)` applied to the block's parameters and to `is`
--| (`replaceAllNested`: from the outside in, so `is` stay as they are).
term spz: ind > ctx > nat > expr > expr > wff;
axiom spz_refl (D: ind) (N: ctx) (d: nat) (e: expr): $ spz D N d e e $;
axiom spz_hit (D: ind) (N: ctx) (d np n m n0: nat) (e e2: expr):
  $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ nst_hit N n0 d np e e2 $ > $ spz D N d e e2 $;
axiom spz_app (D: ind) (N: ctx) (d: nat) (f a f2 a2: expr): $ spz D N d f f2 $ > $ spz D N d a a2 $ > $ spz D N d (f @ a) (f2 @ a2) $;
axiom spz_lam (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (λ A, b) (λ A2, b2) $;
axiom spz_pi (D: ind) (N: ctx) (d: nat) (A b A2 b2: expr): $ spz D N d A A2 $ > $ spz D N (s d) b b2 $ > $ spz D N d (Π A, b) (Π A2, b2) $;
axiom spz_proj (D: ind) (N: ctx) (d: nat) (b: blk) (i: nat) (e e2: expr): $ spz D N d e e2 $ > $ spz D N d (proj b i e) (proj b i e2) $;
--| `afree e`: `e` mentions no auxiliary type and no constructor of one: at
--| `ind_ty D j` and `ind_ctor D j c` the number `j` is one of `D`'s declared
--| types. Lean's terms are such; `spz_ctors` requires it of a restored
--| constructor, which makes the restoration unique (`rst` alone may leave
--| any subterm as it is).
term afree: expr > wff;
axiom afree_bvar (i: nat): $ afree #i $;
axiom afree_srt (l: lvl): $ afree (Sort l) $;
axiom afree_app (f a: expr): $ afree f $ > $ afree a $ > $ afree (f @ a) $;
axiom afree_lam (A b: expr): $ afree A $ > $ afree b $ > $ afree (λ A, b) $;
axiom afree_pi (A b: expr): $ afree A $ > $ afree b $ > $ afree (Π A, b) $;
axiom afree_cst (a: atom) (S: lvls): $ afree (cst a S) $;
axiom afree_ind_ty (D: ind) (N: ctx) (j np n m n0: nat):
  $ ind_nested D N $ > $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ j < n0 $ > $ afree (ind_ty D j) $;
axiom afree_ind_ctor (D: ind) (N: ctx) (j c np n m n0: nat):
  $ ind_nested D N $ > $ ind_arity D np n m $ > $ ndecl N n n0 $ > $ j < n0 $ > $ afree (ind_ctor D j c) $;
axiom afree_ind_rec (D: ind) (i: nat) (v: lvl): $ afree (ind_rec D i v) $;
axiom afree_proj (b: blk) (i: nat) (e: expr): $ afree e $ > $ afree (proj b i e) $;
--| `spz_ctors D N I X ni npi C C2`: `C2` is the constructors `C` of a type of
--| `I` at the occurrence `X`, specialized: `I`'s types put in, `I`'s own
--| occurrences restored (it may be nested itself), the parameters replaced
--| by `Ds` (`pinst`), then `spz`.
term spz_ctors: ind > ctx > ind > expr > nat > nat > ctors > ctors > wff;
axiom spz_ctors_nil (D: ind) (N: ctx) (I: ind) (X: expr) (ni npi: nat): $ spz_ctors D N I X ni npi cnil cnil $;
axiom spz_ctors_cons (D I: ind) (N NI: ctx) (X K K1 K2 K3 K4: expr) (ni npi: nat) (C C2: ctors):
  $ sinst I 0 ni npi K K1 $ > $ ind_nested I NI $ > $ rst I NI K1 K2 $ > $ afree K2 $ > $ pinst 0 X K2 K3 $ >
  $ spz D N 0 K3 K4 $ >
  $ spz_ctors D N I X ni npi C C2 $ > $ spz_ctors D N I X ni npi (ccons K C) (ccons K4 C2) $;
--| `aux_data D I X j i`: type `j` of `D` has the type of `I`'s type `i` at
--| `X`'s arguments and its constructors specialized.
term aux_data: ind > ind > expr > nat > nat > wff;
axiom aux_data_i (D I: ind) (b bi: blk) (P Pi N: ctx) (T Ti: tys) (j i npi ni mi: nat) (X F Fi: expr) (C Ci: ctors):
  $ ind_data D b P T $ > $ ind_nested D N $ > $ ind_data I bi Pi Ti $ > $ nth_ty T j F C $ > $ nth_ty Ti i Fi Ci $ >
  $ pinst 0 X Fi F $ > $ ind_arity I npi ni mi $ > $ spz_ctors D N I X ni npi Ci C $ > $ aux_data D I X j i $;

-- The recursor's type (`mkRecInfos`) ---------------------------------------

--| `mty D np j d v F M`: `M` is the type of motive `j`, read off `F` (the
--| type's type lifted over the `j` earlier motives) at depth `d`:
--| `Π indices, Π (ind_ty D j params indices), srt v`.
term mty: ind > nat > nat > nat > lvl > expr > expr > wff;
axiom mty_pi (D: ind) (np j d: nat) (v: lvl) (A B M: expr):
  $ mty D np j (s d) v B M $ > $ mty D np j d v (Π A, B) (Π A, M) $;
axiom mty_srt (D: ind) (np j d k: nat) (v l: lvl) (X I: expr):
  $ ⦃ d + j = k ⦄ $ > $ pargs (ind_ty D j) k np X $ > $ pargs X 0 d I $ > $ mty D np j d v (Sort l) (Π I, Sort v) $;
--| `motives D np v j T M`: the motives of the types `j`.. of `T`, as a context
--| (motive `j` outermost).
term motives: ind > nat > lvl > nat > tys > ctx > wff;
axiom motives_nil (D: ind) (np j: nat) (v: lvl): $ motives D np v j tnil [] $;
axiom motives_cons (D: ind) (np j: nat) (v: lvl) (F F2 Mj: expr) (C: ctors) (T: tys) (Mr M: ctx):
  $ ⟮₀ F ↑ j = F2 ⟯ $ > $ mty D np j 0 v F2 Mj $ > $ motives D np v (s j) T Mr $ > $ ⌊ [] ▷ Mj ++ Mr = M ⌋ $ >
  $ motives D np v j (tcons F C T) M $;
--| `ihty D np n mo fld y j A IH`: the type of the inductive hypothesis for a
--| recursive field on type `j` (`recfield`'s), of type `A = Π ys, ind_ty D j params indices` (`A` already
--| over the fields and the minors before it): `Π ys. motive_j indices (field
--| ys)`, with the motives `mo` binders above depth 0 and the field at `#fld`.
term ihty: ind > nat > nat > nat > nat > nat > nat > expr > expr > wff;
axiom ihty_pi (D: ind) (np n mo fld y j: nat) (A B IH: expr):
  $ ihty D np n mo fld (s y) j B IH $ > $ ihty D np n mo fld y j (Π A, B) (Π A, IH) $;
axiom ihty_app (D: ind) (np n mo fld y j ni k a b mj f: nat) (Y X U A: expr):
  $ spine (ind_ty D j) A k $ > $ nidx D j ni $ > $ ⦃ np + ni = k ⦄ $ > $ rehead Y #mj ni A X $ > $ spine (ind_ty D j) Y np $ >
  $ ⦃ y + mo = a ⦄ $ > $ ⦃ a + n = b ⦄ $ > $ ⦃ mj + s j = b ⦄ $ > $ ⦃ y + fld = f ⦄ $ > $ pargs #f 0 y U $ >
  $ ihty D np n mo fld y j A (X @ U) $;
--| `mwalk D np n k i c nf d r Ihs K Min`: `Min` is the rest of the type of
--| minor `k` (for constructor `c` of type `i`, with `nf` fields), read off
--| the constructor type `K` at depth `d`, after `r` recursive fields whose
--| inductive hypotheses are `Ihs`: `Π fields. Π Ihs. motive_i indices
--| (ind_ctor D i c params fields)`. Field types are put over the minors and
--| motives (`lift`, with the block's types put in).
term mwalk: ind > nat > nat > nat > nat > nat > nat > nat > nat > ctx > expr > expr > wff;
axiom mwalk_pi_nr (D: ind) (np n k i c nf d r dp kn: nat) (Ihs: ctx) (A A3 B Min: expr):
  $ ⦃ d + np = dp ⦄ $ > $ closed dp A $ > $ ⦃ k + n = kn ⦄ $ > $ ⟮ₗ [ #d ↑ kn ] A = A3 ⟯ $ >
  $ mwalk D np n k i c nf (s d) r Ihs B Min $ > $ mwalk D np n k i c nf d r Ihs (Π A, B) (Π A3, Min) $;
axiom mwalk_pi_rec (D: ind) (np n k i c nf d r dp kn j a sh fld mo: nat) (Ihs: ctx) (A A2 A3 A4 B IH Min: expr):
  $ ⦃ d + np = dp ⦄ $ > $ recfield D n np d A j $ > $ sinst D 0 n dp A A2 $ > $ ⦃ k + n = kn ⦄ $ > $ ⟮ₗ [ #d ↑ kn ] A2 = A3 ⟯ $ >
  $ ⦃ r + nf = a ⦄ $ > $ ⦃ sh + d = a ⦄ $ > $ ⦃ fld + 1 = sh ⦄ $ > $ ⦃ a + k = mo ⦄ $ > $ ⟮₀ A3 ↑ sh = A4 ⟯ $ >
  $ ihty D np n mo fld 0 j A4 IH $ >
  $ mwalk D np n k i c nf (s d) (s r) (Ihs ▷ IH) B Min $ > $ mwalk D np n k i c nf d r Ihs (Π A, B) (Π A3, Min) $;
axiom mwalk_res (D: ind) (np n k i c d r dp kn h0 h1 h ni mi a b: nat) (Ihs: ctx) (K K2 K3 Y X Y1 Y2 Min: expr):
  $ ⦃ d + np = dp ⦄ $ > $ ⦃ k + n = kn ⦄ $ > $ ⦃ dp + i = h0 ⦄ $ > $ ⦃ h0 + kn = h1 ⦄ $ > $ ⦃ h1 + r = h ⦄ $ >
  $ ⟮ₗ [ #d ↑ kn ] K = K2 ⟯ $ > $ ⟮₀ K2 ↑ r = K3 ⟯ $ > $ nidx D i ni $ > $ rehead Y #mi ni K3 X $ > $ spine #h Y np $ >
  $ ⦃ r + d = a ⦄ $ > $ ⦃ a + kn = b ⦄ $ > $ ⦃ mi + s i = b ⦄ $ > $ pargs (ind_ctor D i c) b np Y1 $ > $ pargs Y1 r d Y2 $ >
  $ ⌊Π Ihs, X @ Y2 = Min ⌋ $ > $ mwalk D np n k i c d d r Ihs K Min $;
--| `cminors D np n k i c C M`: the minors of constructors `c`.. (`C`) of type
--| `i`, from minor `k`; `minors D np n k i T M`: of types `i`.. (`T`). Both
--| as contexts.
term cminors: ind > nat > nat > nat > nat > nat > ctors > ctx > wff;
axiom cminors_nil (D: ind) (np n k i c: nat): $ cminors D np n k i c cnil [] $;
axiom cminors_cons (D: ind) (np n k i c nf: nat) (K Min: expr) (C: ctors) (M1 M: ctx):
  $ npis K nf $ > $ mwalk D np n k i c nf 0 0 [] K Min $ > $ cminors D np n (s k) i (s c) C M1 $ >
  $ ⌊ [] ▷ Min ++ M1 = M ⌋ $ > $ cminors D np n k i c (ccons K C) M $;
term minors: ind > nat > nat > nat > nat > tys > ctx > wff;
axiom minors_nil (D: ind) (np n k i: nat): $ minors D np n k i tnil [] $;
axiom minors_cons (D: ind) (np n k i nc k2: nat) (F: expr) (C: ctors) (T: tys) (M1 M2 M: ctx):
  $ cminors D np n k i 0 C M1 $ > $ clen_c C nc $ > $ ⦃ k + nc = k2 ⦄ $ > $ minors D np n k2 (s i) T M2 $ >
  $ ⌊ M1 ++ M2 = M ⌋ $ > $ minors D np n k i (tcons F C T) M $;
--| `rtail D np n m i d F B`: `B = Π indices. Π (ind_ty D i params indices).
--| motive_i indices major`, read off `F` (lifted over the motives and
--| minors) at depth `d`.
term rtail: ind > nat > nat > nat > nat > nat > expr > expr > wff;
axiom rtail_pi (D: ind) (np n m i d: nat) (A B B2: expr):
  $ rtail D np n m i (s d) B B2 $ > $ rtail D np n m i d (Π A, B) (Π A, B2) $;
axiom rtail_srt (D: ind) (np n m i d mn dmn mi: nat) (l: lvl) (X I X2: expr):
  $ ⦃ m + n = mn ⦄ $ > $ ⦃ d + mn = dmn ⦄ $ > $ pargs (ind_ty D i) dmn np X $ > $ pargs X 0 d I $ >
  $ ⦃ mi + i = dmn ⦄ $ > $ pargs #mi 1 d X2 $ > $ rtail D np n m i d (Sort l) (Π I, X2 @ #0) $;
--| `rec_ty D v i R`: the type of the recursor of type `i` with motives in
--| `srt v`: `Π params. Π motives. Π minors. Π indices. Π major. motive_i
--| indices major`.
term rec_ty: ind > lvl > nat > expr > wff;
axiom rec_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i np n m mn: nat) (M N: ctx) (F F2 B R1 R2 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ motives D np v 0 T M $ > $ minors D np n 0 0 T N $ >
  $ nth_ty T i F C $ > $ ⦃ m + n = mn ⦄ $ > $ ⟮₀ F ↑ mn = F2 ⟯ $ > $ rtail D np n m i 0 F2 B $ >
  $ ⌊Π N, B = R1 ⌋ $ > $ ⌊Π M, R1 = R2 ⌋ $ > $ ⌊Π P, R2 = R ⌋ $ > $ rec_ty D v i R $;
--| `ctor_ty D i c R`: the type of constructor `c` of type `i`: `Π params,` its
--| data type with the block's types applied to the parameters for the type
--| variables (`sinst`), restored (`rst`).
term ctor_ty: ind > nat > nat > expr > wff;
axiom ctor_ty_i (D: ind) (b: blk) (P N: ctx) (T: tys) (i c np n m: nat) (F K K2 K3 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ >
  $ sinst D 0 n np K K2 $ > $ ind_nested D N $ > $ rst D N K2 K3 $ > $ ⌊Π P, K3 = R ⌋ $ > $ ctor_ty D i c R $;

-- The recursor's rules (`mkRecRules`) --------------------------------------

--| `ihval D np n m v nf fld y j A IH`: the inductive hypothesis of a recursive
--| field on type `j` (`recfield`'s): `λ ys, ind_rec D j v params motives minors indices (field ys)`, read
--| off the field's type `A` (over all `nf` fields, the field at `#fld`).
term ihval: ind > nat > nat > nat > lvl > nat > nat > nat > nat > expr > expr > wff;
axiom ihval_lam (D: ind) (np n m: nat) (v: lvl) (nf fld y j: nat) (A B IH: expr):
  $ ihval D np n m v nf fld (s y) j B IH $ > $ ihval D np n m v nf fld y j (Π A, B) (λ A, IH) $;
axiom ihval_app (D: ind) (np n m: nat) (v: lvl) (nf fld y j ni k a mn b f: nat) (Y X1 X2 X3 U A: expr):
  $ spine (ind_ty D j) A k $ > $ nidx D j ni $ > $ ⦃ np + ni = k ⦄ $ > $ rehead Y X2 ni A X3 $ > $ spine (ind_ty D j) Y np $ >
  $ ⦃ y + nf = a ⦄ $ > $ ⦃ m + n = mn ⦄ $ > $ ⦃ a + mn = b ⦄ $ > $ pargs (ind_rec D j v) b np X1 $ > $ pargs X1 a mn X2 $ >
  $ ⦃ y + fld = f ⦄ $ > $ pargs #f 0 y U $ > $ ihval D np n m v nf fld y j A (X3 @ U) $;
--| `rwalk D np n m v nf d Acc K Val`: `Val = λ fields, Acc ihs`, read off the
--| constructor type `K` at depth `d`, where `Acc` is the minor applied to
--| the fields and `ihs` the inductive hypotheses of the recursive fields.
term rwalk: ind > nat > nat > nat > lvl > nat > nat > expr > expr > expr > wff;
axiom rwalk_pi_nr (D: ind) (np n m: nat) (v: lvl) (nf d dp mn: nat) (Acc A A3 B Val: expr):
  $ ⦃ d + np = dp ⦄ $ > $ closed dp A $ > $ ⦃ m + n = mn ⦄ $ > $ ⟮ₗ [ #d ↑ mn ] A = A3 ⟯ $ >
  $ rwalk D np n m v nf (s d) Acc B Val $ > $ rwalk D np n m v nf d Acc (Π A, B) (λ A3, Val) $;
axiom rwalk_pi_rec (D: ind) (np n m: nat) (v: lvl) (nf d dp mn j sh fld: nat) (Acc A A2 A3 A4 B IH Val: expr):
  $ ⦃ d + np = dp ⦄ $ > $ recfield D n np d A j $ > $ sinst D 0 n dp A A2 $ > $ ⦃ m + n = mn ⦄ $ > $ ⟮ₗ [ #d ↑ mn ] A2 = A3 ⟯ $ >
  $ ⦃ sh + d = nf ⦄ $ > $ ⦃ fld + 1 = sh ⦄ $ > $ ⟮₀ A3 ↑ sh = A4 ⟯ $ > $ ihval D np n m v nf fld 0 j A4 IH $ >
  $ rwalk D np n m v nf (s d) (Acc @ IH) B Val $ > $ rwalk D np n m v nf d Acc (Π A, B) (λ A3, Val) $;
axiom rwalk_res (D: ind) (np n m: nat) (v: lvl) (d: nat) (Acc K: expr):
  $ npis K 0 $ > $ rwalk D np n m v d d Acc K Acc $;
--| `rec_rhs D v i c R`: the right-hand side of the recursor's rule for
--| constructor `c` of type `i`: `λ params. λ motives. λ minors. λ fields.
--| minor_k fields ihs`.
term rec_rhs: ind > lvl > nat > nat > expr > wff;
axiom rec_rhs_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i c np n m k nf a mk: nat) (M N: ctx) (F K Acc Val R1 R2 R: expr) (C: ctors):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ motives D np v 0 T M $ > $ minors D np n 0 0 T N $ >
  $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ minor_idx T i c k $ > $ npis K nf $ >
  $ ⦃ nf + m = a ⦄ $ > $ ⦃ mk + s k = a ⦄ $ > $ pargs #mk 0 nf Acc $ > $ rwalk D np n m v nf 0 Acc K Val $ >
  $ ⌊λ N, Val = R1 ⌋ $ > $ ⌊λ M, R1 = R2 ⌋ $ > $ ⌊λ P, R2 = R ⌋ $ > $ rec_rhs D v i c R $;

-- The recursor's rules as closed equations (draft) -------------------------

--| `clift k X Y`: the context `Y` is `X` moved under `k` more variables: each
--| entry lifted by `k` past the entries before it.
term clift: nat > ctx > ctx > wff;
axiom clift_nil (k: nat): $ clift k [] [] $;
axiom clift_cons (k d: nat) (A A2: expr) (X Y: ctx):
  $ clift k X Y $ > $ ⌊| X | = d ⌋ $ > $ ⟮ₗ [ #d ↑ k ] A = A2 ⟯ $ > $ clift k (X ▷ A) (Y ▷ A2) $;
--| `psplit n K A X res`: `K` is `Π` over `n` binders of `res`, and `X` is
--| those binders' context on top of `A` (the inverse of `pis` at a given
--| number of binders).
term psplit: nat > expr > ctx > ctx > expr > wff;
axiom psplit_z (K: expr) (A: ctx): $ psplit 0 K A A K $;
axiom psplit_s (n: nat) (B C res: expr) (A X: ctx):
  $ psplit n C (A ▷ B) X res $ > $ psplit (s n) (Π B, C) A X res $;
--| `iota_tel D v i c X res nf Dl`: the context `Dl` of the rule of constructor
--| `c` of type `i` as a closed equation: the parameters, the motives, the
--| minors, then the constructor's `nf` fields `X` (its type with the block's
--| types put in is `Π X, res`), moved under the motives and the minors.
term iota_tel: ind > lvl > nat > nat > ctx > expr > nat > ctx > wff;
axiom iota_tel_i (D: ind) (b: blk) (P: ctx) (T: tys) (v: lvl) (i c np n m mn nf: nat) (M N X Xl Q1 Q2 Dl: ctx)
    (F K K2 res: expr) (C: ctors):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ motives D np v 0 T M $ > $ minors D np n 0 0 T N $ >
  $ nth_ty T i F C $ > $ nth_ctor C c K $ > $ npis K nf $ > $ sinst D 0 n np K K2 $ > $ psplit nf K2 [] X res $ >
  $ ⦃ m + n = mn ⦄ $ > $ clift mn X Xl $ > $ ⌊ P ++ M = Q1 ⌋ $ > $ ⌊ Q1 ++ N = Q2 ⌋ $ > $ ⌊ Q2 ++ Xl = Dl ⌋ $ >
  $ iota_tel D v i c X res nf Dl $;
--| `iota_lhs D v i c nf res e3 c1 maj e4 T`: in that context, `e3` is the
--| recursor at the parameters, the motives and the minors, `c1` the
--| constructor at the parameters and `maj` at the fields too, `e4` is `e3` at
--| the indices of the constructor's result `res`, and `T` is the motive of
--| type `i` at those indices and `maj`.
term iota_lhs: ind > lvl > nat > nat > nat > expr > expr > expr > expr > expr > expr > wff;
axiom iota_lhs_i (D: ind) (v: lvl) (i c np n m mn nf ni a d1 io mo: nat) (res e1 e2 e3 e4 Y T2 T0 c1 maj: expr):
  $ ind_arity D np n m $ > $ nidx D i ni $ >
  $ ⦃ m + n = mn ⦄ $ > $ ⦃ nf + m = a ⦄ $ > $ ⦃ a + n = d1 ⦄ $ >
  $ pargs (ind_rec D i v) d1 np e1 $ > $ pargs e1 a n e2 $ > $ pargs e2 nf m e3 $ >
  $ pargs (ind_ty D i) d1 np Y $ > $ ⟮ₗ [ #nf ↑ mn ] res = T2 ⟯ $ > $ rehead Y e3 ni T2 e4 $ >
  $ pargs (ind_ctor D i c) d1 np c1 $ > $ pargs c1 0 nf maj $ >
  $ ⦃ io + s i = n ⦄ $ > $ ⦃ a + io = mo ⦄ $ > $ rehead Y #mo ni T2 T0 $ >
  $ iota_lhs D v i c nf res e3 c1 maj e4 (T0 @ maj) $;
--| `iota_eq D i c v Dl lhs rhs T`: the rule of constructor `c` of type `i`
--| as a closed equation over the block's own types and constructors (for a
--| block with nested occurrences, the rule restores it, `rst`): its context
--| (`iota_tel`), its left-hand side and type (`iota_lhs`), and its right-hand
--| side, `rec_rhs`'s closed term at the context's variables. For `Nat.rec` at
--| `succ`, with `N` for the type and `R` for `rec_rhs`'s term: the context is
--| `[] ▷ (Π N. Sort v) ▷ (#0 @ zero) ▷ (Π N. Π (#2 @ #0). #3 @ (succ @ #1)) ▷
--| N` (the motive, the two minors, the field), `lhs` is `rec @ #3 @ #2 @
--| #1 @ (succ @ #0)`, `rhs` is `R @ #3 @ #2 @ #1 @ #0` and `T` is `#3 @ (succ
--| @ #0)`.
term iota_eq: ind > nat > nat > lvl > ctx > expr > expr > expr > wff;
axiom iota_eq_i (D: ind) (i c: nat) (v: lvl) (np n m a0 ar nf: nat) (X Dl: ctx) (res e3 e4 c1 maj Rh rhs0 rhs T: expr):
  $ iota_tel D v i c X res nf Dl $ > $ iota_lhs D v i c nf res e3 c1 maj e4 T $ >
  $ rec_rhs D v i c Rh $ > $ ind_arity D np n m $ > $ ⦃ np + n = a0 ⦄ $ > $ ⦃ a0 + m = ar ⦄ $ >
  $ rehead (ind_rec D i v) Rh ar e3 rhs0 $ > $ rehead c1 rhs0 nf maj rhs $ >
  $ iota_eq D i c v Dl (e4 @ maj) rhs T $;

-- Structures: fields, projections and eta ----------------------------------

--| `struct_like D j`: type `j` has one constructor and no indices (the kernel's
--| `is_structure_like`; a type of a mutual block may qualify).
term struct_like: ind > nat > wff;
axiom struct_like_i (D: ind) (b: blk) (P: ctx) (T: tys) (j: nat) (F K: expr) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ isort F 0 l $ > $ struct_like D j $;
--| `field_ty D j i A`: the type of field `i` of the constructor of type `j`,
--| under the parameters and the earlier fields, with the block's types put in.
term field_ty: ind > nat > nat > expr > wff;
axiom field_ty_i (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K K2 A: expr) (C: ctors):
  $ ind_data D b P T $ > $ nth_ty T j F C $ > $ nth_ctor C 0 K $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ >
  $ sinst D 0 n np K K2 $ > $ nth_pi K2 i A $ > $ field_ty D j i A $;
--| `qinst b e k j A R`: `R` is `A` with the `k` remaining fields `j`,
--| `j+1`, ... (field `j` at `#(k-1)`) replaced by the projections of `e`.
term qinst: blk > expr > nat > nat > expr > expr > wff;
axiom qinst_z (b: blk) (e A: expr) (j: nat): $ qinst b e 0 j A A $;
axiom qinst_s (b: blk) (e A A1 R: expr) (k j: nat):
  $ ⟮ [ #k ↦ proj b j e ] A = A1 ⟯ $ > $ qinst b e k (s j) A1 R $ > $ qinst b e (s k) j A R $;
--| Structure eta is for a structure whose fields do not mention the block
--| (`nonrec`, `eta_ok`); `projs b e k Y M`: `M = Y @ proj b 0 e @ .. @ proj b (k-1) e`.
term nonrec: nat > nat > expr > wff;
axiom nonrec_pi (np d k: nat) (A B: expr): $ ⦃ d + np = k ⦄ $ > $ closed k A $ > $ nonrec np (s d) B $ > $ nonrec np d (Π A, B) $;
axiom nonrec_res (np d: nat) (K: expr): $ npis K 0 $ > $ nonrec np d K $;
term eta_ok: ind > nat > wff;
axiom eta_ok_i (D: ind) (b: blk) (P: ctx) (T: tys) (j np: nat) (F K: expr):
  $ struct_like D j $ > $ ind_data D b P T $ > $ nth_ty T j F (ccons K cnil) $ > $ ⌊| P | = np ⌋ $ > $ nonrec np 0 K $ >
  $ eta_ok D j $;
term projs: blk > expr > nat > expr > expr > wff;
axiom projs_z (b: blk) (e Y: expr): $ projs b e 0 Y Y $;
axiom projs_s (b: blk) (e Y M: expr) (k: nat): $ projs b e k Y M $ > $ projs b e (s k) Y (M @ proj b k e) $;
--| `proj_eq D j i Dl lhs k`: the reduction of field `i` of type `j`'s first
--| constructor as a closed equation, over the block's own types: `Dl` is the
--| context of the parameters and then the constructor's fields `X` (`psplit`
--| of its type with the block's types put in, `sinst`), `lhs` is `proj b i` of
--| the constructor applied to the parameters and the fields, all variables of
--| `Dl` (windows `pargs`), and `#k` is field `i`. For `Prod.mk`, field `0`:
--| the context is `[] ▷ Sort u ▷ Sort v ▷ #1 ▷ #1` (`α`, `β`, `fst`,
--| `snd`), `lhs` is `proj b 0 (mk @ #3 @ #2 @ #1 @ #0)` and `k` is `1`.
term proj_eq: ind > nat > nat > ctx > expr > nat > wff;
axiom proj_eq_i (D: ind) (b: blk) (P X Dl: ctx) (T: tys) (j i np n m nf k: nat) (F K K2 res c1 maj: expr) (C: ctors):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ nth_ty T j F C $ > $ nth_ctor C 0 K $ > $ npis K nf $ >
  $ sinst D 0 n np K K2 $ > $ psplit nf K2 [] X res $ > $ ⌊ P ++ X = Dl ⌋ $ >
  $ pargs (ind_ctor D j 0) nf np c1 $ > $ pargs c1 0 nf maj $ > $ ⦃ k + s i = nf ⦄ $ >
  $ proj_eq D j i Dl (proj b i maj) k $;
--| `eta_eq D j Dl M S`: structure eta for type `j` as a closed equation:
--| `Dl` is the context of the parameters and then one variable of the type
--| applied to them (`S0`), `S` is that type seen from inside `Dl`, and `M` is
--| the constructor applied to the parameters and to the projections of `#0`.
--| For `Prod`: the context is `[] ▷ Sort u ▷ Sort v ▷ Prod @ #1 @ #0`
--| (`α`, `β`, `p`), `S` is `Prod @ #2 @ #1` and `M` is
--| `mk @ #2 @ #1 @ proj b 0 #0 @ proj b 1 #0`.
term eta_eq: ind > nat > ctx > expr > expr > wff;
axiom eta_eq_i (D: ind) (b: blk) (P: ctx) (T: tys) (j np nf: nat) (S0 S Y M: expr):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ pargs (ind_ty D j) 0 np S0 $ > $ ⟮₀ S0 ↑ 1 = S ⟯ $ >
  $ rehead (ind_ty D j) (ind_ctor D j 0) np S Y $ > $ nfields D j 0 nf $ > $ projs b #0 nf Y M $ >
  $ eta_eq D j (P ▷ S0) M S $;
---------------------------------------------------------------------------
-- PART II: DEFINITIONS OVER LEVEL EQUIVALENCE AND THE JUDGMENT
---------------------------------------------------------------------------

-- Level equivalence of expressions -----------------------------------------

--| `ind_eqv D D2`: the blocks agree except at levels, which are equivalent
--| (`teqv`, `cseqv`: their types and constructors).
term ind_eqv: ind > ind > wff;
term teqv: tys > tys > wff;
term cseqv: ctors > ctors > wff;
axiom eeqv_ind_ty (D D2: ind) (i: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ty D i) (ind_ty D2 i) $;
axiom eeqv_ind_ctor (D D2: ind) (i c: nat): $ ind_eqv D D2 $ > $ eeqv (ind_ctor D i c) (ind_ctor D2 i c) $;
axiom eeqv_ind_rec (D D2: ind) (i: nat) (v v2: lvl):
  $ ind_eqv D D2 $ > $ v ≈ v2 $ > $ eeqv (ind_rec D i v) (ind_rec D2 i v2) $;
axiom eeqv_proj (b: blk) (i: nat) (e e2: expr): $ eeqv e e2 $ > $ eeqv (proj b i e) (proj b i e2) $;
axiom ind_eqv_i (D D2: ind) (b: blk) (P P2 N N2: ctx) (T T2: tys):
  $ ind_data D b P T $ > $ ind_data D2 b P2 T2 $ > $ ceqv P P2 $ > $ teqv T T2 $ >
  $ ind_nested D N $ > $ ind_nested D2 N2 $ > $ ceqv N N2 $ > $ ind_eqv D D2 $;
axiom teqv_nil: $ teqv tnil tnil $;
axiom teqv_cons (F F2: expr) (C C2: ctors) (T T2: tys):
  $ eeqv F F2 $ > $ cseqv C C2 $ > $ teqv T T2 $ > $ teqv (tcons F C T) (tcons F2 C2 T2) $;
axiom cseqv_nil: $ cseqv cnil cnil $;
axiom cseqv_cons (K K2: expr) (C C2: ctors): $ eeqv K K2 $ > $ cseqv C C2 $ > $ cseqv (ccons K C) (ccons K2 C2) $;

-- Well-formedness of an inductive block ------------------------------------
-- `checkInductiveTypes` and `checkConstructors`; for a nested block, `nst_ok`:
-- the occurrences come in groups, one per declared type of a well-formed block
-- `I`, each auxiliary type with `I`'s data specialized.

--| `cwf D n np l i Ctx d K`: `K`, the rest of a constructor type of type `i`
--| at depth `d`, is well formed in `Ctx` (the fields so far, with the block's
--| types put in, over the parameters and `G`): each field type is a type of
--| an allowed level and positive, a recursive field (`cwf_pi_rec`) is not
--| mentioned in the rest of the type, and the result is type `i` applied to
--| the parameters and indices, each argument typed at its binder's type in
--| type `i`'s type (`checkConstructors`, whose `checkType` of the whole
--| constructor type types the indices). The kernel's typing implies that a
--| recursive field is not mentioned later (a term mentioning a field of type
--| `T` mentions `T`, which neither a positive field's domain nor an index may
--| do); the model sees only that the typings hold, not that they are
--| derivable, so the spec states it (`#0` does not occur in `B` when `B` is
--| the lift of something: the `inst` premise only computes that).
term cwf: ind > nat > nat > lvl > nat > ctx > nat > expr > wff;
axiom cwf_pi (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2: expr) (u: lvl):
  $ ⦃ d + np = k ⦄ $ > $ closed k A $ > $ sinst D 0 n k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Sort u ⟧ $ > $ ulevel l u $ >
  $ cwf D n np l i (Ctx ▷ A2) (s d) B $ > $ cwf D n np l i Ctx d (Π A, B) $;
axiom cwf_pi_rec (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (A B A2 B2: expr) (u: lvl):
  $ ⦃ d + np = k ⦄ $ > $ sinst D 0 n k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Sort u ⟧ $ > $ ulevel l u $ > $ ipos D n np d A $ >
  $ ⟮ [ #0 ↦ Sort lz ] B = B2 ⟯ $ > $ ⟮₀ B2 ↑ 1 = B ⟯ $ >
  $ cwf D n np l i (Ctx ▷ A2) (s d) B $ > $ cwf D n np l i Ctx d (Π A, B) $;
axiom cwf_res (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (d k: nat) (K K2: expr) (b: blk) (P: ctx)
    (T: tys) (F: expr) (C: ctors) (R R2 S: expr):
  $ indapp D n np d K i $ > $ ⦃ d + np = k ⦄ $ > $ sinst D 0 n k K K2 $ > $ ind_data D b P T $ > $ nth_ty T i F C $ >
  $ ⌊Π P, F = R ⌋ $ > $ ⟮₀ R ↑ k = R2 ⟯ $ > $ sty Ctx (ind_ty D i) R2 K2 S $ > $ cwf D n np l i Ctx d K $;
--| `ctors_wf D n np l i Ctx C`: the constructors `C` of type `i` are well
--| formed, and each is closed over the parameters and the types (`Π P, K`
--| mentions only the `n` types: a constructor is a closed constant, as
--| `tys_closed` for the types' types).
term ctors_wf: ind > nat > nat > lvl > nat > ctx > ctors > wff;
axiom ctors_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ ctors_wf D n np l i Ctx cnil $;
axiom ctors_wf_cons (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx) (K: expr) (C: ctors) (b: blk) (P: ctx)
    (T: tys) (R: expr):
  $ ind_data D b P T $ > $ ⌊Π P, K = R ⌋ $ > $ closed n R $ >
  $ cwf D n np l i Ctx 0 K $ > $ ctors_wf D n np l i Ctx C $ > $ ctors_wf D n np l i Ctx (ccons K C) $;
--| `tys_wf D n np l i Ctx T`: the types `i`.. of `T`, in `Ctx = P ++ G`: each
--| type's type is `Π indices, srt l` (all in the same universe `l`,
--| `checkInductiveTypes`) and its constructors are well formed.
term tys_wf: ind > nat > nat > lvl > nat > ctx > tys > wff;
axiom tys_wf_nil (D: ind) (n np: nat) (l: lvl) (i: nat) (Ctx: ctx): $ tys_wf D n np l i Ctx tnil $;
axiom tys_wf_cons (D: ind) (n np: nat) (l l2: lvl) (i k: nat) (Ctx: ctx) (F: expr) (C: ctors) (T: tys):
  $ isort F k l2 $ > $ l2 ≈ l $ > $ ctors_wf D n np l i Ctx C $ > $ tys_wf D n np l (s i) Ctx T $ >
  $ tys_wf D n np l i Ctx (tcons F C T) $;
--| `ctx_wf G P`: each parameter type is a type over the earlier ones.
term ctx_wf: ctx > ctx > wff;
axiom ctx_wf_nil (G: ctx): $ ctx_wf G [] $;
axiom ctx_wf_cons (G P G2: ctx) (A: expr) (u: lvl):
  $ ctx_wf G P $ > $ ⌊ G ++ P = G2 ⌋ $ > $ ⟦ₜ G2 ⊢ A : Sort u ⟧ $ > $ ctx_wf G (P ▷ A) $;
--| `tys_ty Ctx T`: each type's type is binders over a sort (`isort`) and a type
--| in `Ctx = P ++ G`.
term tys_ty: ctx > tys > wff;
axiom tys_ty_nil (Ctx: ctx): $ tys_ty Ctx tnil $;
axiom tys_ty_cons (Ctx: ctx) (F: expr) (C: ctors) (T: tys) (u l: lvl) (k: nat):
  $ isort F k l $ > $ ⟦ₜ Ctx ⊢ F : Sort u ⟧ $ > $ tys_ty Ctx T $ > $ tys_ty Ctx (tcons F C T) $;
--| `tys_ok G D`: the parameters and the types' types are closed, the
--| parameters are types over the earlier ones and the types' types are types:
--| what typing `ind_ty D i` needs (the kernel adds the types before it checks
--| the constructors; a block whose constructors are not legal denotes a family
--| of empty types).
term tys_ok: ctx > ind > wff;
axiom tys_ok_i (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys):
  $ ind_data D b P T $ > $ tys_closed P T $ > $ ctx_wf G P $ > $ ⌊ G ++ P = G2 ⌋ $ > $ tys_ty G2 T $ > $ tys_ok G D $;
--| A well-formed block, in context `G` (`ind_wf_i`, after `nst_ok` below).
term ind_wf: ctx > ind > wff;
--| `nst_ok G D j N2`: the occurrences `N2` (from auxiliary type `j` on) come
--| in groups, one per declared type of a well-formed block `I` in order with
--| the same arguments (`nst_group`, types `i` to `ni0`; `I.all` excludes
--| `I`'s own auxiliary types), each with the data of `aux_data` (Part I).
--| `I` declares a type (`0 < ni0`), and a group's arguments are typed
--| (`nst_ty`).
term nst_ok: ctx > ind > nat > ctx > wff;
term nst_group: ctx > ind > ind > expr > nat > nat > nat > ctx > ctx > wff;
--| `nst_ty G D I X`: the arguments of the occurrence `X` of `I`'s first type
--| are typed at `I`'s parameters under the block's (`sty`, with the block's
--| types put in: as in `cwf_res`, a head applied to arguments of other types
--| has no meaning; audit §4). They mention no variable of `G` (`closed`):
--| the block's constants are closed.
term nst_ty: ctx > ind > ind > expr > wff;
axiom nst_ty_i (G G2: ctx) (D I: ind) (b bi: blk) (P Pi: ctx) (T Ti: tys) (np n m: nat) (X X1 Fi RI S: expr) (Ci: ctors):
  $ ind_data D b P T $ > $ ⌊ G ++ P = G2 ⌋ $ > $ ind_arity D np n m $ > $ sinst D 0 n np X X1 $ > $ closed np X1 $ >
  $ ind_data I bi Pi Ti $ > $ nth_ty Ti 0 Fi Ci $ > $ ⌊Π Pi, Fi = RI ⌋ $ > $ sty G2 (ind_ty I 0) RI X1 S $ > $ nst_ty G D I X $;
axiom nst_ok_nil (G: ctx) (D: ind) (j: nat): $ nst_ok G D j [] $;
axiom nst_ok_cons (G: ctx) (D I: ind) (j j2 npi ni mi ni0: nat) (X: expr) (N2 N3 NI: ctx):
  $ spine (ind_ty I 0) X npi $ > $ ind_wf G I $ > $ ind_arity I npi ni mi $ > $ ind_nested I NI $ > $ ndecl NI ni ni0 $ >
  $ 0 < ni0 $ > $ nst_ty G D I X $ >
  $ nst_group G D I X j 0 ni0 (X :: N2) N3 $ > $ ⦃ j + ni0 = j2 ⦄ $ > $ nst_ok G D j2 N3 $ > $ nst_ok G D j (X :: N2) $;
axiom nst_group_done (G: ctx) (D I: ind) (X0: expr) (j ni: nat) (N: ctx): $ nst_group G D I X0 j ni ni N N $;
axiom nst_group_cons (G: ctx) (D I: ind) (X0 X: expr) (j i ni npi: nat) (N N2: ctx):
  $ i < ni $ > $ spine (ind_ty I 0) X0 npi $ > $ rehead (ind_ty I 0) (ind_ty I i) npi X0 X $ > $ aux_data D I X j i $ >
  $ nst_group G D I X0 (s j) (s i) ni N N2 $ > $ nst_group G D I X0 j i ni (X :: N) N2 $;
--| A well-formed block, in context `G` (`l`, the block's universe, is the first
--| type's).
axiom ind_wf_i (G G2: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (np n m k n0: nat) (l: lvl) (F: expr) (C: ctors):
  $ tys_ok G D $ > $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ ⌊ G ++ P = G2 ⌋ $ >
  $ nth_ty T 0 F C $ > $ isort F k l $ > $ tys_wf D n np l 0 G2 T $ >
  $ ind_nested D N $ > $ ndecl N n n0 $ > $ nst_ok G D n0 N $ > $ ind_wf G D $;

-- The elimination level (`isLargeEliminator`) ------------------------------

--| `elim_ok G D v`: the recursor may have motives in `srt v`: always for
--| `v ≈ 0`; for every `v` when the types are never propositions, or the block
--| is one type with no constructors, or one type with one constructor whose
--| fields that are not propositions all appear as arguments of its result.
term large: ctx > ind > wff;
--| `fir D np Ctx d K`: each remaining field is a proposition or an argument
--| of the result.
term fir: ind > nat > ctx > nat > expr > wff;
term elim_ok: ctx > ind > lvl > wff;
axiom elim_prop (G: ctx) (D: ind) (v: lvl): $ v ≈ lz $ > $ elim_ok G D v $;
axiom elim_large (G: ctx) (D: ind) (v: lvl): $ large G D $ > $ elim_ok G D v $;
axiom large_nz (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (F: expr) (C: ctors) (k: nat) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T 0 F C $ > $ isort F k l $ > $ ls lz ⊔ l ≈ l $ > $ large G D $;
axiom large_empty (G: ctx) (D: ind) (b: blk) (P: ctx) (F: expr):
  $ ind_data D b P (tcons F cnil tnil) $ > $ large G D $;
axiom large_single (G G2: ctx) (D: ind) (b: blk) (P: ctx) (F K: expr) (np: nat):
  $ ind_data D b P (tcons F (ccons K cnil) tnil) $ > $ ⌊| P | = np ⌋ $ > $ ⌊ G ++ P = G2 ⌋ $ > $ fir D np G2 0 K $ >
  $ large G D $;
--| `fir D np Ctx d K`: each remaining field is a proposition or an argument
--| of the result; `leaf_has j e`: `#j` (at the binder's depth) is an argument
--| of the result under the remaining binders.
axiom fir_res (D: ind) (np: nat) (Ctx: ctx) (d: nat) (K: expr):
  $ indapp D 1 np d K 0 $ > $ fir D np Ctx d K $;
axiom fir_arg (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr):
  $ leaf_has 0 B $ > $ ⦃ d + np = k ⦄ $ > $ sinst D 0 1 k A A2 $ > $ fir D np (Ctx ▷ A2) (s d) B $ >
  $ fir D np Ctx d (Π A, B) $;
axiom fir_prop (D: ind) (np: nat) (Ctx: ctx) (d k: nat) (A A2 B: expr):
  $ ⦃ d + np = k ⦄ $ > $ sinst D 0 1 k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Prop ⟧ $ > $ fir D np (Ctx ▷ A2) (s d) B $ >
  $ fir D np Ctx d (Π A, B) $;

-- Projections from a structure that may be a proposition (`infer_proj`) ----

--| `proj_ok G D j i`: field `i` of type `j` may be projected: the type's sort
--| is at least 1, or the fields up to `i` are all propositions (nanoda's
--| `infer_proj`, which requires only the projected and the dependent ones).
term fprops: ind > nat > nat > ctx > nat > nat > expr > wff;
term proj_ok: ctx > ind > nat > nat > wff;
axiom proj_ok_sort (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i: nat) (F: expr) (C: ctors) (l: lvl):
  $ ind_data D b P T $ > $ nth_ty T j F C $ > $ isort F 0 l $ > $ ls lz ⊔ l ≈ l $ > $ proj_ok G D j i $;
axiom proj_ok_prop (G G2: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (j i np n m: nat) (F K: expr) (C: ctors):
  $ ind_data D b P T $ > $ ⌊| P | = np ⌋ $ > $ ntys T n m $ > $ ⌊ G ++ P = G2 ⌋ $ > $ nth_ty T j F C $ > $ nth_ctor C 0 K $ >
  $ fprops D n np G2 0 (s i) K $ > $ proj_ok G D j i $;
--| `fprops D n np Ctx d cnt K`: the next `cnt` fields of `K` are propositions.
axiom fprops_z (D: ind) (n np: nat) (Ctx: ctx) (d: nat) (K: expr): $ fprops D n np Ctx d 0 K $;
axiom fprops_s (D: ind) (n np: nat) (Ctx: ctx) (d cnt k: nat) (A A2 B: expr):
  $ ⦃ d + np = k ⦄ $ > $ sinst D 0 n k A A2 $ > $ ⟦ₜ Ctx ⊢ A2 : Prop ⟧ $ > $ fprops D n np (Ctx ▷ A2) (s d) cnt B $ >
  $ fprops D n np Ctx d (s cnt) (Π A, B) $;

---------------------------------------------------------------------------
-- PART III: THE RULES
---------------------------------------------------------------------------

-- Inductive types: typing, iota, projections and eta (audit §4) ------------

--| The type former: `ind_ty D i : (ps : P) → F`, for the `i`-th type of the
--| block `D` with parameters `P` and declared type `F` (`pis P F R`: `R` is
--| `F` under the parameters' binders).
axiom ind_ty_ty (G: ctx) (D: ind) (b: blk) (P: ctx) (T: tys) (i: nat) (F R: expr) (C: ctors):
  $ tys_ok G D $ > $ ind_data D b P T $ > $ nth_ty T i F C $ > $ ⌊Π P, F = R ⌋ $ > $ ⟦ₜ G ⊢ ind_ty D i : R ⟧ $;
--| The constructor: `ind_ctor D i c : R`, with `R` the constructor's declared
--| type under the parameters, the block's types put in for its variables
--| (`ctor_ty`).
axiom ind_ctor_ty (G: ctx) (D: ind) (i c: nat) (R: expr):
  $ ind_wf G D $ > $ ctor_ty D i c R $ > $ ⟦ₜ G ⊢ ind_ctor D i c : R ⟧ $;
--| The recursor: `ind_rec D i v : (ps) → (motives) → (minors) → (indices) →
--| (t : I ps indices) → motive indices t`, as `rec_ty` builds it, for `I`
--| the block's `i`-th type; `v` is the motives' universe, allowed by
--| `elim_ok`; `rst` puts back the nested occurrences (the identity at a
--| block without them).
axiom ind_rec_ty (G: ctx) (D: ind) (N: ctx) (i: nat) (v: lvl) (R0 R: expr):
  $ ind_wf G D $ > $ elim_ok G D v $ > $ rec_ty D v i R0 $ > $ ind_nested D N $ > $ rst D N R0 R $ > $ ⟦ₜ G ⊢ ind_rec D i v : R ⟧ $;
--| Weakening below a closed context: a judgment in a context `G` whose
--| entries and terms mention no variable outside `G` holds over any base
--| context `G0` (`IsDefEq.weakN` for `Ctx.LiftN n k` at `k` the length of
--| `G`, where lifting is the identity; see notes/audit-lean-mm0.md §6).
axiom weakBaseDF (k: nat) (G G0 G2: ctx) (e e2 A K: expr):
  $ ⟦ G ⊢ e ≡ e2 : A ⟧ $ > $ ⌊Π G, Sort lz = K ⌋ $ > $ closed 0 K $ > $ ⌊| G | = k ⌋ $ >
  $ closed k e $ > $ closed k e2 $ > $ closed k A $ > $ ⌊ G0 ++ G = G2 ⌋ $ >
  $ ⟦ G2 ⊢ e ≡ e2 : A ⟧ $;
--| Iota as a closed equation (`iota_eq`): in the context `Dl` of the
--| recursor's own variables, `ind_rec D i v ps ms ns is (ind_ctor D i c ps fs)
--| ≡ Rh ps ms ns fs`, with the block's auxiliary types and constructors
--| restored to its nested occurrences in the context, both sides and the type
--| (`crst`, `rst`; nothing to restore when `N` is empty). No typing premise:
--| every argument is a variable of the context or an index of the
--| constructor's result. Instances follow by `weakBaseDF` and `instDF`.
axiom ind_iota_eq (D: ind) (N: ctx) (i c: nat) (v: lvl) (Dl0 Dl: ctx) (lhs0 rhs0 T0 lhs rhs T: expr):
  $ ind_wf Dl D $ > $ elim_ok Dl D v $ > $ iota_eq D i c v Dl0 lhs0 rhs0 T0 $ > $ ind_nested D N $ >
  $ crst D N Dl0 Dl $ > $ rst D N lhs0 lhs $ > $ rst D N rhs0 rhs $ > $ rst D N T0 T $ >
  $ ⟦ Dl ⊢ lhs ≡ rhs : T ⟧ $;
--| `e.i ≡ e2.i : A[ps, e.0, …, e.(i-1)]` from `e ≡ e2 : I ps`, for a
--| structure `I` (the block's `j`-th type) whose `i`-th field has type `A`
--| and may be projected (`proj_ok`).
axiom proj_ty (G: ctx) (D: ind) (b: blk) (P N: ctx) (T: tys) (j i np: nat) (e e2 S A A1 A2 R: expr):
  $ ⟦ G ⊢ e ≡ e2 : S ⟧ $ > $ spine (ind_ty D j) S np $ > $ ind_wf G D $ > $ ind_data D b P T $ > $ struct_like D j $ >
  $ proj_ok G D j i $ > $ ⌊| P | = np ⌋ $ > $ field_ty D j i A $ > $ ind_nested D N $ > $ rst D N A A2 $ > $ pinst i S A2 A1 $ >
  $ qinst b e i 0 A1 R $ >
  $ ⟦ G ⊢ proj b i e ≡ proj b i e2 : R ⟧ $;
--| `proj b i (ind_ctor D j 0 @ ps @ fs) ≡ fs[i]` when the field may be
--| projected (`proj_ok`), as a closed equation: stated once (`proj_eq`), in
--| the context of the parameters and the constructor's fields, with the
--| block's auxiliary types restored to its nested occurrences in the context
--| and the left-hand side (`crst`, `rst`; nothing to restore when `N` is
--| empty). The field is a variable of the context, at its type there
--| (`lookup`). No typing premise: every argument is a variable of the
--| context. Instances follow by `weakBaseDF` and `instDF`.
axiom proj_mk (D: ind) (N: ctx) (j i k: nat) (Dl0 Dl: ctx) (lhs0 lhs T: expr):
  $ ind_wf Dl D $ > $ proj_ok Dl D j i $ > $ proj_eq D j i Dl0 lhs0 k $ > $ ind_nested D N $ >
  $ crst D N Dl0 Dl $ > $ rst D N lhs0 lhs $ > $ ⟮ₖ Dl ∋ #k : T ⟯ $ > $ ⟦ Dl ⊢ lhs ≡ #k : T ⟧ $;
--| Structure eta, `e ≡ ind_ctor D j 0 @ ps @ (proj b 0 e) @ …`, when the type
--| has it (`eta_ok`), as a closed equation: stated once (`eta_eq`), in the
--| context of the parameters and one variable of the structure type, for
--| that variable. No typing premise. Instances follow by `weakBaseDF` and
--| `instDF`.
axiom ind_eta (D: ind) (j: nat) (Dl: ctx) (M S: expr):
  $ ind_wf Dl D $ > $ eta_ok D j $ > $ eta_eq D j Dl M S $ > $ ⟦ Dl ⊢ #0 ≡ M : S ⟧ $;
