include "../lib.auf";

-- Contexts under the binders of a Church numeral: α : Sort u, s : α → α, z : α.
def q1 (G: ctx) (u: lvl): ctx = $ cons (srt u) G $
def q2 (G: ctx) (u: lvl): ctx = $ cons (pi v0 v1) (q1 G u) $
def q3 (G: ctx) (u: lvl): ctx = $ cons v1 (q2 G u) $

-- The body of `succ`, under `n`, `α`, `s`, `z`.
def sbody: expr = $ app v1 (app (app (app v3 v2) v1) v0) $

lemma cl_cnat (u: lvl): $ closed nz (cnat u) $
----
l1: $ closed nz (cnat u) $
  by closed_pi [closed_srt [],
       closed_pi [closed_pi [closed_bvar [le_s [le_z []]], closed_bvar [le_s [le_s [le_z []]]]],
                  closed_pi [closed_bvar [le_s [le_s [le_z []]]],
                             closed_bvar [le_s [le_s [le_s [le_z []]]]]]]]

lemma cl_czero (u: lvl): $ closed nz (czero u) $
----
l1: $ closed nz (czero u) $
  by closed_lam [closed_srt [],
       closed_lam [closed_pi [closed_bvar [le_s [le_z []]], closed_bvar [le_s [le_s [le_z []]]]],
                   closed_lam [closed_bvar [le_s [le_s [le_z []]]], closed_bvar [le_s [le_z []]]]]]

-- Typings of the binder types and variables

lemma arr_ty (G: ctx) (u: lvl): $ ty (q1 G u) (pi v0 v1) (srt (limax u u)) $
----
l1: $ ty (q1 G u) (pi v0 v1) (srt (limax u u)) $
  by forallEDF [bvar [lookup_srt0 []], bvar [lookup_srt_s [lookup_srt0 []]]]

lemma a_ty (G: ctx) (u: lvl): $ ty (q2 G u) v1 (srt u) $
----
l1: $ ty (q2 G u) v1 (srt u) $ by bvar [lookup_srt_s [lookup_srt0 []]]

lemma a_ty3 (G: ctx) (u: lvl): $ ty (q3 G u) v2 (srt u) $
----
l1: $ ty (q3 G u) v2 (srt u) $ by bvar [lookup_srt_s [lookup_srt_s [lookup_srt0 []]]]

lemma s_ty (G: ctx) (u: lvl): $ ty (q3 G u) v1 (pi v2 v3) $
----
l1: $ lift (s nz) nz (pi v0 v1) (pi v1 v2) $ by lift_pi [lift1_z [], lift1_ge [le_s [le_z []]]]
l2: $ lift (s nz) nz (pi v1 v2) (pi v2 v3) $ by lift_pi [lift1_z [], lift1_ge [le_s [le_z []]]]
l3: $ ty (q3 G u) v1 (pi v2 v3) $ by bvar [lookup_s [lookup_z [l1], l2]]

lemma z_ty (G: ctx) (u: lvl): $ ty (q3 G u) v0 v2 $
----
l1: $ ty (q3 G u) v0 v2 $ by bvar [lookup_z [lift1_z []]]

-- Types

cnat_ty
-------
l1: $ ty G (srt u) (srt (ls u)) $ by ty_srt []
l2: $ ty (q1 G u) (pi v0 v1) (srt (limax u u)) $ by arr_ty []
l3: $ ty (q2 G u) (pi v1 v2) (srt (limax u u)) $
  by forallEDF [bvar [lookup_srt_s [lookup_srt0 []]],
                bvar [lookup_srt_s [lookup_srt_s [lookup_srt0 []]]]]
l4: $ ty (q1 G u) (pi (pi v0 v1) (pi v1 v2)) (srt (limax (limax u u) (limax u u))) $
  by forallEDF [l2, l3]
l5: $ ty G (cnat u) (srt (limax (ls u) (limax (limax u u) (limax u u)))) $
  by forallEDF [l1, l4]

cnat_ty2
--------
l1: $ ty G (cnat u) (srt (limax (ls u) (limax (limax u u) (limax u u)))) $ by cnat_ty []
m1: $ leqv (limax (limax u u) (limax u u)) (limax u u) $
  by leqv_imax [limax_self [], limax_self []]
m2: $ leqv (limax u u) u $ by limax_self []
m3: $ leqv (limax (limax u u) (limax u u)) u $ by leqv_trans [m1, m2]
l2: $ leqv (limax (ls u) (limax (limax u u) (limax u u))) (limax (ls u) u) $
  by leqv_imax [leqv_refl [], m3]
l3: $ deq G (srt (limax (ls u) (limax (limax u u) (limax u u)))) (srt (limax (ls u) u))
      (srt (ls (limax (ls u) (limax (limax u u) (limax u u))))) $ by sortDF [l2]
l4: $ ty G (cnat u) (srt (limax (ls u) u)) $ by defeqDF [l3, l1]

lemma czero_body (G: ctx) (u: lvl):
  $ ty (q1 G u) (lam (pi v0 v1) (lam v1 v0)) (pi (pi v0 v1) (pi v1 v2)) $
----
l1: $ ty (q1 G u) (pi v0 v1) (srt (limax u u)) $ by arr_ty []
l2: $ ty (q2 G u) v1 (srt u) $ by a_ty []
l3: $ ty (q3 G u) v0 v2 $ by z_ty []
l4: $ ty (q2 G u) (lam v1 v0) (pi v1 v2) $ by lamDF [l2, l3]
l5: $ ty (q1 G u) (lam (pi v0 v1) (lam v1 v0)) (pi (pi v0 v1) (pi v1 v2)) $ by lamDF [l1, l4]

czero_ty
--------
l1: $ ty G (srt u) (srt (ls u)) $ by ty_srt []
l2: $ ty (q1 G u) (lam (pi v0 v1) (lam v1 v0)) (pi (pi v0 v1) (pi v1 v2)) $ by czero_body []
l3: $ ty G (czero u) (cnat u) $ by lamDF [l1, l2]

cone_ty
-------
l0a: $ ty (q3 G u) v1 (pi v2 v3) $ by s_ty []
l0b: $ ty (q3 G u) v0 v2 $ by z_ty []
l1: $ ty (q3 G u) (app v1 v0) v2 $ by appDF [l0a, l0b, inst_bvar_gt [le_z []]]
l2: $ ty (q2 G u) v1 (srt u) $ by a_ty []
l3: $ ty (q2 G u) (lam v1 (app v1 v0)) (pi v1 v2) $ by lamDF [l2, l1]
l4: $ ty (q1 G u) (pi v0 v1) (srt (limax u u)) $ by arr_ty []
l5: $ ty (q1 G u) (lam (pi v0 v1) (lam v1 (app v1 v0))) (pi (pi v0 v1) (pi v1 v2)) $
  by lamDF [l4, l3]
l6: $ ty G (srt u) (srt (ls u)) $ by ty_srt []
l7: $ ty G (cone u) (cnat u) $ by lamDF [l6, l5]

-- `inst` of the body of `cnat` at `α := v2`, shared by `succ` and the β-steps.
lemma i_cb : $ inst nz (pi (pi v0 v1) (pi v1 v2)) v2 (pi (pi v2 v3) (pi v3 v4)) $
----
l1: $ inst nz (pi (pi v0 v1) (pi v1 v2)) v2 (pi (pi v2 v3) (pi v3 v4)) $
  by inst_pi [inst_pi [inst_bvar_eq [lift0 []], inst_bvar_eq [lift1_z []]],
              inst_pi [inst_bvar_eq [lift1_z []],
                       inst_bvar_eq [lift_bvar_ge [le_z [], add_s [add_s [add_z []]]]]]]

lemma i_s : $ inst nz (pi v3 v4) v1 (pi v2 v3) $
----
l1: $ inst nz (pi v3 v4) v1 (pi v2 v3) $
  by inst_pi [inst_bvar_gt [le_z []], inst_bvar_gt [le_s [le_z []]]]

lemma csucc_body (G: ctx) (u: lvl):
  $ ty (cons (cnat u) G) (lam (srt u) (lam (pi v0 v1) (lam v1 sbody))) (cnat u) $
----
n1: $ ty (q3 (cons (cnat u) G) u) v3 (cnat u) $
  by bvar [lookup_closed_s [lookup_closed_s [lookup_closed_s [lookup_closed0 [cl_cnat []],
            cl_cnat []], cl_cnat []], cl_cnat []]]
n2: $ ty (q3 (cons (cnat u) G) u) v2 (srt u) $ by a_ty3 []
n3: $ ty (q3 (cons (cnat u) G) u) v1 (pi v2 v3) $ by s_ty []
n4: $ ty (q3 (cons (cnat u) G) u) v0 v2 $ by z_ty []
t1: $ ty (q3 (cons (cnat u) G) u) (app v3 v2) (pi (pi v2 v3) (pi v3 v4)) $
  by appDF [n1, n2, i_cb []]
t2: $ ty (q3 (cons (cnat u) G) u) (app (app v3 v2) v1) (pi v2 v3) $
  by appDF [t1, n3, i_s []]
t3: $ ty (q3 (cons (cnat u) G) u) (app (app (app v3 v2) v1) v0) v2 $
  by appDF [t2, n4, inst_bvar_gt [le_z []]]
t4: $ ty (q3 (cons (cnat u) G) u) sbody v2 $
  by appDF [n3, t3, inst_bvar_gt [le_z []]]
a1: $ ty (q2 (cons (cnat u) G) u) v1 (srt u) $ by a_ty []
t5: $ ty (q2 (cons (cnat u) G) u) (lam v1 sbody) (pi v1 v2) $ by lamDF [a1, t4]
a2: $ ty (q1 (cons (cnat u) G) u) (pi v0 v1) (srt (limax u u)) $ by arr_ty []
t6: $ ty (q1 (cons (cnat u) G) u) (lam (pi v0 v1) (lam v1 sbody))
        (pi (pi v0 v1) (pi v1 v2)) $ by lamDF [a2, t5]
a3: $ ty (cons (cnat u) G) (srt u) (srt (ls u)) $ by ty_srt []
t7: $ ty (cons (cnat u) G) (lam (srt u) (lam (pi v0 v1) (lam v1 sbody))) (cnat u) $
  by lamDF [a3, t6]

csucc_ty
--------
l1: $ ty G (cnat u) (srt (limax (ls u) (limax (limax u u) (limax u u)))) $ by cnat_ty []
l2: $ ty (cons (cnat u) G) (lam (srt u) (lam (pi v0 v1) (lam v1 sbody))) (cnat u) $
  by csucc_body []
l3: $ ty G (csucc u) (pi (cnat u) (cnat u)) $ by lamDF [l1, l2]

csucc_zero
----------
-- Step 1: β-reduce `succ zero`, substituting `zero` for `n` under three binders.
s1: $ ty (cons (cnat u) G) (lam (srt u) (lam (pi v0 v1) (lam v1 sbody))) (cnat u) $
  by csucc_body []
s2: $ ty G (czero u) (cnat u) $ by czero_ty []
s3: $ inst nz (lam (srt u) (lam (pi v0 v1) (lam v1 sbody))) (czero u)
      (lam (srt u) (lam (pi v0 v1) (lam v1
        (app v1 (app (app (app (czero u) v2) v1) v0))))) $
  by inst_lam [inst_srt [],
       inst_lam [inst_pi [inst_bvar_lt [le_s [le_z []]], inst_bvar_lt [le_s [le_s [le_z []]]]],
         inst_lam [inst_bvar_lt [le_s [le_s [le_z []]]],
           inst_app [inst_bvar_lt [le_s [le_s [le_z []]]],
             inst_app [inst_app [inst_app [inst_bvar_eq [lift_closed0 [cl_czero []]],
                                           inst_bvar_lt [le_s [le_s [le_s [le_z []]]]]],
                                 inst_bvar_lt [le_s [le_s [le_z []]]]],
                       inst_bvar_lt [le_s [le_z []]]]]]]]
s4: $ inst nz (cnat u) (czero u) (cnat u) $ by inst_closed0 [cl_cnat []]
s5: $ deq G (app (csucc u) (czero u))
      (lam (srt u) (lam (pi v0 v1) (lam v1
        (app v1 (app (app (app (czero u) v2) v1) v0))))) (cnat u) $
  by beta [s1, s2, s3, s4]
-- Step 2: three β-steps inside `z := zero α s z`, in context α, s, z.
z2: $ ty (q3 G u) v2 (srt u) $ by a_ty3 []
z3: $ ty (q3 G u) v1 (pi v2 v3) $ by s_ty []
z4: $ ty (q3 G u) v0 v2 $ by z_ty []
b1a: $ ty (q1 (q3 G u) u) (lam (pi v0 v1) (lam v1 v0)) (pi (pi v0 v1) (pi v1 v2)) $
  by czero_body []
b1b: $ inst nz (lam (pi v0 v1) (lam v1 v0)) v2 (lam (pi v2 v3) (lam v3 v0)) $
  by inst_lam [inst_pi [inst_bvar_eq [lift0 []], inst_bvar_eq [lift1_z []]],
               inst_lam [inst_bvar_eq [lift1_z []], inst_bvar_lt [le_s [le_z []]]]]
b1: $ deq (q3 G u) (app (czero u) v2) (lam (pi v2 v3) (lam v3 v0))
      (pi (pi v2 v3) (pi v3 v4)) $ by beta [b1a, z2, b1b, i_cb []]
b2a: $ ty (cons v3 (cons (pi v2 v3) (q3 G u))) v0 v4 $ by bvar [lookup_z [lift1_z []]]
b2b: $ ty (cons (pi v2 v3) (q3 G u)) v3 (srt u) $
  by bvar [lookup_srt_s [lookup_srt_s [lookup_srt_s [lookup_srt0 []]]]]
b2c: $ ty (cons (pi v2 v3) (q3 G u)) (lam v3 v0) (pi v3 v4) $ by lamDF [b2b, b2a]
b2d: $ inst nz (lam v3 v0) v1 (lam v2 v0) $
  by inst_lam [inst_bvar_gt [le_z []], inst_bvar_lt [le_s [le_z []]]]
b2: $ deq (q3 G u) (app (lam (pi v2 v3) (lam v3 v0)) v1) (lam v2 v0) (pi v2 v3) $
  by beta [b2c, z3, b2d, i_s []]
b3a: $ ty (cons v2 (q3 G u)) v0 v3 $ by bvar [lookup_z [lift1_z []]]
b3: $ deq (q3 G u) (app (lam v2 v0) v0) v0 v2 $
  by beta [b3a, z4, inst_bvar_eq [lift0 []], inst_bvar_gt [le_z []]]
c1: $ deq (q3 G u) (app (app (czero u) v2) v1) (app (lam (pi v2 v3) (lam v3 v0)) v1)
      (pi v2 v3) $ by appDF [b1, z3, i_s []]
c2: $ deq (q3 G u) (app (app (czero u) v2) v1) (lam v2 v0) (pi v2 v3) $ by trans [c1, b2]
c3: $ deq (q3 G u) (app (app (app (czero u) v2) v1) v0) (app (lam v2 v0) v0) v2 $
  by appDF [c2, z4, inst_bvar_gt [le_z []]]
c4: $ deq (q3 G u) (app (app (app (czero u) v2) v1) v0) v0 v2 $ by trans [c3, b3]
-- Step 3: congruence back out through `s _` and the three binders.
z5: $ ty (q2 G u) v1 (srt u) $ by a_ty []
c5: $ deq (q3 G u) (app v1 (app (app (app (czero u) v2) v1) v0)) (app v1 v0) v2 $
  by appDF [z3, c4, inst_bvar_gt [le_z []]]
c6: $ deq (q2 G u) (lam v1 (app v1 (app (app (app (czero u) v2) v1) v0))) (lam v1 (app v1 v0))
      (pi v1 v2) $ by lamDF [z5, c5]
d1: $ ty (q1 G u) (pi v0 v1) (srt (limax u u)) $ by arr_ty []
c7: $ deq (q1 G u) (lam (pi v0 v1) (lam v1 (app v1 (app (app (app (czero u) v2) v1) v0))))
      (lam (pi v0 v1) (lam v1 (app v1 v0))) (pi (pi v0 v1) (pi v1 v2)) $ by lamDF [d1, c6]
d2: $ ty G (srt u) (srt (ls u)) $ by ty_srt []
c8: $ deq G (lam (srt u) (lam (pi v0 v1) (lam v1
        (app v1 (app (app (app (czero u) v2) v1) v0))))) (cone u) (cnat u) $
  by lamDF [d2, c7]
c9: $ deq G (app (csucc u) (czero u)) (cone u) (cnat u) $ by trans [s5, c8]
