import "../lean.mm0";

--| `@[reducible] def id.{u} {α : Sort u} (a : α) : α := a`
def id (u: lvl): expr = $ lam (srt u) (lam (bvar nz) (bvar nz)) $;
theorem id_ty (G: ctx) (u: lvl): $ ty G (id u) (pi (srt u) (pi (bvar nz) (bvar (s nz)))) $;

--| `def Function.comp.{u,v,w} {α : Sort u} {β : Sort v} {δ : Sort w}
--|    (f : β → δ) (g : α → β) : α → δ := fun x => f (g x)`
def comp (u v w: lvl): expr = $ lam (srt u) (lam (srt v) (lam (srt w)
  (lam (pi (bvar (s nz)) (bvar (s nz)))
  (lam (pi (bvar (s (s (s nz)))) (bvar (s (s (s nz)))))
  (lam (bvar (s (s (s (s nz)))))
    (app (bvar (s (s nz))) (app (bvar (s nz)) (bvar nz)))))))) $;
theorem comp_ty (G: ctx) (u v w: lvl): $ ty G (comp u v w)
  (pi (srt u) (pi (srt v) (pi (srt w)
  (pi (pi (bvar (s nz)) (bvar (s nz)))
  (pi (pi (bvar (s (s (s nz)))) (bvar (s (s (s nz)))))
  (pi (bvar (s (s (s (s nz))))) (bvar (s (s (s nz)))))))))) $;

--| η: in context `f : Sort l → Sort l`, `fun x => f x ≡ f`.
theorem eta_ex (G: ctx) (l: lvl): $ deq (cons (pi (srt l) (srt l)) G)
  (lam (srt l) (app (bvar (s nz)) (bvar nz))) (bvar nz) (pi (srt l) (srt l)) $;

--| Proof irrelevance: in context `p : Prop, h₁ : p, h₂ : p`, `h₁ ≡ h₂ : p`.
theorem pirr_ex (G: ctx): $ deq (cons (bvar (s nz)) (cons (bvar nz) (cons (srt lz) G)))
  (bvar (s nz)) (bvar nz) (bvar (s (s nz))) $;

--| A theorem stated without its proof term: `∀ α : Sort u, α → α` is inhabited.
theorem id_inh (u: lvl): $ inh nil (pi (srt u) (pi (bvar nz) (bvar (s nz)))) $;
