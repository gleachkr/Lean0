include "../lib.auf";

PUnit_comm
----------
l1: $ deq G (PUnit (lmax u v)) (PUnit (lmax v u)) (srt (lmax u v)) $
  by PUnit_df [lmax_comm []]

PUnit_id
--------
l1: $ ty G (PUnit u) (srt u) $ by PUnit_df [leqv_refl []]
l2: $ ty (cons (PUnit u) G) (bvar nz) (PUnit u) $ by bvar [lookup_closed0 [PUnit_closed []]]
l3: $ ty G (lam (PUnit u) (bvar nz)) (pi (PUnit u) (PUnit u)) $ by lamDF [l1, l2]
